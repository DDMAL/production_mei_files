38" lry="1018" /><zone xml:id="m-79456b28-caf3-4db0-8f38-96b363ce23fc" ulx="122" uly="984" lrx="526" lry="1018" /><zone xml:id="m-f53dd54a-19d0-4900-ad2c-b928683d0b59" ulx="118" uly="1008" lrx="937" lry="1042" /><zone xml:id="m-69d748bb-82c8-4186-84c0-66eb6e4a825d" ulx="423" uly="1060" lrx="640" lry="1092" /><zone xml:id="m-6fea2f83-8a8d-47a1-becd-e1524c17c20f" ulx="148" uly="1098" lrx="941" lry="1134" /><zone xml:id="m-d9ad2290-1046-4015-81b2-6daf304cf1a1" ulx="534" uly="1125" lrx="940" lry="1163" /><zone xml:id="m-29c00b3c-7b91-47ee-bc17-a8e490ffd7bc" ulx="128" uly="1126" lrx="526" lry="1160" /><zone xml:id="m-ea9c9a25-4154-43c0-96cd-9343f302bb75" ulx="121" uly="1154" lrx="904" lry="1188" /><zone xml:id="m-fca7ea9c-7fac-4916-b7ee-3569d71b20ad" ulx="432" uly="1273" lrx="620" lry="1307" /><zone xml:id="m-eca8198c-363c-4da1-b637-b45da534369a" ulx="247" uly="1330" lrx="805" lry="1383" /><zone xml:id="m-b9b6caa7-dadd-4806-bc9f-cbe4ba6821ca" ulx="144" uly="1408" lrx="664" lry="1449" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-625c53a4-97d7-4862-888a-f718ace224fc" n="2332" facs="#m-d67b7702-ff20-4f49-b156-33c6a2b30807" /><div xml:id="m-ceddaf1e-001b-4bd3-985d-310b2fb3d488">
            <lg xml:id="m-4af7d097-1eb1-4d08-a8ee-3c535cd0a70f">
              <l xml:id="m-88aa9552-e7a6-46a9-8eeb-9bd502cae561" facs="#m-2b3c8d21-45a7-4819-83b4-666e10d72a84" label="ambiguous">«o</l><l xml:id="m-83d55799-b656-42f2-b6b9-c3ea11a4625d" facs="#m-9601dab3-9f6c-4980-898a-002cb56b7268" label="text-like">Proper feasts of U. S. A.</l><l xml:id="m-93d48b12-026a-40f5-9a8a-003ca98a352f" facs="#m-0d9b90df-2aa2-41e9-a134-db3cbb7af554" label="ambiguous">NOVEMBERG</l><l xml:id="m-a435d4f0-1e42-41df-a987-ed01870967ff" facs="#m-3f1bc147-1571-494c-bc6d-275d666d27e0" label="ambiguous">St. Leonard, Abbot</l><l xml:id="m-ea045489-d0a7-4551-abe6-2f8c332b7aed" facs="#m-e72002d0-df12-464e-bc2e-4eeeb9f60de0" label="lyrics-like">Mass. Os jústi, from the Common of Abbots, p. 1206.</l><l xml:id="m-b11ef157-a643-4669-9c18-692bba22af2b" facs="#m-004a8a84-3d51-4243-9abe-2c2b5048e70c" label="ambiguous">Collect</l><l xml:id="m-b051c50d-a168-42cb-9bb3-77d54359d4f0" facs="#m-33258f4e-86a4-4ffd-8446-0167788e66dd" label="lyrics-like">Ajestáti tuae, quaésumus, pia comméndet orátio; ut, quem</l><l xml:id="m-2fd51944-ceb2-46ef-b4a1-2ca26d6da653" facs="#m-4d4d2c36-b48d-4164-882f-9be032014471" label="lyrics-like">1L omnipotens Deus, nos san-venerámur officio, ipsius suffrá¬</l><l xml:id="m-3fa81d8b-fbde-4849-af6a-7441b2645edd" facs="#m-62d42941-ce7b-4a34-adba-108fcbc030c2" label="lyrics-like">ctíssimi Confessóris tui Leonárdi lgiis sublevémur. Per Dóminum.</l><l xml:id="m-36ffdcd0-9892-47c6-bf71-051c75284f0e" facs="#m-f6805a67-b48b-4cdd-899c-1433e33e6161" label="ambiguous">NOVEMBER 17</l><l xml:id="m-e5c57a24-50f9-4d5b-881a-3765d8c8ba74" facs="#m-2d4e5ccc-f886-4d69-985b-e883f05ca9cf" label="ambiguous">Bd Philippine Duchesne, Virgin</l><l xml:id="m-d8b0922c-e0a9-43ae-ba8b-17ae9dd729d7" facs="#m-6a0bad40-6df3-4970-bb97-21291b1c5c35" label="text-like">In the archdiocese of St. Louis</l><l xml:id="m-ec55a78d-ad14-494a-9078-7184b28a4e76" facs="#m-cd8c79ff-36c6-4fbd-9db7-3675435f2d72" label="text-like">Mass. Dilexisti. p. 1225, except the following Pravers:</l><l xml:id="m-ea8c40b1-d682-4ae3-87b7-14e64e1b7cd5" facs="#m-20ab5ce3-48bd-4fe3-91be-8d0bc53adf8c" label="ambiguous">Collect</l><l xml:id="m-c6acd752-afe7-485f-8d8c-d70b40783934" facs="#m-ee572603-b0c6-430a-83c2-a8fce284c794" label="lyrics-like">Eus, qui caritátis dona in! concéde, r ut fidéles tui quae tibi</l><l xml:id="m-668df1fc-5c65-4ae5-b937-abaab8397906" facs="#m-04a7233a-64f6-4d20-ad9d-0def19cb45e0" label="lyrics-like">U corde beâtae Philippínae in- sunt plácita tota dilectiõne per¬</l><l xml:id="m-cdbf2e4c-7953-4727-bcd5-f2c2d01ba652" facs="#m-05114359-dde9-4eaf-8e59-f184f78001f5" label="lyrics-like">fudísti : t ejus méritis et précibus! ficiant. Per Dóminum.</l><l xml:id="m-105077c4-0538-43bd-8014-384002acd41c" facs="#m-6df4e9b0-bd09-4bb0-90aa-3edfe68e2ccb" label="ambiguous">Secret</l><l xml:id="m-4261af0a-9a70-4ad8-bcec-bb763b0cf984" facs="#m-b96bc22f-77f2-4792-a8e4-9984e848cf50" label="lyrics-like">DReces et hóstias, Dómine, dicámus, cujus ánimus tibi sédula</l><l xml:id="m-124cb7ed-5c18-4770-b8c8-07fe86b03961" facs="#m-67e1ac92-ab08-40f1-bf95-c85814240599" label="lyrics-like">oratióne et sui ipsius immola¬</l><l xml:id="m-50a2cb3e-ad5a-4669-83ac-11b188cabedf" facs="#m-79456b28-caf3-4db0-8f38-96b363ce23fc" label="lyrics-like">L benignus assúme, quas in</l><l xml:id="m-5837ea20-817a-4fea-86b9-6c142c259aca" facs="#m-f53dd54a-19d0-4900-ad2c-b928683d0b59" label="lyrics-like">beátae Philippinae festivitâte tione adhaerébat. Per Dóminum.</l><l xml:id="m-d649b49c-b022-4500-acd8-d74e6acd97f0" facs="#m-69d748bb-82c8-4186-84c0-66eb6e4a825d" label="ambiguous">Postcommunion</l><l xml:id="m-5f7963f8-81ee-454b-9bcd-e8c0bfc85bcd" facs="#m-6fea2f83-8a8d-47a1-becd-e1524c17c20f" label="lyrics-like">VAelésti dape refécti, quaésu- dilectíssimi Filii tui regnum</l><l xml:id="m-e3e53d89-50ff-4b38-a30d-5be0448fe3d9" facs="#m-d9ad2290-1046-4015-81b2-6daf304cf1a1" label="lyrics-like">ubique géntium dilatáre studeá¬</l><l xml:id="m-fa4b8957-83f2-4a5d-b198-ffa4eb6d7636" facs="#m-29c00b3c-7b91-47ee-bc17-a8e490ffd7bc" label="lyrics-like">L mus, Dómine, ut beátac</l><l xml:id="m-17c2034c-7e0d-4217-87fa-9c6b6583e413" facs="#m-ea9c9a25-4154-43c0-96cd-9343f302bb75" label="lyrics-like">Philippinae vestigiis insisténtes, mus. Per eúmdem Dóminum.</l><l xml:id="m-22bad3f6-2735-46d5-bc1a-51b889c3c42f" facs="#m-fca7ea9c-7fac-4916-b7ee-3569d71b20ad" label="ambiguous">NOVEMBER 27</l><l xml:id="m-2d8f38d5-ed36-4dc2-aea1-38827da0dd46" facs="#m-eca8198c-363c-4da1-b637-b45da534369a" label="text-like">St. Virgil, Bishop and Confessor</l><l xml:id="m-c6c1edc5-9c11-4c1f-89f6-db5f787fd10e" facs="#m-b9b6caa7-dadd-4806-bc9f-cbe4ba6821ca" label="lyrics-like">Mass. Státuit. from the Common. p. 1182.</l></lg></div></section></score></mdiv></body></music>
</mei>