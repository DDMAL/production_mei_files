546" lry="491" /><zone xml:id="m-c701ee6b-9247-4bdf-8f1b-43d93faa80f2" ulx="555" uly="481" lrx="986" lry="520" /><zone xml:id="m-0799c839-a828-4524-837c-3cc84b0d153f" ulx="116" uly="483" lrx="545" lry="515" /><zone xml:id="m-a0789155-e328-413b-b09e-8e6b57a3dd4b" ulx="555" uly="508" lrx="987" lry="541" /><zone xml:id="m-c5ae863a-cf09-45f6-9409-3cfb22c72b2e" ulx="116" uly="509" lrx="546" lry="544" /><zone xml:id="m-88ecf9c2-a599-4a75-8ccc-32f5935ecd48" ulx="553" uly="534" lrx="986" lry="573" /><zone xml:id="m-8601eb10-77a1-4b6c-8348-9162e601b468" ulx="117" uly="538" lrx="546" lry="572" /><zone xml:id="m-9e64e9f1-2291-43ae-8b9b-46b9ee47d19e" ulx="117" uly="563" lrx="773" lry="597" /><zone xml:id="m-b1219f60-4629-4182-ab2e-ec0ec61e9071" ulx="868" uly="592" lrx="961" lry="627" /><zone xml:id="m-a940320a-44c7-4db7-9b19-92b52631be39" ulx="143" uly="593" lrx="605" lry="632" /><zone xml:id="m-82e78035-31bb-4e9e-977d-9caaa86c43de" ulx="506" uly="631" lrx="603" lry="663" /><zone xml:id="m-057fd49a-c709-45b9-84f6-89949b3fedee" ulx="129" uly="656" lrx="986" lry="699" /><zone xml:id="m-fd4c6bca-efe3-417c-b96a-1c50e56d4c1d" ulx="120" uly="686" lrx="546" lry="722" /><zone xml:id="m-0443d276-25be-4c2e-ab19-165a66519850" ulx="556" uly="686" lrx="988" lry="724" /><zone xml:id="m-0f770f2d-4f79-4843-9b0c-cbce0f729dc8" ulx="558" uly="715" lrx="864" lry="754" /><zone xml:id="m-6c0bcbcd-6930-4fc9-a637-f6874ffc3c0f" ulx="118" uly="716" lrx="545" lry="747" /><zone xml:id="m-6eebc7c9-6924-4304-930d-524e69808347" ulx="117" uly="740" lrx="549" lry="780" /><zone xml:id="m-87c71018-d4e8-45d9-bc2a-bbaaf887a4a6" ulx="140" uly="772" lrx="491" lry="811" /><zone xml:id="m-0bfcafa8-7253-4310-8424-2f880a28c58e" ulx="435" uly="808" lrx="671" lry="841" /><zone xml:id="m-52fb5620-2937-4852-80f3-5cad14dbd632" ulx="119" uly="833" lrx="987" lry="874" /><zone xml:id="m-5270bd78-ebb7-4282-a9af-370a92053178" ulx="127" uly="864" lrx="987" lry="899" /><zone xml:id="m-fc749d50-ae52-47e4-aec8-f018374f4bde" ulx="118" uly="891" lrx="695" lry="929" /><zone xml:id="m-ffe65d0a-403b-467a-b7c8-a072692fa52d" ulx="118" uly="954" lrx="920" lry="995" /><zone xml:id="m-382e5319-e819-4b6b-847d-1a764f5a0020" ulx="476" uly="993" lrx="634" lry="1034" /><zone xml:id="m-8dc58224-b295-434f-9387-9b9b0457f90a" ulx="501" uly="1031" lrx="613" lry="1065" /><zone xml:id="m-735ce650-c113-4694-9105-bc91a70897eb" ulx="154" uly="1065" lrx="982" lry="1104" /><zone xml:id="m-ec8ed4a6-5dda-4446-8abf-155ef1fb0bab" ulx="123" uly="1092" lrx="988" lry="1128" /><zone xml:id="m-88382ce4-3801-4e15-9055-f5350897fd2d" ulx="119" uly="1121" lrx="915" lry="1156" /><zone xml:id="m-7302de20-383b-4ac0-b94f-e7d6c415e116" ulx="119" uly="1153" lrx="550" lry="1181" /><zone xml:id="m-8ab3b080-3b08-4f12-b794-fdb57455c9b3" ulx="142" uly="1177" lrx="891" lry="1212" /><zone xml:id="m-3634c69f-537d-4888-a480-20394d3a6bfa" ulx="120" uly="1237" lrx="987" lry="1284" /><zone xml:id="m-e3751191-4d13-4a1c-99c2-843932ef0ceb" ulx="503" uly="1272" lrx="604" lry="1314" /><zone xml:id="m-2f6f01e3-f717-411f-b35c-d282479df7d3" ulx="144" uly="1311" lrx="990" lry="1350" /><zone xml:id="m-12d84477-ac30-4f9b-9aff-8be91480c974" ulx="121" uly="1338" lrx="297" lry="1376" /><zone xml:id="m-9fe07a12-6bc0-454d-87b9-e8380bff31ce" ulx="146" uly="1369" lrx="841" lry="1409" /><zone xml:id="m-f7947e3e-4467-4343-a466-ce361ecf0ed0" ulx="498" uly="1413" lrx="612" lry="1442" /><zone xml:id="m-c65fd3c3-c1d8-4d70-aee4-b45b97776c9b" ulx="165" uly="1442" lrx="992" lry="1475" /><zone xml:id="m-df3b19ff-4678-4cb0-bd67-998b01b555e1" ulx="123" uly="1466" lrx="991" lry="1504" /><zone xml:id="m-4a7fa5a7-710a-4e23-80b6-d4b589f1ad36" ulx="555" uly="1495" lrx="989" lry="1534" /><zone xml:id="m-37fb0543-638d-4810-85c7-0b07d3c414e3" ulx="123" uly="1496" lrx="551" lry="1532" /><zone xml:id="m-f238bb98-1cfd-4393-93c5-36e71d468aa9" ulx="121" uly="1521" lrx="745" lry="1560" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-a974ad2e-84c6-4f12-9fad-b914987001d2" n="1636" facs="#m-5151cdb9-3418-480c-82f1-1533aea17f29" /><div xml:id="m-d028bc99-f5d8-45e0-a11c-53b441e8a024">
            <lg xml:id="m-46c44720-af93-4823-b057-405458adbbb2">
              <l xml:id="m-5ef803a1-9a60-4373-b60a-dd46f8935e42" facs="#m-c997e13a-bc37-4418-81fa-54d0fab58c09" label="ambiguous">April 26. 27.</l><l xml:id="m-f6a7653a-fc37-4916-9463-1282b992d13a" facs="#m-174e4b88-882d-4483-8e92-d357b03a026d" label="ambiguous">1432</l><l xml:id="m-b05bb801-6b81-46ad-9223-5e799db5da5f" facs="#m-ea487f1e-a1ef-4bb0-b18e-500928132bb9" label="ambiguous">Collect.</l><l xml:id="m-6c97383e-607e-4ca2-8521-f38f7de7cbe9" facs="#m-4a047d25-c493-4c7b-96d5-06d027ce21ae" label="lyrics-like">Eus, qui beátum Marcum Evan-] tribue quaésumus; ejus nos semper</l><l xml:id="m-e70c5abe-f6b9-4d02-893e-eb15e3c134f9" facs="#m-a5c6a0ce-93b7-4788-8bfc-634b104cca82" label="lyrics-like">U gelistam tuum, evangélicael et eruditióne proficere, *et oratió¬</l><l xml:id="m-c993b7cb-bd0e-43c3-8a20-5699dc9de8f5" facs="#m-f6e8241d-76ea-4089-89ce-800359eeb757" label="lyrics-like">praedicatiónis grátia sublimásti : tl ne deféndi. Per Dóminum nostrum.</l><l xml:id="m-31949d02-6c5a-46f4-8cc5-e4eabb489cf7" facs="#m-1ba5ad30-c6d1-41e7-af5c-7e43627ed246" label="ambiguous">Lectio Ezechielis Prophetae. Erech. I. c.</l><l xml:id="m-f92f1c13-133c-425f-8fc4-206548e30eb8" facs="#m-353daeff-682a-470b-a7eb-e748d7cb320e" label="lyrics-like">NImilitúdo vultus quátuor ani-] ubi erat impetus spíritus, illuc gra¬</l><l xml:id="m-6d9006f6-2680-4705-b76d-f87cd482fd20" facs="#m-27da124a-3058-4b6a-912a-89c569f88555" label="lyrics-like">O málium: fácies hóminis et fá¬</l><l xml:id="m-b14fabab-33f2-49fd-951c-d64db2e67e22" facs="#m-1cfa155e-5fb7-4c64-a025-cc11189f339b" label="lyrics-like">diebántur, nec revertebántur cum</l><l xml:id="m-9f712922-220f-4c76-bed7-f125ae9d9b50" facs="#m-cfd8d24b-974e-44bf-a8b1-4bea1be32ed3" label="lyrics-like">ambulárent. Et similitúdo animá¬</l><l xml:id="m-b77b3fef-0d60-4b65-88a2-5d0a3369afc6" facs="#m-6fa4e565-1454-4204-964c-c3203a900872" label="lyrics-like">cies leónis a dextris ipsórum quá¬</l><l xml:id="m-f9f1eed5-c0d9-48d7-9d99-7da53121d543" facs="#m-c0004429-05aa-41b4-9050-5ec64734dde9" label="lyrics-like">lium, aspéctus eórum quasi carbó¬</l><l xml:id="m-9ea61515-8742-49df-904e-88f26398c3ca" facs="#m-9ad6ee16-51f7-480c-ae53-3d0e1ca7624a" label="lyrics-like">tuor : fácies autem bovis a sinistris</l><l xml:id="m-40fe5801-210a-475c-92e8-beff5d2433b4" facs="#m-7a94be65-9b17-42ec-9baa-81f050d143c5" label="lyrics-like">num ignis ardéntium, et quasi aspé¬</l><l xml:id="m-cc513567-c3fa-4ac3-a367-c95f67397c13" facs="#m-b8e9f171-3fa9-455a-b063-09b16e570278" label="lyrics-like">ipsórum quátuor, et fácies áquilae</l><l xml:id="m-44398597-1032-422a-b110-57cfa06ad55a" facs="#m-fa3f62f0-c8a2-475c-ac8f-2c47ecf8b2f8" label="lyrics-like">ctus lampadárum. Haec'erat vísio</l><l xml:id="m-1b61cf5c-bd01-4e20-9dd2-1f908f0b08b4" facs="#m-6784d234-b643-430f-baf4-25f8f39f9310" label="lyrics-like">désuper ipsórum quátuor. Fácies</l><l xml:id="m-ec6581c0-cc2c-4adf-9249-24f3712b1945" facs="#m-d488580a-7f88-48cb-8de7-f143cd8c0216" label="lyrics-like">discúrrens in médio animálium.</l><l xml:id="m-098fa0cf-4eed-45b2-9279-1840e5b449ad" facs="#m-68edae8e-e1b2-4249-bed8-c818a5c9115e" label="lyrics-like">córum et pennae éórum exténtae</l><l xml:id="m-f17219f1-1985-42c7-8833-9d305f4c7cda" facs="#m-c701ee6b-9247-4bdf-8f1b-43d93faa80f2" label="ambiguous">splendor ignis, et de igne fulgur</l><l xml:id="m-004ee43d-7b48-41ac-aca6-9b9f8f91859d" facs="#m-0799c839-a828-4524-837c-3cc84b0d153f" label="lyrics-like">désuper: duae pennae singulórum</l><l xml:id="m-06fa375a-aabc-4619-894c-17948b56f4dd" facs="#m-a0789155-e328-413b-b09e-8e6b57a3dd4b" label="lyrics-like">egrédiens. Et animália ibant, et</l><l xml:id="m-a300daa6-581d-4d5f-8c3f-0e3c88e44a1c" facs="#m-c5ae863a-cf09-45f6-9409-3cfb22c72b2e" label="lyrics-like">jungebántur, et duae tegébant cór¬</l><l xml:id="m-350afe45-1657-4a53-aa64-bff486c50f82" facs="#m-88ecf9c2-a599-4a75-8ccc-32f5935ecd48" label="lyrics-like">rẽvertebántur in similitúdinem fúl¬</l><l xml:id="m-e737c1b1-5ca9-4be5-9be0-a0c603248fe4" facs="#m-8601eb10-77a1-4b6c-8348-9162e601b468" label="lyrics-like">porã eórum : et unumquódque eó¬</l><l xml:id="m-60be63d3-a8b8-41cb-bfee-20525a514f70" facs="#m-9e64e9f1-2291-43ae-8b9b-46b9ee47d19e" label="lyrics-like">rum coram fácie sua ambulábat : guris coruscántis.</l><l xml:id="m-a4a35f82-93f0-42b9-9000-4d08264c8a8c" facs="#m-b1219f60-4629-4182-ab2e-ec0ec61e9071" label="ambiguous">Credo.</l><l xml:id="m-24bebd54-48d6-496c-9723-c0f4d77c20ee" facs="#m-a940320a-44c7-4db7-9b19-92b52631be39" label="lyrics-like">Gospel. Designávit Dóminus. p. 1373</l><l xml:id="m-f160dbc6-0a6a-4dac-b6f7-e330d7f7ebeb" facs="#m-82e78035-31bb-4e9e-977d-9caaa86c43de" label="ambiguous">Secret.</l><l xml:id="m-f0e8fa58-2664-47db-97c5-2c941d9c302d" facs="#m-057fd49a-c709-45b9-84f6-89949b3fedee" label="lyrics-like">REáti Marci Evangelistae tui fecit gloriósum; ita nos ejus inter¬</l><l xml:id="m-1bde478d-ac90-4706-8254-4f410ff8a68f" facs="#m-fd4c6bca-efe3-417c-b96a-1c50e56d4c1d" label="lyrics-like">O solemnitáte, tibi múnera defe¬</l><l xml:id="m-8a0699da-c483-43b9-b6ae-2a3adc3775da" facs="#m-0443d276-25be-4c2e-ab19-165a66519850" label="lyrics-like">céssio, et verbo et ópere tibi reddar</l><l xml:id="m-75a81f34-e285-4d2b-a3a9-1012a5fb72ba" facs="#m-0f770f2d-4f79-4843-9b0c-cbce0f729dc8" label="lyrics-like">accéptos. Per Dóminum.</l><l xml:id="m-9f8b8721-1561-42a7-b447-9a4836b17512" facs="#m-6c0bcbcd-6930-4fc9-a637-f6874ffc3c0f" label="lyrics-like">réntes, quaésumus, Dómine: ut,</l><l xml:id="m-38a2c06b-2a31-4b30-a43b-9b9b76a219c5" facs="#m-6eebc7c9-6924-4304-930d-524e69808347" label="lyrics-like">sicut illum praedicátio evangélica</l><l xml:id="m-99185f22-d6e3-4b45-80e2-46fdff30f1b4" facs="#m-87c71018-d4e8-45d9-bc2a-bbaaf887a4a6" label="text-like">Preface of the Apostles. p. 10.</l><l xml:id="m-e1a44336-b301-476b-b739-e9bd2a40b33e" facs="#m-0bfcafa8-7253-4310-8424-2f880a28c58e" label="ambiguous">Postcommunion.</l><l xml:id="m-00060526-d5ef-4442-9c46-446cf61b637f" facs="#m-52fb5620-2937-4852-80f3-5cad14dbd632" label="lyrics-like">HRibuant nobis, quaésumus Dó¬ gelistae tui précibus, nos ab ómni¬</l><l xml:id="m-09bd9ae6-f0df-4ad3-afbd-a8298e86e23c" facs="#m-5270bd78-ebb7-4282-a9af-370a92053178" label="lyrics-like">I mine, continuum tua sancta bus semper tueántur advérsis. Per</l><l xml:id="m-14014d3d-28bf-421b-aaa9-45019e3dc12e" facs="#m-fc749d50-ae52-47e4-aec8-f018374f4bde" label="lyrics-like">praesídium: quo, beáti Marci Evan- Dóminum.</l><l xml:id="m-b6f788cd-d5f7-4630-8c05-5e068dd47627" facs="#m-ffe65d0a-403b-467a-b7c8-a072692fa52d" label="text-like">26. SS. Cletus and Marcellinus, Popes and Martyrs.</l><l xml:id="m-3228e367-bb93-4782-a3e9-2afe90047db3" facs="#m-382e5319-e819-4b6b-847d-1a764f5a0020" label="ambiguous">Semi-double.</l><l xml:id="m-7f242a22-2e9c-41fa-8165-6c940f40a0d6" facs="#m-8dc58224-b295-434f-9387-9b9b0457f90a" label="ambiguous">Collect.</l><l xml:id="m-a7196e7a-011d-47bf-ba41-5b18deac7191" facs="#m-735ce650-c113-4694-9105-bc91a70897eb" label="lyrics-like">(Regem tuum, Pastor aetérne, perpétua protectióne custódi;</l><l xml:id="m-2c7b2bae-bb30-4517-9b66-cb68b87dc6ff" facs="#m-ec8ed4a6-5dda-4446-8abf-155ef1fb0bab" label="lyrics-like">U placátus inténde : t et per beâ- quos totius Écclésiae praestitisti</l><l xml:id="m-0de5bfed-bf16-459c-9c62-5d77809471c0" facs="#m-88382ce4-3801-4e15-9055-f5350897fd2d" label="lyrics-like">tos Cletum et Marcellinum Márty-l esse pastóres. Per Dóminum.</l><l xml:id="m-e0af65a8-fe50-4d19-93ce-28fee9c16c26" facs="#m-7302de20-383b-4ac0-b94f-e7d6c415e116" label="lyrics-like">res tuos atque Summos Pontífices,</l><l xml:id="m-b86e056d-5f56-41af-9389-7d1080876316" facs="#m-8ab3b080-3b08-4f12-b794-fdb57455c9b3" label="lyrics-like">Secret. Oblátis. p. 11226. and Postcommunion. Retectióne. p. 1123.</l><l xml:id="m-dc639ded-4960-4fa3-9bf9-d358841418f1" facs="#m-3634c69f-537d-4888-a480-20394d3a6bfa" label="text-like">27. St. Peter Canisius, Conf. and Doctor of the Church.</l><l xml:id="m-08d50e02-bd56-49b9-8a10-d8a98eb2b0f2" facs="#m-e3751191-4d13-4a1c-99c2-843932ef0ceb" label="ambiguous">Double.</l><l xml:id="m-0e85103a-90cf-4aa7-b90c-540f1eb69890" facs="#m-2f6f01e3-f717-411f-b35c-d282479df7d3" label="lyrics-like">At Ist and 2nd Vespers, at Magn. Ant. O Dóctor óptime... beáte</l><l xml:id="m-a2bd87f2-b8b1-4d74-9629-9f6434132209" facs="#m-12d84477-ac30-4f9b-9aff-8be91480c974" label="lyrics-like">Pêtre. p. 2025.</l><l xml:id="m-44dabded-ed73-46fe-ad50-566a0674c131" facs="#m-9fe07a12-6bc0-454d-87b9-e8380bff31ce" label="lyrics-like">Mass. In médio. of Doctors, p. 1190. The Credo. is said.</l><l xml:id="m-5c2e2bb1-5c7d-4349-813c-e4ac4067ed69" facs="#m-f7947e3e-4467-4343-a466-ce361ecf0ed0" label="ambiguous">Collect.</l><l xml:id="m-563e6b8a-0afa-444b-854f-a26086ffe78d" facs="#m-c65fd3c3-c1d8-4d70-aee4-b45b97776c9b" label="lyrics-like">Eus, qui ad tuéndam cathólicam ¡ ejus exémplis et mónitis errántes</l><l xml:id="m-a157a618-98f4-4baa-bc86-5774e1a5f288" facs="#m-df3b19ff-4678-4cb0-bd67-998b01b555e1" label="lyrics-like">I fidem beátum Petrum, Confes-ad salútem resipiscant. * et fidéles</l><l xml:id="m-1580f12f-5e23-46b2-a75e-c86278665de2" facs="#m-4a7fa5a7-710a-4e23-80b6-d4b589f1ad36" label="lyrics-like">in veritátis confessióne persevérent.</l><l xml:id="m-c6fecf13-4cb5-4731-843e-dab4541f9bfa" facs="#m-37fb0543-638d-4810-85c7-0b07d3c414e3" label="lyrics-like">sórem tuum, virtúte et doctrina</l><l xml:id="m-ac3b0127-9d1c-462c-b5ca-39753c56b144" facs="#m-f238bb98-1cfd-4393-93c5-36e71d468aa9" label="lyrics-like">roborásti : t concéde propitius; ut! Per Dóminum.</l></lg></div></section></score></mdiv></body></music>
</mei>