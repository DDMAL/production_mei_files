        <zone xml:id="m-b626dc8a-e963-4722-8cdc-42461679f9af" ulx="242" uly="76" lrx="718" lry="110" /><zone xml:id="m-576cd5a6-034c-4def-b7d4-0ee4c85b526a" ulx="832" uly="78" lrx="912" lry="114" /><zone xml:id="m-54736850-d483-4ce8-bd3a-cf43b150528b" ulx="391" uly="141" lrx="567" lry="172" /><zone xml:id="m-78a54fb9-abe2-47d5-8bfe-f467034ad178" ulx="78" uly="172" lrx="909" lry="212" /><zone xml:id="m-f6f6fb62-ba14-425e-a3c0-dcffc14bc3d3" ulx="51" uly="203" lrx="260" lry="239" /><zone xml:id="m-d5d98ae9-83bd-4d37-8a2e-80a39a97933f" ulx="87" uly="231" lrx="909" lry="268" /><zone xml:id="m-c7c1dcff-eb2f-455e-9e3b-8e502ded0adf" ulx="46" uly="254" lrx="165" lry="290" /><zone xml:id="m-059ad09d-8a8d-4f50-8f8e-01176a7c9d03" ulx="86" uly="280" lrx="861" lry="317" /><zone xml:id="m-fce34c8b-efd6-4cb0-958f-b305826418b1" ulx="86" uly="313" lrx="908" lry="349" /><zone xml:id="m-bdd2626c-a693-4828-a7d6-34c1bd31730b" ulx="46" uly="337" lrx="386" lry="372" /><zone xml:id="m-751494dc-dbc3-4230-83ea-344ecabeadc2" ulx="86" uly="364" lrx="910" lry="405" /><zone xml:id="m-9f602746-d0fb-43e6-ad2d-7cc819e94b11" ulx="48" uly="392" lrx="320" lry="426" /><zone xml:id="m-802d15fe-2087-421f-8527-0608ee3334a4" ulx="87" uly="418" lrx="909" lry="459" /><zone xml:id="m-aa080e60-0c5a-403a-a2a5-a20c49976dfa" ulx="47" uly="448" lrx="369" lry="481" /><zone xml:id="m-bc878130-8dd3-4a5f-aa9b-ec4620612894" ulx="89" uly="473" lrx="902" lry="511" /><zone xml:id="m-32278b09-8994-42e8-a404-af6ce957fdd1" ulx="47" uly="501" lrx="333" lry="531" /><zone xml:id="m-4e8b35ce-e89c-4a9c-8364-8624e19e700d" ulx="86" uly="522" lrx="910" lry="564" /><zone xml:id="m-0a84749b-f734-4997-9fdd-43e65c4e4212" ulx="49" uly="553" lrx="213" lry="588" /><zone xml:id="m-b7b1b3c5-96a3-413d-8d3b-e2b6e24b2bd7" ulx="87" uly="576" lrx="910" lry="613" /><zone xml:id="m-54712ced-07db-4506-9f56-f2a26282a581" ulx="74" uly="606" lrx="910" lry="643" /><zone xml:id="m-ad9b091f-a881-4044-8214-851b351fa066" ulx="49" uly="634" lrx="735" lry="668" /><zone xml:id="m-d329d7d5-48b3-46f3-bdea-f0803d44fc2e" ulx="383" uly="680" lrx="575" lry="720" /><zone xml:id="m-b0db3037-70a0-4871-8b75-f1e630550196" ulx="87" uly="722" lrx="910" lry="761" /><zone xml:id="m-298b93ca-73bb-459f-90dc-78b8d6c64fc7" ulx="49" uly="738" lrx="405" lry="787" /><zone xml:id="m-643d5f1a-9345-4382-b609-120acc974c1a" ulx="87" uly="775" lrx="911" lry="814" /><zone xml:id="m-ca14bfb4-deeb-43fb-8a14-9cba3b531c8e" ulx="48" uly="802" lrx="294" lry="835" /><zone xml:id="m-c20416b1-3626-493d-ac28-9bd3cb7228d5" ulx="87" uly="827" lrx="908" lry="868" /><zone xml:id="m-e2e8bfdc-9701-44e0-856f-0d8e7af4d162" ulx="48" uly="857" lrx="413" lry="893" /><zone xml:id="m-969dd682-58d4-4180-9b0f-152813419afa" ulx="90" uly="882" lrx="910" lry="916" /><zone xml:id="m-709928d0-bbf1-4182-a810-8df7523b970a" ulx="51" uly="908" lrx="604" lry="943" /><zone xml:id="m-f02ed9c0-3a70-44fe-a161-104365a58386" ulx="88" uly="935" lrx="850" lry="968" /><zone xml:id="m-71b19c18-e07c-49fa-ac24-68c94af58f72" ulx="87" uly="961" lrx="898" lry="999" /><zone xml:id="m-48a81b8b-12ce-4d4a-bc1b-d615022c7448" ulx="48" uly="988" lrx="334" lry="1022" /><zone xml:id="m-3ac29fbb-f872-460c-80fb-ae6055ee8dd7" ulx="88" uly="1012" lrx="914" lry="1053" /><zone xml:id="m-19976258-467d-4c5f-a8e2-f440eb10d4df" ulx="48" uly="1042" lrx="369" lry="1078" /><zone xml:id="m-9b583451-f092-4140-b629-73efa8e27cb4" ulx="87" uly="1064" lrx="910" lry="1106" /><zone xml:id="m-e9e12949-5eeb-4b4d-977f-c5e8ceaab6c7" ulx="48" uly="1101" lrx="297" lry="1131" /><zone xml:id="m-5fc3f480-9c9f-4ae8-bcce-d68bfafbdaa1" ulx="87" uly="1117" lrx="911" lry="1160" /><zone xml:id="m-78abcab9-5bc6-4b61-8e86-8fa7a53423e4" ulx="49" uly="1154" lrx="280" lry="1184" /><zone xml:id="m-c0af8273-4910-4f9b-9b05-15b4194bb81e" ulx="77" uly="1170" lrx="902" lry="1216" /><zone xml:id="m-d8248812-e63a-44f4-bf9d-7d43752846a2" ulx="48" uly="1205" lrx="415" lry="1241" /><zone xml:id="m-505dfc68-6fe8-4df7-9d41-c5cd4cf5c21a" ulx="406" uly="1247" lrx="549" lry="1284" /><zone xml:id="m-fa4302ad-ffec-4842-8242-53b8fdf1cc58" ulx="87" uly="1282" lrx="911" lry="1324" /><zone xml:id="m-3c5b1a2c-4688-4cdd-a7da-57a7d0a961df" ulx="46" uly="1288" lrx="170" lry="1349" /><zone xml:id="m-ffa730ed-be03-4393-9744-de2b0a79d6ff" ulx="86" uly="1336" lrx="909" lry="1376" /><zone xml:id="m-6b9691d0-c9a3-4f49-90e1-3d72df56372b" ulx="45" uly="1365" lrx="332" lry="1402" /><zone xml:id="m-302fc46f-aa0e-4765-97bf-fa6c33adbd32" ulx="85" uly="1395" lrx="880" lry="1426" /><zone xml:id="m-dd2cb0d7-3924-4844-a104-c6b2c1cda091" ulx="84" uly="1422" lrx="910" lry="1457" /><zone xml:id="m-41b54f77-0328-46d6-846f-15ac8d130237" ulx="43" uly="1445" lrx="125" lry="1483" /><zone xml:id="m-2502e76f-2927-4872-8f55-6d19e12b5e79" ulx="85" uly="1469" lrx="909" lry="1511" /><zone xml:id="m-6fc7c37f-2de9-4aac-a4c8-2e55c7a2aa38" ulx="45" uly="1497" lrx="95" lry="1533" /></surface>
    </facsimile>
    <body xml:id="m-f7ada9c6-fb45-4f24-87b4-902006796cbc">
      <mdiv xml:id="m-39a6d071-6b53-49db-ad8c-ec87e2cae676" type="solesmes">
        <score xml:id="m-3fba696b-18b9-450f-9649-2b0ec5ea5f8e">
          <section xml:id="m-09a49b5d-38c8-4cf5-848d-8078952ee83b">
            <pb xml:id="m-9e51fef5-ca2b-469c-9e78-4e9e03e3bd03" n="0415" facs="#m-86b7fd1a-348d-4a64-8b45-f1e171a0fb90" />
            <div xml:id="m-26293ddb-ce37-4fe6-891f-d91963e4b0cf">
              <lg xml:id="m-00ff2af0-10c7-454e-870d-a471f9bde871">
                <l xml:id="m-4790be78-dabd-4a28-a2ab-d1dd5b0864b6" facs="#m-b626dc8a-e963-4722-8cdc-42461679f9af" label="text-like">for Feasts whicn are not I. class.</l><l xml:id="m-33d33288-4563-464f-8ddf-4a903fbcfbc6" facs="#m-576cd5a6-034c-4def-b7d4-0ee4c85b526a" label="ambiguous">2791</l><l xml:id="m-04c1dc88-191a-47bc-acae-838a34ed6f03" facs="#m-54736850-d483-4ce8-bd3a-cf43b150528b" label="ambiguous">Psalm 58. I.</l><l xml:id="m-a7012102-9d15-4d50-b220-3be3cd10c409" facs="#m-78a54fb9-abe2-47d5-8bfe-f467034ad178" label="lyrics-like">"Ripe me de inimicis méis, Déus méus: “ insurgéntibus in</l><l xml:id="m-9a27f670-d269-4f00-8580-dc83c39cf795" facs="#m-f6f6fb62-ba14-425e-a3c0-dcffc14bc3d3" label="ambiguous">U me libera me.</l><l xml:id="m-f8ffa7a1-b0a9-458e-a8b8-8a3faaccf65c" facs="#m-d5d98ae9-83bd-4d37-8a2e-80a39a97933f" label="lyrics-like">2. Eripe me de operántibus iniquitátem :“t de viris sánguinum</l><l xml:id="m-b1c4e980-3cb8-481b-a6d2-359e8fc2a186" facs="#m-c7c1dcff-eb2f-455e-9e3b-8e502ded0adf" label="lyrics-like">sálva me.</l><l xml:id="m-084186c7-a430-4683-8046-800a556fa245" facs="#m-059ad09d-8a8d-4f50-8f8e-01176a7c9d03" label="lyrics-like">3. Quia ecce cepérunt ánimam méam : * irruérunt in me fórtes.</l><l xml:id="m-cf0f0948-a6ea-479d-98f5-f54506289c9f" facs="#m-fce34c8b-efd6-4cb0-958f-b305826418b1" label="lyrics-like">4. Neque iníquitas méa, neque peccátum méum, Dómine: "sine</l><l xml:id="m-815230ac-e0d1-4b65-b94b-9504e00e03d3" facs="#m-bdd2626c-a693-4828-a7d6-34c1bd31730b" label="lyrics-like">iniquitáte cucúrri, et diréxi.</l><l xml:id="m-76b3de48-632a-4172-81c1-d6e94ec847d2" facs="#m-751494dc-dbc3-4230-83ea-344ecabeadc2" label="lyrics-like">5. Exsúrge in occúrsum méum, et vide: “et tu, Dómine Déus</l><l xml:id="m-65379b1c-c106-4a08-aa1e-602191390433" facs="#m-9f602746-d0fb-43e6-ad2d-7cc819e94b11" label="lyrics-like">virtútum, Déus Israel.</l><l xml:id="m-36a5a5a2-4e28-4254-9823-0d52683463a2" facs="#m-802d15fe-2087-421f-8527-0608ee3334a4" label="lyrics-like">6. Inténde ad visitándas ómnes gentes:nn misereáris ómnibus</l><l xml:id="m-5cc170e2-25c6-44d9-b6b3-f2806f23217c" facs="#m-aa080e60-0c5a-403a-a2a5-a20c49976dfa" label="lyrics-like">qui operantur iniquitátem.</l><l xml:id="m-7d26e350-4ae5-41ea-9f94-1f8b66fa0beb" facs="#m-bc878130-8dd3-4a5f-aa9b-ec4620612894" label="lyrics-like">7 Converténtur ad vésperam, et fámem patiéntur ut cánes,</l><l xml:id="m-99d66d3a-1b73-41ff-b184-d8b09d99f7c0" facs="#m-32278b09-8994-42e8-a404-af6ce957fdd1" label="lyrics-like">et circuibunt civitátem.</l><l xml:id="m-26607c48-f3e3-4365-8951-475b3b2d1b83" facs="#m-4e8b35ce-e89c-4a9c-8364-8624e19e700d" label="lyrics-like">8. Ecce loquéntur in óre súo, f et gládius in lábiis eórum :"quóniam</l><l xml:id="m-a84c7e5d-1aef-4a9b-9cf9-52df78cafb58" facs="#m-0a84749b-f734-4997-9fdd-43e65c4e4212" label="ambiguous">quis audivit?</l><l xml:id="m-c02a29db-3993-4aa5-8401-1ce3fd5f294c" facs="#m-b7b1b3c5-96a3-413d-8d3b-e2b6e24b2bd7" label="lyrics-like">9. Et tu, Dómine, deridébis éos :“ ad níhilum dedúces ómnes géntes.</l><l xml:id="m-369c31f6-2089-4c58-ba88-c0bcf60df452" facs="#m-54712ced-07db-4506-9f56-f2a26282a581" label="lyrics-like">10. Fortitúdinem méam ad te custódiam, t quia Déus suscéptor</l><l xml:id="m-af37bfba-e46d-4643-92f7-f530bacade2a" facs="#m-ad9b091f-a881-4044-8214-851b351fa066" label="lyrics-like">méus es : " Deus meus, misericórdia éjus praevéniet me.</l><l xml:id="m-c3c8a08b-d8a2-4bbf-b532-6e7388883330" facs="#m-d329d7d5-48b3-46f3-bdea-f0803d44fc2e" label="ambiguous">Psalm 58. II.</l><l xml:id="m-4770ce56-3b6c-4c05-9a31-567ca39ce6a4" facs="#m-b0db3037-70a0-4871-8b75-f1e630550196" label="lyrics-like">Eus osténdet mihi super inimícos méos, ne occídas éos : “ nequándo</l><l xml:id="m-423b6411-ad00-4002-b95c-55e0aa474102" facs="#m-298b93ca-73bb-459f-90dc-78b8d6c64fc7" label="lyrics-like">D obliviscantur pópuli méi.</l><l xml:id="m-9e7a47fa-60ed-4a73-9ae6-cc2dfa7b69a7" facs="#m-643d5f1a-9345-4382-b609-120acc974c1a" label="lyrics-like">2. Dispérge illos in virtúte túa: * et depóne éos, proté¬</l><l xml:id="m-17a18b73-54d0-4427-9549-b128920931a5" facs="#m-ca14bfb4-deeb-43fb-8a14-9cba3b531c8e" label="lyrics-like">ctor méus, Dómine:</l><l xml:id="m-e2cef79a-bf8b-4482-813b-6e0e9326fc44" facs="#m-c20416b1-3626-493d-ac28-9bd3cb7228d5" label="lyrics-like">3. Delictum óris eórum, sermónem labiórum ipsórum:</l><l xml:id="m-a9287899-ab3c-4e7c-9dd6-eb098a76602a" facs="#m-e2e8bfdc-9701-44e0-856f-0d8e7af4d162" label="lyrics-like">prehendantur in supérbia súa.</l><l xml:id="m-61d67dc3-97a6-4fb3-b4a2-770e6908aa8c" facs="#m-969dd682-58d4-4180-9b0f-152813419afa" label="lyrics-like">4. Et de exsecratiône et mendácio annuntiabúntur in consumma¬</l><l xml:id="m-555cbd6c-4c14-4ac3-92ba-2992c206b30f" facs="#m-709928d0-bbf1-4182-a810-8df7523b970a" label="lyrics-like">tióne : * in fra consummatiónis, et non érunt.</l><l xml:id="m-cc8acf31-14fd-44a1-89a7-c428d66b77af" facs="#m-f02ed9c0-3a70-44fe-a161-104365a58386" label="lyrics-like">5. Et scient quia Déus dominábitur Jacob:* et finium térrae.</l><l xml:id="m-0a9a93b8-f6cf-407b-a1c8-a2d4dedca927" facs="#m-71b19c18-e07c-49fa-ac24-68c94af58f72" label="lyrics-like">6. Converténtur ad vésperam, et fâmem patiéntur ut cánes:</l><l xml:id="m-d4e5921f-4f7e-43f0-acfe-7d9ae2398085" facs="#m-48a81b8b-12ce-4d4a-bc1b-d615022c7448" label="lyrics-like">et circuibunt civitátem.</l><l xml:id="m-a30b7377-f9f5-458f-8f20-70c8c9c735df" facs="#m-3ac29fbb-f872-460c-80fb-ae6055ee8dd7" label="lyrics-like">7. Ipsi dispergéntur ad manducándum:vero non fuerint</l><l xml:id="m-319f5963-cd87-4df7-9965-eed1ede37440" facs="#m-19976258-467d-4c5f-a8e2-f440eb10d4df" label="lyrics-like">saturáti, et murmurábunt.</l><l xml:id="m-acc5e88a-8d7c-4de3-bb74-07f98191978b" facs="#m-9b583451-f092-4140-b629-73efa8e27cb4" label="lyrics-like">8. Ego autem cantábo fortitúdinem túam: “t exsultábo mane</l><l xml:id="m-c64f8d58-6ff5-45ec-b308-62c4a3a8bd91" facs="#m-e9e12949-5eeb-4b4d-977f-c5e8ceaab6c7" label="lyrics-like">misericórdiam túam.</l><l xml:id="m-da810868-1ee6-417f-a399-729e22dab2f8" facs="#m-5fc3f480-9c9f-4ae8-bcce-d68bfafbdaa1" label="lyrics-like">9. Quia fáctus es suscéptor méus, et refúgium méum, in die</l><l xml:id="m-45145b5f-b8b1-4d13-bfd0-b31d86ef9bf7" facs="#m-78abcab9-5bc6-4b61-8e86-8fa7a53423e4" label="lyrics-like">tribulatiónis méae.</l><l xml:id="m-70fad0f6-d67d-47c7-a2c7-bc06a9505472" facs="#m-c0af8273-4910-4f9b-9b05-15b4194bb81e" label="lyrics-like">10. Adjútor méus, tibi psâllam, f quia, Déus, suscéptor méus es:</l><l xml:id="m-c327c761-5ed0-4fc8-86ff-5bc8b9a37103" facs="#m-d8248812-e63a-44f4-bf9d-7d43752846a2" label="lyrics-like">Déus méus, misericórdia méa.</l><l xml:id="m-8a965c02-0b5a-4821-9391-0a7fc862c5ed" facs="#m-505dfc68-6fe8-4df7-9d41-c5cd4cf5c21a" label="ambiguous">Psalm 59.</l><l xml:id="m-48c466a7-afae-4838-bee8-0cd1873835ef" facs="#m-fa4302ad-ffec-4842-8242-53b8fdf1cc58" label="lyrics-like">Eus, repulisti nos, et destruxisti nos: “irátus es, et misértus es</l><l xml:id="m-8fe4cc39-7321-4e59-bd26-741f24ff5e08" facs="#m-3c5b1a2c-4688-4cdd-a7da-57a7d0a961df" label="ambiguous">Dnevis</l><l xml:id="m-d566ed36-a2c4-4b0d-ae08-d6267b609fe9" facs="#m-ffa730ed-be03-4393-9744-de2b0a79d6ff" label="lyrics-like">2. Commovísti térram, et conturbásti éam:“sána contritiónes</l><l xml:id="m-a1a0783d-88d8-4e7c-a20b-282970070c2f" facs="#m-6b9691d0-c9a3-4f49-90e1-3d72df56372b" label="lyrics-like">éjus, quia commóta est.</l><l xml:id="m-3a88bd9f-9216-4f99-a370-195d23b04d1c" facs="#m-302fc46f-aa0e-4765-97bf-fa6c33adbd32" label="lyrics-like">3. Ostendísti pópulo túo dúra : " potásti nos vino compunctiónis.</l><l xml:id="m-ad6df43a-fe1c-4e4c-97e9-0a258bd7179b" facs="#m-dd2cb0d7-3924-4844-a104-c6b2c1cda091" label="lyrics-like">4. Dedisti métuéntibus te significatiónem: fugiant a fácie</l><l xml:id="m-cd40fb25-f677-4e7a-9fa6-4f4667ba34a5" facs="#m-41b54f77-0328-46d6-846f-15ac8d130237" label="lyrics-like">árcus</l><l xml:id="m-1bca27f7-0651-4616-ab7b-88984e11a9cb" facs="#m-2502e76f-2927-4872-8f55-6d19e12b5e79" label="lyrics-like">5. Ut liberéntur dilécti túi: “sálvum fac déxtera túa, et exáudi</l><l xml:id="m-4a73cbbb-8198-464e-82c6-39447c3a0f27" facs="#m-6fc7c37f-2de9-4aac-a4c8-2e55c7a2aa38" label="ambiguous">me.</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>