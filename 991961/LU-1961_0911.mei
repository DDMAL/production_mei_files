                  <syl /><neume facs="#m-e1aa5653-efdd-48b4-8b5a-3cf85a79c652" type="punctum" xml:id="m-899c092f-c2ee-4541-b5b7-42d65c2a8055">
                    <nc xml:id="m-53afc866-7bdc-4aac-9719-4f55ed46701a" pname="c" oct="4" />
                  </neume>
