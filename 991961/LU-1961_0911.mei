                <syllable xml:id="m-e79d9586-d307-4bdc-add2-ae7d0a6ac19c">
                  <syl /><neume facs="#m-97e218c3-f473-453a-a8c1-690dc8ed7cee" type="clivis" xml:id="m-736740d9-6036-4c14-9223-848bfd6088a1">
                    <nc xml:id="m-9bda31cd-6d67-4649-a7d4-80aeb9929035" pname="c" oct="4" />
