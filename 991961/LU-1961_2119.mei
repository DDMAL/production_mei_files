            <layer xml:id="m-79f7f80d-b0b8-4256-b468-56f5696f479a" n="1">
              </layer></staff><div xml:id="m-7023d740-df94-451a-8d98-48d412bf1354"><lg xml:id="m-57d03ab3-34ef-40b8-bab1-5052f7af30bc"><l xml:id="m-1fc55a1a-4cb0-4bbd-8f9e-f9855a6f85f7" facs="#m-5613a73e-2ae5-43b9-838b-0a8b1e394cd4" label="ambiguous">1875</l><l xml:id="m-d1a1cd2c-3170-4b97-a1ba-43f005899720" facs="#m-270a0982-929b-4fed-a057-dbd6307cff7d" label="text-like">At Eas</l><l xml:id="m-74e9c9f2-9cd2-4627-acef-971835005827" facs="#m-538f6cb9-3b03-45da-9b73-5bc1d53f1336" label="ambiguous">ter.</l><l xml:id="m-3a8792f2-06fb-45e6-9491-0fb76a9ffc9b" facs="#m-8bafb070-9524-4ea7-9e71-9357c436160e" label="text-like">AT EAS</l><l xml:id="m-2af40f1b-82f3-4b51-bd54-5f38e1a7bd5d" facs="#m-3fb62790-1f04-4b84-8d89-962347730ed4" label="ambiguous">TER.</l><l xml:id="m-a5d5afb3-b2f8-4a2c-9826-11f0bfeda00e" facs="#m-12ed1f91-ba74-40d3-9166-d28cdf3db7c9" label="lyrics-like">Al-le- lú- ia, Al-le¬</l><l xml:id="m-60219425-47e6-4e71-a03e-016a86e4529c" facs="#m-a41cedf5-2147-4c57-9a00-3fe162fa7b44" label="lyrics-like">lú- ia, Al-le- lú¬ ia.</l><l xml:id="m-b8a2858d-85c3-4e47-9652-265f7ac4b488" facs="#m-79d075cb-3885-4970-9721-df1f8b63e8c6" label="lyrics-like">The Choir repeats: Allelúia.</l><l xml:id="m-2b77f357-84ea-4c80-907e-3a63c548f131" facs="#m-169f2e66-10ca-468d-90ad-b65bf33601a3" label="lyrics-like">1.Off- 1i-et fí- li-ae, R</l><l xml:id="m-a788216c-e388-4acb-87ad-3034a51d4795" facs="#m-01eab0f1-1d7c-42a5-8cb1-076dcc9ad54f" label="lyrics-like">lex cae-lé-stis, Rexgló¬ ri¬</l><l xml:id="m-afebd995-0467-49be-be86-d11d2b3a1074" facs="#m-50ca2fad-f42c-4326-b88d-7061d36bf29d" label="lyrics-like">ae, Mór-te sur-ré¬ xit hó</l><l xml:id="m-6cc69c10-e67a-40ad-8335-d5822f8232f1" facs="#m-89c67af8-38a9-4c59-9f9d-6456197d83e7" label="lyrics-like">- di- e, Al-le- lú- ia.</l><l xml:id="m-7ea8398c-c811-4ea1-a1fe-ce413ecf4f64" facs="#m-1446dd34-2f62-4644-9eac-3754bdb0728c" label="ambiguous">7.</l><l xml:id="m-102e8e4a-6a18-4373-acc8-4b1888a36872" facs="#m-f5e140bd-6ce0-4271-a0a3-1a070cd5b645" label="ambiguous">2.</l><l xml:id="m-ea43a517-2667-4c4a-8dca-afa9e0986cea" facs="#m-ab7de8d5-8b12-4e38-aa12-74fb3ed87b17" label="lyrics-like">Ut intelléxit Didymus,</l><l xml:id="m-61b8b0d2-de37-4da2-93c6-e7a106a266a6" facs="#m-fef8211a-236f-4064-8f2f-0aa51641f493" label="lyrics-like">Et máne príma sábbati,</l><l xml:id="m-ea3dea4d-ffee-42d8-b08c-a765c5138d45" facs="#m-aed75fc8-8bc1-4d37-8177-e58595a960a4" label="lyrics-like">Quia surréxerat Jésus,</l><l xml:id="m-b67a4950-dde6-4ee4-b72d-b35cf1dfba5f" facs="#m-7284aa73-d13a-45d9-bcad-5123918fb934" label="lyrics-like">Ad óstium monuménti</l><l xml:id="m-f6ff5952-5a5a-4a38-8a38-3ca9b3f723ac" facs="#m-268e5f4d-b489-4835-b868-b38fb423ab9b" label="lyrics-like">Remánsit fere dúbius.</l><l xml:id="m-60f30fa3-0d37-4e64-bfd0-59ac8cbc9295" facs="#m-15b108f1-255d-4559-b205-bfc2640b4d7f" label="lyrics-like">Accessérunt discípuli.</l><l xml:id="m-2dca524b-9f3f-4ecb-9142-6ecaa311df57" facs="#m-acee4640-151e-4071-9ebd-f1d8df5d5f36" label="ambiguous">8.</l><l xml:id="m-dd216ce3-e757-4d6b-9e62-6365f249a409" facs="#m-cfae0bad-e953-4ceb-9ba3-05fa2009e730" label="ambiguous">3.</l><l xml:id="m-0ea62464-9b22-46f8-9c70-60251b5f8201" facs="#m-2801326c-ceb8-44e2-914a-f4860e1afe45" label="lyrics-like">Vide, Thóma, víde látus,</l><l xml:id="m-6bf8fd72-962f-4625-ac30-ce1575713d68" facs="#m-500b6e81-8887-4119-8e27-f0ab92ec37c2" label="lyrics-like">Et María Magdaléne,</l><l xml:id="m-cecc34c3-c42a-4015-be0f-9e00f79aead6" facs="#m-d2b93141-ee62-47a0-bc61-bfef9f9f6a24" label="lyrics-like">Vide pédes, víde mánus,</l><l xml:id="m-e7dafab8-e0f8-4c6c-b568-0e0f65f11a48" facs="#m-3694bfeb-13cd-438b-996e-f34d6bd649c1" label="lyrics-like">Et Jacóbi, et Salóme,</l><l xml:id="m-0fb643a3-0677-4e17-803c-cf55a6a48014" facs="#m-39cb57ec-0baf-4c04-abfd-feafec9d2b75" label="lyrics-like">Nóli ésse incrédulus.</l><l xml:id="m-b81575a0-8ef3-4184-9bbb-ed55e9409102" facs="#m-88f777b7-b179-4073-85c3-4b3c314601cb" label="lyrics-like">Venérunt córpus úngere.</l><l xml:id="m-ecbb7791-987a-4d45-9eba-04933acd6f49" facs="#m-1410c4c2-a6e3-4b7e-bc89-be8e4afc7735" label="ambiguous">9.</l><l xml:id="m-e9437e69-3ed6-428c-aed9-57c91942a89c" facs="#m-6cf37f97-dd0c-4f4b-8dae-d5610612d240" label="ambiguous">4.</l><l xml:id="m-2050a620-5dcd-4404-b311-ebf16aa825c0" facs="#m-9ab87a20-eccf-412a-8bd5-9c36afd783c8" label="lyrics-like">Quando Thómas Christi látus,</l><l xml:id="m-649afe60-7459-4072-bfcc-932ca4de63db" facs="#m-dff1c17d-d1aa-4190-92fc-222a6cc87881" label="lyrics-like">In albis sédens Angelus</l><l xml:id="m-5d230daa-7aec-448b-9405-f6a20b56740b" facs="#m-130ad5c4-c063-4f66-b70d-5f266f49732b" label="lyrics-like">Pédes vídit atque mánus,</l><l xml:id="m-0d1bce76-9c1c-4d3a-8310-e9a4c0cde706" facs="#m-e7d5bcde-120e-4f3e-9d54-c6080e096e7a" label="lyrics-like">Praedixit muliéribus:</l><l xml:id="m-1a747c04-3bdf-48e2-a568-b9ce5b686049" facs="#m-6c939cd5-3b8c-488d-b259-ec52a5514637" label="lyrics-like">Díxit: Tu es Déus méus.</l><l xml:id="m-f8cc210b-433b-44f7-b5f0-61f34f826c16" facs="#m-ddbbf15e-c0e3-4ea6-a2e1-3a3ea40211c5" label="lyrics-like">In Galilaéa est Dóminus.</l><l xml:id="m-5b694707-37b8-4c18-ad2a-6f5e7df7e7e8" facs="#m-ab9a8f88-5539-42f3-840f-b9fa292b7750" label="ambiguous">10.</l><l xml:id="m-dadd87ed-5868-4cbe-80fe-2e3d0602e365" facs="#m-483d3587-18e0-4ae0-b70c-7e9efc61effa" label="ambiguous">5.</l><l xml:id="m-ab4ee27c-3c2c-41bf-9627-b3fcb04268d3" facs="#m-7a367eff-2c4f-4069-b22c-86fbc3033a9e" label="lyrics-like">Beáti qui non vidérunt,</l><l xml:id="m-170565d9-9cc7-4ac2-87af-4e412b3566e1" facs="#m-479e5b92-ac95-4b03-bfd5-a02b0fa672ce" label="lyrics-like">Et Joánnes Apóstolus</l><l xml:id="m-7a5bdb21-4d46-47de-aa3c-b3ba9a4be303" facs="#m-28a41365-6ff8-49e0-8dc5-e895ae158ac4" label="lyrics-like">Et firmiter credidérunt,</l><l xml:id="m-6164e03a-da36-4321-9b47-153d3879e6ff" facs="#m-5482e56f-a7e2-47f8-9955-3501e1556e2b" label="lyrics-like">Cueurrit Pétro citius,</l><l xml:id="m-def8ecee-ad0a-4a09-abf1-c3322ee6ef42" facs="#m-1398bbb0-8914-436e-9b05-76973508b899" label="lyrics-like">Vitam aetérnam habébunt.</l><l xml:id="m-aa1efb55-e72f-4388-b556-e44114d5095c" facs="#m-125794d9-9b3e-4817-b27c-9860b8162e5c" label="lyrics-like">Monuménto vénit prius.</l><l xml:id="m-1bd7fa97-085f-48ba-b144-7fc9ee32a8e7" facs="#m-62ef7faa-cc8f-4cd6-85c3-5f1afc42306f" label="ambiguous">11.</l><l xml:id="m-12a05d67-8f69-472e-b04b-95a9e65dd56a" facs="#m-22421c0f-ef60-432e-9794-84ef41f4b9d7" label="ambiguous">6.</l><l xml:id="m-bd5f264f-a13c-4d52-b009-36f42ab594a7" facs="#m-1b77b7b2-0203-47aa-9da3-2b96ee081728" label="lyrics-like">Discípulis adstántibus,</l><l xml:id="m-4903b348-17a6-4443-9165-12dece2c4fd4" facs="#m-a887952a-7dd3-4dc7-aac2-850d29a83128" label="lyrics-like">In hoc fésto sanctíssimo</l><l xml:id="m-0f96a7e5-1ed2-4769-ab5e-df18e2973381" facs="#m-2f19674d-f623-436f-a19a-46e00f197b32" label="lyrics-like">Sit laus et jubilátio,</l><l xml:id="m-09ab5a43-9815-4d66-8084-cb497fb7e5a8" facs="#m-64eb5fa7-07bb-4498-9b7c-6fd4088d60c7" label="lyrics-like">In médio stétit Christus,</l><l xml:id="m-f4fef546-22d4-4ca3-a542-ad83163dfddc" facs="#m-dbd0a3ce-0217-41fb-884a-6bf152fdd88f" label="lyrics-like">BENEDICÁMUS DÓMINO.</l><l xml:id="m-922cbce8-3930-4898-8dc1-cff15cb0d731" facs="#m-8ad6740c-4331-41a7-aef5-8abdbbe119f9" label="lyrics-like">Dícens: Pax vóbis ómnibus.</l><l xml:id="m-a5a1ff08-e338-4c2c-b6ae-3a02a6e15088" facs="#m-225acfe4-da7a-40e4-87b7-b70614b9af0b" label="ambiguous">12.</l><l xml:id="m-1911417a-6215-4e71-a962-5e1aa770fa8c" facs="#m-6245a85b-4b91-428c-9dbd-473926e706d8" label="lyrics-like">Ex quíbus nos</l><l xml:id="m-b35602ab-5d7f-49f2-a6b9-7bbf277b4acb" facs="#m-7b434497-1254-4a86-84bc-2a14a961c528" label="lyrics-like">humíllimas</l><l xml:id="m-da116a34-8d8f-4f1e-87a0-d5c69b7ae20b" facs="#m-05238c7c-7fc0-4bc4-9ec4-533ba72e6aa5" label="lyrics-like">Devótas atque</l><l xml:id="m-32b112f7-00c2-4f56-a187-e108daf72311" facs="#m-3372b9de-ceb1-4f43-98b4-6a348b779e36" label="lyrics-like">débitas</l><l xml:id="m-b0a150bb-00a6-41c5-8405-809196221cde" facs="#m-e7daf515-790a-4e77-995c-1eacda941f8b" label="lyrics-like">Deo dicámus </l><l xml:id="m-c53cd27d-f571-4686-a475-69e6cb363045" facs="#m-08d44a44-37e1-4e18-b621-04e3e4a97982" label="lyrics-like">TRÁTIAS.</l></lg></div></section></score></mdiv></body></music>
</mei>