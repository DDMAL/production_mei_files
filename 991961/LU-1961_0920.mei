                <clef xml:id="m-7ff9c88b-b292-4813-b5bf-7373847c23c6" facs="#m-4da53ec3-27a7-4edb-8418-520139a0bbdb" line="3" shape="C" />
                <syllable xml:id="m-70986d38-ff4f-4c5c-a2a7-dd342f3127d5">
