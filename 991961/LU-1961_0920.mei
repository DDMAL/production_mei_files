                <syllable xml:id="m-a16413e4-6c96-422f-9b70-d55f4a892a5e">
                  <syl /><neume facs="#m-e49ec200-5dd1-4645-99cc-470d12a8e1c1" type="punctum" xml:id="m-0d192c51-4655-4b0a-bfa6-83525b879187">
                    <nc xml:id="m-0a49dbe3-c0e1-4b35-a9ae-645dbfb2c7af" pname="d" oct="4" />
                  </neume>
                </syllable>
