                  <syl /><neume facs="#m-5971e17b-0ebb-4df8-98be-cd0d1fefeb7d" type="punctum" xml:id="m-dd842592-a5ec-49e4-bbf9-aed570b0565c">
                    <nc xml:id="m-3e6eb051-9f1b-41ff-a8aa-1334b95c3cd9" pname="d" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-e8a793e7-f764-4cd9-a57b-94db29cc9d74">
                  <syl /><neume facs="#m-65c3be1f-afbb-45a4-8dd8-e4b549c9a906" type="punctum" xml:id="m-7aa00e3d-27af-443e-9f6f-3d7639f85b70">
                    <nc xml:id="m-9491fe81-59e3-47d8-b6d4-54a8dfdc479f" pname="c" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-309e3b32-ca42-4947-939e-8125efd1112a">
                  <syl /><neume facs="#m-20648441-c18d-4203-b0fd-a0bb14781d48" type="punctum" xml:id="m-b0cc15a5-6d5f-4941-8106-0a7b8678b31e">
                    <nc xml:id="m-9f5431d5-f777-4b29-abef-730331860092" pname="c" oct="4">
                      <signifLet xml:id="m-3745568e-9ae6-44fb-9ea6-b96f85dccc4f" />
