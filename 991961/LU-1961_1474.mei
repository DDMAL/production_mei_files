"997" lry="844" /><zone xml:id="m-82a4b768-8dcf-45de-8bce-39a2215a50d1" ulx="135" uly="812" lrx="560" lry="847" /><zone xml:id="m-3dc06c62-00c6-4c9f-b837-f239d79fd5d7" ulx="569" uly="836" lrx="997" lry="870" /><zone xml:id="m-2fc2fb84-24e4-4869-b2c2-115995a60f59" ulx="135" uly="843" lrx="560" lry="871" /><zone xml:id="m-6bebd5ce-eb92-4220-bfa2-58f3743beed9" ulx="135" uly="866" lrx="561" lry="900" /><zone xml:id="m-5f565f55-9edc-4d10-b345-82e7b6ccf741" ulx="570" uly="866" lrx="997" lry="899" /><zone xml:id="m-0cb69fbb-19f3-49ff-9fd5-6543ad73111a" ulx="570" uly="890" lrx="996" lry="923" /><zone xml:id="m-4d581296-c0fb-43cc-89ad-43dc2858a489" ulx="134" uly="891" lrx="560" lry="923" /><zone xml:id="m-1be9425b-edb7-4c8a-90f1-69f93479e317" ulx="571" uly="918" lrx="996" lry="949" /><zone xml:id="m-ae198126-bb07-40f8-87c1-3eaaa8e79be0" ulx="134" uly="920" lrx="558" lry="949" /><zone xml:id="m-54b897ec-5e45-40a5-b167-76f57a3c3607" ulx="135" uly="941" lrx="560" lry="978" /><zone xml:id="m-f845187c-fb59-4a2e-9db7-0b77614a268d" ulx="570" uly="943" lrx="996" lry="980" /><zone xml:id="m-40c8f7bb-3d6f-4012-81c9-600b4c048cc4" ulx="135" uly="969" lrx="560" lry="1004" /><zone xml:id="m-2d780b28-ffc0-4085-880d-bfa75e78a787" ulx="570" uly="970" lrx="800" lry="1003" /><zone xml:id="m-88e99e24-89ea-43c1-9be3-91da0ccfca29" ulx="136" uly="996" lrx="560" lry="1031" /><zone xml:id="m-9cb1bff1-00e8-463c-bcff-e97aaf25677c" ulx="160" uly="1029" lrx="562" lry="1065" /><zone xml:id="m-e254fc7a-a99e-407b-8f16-86cb9300b763" ulx="160" uly="1062" lrx="772" lry="1099" /><zone xml:id="m-a0ebec65-1249-4cb3-9804-2054f61df3bb" ulx="157" uly="1095" lrx="997" lry="1132" /><zone xml:id="m-391d2d1d-8486-4551-948f-f5247b07cb08" ulx="133" uly="1127" lrx="500" lry="1155" /><zone xml:id="m-054a7aa7-4a3b-49e0-890a-f22bdc8e3e19" ulx="160" uly="1154" lrx="698" lry="1186" /><zone xml:id="m-37b86f78-7212-44bb-b51c-6b2e88979cfb" ulx="160" uly="1187" lrx="613" lry="1221" /><zone xml:id="m-64201868-8676-4181-8cac-c75015f8ba1e" ulx="518" uly="1228" lrx="614" lry="1268" /><zone xml:id="m-fa7e94a5-3fda-4df0-9faa-9e48c2d3b1ae" ulx="173" uly="1256" lrx="997" lry="1299" /><zone xml:id="m-e11dc53a-ea1a-4768-be4d-26f5be74f058" ulx="141" uly="1288" lrx="820" lry="1324" /><zone xml:id="m-52b75939-67d6-4f10-a8cd-85c0ad10d56d" ulx="136" uly="1317" lrx="570" lry="1352" /><zone xml:id="m-515dd3e4-0f5c-42ec-bf2f-03dd2c7e696a" ulx="158" uly="1348" lrx="493" lry="1388" /><zone xml:id="m-7263fbee-5be2-4e20-a3ac-db46f4ba38b9" ulx="160" uly="1380" lrx="718" lry="1420" /><zone xml:id="m-378e057d-cb4e-41c9-9097-e7eb3989c0e9" ulx="454" uly="1426" lrx="690" lry="1458" /><zone xml:id="m-a9593c30-74a7-45bb-8e36-1e1e0e252c96" ulx="165" uly="1453" lrx="998" lry="1494" /><zone xml:id="m-7cf2a9c6-049b-45cf-9a78-86c53d6d6f03" ulx="139" uly="1482" lrx="755" lry="1516" /><zone xml:id="m-3eaddeaa-ff40-40f9-8f21-71fcec852085" ulx="138" uly="1511" lrx="564" lry="1548" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-29ff3b3e-2bc6-42ef-8ee8-8d01d1e993bd" n="1474" facs="#m-38669679-34dd-4a1c-9f3d-2ffa4869639a" /><div xml:id="m-728d0cb4-77a0-41cc-9951-4afdd114d634">
            <lg xml:id="m-69d64620-d171-4f9f-b5dd-256624ab65b2">
              <l xml:id="m-3ebb597e-7c7d-4a4c-a601-ce288516ba75" facs="#m-e0985e0c-ac21-42fc-a5f3-f371ceca7376" label="text-like">1278 Votive Mass of the Holy Aposties Peter and Paul.</l><l xml:id="m-94af2157-e166-4ed2-a73c-5f9716d4a2de" facs="#m-c0ca7562-c29e-44d1-9e64-d0f3e8aa7fb4" label="lyrics-like">P. T. t Chrí-stus, alle-lú-ia, alle-lú¬</l><l xml:id="m-4fff0c1b-8733-40a7-96ae-4b2d4457192b" facs="#m-bb45a476-b0ac-42bf-9c04-0d5945a7df98" label="ambiguous">ia.</l><l xml:id="m-e5c4ee47-a19a-4049-95b5-e1ff83da0dc0" facs="#m-e4b3c576-33f4-411a-ad1b-9f1cf8e39d3b" label="ambiguous">Postcommunion.</l><l xml:id="m-cb28d911-a3b1-443a-b769-7a8fc1a5010b" facs="#m-1ae892cb-a19a-4375-93bd-faabdfc682fe" label="lyrics-like">Ivini múneris fonte refécti, quaé¬ tectióne gaudére; ita ejus méritis et</l><l xml:id="m-5d918358-b7ab-401f-8e2e-fe9dd1e11f7b" facs="#m-c794b1d2-e589-4e69-b0d3-565ee0c2e702" label="lyrics-like">U sumus, Dómine Deus noster : intercessiône, caeléstis glóriae fá¬</l><l xml:id="m-e78c1fea-67c7-430b-9d21-e0ef569e6abe" facs="#m-dfa72b08-697a-4ec4-a151-246b553f5825" label="lyrics-like">ut, sicut nos facis beáti Joseph pro- cias esse partícipes. Per Dóminum.</l><l xml:id="m-8bfeef83-3e4e-4d02-b798-6f98f3538bfd" facs="#m-1207f33b-4ab7-426f-9c2d-4851cdbca000" label="text-like">Votive Mass of the Holy Apostles Peter and Paul.</l><l xml:id="m-8feddd7a-cf3e-4550-881f-10cf7efedf85" facs="#m-b6749300-9cad-4012-8025-e3485941611f" label="text-like">Introit. Mihi autem. p. 1304.</l><l xml:id="m-9584b5e3-653a-4cc4-a24a-972f42121990" facs="#m-516df56c-8eae-40e1-8e96-d50d98df5f9e" label="ambiguous">Collect.</l><l xml:id="m-9543e1e4-df69-467c-a1b7-5744640f955a" facs="#m-84cfce36-5375-4f17-9f79-5ca15146b86f" label="lyrics-like">Eus, cujus déxtera beátum Pe-l tem, de profúndo pélagi liberávit:</l><l xml:id="m-2d9ce86e-92e1-4ac7-bab0-4ede80686c3f" facs="#m-2c92a4f0-ebe2-451b-9fb7-2f8b254492ce" label="lyrics-like">U trum ambulantem in fluctibus, exáudi nos propitius, et concéde;</l><l xml:id="m-15668be8-f9eb-4d85-93d0-dd900dc1b306" facs="#m-1294c801-d102-4529-8f64-a70e6f45ff85" label="lyrics-like">ut, ambórum méritis, aeternitátis</l><l xml:id="m-004d0fe1-7cf7-4ad9-98c7-64dab932de9f" facs="#m-a91f0a5f-0eee-440f-895a-d65334fe270d" label="lyrics-like">ne mergerétur, eréxit, et coapósto¬</l><l xml:id="m-6d25618f-9588-48c8-ae28-41fb9250457b" facs="#m-b2dbf665-b9df-489d-b855-18b74cb34f66" label="lyrics-like">tum ejus Paulum, tértio naufragán- glóriam consequámur : Qui vivis.</l><l xml:id="m-0040a121-7319-4796-87e9-707f5220f2d9" facs="#m-a686cdad-59a8-4fdf-ad26-381b13588165" label="ambiguous">Lectio Actuum Apostolorum. Act. 5, 12-16.</l><l xml:id="m-ee5ecb43-e9cb-4a57-89e2-1be26c91520f" facs="#m-c73345d3-a9f4-4998-a08a-6d1e8ed14675" label="lyrics-like">TN diébus illis: Per manus Apo-let pónerent in léctulis ac grabátis,</l><l xml:id="m-11ffc4b3-55b1-4bb2-bce5-68448d6e861a" facs="#m-c14d1fbb-dfd3-4284-92b3-e544293dc0c3" label="lyrics-like">L stolórum fiébant signa, et prodi¬</l><l xml:id="m-e2db5895-dabd-44bf-a966-0deeb378997d" facs="#m-c0182c5c-30e0-4be8-8f3b-18a97869bbac" label="lyrics-like">ut, veniénte Petro, saltem umbra</l><l xml:id="m-cab83bda-8cb9-4b55-8dca-d54747748b5f" facs="#m-8d80c840-699f-472b-b051-6da1fa42e4bb" label="lyrics-like">illius obumbráret quemquam illó¬</l><l xml:id="m-6bdf5032-91c2-4dc3-affe-cc1a11517ae0" facs="#m-82a4b768-8dcf-45de-8bce-39a2215a50d1" label="ambiguous">gia multa in plebe. Et erant unani¬</l><l xml:id="m-a1b59594-ef2b-47f8-8c2d-d15b829e465b" facs="#m-3dc06c62-00c6-4c9f-b837-f239d79fd5d7" label="lyrics-like">rum, et liberaréntur ab infirmitati¬</l><l xml:id="m-6a593601-4089-46ab-8c86-f5428c3bc8f6" facs="#m-2fc2fb84-24e4-4869-b2c2-115995a60f59" label="lyrics-like">miter omnes in pórticu Salomónis.</l><l xml:id="m-0c0f3d7d-683e-4df9-af5f-809a177ce7c4" facs="#m-6bebd5ce-eb92-4220-bfa2-58f3743beed9" label="lyrics-like">ceterórum autem nemo audébat</l><l xml:id="m-33907d7e-8c0c-487e-8c5c-2698ab6e2ac6" facs="#m-5f565f55-9edc-4d10-b345-82e7b6ccf741" label="lyrics-like">bus suis. Concurrébat autem et</l><l xml:id="m-203a7860-6332-453d-a3f7-95f5faeff7a4" facs="#m-0cb69fbb-19f3-49ff-9fd5-6543ad73111a" label="lyrics-like">multitudo vicinárum civitátum JJe¬</l><l xml:id="m-ef2db666-8d24-48af-b13e-5460c062c27f" facs="#m-4d581296-c0fb-43cc-89ad-43dc2858a489" label="lyrics-like">se conjúngere illis : sed magnificá¬</l><l xml:id="m-1c5f597f-7c67-4a05-b816-265cbb070456" facs="#m-1be9425b-edb7-4c8a-90f1-69f93479e317" label="lyrics-like">rúsalem, afferéntes aegros, et ve¬</l><l xml:id="m-9053f46b-2fae-497d-9bc2-990172585c61" facs="#m-ae198126-bb07-40f8-87c1-3eaaa8e79be0" label="lyrics-like">bat eos pópulus. Magis autem au¬</l><l xml:id="m-f27477dd-00dd-44bc-bcac-a065442132e0" facs="#m-54b897ec-5e45-40a5-b167-76f57a3c3607" label="lyrics-like">gebátur credéntium in Dómino</l><l xml:id="m-aa0fb4ed-2ac2-4cc4-8874-52d61593ef50" facs="#m-f845187c-fb59-4a2e-9db7-0b77614a268d" label="lyrics-like">xátos a spiritibus immúndis: qui</l><l xml:id="m-a5bab41b-3a18-4e77-9438-5bd30ef087a8" facs="#m-40c8f7bb-3d6f-4012-81c9-600b4c048cc4" label="lyrics-like">multitudo virórum ac mulierum,</l><l xml:id="m-3420b3ee-5033-4355-b106-b9a501bd797a" facs="#m-2d780b28-ffc0-4085-880d-bfa75e78a787" label="lyrics-like">curabántur omnes.</l><l xml:id="m-402d9d61-0570-4246-a646-f05c87e3423d" facs="#m-88e99e24-89ea-43c1-9be3-91da0ccfca29" label="lyrics-like">ita ut in platéas ejicerent infirmos,</l><l xml:id="m-3cca8116-f61a-429a-b109-0cf0f7b6a046" facs="#m-9cb1bff1-00e8-463c-bcff-e97aaf25677c" label="lyrics-like">Gradual. Constitues éos. p. 1519.</l><l xml:id="m-3b082aad-5fe5-4be6-8729-1bd48b03271c" facs="#m-e254fc7a-a99e-407b-8f16-86cb9300b763" label="lyrics-like">Alleluia, allelúia. V. Nimis honoráti sunt. p. 1720.</l><l xml:id="m-931b0b4e-5fe4-4eca-922b-266242190f91" facs="#m-a0ebec65-1249-4cb3-9804-2054f61df3bb" label="text-like">After Septuagesima, the Alleluia. and its Verse are omitted; the Tract Qui</l><l xml:id="m-d1f0f09f-0efb-4334-ba60-b5ad2542e61b" facs="#m-391d2d1d-8486-4551-948f-f5247b07cb08" label="lyrics-like">séminant. p. 1164. is said instead.</l><l xml:id="m-35511010-e81a-4d12-ac9d-b915b7ba7256" facs="#m-054a7aa7-4a3b-49e0-890a-f22bdc8e3e19" label="lyrics-like">Gospel. Ecce nos relíquimus ómnia. p. 1208.</l><l xml:id="m-721f8bd7-3b30-4cf0-b02e-f1ec5cc0a948" facs="#m-37b86f78-7212-44bb-b51c-6b2e88979cfb" label="lyrics-like">Offertory. In ómnem térram. p. 1327.</l><l xml:id="m-ed4312d9-b7e2-42d3-a833-b5245c11158d" facs="#m-64201868-8676-4181-8cac-c75015f8ba1e" label="ambiguous">Secret.</l><l xml:id="m-076137ed-31d3-4b6a-817a-679990232ef7" facs="#m-fa7e94a5-3fda-4df0-9faa-9e48c2d3b1ae" label="lyrics-like">Fférimus tibi, Dómine, preces rum Petri et Pauli précibus adjuvé¬</l><l xml:id="m-0822fb46-40a7-4d96-9475-dc331273b445" facs="#m-e11dc53a-ea1a-4768-be4d-26f5be74f058" label="lyrics-like">U et múnera: quae ut tuo sint mur. Per Dóminum.</l><l xml:id="m-ba6eeef2-33f7-4e4a-a938-883f9f89fc42" facs="#m-52b75939-67d6-4f10-a8cd-85c0ad10d56d" label="lyrics-like">digna conspéctu, Apostolórum tuó¬</l><l xml:id="m-78623626-1b6b-4fa8-803e-b3de9d941a8f" facs="#m-515dd3e4-0f5c-42ec-bf2f-03dd2c7e696a" label="text-like">Preface of the Apostles, p. 10.</l><l xml:id="m-6df509b7-04bd-4bd3-b865-8aa4ef3aeb52" facs="#m-7263fbee-5be2-4e20-a3ac-db46f4ba38b9" label="lyrics-like">Communion. Vos qui secúti estis me. p. 1392.</l><l xml:id="m-1772f0ef-f61e-4c4e-8ea9-82619362c37e" facs="#m-378e057d-cb4e-41c9-9097-e7eb3989c0e9" label="ambiguous">Postcommunion.</l><l xml:id="m-afc3e39a-f814-4ef6-a305-abf94178bdd6" facs="#m-a9593c30-74a7-45bb-8e36-1e1e0e252c96" label="lyrics-like">DRótege, Dómine, pópulum tem, perpétua defensióne consérva.</l><l xml:id="m-10bd8a92-f516-48ea-bb48-50bf1ee7b534" facs="#m-7cf2a9c6-049b-45cf-9a78-86c53d6d6f03" label="lyrics-like">E tuum : et Apostolórum tuórum Per Dóminum.</l><l xml:id="m-e4a9b84b-cc06-4c35-9f7f-1fbe7eeecf05" facs="#m-3eaddeaa-ff40-40f9-8f21-71fcec852085" label="lyrics-like">Petri et Pauli patrocinio confidén¬</l></lg></div></section></score></mdiv></body></music>
</mei>