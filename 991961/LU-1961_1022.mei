            <div xml:id="m-29bee936-7691-4a69-9ab9-fa232dd3269f">
              <lg xml:id="m-88e216dc-0ad4-4ac2-9a8e-af721607b9f1">
                <l xml:id="m-2b32740a-7f69-411c-ab56-3c2b119a778c" facs="#m-513f5b92-b8d4-4dbd-8cf2-b93fa92b5ec8" label="ambiguous">836</l><l xml:id="m-33d354af-9d92-4989-ac7a-6597b7723f5d" facs="#m-08764252-7bec-41bb-912d-1fd1ef438ee6" label="text-like">The Greater and Lesser Litanies.</l><l xml:id="m-0cad1b9b-44da-46ef-b7b2-2961766e4c31" facs="#m-7bf462aa-e1ca-4fa3-850a-b75714425c08" label="lyrics-like">Sáncta Mari-a, óra pro nóbis.</l><l xml:id="m-0c84c5a0-f635-4a7a-9e4a-27aeec283b7f" facs="#m-06e964ea-81dd-4b8f-bebf-31bc2d97c154" label="text-like">Here all rise and the Procession begins without any interruption in the</l><l xml:id="m-09215a48-9557-48ca-9c4b-30f7611d5baa" facs="#m-dc2f7373-1000-4cef-87a7-2d19e06ccb4a" label="text-like">chant of the Litany.</l><l xml:id="m-f452a7d5-8a38-4915-89b7-c1b74ee7795c" facs="#m-f2338c8f-4090-424c-abd6-ef0ed1b41639" label="lyrics-like">Sáncta Dé- i Génitrix, óra pro nóbis.</l><l xml:id="m-6d15dc1d-6cc9-40f9-b7b3-77e5e6dfb9e0" facs="#m-1ac91762-6fd5-4d26-99fe-3dc173994304" label="lyrics-like">Sáncta Virgo vírginum, óra pro nóbis.</l><l xml:id="m-9f353aa6-1f24-41d7-8098-f2be289c5275" facs="#m-28d3fa9f-29a1-43ac-b506-763d0a9d97cd" label="lyrics-like">Mícha-el,</l><l xml:id="m-f9485a9d-354e-4234-b176-852bad192f27" facs="#m-515d1c92-eb5e-46bc-ae7b-77c2c31c8ced" label="lyrics-like">Sáncte</l><l xml:id="m-4ce5b399-4fa9-4abd-9917-ce95b0c4f8d1" facs="#m-e09fd608-0a80-4f26-b446-8fc79227bb64" label="lyrics-like">óra pro nóbis.</l><l xml:id="m-84c5fac8-21d8-4408-b9b3-70055d076642" facs="#m-61bbddc8-0994-4858-ba6d-37dd4fe44f18" label="lyrics-like">Sáncte</l><l xml:id="m-bf2dc20e-5455-4b21-b15a-3dff81fe2927" facs="#m-7e2db8fb-4676-462e-98ca-8fecd2611370" label="lyrics-like">Gábri-el, óra pro nóbis.</l><l xml:id="m-c7cb2bdd-0793-4181-b714-6fa6242159de" facs="#m-1e53b4eb-925e-4d5b-a65e-24fd5911ee83" label="lyrics-like">Rápha-el, óra pro nóbis.</l><l xml:id="m-5520d401-24a3-46bb-9c42-01e05b72a24b" facs="#m-b6604101-06a1-494c-99fb-a1ce2ecfa3c9" label="lyrics-like">Sáncte</l><l xml:id="m-f603ab88-c4a2-4112-9135-ac62339d840b" facs="#m-972ece2b-fe29-4c9b-9b21-3af23339febb" label="lyrics-like">Omnes sáncti Angeli et Archánge-li, orá-te pro nóbis.</l><l xml:id="m-5f433ff5-59b6-44d9-84db-d3f5411ce087" facs="#m-1cae6226-f9ea-47c7-bce6-d1e07c51ed4a" label="lyrics-like">Omnes sáncti beatórum Spirítuum órdines, orá-te pro nóbis.</l><l xml:id="m-01581298-a1b2-4665-89ad-4741b3a29446" facs="#m-6c4fedc2-9085-4761-91d3-96ce9f413e85" label="lyrics-like">Sáncte Jo-ánnes Baptísta, óra pro nóbis.</l><l xml:id="m-63d16c13-4778-4a48-9318-d4cec77ee51d" facs="#m-17847e25-6f63-4198-9927-1a5704d1d45c" label="lyrics-like">Sáncte</l><l xml:id="m-ca1f04a7-7b77-42d4-9f04-a3660980c11f" facs="#m-543c58b6-9aa7-4ace-a1d3-d4a2094e0e5b" label="lyrics-like">Jó-seph, óra pro nóbis.</l><l xml:id="m-c77a9023-99eb-4f8b-829a-60503330af4d" facs="#m-4ee18981-1574-4454-91e8-d6e057d6ca5d" label="lyrics-like">Omnes sáncti Patri-árchae et Prophétae, orá-te pro nóbis.</l><l xml:id="m-b205ad72-da38-4286-9ec7-3c22922a59de" facs="#m-276caec4-76a1-4a45-a53c-7604af68ab36" label="lyrics-like">Sáncte Pé-tre, óra pro nóbis.</l><l xml:id="m-6522cde4-163b-4898-ac14-00b81f982e3b" facs="#m-143cb460-ade7-43bf-9213-15df716e2800" label="lyrics-like">Sáncte Páule,</l><l xml:id="m-99cdff01-4c32-4152-ac2b-c925dc95cb1f" facs="#m-c577fbe1-8bf1-4a79-8023-8809b4064599" label="lyrics-like">óra. ISáncte Márce,</l><l xml:id="m-642414cc-8cc5-45c6-a12c-97d167ab1303" facs="#m-d3a6d170-463c-4d06-a549-c4eb25289c6d" label="ambiguous">ora.</l><l xml:id="m-95f74eb5-1b47-4aaf-bf1b-5064f96f502c" facs="#m-4613452c-90e5-4912-8068-d20be94fd482" label="lyrics-like">Sáncte Andréa,</l><l xml:id="m-f21bbbea-6431-42e7-8725-24c7d8050740" facs="#m-805cf38a-f59b-481a-9fa7-579a2d0dd6d0" label="lyrics-like">Omnes sáncti Apóstoli et</l><l xml:id="m-86c623d6-660c-41b0-80fa-d315b6f10d1a" facs="#m-274392e4-7c22-49f4-8063-0bc489f7bcb0" label="lyrics-like">óra.</l><l xml:id="m-200d92cc-9db7-407e-a279-7db00534b8b3" facs="#m-6f31e79f-9c31-422c-a3ac-101b8b241d62" label="lyrics-like">oráte.</l><l xml:id="m-49d54061-c60d-4fb7-93aa-e358f5569c1d" facs="#m-44122ff5-1553-4b96-bb1d-1511f2e1553a" label="ambiguous">Evangelistae,</l><l xml:id="m-44e35f87-9778-43ad-8e71-46209cc9464a" facs="#m-2476d1a0-7da1-46f7-8982-2bd10fa07596" label="lyrics-like">sáncte Jacóbe,</l><l xml:id="m-7eaeeb9a-9f69-4fdd-95d9-cd92bd223381" facs="#m-b044d0ec-d137-44d1-a345-f55e230eee12" label="lyrics-like">óra.</l><l xml:id="m-0ccf8977-4861-4a99-8357-e1020d7b6c57" facs="#m-db3a32ce-bf3b-4b08-b145-72d2c8826795" label="lyrics-like">Omnes sáncti Discipuli</l><l xml:id="m-9a3f1560-19de-4e91-b06e-b89be50c5e87" facs="#m-4beba6a0-6107-4568-97db-069daf096e2c" label="lyrics-like">Sáncte Joânnes,</l><l xml:id="m-bb770396-2e7a-4cf5-a65c-bc36d6559c94" facs="#m-e7049755-b3e9-4e59-b8d4-219a253e906b" label="lyrics-like">óra.</l><l xml:id="m-6e955356-5e5f-49a3-ae94-cbe9af18da30" facs="#m-b70770ed-e1f2-4205-b53c-9d852ce4cf18" label="lyrics-like">orâte.</l><l xml:id="m-86215eff-b906-4a09-a48a-545cd1cc1dea" facs="#m-c67f2b6d-19d8-4297-b14b-916f1ff951c9" label="lyrics-like">Sáncte Thóma,</l><l xml:id="m-c180fe56-ac94-4499-a49d-e0f91a89c17e" facs="#m-8bffc48e-46cd-4b25-95f7-da8bce36eedb" label="lyrics-like">Dómini,</l><l xml:id="m-53af293b-4a53-429b-8251-0f11418235cb" facs="#m-a7518ea0-c8d9-4142-a48d-3a34f5e1e5eb" label="lyrics-like">óra.</l><l xml:id="m-f836a0ed-1446-4c14-96eb-bb7ed68a60ee" facs="#m-495ac094-3359-4429-955d-2d5674bce602" label="lyrics-like">Sáncte Jacóbe.</l><l xml:id="m-12876e45-d1b6-4128-9c4d-7bb8ccd8169f" facs="#m-405bbf56-b691-4938-85a8-854baf3479e9" label="lyrics-like">Omnes sáncti Innocéntes,</l><l xml:id="m-57adc3c3-0c48-4bdf-97d1-111b50c00058" facs="#m-dfb63944-7231-4aa1-ac40-4d29dd34b626" label="lyrics-like">orá̂te.</l><l xml:id="m-43d0b5df-343c-441c-bc46-9a6502cec972" facs="#m-305ad77a-9f9c-4a64-80f4-f7733b3671c6" label="lyrics-like">óra.</l><l xml:id="m-9d5ee64f-c36b-4499-99d0-658744e15d66" facs="#m-1df4a91b-ea5d-423d-83ad-f8193ed5469a" label="ambiguous">sancte Philippe,</l><l xml:id="m-8b3ef437-c6ab-4433-9889-b0ba5cb31521" facs="#m-6886235b-5660-4d8c-aa08-d30f7360943e" label="lyrics-like">Sáncte Stéphane,</l><l xml:id="m-de11014b-ae5a-4ad4-9452-a2d9e4aaef5e" facs="#m-eceb4a0a-681d-4b97-ad9d-2bb5de19c029" label="lyrics-like">óra.</l><l xml:id="m-1af4b07c-5f51-453c-9300-f3f2750a4e31" facs="#m-97d4382c-dab0-4c4a-9bfd-ac373043e461" label="lyrics-like">óra.</l><l xml:id="m-3ed42977-14d9-4626-8be5-99affba2c681" facs="#m-1df607ad-da77-46d1-81b4-28fd7fee2c98" label="lyrics-like">Sáncte Bartholomaée,</l><l xml:id="m-4902550b-722b-4165-abad-aa23ab5b9c89" facs="#m-e714dac2-d747-4f7f-8c81-92cabd8444b2" label="lyrics-like">Sancte Laurénti,</l><l xml:id="m-847cd9a5-1282-4ac5-8378-6dc33c3bceea" facs="#m-ff4af693-de28-4d47-8350-e188ce72c7f2" label="lyrics-like">óra.</l><l xml:id="m-14fafb5e-0208-4c1f-8f40-8a5f53547e07" facs="#m-7698da9e-28fd-4a33-b92c-7156b649f75c" label="lyrics-like">óra.</l><l xml:id="m-a2103e91-d44a-45ba-b771-d6cced4955ed" facs="#m-36e929d2-f469-4a62-bfb7-f7dc7223b0b4" label="lyrics-like">Sáncte Vincénti,</l><l xml:id="m-90f1dfde-666f-4c12-b4e5-ec2f6861028a" facs="#m-2ec069fb-c381-48ad-b959-0e21bbe0ad9e" label="lyrics-like">Sáncte Matthaée,</l><l xml:id="m-dd053871-4585-4771-9a53-c4c675972e19" facs="#m-2f26af44-80a0-4fe5-8cfa-c7425f541612" label="lyrics-like">óra.</l><l xml:id="m-01ab00fc-7d95-4293-b26e-9cb41c3941eb" facs="#m-3de73145-e6f1-4afb-85ef-6e7eb2d19a7d" label="lyrics-like">óra.</l><l xml:id="m-b97c8d51-e3b3-4f57-91f4-196dc8e723db" facs="#m-9206e0ea-29b7-4569-855b-85358fc4da1d" label="ambiguous">Sancte Simon,</l><l xml:id="m-8a2b0b25-d020-4149-a837-e0ae287197ce" facs="#m-b94b1ebe-3fff-4e15-b7f7-b1df7c067099" label="lyrics-like">Sáncti Fabiáne et Sebastiáne, oráte.</l><l xml:id="m-8e38de45-223a-428b-9830-4b6c4c933fd3" facs="#m-f12207b8-0fe5-4780-88bb-fc94e9c046f0" label="lyrics-like">óra.</l><l xml:id="m-49478062-3ef1-4dc7-949b-90aac9ab5ba7" facs="#m-dd16724d-272c-4286-bb71-dfc092ba41d3" label="lyrics-like">Sáncte Thaddaée,</l><l xml:id="m-e9d4ce38-47af-4e01-9568-887a9e35527f" facs="#m-893df948-12db-4704-a7ff-bf0af9dbe06a" label="lyrics-like">Sáncti Ioannes et Paule,</l><l xml:id="m-88252da1-20bd-482d-93e9-cecdfd965723" facs="#m-b540f3bf-d1cb-4489-8187-25192e3da8d8" label="lyrics-like">óra.</l><l xml:id="m-c64ab265-b2b1-4303-a91b-02dc0b0aefc9" facs="#m-9925134c-988a-4b04-b3c5-9c5eafec5b75" label="lyrics-like">oráte.</l><l xml:id="m-c1e0cbde-76a9-488a-acda-878166e0fc94" facs="#m-5cd1230c-4530-4227-8af2-164d727768f3" label="lyrics-like">Sancti Cósma et Damiâne,</l><l xml:id="m-eeb98cfd-237e-4691-80e2-bd544e8ffbdd" facs="#m-4245f421-fa08-41d6-aac1-ea2ee5408a46" label="lyrics-like">oráte.</l><l xml:id="m-32af9835-4743-4ad0-9d62-feccb4ebdc0b" facs="#m-49a3163d-1240-4f19-bcb3-4a28977d3c01" label="ambiguous">Sancte Matthia,</l><l xml:id="m-fae8ee6b-23e1-4de3-8505-abf2e40eaaa2" facs="#m-7dfaa36a-5784-45f6-a66b-d1e879d983ea" label="lyrics-like">óra.</l><l xml:id="m-186d0270-797b-4218-911b-a6e401ca48f9" facs="#m-d72ef944-acb5-41a7-bc44-76beebff0c28" label="lyrics-like">Sancte Bárnaba,</l><l xml:id="m-50e2ae95-f8df-4095-aaea-7d11a7a62bf4" facs="#m-03f9a47a-d755-4332-b5fe-ba1110e0a64c" label="lyrics-like">óra.</l><l xml:id="m-d49ca9dd-a4d4-48df-aef7-4cd5a82ea51f" facs="#m-042fd139-d8b9-437b-b208-ceec0f550b87" label="lyrics-like">Sáncti Gervási et Protási,</l><l xml:id="m-c90b2105-bb8c-456a-93a8-50965e5859d0" facs="#m-7d6f78d5-4a06-45d2-8e98-1e5659e1a475" label="lyrics-like">oráte.</l><l xml:id="m-0da77238-d3b3-4865-833c-720c6a060135" facs="#m-c07edc56-3dd7-4912-827e-a3f33811e460" label="lyrics-like">sáncte Lúca,</l><l xml:id="m-fcf21ded-113c-4ce5-bfee-db207dec456d" facs="#m-086e67f3-bbf3-4e86-b750-2c67eb3a2454" label="ambiguous">orate.</l><l xml:id="m-b8a56d06-d2d4-4d13-83fd-0ce0215ecc48" facs="#m-051068e6-6179-4891-82db-5ebc023a0e6c" label="lyrics-like">óra.l Omnes sáncti Mártyres,</l></lg>
