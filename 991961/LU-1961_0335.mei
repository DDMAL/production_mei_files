      <graphic xml:id="m-e5d20f6a-4c33-488e-8527-2bb1417b8bd4" target="0335_original_image.tiff" /><zone xml:id="m-eaa73ae6-2c88-46cc-bc50-32ac08251b5c" ulx="614" uly="133" lrx="1028" lry="184" /><zone xml:id="m-a16b9a62-2787-4aab-9116-9a0ffd1404da" ulx="1471" uly="134" lrx="1574" lry="185" /><zone xml:id="m-a32bc0b1-92ac-4d9e-b4ec-74e3d22b0e25" ulx="473" uly="253" lrx="1165" lry="314" /><zone xml:id="m-e0df40c1-1c2f-451b-b54e-d76b747f2cdd" ulx="93" uly="344" lrx="1565" lry="406" /><zone xml:id="m-8e84e5f2-6f89-47c6-b009-b98a5346fcca" ulx="61" uly="391" lrx="1092" lry="460" /><zone xml:id="m-a0bfb6ba-61c9-4463-88da-25430b4b2379" ulx="58" uly="437" lrx="644" lry="495" /><zone xml:id="m-921e4e50-d98a-4458-a52c-f29ef0d55c48" ulx="871" uly="442" lrx="1565" lry="498" /><zone xml:id="m-130ec05b-b4d7-4c20-9de4-c5931a86ff76" ulx="101" uly="482" lrx="795" lry="541" /><zone xml:id="m-613765d7-fe21-4c2b-89fb-f07351815780" ulx="822" uly="487" lrx="1476" lry="553" /><zone xml:id="m-bf4b4fe4-cee5-48da-b5aa-e074c2ff8555" ulx="55" uly="531" lrx="628" lry="590" /><zone xml:id="m-14c66223-6dca-42e9-8adc-91bf5341582b" ulx="866" uly="536" lrx="1565" lry="599" /><zone xml:id="m-d3e0f453-5ffb-4277-96f6-52695bb21be3" ulx="100" uly="583" lrx="800" lry="637" /><zone xml:id="m-334ed3bf-ed58-4798-b769-879796d5bcde" ulx="822" uly="583" lrx="1560" lry="645" /><zone xml:id="m-71736df9-351d-493f-8f9b-ced719b779a3" ulx="814" uly="629" lrx="1489" lry="685" /><zone xml:id="m-8cd4634b-6a64-4ced-8af8-1bfc4252036d" ulx="55" uly="631" lrx="804" lry="693" /><zone xml:id="m-0629e4a2-f29c-4a54-be4f-85057190f925" ulx="868" uly="677" lrx="1563" lry="733" /><zone xml:id="m-83fed5ad-16d8-4790-8d21-ff6d06656846" ulx="57" uly="679" lrx="330" lry="736" /><zone xml:id="m-d199ea88-fea5-4535-b1a2-1e8966ad6101" ulx="104" uly="718" lrx="808" lry="774" /><zone xml:id="m-a1c67e81-7fef-4e9a-99c4-05738b2041d9" ulx="819" uly="721" lrx="1565" lry="785" /><zone xml:id="m-dd38f717-e79c-4fa8-b030-76a98d31bdcf" ulx="819" uly="771" lrx="1098" lry="823" /><zone xml:id="m-3cc078e5-3406-4143-a8e3-e35d00225008" ulx="53" uly="772" lrx="803" lry="820" /><zone xml:id="m-794108fe-5066-4968-9132-c9662ef40be7" ulx="100" uly="812" lrx="803" lry="869" /><zone xml:id="m-76dcd336-c512-4d22-8d80-36820e217285" ulx="870" uly="812" lrx="1568" lry="871" /><zone xml:id="m-38815bfc-07b6-4c6e-a46c-2c4955b59636" ulx="820" uly="859" lrx="1562" lry="923" /><zone xml:id="m-6a086fb7-4e3a-4c0d-8786-ef26a9eb91b1" ulx="60" uly="861" lrx="806" lry="921" /><zone xml:id="m-290b92e3-2beb-451b-b18b-f9053ecc4c93" ulx="58" uly="907" lrx="530" lry="964" /><zone xml:id="m-d157e2c4-b361-4565-8026-c8ef4aa78965" ulx="823" uly="909" lrx="1166" lry="966" /><zone xml:id="m-15fa6f73-49c2-4185-a755-dbfde910fe54" ulx="866" uly="955" lrx="1566" lry="1015" /><zone xml:id="m-e812c1df-65b4-4843-b598-555441305650" ulx="106" uly="958" lrx="803" lry="1013" /><zone xml:id="m-1d16e504-999f-42c6-a01e-7e371bd4c534" ulx="58" uly="1002" lrx="800" lry="1066" /><zone xml:id="m-958ea133-bb85-4f97-bbc2-76b396809608" ulx="822" uly="1004" lrx="1560" lry="1058" /><zone xml:id="m-3f746f42-495f-440c-8ecb-d4b663433311" ulx="823" uly="1048" lrx="1551" lry="1115" /><zone xml:id="m-b8380fb5-d1b8-47e6-9250-848f9e6ccfd8" ulx="58" uly="1050" lrx="419" lry="1107" /><zone xml:id="m-9b030f1a-b3bf-4c6c-8514-247d43c28cdc" ulx="103" uly="1091" lrx="825" lry="1155" /><zone xml:id="m-fa4d5321-801f-494e-b4be-24e0fb23c29d" ulx="852" uly="1093" lrx="1151" lry="1159" /><zone xml:id="m-3d9e85e9-148b-43da-a71c-b6c004ff3d6c" ulx="106" uly="1186" lrx="1273" lry="1242" /><zone xml:id="m-b1a4a267-c5f5-40df-b8d1-5df58e13128b" ulx="104" uly="1236" lrx="590" lry="1301" /><zone xml:id="m-de90cd27-2ea0-4f4e-9673-b4dbfc9a778a" ulx="106" uly="1288" lrx="587" lry="1350" /><zone xml:id="m-03e116c5-c165-4944-8c40-d6577d9ef4ed" ulx="106" uly="1374" lrx="703" lry="1421" /><zone xml:id="m-d4da4211-baac-4247-948b-054069a97e18" ulx="100" uly="1428" lrx="1568" lry="1488" /><zone xml:id="m-3f63528e-dd9b-40a0-966a-15e910ba8f0c" ulx="58" uly="1485" lrx="1566" lry="1535" /><zone xml:id="m-6b943887-5b1f-40e0-9dea-9be57f6d4958" ulx="57" uly="1523" lrx="215" lry="1589" /><zone xml:id="m-d872ac9c-65a4-44ee-b778-2d3c87245aeb" ulx="104" uly="1585" lrx="1309" lry="1648" /><zone xml:id="m-aeae3a69-535a-4a4e-aa5e-6debdde824c8" ulx="103" uly="1645" lrx="1452" lry="1710" /><zone xml:id="m-d8714936-7fbb-4d38-8b37-4935b9f918ed" ulx="101" uly="1699" lrx="331" lry="1756" /><zone xml:id="m-ca59043a-163d-4255-b762-cbb542fcf1b6" ulx="100" uly="1769" lrx="1568" lry="1832" /><zone xml:id="m-7e31b9b4-4d12-4b37-8da5-03bfd5ce6243" ulx="58" uly="1818" lrx="1568" lry="1878" /><zone xml:id="m-7b26ebd3-8ac8-479e-94b6-cb2e31183537" ulx="58" uly="1867" lrx="1563" lry="1926" /><zone xml:id="m-9217ade0-e62a-4a57-90c4-947dbde3cdcd" ulx="57" uly="1915" lrx="700" lry="1973" /><zone xml:id="m-befdbd4a-1677-454d-8a7d-5b7334b9711e" ulx="101" uly="1978" lrx="1354" lry="2049" /><zone xml:id="m-457c9440-46c8-43dd-9a4f-50b91867abcd" ulx="720" uly="2308" lrx="876" lry="2360" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-a8c880d7-8008-4e06-b0f1-71edf0c66418" n="0335" facs="#m-0341a9b8-9874-47cd-89ad-310b92d4e38b" /><div xml:id="m-fa90f1e5-b96f-4c3f-ad48-ca4507c3a822">
            <lg xml:id="m-423f2ad7-539c-4e57-b303-bc91e601b411">
              <l xml:id="m-52e9f4cc-0848-4102-915f-ed27896e9476" facs="#m-eaa73ae6-2c88-46cc-bc50-32ac08251b5c" label="text-like">Lauds of Feasts.</l><l xml:id="m-d3228730-f62c-4743-a2b9-412290c169fc" facs="#m-a16b9a62-2787-4aab-9116-9a0ffd1404da" label="ambiguous">223</l><l xml:id="m-4fad0952-42fa-444e-94a9-03f3dd106c72" facs="#m-a32bc0b1-92ac-4d9e-b4ec-74e3d22b0e25" label="text-like">Cantiele of Zachary. Luke I.</l><l xml:id="m-6fe7ea2d-2258-4de1-b6e1-3fabf20e3878" facs="#m-e0df40c1-1c2f-451b-b54e-d76b747f2cdd" label="lyrics-like">TEnedíctus Dóminus Déus Is-(córum nostrórum liberáti, “ser¬</l><l xml:id="m-cc7a8d2e-634c-4d9e-a51a-b9fbf88132db" facs="#m-8e84e5f2-6f89-47c6-b009-b98a5346fcca" label="lyrics-like">l*quia visitávit, et fécit viámus illi:</l><l xml:id="m-a72d06cd-4d64-4fad-a942-2c0b7bd1cc12" facs="#m-a0bfb6ba-61c9-4463-88da-25430b4b2379" label="lyrics-like">redemptiónem plébis súae.</l><l xml:id="m-994f8b92-fd5f-4041-8e63-51286f60abbb" facs="#m-921e4e50-d98a-4458-a52c-f29ef0d55c48" label="lyrics-like">In sanctitáte et justítia córam</l><l xml:id="m-301e3d7c-ea33-4f40-ad01-c7cfb1588d8a" facs="#m-130ec05b-b4d7-4c20-9de4-c5931a86ff76" label="lyrics-like">Et eréxit córnu salútis nóbis,</l><l xml:id="m-e3bd5809-16d7-4bee-833f-cf1f543a01a3" facs="#m-613765d7-fe21-4c2b-89fb-f07351815780" label="lyrics-like">ipso,*ómnibus diébus nóstris.</l><l xml:id="m-12977186-c53b-4fc3-a0f2-880c51afce32" facs="#m-bf4b4fe4-cee5-48da-b5aa-e074c2ff8555" label="lyrics-like">in dómo Dávid púeri súi:</l><l xml:id="m-556a9a97-d932-47d8-931d-df7bcfb5a1d7" facs="#m-14c66223-6dca-42e9-8adc-91bf5341582b" label="lyrics-like">Et tu púer, prophéta Altíssimi</l><l xml:id="m-c90033f2-6f98-461b-b2db-ca6c51394912" facs="#m-d3e0f453-5ffb-4277-96f6-52695bb21be3" label="lyrics-like">Sicut locútus est per ós sanctó¬</l><l xml:id="m-6a429f57-c813-4a97-9f1b-3e36205dcfe7" facs="#m-334ed3bf-ed58-4798-b769-879796d5bcde" label="lyrics-like">vocáberis :* praeíbis enim ante fá¬</l><l xml:id="m-67daec1f-ae8b-4dd8-9f9b-9836fc91cea3" facs="#m-71736df9-351d-493f-8f9b-ced719b779a3" label="lyrics-like">ciem Dómini paráre vias éjus:</l><l xml:id="m-7a133bfb-8cf2-4b57-80c4-7d959622b432" facs="#m-8cd4634b-6a64-4ced-8af8-1bfc4252036d" label="lyrics-like">rum, *qui a saéculo sunt, prophe¬</l><l xml:id="m-fd4d0d68-3de7-4a69-ad15-074af5dd29cb" facs="#m-0629e4a2-f29c-4a54-be4f-85057190f925" label="lyrics-like">Ad dándam sciéntiam salútis plé¬</l><l xml:id="m-8b1188bb-4478-48b7-90ca-d866db0420b1" facs="#m-83fed5ad-16d8-4790-8d21-ff6d06656846" label="lyrics-like">tárum éjus:</l><l xml:id="m-10bc4c79-9376-4b3a-8dca-e78363297b14" facs="#m-d199ea88-fea5-4535-b1a2-1e8966ad6101" label="lyrics-like">Salútem ex inimicis nóstris, “et</l><l xml:id="m-80895660-c602-4e9f-8051-2c09b96ce756" facs="#m-a1c67e81-7fef-4e9a-99c4-05738b2041d9" label="lyrics-like">bi éjus, * in remissiónem peccató¬</l><l xml:id="m-9fc95400-f093-4f30-a0a8-662a8d03c15b" facs="#m-dd38f717-e79c-4fa8-b030-76a98d31bdcf" label="lyrics-like">rum eórum:</l><l xml:id="m-82c55740-a3f9-450b-821f-756b5be2c2d4" facs="#m-3cc078e5-3406-4143-a8e3-e35d00225008" label="lyrics-like">de mánu ómnium qui odérunt nos:</l><l xml:id="m-5f2548a5-6808-43ee-9d2f-4e8e75a7a580" facs="#m-794108fe-5066-4968-9132-c9662ef40be7" label="lyrics-like">Ad faciéndam misericórdiam cum</l><l xml:id="m-3de4bad5-a0c8-487c-8e85-fdaf8207035b" facs="#m-76dcd336-c512-4d22-8d80-36820e217285" label="lyrics-like">Per víscera misericórdiae Déi</l><l xml:id="m-3c577dde-801b-48ac-9c5d-12a73fd3f6c1" facs="#m-38815bfc-07b6-4c6e-a46c-2c4955b59636" label="lyrics-like">nóstri:*in quíbus visitávit nos,</l><l xml:id="m-aa47d088-b9db-472f-97f9-f987133ce8d8" facs="#m-6a086fb7-4e3a-4c0d-8786-ef26a9eb91b1" label="lyrics-like">pátribus nóstris: * et memorári</l><l xml:id="m-2c485a01-c83a-44df-8981-c0dd66d53ab0" facs="#m-290b92e3-2beb-451b-b18b-f9053ecc4c93" label="lyrics-like">testaménti sui sáncti.</l><l xml:id="m-6a78bc5c-2b2f-43ba-8e9f-5973bc031d8b" facs="#m-d157e2c4-b361-4565-8026-c8ef4aa78965" label="lyrics-like">óriens ex álto:</l><l xml:id="m-8f230234-268f-4829-9a9c-039468edf649" facs="#m-15fa6f73-49c2-4185-a755-dbfde910fe54" label="lyrics-like">Illumináre his qui in ténebris et</l><l xml:id="m-cceaa4fd-6e65-4a88-abfb-1c397357c08b" facs="#m-e812c1df-65b4-4843-b598-555441305650" label="lyrics-like">Jusjurándum, quod jurávit ad</l><l xml:id="m-a52373c4-af82-40b0-8b30-e04c27fc7c0b" facs="#m-1d16e504-999f-42c6-a01e-7e371bd4c534" label="lyrics-like">Abraham pâtrem nóstrum, “da¬</l><l xml:id="m-3c0a93ae-555c-4859-ae44-ab7b7eef11b7" facs="#m-958ea133-bb85-4f97-bbc2-76b396809608" label="lyrics-like">in úmbra mórtis sédent:“ ad diri¬</l><l xml:id="m-8f803213-931d-4cc0-837e-95c00b0658ba" facs="#m-3f746f42-495f-440c-8ecb-d4b663433311" label="lyrics-like">géndos pédes nóstros in víam pácis</l><l xml:id="m-d56ac63a-5e30-426c-ace1-8f8374ea7a03" facs="#m-b8380fb5-d1b8-47e6-9250-848f9e6ccfd8" label="lyrics-like">túrum se nóbis:</l><l xml:id="m-e109713f-d4df-45b9-a536-9a175e209e79" facs="#m-9b030f1a-b3bf-4c6c-8514-247d43c28cdc" label="lyrics-like">Ut sine timóre, de mánu inimi¬</l><l xml:id="m-cc911a4c-a8c4-4170-88ec-9fa0aa05c3e1" facs="#m-fa4d5321-801f-494e-b4be-24e0fb23c29d" label="lyrics-like">Glória Pátri.</l><l xml:id="m-485bf47e-c145-416a-b9e3-12c0749b6d5d" facs="#m-3d9e85e9-148b-43da-a71c-b6c004ff3d6c" label="text-like">The Antiphon is here repeated. The Celebrant next says:</l><l xml:id="m-d8268d8b-fc1b-4fac-95a0-46f34ac1e3bc" facs="#m-b1a4a267-c5f5-40df-b8d1-5df58e13128b" label="lyrics-like">V. Dóminus vobíscum.</l><l xml:id="m-fffe804a-1186-4f8d-90c8-31db3f443ecf" facs="#m-de90cd27-2ea0-4f4e-9673-b4dbfc9a778a" label="lyrics-like">K. Et cum spíritu túo.</l><l xml:id="m-8e797139-c05e-4c15-a02e-29daa84b592e" facs="#m-03e116c5-c165-4944-8c40-d6577d9ef4ed" label="text-like">Then the Prayer of the Feast.</l><l xml:id="m-b5318ac1-47b3-40d0-a063-4710a442e6bc" facs="#m-d4da4211-baac-4247-948b-054069a97e18" label="lyrics-like">After the Prayer, the Celebrant repeats the V. Dóminus vobíscum. and</l><l xml:id="m-eb562993-2fd9-4c9b-9647-94d93dad0e66" facs="#m-3f63528e-dd9b-40a0-966a-15e910ba8f0c" label="lyrics-like">the Cantors sing the V. Benedicámus Dómino. in the tone indicated on</l><l xml:id="m-819d7f7a-14ba-4a42-839c-f5fc84412cb7" facs="#m-6b943887-5b1f-40e0-9dea-9be57f6d4958" label="ambiguous">p.124.</l><l xml:id="m-d650107a-7d7f-49a2-9637-2c3dec5b46ff" facs="#m-d872ac9c-65a4-44ee-b778-2d3c87245aeb" label="lyrics-like">The Choir having replied Déo grátias. the Celebrant adas:</l><l xml:id="m-e4fffacb-2dd8-46af-9c0e-7a932c48e4d5" facs="#m-aeae3a69-535a-4a4e-aa5e-6debdde824c8" label="lyrics-like">v. Fidélium ánimae per misericórdiam Déi requiéscant in páce.</l><l xml:id="m-e210bac7-83b2-4596-b253-019b177ed003" facs="#m-d8714936-7fbb-4d38-8b37-4935b9f918ed" label="ambiguous">R. Amen.</l><l xml:id="m-36eab0d9-2387-4f1e-b5a7-b3247a9f017e" facs="#m-ca59043a-163d-4255-b762-cbb542fcf1b6" label="lyrics-like">If no other Office is to follow immediately, the Páter nóster. Is satd in</l><l xml:id="m-dbaad004-4833-46b9-a03a-047e0f1e6c44" facs="#m-7e31b9b4-4d12-4b37-8da5-03bfd5ce6243" label="lyrics-like">silence, then the V. Dóminus det nóbis súam pácem. K. Et vítam aetér¬</l><l xml:id="m-a59646c6-3680-4c77-acf6-e182c2e05af6" facs="#m-7b26ebd3-8ac8-479e-94b6-cb2e31183537" label="text-like">nam. Amen. Next follows the Anthem to the Blessed Virgin according</l><l xml:id="m-43a7324a-d5da-4d26-85d1-2f037b9ebe32" facs="#m-9217ade0-e62a-4a57-90c4-947dbde3cdcd" label="text-like">the Season p. 273, and finally:</l><l xml:id="m-a4ac1599-5bea-4a2e-a268-86328efb79bf" facs="#m-befdbd4a-1677-454d-8a7d-5b7334b9711e" label="lyrics-like">V. Divínum auxílium máneat semper nobíscum. K. Amen.</l><l xml:id="m-b682656c-7751-4887-a835-6102cdc13dd2" facs="#m-457c9440-46c8-43dd-9a4f-50b91867abcd" label="ambiguous">—</l></lg></div></section></score></mdiv></body></music>
</mei>