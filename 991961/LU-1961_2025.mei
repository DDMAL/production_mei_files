                <syl /><neume facs="#m-756104eb-c7ea-4d9b-ad43-ce5605d99707" type="punctum" xml:id="m-c828d54b-9b7e-42b3-b002-bf6ef9dac8ef">
                  <nc xml:id="m-36d2789b-57c6-4346-877f-6ca5433cfaf3" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-bf31151e-f043-4f52-aba1-e0fe68fe9896">
                <syl /><neume facs="#m-6e924f8c-83e8-49f6-9b61-f6a234a6e066" type="punctum" xml:id="m-9f9f92c8-72df-48a5-a3e2-b022a5564643">
                  <nc xml:id="m-b3f2b48b-bdc7-4bfd-b21b-2c19af3ad86f" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-efa463f7-38c6-4b60-9a6e-7c6a6d12fd13">
                <syl /><neume facs="#m-548d66b7-755d-4fa0-9908-d24a9592732b" type="punctum" xml:id="m-074564a6-3828-4add-93b3-75137276d95a">
                  <nc xml:id="m-5121b20e-7bbc-4894-b8dd-341fb4691057" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-903f9e6e-d7ec-44f2-89dd-520b88ae8c4f">
                <syl /><neume facs="#m-0977e7bf-521b-448c-b05b-2734a21012aa" type="punctum" xml:id="m-df1cd859-37e0-4448-9149-62576f7f438c">
                  <nc xml:id="m-ecf354b0-31b0-421a-85bc-beddf1f1cd20" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-d8585ac2-8041-4023-8bef-f3dab3bc2bc0">
                <syl /><neume facs="#m-ca47886c-ae94-4972-b150-618b78becb2d" type="punctum" xml:id="m-adf10f85-0292-4694-8152-6de5e9aaa65c">
                  <nc xml:id="m-1a24f51d-b47b-4ffd-9aac-30060dcae823" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-0daed2af-37c3-481a-a913-6301eb27d379">
                <syl /><neume facs="#m-267f5df4-ecd2-459d-b5ae-4620a6157728" type="punctum" xml:id="m-5426578c-1505-4cbf-ba5b-4d7ed67208b1">
                  <nc xml:id="m-af42c232-47e0-4879-9aa6-607606e97efc" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-65bfe7b9-3b66-42f5-a088-5ec88fbc4070">
                <syl /><neume facs="#m-fc2c493e-9080-4f40-bb82-cc871bb36185" type="punctum" xml:id="m-1e4be8d9-47b8-4a9c-916c-b5621861293c">
                  <nc xml:id="m-5f9c200f-309a-42cd-8ade-897f5a9ece40" pname="a" oct="3"><episema xml:id="m-61f3ccf3-dca2-4703-b667-1594860c8e40" form="h" /></nc></neume></syllable><divLine xml:id="m-b7337253-6aa3-4f1c-ad4c-eb7f8e120fd2" facs="#m-5213983c-3624-4281-bef1-1a00da3564cc" form="minima" /><syllable xml:id="m-79790f38-a835-406c-b147-a0719790264f">
                <syl /><neume facs="#m-80abaedd-a469-4786-93bf-a175324ea20b" type="punctum" xml:id="m-79909fd1-e960-4a60-89d6-fd4755f37c51">
                  <nc xml:id="m-00068d87-6e6e-44af-8a74-8c2e4cf7ab1d" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-e849011c-039a-4023-9424-1bdc4c899608">
                <syl /><neume facs="#m-e37f426b-2b9c-4d76-9c89-51dac8e3be93" type="punctum" xml:id="m-781b6fae-69af-4054-82e1-9d8724fd6484">
                  <nc xml:id="m-0af8c487-ed59-48f5-aa22-8b97e1561cd9" pname="g" oct="3"><episema xml:id="m-2ecfe917-bf7d-4210-a681-fa04f068283c" form="v" /></nc></neume></syllable><custos xml:id="m-cd01fafb-8a5e-4ca5-b23e-70c3a9ca414c" facs="#m-8aa72bdd-229c-48c9-95c9-71fc0220c12d" pname="a" oct="3" /></layer></staff><div xml:id="m-42e76f35-1ee8-46cd-9871-6ae77ddf8cb3"><lg xml:id="m-7f79fe88-d1a4-41c0-9782-e24411f672ed"><l xml:id="m-acc58332-aa28-4283-a9e7-3be08b8bd7d9" facs="#m-2769e46f-77fd-4632-86f6-f64bd0be604a" label="ambiguous">1770</l><l xml:id="m-27424413-96bc-4216-9431-7bd717048cfd" facs="#m-17502cf3-d829-485a-999a-9a37a3f119ce" label="text-like">At Matins.</l><l xml:id="m-9917bc70-cd9f-407c-aa7b-1f1d6422c3b5" facs="#m-8762a5ef-b946-4f99-b92f-65cd5fee15ca" label="text-like">For deceased Brethren, Relations, and Benefactors.</l><l xml:id="m-93814c81-d7f0-48ca-8f36-a50045a2ba21" facs="#m-ec793fa1-10d4-4f62-8410-d7d5c3953b22" label="text-like">Prayer.</l><l xml:id="m-08a582d2-3ea3-49f4-a104-0ce8cf90c89f" facs="#m-e520137c-e397-4ee6-890c-a3344d25d54a" label="lyrics-like">Eus véniae largitor et humânael transiérunt,* beáta Maria semper</l><l xml:id="m-09f94ffd-433d-46bb-a531-d32c93d0be66" facs="#m-ba089d94-76d5-4f6d-a6e3-ece5308e5200" label="lyrics-like">I salútis amátor: t quaésumus! Virgine intercedénte cum ómnibus</l><l xml:id="m-6ffffd51-7805-4ab6-b2b1-d326927584ad" facs="#m-ffac3417-11c4-42c3-96a3-69a5c448c58d" label="lyrics-like">cleméntiam tuam; ut nostrae con¬Sanctis tuis, ad perpétuae beatitú¬</l><l xml:id="m-b08817a3-fdab-437d-8e81-618b336b7660" facs="#m-7ead4bfd-0b9f-4eba-b812-cbcc1740e2d2" label="lyrics-like">gregatiónis fratres, propinquos et dinis consórtium pervenire concé¬</l><l xml:id="m-e340824e-80b8-4fbd-b68b-80a2826def43" facs="#m-761a0f62-aae3-464f-9121-60a42f3ac7a6" label="lyrics-like">benefactóres, qui ex hoc saéculo! das. Per Dóminum.</l><l xml:id="m-6fca6405-84ae-4b4e-a743-2c5f6be0d6b3" facs="#m-0482e269-be3d-47fe-b101-4529560f5d36" label="text-like">The following Y. and N. are always said in the plural:</l><l xml:id="m-83973f0e-d7b1-4ef8-a100-87cfe38b0ddf" facs="#m-be42757d-a151-491c-bcee-8f1d362e5c96" label="lyrics-like">v. Réquiem aetérnam dóna éis Dómine.</l><l xml:id="m-09199379-b6bb-4ade-82fa-1bf602abcf0b" facs="#m-df060010-9906-4b86-9134-9b8f1248b1ed" label="lyrics-like">H. Et lux perpétua lúceat éis.</l><l xml:id="m-01b7e855-80e4-478e-a166-7d887921a94b" facs="#m-36021e12-c8c2-4fb7-977f-f18c01dc4f1a" label="text-like">The Cantors:</l><l xml:id="m-098e0c3e-0fd5-42f5-8db7-3d429ab437f6" facs="#m-233b4c2a-c6ba-4f68-a058-0e6ac3089fc0" label="lyrics-like">V. Requi-éscant in pá-ce. W. Amen.</l><l xml:id="m-73802f15-bdc2-42a4-9211-279bd5181ebb" facs="#m-70b65c0a-49de-4a46-970e-0289abc0c76b" label="text-like">AT MATINS.</l><l xml:id="m-d733c807-8d79-4bae-958e-75cb51543a9e" facs="#m-ca94afac-ac64-4d46-9784-90772d0ca4e8" label="text-like">When Matins are said on the day of the burial, the Ofice begins directiy</l><l xml:id="m-bdd782e1-f0bd-4de3-ad42-9985c49ba8ee" facs="#m-2cdb202f-7b50-46bf-a449-8f8f6105232d" label="text-like">br the Invitatory. after the chant or the Responsory Subvenite. or after</l><l xml:id="m-f91bf120-4e2a-4db5-aea9-4c36fa80aa19" facs="#m-fd5a57c6-8c44-4201-8e37-59e0d31a1f36" label="lyrics-like">Matins and Laud̃s or the day. On all other occasions, Pater, Ave, and Credo</l><l xml:id="m-3d097f07-934e-47d7-8c9b-4eb4a8076a56" facs="#m-1123aa91-fe78-4114-9634-02fa6d512ed1" label="text-like">are first said silently.</l><l xml:id="m-76544fac-8b91-44ee-af81-ba06dc398a44" facs="#m-b2d46782-0835-483b-83a6-62c475083aff" label="text-like">The Invitatory is said mhenever there are three Nocturns, even ir the</l><l xml:id="m-c8acef61-eaea-44b6-892a-3345cf4d805f" facs="#m-b84e42a0-efce-4377-bdc7-0b83a31ca339" label="text-like">Omce be of semi-double rite. It is also said when there is only one Nocturn.</l><l xml:id="m-665d008c-81ba-460b-aa8a-cf0cc077014a" facs="#m-a36b9be7-b09b-4426-89f2-1d8415503296" label="text-like">ir the Ofice be of double rite. Othervise it is omitted.</l><l xml:id="m-db675ec9-97d5-498d-bc9c-69be31a84991" facs="#m-0312b7f3-9620-46c2-98e9-7fca8f32b6ef" label="text-like">On the day of the Commemoration of all the Faithful departed, the entire</l><l xml:id="m-794adbeb-6d2b-4f3b-85d4-0fd46372457a" facs="#m-2e6cffec-0801-41ed-abd7-91bc7573b676" label="text-like">omce is said mith three Nocturns. On all other occasions, three Nocturns</l><l xml:id="m-fe75e0ee-b0dc-4b0f-9333-1be8af78a209" facs="#m-70f6027c-f16c-4383-9d06-a7f9fb5fc944" label="text-like">or one Nocturn may be said at choice. If only one Nocturn be said, it varies</l><l xml:id="m-6e839db1-bf76-43ba-8e1b-c0478a9e1083" facs="#m-3c98b9a1-51c7-4e98-b355-6743f2f77eca" label="text-like">according to the dar ot the week. On Sunday. Monday, and Thursday, the</l><l xml:id="m-7d4371da-400e-4db9-9cf9-47048872c50b" facs="#m-06dd2fc6-8b46-4c2f-8317-ffb22e0c1f49" label="text-like">first Nocturn is said; on Tuesday and Friday, the second Nocturn: on</l><l xml:id="m-e25eaee9-a4c2-4d58-9ad7-37c6f61a1fbe" facs="#m-5c28180e-5cee-408f-9c1b-f31bc5890b63" label="text-like">Wednesday and Saturday, the third. However, if only one Nocturn be said</l><l xml:id="m-7f618565-28c7-4d45-80b9-d69a1356e165" facs="#m-1298acd1-8165-4525-8815-4591712d49be" label="text-like">on the day of burial, it is always the first Nocturn.</l><l xml:id="m-2a9d8a39-3db6-4454-ae31-38907f0cc1d0" facs="#m-bbca0764-9356-4682-92fc-adb50e3bc63d" label="ambiguous">Invitatory.</l><l xml:id="m-c3d9744c-f34d-419f-9e0d-64f0c83417ff" facs="#m-81b2ce16-7e6b-4e17-82ad-7ed69c7b42dc" label="ambiguous">6.</l><l xml:id="m-003bed98-bcee-4370-8848-5c1150d5728a" facs="#m-2ea7b8c9-98a9-4723-81cb-8edfb4f525a9" label="lyrics-like">REgem cú-i ómni-a vívunt,“Veni-te ad-orémus.</l><l xml:id="m-2eb12ccf-b476-4e39-90b4-056b4ddfaf9f" facs="#m-0b6f7726-59ca-4736-a5ac-f565f7f46abd" label="lyrics-like">The Choir repeats: Régem cúi ómnia vivunt, * Venite adorémus.</l><l xml:id="m-24f5d568-72af-47b9-b224-6fb7f9e402a3" facs="#m-58d1b933-9c58-4045-8760-28777005adf6" label="ambiguous">Ps.</l><l xml:id="m-f23c19d4-e05b-440f-af1d-7237de6bc587" facs="#m-6c8c64aa-ce6f-40f6-911e-ab7c582951b6" label="lyrics-like">Ení-te, exsultémus Dómino, jubi-lémus Dé¬</l><l xml:id="m-e91897d9-8e92-49b8-b759-63c72307cb7e" facs="#m-c78a0b1d-bdb6-4958-a2f3-c4e48d36ba8a" label="lyrics-like">sa-lu-tá-ri nóstro: prae occupémus fá-ci-em é-jus</l><l xml:id="m-0079b2d7-6892-477e-9ae8-feb082d0835f" facs="#m-3657330b-a7b9-4081-ab50-e4686f89f741" label="ambiguous">in con¬</l></lg></div></section></score></mdiv></body></music>
</mei>