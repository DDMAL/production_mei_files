425" /><zone xml:id="m-36d45c05-d12e-4378-961e-045a95365a83" ulx="18" uly="421" lrx="912" lry="459" /><zone xml:id="m-5b827343-2cab-424c-be5b-00694fed6af0" ulx="18" uly="450" lrx="717" lry="483" /><zone xml:id="m-1c45f578-f454-4d22-94f7-d0d6e5cd3f42" ulx="44" uly="481" lrx="478" lry="523" /><zone xml:id="m-ec61cdd9-1bd6-4466-a25c-b838dd91cd64" ulx="44" uly="516" lrx="373" lry="552" /><zone xml:id="m-1a280aeb-4f21-4ab8-a794-be44fd3c9f80" ulx="44" uly="546" lrx="590" lry="586" /><zone xml:id="m-294cbdb8-4837-48a5-b8d2-815de217a774" ulx="144" uly="622" lrx="778" lry="668" /><zone xml:id="m-650414e5-27cd-40ab-ae09-550c5107860b" ulx="25" uly="624" lrx="110" lry="668" /><zone xml:id="m-8bf94dd0-dd01-412a-b610-b0e329d7147c" ulx="194" uly="662" lrx="618" lry="709" /><zone xml:id="m-b29bff67-cc75-4858-b11d-bc993cd14180" ulx="811" uly="664" lrx="914" lry="707" /><zone xml:id="m-bb5623fc-5883-41b9-8af6-944d757e5d2a" ulx="44" uly="711" lrx="916" lry="758" /><zone xml:id="m-2ed5b8d2-7eb1-473e-aee0-490eb81208c6" ulx="19" uly="744" lrx="298" lry="787" /><zone xml:id="m-38f5a03a-3379-4d19-8ab3-46aed1f0432e" ulx="47" uly="777" lrx="915" lry="821" /><zone xml:id="m-326a6358-e793-4d48-8518-0dddfef7e5fd" ulx="20" uly="812" lrx="159" lry="853" /><zone xml:id="m-d1ca96a1-44d6-4831-b615-0d8f1a47ea5f" ulx="413" uly="832" lrx="526" lry="874" /><zone xml:id="m-a1c5f302-6b0f-43bc-b182-7f840dfa30d4" ulx="31" uly="858" lrx="916" lry="906" /><zone xml:id="m-a37cb885-b056-4749-b8d6-4313afe2b95c" ulx="28" uly="890" lrx="915" lry="938" /><zone xml:id="m-66e17a67-4446-407c-a7e3-93c0463004cf" ulx="22" uly="925" lrx="592" lry="963" /><zone xml:id="m-bbcddc7e-3dce-4596-8221-e032c4ef3953" ulx="23" uly="953" lrx="469" lry="991" /><zone xml:id="m-daa8e278-d647-457b-bb82-6ae0e32dce49" ulx="48" uly="986" lrx="457" lry="1027" /><zone xml:id="m-c02c6326-768a-4aaf-8ebc-a32444dbaa9c" ulx="49" uly="1016" lrx="694" lry="1066" /><zone xml:id="m-8d978952-fd42-4b49-9f36-b90dda2c8dd2" ulx="421" uly="1060" lrx="523" lry="1094" /><zone xml:id="m-9763a7da-7546-4756-9d5f-e620fc6dbc60" ulx="38" uly="1088" lrx="916" lry="1131" /><zone xml:id="m-879dbeef-3dd4-40f7-b721-9a6be39ee79e" ulx="27" uly="1115" lrx="917" lry="1162" /><zone xml:id="m-ccaf878e-0bf5-4127-9055-2b815974730a" ulx="24" uly="1146" lrx="739" lry="1188" /><zone xml:id="m-1a61c334-efcf-4109-859a-5b6339f16628" ulx="345" uly="1186" lrx="591" lry="1219" /><zone xml:id="m-77348723-a302-4ff0-b57d-d265bac3699b" ulx="61" uly="1208" lrx="912" lry="1259" /><zone xml:id="m-6e90d85a-2105-48fc-9da6-c63fa989dfaa" ulx="21" uly="1245" lrx="885" lry="1285" /><zone xml:id="m-d8ac085f-b20d-4791-b013-65f991870d30" ulx="18" uly="1273" lrx="463" lry="1310" /><zone xml:id="m-c2414c95-7276-4915-9afe-3d77b3ce0c1a" ulx="164" uly="1336" lrx="625" lry="1379" /><zone xml:id="m-a71636eb-1401-468e-9a47-90640f64bb86" ulx="811" uly="1340" lrx="912" lry="1380" /><zone xml:id="m-e252514a-e777-4785-bd0b-1751ada6b583" ulx="17" uly="1344" lrx="86" lry="1388" /><zone xml:id="m-c836ce83-1e33-4582-a504-f3a731e4575f" ulx="44" uly="1380" lrx="787" lry="1423" /><zone xml:id="m-6846450e-0995-4512-9287-a4ba1f8b09bb" ulx="408" uly="1418" lrx="523" lry="1456" /><zone xml:id="m-aad96a55-0ea3-4b92-b69c-0581e228b79c" ulx="59" uly="1448" lrx="913" lry="1496" /><zone xml:id="m-b1807e92-9de3-4e74-b952-df139e5d5a63" ulx="468" uly="1477" lrx="914" lry="1518" /><zone xml:id="m-154758c2-e17c-44ee-bc49-af70faa2deeb" ulx="21" uly="1481" lrx="462" lry="1523" /><zone xml:id="m-dad65b4a-8ef4-4aea-9021-1064347dcb0e" ulx="469" uly="1506" lrx="912" lry="1548" /><zone xml:id="m-faceac7e-3cb7-4f4c-bcc0-9b46e51f47ff" ulx="19" uly="1510" lrx="463" lry="1546" /><zone xml:id="m-be4ac4f7-d68f-469d-8f7c-950faa316aac" ulx="19" uly="1538" lrx="462" lry="1573" /><zone xml:id="m-4384b91c-e85d-4df5-8caa-64ef3905315c" ulx="472" uly="1538" lrx="602" lry="1577" /><zone xml:id="m-63c7ace7-3991-4c97-812b-10b818a4b8b7" ulx="19" uly="1563" lrx="462" lry="1606" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-8f262168-8daa-40dc-a404-324ed8c1c841" n="1551" facs="#m-62ee24b7-d303-4cb7-b810-c650355594a6" /><div xml:id="m-e2d0c69c-2742-4041-a0e7-6981a11ba11f">
            <lg xml:id="m-db180a58-be68-43af-942d-bb31ec9ad016">
              <l xml:id="m-39c001b5-5f4c-45f9-a2f8-548dec48dfde" facs="#m-e26388dd-1563-458c-8d48-00db5810f3e0" label="ambiguous">January 27. 28.</l><l xml:id="m-01ce032c-440f-4cb9-bec3-1553bb792aa9" facs="#m-a881fd76-f238-40dc-8420-00bdb0385999" label="ambiguous">1351</l><l xml:id="m-d8375add-c957-42fb-987c-b026bb062522" facs="#m-c6a511d9-02a3-4638-a8ec-f5f8ae81722b" label="ambiguous">Lectio Epistolae beati Joannis Apostoli. I. Joann. J. b.</l><l xml:id="m-bc75d00a-5f07-49eb-a0ff-936d0076fb74" facs="#m-9c157b5f-fca1-4f56-a003-0bc83918709f" label="lyrics-like">(VArissimi : Omnis qui non est ju-(niam transláti sumus de morte ad</l><l xml:id="m-4e553810-a87c-490e-90da-26d68dcce01e" facs="#m-f8061e2f-bf77-4d38-88e7-7860691be733" label="ambiguous">C stus, non est ex Deo, et qui non</l><l xml:id="m-d21c01b7-97a4-4408-909d-11632be0124d" facs="#m-de4e230b-5e38-413d-bc48-6152ef2a6032" label="lyrics-like">vitam, quóniam dilígimus fratres.</l><l xml:id="m-28d8a253-90c9-4d14-95af-d02bdf4e6b3a" facs="#m-1a4adf7d-4961-45c9-8cdd-a5b50668f031" label="ambiguous">Qui non diligit, manet in morte:</l><l xml:id="m-a8a5c110-14fb-42af-884a-9e3c79fba064" facs="#m-baed706f-94cb-49d2-94a3-0fcb5d08e6ed" label="lyrics-like">diligit fratrem suum : quóniam haec</l><l xml:id="m-532025c0-bd3a-4e2d-9e01-741c78a61951" facs="#m-7064cb8b-ae43-4974-a357-82a2a0600211" label="lyrics-like">est annuntiátio, quam audistis ab</l><l xml:id="m-c5edf9b7-8552-4bf6-8492-8e18b5a1ac72" facs="#m-712ed246-5a79-4f68-9a4f-800e4f55ee7d" label="ambiguous">omnis qui odit fratrem suum, homi¬</l><l xml:id="m-093e41d0-76e9-43e4-8f28-6638a2401482" facs="#m-169a034d-17c3-401b-97db-9e29e9ee2a79" label="lyrics-like">cida est. Et scitis, quóniam omnis</l><l xml:id="m-215ad031-3000-4a7f-9f48-a3b48b7d2b3e" facs="#m-4f68e721-249f-4c93-8330-8a3b8cf38140" label="lyrics-like">instio, ut diligátis altérutrum. Non</l><l xml:id="m-20e81dca-1422-4711-a922-a3896b15806a" facs="#m-39695156-4fe7-4b46-a267-8c2794d4bed2" label="lyrics-like">homicida non habet vitam aetér¬</l><l xml:id="m-42b9d28b-4e68-4598-a65b-df4dc9b7ec1a" facs="#m-52f2afd6-1aa1-4c4d-bc88-ded38932db8a" label="ambiguous">sicut Cain, qui ex maligno erat, et</l><l xml:id="m-538f043f-9f65-4082-a971-1d71ef74359b" facs="#m-ba6703dc-bc53-4072-94ff-3ff21d0d0894" label="lyrics-like">occídit fratrem suum. Et propter</l><l xml:id="m-be39894e-b268-4689-b6c4-62f11e8c0145" facs="#m-63d59e1a-a728-43e1-b7e5-efc8bab23e02" label="lyrics-like">nam in semetípso manéntem. In</l><l xml:id="m-4aa55e67-48fc-4b6e-b0f9-bed1d1e66e7c" facs="#m-206b7d95-4e08-4929-abca-9a25f23a0213" label="lyrics-like">hoc cognóvimus caritátem Dei, quó¬</l><l xml:id="m-f559627d-d193-4227-949a-968717045bff" facs="#m-d7318315-f0a3-4560-b0a1-661553df9641" label="lyrics-like">quid occidit eum? Quóniam ópera</l><l xml:id="m-cdd631be-d180-472e-b57a-721973fca7e8" facs="#m-abf145ab-27c9-4552-b4f6-482ada0f620f" label="lyrics-like">niam ille ánimam suam pro nobis</l><l xml:id="m-ab23e162-7946-4b10-84e9-283388ce38f7" facs="#m-3af310e8-277f-49b4-9561-8733ef6fe829" label="lyrics-like">éjus maligna erant : fratris autem</l><l xml:id="m-189267e0-b7ee-47ae-9c6e-f4a3c5302d83" facs="#m-36d45c05-d12e-4378-961e-045a95365a83" label="lyrics-like">ejus justa. Nolite mirári, fratres, si l pósuit : et nos debémus pro frátri¬</l><l xml:id="m-6f80c947-4aa1-4640-be8c-83a866398352" facs="#m-5b827343-2cab-424c-be5b-00694fed6af0" label="lyrics-like">odit vos mundus. Nos scimus, quó-l bus ánimas pónere.</l><l xml:id="m-33c5b1e8-a934-4a72-aeb9-709316414ec1" facs="#m-1c45f578-f454-4d22-94f7-d0d6e5cd3f42" label="lyrics-like">Gospet. Nihil est opértum. D. 1140.</l><l xml:id="m-e35bbb3f-d3fc-4eec-bd16-5d0bba1ae7bd" facs="#m-ec61cdd9-1bd6-4466-a25c-b838dd91cd64" label="lyrics-like">Secret. Múnera tibi. p. 1135.</l><l xml:id="m-40189787-e226-4b05-b3b6-93e0c618e0cd" facs="#m-1a280aeb-4f21-4ab8-a794-be44fd3c9f80" label="lyrics-like">Postcommunion. Refécti participatióne. p. 1141.</l><l xml:id="m-d889e8cf-6535-40c9-b665-c27fe335036a" facs="#m-294cbdb8-4837-48a5-b8d2-815de217a774" label="ambiguous">St. John Chrysostom, Bishop, Confessor,</l><l xml:id="m-0e4782d9-d4ff-461c-98b6-97c44ed42639" facs="#m-650414e5-27cd-40ab-ae09-550c5107860b" label="ambiguous">27.</l><l xml:id="m-273fbf90-24d2-417d-a74d-ad4686d25695" facs="#m-8bf94dd0-dd01-412a-b610-b0e329d7147c" label="text-like">and Doctor of the Church.</l><l xml:id="m-b8a9fdb1-830c-44fe-a0f7-c6451d357a60" facs="#m-b29bff67-cc75-4858-b11d-bc993cd14180" label="ambiguous">Double.</l><l xml:id="m-32f5e1ee-8c81-4dd4-8cf7-9ba24c596753" facs="#m-bb5623fc-5883-41b9-8af6-944d757e5d2a" label="lyrics-like">At Ist and 2nd Vespers. A Magn. Ant. O Dóctor... beáte Joánnes</l><l xml:id="m-4d723153-c51e-485a-a365-a007f06f6da1" facs="#m-2ed5b8d2-7eb1-473e-aee0-490eb81208c6" label="lyrics-like">Chrysóstome. p. 262e.</l><l xml:id="m-bcb7a72b-5706-49eb-9b5b-dc42c953e5ed" facs="#m-38f5a03a-3379-4d19-8ab3-46aed1f0432e" label="lyrics-like">Mass. In médio. from the Common of Doctors, p. 1190, except the</l><l xml:id="m-f8796847-3ecd-4432-a54c-18a23f31a4a0" facs="#m-326a6358-e793-4d48-8518-0dddfef7e5fd" label="ambiguous">following:</l><l xml:id="m-b92c9f88-fbe5-4c7b-a828-5aca47d9efcb" facs="#m-d1ca96a1-44d6-4831-b615-0d8f1a47ea5f" label="ambiguous">Collect.</l><l xml:id="m-2d6caa31-b439-4dec-bc9b-5eecf10e3314" facs="#m-a1c5f302-6b0f-43bc-b182-7f840dfa30d4" label="lyrics-like">(Cclésiam tuam, quaésumus Dó- tíficis illustráre voluísti gloriósis</l><l xml:id="m-cfdef57e-4da1-48e5-9658-18a2f678ed0c" facs="#m-a37cb885-b056-4749-b8d6-4313afe2b95c" label="lyrics-like">C mine, grátia caeléstis amplifi- méritis, et doctrinis. Per Dóminum</l><l xml:id="m-f080f02d-766a-4a6c-ba41-203de9f5b11f" facs="#m-66e17a67-4446-407c-a7e3-93c0463004cf" label="lyrics-like">cet :* quam beáti Joánnis Chrysó-] nostrum.</l><l xml:id="m-e84ae0c8-dddb-4d52-9033-438155c5f2c7" facs="#m-bbcddc7e-3dce-4596-8221-e032c4ef3953" label="lyrics-like">stomi Confessóris tui atque Pon¬</l><l xml:id="m-5f6425e3-2c28-4c56-9c31-e6c8896fbbc9" facs="#m-daa8e278-d647-457b-bb82-6ae0e32dce49" label="lyrics-like">Gradual. Ecce sacérdos. p. 1183.</l><l xml:id="m-bf351154-2e1e-4ae0-a1a4-49ac5394f531" facs="#m-c02c6326-768a-4aaf-8ebc-a32444dbaa9c" label="lyrics-like">Allelúia, allelúia. V. Beátus vir qui súffert. p. 1202.</l><l xml:id="m-6cb045c3-2af4-40f6-96ed-3e7e7bd6410c" facs="#m-8d978952-fd42-4b49-9f36-b90dda2c8dd2" label="ambiguous">Secret.</l><l xml:id="m-921cad04-c8a3-484a-9ea9-affa6fbed722" facs="#m-9763a7da-7546-4756-9d5f-e620fc6dbc60" label="lyrics-like">NAncti Joánnis Chrysóstomi Pon-] et múnera nostra conciliet, et tuam</l><l xml:id="m-d837986e-cc53-4fad-806e-5fa739e4a854" facs="#m-879dbeef-3dd4-40f7-b721-9a6be39ee79e" label="lyrics-like">O tfficis tui atque Doctóris nobis, l nobis indulgéntiam semper obtt¬</l><l xml:id="m-0dc5196f-a218-4b60-9765-fcb29223513d" facs="#m-ccaf878e-0bf5-4127-9055-2b815974730a" label="lyrics-like">Dómine, pia non desit orátio: quae! neat. Per Döminum.</l><l xml:id="m-9c4c3c50-a17e-46a4-96b1-1b75056d6ccb" facs="#m-1a61c334-efcf-4109-859a-5b6339f16628" label="ambiguous">Postcommunion.</l><l xml:id="m-fabba703-892f-4edc-b63a-0b97147b85b6" facs="#m-77348723-a302-4ff0-b57d-d265bac3699b" label="lyrics-like">T nobis, Dómine, tua sacrificia ! ctor egrégius, quaésumus, precátor</l><l xml:id="m-745e133b-adee-4443-8e43-fb4a4cf04f2e" facs="#m-6e90d85a-2105-48fc-9da6-c63fa989dfaa" label="lyrics-like">U dent salûtem : beãtus Joánnes ! accédãt. Per Döminum nostrum.</l><l xml:id="m-9cf9db83-033c-4d69-aa68-27f0bc3dd361" facs="#m-d8ac085f-b20d-4791-b013-65f991870d30" label="lyrics-like">Chrysóstomus Póntifex tuus et Do¬</l><l xml:id="m-02c7900c-1ee2-4447-a3ad-3b416aa3e960" facs="#m-c2414c95-7276-4915-9afe-3d77b3ce0c1a" label="ambiguous">St. Peter Nolasco, Confessor.</l><l xml:id="m-4f09b604-8cb2-423e-ad43-29182ae51015" facs="#m-a71636eb-1401-468e-9a47-90640f64bb86" label="ambiguous">Double.</l><l xml:id="m-c750757f-2b46-4a06-a47f-9bc8af991800" facs="#m-e252514a-e777-4785-bd0b-1751ada6b583" label="ambiguous">28.</l><l xml:id="m-5b7a186a-36e9-4ccd-9cbc-78dedd9bd4f0" facs="#m-c836ce83-1e33-4582-a504-f3a731e4575f" label="lyrics-like">Mass. Jústus ut pálma. of a Confessor not a Bishop, p. 124</l><l xml:id="m-31911ea0-1b85-4863-b93b-904abdac5f8b" facs="#m-6846450e-0995-4512-9287-a4ba1f8b09bb" label="ambiguous">Collect.</l><l xml:id="m-a27993eb-9d97-4042-b8fc-779020a799a6" facs="#m-aad96a55-0ea3-4b92-b69c-0581e228b79c" label="lyrics-like">Eus, qui in tuae caritátis exém-[cessióne concéde; a peccáti servi¬</l><l xml:id="m-f51731ab-373b-42bf-97d7-bd714c917341" facs="#m-b1807e92-9de3-4e74-b952-df139e5d5a63" label="lyrics-like">túte solútis, * in caelésti pátria per¬</l><l xml:id="m-e6d958fc-6fa4-46b9-9cd6-21455a78c15c" facs="#m-154758c2-e17c-44ee-bc49-af70faa2deeb" label="lyrics-like">I plum, ad fidélium redemptió¬</l><l xml:id="m-da2cbd4e-34ec-4d10-a70e-a8afc9db1e32" facs="#m-dad65b4a-8ef4-4aea-9021-1064347dcb0e" label="lyrics-like">pétua libertáte gaudére: Qui vivis</l><l xml:id="m-586ea170-6733-4d54-ac4b-18e1d738c785" facs="#m-faceac7e-3cb7-4f4c-bcc0-9b46e51f47ff" label="lyrics-like">nem sanctum Petrum Ecclésiam</l><l xml:id="m-707c8e48-8f46-449f-aa6b-9990c35ae77b" facs="#m-be4ac4f7-d68f-469d-8f7c-950faa316aac" label="lyrics-like">tuam nova prole foecundáre diví¬</l><l xml:id="m-cc6212d3-8451-4504-aae6-a2a8ff4794ff" facs="#m-4384b91c-e85d-4df5-8caa-64ef3905315c" label="ambiguous">et regnas.</l><l xml:id="m-c0821f7a-daf3-4801-acd7-4057ca33ca8c" facs="#m-63c7ace7-3991-4c97-812b-10b818a4b8b7" label="ambiguous">nitus docuisti : t ipsius nobis inter¬</l></lg></div></section></score></mdiv></body></music>
