0-2c806f2f35ba"><syl /><neume facs="#m-6367945a-b537-4409-9c53-dbe680c86a33" type="punctum" xml:id="m-f1f255ad-d2fa-4f47-9ee8-fb4801dea03b"><nc xml:id="m-21f1b800-cd6a-48e1-9fca-dcdf89e4e901" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-ab956c9e-ec06-48da-b2d0-c090855f14cc"><syl /><neume facs="#m-bac209bd-82f2-4f32-a40e-d9a7635db68d" type="punctum" xml:id="m-3ad7a328-e691-4730-8319-c068fb85239e"><nc xml:id="m-746b999b-e913-46c3-a9e1-77ad4182438d" pname="c" oct="4" /></neume></syllable><syllable xml:id="m-0cfd7591-1b1f-495e-b8f0-56b13e5fe7e8"><syl /><neume facs="#m-93c6b720-0610-479a-a80e-cb4b0f0ac747" type="punctum" xml:id="m-b8853185-d511-4ade-9ce2-e5fe6e953648"><nc xml:id="m-615909f5-4c75-4a6a-a6ec-540e5ba96017" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-fc36df6c-4961-4f2b-ac82-b9521b6e1b55"><syl /><neume facs="#m-12d42020-3663-4e9d-9d68-2b0babb6c0a6" type="punctum" xml:id="m-2c2cee05-4e1d-40d7-a002-d1bd6a37129c"><nc xml:id="m-e171a2d6-72a8-4865-bc8c-0b0b8e292ec9" pname="g" oct="3" /></neume></syllable><divLine xml:id="m-7f325780-bef7-4a08-8eaa-f314228d607c" facs="#m-8adda5a4-6077-4326-b713-6228815d5e31" form="finalis" /><syllable xml:id="m-582bd8cf-18dc-447d-9eed-ff9a912aca86"><syl /><neume facs="#m-90d46a71-08de-4b52-ba0a-57902c33be76" type="punctum" xml:id="m-c8955de3-0696-4b7f-baf7-90bf280f5173"><nc xml:id="m-4938e03d-6cc0-42c1-8cc3-62d6cf01a11f" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-8b0f289a-799e-44a7-aec1-98c281b2a061"><syl /><neume facs="#m-8f24efb6-90d3-4980-8eb6-b08df6a77dac" type="punctum" xml:id="m-53c876cd-64c0-48aa-be57-4c30eb02fab9"><nc xml:id="m-4249f463-21d5-470f-a629-86d80895ccc2" pname="g" oct="3" /></neume></syllable><divLine xml:id="m-ea3466b0-7813-4a3d-8df8-5d106520b3fb" facs="#m-479181e9-8668-4c6d-b325-4a5ca3b2919f" form="finalis" /><clef xml:id="m-f8a9fa49-cbdc-4ba5-a1ed-d7fac7486e65" facs="#m-51625f58-fbf2-4d8e-b547-5c375ba733dd" shape="C" line="4" /></layer></staff><div xml:id="m-ba7d6d1f-8a06-4b5a-b394-2f36b229cc72"><lg xml:id="m-3f111e85-dbcf-4fad-8c59-697766e8e670"><l xml:id="m-1f72f4d4-b163-4c51-b14e-f64a0c47bf59" facs="#m-6e455079-7d2c-4843-9c8c-f2bbb4f66034" label="ambiguous">September 8.</l><l xml:id="m-199b5841-0643-4836-b4b2-60f03acc87ad" facs="#m-752865e0-bb32-480b-97e6-a8407b5c7773" label="ambiguous">1e25</l><l xml:id="m-48ce3045-7134-4f41-8a70-7ef2c45f0ed2" facs="#m-cffa20e3-6d45-42a5-9436-ee1c13896c5e" label="lyrics-like">tem génuit Joram. Joram autem Zoróbabel. Zoróbabel autem génuit</l><l xml:id="m-ed6bfcb2-0350-4885-a3a9-8c830a933006" facs="#m-6c5d9eb6-c868-4b2b-a724-c5974ede89dd" label="lyrics-like">génuit Ozíam. Ozias autem génuit</l><l xml:id="m-0bc64a47-5c9b-4122-ab9a-4c1e1311ee18" facs="#m-9c8b3bda-a966-41fe-a42d-0795be668a47" label="lyrics-like">Abiud. Abiud autem génuit Ella¬</l><l xml:id="m-9a9b4882-0600-4018-9efc-7bfcf9d455ca" facs="#m-a6edd5fa-317b-4681-94ba-a89d0bae043d" label="lyrics-like">Jóatham. Jóatham autem génuit</l><l xml:id="m-731af679-2a03-475a-bc22-ac2055cda38a" facs="#m-9e2bd25e-7d07-45e0-b6a4-56624f155b61" label="lyrics-like">cim. Eliacim autem génuit Azor.</l><l xml:id="m-9e51d1a6-86f6-42f3-bd86-3b37259c6e41" facs="#m-cb761a00-03b7-40e2-8113-18fb2c3f112c" label="lyrics-like">Achaz. Achaz autem génuit Eze¬</l><l xml:id="m-b60bf56c-9bd2-47a7-a36f-5a140b8d4a89" facs="#m-91a35716-d149-4f33-9bac-302e27de7b56" label="lyrics-like">Azor autem génuit Sadoc. Sadoc</l><l xml:id="m-b46ebfeb-2c8d-427d-b920-e713542c3e91" facs="#m-b8fd5001-a075-4ddb-a326-6cb3b202107d" label="lyrics-like">chíam. Ezechías autem génuit Ma¬</l><l xml:id="m-5d9ba995-8f50-4f55-8dfe-6dbbb7543d09" facs="#m-3c4036e6-4d53-4328-8de7-caeabf23bc0f" label="lyrics-like">autem génuit Achim. Achim autem</l><l xml:id="m-64bf900b-6073-4336-b3aa-4fd50be5ec24" facs="#m-00b2966d-58e8-43d4-ac38-8d5faed59c03" label="lyrics-like">génuit Eliud. Eliud autem génuit</l><l xml:id="m-78827aa0-bc9d-4a04-8e26-30ce9645134e" facs="#m-f6e9b146-aad7-46bb-b8fa-9b9d0af22e47" label="lyrics-like">nássen. Manásses autem génuit</l><l xml:id="m-f0aeb8af-79f6-49e0-b1e6-1136fa759b9b" facs="#m-50674306-8803-4338-a4cb-96044ec85ea9" label="lyrics-like">Amon. Amon autem génuit Josíam.</l><l xml:id="m-d26508f4-6f23-4e02-b51e-1b7510bcc028" facs="#m-943d77c7-a882-4756-8b66-cc5c5a5f9f44" label="lyrics-like">Éleázar. Eleázar autem génuit Ma¬</l><l xml:id="m-6559260b-aea1-4ccf-b93d-cb8f75881893" facs="#m-06b52ebc-ca07-469f-ada0-5943a6f7be75" label="lyrics-like">than. Mathan autem génuit Jacob.</l><l xml:id="m-c49a7f1d-7547-4f18-96ad-028705eee3c4" facs="#m-76c54a9e-ee5d-48a8-a85b-9b7bd2b093a7" label="lyrics-like">Josías autem génuit Jechoníam,</l><l xml:id="m-ce0bc19a-1656-4a6f-9dc5-7ffcd59086da" facs="#m-5fd5bb2f-a14b-4e16-a521-3ca9442e3a7f" label="lyrics-like">et fratres ejus in transmigratióne</l><l xml:id="m-06c5a9a4-dfbd-443b-a55f-20646190f58b" facs="#m-91e19dfc-318a-43e8-81d9-f4dd6298067d" label="lyrics-like">Jacob autem génuit Joseph virum</l><l xml:id="m-89b663fd-89ee-460d-9e25-8d2ffd5a8aad" facs="#m-2601b20f-4719-47a2-b096-a528533691e1" label="lyrics-like">Babylónis. Et post transmigratió¬</l><l xml:id="m-7d27ea28-b912-4c28-a376-10210ca6c6f5" facs="#m-ae360df6-39e9-41d1-9344-de2b2b9d5730" label="lyrics-like">Maríae, de qua natus est Jesus, qui</l><l xml:id="m-905ea2e1-887c-4f93-8b05-48ec0ef075e9" facs="#m-9da02af8-ec8f-4970-a69c-dbf2bf5181f9" label="ambiguous">Credo.</l><l xml:id="m-2bc8d3a7-cb7b-44ee-b181-67160f4f4433" facs="#m-cd1c8d08-0248-4767-bebf-cbdaf522c0b7" label="lyrics-like">nem Babylónis: Jechonias génuit</l><l xml:id="m-bd04bafd-7c06-4afd-8734-344f6322d319" facs="#m-c4af0fe1-fe57-43d7-888f-15044d5c6cdd" label="lyrics-like">vocátur Christus.</l><l xml:id="m-67e41e0b-9c5d-4b85-a817-7a137bd17f35" facs="#m-ef0f1909-4010-414e-9ae3-6f72c8b99d90" label="lyrics-like">Saláthiel. Saláthiel autem génuit</l><l xml:id="m-6100a9f9-f3e1-4bb7-9cb5-1a7531a43289" facs="#m-26ed741f-5262-4e75-b9d2-461a79228c77" label="lyrics-like">offertory. Beáta es Virgo Maria. p. 1272, omitting Allelúia. at the end.</l><l xml:id="m-2b39f713-289c-4f8c-be4a-0e820a62714f" facs="#m-01151088-580d-4802-b434-527de0441d53" label="ambiguous">Secret.</l><l xml:id="m-f65a67c1-01cd-4f9b-995f-619586f2b95c" facs="#m-25b6f0ea-4ad4-486a-971a-25d675ffe234" label="lyrics-like">(Nigéniti tui Dómine nobis suc-! ejus solémniis, nostris nos piáculis</l><l xml:id="m-b229abae-b829-4d19-b55d-04b882754ad9" facs="#m-ed9a3c17-8200-47bd-843a-53b92adad269" label="lyrics-like">U cúrrat humánitas: ut qui natus l éxuens, oblatiónem nostram tibi</l><l xml:id="m-6deebfb0-256f-44d2-9d7f-8c153a84f7cd" facs="#m-54ba8d2f-f77e-4d71-8e9a-fda8c3dafebc" label="lyrics-like">de Virgine, Matris integritátem non! fáciat accéptam Jesus Christus Dó¬</l><l xml:id="m-45c172d6-a5f2-450d-b56e-aa6ea708eb78" facs="#m-f90b200f-4aae-4175-8683-5c9d3bd0b71e" label="lyrics-like">minuit, sed sacrávit; in Nativitátis! minus noster : Qui tecum vivit.</l><l xml:id="m-61581581-840f-477a-a003-be5727ed47c7" facs="#m-bdf5f55f-9436-419a-8d86-1ff13f70ff89" label="lyrics-like">Preface of the B. V. M. Et te in Nativitáte. p. 10.</l><l xml:id="m-53470b78-f146-4a57-9910-24c39d0a35e6" facs="#m-3484ee1f-1cd4-4611-b094-6c098c5406d3" label="lyrics-like">Communion. Beáta viscera. p. 1268.</l><l xml:id="m-37d571f0-e7d2-4b0d-9499-807024daf27f" facs="#m-e130104b-b45a-4745-b72d-6bc8450c82d9" label="ambiguous">Postcommunion.</l><l xml:id="m-edea3020-8ef0-4c2a-bfad-8c416f6d894b" facs="#m-64af63ba-8e1a-4ccd-ad3d-79b07b23cecc" label="lyrics-like">YUmpsimus Dómine celebritátis! rális vitae nobis remédia praébeant,</l><l xml:id="m-0011500f-49a2-4c1b-80a1-03d264c89176" facs="#m-951e19ff-0756-4aee-9c2d-cbd9d32edbdc" label="lyrics-like">D ánnuae votiva sacraménta: et aetérnae. Per Dóminum.</l><l xml:id="m-be2a9603-719e-4165-a412-e5f3e9ca6e0d" facs="#m-cb9f3b26-0701-401c-86f0-1b88696c9b84" label="lyrics-like">praesta, quaésumus; ut et tempo¬</l><l xml:id="m-3eb4c54f-8f97-4da3-944b-4eb0b52ad861" facs="#m-8b620ea0-e778-45ff-a081-f108574707df" label="lyrics-like">At Sext. Ant. Regáli ex progénie. p. 1626. Chapter. Et sic in Sion.</l><l xml:id="m-6740ddd0-e164-4d0b-9849-21e277ea0022" facs="#m-754ba55d-ca1e-4e81-85cc-71b6f84c0317" label="lyrics-like">Short Resp. Adjuvábit éam. D. 1257. V. Elégit éam.</l><l xml:id="m-98c660b3-208e-4f00-8b8e-b34e46718d7f" facs="#m-36fb9a40-ec3b-4f8f-908d-be2e7d73b1e0" label="lyrics-like">At None. Ant. Cum jucunditáte. p. 1626. Chapter. In platéis. p. 1257.</l><l xml:id="m-a7c6559c-f476-4c10-a52a-9709cd59b2b8" facs="#m-b86e4afa-6f38-45a3-b6f0-fd714da290be" label="lyrics-like">Short Resp. Elégit éam. D. 1258. v. Diffúsa est.</l><l xml:id="m-38e4ed22-fb46-45e9-865f-3297ae79e96e" facs="#m-d2ebc052-3c91-4533-ab00-26f8f1423274" label="text-like">AT SECOND VESPERS.</l><l xml:id="m-bb999911-1332-4d07-a95f-8dee72fbdf42" facs="#m-669edcdd-4245-45a7-adce-55df35566d15" label="lyrics-like">Psalms. 1. Dixit Dóminus. 8. G. p. 133. — 2. Laudáte púeri. 7. c. p. 151.</l><l xml:id="m-b0242d5c-4d97-4b14-a630-c67ecb8b1176" facs="#m-730f2902-b588-4d72-81d6-439039f09e0a" label="lyrics-like">— 3. Laetátus sum. 6. F. p. 172. — 4. Nisi Dóminus. 8. G. p. 177.—</l><l xml:id="m-e0179d3a-0116-4186-bfbc-84b2673c4e1f" facs="#m-de9fbe40-ab71-46ba-842e-6330f46ae885" label="lyrics-like">5. Láuda Jerúsalem. 7. c. p. 206.</l><l xml:id="m-add15995-c56d-41e3-ba68-1d46b74db924" facs="#m-8430dc41-f1fc-4576-b2cd-6c783fee2f12" label="ambiguous">1. Ant.E</l><l xml:id="m-daf3964a-c6cb-49b8-9601-b8170139894c" facs="#m-bb8962cd-677e-428c-9ac1-9d88f84b5ac8" label="ambiguous">8.d</l><l xml:id="m-d6dbd633-c46b-4698-a46c-53f990701df7" facs="#m-610d4c83-d100-4316-92dd-f5df6b8232f9" label="lyrics-like">Atí-vi-tas glo-ri-ósae“ Virgi-nis Ma-rí-ae, ex sé¬</l><l xml:id="m-36bccfc1-8c17-4c43-9c44-9eebb68284d0" facs="#m-70dcd31b-6a63-4d47-84b7-f4c2996391b0" label="lyrics-like">mine A-brahae, órtae de tríbu</l><l xml:id="m-e662542a-912d-4e6c-aee8-bd91b2faea6d" facs="#m-b22ef962-8438-4480-9449-e5fc2fe49055" label="lyrics-like">Jú-da, clá-ra ex stírpe</l><l xml:id="m-4da48a76-1ee3-4934-b60c-481639829e2e" facs="#m-6f2013fa-5390-496f-ba53-1309bb99a09e" label="ambiguous">2. Ant.</l><l xml:id="m-38578747-29d3-4c5c-9b27-9c51dd5566ea" facs="#m-429569a4-bc4e-4448-b425-ccceb8c003a9" label="ambiguous">7.e</l><l xml:id="m-2aa121de-90ba-42fc-9a39-294f8a2019fa" facs="#m-c4e04751-3a60-4714-a02d-c9f5d6bfc180" label="ambiguous">n</l><l xml:id="m-5edfede2-3384-4178-b645-3fed1796d26b" facs="#m-cffe343d-a8f2-4903-9358-c0878e9f4e20" label="lyrics-like">Atí-vi-tas est hódi-e“ sán¬</l><l xml:id="m-50c4f812-5110-4c10-8fac-fb26381ef121" facs="#m-3f1cbbfb-b53b-42d9-9fe9-c30fd020cbc0" label="lyrics-like">Dávid. Eu o u a e.</l></lg></div></section></score></mdiv></body></music>
