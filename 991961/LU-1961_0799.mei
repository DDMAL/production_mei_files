                  <syl /><neume facs="#m-160f23e6-8522-485d-b77f-bcebd49ba11e" type="punctum" xml:id="m-c05b7c7a-8482-484f-b623-4d50f61ad969">
                    <nc xml:id="m-93f0737f-f87c-4b7b-9dc8-66f1923a1489" pname="f" oct="3" />
