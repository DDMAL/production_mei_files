 uly="715" lrx="851" lry="756" /><zone xml:id="m-4b9378b2-5669-43fb-b0cf-cfbdf1793a46" ulx="128" uly="760" lrx="913" lry="797" /><zone xml:id="m-64bceee1-e44a-426b-8cda-cb1fdf37273a" ulx="100" uly="788" lrx="914" lry="818" /><zone xml:id="m-02893ca6-253e-4f79-8703-3ed0f58fdd35" ulx="100" uly="811" lrx="228" lry="844" /><zone xml:id="m-37946d6f-ae5f-44b6-90b9-f0226ad1caf0" ulx="125" uly="834" lrx="914" lry="871" /><zone xml:id="m-999e0c68-670b-44a5-a6bf-ac9dd7fcff60" ulx="99" uly="863" lrx="714" lry="891" /><zone xml:id="m-d5005a30-26db-4028-ae9e-7c694d87fca0" ulx="127" uly="886" lrx="914" lry="919" /><zone xml:id="m-87d3db66-3e05-40ed-9faf-8f3118cf7595" ulx="100" uly="910" lrx="913" lry="945" /><zone xml:id="m-f5ca1792-30a2-4996-929d-4d98d7f0e057" ulx="100" uly="935" lrx="913" lry="971" /><zone xml:id="m-439a4b87-7eab-40df-8c3a-63ab72f85ed8" ulx="101" uly="957" lrx="546" lry="994" /><zone xml:id="m-2e50cae8-74c9-4dea-8a16-f38e59536165" ulx="128" uly="993" lrx="593" lry="1028" /><zone xml:id="m-98025ad2-4847-4287-89bd-9ce096adc725" ulx="125" uly="1026" lrx="914" lry="1059" /><zone xml:id="m-f4c9bcd1-ea71-4604-90db-7ba8a8da57c9" ulx="102" uly="1057" lrx="914" lry="1084" /><zone xml:id="m-df4761c2-59db-48c9-b8f3-1c3bbfb403c5" ulx="102" uly="1080" lrx="914" lry="1108" /><zone xml:id="m-efd6946e-1059-4fab-9330-f1f3545c4eb7" ulx="104" uly="1106" lrx="914" lry="1131" /><zone xml:id="m-9ec19c47-ea94-42fb-9f10-89985ca62fdd" ulx="104" uly="1124" lrx="916" lry="1155" /><zone xml:id="m-67d7b41f-a3e9-4be5-9e27-0f157f531422" ulx="103" uly="1148" lrx="915" lry="1181" /><zone xml:id="m-4d526d95-e4ed-4b82-9de4-a29ba9802470" ulx="104" uly="1178" lrx="246" lry="1204" /><zone xml:id="m-9cef5ac0-59da-4229-bea6-eea2d05f14a9" ulx="316" uly="1201" lrx="707" lry="1235" /><zone xml:id="m-8f5cef83-439a-44a6-9ef1-30c365eea1bf" ulx="141" uly="1241" lrx="916" lry="1275" /><zone xml:id="m-1008ce6a-31fe-47f5-82e3-37859574edb4" ulx="108" uly="1266" lrx="916" lry="1301" /><zone xml:id="m-cbe37113-d958-4547-823c-bd2a797e1227" ulx="104" uly="1297" lrx="914" lry="1331" /><zone xml:id="m-4c696d46-baa2-4d7d-b051-02748bc6a0a2" ulx="105" uly="1323" lrx="917" lry="1360" /><zone xml:id="m-82a4e676-d259-4334-8228-ad3b73f510e5" ulx="105" uly="1349" lrx="472" lry="1388" /><zone xml:id="m-fa3a79ac-b838-4f8d-be19-7e1219a30208" ulx="131" uly="1389" lrx="915" lry="1430" /><zone xml:id="m-6a97751f-7ba8-4278-afb6-a9aa6061668b" ulx="107" uly="1417" lrx="480" lry="1451" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-857125ce-7550-41e1-a689-ef766a474c90" n="0878" facs="#m-18500f9d-22cc-4996-8bc1-852c56fa87be" /><div xml:id="m-cba490f4-e358-4aaf-8a6d-49119d1b354c">
            <lg xml:id="m-071e990b-94af-4142-9ff1-16dd268cf1ad">
              <l xml:id="m-ff1e63eb-9312-4ad3-b76c-14ccfa828d9b" facs="#m-1540675a-82ec-4b01-a880-5173d0524eeb" label="ambiguous">732</l><l xml:id="m-74c19fd7-8a0b-4a8a-88b1-0c9634c492e0" facs="#m-60e6cc82-a6f6-463d-8db8-42b87d2a7d2b" label="ambiguous">Good Friday</l><l xml:id="m-ce723ad1-8a6f-4f4c-b5d7-71248f4d237a" facs="#m-c9db36fd-9d5b-406e-a4d5-131efcfb8b52" label="lyrics-like">quidem fregérunt crura, et alté- occultus autem propter metum</l><l xml:id="m-b33ae96b-5679-4ced-80ce-3334b16b8282" facs="#m-5d075e5d-28a5-4f45-9e7a-14daf5480913" label="lyrics-like">Judacórum, ut tólleret corpus</l><l xml:id="m-0e7d020f-db63-4229-8955-1bba3df0f4f5" facs="#m-69912a75-ca0f-42f9-b3c4-a30214493944" label="ambiguous">rius qui crucifixus est cum eo.</l><l xml:id="m-59a00a36-27d4-40ac-b56a-7c95b13075fe" facs="#m-4aeb5ed2-e4f1-429b-a33c-071bf51032e7" label="lyrics-like">Jesu. Et permisit Pilátus. Venit</l><l xml:id="m-444eecb7-2ecb-4f26-ae1e-0db146a4eca3" facs="#m-284d5371-2be5-454e-8709-8acce9a341ad" label="ambiguous">Ad Jesum autem cum venissent,</l><l xml:id="m-ecd7e288-7f18-4dc2-9026-08f6545c056e" facs="#m-ddee7836-a0b6-40f3-bedf-e685fd8899c3" label="ambiguous">ergo, et tulit corpus Jesu. Venit</l><l xml:id="m-499bac5e-4e54-4f94-92d1-04ede0b72d0f" facs="#m-ae852e2a-6ba2-4043-9461-81a26a6c3e7a" label="lyrics-like">ut vidérunt eum jam mórtuum,</l><l xml:id="m-2410d703-6119-4c60-a2d0-b1c4869dd99d" facs="#m-69ef5c9d-b97d-4991-9716-ab3999e1b2a8" label="lyrics-like">autem et Nicodémus, qui vénerat</l><l xml:id="m-ca591ef7-1517-4a99-a0dc-2769d6c47e38" facs="#m-00013ea7-c5b7-4ff2-b4cb-935300d60a84" label="lyrics-like">non fregérunt ejus crura, sed</l><l xml:id="m-9b5402f9-37cf-40ca-a800-2558ea0c2c35" facs="#m-c760e6d5-f2e3-48e7-8b88-57031db48c0b" label="lyrics-like">ad Jesum nocte primüm, ferens</l><l xml:id="m-aa16c994-20bd-4e6d-a3b4-32c54fe6f87e" facs="#m-2ab699e2-8889-4660-98aa-8ebd69c70ab8" label="lyrics-like">unus militum láncea latus ejus</l><l xml:id="m-9a896dea-cc10-424a-a952-590de9bab712" facs="#m-c1e5cadb-29a7-4507-afa1-2b04f34e1ad1" label="lyrics-like">apéruit, et continuo exivit san¬</l><l xml:id="m-1cdf5eea-317f-4f0d-8add-d80c7841f2f1" facs="#m-a730fb00-1a34-4feb-ba2f-635cb2c620c2" label="lyrics-like">mixtúram myrrhae et áloës,</l><l xml:id="m-7a638b02-1640-45a9-a6ec-a561e5f379cb" facs="#m-c1c43df7-c450-4c28-9937-d1bad0038bbf" label="ambiguous">guis, et aqua. Et qui vidit, testi¬</l><l xml:id="m-c538e899-4cc3-4fc3-8bc8-267a798c6896" facs="#m-8de82a35-b320-46f9-aabc-fb82c87e6e1e" label="lyrics-like">quasi libras centum. Accepérunt</l><l xml:id="m-5fc0c040-a92f-4ec7-9a55-ecce160021e1" facs="#m-b85f2af9-dac1-4458-92f6-ac9298718896" label="lyrics-like">mónium perhibuit: et verum est</l><l xml:id="m-d07ecc97-a052-43b1-91e3-ea966d003605" facs="#m-b06a808f-b651-4b87-b0c8-afd79e4d6fd3" label="lyrics-like">ergo corpus Jesu, et ligavérunt</l><l xml:id="m-66bab858-8e00-48ed-846b-dcd697c035a6" facs="#m-08fe6319-070b-4102-9c0f-bd5d11a40fe8" label="lyrics-like">illud linteis cum aromátibus,</l><l xml:id="m-42f838a1-d756-40ba-a6a7-db2ec61afa3d" facs="#m-d04b0a78-15bd-4f06-8632-58cfdbd1ea50" label="lyrics-like">testimónium ejus. Et ille scit, quia</l><l xml:id="m-3f9f0d0f-876a-411a-90d1-5a2c1b5e9d96" facs="#m-a163ebfc-676b-4ec1-be46-284d36bd114b" label="lyrics-like">sicut mos est Judaéis sepelire.</l><l xml:id="m-61fbe610-570e-4a0d-97c1-c28bba04e87e" facs="#m-3f910bd3-a1d4-412c-b542-40ea850cb571" label="lyrics-like">vera dicit: ut et vos credátis.</l><l xml:id="m-4698da32-7fa6-43d7-bed7-1d12c8068748" facs="#m-ae62406b-5ad1-4a60-892f-d16f13691074" label="ambiguous">Facta sunt enim haec ut Scri¬</l><l xml:id="m-dbbc0137-d852-42d1-a098-ba9f50a14ac6" facs="#m-4aab0821-8dac-4ed6-abdc-59c9756daa94" label="ambiguous">Erat autem in loco, ubi crucifixus</l><l xml:id="m-b12d4488-693d-42b2-9e0f-f5fe0c13dc12" facs="#m-c425137c-8ea6-45b7-a892-a039a0fe1ea9" label="ambiguous">est, hortus : et in horto monu¬</l><l xml:id="m-fa1746d8-f7f8-4c39-86e7-54533b519041" facs="#m-e912ba5c-35c6-435c-bb28-a85ac4558712" label="lyrics-like">ptúra implerétur : Os non com¬</l><l xml:id="m-9bdab9de-6acf-4e8c-bfef-ef7300cabc93" facs="#m-33381e05-4a4e-4a2c-8f8d-88c928ccb2c6" label="lyrics-like">minuétis ex eo. Et iterum ália</l><l xml:id="m-4d5423e0-8858-478f-a6b3-a444394a943b" facs="#m-443ff99a-1f49-4ccd-bd31-7ca8a2111834" label="lyrics-like">méntum novum, in quo nondum</l><l xml:id="m-a5e7a4bf-0c0a-46e4-89f0-d85307ed471d" facs="#m-bc282930-1663-48b8-bf26-09ca84e46379" label="lyrics-like">quisquam pósitus erat. Ibi ergo</l><l xml:id="m-ee3ffbc9-4c27-4e38-82f9-0cb39a6dc70e" facs="#m-3380beb8-6a32-4a8b-aa55-5064b28f015e" label="lyrics-like">Scriptúra dicit: Vidébunt in</l><l xml:id="m-f1c21f25-4863-448f-b626-c5ff53b8433f" facs="#m-a58d8dfe-2815-4eb0-a805-e339b8e5640f" label="lyrics-like">propter Parascéven Judacórum,</l><l xml:id="m-ea3fc0ff-286b-4115-b801-7dc56f06184a" facs="#m-02f40cbb-9131-4008-a6ac-fff73baa4089" label="lyrics-like">quem transfixérunt.</l><l xml:id="m-66a112da-1d53-4656-8af4-01d720498431" facs="#m-03a0de89-d622-40c6-ae44-7f8e8dc093cb" label="lyrics-like">Post haec autem rogávit Pi¬</l><l xml:id="m-253b0fd2-2ae1-4fff-8418-d9dbb313da4d" facs="#m-767cca41-e9d5-4110-a1c4-a91ae0fe923c" label="lyrics-like">quia juxta erat monuméntum,</l><l xml:id="m-887be531-3e7e-4c5f-be34-52e736b14c82" facs="#m-8d05f46d-1516-4113-ba06-ae3aa9932a18" label="lyrics-like">látum Joseph ab Arimathaéa,</l><l xml:id="m-948eb005-8a1f-486b-a750-14084fbb6bde" facs="#m-c6b4ffb1-5f16-42fa-93a4-0d650ff32d74" label="lyrics-like">posuérunt Jesum.</l><l xml:id="m-512bd6be-a3b2-4197-beed-e0512f0b5fd4" facs="#m-c5eca235-57e8-4f76-916d-e8f77df2b098" label="lyrics-like">co quod esset discípulus Jesu,</l><l xml:id="m-2c3782cd-dd15-4339-9398-04f9b7d0496b" facs="#m-29fdea49-941d-4ccc-b129-57a4c47b1926" label="text-like">SECOND PART OF THE LITURGY:</l><l xml:id="m-d54e1bcb-7a62-41eb-aa56-17d1bc517b91" facs="#m-407db4ae-0bcc-4fcf-a20f-ef3e8dc8e1be" label="text-like">THE SOLEMN COLLECTS,</l><l xml:id="m-faebea31-f7ef-4452-8f91-ae391f8858f5" facs="#m-f361973f-1e3e-417d-8e91-f789aa135646" label="text-like">ALSO CALLED THE PRAYER OF THE FAITHFUL</l><l xml:id="m-64b31fdf-10c1-434e-b9e4-cc1522b88344" facs="#m-4b9378b2-5669-43fb-b0cf-cfbdf1793a46" label="text-like">12. When the singing or reading of the Passion is finished, the celebrant,</l><l xml:id="m-c44eadaa-e9ec-4582-8d1c-694d5fd409d4" facs="#m-64bceee1-e44a-426b-8cda-cb1fdf37273a" label="lyrics-like">at the sedilia, puts on a black cope, thé deacon and subdeacon a blacke dalmatic</l><l xml:id="m-16a98ad1-0ecd-48f0-bbff-10ecc161aea8" facs="#m-02893ca6-253e-4f79-8703-3ed0f58fdd35" label="text-like">and tunicle.</l><l xml:id="m-aecafd76-fe7b-4f24-97b8-995b0bc6b3ca" facs="#m-37946d6f-ae5f-44b6-90b9-f0226ad1caf0" label="text-like">Meanwhile, two acolytes lor tuo serversl spread a single linen cloth on the</l><l xml:id="m-ab3524f8-afca-4bf3-ad93-5b64a3ca5c8c" facs="#m-999e0c68-670b-44a5-a6bf-ac9dd7fcff60" label="text-like">altar and put the book in the middle on a cushion or stand.</l><l xml:id="m-66c292c0-e9af-475e-be94-2716012a160b" facs="#m-d5005a30-26db-4028-ae9e-7c694d87fca0" label="text-like">Then the celebrant, with the ministers lor serversl, goes to the altar; he</l><l xml:id="m-9a69c1bc-21f9-4153-95e8-c528d8737a40" facs="#m-87d3db66-3e05-40ed-9faf-8f3118cf7595" label="text-like">mounts the steps, and kisses the altar. Standing in ihe midale, by the boole,</l><l xml:id="m-cedb2d40-1f4f-4bba-931a-c1b2d40abf2a" facs="#m-f5ca1792-30a2-4996-929d-4d98d7f0e057" label="text-like">he begins the solemn Collects, while the sacred ministers Ior serversl, one on</l><l xml:id="m-3b42e943-bc6c-4fec-b4a9-31bee5dd7fed" facs="#m-439a4b87-7eab-40df-8c3a-63ab72f85ed8" label="text-like">either side of him, lift the edge of his cope.</l><l xml:id="m-a723184b-0de7-4d7f-affe-2f8a1b658fcc" facs="#m-2e50cae8-74c9-4dea-8a16-f38e59536165" label="text-like">13. The solemn Collects are said as follows:</l><l xml:id="m-bb860de7-df92-4530-846f-5167736eb6d2" facs="#m-98025ad2-4847-4287-89bd-9ce096adc725" label="text-like">The celebrant begins with an introduction which annonces a particular</l><l xml:id="m-9676df0a-fbb3-43fa-9628-63685889b853" facs="#m-f4c9bcd1-ea71-4604-90db-7ba8a8da57c9" label="text-like">intention; he sings it, with hands joined, to the special tone given in the Missal.</l><l xml:id="m-e94b0edc-336d-44b1-b5db-b39b77400c33" facs="#m-df4761c2-59db-48c9-b8f3-1c3bbfb403c5" label="lyrics-like">He then sings Orémus; the deacon lor the celebrantl adds Flectámus génua,</l><l xml:id="m-6277699d-4fee-4421-afbe-021c926d0240" facs="#m-efd6946e-1059-4fab-9330-f1f3545c4eb7" label="text-like">and all, including the celebrant, kneel and pray silently for a litile while.</l><l xml:id="m-c3464156-16e6-4687-b682-b7ea2dcdbd4d" facs="#m-9ec19c47-ea94-42fb-9f10-89985ca62fdd" label="lyrics-like">When the deacon lor the celebrantl sings Lèvâte, all rise, and the celebrant</l><l xml:id="m-c530f92d-9977-48fb-9eab-606ae0f45ed0" facs="#m-67d7b41f-a3e9-4be5-9e27-0f157f531422" label="text-like">with hands extended sings the Collect to the ferial tone A (or the ancient</l><l xml:id="m-110cac0a-8e8c-4928-bc4b-d48db40a8711" facs="#m-4d526d95-e4ed-4b82-9de4-a29ba9802470" label="ambiguous">solemn tone).</l><l xml:id="m-4ad152a4-7465-4f0b-bb37-1bb96e07ff0d" facs="#m-9cef5ac0-59da-4229-bea6-eea2d05f14a9" label="text-like">I. FOR THE HOLY CHURCH</l><l xml:id="m-dc2cba64-b8df-4ac4-8448-491b7b5e9815" facs="#m-8f5cef83-439a-44a6-9ef1-30c365eea1bf" label="lyrics-like">Rémus, dilectissimi nobis, pro Ecclésia sancta Dei: ut eam</l><l xml:id="m-ea6637d8-7007-4e13-9e76-61fccd7fb7b4" facs="#m-1008ce6a-31fe-47f5-82e3-37859574edb4" label="lyrics-like">U Deus et Dóminus noster pacificâre, adunare et custodire di¬</l><l xml:id="m-edf84164-240e-40d1-8caa-6b383b70c4dc" facs="#m-cbe37113-d958-4547-823c-bd2a797e1227" label="lyrics-like">gnétur toto orbe terrárum : subiiciens ei principátus et potestátes:</l><l xml:id="m-ba0c9edd-1fe6-4d76-95e5-4578096534be" facs="#m-4c696d46-baa2-4d7d-b051-02748bc6a0a2" label="lyrics-like">detque nobis, quiétam et tranquillam vitam degéntibus, glorificáre</l><l xml:id="m-d94ea55b-5cd4-47cd-936b-b3b24e1a3db7" facs="#m-82a4e676-d259-4334-8228-ad3b73f510e5" label="lyrics-like">Deum Patrem omnipoténtem.</l><l xml:id="m-163db66a-0342-45bc-bf89-99ee60e7c4cf" facs="#m-fa3a79ac-b838-4f8d-be19-7e1219a30208" label="lyrics-like">The celebrant: Orémus. The deacon lor the priestl : Flectámus génua.</l><l xml:id="m-885e172a-4e2e-4250-a088-a1e911c5738e" facs="#m-6a97751f-7ba8-4278-afb6-a9aa6061668b" label="lyrics-like">The deacon lor the priestl : Leváte.</l></lg></div></section></score></mdiv></body></music>
</mei>