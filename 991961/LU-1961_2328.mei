aabb1c5a-b8ea-4594-b4a1-65b8443a4f16" facs="#m-56bf518a-a8cf-4eb2-a6c3-a8da939e3c38" label="lyrics-like">cáu¬</l><l xml:id="m-f1ac7b1d-217c-4dab-9614-37b3087e0d9d" facs="#m-d6f37a2f-36cf-435e-b380-a8274b4cd94a" label="ambiguous">sti¬</l><l xml:id="m-a2e9bd85-b8db-4836-a221-678a40021496" facs="#m-8331deb6-58cb-49de-adc5-daff740f7448" label="lyrics-like">accé pit</l><l xml:id="m-3bedc35f-8300-4ceb-bab2-bbbce8dcb3fb" facs="#m-987081b0-aca7-41fe-8ee8-43c7dadbe502" label="ambiguous">am</l><l xml:id="m-584c34de-b31a-442d-9ee2-612d77ba2fc1" facs="#m-ff2393be-0c13-40ad-abec-beae0a0b1c8f" label="lyrics-like">é¬</l><l xml:id="m-4935f9b6-44c4-4ade-b577-dbbf8e9b4547" facs="#m-93bc4763-1e10-45d7-8f24-1c15dbb873fd" label="ambiguous">os.</l><l xml:id="m-a1d3cbd7-84e1-4a7a-9211-a66173964b7c" facs="#m-d1ac294b-cac2-4be7-8e3c-551f9b739258" label="ambiguous">Secret</l><l xml:id="m-da200873-e48e-4f4e-a30e-bb903503b14d" facs="#m-565ae77c-b3b6-4f90-a2f3-7feedb24cc0c" label="lyrics-like">Mmaculátam hóstiam fac nos, mortificatiónis stúdium dapem</l><l xml:id="m-4ab73e7e-2042-4297-854c-2918ed87e472" facs="#m-bc41702e-b81a-4c22-ad81-4d7501a76106" label="lyrics-like">1 Dómine, méntibus tibi puris</l><l xml:id="m-1dc63af5-d4e5-45e2-a8e4-447209914355" facs="#m-d6cb5ef2-404b-4ed0-8016-dae276076275" label="lyrics-like">suavíssimam efficiébant. Per Dó¬</l><l xml:id="m-a4db29bb-c816-4a74-81cf-ee8c02433564" facs="#m-bb20cdb0-3ae7-44b2-8aad-ed27bd1fce4d" label="lyrics-like">offérre, quam sanctis Martyribus minum nostrum Jesum Christum</l><l xml:id="m-efeee86c-0d64-4baf-8679-421a47a88150" facs="#m-ce769279-5c4f-49e8-b9fb-a862863b17de" label="lyrics-like">tuis illibátus vitae candor et juge Filium tuum.</l><l xml:id="m-9a181b44-23d4-45e2-b566-a2b72d6f4da9" facs="#m-2a2d5290-ced9-45f9-81b4-e1ede8112d1b" label="ambiguous">comm.8</l><l xml:id="m-11953dc7-bb56-4871-b7d9-6958c83a8880" facs="#m-229831dc-c84f-41b5-b53b-568fc74e9264" label="ambiguous">3.</l><l xml:id="m-481554b9-f1a4-4aef-ba91-885f924eb674" facs="#m-6685f7f5-e08b-4f0b-b713-797c49d64704" label="lyrics-like">1Agni-ficábi-tur“ Chrí¬stus in córpore mé-o,</l><l xml:id="m-221cec0e-dfd5-47ee-89c3-e67c8f81c1b4" facs="#m-7ad9ae08-a40f-469c-99c3-1c781df9206b" label="lyrics-like">si-ve per ví- tam, si-ve per mór- tem : mí- hi e- nim</l><l xml:id="m-f3c03fe9-6fe1-434a-a768-47c54a23ae9a" facs="#m-ccff0fcb-ec75-4a44-9355-75c41eca8110" label="lyrics-like">ví-ve-re Chrístus est</l><l xml:id="m-c87e2974-4d0c-4b46-adac-d2d47aad4a30" facs="#m-25c82cb5-625f-49b1-a528-b82cf51db979" label="lyrics-like">et mó-ri lú- crum.</l><l xml:id="m-6c612436-26d1-40b6-8073-536563b716c4" facs="#m-80c319b8-28a1-49c9-93ff-2299e438a449" label="ambiguous">Postcommunion</l><l xml:id="m-240893ba-d9db-4127-97b5-97388e101802" facs="#m-96cbc83c-324d-4a49-b23f-f143cc751291" label="lyrics-like">VOrtium pane reféctis tribue tribus pónere non dubitárunt;</l><l xml:id="m-6ed6707f-2b88-4b9f-a38e-6b045e39a536" facs="#m-a0137d79-6ee1-4ad0-8064-e05bce9cf460" label="lyrics-like">1 nobis, omnípotens Deus: ut,</l><l xml:id="m-463dc5f3-ab20-41a7-913b-45813f116db1" facs="#m-9c2b91d9-6d1d-474b-8d6e-9d8a46cc67e8" label="lyrics-like">ita nos, alter altérius ónera</l><l xml:id="m-aa788e0d-0994-431f-8ab8-1a97d4bcf2ab" facs="#m-3fc4387e-657d-4b5e-be23-37da69585b33" label="lyrics-like">sicut sancti Mártyres tui Isaácus,</l><l xml:id="m-de5acec7-c010-4f7f-96d6-6c27083e0c71" facs="#m-988c51d9-375f-4d4b-9fe9-b2d1facd0fa6" label="lyrics-like">portántes, próximos nostros ópe¬</l><l xml:id="m-6ec88570-81ac-4ba5-9a7f-e9bd686bc1be" facs="#m-66785ac9-f99d-4da1-82b6-a25aa557740e" label="lyrics-like">Joánnes eorúmque Sócii, códem</l><l xml:id="m-338c5675-f842-45f9-bfc6-a64e973d7d6d" facs="#m-d9226737-de1d-4c26-96dd-172166d3328f" label="lyrics-like">re et veritâte diligámus. Per</l><l xml:id="m-fa619c90-d5e5-4ecd-9ba0-87009297b45b" facs="#m-fc2d37f4-c9e5-48d3-b83b-de21d410bf65" label="lyrics-like">roboráti, ánimam suam pro frá-Dóminum nostrum.</l><l xml:id="m-d7abe311-8fd7-479d-a25b-ce53d93028e8" facs="#m-77260780-a8ef-41a6-8434-a1941c65f60c" label="text-like">Vespers from the Common, p. 1156, except the prayer, p. (65).</l></lg></div></section></score></mdiv></body></music>
