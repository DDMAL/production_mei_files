4" lry="571" /><zone xml:id="m-0bf9d0c7-e42a-489e-a5da-a5bd979cdf5c" ulx="561" uly="535" lrx="993" lry="570" /><zone xml:id="m-78895f94-1e4f-477f-bb6a-5142a2881636" ulx="873" uly="561" lrx="965" lry="596" /><zone xml:id="m-4d0ead4b-c39f-4158-a0e9-73d268125b2b" ulx="125" uly="563" lrx="704" lry="595" /><zone xml:id="m-32783f10-ed15-4823-ba39-daf60518968e" ulx="124" uly="586" lrx="561" lry="625" /><zone xml:id="m-bc9fdbeb-6530-4096-a22c-23520cfe7034" ulx="146" uly="617" lrx="561" lry="657" /><zone xml:id="m-24e11d53-408e-42d6-914c-3cc15a3f39ca" ulx="514" uly="655" lrx="611" lry="691" /><zone xml:id="m-02f4461c-2e00-439b-9204-2744e5445032" ulx="182" uly="683" lrx="993" lry="725" /><zone xml:id="m-115683f2-ae2d-47ca-a52d-c217aa212fc4" ulx="126" uly="715" lrx="864" lry="749" /><zone xml:id="m-5e348dca-7c57-4cf8-90a9-520ba77a4eb0" ulx="124" uly="740" lrx="558" lry="779" /><zone xml:id="m-94317d52-5e0e-448d-a7cc-abf1b50aabbf" ulx="147" uly="771" lrx="497" lry="809" /><zone xml:id="m-e5adaf07-a229-416a-9f21-7436a883b3cf" ulx="147" uly="801" lrx="590" lry="837" /><zone xml:id="m-95e85c4a-e31c-44eb-b7e6-6d8011ee4216" ulx="442" uly="841" lrx="678" lry="877" /><zone xml:id="m-78f81406-6715-41cd-aae5-0d1cbe1a22cc" ulx="149" uly="869" lrx="993" lry="908" /><zone xml:id="m-6b2a27b1-c884-46c8-9788-630806e010f0" ulx="124" uly="899" lrx="995" lry="935" /><zone xml:id="m-37d158c6-d283-4d4d-b546-7cd705378929" ulx="123" uly="931" lrx="848" lry="961" /><zone xml:id="m-32fc8aab-70e2-44d4-8000-9f2004d32a4d" ulx="146" uly="960" lrx="995" lry="995" /><zone xml:id="m-9d4d7be3-bf6c-4053-9532-2c6837453ce5" ulx="122" uly="982" lrx="735" lry="1018" /><zone xml:id="m-ed558b0b-2c7c-4916-8067-0977d6090cd0" ulx="275" uly="1054" lrx="849" lry="1100" /><zone xml:id="m-fce6974d-4e61-4195-b79e-49f202801940" ulx="125" uly="1056" lrx="186" lry="1095" /><zone xml:id="m-0c8e1e0d-5bb5-494a-a725-5afa2cc202b9" ulx="889" uly="1063" lrx="995" lry="1098" /><zone xml:id="m-e21a255f-c98a-4af7-ba01-4d7b58079d54" ulx="147" uly="1101" lrx="995" lry="1147" /><zone xml:id="m-c84390d5-3650-4824-b83e-fd851a0c946e" ulx="121" uly="1134" lrx="337" lry="1171" /><zone xml:id="m-3825df10-ec13-497b-aaf2-773c118b964f" ulx="502" uly="1159" lrx="611" lry="1195" /><zone xml:id="m-d72addd9-d67a-4389-a737-0e284fa815f1" ulx="158" uly="1192" lrx="997" lry="1234" /><zone xml:id="m-7494d48e-cda0-44fe-b213-1e30a425bf93" ulx="125" uly="1224" lrx="992" lry="1257" /><zone xml:id="m-327ef0d6-ee25-4ddf-b5e6-99c4d6883126" ulx="122" uly="1250" lrx="994" lry="1287" /><zone xml:id="m-0d8e018d-d387-4144-8558-008230ed1b02" ulx="122" uly="1277" lrx="749" lry="1316" /><zone xml:id="m-47716d7d-6c61-4dd6-8795-778d57f214ea" ulx="146" uly="1312" lrx="995" lry="1354" /><zone xml:id="m-d228b8c6-7ac1-40d5-a7ab-3334595cfec2" ulx="124" uly="1338" lrx="248" lry="1377" /><zone xml:id="m-939b3c75-b7da-4bf1-82dd-b68841a65acb" ulx="506" uly="1361" lrx="615" lry="1395" /><zone xml:id="m-1ad0945f-85c3-4621-a9c2-20d71b2a7c45" ulx="134" uly="1393" lrx="997" lry="1435" /><zone xml:id="m-6a260e22-6fbb-46e9-99a8-e43758454002" ulx="124" uly="1423" lrx="553" lry="1459" /><zone xml:id="m-863b3df7-065f-4915-a041-56c93a59c2e8" ulx="563" uly="1427" lrx="996" lry="1459" /><zone xml:id="m-912728c5-41d9-4057-925c-be3b86fa4225" ulx="123" uly="1456" lrx="554" lry="1483" /><zone xml:id="m-6f85f822-334b-40d5-af2b-a7b66bcec21f" ulx="564" uly="1456" lrx="950" lry="1492" /><zone xml:id="m-0e58dd0f-0195-4393-8d98-a09b8c7c64f7" ulx="122" uly="1478" lrx="546" lry="1518" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-30652b62-2ba7-4ccc-900e-c9a804d4f66b" n="1704" facs="#m-1f460345-b3cc-4f7f-b06e-69520a16a3d7" /><div xml:id="m-04379e8d-7315-4cc6-89b1-1ed19aef1b62">
            <lg xml:id="m-8e41e567-2b1a-4fb3-90ae-9d4b7e11cac3">
              <l xml:id="m-7d5bdc9c-4105-4b3c-b683-0178bb367d19" facs="#m-d6a46460-8dcc-4543-b9dc-8b850b90c316" label="ambiguous">1488</l><l xml:id="m-e7e77fcb-ad64-422c-ab61-960e9a37a30e" facs="#m-46399848-02c4-488d-ae8b-22830665ac0f" label="ambiguous">Iune 12.</l><l xml:id="m-a7b96b71-f118-4fe8-a286-1f81482cfcd2" facs="#m-b304188f-3f43-4ce3-af69-6041f3a1af9f" label="ambiguous">ne-at.</l><l xml:id="m-5d6de11d-427e-4a56-866c-4738a945ca3a" facs="#m-ecc5d695-92ae-4c94-995a-a5cf1dad9873" label="ambiguous">F Sequentia sancti Evangelli secundum Matthaeum. Matth. 10.b.</l><l xml:id="m-618ac413-f741-499c-a994-7818eb4cebd7" facs="#m-83bfbff7-c0c6-41da-aabf-b595ba521c52" label="lyrics-like">TN illo témpore: Dixit Jesus discí-mini: dábitur enim vobis in illa</l><l xml:id="m-73481dce-9a48-4f61-926c-7b7876d3f9c1" facs="#m-5eefedca-bf18-4752-a198-4659c3b56405" label="lyrics-like">L pulis suis : Ecce, egõ mitto vosl hora, quid loquámini. Non enim vos</l><l xml:id="m-da60c012-1fa8-4823-a349-e93605bedc9b" facs="#m-23408417-4894-4b11-a456-1f314a99927a" label="lyrics-like">estis, qui loquímini, sed Spiritus</l><l xml:id="m-7da32258-8487-48b9-81f6-93258576594f" facs="#m-5a83b279-bce6-4e2b-b1d9-6b383a291911" label="lyrics-like">sicut oves in médio lupórum. Estóte</l><l xml:id="m-d93c642d-f9a5-43a8-893c-ec5c463955fd" facs="#m-fc12d129-f2dc-447e-80f4-9b5bb1a97093" label="lyrics-like">Patris vestri, qui lóquitur in vobis.</l><l xml:id="m-1d1576fc-2ed5-4b6c-8db4-13ae71f46c3f" facs="#m-91785399-7bc2-48a7-9fd6-158253c17108" label="lyrics-like">ergo prudéntes sicut serpéntes, et</l><l xml:id="m-b17dde7c-3ebf-4ab6-ae5f-b892a5d078bf" facs="#m-a0824a23-32d2-4d64-ae9b-e319f3ed7b6c" label="lyrics-like">simplices sicut colúmbae. Cavéte</l><l xml:id="m-1b6ca641-b7ec-4c7f-a17c-27cbbe896b5b" facs="#m-de2b5f13-292b-4f5e-b343-fbcbf46efab7" label="ambiguous">Tradet autem frater fratrem in</l><l xml:id="m-be398526-7d88-4afd-90ed-a07f18d7b294" facs="#m-c98e5994-f800-465c-9493-4ff9a898f224" label="lyrics-like">autem ab hominibus. Tradent enim! mortem, et pater filium: et insúr¬</l><l xml:id="m-04f2058c-5cbf-4306-986c-272ffff4b3e9" facs="#m-8b46fc0b-86e8-47ed-b0d3-db9dab73ef78" label="lyrics-like">vos in conciliis, et in synagógis suis</l><l xml:id="m-828da22a-a5a2-4cfd-a767-f65c970799ee" facs="#m-d90420aa-b011-45f0-8fa0-243fa4829b9b" label="lyrics-like">gent filii in paréntes, et morte eos</l><l xml:id="m-375506c6-1cab-4818-b98c-5cc7de05d914" facs="#m-d3509fcf-dab9-4baa-a495-28bdd62462f6" label="lyrics-like">flagellábunt vos: et ad praésides</l><l xml:id="m-011424dd-efa8-4b78-85b5-30878b27f176" facs="#m-962140d2-1d02-44a9-a0ea-722487af475e" label="lyrics-like">afficient: et éritis ódio ómnibus</l><l xml:id="m-158d882c-70ec-4d93-bbcd-827347b813e0" facs="#m-f24eda97-c11d-4b6c-9815-aee95d71a08a" label="lyrics-like">et ad reges ducémini propter me</l><l xml:id="m-9f8e02b2-0e15-4375-a857-23290f25b40e" facs="#m-3e3fb2e0-9912-4ec6-8d23-0272c26a3815" label="ambiguous">propter nomen meum: qui autem</l><l xml:id="m-beb2116c-437a-4ea0-99e4-d7687e5cf7ba" facs="#m-87ba5d2c-b101-48fc-a3bc-710fbb0c495e" label="lyrics-like">in testimónium illis et géntibus.</l><l xml:id="m-c2af6c3c-2278-4086-b112-9bd29a47e7c2" facs="#m-0bf9d0c7-e42a-489e-a5da-a5bd979cdf5c" label="lyrics-like">perseveráverit usque in finem, hic</l><l xml:id="m-281b41ed-473c-431f-82f4-f80c6aa88846" facs="#m-78895f94-1e4f-477f-bb6a-5142a2881636" label="ambiguous">Credo.</l><l xml:id="m-4caa74b5-63bf-4340-8b92-ebf14b387bf9" facs="#m-4d0ead4b-c39f-4158-a0e9-73d268125b2b" label="ambiguous">Cum autem tradent vos, nolite co-lsalvus erit.</l><l xml:id="m-6c8d09f5-4531-4932-a0bf-6f134c5cb9c6" facs="#m-32783f10-ed15-4823-ba39-daf60518968e" label="lyrics-like">gitáre, quómodo aut quid loquá¬</l><l xml:id="m-32531af1-5701-46f3-8e11-801e1399793f" facs="#m-bc9fdbeb-6530-4096-a22c-23520cfe7034" label="lyrics-like">offertory. Constitues éos. p. 1520.</l><l xml:id="m-6dcc4e12-f005-49a6-b6fa-65855cf671c4" facs="#m-24e11d53-408e-42d6-914c-3cc15a3f39ca" label="ambiguous">Secret.</l><l xml:id="m-1f49761c-504b-40af-960c-ca78f9cc7995" facs="#m-02f4461c-2e00-439b-9204-2744e5445032" label="lyrics-like">Unera, Dómine, obláta sancti-]a peccatórum nostrórum máculis</l><l xml:id="m-26e9b1f6-6603-41bb-b785-9ae43d780140" facs="#m-115683f2-ae2d-47ca-a52d-c217aa212fc4" label="lyrics-like">316 fica, et, intercedénte beáto lemúnda. Per Dóminum.</l><l xml:id="m-1e68c8fb-4a51-4c51-8571-114ac8ba9f9f" facs="#m-5e348dca-7c57-4cf8-90a9-520ba77a4eb0" label="lyrics-like">Barnaba Apóstolo tuo, nos per haec</l><l xml:id="m-5c3bbfed-90fd-4f40-ba29-de077cb56005" facs="#m-94317d52-5e0e-448d-a7cc-abf1b50aabbf" label="text-like">Preface of the Apostles, p. 10.</l><l xml:id="m-f1e544fe-f206-4c7d-98ca-d45dd51c098a" facs="#m-e5adaf07-a229-416a-9f21-7436a883b3cf" label="lyrics-like">Commanton. Vos qui secúti. p. 1392.</l><l xml:id="m-1ed72b72-9764-4335-aa20-82b6e6e21559" facs="#m-95e85c4a-e31c-44eb-b7e6-6d8011ee4216" label="lyrics-like">Postcómmunion.</l><l xml:id="m-02c0ae6e-bb0f-4203-a337-0ad9b0c58d9f" facs="#m-78f81406-6715-41cd-aae5-0d1cbe1a22cc" label="lyrics-like">TUpplices te rogámus, omnípo-i naba Apóstolo tuo, tibi étiam plá¬</l><l xml:id="m-806bced4-0e62-4f26-931b-5245b11380bb" facs="#m-6b2a27b1-c884-46c8-9788-630806e010f0" label="lyrics-like">O tens Deus:ut quos tuis réficis sa-Icitis móribus dignánter tribuas de¬</l><l xml:id="m-061b35c0-6385-4b35-b459-d91119da0b77" facs="#m-37d158c6-d283-4d4d-b546-7cd705378929" label="lyrics-like">craméntis, intercedénte beáto Bár-l servire. Per Dóminum.</l><l xml:id="m-d84c97a9-d377-470d-94e9-574e1286617b" facs="#m-32fc8aab-70e2-44d4-8000-9f2004d32a4d" label="text-like">In Paschal Time, the Mass is Protexisti, p. 1146, with the foregoine</l><l xml:id="m-9cb6e91d-9afa-46e6-bb6d-6b690f9578e9" facs="#m-9d4d7be3-bf6c-4053-9532-2c6837453ce5" label="text-like">Collect. Epistle, Gospel. Secret, and Postcommunion.</l><l xml:id="m-ad94e5e4-e66e-404a-8476-19d5bcb9c204" facs="#m-ed558b0b-2c7c-4916-8067-0977d6090cd0" label="text-like">St. John of San Facundo, Confessor.</l><l xml:id="m-904335ce-be0e-444a-b140-30f0d6a71a84" facs="#m-fce6974d-4e61-4195-b79e-49f202801940" label="ambiguous">12.</l><l xml:id="m-9ee243e0-0037-4d44-b57b-67b33b47d1cd" facs="#m-0c8e1e0d-5bb5-494a-a725-5afa2cc202b9" label="ambiguous">Double.</l><l xml:id="m-fe2b0d73-65f6-4404-a40f-a3fa9c9889f4" facs="#m-e21a255f-c98a-4af7-ba01-4d7b58079d54" label="lyrics-like">Mass. Os jústi. from the Common of a Confessor not a Bishop, p. 1200.</l><l xml:id="m-6041aeb1-938c-4a62-8072-40cf26161e6f" facs="#m-c84390d5-3650-4824-b83e-fd851a0c946e" label="text-like">except the Collect.</l><l xml:id="m-1c692098-57f5-4863-a933-2e9ae64b46eb" facs="#m-3825df10-ec13-497b-aaf2-773c118b964f" label="ambiguous">Collect.</l><l xml:id="m-fad6567d-8db7-4d4f-a361-ffa1f090a842" facs="#m-d72addd9-d67a-4389-a737-0e284fa815f1" label="lyrics-like">Eus auctor pacis et amátor ca-Isti :t ejus méritis et intercessióne</l><l xml:id="m-f3703421-c8db-487e-ad32-a1269999cde0" facs="#m-7494d48e-cda0-44fe-b213-1e30a425bf93" label="lyrics-like">U ritátis, qui beátum Joánnem! concéde; ut in tua caritate firmáti."</l><l xml:id="m-f2aa5c87-ad32-48bf-9355-aefed2b79327" facs="#m-327ef0d6-ee25-4ddf-b5e6-99c4d6883126" label="lyrics-like">Confessórem tuum mirífica dissi-] nullis a te tentatiónibus separémur.</l><l xml:id="m-56f046dd-d612-4067-bda1-4a2e92bdf0d0" facs="#m-0d8e018d-d387-4144-8558-008230ed1b02" label="lyrics-like">déntes componéndi grátia decorá-l Per Dóminum.</l><l xml:id="m-df2c21f4-c0c4-4747-bf9c-c7fdebf85d47" facs="#m-47716d7d-6c61-4dd6-8795-778d57f214ea" label="text-like">Commemoration of SS. Basilides, Cyrinus, Nabor, and Nazarius,</l><l xml:id="m-b2147da8-0db1-434c-bd99-25ce20106a1d" facs="#m-d228b8c6-7ac1-40d5-a7ab-3334595cfec2" label="ambiguous">martyrs.</l><l xml:id="m-10807965-08d5-4c3f-bc3d-91f3b0e0a92f" facs="#m-939b3c75-b7da-4bf1-82dd-b68841a65acb" label="ambiguous">Collect.</l><l xml:id="m-16ffd51c-7b70-46bc-802f-dadf700863f8" facs="#m-1ad0945f-85c3-4621-a9c2-20d71b2a7c45" label="lyrics-like">NAnctórum Mártyrum tuórum ! et quod illis cóntulit excelléntia</l><l xml:id="m-ac839dd6-1464-49a1-a344-e8845d5158ad" facs="#m-6a260e22-6fbb-46e9-99a8-e43758454002" label="ambiguous">D Basflidis, Cyrini, Naporis atque</l><l xml:id="m-f3841f21-3eb1-4635-8c0f-ae4c5851d5c5" facs="#m-863b3df7-065f-4915-a041-56c93a59c2e8" label="lyrics-like">sempitérna, frúctibus nostrae devo¬</l><l xml:id="m-28279c39-8d7d-4396-a67c-c68a56c0b7c5" facs="#m-912728c5-41d9-4057-925c-be3b86fa4225" label="lyrics-like">Nazárii, quaésumus, Dómine, nata¬</l><l xml:id="m-a3f14100-ac7e-4d58-90f0-dd95b6ec9652" facs="#m-6f85f822-334b-40d5-af2b-a7b66bcec21f" label="lyrics-like">tiónis accréscat. Per Dóminum.</l><l xml:id="m-4f13282d-4f7c-40c1-b8f6-cebc08754dd0" facs="#m-0e58dd0f-0195-4393-8d98-a09b8c7c64f7" label="lyrics-like">utia nobis votiva respléndeant :"</l></lg></div></section></score></mdiv></body></music>
</mei>