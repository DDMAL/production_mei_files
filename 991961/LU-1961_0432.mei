                <divLine xml:id="m-e00c98de-abe0-4b55-9e42-42e448745692" facs="#m-ca16cecd-b199-4edd-b99d-c90aad6b2c4f" form="maior" />
                <syllable xml:id="m-a249b8e9-8a7d-4304-8f7a-f7fec9247ac7">
                  <syl /><neume facs="#m-70ec30bd-8c8b-4f87-a6dd-cef1da7c448b" type="punctum" xml:id="m-17034f83-a449-464c-b4ac-fb23f4817960">
                    <nc xml:id="m-98fb04f5-e374-4b35-97ed-c80e5d174390" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-190a76a5-c42c-4744-ab0f-9af5f4b446a7">
                  <syl /><neume facs="#m-3d80a0a6-24ce-4365-9c73-310ddccb0f72" type="clivis" xml:id="m-ac261107-04b7-4141-aeff-e62085b918c9">
                    <nc xml:id="m-ce282411-848a-4e29-a118-93a0e0b1e9a1" pname="g" oct="3" />
                    <nc xml:id="m-8134b195-8404-4ec2-9605-9faf795df953" pname="f" oct="3" />
