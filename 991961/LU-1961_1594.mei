979" lry="721" /><zone xml:id="m-2d466ca6-a72e-4f7b-825d-c3f4cda68d05" ulx="106" uly="710" lrx="979" lry="750" /><zone xml:id="m-7abc44f0-942a-4cf5-9574-e79f7418ba5a" ulx="107" uly="735" lrx="791" lry="777" /><zone xml:id="m-5a6feaad-65aa-4f5d-9b7d-297fc9b72620" ulx="127" uly="768" lrx="959" lry="804" /><zone xml:id="m-9d0e2d12-bb48-4a5a-b6bf-fdd02b1ce26a" ulx="108" uly="847" lrx="168" lry="892" /><zone xml:id="m-8376efcb-4e4a-4275-9213-4f16d5f64645" ulx="293" uly="849" lrx="790" lry="892" /><zone xml:id="m-79b94d0b-96b6-4d2d-82ea-1fe22e54d3ee" ulx="490" uly="896" lrx="601" lry="930" /><zone xml:id="m-fec91c2f-78ca-4de4-a5e4-58a85436242a" ulx="124" uly="923" lrx="984" lry="963" /><zone xml:id="m-8804f72f-deba-4a56-8c22-8afba3ff500e" ulx="108" uly="955" lrx="983" lry="993" /><zone xml:id="m-59f57ded-db95-4ed9-adb4-801c36abffed" ulx="107" uly="985" lrx="797" lry="1018" /><zone xml:id="m-76e8a661-89fa-4c04-9e83-3ed1510bf238" ulx="129" uly="1016" lrx="944" lry="1050" /><zone xml:id="m-d5c45a15-01aa-49fe-b503-7f8c47ee5524" ulx="315" uly="1092" lrx="984" lry="1141" /><zone xml:id="m-b30349a7-fa5c-4c8c-a5f3-ce71ff4ffca1" ulx="109" uly="1093" lrx="168" lry="1131" /><zone xml:id="m-0659f2c8-88a9-4791-ab1d-dd9e0f3c52d9" ulx="132" uly="1144" lrx="777" lry="1183" /><zone xml:id="m-74b1995f-9703-477c-a82a-ec0162443c04" ulx="403" uly="1223" lrx="685" lry="1267" /><zone xml:id="m-85cb7512-9cfc-446d-9a41-4934bd747b7c" ulx="111" uly="1225" lrx="168" lry="1267" /><zone xml:id="m-1ed7ff2b-7fc0-4449-9b9c-50ee4aa6d425" ulx="165" uly="1263" lrx="987" lry="1314" /><zone xml:id="m-49aea3b0-05e4-44b3-8f1c-07d4c75d5eaa" ulx="136" uly="1320" lrx="984" lry="1361" /><zone xml:id="m-c552c19e-0cef-42ed-a078-3c8ac983a244" ulx="138" uly="1353" lrx="821" lry="1396" /><zone xml:id="m-810fd6a1-1290-410c-9802-602a2a072cdb" ulx="492" uly="1393" lrx="605" lry="1428" /><zone xml:id="m-44ed5538-9184-45dd-b075-cab6c310f291" ulx="134" uly="1425" lrx="987" lry="1469" /><zone xml:id="m-167f1c41-ccaa-4ddd-90a3-15dcc48151ce" ulx="117" uly="1458" lrx="542" lry="1490" /><zone xml:id="m-baf268b5-4bdd-4d83-80e5-cf5aa89750b9" ulx="554" uly="1461" lrx="988" lry="1501" /><zone xml:id="m-0482ab18-2aaf-4ae5-ba1f-4fc7e5daf3d1" ulx="112" uly="1487" lrx="542" lry="1521" /><zone xml:id="m-dfcfba52-1c4b-48f7-adcb-005316028903" ulx="555" uly="1490" lrx="731" lry="1523" /><zone xml:id="m-f5b9cf29-119c-440d-95e8-1e33ec0533c1" ulx="112" uly="1512" lrx="541" lry="1548" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-fbd8af70-cd63-4b45-94c7-4ef8878b31f8" n="1594" facs="#m-5451762e-291e-4e92-9b61-25d92c790d9d" /><div xml:id="m-6e9c8619-0c4a-4f6b-9513-56590af32919">
            <lg xml:id="m-a08ba3a4-f9a1-48c0-854c-df328b102891">
              <l xml:id="m-56497729-2545-4028-a785-868660626860" facs="#m-00147901-0a87-43ce-8f63-75472df3a4da" label="ambiguous">1390</l><l xml:id="m-f0041e97-66ac-4ae5-a619-99d6183f01ca" facs="#m-26206b4d-6363-4732-8730-f2b38aa510f7" label="ambiguous">February 14. 15. 18. 22.23</l><l xml:id="m-f693e162-fed8-4b27-ad3a-55cb0b63afc0" facs="#m-3829fda1-359f-47f0-9edf-11c03c1f8dda" label="text-like">St. Valentine, Priest and Martyr.</l><l xml:id="m-fc467ba5-6355-4ce8-aa90-816d05a6132b" facs="#m-5cc462e7-5b7a-4647-9323-8c8bbfb91e01" label="ambiguous">14.</l><l xml:id="m-56af6791-8177-408d-af89-d1417ec06889" facs="#m-79179609-4281-44e2-9ea1-9c12a8e54aa7" label="ambiguous">Collect.</l><l xml:id="m-1b56f482-2b02-4f85-9129-0105d5456b9b" facs="#m-669cf375-0fa5-4f2b-af0b-be98dd5e1931" label="lyrics-like">ORaesta, quaésumus, omnípotens cunctis malis imminéntibus ejus</l><l xml:id="m-a7ad150c-d5d5-48aa-843e-848d4d8c120f" facs="#m-4a4e895b-d48c-4a43-bfa0-93df7ae1144a" label="lyrics-like">L Deus: t’ut, qui beáti Valentini l intercessióne liberémur. Per Dómi¬</l><l xml:id="m-4aab3c7d-f4f5-4b6d-aedc-721192023964" facs="#m-c07032fc-5b20-4a93-b14e-9f314725e057" label="lyrics-like">Mártyris tui natalitia cólimus, * a l num.</l><l xml:id="m-93141876-aa30-4543-b172-84f15cb63cd0" facs="#m-7bdd3065-9c3a-454a-9b35-71278b9745d2" label="ambiguous">Secret.</l><l xml:id="m-59ed8386-aa07-4f08-9b4b-0f4c6f3724ae" facs="#m-db53ecc8-e96b-4930-8429-c20fad568f64" label="lyrics-like">NUscipe, quaésumus, Dómine, lgántibus méritis, ad nostrae salútis</l><l xml:id="m-5f4d77e3-79a5-4008-a000-10f8270d97c9" facs="#m-2ef28a92-7532-43cd-b0b8-2bf8c91605f0" label="lyrics-like">O múnera dignánter obláta: et auxilium provenire concéde. Per</l><l xml:id="m-e41cb046-4010-48bf-8fe9-6c6cefa4c641" facs="#m-6cc5d96a-b62d-412e-9da5-44740bc0bd93" label="lyrics-like">beáti Valentini Martyris tui suffra-Dóminum.</l><l xml:id="m-223919f7-8d41-4396-886b-49b0a797b9a2" facs="#m-02d6721e-efcf-4094-8b47-452bbb0f058b" label="ambiguous">Postcommunion.</l><l xml:id="m-f48bee57-5359-4f1d-b474-713338173ebf" facs="#m-344204ca-8e20-4efe-8704-bdbd76fd3f99" label="lyrics-like">YIT nobis, Dómine, reparátio! nem, intercedénte beáto Valentino</l><l xml:id="m-e769bf94-c309-4f5c-bc0b-ca4251b5236a" facs="#m-edeb0cd3-8055-4607-b4e9-0dcdd1b8b468" label="lyrics-like">O mentis et córporis caeléste my-[Mártyre tuo, sentiámus efféctum.</l><l xml:id="m-155b719d-d0d0-4ef2-ab93-d3be2822bdda" facs="#m-9e30efae-c64a-4723-988a-443698b07176" label="lyrics-like">stérium : ut, cujus exséquimur actió-lPer Dóminum.</l><l xml:id="m-5f9a013c-120a-4782-8d1b-94e8f4adb155" facs="#m-39108d46-68c4-410e-9e6b-2f406b735bf7" label="text-like">SS. Faustinus and Jovita, Martyrs.</l><l xml:id="m-177fd6e5-7e8a-4432-a4f3-0ec5da693385" facs="#m-dc34fc6a-ca5f-4780-81be-1d59d95ace17" label="ambiguous">15.</l><l xml:id="m-330b4cf9-dd72-42a7-9b15-2066fa76b2d0" facs="#m-05ffd4b5-349c-4c72-bcbe-dfb1cd8a6c2b" label="ambiguous">Collect.</l><l xml:id="m-ebf95310-621e-4a9b-a14f-26fec9951cc3" facs="#m-b45041f1-18b4-4899-a254-18693669771f" label="lyrics-like">Eus, qui nos ánnua sanctórum ! concéde propítius; ut quorum gau¬</l><l xml:id="m-de42110a-da7e-4b22-85d0-e8b02dee0e46" facs="#m-2d466ca6-a72e-4f7b-825d-c3f4cda68d05" label="lyrics-like">I Mártyrum tuórum Faustini et démus méritis, * accendámur exém¬</l><l xml:id="m-feb3c1d2-7ae5-4f40-836d-bb4e1f7a22ac" facs="#m-7abc44f0-942a-4cf5-9574-e79f7418ba5a" label="lyrics-like">Jovitae solemnitáte laetificas: tl plis. Per Dóminum.</l><l xml:id="m-b0248eee-ac92-42bb-8c0e-d8e7a8e246ca" facs="#m-5a6feaad-65aa-4f5d-9b7d-297fc9b72620" label="lyrics-like">Secret. Adésto Dómine. and Postcommunion. Quaésumus Dómine. p. 1166.</l><l xml:id="m-a66f95d8-0494-4011-afed-119e8cd71600" facs="#m-9d0e2d12-bb48-4a5a-b6bf-fdd02b1ce26a" label="ambiguous">18.</l><l xml:id="m-590f97c1-51aa-489b-a176-118196100864" facs="#m-8376efcb-4e4a-4275-9213-4f16d5f64645" label="text-like">St. Simeon, Bishop and Martyr.</l><l xml:id="m-055d3f8f-e922-47b0-a920-2f8496c902de" facs="#m-79b94d0b-96b6-4d2d-82ea-1fe22e54d3ee" label="ambiguous">Collect.</l><l xml:id="m-9e44ffc0-26bb-460b-8b24-c070981d60c1" facs="#m-fec91c2f-78ca-4de4-a5e4-58a85436242a" label="lyrics-like">TNfirmitátem nostram réspice, (Simeónis Mártyris tui atque Ponti¬</l><l xml:id="m-42e15e94-7996-4f60-9990-7d02a1226fa2" facs="#m-8804f72f-deba-4a56-8c22-8afba3ff500e" label="lyrics-like">L omnipotens Deus :t et quia pon-lficis intercéssio gloriósa nos próte¬</l><l xml:id="m-8543c540-047c-4831-8553-3a2e6ac7016f" facs="#m-59f57ded-db95-4ed9-adb4-801c36abffed" label="lyrics-like">dus própriae actiónis gravat, * beáti l gat. Per Dóminum.</l><l xml:id="m-999f83c5-f235-4b1d-87c9-d2185ceebe47" facs="#m-76e8a661-89fa-4c04-9e83-3ed1510bf238" label="lyrics-like">Secret. Hóstias tibi. and Postcommunion. Refécti participatióne. p. 1132.</l><l xml:id="m-309b9b13-85dd-4b03-80bf-28e05845335e" facs="#m-d5c45a15-01aa-49fe-b503-7f8c47ee5524" label="text-like">St. Peter’s Chair at Antioch. Double major.</l><l xml:id="m-3e901b80-63a7-45b1-a734-3b9584ca59d4" facs="#m-b30349a7-fa5c-4c8c-a5f3-ce71ff4ffca1" label="ambiguous">22.</l><l xml:id="m-46bb4152-539f-476a-996c-f27a572c7138" facs="#m-0659f2c8-88a9-4791-ab1d-dd9e0f3c52d9" label="text-like">All as on the feast of St Peter's Chair at Rome, p. 1330.</l><l xml:id="m-0b8874e3-bd7c-407c-b3d6-25ab82e8bf2f" facs="#m-74b1995f-9703-477c-a82a-ec0162443c04" label="ambiguous">St. Peter Damian,</l><l xml:id="m-87b2fe4d-67e0-406c-9b6a-ae9e9eac72e4" facs="#m-85cb7512-9cfc-446d-9a41-4934bd747b7c" label="ambiguous">23.</l><l xml:id="m-53679c8d-d3d6-4ef4-90f2-e904b5e3bce4" facs="#m-1ed7ff2b-7fc0-4449-9b9c-50ee4aa6d425" label="text-like">Bishop, Confessor, and Doctor of the Church. Double.</l><l xml:id="m-2c153bcd-f6df-4cd9-952d-e78fb1832ace" facs="#m-49aea3b0-05e4-44b3-8f1c-07d4c75d5eaa" label="lyrics-like">At Ist ana 2nd Vespers, at Magn. Ant. O Dóctor... beá̂te Pétre. p. 262:.</l><l xml:id="m-96d212e8-93ac-472d-9044-b0ba7f52e399" facs="#m-c552c19e-0cef-42ed-a078-3c8ac983a244" label="lyrics-like">Mass. In médio Ecclésiae. D. 1190. The Credo. 1s said.</l><l xml:id="m-9add5d9b-b7c8-44ea-a017-bddcfcaab755" facs="#m-810fd6a1-1290-410c-9802-602a2a072cdb" label="ambiguous">Collect.</l><l xml:id="m-daf1f9b8-301f-4130-9c1c-a064571127e8" facs="#m-44ed5538-9184-45dd-b075-cab6c310f291" label="lyrics-like">voncéde nos, quaésumus omní-strium rerum contémptum, “ aetér¬</l><l xml:id="m-c0e5689c-4aa1-43d2-81dd-8f40a3553ea5" facs="#m-167f1c41-ccaa-4ddd-90a3-15dcc48151ce" label="lyrics-like">L potens Deus, beáti Petri Con¬</l><l xml:id="m-3a5c8050-c7c6-4d2c-b537-2a041226b13c" facs="#m-baf268b5-4bdd-4d83-80e5-cf5aa89750b9" label="lyrics-like">na gáudia consequámur. Per Dómi¬</l><l xml:id="m-6efd019a-65a3-44e9-9cb6-e9f97deef930" facs="#m-0482ab18-2aaf-4ae5-ba1f-4fc7e5daf3d1" label="lyrics-like">fessóris tui atque Pontificis mónita</l><l xml:id="m-df07dca0-a429-454e-9a13-899c62e908ee" facs="#m-dfcfba52-1c4b-48f7-adcb-005316028903" label="ambiguous">num nostrum.</l><l xml:id="m-8893960f-b601-4706-a58e-2778e80c4107" facs="#m-f5b9cf29-119c-440d-95e8-1e33ec0533c1" label="lyrics-like">et exémpla sectári : f ut per terré¬</l></lg></div></section></score></mdiv></body></music>
</mei>