0" lrx="1012" lry="725" /><zone xml:id="m-b47c6b95-f512-4783-9c9a-bce1adc5d9d2" ulx="127" uly="712" lrx="462" lry="748" /><zone xml:id="m-7989eff5-b171-41cd-88ec-82276444402d" ulx="151" uly="743" lrx="1014" lry="777" /><zone xml:id="m-d485e3ac-af69-4b82-94a5-df9e8942ba17" ulx="128" uly="769" lrx="1014" lry="804" /><zone xml:id="m-ebe98e28-aa10-45f4-b75a-d8ede63f6e97" ulx="128" uly="799" lrx="1014" lry="828" /><zone xml:id="m-32a2d0c0-992e-4eb3-a6e9-3d9825eb72c6" ulx="128" uly="824" lrx="481" lry="864" /><zone xml:id="m-4f4da251-1e10-40fb-93d3-9a344dd67331" ulx="423" uly="862" lrx="744" lry="901" /><zone xml:id="m-5ec105fb-a0c1-4750-a48c-ac58bc17c0e9" ulx="521" uly="904" lrx="620" lry="940" /><zone xml:id="m-4ab4a096-b707-428b-9055-cd203417da51" ulx="171" uly="939" lrx="1016" lry="978" /><zone xml:id="m-c49963e8-ed26-4f42-8871-d6ef470d578c" ulx="134" uly="965" lrx="1013" lry="1006" /><zone xml:id="m-fa5ec0fe-8f71-45c4-80bd-998028b980fd" ulx="131" uly="995" lrx="680" lry="1033" /><zone xml:id="m-e4ff47e8-1aef-4425-8486-7fcfec7c479e" ulx="129" uly="1020" lrx="571" lry="1058" /><zone xml:id="m-014526b6-1696-4e92-868b-0be57f0897b9" ulx="472" uly="1061" lrx="674" lry="1098" /><zone xml:id="m-a1d9ca35-72cc-47f3-94f4-82e9f1fc6a52" ulx="153" uly="1095" lrx="1011" lry="1139" /><zone xml:id="m-08265d96-b00a-4f32-b8cc-b7d51d0a2b40" ulx="133" uly="1125" lrx="1016" lry="1166" /><zone xml:id="m-d8bfa704-f071-4162-8b65-1e3849468605" ulx="131" uly="1156" lrx="852" lry="1189" /><zone xml:id="m-9442a679-fc44-4c5a-b26c-29a6942f70db" ulx="423" uly="1199" lrx="728" lry="1236" /><zone xml:id="m-cd07f244-6533-42ec-8eae-216edb2e6d03" ulx="527" uly="1238" lrx="628" lry="1275" /><zone xml:id="m-9a014134-bc7d-4b77-89f0-31abd3da709a" ulx="150" uly="1268" lrx="1017" lry="1312" /><zone xml:id="m-dbe844d6-9c45-49e8-9987-2d38fdb3eca3" ulx="134" uly="1302" lrx="1019" lry="1340" /><zone xml:id="m-608766a6-dd74-42d6-bc24-847460252b36" ulx="133" uly="1328" lrx="1019" lry="1362" /><zone xml:id="m-0a76ab5f-11df-44ea-b0dc-a62ffa7f5472" ulx="135" uly="1356" lrx="872" lry="1389" /><zone xml:id="m-cb1f62fb-3832-4a7c-8a61-88dd083d7b40" ulx="401" uly="1402" lrx="754" lry="1436" /><zone xml:id="m-99ba6d38-a983-4108-a478-4006da68085e" ulx="527" uly="1438" lrx="628" lry="1476" /><zone xml:id="m-1b689126-f36f-4379-a4fc-d7cef698d40a" ulx="181" uly="1471" lrx="1022" lry="1509" /><zone xml:id="m-7814d6a3-64b3-4663-aa50-46b694767ffa" ulx="139" uly="1502" lrx="1018" lry="1540" /><zone xml:id="m-6417f3b4-af44-4126-92cb-655fcad4a253" ulx="141" uly="1531" lrx="580" lry="1572" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-d5de9f38-49a3-4ba4-a4db-76606d43c770" n="2024" facs="#m-7845ab10-93fa-42e2-881b-96314de03870" /><div xml:id="m-a63b928a-77d2-469f-8406-1a481613f7b3">
            <lg xml:id="m-779fb695-6eb7-4e0f-8a55-94c09e6469b8">
              <l xml:id="m-5a04f341-21ea-42c4-a37a-c70653b8e8b5" facs="#m-f3492667-d409-4d0c-b705-a585565d6da7" label="text-like">ofce for the Dead.</l><l xml:id="m-2e476734-1f20-4281-879c-cb945b505c9c" facs="#m-291962c0-4e73-433c-ad16-e0b6674257db" label="ambiguous">1778</l><l xml:id="m-e01165d6-8371-4baa-b717-02a72de7bfb0" facs="#m-073a5bd8-bcfd-403d-b005-03318abd10c5" label="text-like">For a Sovereign Pontiff deceased.</l><l xml:id="m-eaf13cd6-45a6-469c-a0ae-a28e5a130b47" facs="#m-f05cede5-f023-4170-ad69-e89015863263" label="text-like">Prayer.</l><l xml:id="m-adab133a-31eb-4360-9f80-76025158c9bd" facs="#m-eca4c18d-1c12-4733-b62c-b6c835cc6658" label="lyrics-like">Eus, qui inter summos sacerdó- unigéniti Filii tui vices in terris ge¬</l><l xml:id="m-970e651c-f3a6-4f95-8c35-56e51b7a1bd7" facs="#m-24580e16-aae8-4cfe-bc93-3750747fd20d" label="lyrics-like">U tes fámulum tuum N. ineffábili l rébat, * sanctórum tuórum pontifi¬</l><l xml:id="m-c60f2c5d-7c0e-42aa-866f-3b9c1dbe272f" facs="#m-3570f1c4-98d2-419e-8a8e-c84451fa2e74" label="lyrics-like">tua dispositióne connumerári volus-l cum consórtio perpétuo aggregétur.</l><l xml:id="m-9c5b9ea6-867c-4f1d-aebd-6e217b37a041" facs="#m-20e002aa-ef35-4806-9f6a-93ae4ba9f0de" label="lyrics-like">sti : t praesta, quaésumus; ut quil Per eúmdem Dóminum.</l><l xml:id="m-75284aba-2944-45a1-9da9-9b21dbc478df" facs="#m-6ddf8227-bad3-46ad-9e08-9c2c427db27b" label="text-like">For a Bishop deceased.</l><l xml:id="m-c53bf7f5-af89-4d06-9dda-e666e5d58860" facs="#m-d6dd96cc-0873-4e13-bf94-91c3ad14da92" label="text-like">Prayer.</l><l xml:id="m-1efcfd95-0e01-44f2-b948-5ebde3918d97" facs="#m-4884952c-ddc3-403a-86b1-b0e7f6bb604a" label="lyrics-like">Eus, qui inter apostólicos sacer-] sumus; “ut eórum quoque perpétuo</l><l xml:id="m-4b7a7800-d887-424a-b12e-0829883a6016" facs="#m-de690878-bffa-4719-8622-797fad2a9dc9" label="lyrics-like">U dótes fámulum tuum N. (fámu-laggregé(n)tur consórtio. Per Dó¬</l><l xml:id="m-dbf2be53-b76f-4541-a886-f40760db186e" facs="#m-0cb96833-5da3-4f74-ad6e-a57b659e8c74" label="lyrics-like">los tuos N. et N.) pontificáli fecisti l minum.</l><l xml:id="m-1e6b3be3-e4c2-4b06-a072-7751fc4c720f" facs="#m-bca02758-af89-42b3-aa25-6ecfe868c2ff" label="lyrics-like">dignitáte vigére : t praesta, quaé¬</l><l xml:id="m-b22c8974-d538-4da3-81b2-3a14f1e37704" facs="#m-d4ee821d-8ca3-429d-9942-a372d10c1144" label="lyrics-like">For a deceased Cardinal-Bishop : fámulum tuum N. Episcopum Cardinálem</l><l xml:id="m-65435a8f-a13d-42a8-b8cb-446a24eab92d" facs="#m-397441e9-b565-4c82-9e89-533a4b16b625" label="lyrics-like">pontifcáli fecisti dignitáte.</l><l xml:id="m-d6bde6b2-26c8-4a56-a76f-b846f31af517" facs="#m-d84efefb-95a7-4604-a258-bb89508ae5bc" label="lyrics-like">For a deceased Cardinal-Priest raised to episcopal rank: fámulum tuum</l><l xml:id="m-692b50f6-bfe8-410b-9868-553edc17d75e" facs="#m-d8174292-d4a0-48b1-b990-d3acf7683ed4" label="lyrics-like">N. Presbyterum Cardinálem pontificali fecisti.</l><l xml:id="m-161665a6-eb5a-418f-bf6a-23f0f5b33833" facs="#m-c8330d29-2c1d-4988-b5f0-77e31469fe8e" label="text-like">For a deceased Cardinal-Priest not raised to the dignity ot the Episcopate</l><l xml:id="m-dee84ccb-25c3-4b80-be6c-1421887584ae" facs="#m-48b69f87-67e5-4717-8c34-68ef1e65214a" label="lyrics-like">(or for a Cardinal-Deaçon, priest) : fámulum tuum N. Presbyterum (Diäconum)</l><l xml:id="m-63017f80-c10e-421a-bd07-d06fe2302658" facs="#m-b47c6b95-f512-4783-9c9a-bce1adc5d9d2" label="lyrics-like">Cardinálem sacerdotáli fecisti.</l><l xml:id="m-f73f0ad9-e86b-4854-90c0-be72bdf0034f" facs="#m-7989eff5-b171-41cd-88ec-82276444402d" label="text-like">For a deceased Cardinal-Deacon who had not received the order of</l><l xml:id="m-5d6ee908-fbed-4422-b904-75a889a0749d" facs="#m-d485e3ac-af69-4b82-94a5-df9e8942ba17" label="lyrics-like">Priesthood, the Prayer Inclina Dómine. is said as given below, mention beins</l><l xml:id="m-753207fc-e52d-4948-9259-ffe4008730bb" facs="#m-ebe98e28-aa10-45f4-b75a-d8ede63f6e97" label="lyrics-like">made of the dignity of the deceased : ut ánimam fámuli tui N. Diáconi Cardi¬</l><l xml:id="m-20f518b5-b735-4640-9eac-801918b1e33e" facs="#m-32a2d0c0-992e-4eb3-a6e9-3d9825eb72c6" label="lyrics-like">nális, quam de hoc saéculo. etc.</l><l xml:id="m-0f8fee60-a050-4080-ba67-2a2b3713d3bc" facs="#m-4f4da251-1e10-40fb-93d3-9a344dd67331" label="text-like">For a Priest deceased.</l><l xml:id="m-0658bd47-b8c7-458e-8963-000b318fbc54" facs="#m-5ec105fb-a0c1-4750-a48c-ac58bc17c0e9" label="text-like">Prayer.</l><l xml:id="m-9529d5be-93e6-41b1-a5d1-9871d8a1b76d" facs="#m-4ab4a096-b707-428b-9055-cd203417da51" label="lyrics-like">Eus, qui inter apostólicos sacer- sumus;* ut eórum quoque perpétuo</l><l xml:id="m-a845497f-8aa2-4536-916e-98bde05ffa52" facs="#m-c49963e8-ed26-4f42-8871-d6ef470d578c" label="lyrics-like">1 dótes fámulum tuum N. (fámu-laggregé(n)tur consórtio. Per Dó¬</l><l xml:id="m-a568370e-2591-41f9-ac2c-034ecb809584" facs="#m-fa5ec0fe-8f71-45c4-80bd-998028b980fd" label="lyrics-like">los tuos N. et N.) sacerdotáli fecisti] minum.</l><l xml:id="m-41756e6e-6dac-4633-8481-0209a4d9447c" facs="#m-e4ff47e8-1aef-4425-8486-7fcfec7c479e" label="lyrics-like">dignitáte vigére : t praesta, quaé¬</l><l xml:id="m-cfdab372-d3fc-484e-ad37-8cda382d6844" facs="#m-014526b6-1696-4e92-868b-0be57f0897b9" label="text-like">Another Prayer.</l><l xml:id="m-04483c7b-e753-437e-8f2e-5a557c57a9fe" facs="#m-a1d9ca35-72cc-47f3-94f4-82e9f1fc6a52" label="lyrics-like">DRaesta, quaésumus Dómine: tl rántem, sacris munéribus decorásti.</l><l xml:id="m-cc3d9657-0821-44f4-8d73-ed27df585c40" facs="#m-08265d96-b00a-4f32-b8cc-b7d51d0a2b40" label="lyrics-like">L ut ánima fámuli tui N. Sacer-lin caelésti sede gloriósa semper ex¬</l><l xml:id="m-d6c824b9-896e-446d-a1e9-5d4e773e8ea1" facs="#m-d8bfa704-f071-4162-8b65-1e3849468605" label="lyrics-like">dótis, quem in hoc saéculo commo-! súltet. Per Dóminum.</l><l xml:id="m-f7004e3b-9c5b-45ef-b878-21f92c88f46b" facs="#m-9442a679-fc44-4c5a-b26c-29a6942f70db" label="text-like">For a Man deceased.</l><l xml:id="m-2cef2b68-c7f2-45b2-8d50-7a7652d70d70" facs="#m-cd07f244-6533-42ec-8eae-216edb2e6d03" label="text-like">Prayer.</l><l xml:id="m-41ff257c-6999-4cc4-9e9d-100d46056ade" facs="#m-9a014134-bc7d-4b77-89f0-31abd3da709a" label="lyrics-like">TNclina Dómine aurem tuam ad ! hoc saéculo migráre jussisti, in pa¬</l><l xml:id="m-eb57fc6b-b14e-4162-8d9e-252efd2adb52" facs="#m-dbe844d6-9c45-49e8-9987-2d38fdb3eca3" label="lyrics-like">L preces nostras, quibus misericór-] cis ac lucis regióne constituas, * et</l><l xml:id="m-fc58c67a-1d21-4a16-a3ad-99fde83fe394" facs="#m-608766a6-dd74-42d6-bc24-847460252b36" label="lyrics-like">diam tuam súpplices deprecámur : tl Sanctórum tuórum júbeas esse con¬</l><l xml:id="m-fd81c21c-96b1-44ee-a00f-d8ebb213ccba" facs="#m-0a76ab5f-11df-44ea-b0dc-a62ffa7f5472" label="lyrics-like">ut ánimam fámuli tui N., quam del sórtem. Per Dóminum.</l><l xml:id="m-c9348c19-5e91-43ac-b07b-cf1392ebb8c9" facs="#m-cb1f62fb-3832-4a7c-8a61-88dd083d7b40" label="text-like">For a Woman deceased.</l><l xml:id="m-40fc18ec-471e-4fb9-93e7-3fe6c011be13" facs="#m-99ba6d38-a983-4108-a478-4006da68085e" label="text-like">Prayer.</l><l xml:id="m-3c45c242-96b8-4260-b7d3-008502e9b856" facs="#m-1b689126-f36f-4379-a4fc-d7cef698d40a" label="lyrics-like">Uaésumus Dómine, pro tua pie-l tátis exútam, * in aetérnae salvatió¬</l><l xml:id="m-a2f187dc-b330-4259-9b26-673851a46c12" facs="#m-7814d6a3-64b3-4663-aa50-46b694767ffa" label="lyrics-like">U táte miserére ánimae fámulae nis partem reststue. Per Dóminum.</l><l xml:id="m-fba19aea-bf50-4225-abb4-8ca13126eab9" facs="#m-6417f3b4-af44-4126-92cb-655fcad4a253" label="lyrics-like">tuae N. :t et a contágiis mortali¬</l></lg></div></section></score></mdiv></body></music>
</mei>