4-49b0-9b8e-69f1b5a3cee3" ulx="342" uly="2653" lrx="1904" lry="2765" /><zone xml:id="m-7c7eabe8-d0b9-4139-80a7-73ca3022a5cc" ulx="476" uly="2744" lrx="3103" lry="2853" /><zone xml:id="m-3772eade-3cb5-42dc-815a-dcd5da897a00" ulx="558" uly="2832" lrx="3099" lry="2941" /><zone xml:id="m-5f1b5ca9-46ea-4f60-8975-afbf2e5e4375" ulx="558" uly="2914" lrx="1983" lry="3038" /><zone xml:id="m-6234b378-86ba-4fd4-9554-60f826674fcd" ulx="967" uly="3208" lrx="2305" lry="3320" /><zone xml:id="m-38840a55-49c1-4bb4-9eb7-b68f5e54651c" ulx="221" uly="3399" lrx="2641" lry="3514" /><zone xml:id="m-95e98046-b6cd-4f48-9279-ff9587d5abde" ulx="345" uly="3542" lrx="2990" lry="3663" /><zone xml:id="m-ce492383-418a-4ed9-893e-b5641a1c8131" ulx="224" uly="3718" lrx="2208" lry="3842" /><zone xml:id="m-3fbc96b4-49df-41d3-b7a1-8880cd7149cb" ulx="342" uly="3857" lrx="1801" lry="3988" /><zone xml:id="m-bf31628a-963c-4a4f-a19f-ab2958c0f3bf" ulx="367" uly="3991" lrx="3106" lry="4115" /><zone xml:id="m-c16a7d0b-b5bf-4c63-a8ac-c3ad6b9d3cf7" ulx="382" uly="4085" lrx="994" lry="4191" /><zone xml:id="m-94c03eb6-a8d2-4ac3-b0f3-b99402f5e4ad" ulx="339" uly="4194" lrx="3109" lry="4309" /><zone xml:id="m-c2563a72-fed3-42e8-86ba-b0e588936812" ulx="424" uly="4282" lrx="1000" lry="4397" /><zone xml:id="m-3c2cbd96-1816-4385-9780-4b5acd05d258" ulx="339" uly="4400" lrx="3109" lry="4518" /><zone xml:id="m-d108ad98-ea30-4e39-9751-e4c46346342a" ulx="430" uly="4497" lrx="2478" lry="4609" /><zone xml:id="m-2fdfae71-2e89-4306-9cb2-c825c762a7f7" ulx="342" uly="4612" lrx="2933" lry="4728" /><zone xml:id="m-f7d66c0f-b96d-4869-be81-7a2202553bde" ulx="230" uly="4779" lrx="2914" lry="4904" /><zone xml:id="m-a3e4b12a-203b-4044-b5d4-8746d40b74cb" ulx="348" uly="4925" lrx="3093" lry="5049" /><zone xml:id="m-277966ef-d9a2-4ab7-8020-6dee03335a2a" ulx="436" uly="5019" lrx="2569" lry="5143" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-cf7fdb3c-d2ab-48cf-8373-ce167ef27df2" n="0083" facs="#m-fc150e74-2842-4f41-b9f7-01615d33ac69" /><div xml:id="m-775f2b30-cd45-425c-97bc-b33f7165c365">
            <lg xml:id="m-75069da5-3f09-4ff3-b126-e404dddad69a">
              <l xml:id="m-aaf37ec2-9d52-4489-8280-a50d5db4e66f" facs="#m-9374f7cd-0255-45d8-958e-64d08cf7052f" label="text-like">Proper of the Saints.</l><l xml:id="m-3b819a3f-a09a-4906-afe4-6c735bc80d35" facs="#m-40d17b2c-f489-4e03-a4a2-e310fef329dc" label="ambiguous">Lxxxiii.</l><l xml:id="m-b9487e75-c7d3-4362-8f2e-0070fb3fe1ec" facs="#m-1f2f4945-8e28-4492-947a-68d0c839981d" label="text-like">FEASTS OF NOVEMBER</l><l xml:id="m-cbe2278d-5c7d-44d2-9a74-0339ee190ce1" facs="#m-4f604cff-9f2d-41c9-9e21-d7e74e5c3c83" label="text-like">For the celebration of feasts during Advent, see above, p. LXXII.</l><l xml:id="m-e86a57d6-823a-4add-b8c2-533488e8f545" facs="#m-8f1b323f-6553-4c32-b829-a392b43a21c5" label="text-like">Also for the melody of hymns at the lesser Hours and Compline,</l><l xml:id="m-b3944f13-20ab-4d16-b1e1-61cee2b16f76" facs="#m-59895ad0-083f-4ade-8712-8454da09fdb6" label="ambiguous">see above, p. LXVIII.</l><l xml:id="m-53623cfc-e474-4d7d-b89b-0c885a7e24ae" facs="#m-1e2f59f3-c73b-4f94-83e9-d913d35cdbd1" label="ambiguous">30. ST. ANDREW, Apostle, II class. — Semi-festive Office.</l><l xml:id="m-7403f302-5d00-47f3-a32c-a93758a45f4e" facs="#m-cb33ebb3-b76a-42d0-811a-5dafea6c89d1" label="text-like">At lesser Hours, ants. and pss. of weekday, p. 279A ff; rest</l><l xml:id="m-4f54fbf5-6b63-4d0e-a9a9-30a7f231ca77" facs="#m-4058f74b-085a-4d6a-a16b-91d2c76f7e14" label="text-like">from Proper, p. 1304 or 1307.</l><l xml:id="m-8f0fb773-f5e9-4fbe-a3ab-1921a1193cb1" facs="#m-4bb15c98-8f85-4152-b0cb-e472d4db5c44" label="text-like">Mass, p. 1304. Vesp. from Proper, p. 1307. Compl. of Sun.</l><l xml:id="m-53953d4a-dbf6-4f91-8ba5-92e0953886eb" facs="#m-13f2f434-c950-45fc-ad69-d36a3049662e" label="text-like">1f 30 is Saturday, Vespers of Sun. without com. of the feast;</l><l xml:id="m-c3dce76c-6f7f-4418-a77b-f9683788724b" facs="#m-8d724f6b-66ff-4f96-b2df-cf74a858d8ec" label="text-like">Compl. of Sat.</l><l xml:id="m-f5e150d2-0cac-4745-a9c5-b5f98602bc48" facs="#m-bc7ea299-01de-4f2e-b288-9af72c0bb29a" label="text-like">If 30 is Sunday, the feast is not kept that year.</l><l xml:id="m-d65f3575-1a63-41ba-a98b-d5e46b0dd247" facs="#m-aa1fbd15-96a7-4f3d-b055-b942d7672c05" label="text-like">If the feast is I class: festive Office.</l><l xml:id="m-eda8a9ce-9c4e-419c-8fd8-f3b07355ed49" facs="#m-41d3946c-aae2-456f-a3e9-6a7119ac2795" label="text-like">a) It has I Vespers, p. 1303 (except on Sunday).</l><l xml:id="m-845b1e7b-a8ef-45d7-b033-fa2347eacbe6" facs="#m-2e41d241-6f24-4b9d-8280-1e4c02c2280e" label="text-like">5) At lesser Hours, ants. as pp. 1304 and 1307 with pss. of Sunday</l><l xml:id="m-846c6719-0db3-40da-9911-33205184778c" facs="#m-2d3917c9-1ebc-4d33-9cc1-401a5f2714a1" label="ambiguous">(Prime, n° III).</l><l xml:id="m-2e737e74-c07a-446b-88cf-6195d367b8a6" facs="#m-adf95ba2-4db8-4506-985a-2585603598ca" label="text-like">II Vesp. proper, p. 1307, even on Sat., with com. of Sunday:</l><l xml:id="m-548e137d-4b14-44d8-8475-95bab264e9a9" facs="#m-00b6e64a-d2a7-4ed6-957d-24b6c4505310" label="lyrics-like">ant. Ecce nómen Dómini, p. 317, V. Rorâte, prayer Excita, p. 320</l><l xml:id="m-9effc704-4fb0-46a2-9eba-4a852eeff125" facs="#m-44c57a6a-cc94-49b0-9b8e-69f1b5a3cee3" label="text-like">d) On both days, Compline of Sunday.</l><l xml:id="m-e4a7721e-7a28-42a2-9550-522adcc8c2b8" facs="#m-7c7eabe8-d0b9-4139-80a7-73ca3022a5cc" label="text-like">1 30 is Sunday, the feast is kept on Monday; on Sunday com. only</l><l xml:id="m-ac7ab71d-8bb7-4c39-9576-30959cf18c09" facs="#m-3772eade-3cb5-42dc-815a-dcd5da897a00" label="lyrics-like">of the feast: ant. Unus ex duóbus, p. 1304, V. In ómnem térram,</l><l xml:id="m-8357745a-c089-473e-b4e9-6561833827a8" facs="#m-5f1b5ca9-46ea-4f60-8975-afbf2e5e4375" label="lyrics-like">p. 1303, prayer Majestátem, p. 1305.</l><l xml:id="m-e0f80aaa-4902-4406-b087-3f5c56b8d646" facs="#m-6234b378-86ba-4fd4-9554-60f826674fcd" label="text-like">FEASTS OF DECEMBER</l><l xml:id="m-19b0ec7b-be1e-4943-943e-541e16ec8d61" facs="#m-38840a55-49c1-4bb4-9eb7-b68f5e54651c" label="ambiguous">2. ST. BIBIANA, V. M., III class. — Ordinary Office.</l><l xml:id="m-c0c7fd97-d524-49a9-9649-da757d70e96b" facs="#m-95e98046-b6cd-4f48-9279-ff9587d5abde" label="lyrics-like">Mass Me exspectavérunt, p. 1220, except the collect, p. 1309.</l><l xml:id="m-f9827e3a-75b4-499f-9486-22b9df79fbf5" facs="#m-ce492383-418a-4ed9-893e-b5641a1c8131" label="ambiguous">3. ST. FRANCIS XAVIER, Conf., III class.</l><l xml:id="m-d864deea-8f71-485e-9297-d68563db4078" facs="#m-3fbc96b4-49df-41d3-b7a1-8880cd7149cb" label="text-like">Ordinary Office. Mass, p. 1310.</l><l xml:id="m-b32c2716-df90-4332-a0a7-6fcdc6cdd968" facs="#m-bf31628a-963c-4a4f-a19f-ab2958c0f3bf" label="text-like">In the Missions: principal patron of the Missions, I class.</l><l xml:id="m-605d2c31-7e57-4c71-99a4-b38f01dd0a71" facs="#m-c16a7d0b-b5bf-4c63-a8ac-c3ad6b9d3cf7" label="ambiguous">Festive Office.</l><l xml:id="m-6f418f6f-9642-44a0-ac92-72981d6d7b22" facs="#m-94c03eb6-a8d2-4ac3-b0f3-b99402f5e4ad" label="text-like">All from Common of Conf. not Bp., p. 1193, except the prayer of the</l><l xml:id="m-8018dc27-f1f5-4f7a-84ce-451f7bd48bb9" facs="#m-c2563a72-fed3-42e8-86ba-b0e588936812" label="ambiguous">feast, p. 1310.</l><l xml:id="m-19b47f50-079d-4178-ad5f-ae69f02b6ebb" facs="#m-3c2cbd96-1816-4385-9780-4b5acd05d258" label="text-like">If the feast falls on Sunday, it is transferred to the first free day not</l><l xml:id="m-1982339a-011b-476f-af5e-46fa40d3bd6e" facs="#m-d108ad98-ea30-4e39-9751-e4c46346342a" label="text-like">Ior II class; if Monday, it is com. at Sunday Vesp.</l><l xml:id="m-fe3ac5af-9cce-4293-8b91-4328368af737" facs="#m-2fdfae71-2e89-4306-9cb2-c825c762a7f7" label="text-like">1f 3 is Sat., Vesp. of the feast with com. of the occurring Sunday.</l><l xml:id="m-45661fb1-4147-4f71-9ab9-be13a145b35a" facs="#m-f7d66c0f-b96d-4869-be81-7a2202553bde" label="ambiguous">4. ST. PETER CHRYSOLOGUS, Bp. Conf. Doct., III class.</l><l xml:id="m-ca273c63-951a-4016-90d7-76e84e6bd1ad" facs="#m-a3e4b12a-203b-4044-b5d4-8746d40b74cb" label="text-like">Ordinary Office. Mass, p. 1311, without Creed; com. of feria,</l><l xml:id="m-5d609f38-e1ea-421b-b053-522450cf25a7" facs="#m-277966ef-d9a2-4ab7-8020-6dee03335a2a" label="text-like">(if conventual, commem. of St. Barbara, V. M.).</l></lg></div></section></score></mdiv></body></music>
</mei>