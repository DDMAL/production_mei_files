c34-c530ab91bc6a" ulx="155" uly="1419" lrx="998" lry="1460" /><zone xml:id="m-e6ee188a-258a-4062-b2a6-60630c49ff3d" ulx="129" uly="1448" lrx="557" lry="1485" /><zone xml:id="m-b3737603-e540-49bc-adcc-ecf888c476f7" ulx="566" uly="1449" lrx="997" lry="1487" /><zone xml:id="m-51cf2b18-05bb-4835-9cae-d4babee83747" ulx="128" uly="1475" lrx="556" lry="1506" /><zone xml:id="m-88bd8e0b-3356-4ff9-8169-6185c0eb6306" ulx="567" uly="1476" lrx="701" lry="1515" /><zone xml:id="m-0eb0dd3f-a0e6-461a-8919-f852e1a8a638" ulx="127" uly="1505" lrx="556" lry="1540" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-d617ad0f-b882-4f42-8d92-36563df5bad2" n="1854" facs="#m-ae245645-b8ad-414e-8966-1d52ffb4510c" /><div xml:id="m-cc95ab5e-1d06-4985-9299-e5f36e495666">
            <lg xml:id="m-7240f5ea-8b11-4c7a-aca3-228da741d894">
              <l xml:id="m-dcea5baa-5a67-4755-b34c-5bf04883a926" facs="#m-775d2e4c-a7f1-4085-bfbd-572d115f826b" label="ambiguous">1622</l><l xml:id="m-c6b4e318-e686-4a06-8ebf-a2190bac7cd8" facs="#m-6c9a2e58-b8c4-43b8-a918-36c1196f96f4" label="ambiguous">August. 31. — September. 1.</l><l xml:id="m-0ff0195a-1580-4773-b28c-8b8f3f442299" facs="#m-d9b9c16b-3d6f-4e91-89d0-3ccb7fe02746" label="text-like">Commemoration or St. Felix and Adauetus Martyrs.</l><l xml:id="m-a6e13a66-b292-4ef9-a3bc-c5bad734730e" facs="#m-d3e64b59-2d76-4c52-b522-a867e5738e2f" label="ambiguous">Collect.</l><l xml:id="m-c5319b0a-3436-4a34-abcf-d6688ad649a1" facs="#m-ee489c24-c41f-4dc7-b648-6ab4f225a8d4" label="lyrics-like">Ajestátem tuam, Dómine, súp-l memoratióne laetíficas; ita semper</l><l xml:id="m-60a465be-4cdc-4b0f-b841-3eda614471d9" facs="#m-e2f42df4-30dc-4618-8b09-de2b03ce8228" label="lyrics-like">310 plices exorámus : * ut, sicut supplicatióne deféndas. Per Dómi¬</l><l xml:id="m-5eafa582-37b3-46a4-9b71-4af9ee3433f6" facs="#m-e36d5752-4e5a-406a-a06d-f4fa50691ee6" label="lyrics-like">nos júgiter Sanctórum tuórum com-lnum.</l><l xml:id="m-5e95681f-89b2-49e7-8b2f-2b803173ada4" facs="#m-6b1665d8-64d2-4845-8d49-859859706713" label="ambiguous">Secret.</l><l xml:id="m-b5a92bc2-612c-4b46-bf9d-dea5d26bb2bb" facs="#m-ace2181b-dd27-4630-a4f4-29546d4d5025" label="lyrics-like">zOstias, Dómine, tuae plebis in-(brat, proficere sibi séntiat ad salú¬</l><l xml:id="m-0d36ce4b-ba5c-42c0-b1ef-97da43928d13" facs="#m-c3825328-d5a3-41dc-a6dc-bbb3f4e3a509" label="lyrics-like">Et ténde ; et, quas in honóre San-tem. Per Dóminum.</l><l xml:id="m-5f52b996-7edd-4031-9d53-1d16db2eb3a4" facs="#m-9a4477b8-edd6-467f-b46a-63341874c3d2" label="lyrics-like">ctórum tuórum devóta mente céle¬</l><l xml:id="m-2fb780be-af24-4543-b2d1-e4e4158cda27" facs="#m-12b9e4d5-92ce-47ba-aa7b-373d0fb22e06" label="ambiguous">Postcommunion.</l><l xml:id="m-66ef1f40-667c-451f-95dc-d7a28164b624" facs="#m-398887f6-4de6-417c-8112-2a27b5e1c243" label="lyrics-like">DEpléti, Dómine, munéribus sa- semper actióne maneámus. Per</l><l xml:id="m-138bf041-bb77-473c-b227-22a6cc3d4294" facs="#m-2adcfa86-d061-4562-81d5-57c18fce53fe" label="lyrics-like">R cris, quaésumus : ut, interce¬</l><l xml:id="m-6bac53c5-e6ac-4032-8d0f-da0c1db5c371" facs="#m-daa2caa1-1f33-4b8b-ab8f-7ec1bc4e15f4" label="lyrics-like">Dóminum.</l><l xml:id="m-f780069b-000c-488f-9c4d-082bf55bee9c" facs="#m-81af3c15-3e3a-490b-afd4-88731acdff68" label="lyrics-like">déntibus Sanctis tuis, in gratiárum</l><l xml:id="m-dcbc3f2f-6984-4d95-9201-ad532d0f3711" facs="#m-2ca872b6-1519-4cda-8668-2cccd00ddea8" label="ambiguous">St. Raymund Nonnatus Confessor.</l><l xml:id="m-0961a2ed-cec7-4d26-b6f2-d514a94f59f6" facs="#m-896d34c9-d1e5-4ef9-b1ae-0585e8edd97d" label="ambiguous">31.</l><l xml:id="m-2f20ce0a-0448-43ac-bbc0-5580d53b5dd2" facs="#m-589b6e4a-152a-47ef-b475-79b10c22e98f" label="ambiguous">Double.</l><l xml:id="m-20552d6a-d848-4d28-8b88-cc96ebd9907c" facs="#m-f452a4c5-a76f-438f-afa5-3bf4c82b3f09" label="lyrics-like">Mass. Os jústi. p. 1200, with the following Collect:</l><l xml:id="m-ba4d1901-b547-4105-acec-caaf8b3d8a85" facs="#m-fd5c6f98-9354-48d2-b466-61a7e32cc016" label="ambiguous">Collect.</l><l xml:id="m-cdf0e829-30e3-4518-b9f8-1d59af3887db" facs="#m-6cddc9cf-b035-4d81-87fc-d58616ec25fa" label="lyrics-like">Eus, qui in liberándis fidélibus  nobis intercessióne concéde; ut, a</l><l xml:id="m-8b00a37d-1650-4522-b749-aef2512af93c" facs="#m-81525978-ddbc-43ec-85e9-03e40cabba8b" label="lyrics-like">U tuis ab impiórum captivitáte, l peccatórum vinculis absolúti,* quae</l><l xml:id="m-4c11a8e4-f99e-473e-b60d-d9e902c0605d" facs="#m-3593db98-5849-4554-924c-782911f543e5" label="lyrics-like">beátum Raymúndum Confessórem! tibi sunt plácita, liberis méntibus</l><l xml:id="m-b4b41cc9-8ecd-461f-b79b-8fa2c735b245" facs="#m-1427fcb6-b756-4828-82dd-37f4f60231aa" label="lyrics-like">tuum mirábilem effecísti: t ejus exsequámur. Per Dóminum.</l><l xml:id="m-1863b6e7-02e6-40db-9f2f-92cd7b04e75f" facs="#m-fd69c9c6-1798-410f-9c2c-ec099100e11f" label="ambiguous">CC</l><l xml:id="m-243cfeca-a32f-441a-a284-29a1a063afb0" facs="#m-0e692a4f-314e-4d4b-85c7-20e98358cf60" label="text-like">FEASTS OF SEPTEMBER.</l><l xml:id="m-eb998448-e9fa-4286-9ad3-39aba2eab5b5" facs="#m-cbb79ebe-e9bc-407f-96c0-05984d412642" label="ambiguous">St. Giles, Abbot.</l><l xml:id="m-714aa815-9124-48bf-b134-cab981b69d0e" facs="#m-5ff20c70-0479-4177-8e9a-3f5896423e7a" label="ambiguous">1.</l><l xml:id="m-bb4f8110-6379-46a7-a47f-94eee4fcc5c8" facs="#m-f681bdec-e26b-43f4-8b29-8948bdf6f51b" label="lyrics-like">Mass. Os jústi. of the Common of Abbots, p. 1206.</l><l xml:id="m-19265474-a189-4d0b-9480-669df9342233" facs="#m-d05c6676-1baf-4e3b-84dc-ffff64b16ba9" label="ambiguous">Collect.</l><l xml:id="m-781e0e88-4fdc-413a-a08a-694bf5c5902d" facs="#m-abd8c1a7-e0e2-43c8-89f5-b5374c0debb0" label="lyrics-like">Ntercéssio nos, quaésumus, Dó-[ non valémus, * ejus patrocínio asse¬</l><l xml:id="m-168627fa-2f7d-4537-b855-c3c8f73c0bf6" facs="#m-43f67728-e752-47a3-bd80-91d81e8fc7ef" label="lyrics-like">L mine, beáti Ægidii Abbátis com- quámur. Per Dóminum.</l><l xml:id="m-8857c1f5-96b6-4fb0-952e-a769f9d42bdd" facs="#m-fed741a3-fcd0-4c5e-8954-8050ec735494" label="lyrics-like">méndet : t ut quod nostris méritis</l><l xml:id="m-7999d2d2-a095-4740-bfc0-00b772a8cf0c" facs="#m-a6129a52-d745-4ff8-9bd0-4199d15b5d0f" label="ambiguous">Secret.</l><l xml:id="m-67daa57f-f2bd-48d6-934f-c971a55030c4" facs="#m-dd788292-ddff-451b-ba90-56a233bea850" label="lyrics-like">NAcris altáribus, Dómine, hóstias [nobis provenire deposcat. Per Dó¬</l><l xml:id="m-5d244360-0cda-42b3-8410-f852f81e2d55" facs="#m-7042c38d-b334-43cf-8fb1-4d0fb49c6fad" label="lyrics-like">D superpósitas sanctus Ægidius</l><l xml:id="m-73ad45ea-834e-4ee9-bef6-d687e2bdc5e5" facs="#m-79525e17-974f-45fa-a18e-01685b3d137e" label="ambiguous">minum.</l><l xml:id="m-6eee777e-3157-423b-ab10-8a4bd0d9dff2" facs="#m-55fc71cd-3aff-44ad-9b66-474ecbf66e34" label="lyrics-like">Abbas, quaésumus, in salútem</l><l xml:id="m-451d1b65-44f6-4584-ad3f-7089bf604642" facs="#m-156c604e-65ec-4463-b25f-cdaeb933c22b" label="ambiguous">Postcommunion.</l><l xml:id="m-3bed6a0f-038a-4dd7-b5fb-ea86895a11a6" facs="#m-cca3c1a6-0167-41c1-9c34-c530ab91bc6a" label="lyrics-like">DRótegat nos, Dómine, cum tui ¡experiámur insignia, et interces¬</l><l xml:id="m-d6a316d8-3176-4265-9fa3-bce3cc945cf9" facs="#m-e6ee188a-258a-4062-b2a6-60630c49ff3d" label="lyrics-like">Epercéptióne sacraménti beátus</l><l xml:id="m-9a8db057-e05d-4962-943f-6b75d4688927" facs="#m-b3737603-e540-49bc-adcc-ecf888c476f7" label="lyrics-like">siónis percipiámus suffrágia. Per</l><l xml:id="m-818535ea-26b3-4d23-9731-8d1d73eb6d6b" facs="#m-51cf2b18-05bb-4835-9cae-d4babee83747" label="lyrics-like">Ægídius Abbas, pro nobis inter¬</l><l xml:id="m-5e96128f-f82c-43f3-97d5-9ac1b3be9d57" facs="#m-88bd8e0b-3356-4ff9-8169-6185c0eb6306" label="lyrics-like">Dóminum.</l><l xml:id="m-bc1569f5-ca8d-4c48-a494-99ad276dffe2" facs="#m-0eb0dd3f-a0e6-461a-8919-f852e1a8a638" label="lyrics-like">cedéndo: ut et conversatiónis ejus</l></lg></div></section></score></mdiv></body></music>
</mei>