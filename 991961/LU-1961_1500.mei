      <graphic xml:id="m-dd6e0191-a554-49a8-864a-7f62b5877fc9" target="1500_original_image.tiff" /><zone xml:id="m-2817cf55-fced-47c1-97dc-4438b01df1bd" ulx="113" uly="76" lrx="192" lry="107" /><zone xml:id="m-084dd722-9500-40f5-b521-bcd868f94f18" ulx="410" uly="76" lrx="687" lry="109" /><zone xml:id="m-36eb6264-4045-4cf6-9fde-e47421ac516b" ulx="499" uly="130" lrx="599" lry="163" /><zone xml:id="m-95f0e284-ee8a-4a6f-a496-5266ff4a618c" ulx="137" uly="160" lrx="977" lry="196" /><zone xml:id="m-f326f678-7bf1-4ad7-888d-fe002f8a6003" ulx="113" uly="188" lrx="980" lry="228" /><zone xml:id="m-de7df094-ce36-465b-a550-8be40cae76ea" ulx="115" uly="216" lrx="622" lry="254" /><zone xml:id="m-1c95a8d6-7cb9-4c1b-bb9a-8d86c8eb23cc" ulx="427" uly="257" lrx="667" lry="290" /><zone xml:id="m-6a0edf79-f6e9-4e92-8257-ed0c8360b679" ulx="124" uly="288" lrx="982" lry="329" /><zone xml:id="m-c834ae0e-a381-43c7-a8b7-3e0da605aec1" ulx="115" uly="319" lrx="979" lry="356" /><zone xml:id="m-16a2c398-b2d8-4fe3-8be7-8ad73504b3f1" ulx="115" uly="345" lrx="741" lry="379" /><zone xml:id="m-12a190fa-50a0-4f49-8fe2-4e4e0defb299" ulx="180" uly="401" lrx="917" lry="443" /><zone xml:id="m-76ef075e-7787-4294-ac50-33c5e114f3ad" ulx="494" uly="452" lrx="605" lry="490" /><zone xml:id="m-ce1b4ab4-8f43-4ad9-a5b1-b85edb3b0a21" ulx="153" uly="489" lrx="983" lry="527" /><zone xml:id="m-b1d60e43-3da9-4319-b956-6c79eb6ff1f2" ulx="117" uly="516" lrx="983" lry="557" /><zone xml:id="m-328b2446-0af9-4bb3-93f1-d5e9e11631f0" ulx="117" uly="548" lrx="625" lry="578" /><zone xml:id="m-4d157386-7bc5-44cb-8927-a5704aae72ae" ulx="506" uly="588" lrx="605" lry="618" /><zone xml:id="m-c277f482-486e-4117-b6ff-584327aeaf6f" ulx="154" uly="616" lrx="985" lry="652" /><zone xml:id="m-a93b9258-b4e6-45d1-96ab-75a5a74b14df" ulx="120" uly="644" lrx="984" lry="688" /><zone xml:id="m-d824b158-3ead-4f53-8eac-d00fce0b98ef" ulx="433" uly="691" lrx="674" lry="723" /><zone xml:id="m-c405e3d8-1a5d-40cd-b9f1-b3be743e22bd" ulx="126" uly="718" lrx="987" lry="757" /><zone xml:id="m-68ef3fd2-0502-4e7a-b47a-e3f1e228f6a3" ulx="120" uly="748" lrx="764" lry="788" /><zone xml:id="m-0fe657c9-f4dd-4c14-97d2-d2aa37f3353c" ulx="120" uly="777" lrx="559" lry="816" /><zone xml:id="m-fa099bee-603d-42e9-81e1-7cd119fd1851" ulx="145" uly="824" lrx="987" lry="867" /><zone xml:id="m-61f59a69-5244-44f8-bbf9-1bf923604b6a" ulx="119" uly="854" lrx="510" lry="893" /><zone xml:id="m-6f7dcb4a-a377-47bf-bcda-2868269d0814" ulx="448" uly="891" lrx="656" lry="932" /><zone xml:id="m-e0b1646e-08cf-492f-89ab-2377ba8b0852" ulx="500" uly="938" lrx="614" lry="968" /><zone xml:id="m-27dd256e-3d96-42f4-b94b-914a7b6d13f6" ulx="162" uly="969" lrx="987" lry="1003" /><zone xml:id="m-8387ae1e-e61e-4572-af2d-4100370e6050" ulx="123" uly="994" lrx="988" lry="1034" /><zone xml:id="m-dc437121-77d8-44ed-9b8c-046440d4d568" ulx="122" uly="1021" lrx="662" lry="1062" /><zone xml:id="m-2ae5430a-a06f-4692-b74e-c363dd2359a3" ulx="508" uly="1065" lrx="608" lry="1098" /><zone xml:id="m-01fd7599-6f8b-4984-99c9-548e017cf784" ulx="160" uly="1088" lrx="988" lry="1134" /><zone xml:id="m-8a5652fa-32b6-4cc3-8c98-8b0103bc4343" ulx="125" uly="1120" lrx="557" lry="1157" /><zone xml:id="m-41e949ef-aa95-4bed-9c25-0f69fc2937c7" ulx="564" uly="1121" lrx="700" lry="1157" /><zone xml:id="m-54ae1dcd-109a-4762-8efb-3be5c857bda9" ulx="124" uly="1147" lrx="554" lry="1185" /><zone xml:id="m-289c27ab-3556-41af-b7fb-f497303460a3" ulx="440" uly="1187" lrx="678" lry="1220" /><zone xml:id="m-b02d8382-bec1-4726-8d12-4a64d48d50bc" ulx="135" uly="1216" lrx="993" lry="1251" /><zone xml:id="m-31ff4d40-e8eb-40c3-96a2-3ff1a4c487c5" ulx="127" uly="1243" lrx="993" lry="1285" /><zone xml:id="m-cfb769b3-9822-46ca-a977-a7380f68e546" ulx="126" uly="1273" lrx="886" lry="1307" /><zone xml:id="m-00707c42-fb7d-4e79-8d00-df340eae29a4" ulx="341" uly="1339" lrx="780" lry="1372" /><zone xml:id="m-1efbd5d4-bc6d-4305-b1d2-da191a529687" ulx="502" uly="1383" lrx="618" lry="1416" /><zone xml:id="m-029511a5-170e-4f85-ae00-ff14e05225ba" ulx="166" uly="1417" lrx="994" lry="1454" /><zone xml:id="m-fae5525a-c94e-4aab-98ec-9026f8892325" ulx="131" uly="1442" lrx="995" lry="1476" /><zone xml:id="m-dbd0ccab-579a-4483-bb07-8ecae742793d" ulx="129" uly="1473" lrx="558" lry="1505" /><zone xml:id="m-95d8f360-51cf-4cce-8b10-0c5279c03f0d" ulx="562" uly="1474" lrx="994" lry="1509" /><zone xml:id="m-91b9b6fc-03ee-4090-8705-b8f3d87077dd" ulx="130" uly="1496" lrx="818" lry="1537" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-9f733466-b76b-4335-9ede-d1fc3c7257f1" n="1500" facs="#m-e72ec2a6-79ef-4e7f-a0ae-63507b8eee2d" /><div xml:id="m-04e015c8-2846-4450-bf7f-dca17139146d">
            <lg xml:id="m-4cfa0926-6979-49ab-9c95-0bf6cd16b32e">
              <l xml:id="m-ff4abade-15d1-44f5-8156-9aad94256d31" facs="#m-2817cf55-fced-47c1-97dc-4438b01df1bd" label="ambiguous">1300</l><l xml:id="m-761c58e1-28c6-4d2c-9fb2-669e5aa23c8e" facs="#m-084dd722-9500-40f5-b521-bcd868f94f18" label="ambiguous">occasional Prayers.</l><l xml:id="m-d781cf39-a453-440b-bd9a-bb569e3a8a80" facs="#m-36eb6264-4045-4cf6-9fde-e47421ac516b" label="ambiguous">Secret.</l><l xml:id="m-2162c2d7-6c77-41d0-8640-f48454822032" facs="#m-95f0e284-ee8a-4a6f-a496-5266ff4a618c" label="lyrics-like">YUscipe, quaésumus, omnípotens ! sacraménti, fámulos tuos a cunctis</l><l xml:id="m-433a4f22-695f-4fea-91c0-0ce292cc0219" facs="#m-f326f678-7bf1-4ad7-888d-fe002f8a6003" label="lyrics-like">D Deus, oblatiónem nostrae de-adversitátibus prótege. Per Dómi¬</l><l xml:id="m-a0d47e48-7968-49bc-a323-c7bd230f861a" facs="#m-de7df094-ce36-465b-a550-8be40cae76ea" label="lyrics-like">votiónis: et per virtútem hujus ! num.</l><l xml:id="m-555481d2-f122-4c2b-9e4b-fc395eabcc76" facs="#m-1c95a8d6-7cb9-4c1b-bb9a-8d86c8eb23cc" label="ambiguous">Postcommunion.</l><l xml:id="m-c27fc993-4400-4794-820c-0a7ad4c381ce" facs="#m-6a0edf79-f6e9-4e92-8257-ed0c8360b679" label="lyrics-like">NUmptis redemptiónis nostrae celebratióne, tuae protectiónis con¬</l><l xml:id="m-da1bcc6f-c001-493f-8350-e4e7d09e8ece" facs="#m-c834ae0e-a381-43c7-a8b7-3e0da605aec1" label="lyrics-like">O munéribus: praesta, quaésu-Itra omnes adversitátes subsidium.</l><l xml:id="m-08999175-7747-429d-a884-b4457e9b5b06" facs="#m-16a2c398-b2d8-4fe3-8be7-8ad73504b3f1" label="lyrics-like">mus, miséricors Deus; eórum nobis! Per Dóminum.</l><l xml:id="m-ae2f1c89-568d-4ef7-8866-ce6ca9061730" facs="#m-12a190fa-50a0-4f49-8fe2-4e4e0defb299" label="text-like">For the Preservation of concord in a Congregation.</l><l xml:id="m-fe98af78-0aad-4dd4-90c4-4376509940fa" facs="#m-76ef075e-7787-4294-ac50-33c5e114f3ad" label="ambiguous">Collect.</l><l xml:id="m-4fea9a9e-4016-461c-a185-1a9172adeb46" facs="#m-ce1b4ab4-8f43-4ad9-a5b1-b85edb3b0a21" label="lyrics-like">Eus, largítor pacis et amátor lut ab ómnibus, quae nos pulsant,</l><l xml:id="m-0d2c9ec5-1d73-466b-8966-6c93c473e43a" facs="#m-b1d60e43-3da9-4319-b956-6c79eb6ff1f2" label="lyrics-like">U caritátis: da fámulis tuis ve¬ tentatiónibus liberémur. Per Dómi¬</l><l xml:id="m-ae1d337c-7d19-4d43-bee3-8482d2122e84" facs="#m-328b2446-0af9-4bb3-93f1-d5e9e11631f0" label="lyrics-like">ram cum tua voluntáte concórdiam;! num.</l><l xml:id="m-9f376a2f-10bf-424a-aa57-3e11ef61a068" facs="#m-4d157386-7bc5-44cb-8927-a5704aae72ae" label="ambiguous">Secret.</l><l xml:id="m-3da420ff-fe60-48bb-869b-42b7e23bd761" facs="#m-c277f482-486e-4117-b6ff-584327aeaf6f" label="lyrics-like">IS sacrifíciis, Dómine quaésu- própriis orámus absólvi delictis, non</l><l xml:id="m-c487d709-b975-4d07-8873-328995205d37" facs="#m-a93b9258-b4e6-45d1-96ab-75a5a74b14df" label="lyrics-like">It mus, concéde placátus: ut qui gravémur extérnis. Per Dóminum.</l><l xml:id="m-fc2d77c5-25fa-4df6-8784-13a1de5b137b" facs="#m-d824b158-3ead-4f53-8eac-d00fce0b98ef" label="ambiguous">Postcommunion.</l><l xml:id="m-a0537f42-faee-4b79-8e69-346c016076e6" facs="#m-c405e3d8-1a5d-40cd-b9f1-b3be743e22bd" label="lyrics-like">&amp;Piritum nobis, Dómine, tuae ca-l táte concórdes. Per Dóminum... in</l><l xml:id="m-ed408c5b-cc42-4fe4-83de-508ae1d91b17" facs="#m-68ef3fd2-0502-4e7a-b47a-e3f1e228f6a3" label="lyrics-like">O ritátis infúnde: ut, quos uno lunitáte ejúsdem.</l><l xml:id="m-506cbf66-9897-4194-8baf-7019d4059070" facs="#m-0fe657c9-f4dd-4c14-97d2-d2aa37f3353c" label="lyrics-like">pane caelésti satiásti, tua fâcias pie¬</l><l xml:id="m-7ff3077c-119c-4b39-a00b-53b5109152b3" facs="#m-fa099bee-603d-42e9-81e1-7cd119fd1851" label="text-like">Against the Perseeutors of the Church. Collect, p. 319. </l><l xml:id="m-4348de2f-94a7-4ddb-8d25-4a1fd1db2fb3" facs="#m-61f59a69-5244-44f8-bbf9-1bf923604b6a" label="ambiguous">322. Postcommunion, p. 323.</l><l xml:id="m-dd8c2c4f-2c29-491f-956b-a9a92584b260" facs="#m-6f7dcb4a-a377-47bf-bcda-2868269d0814" label="text-like">For any Need.</l><l xml:id="m-286ea53e-07b5-40eb-8c70-11c520953c82" facs="#m-e0b1646e-08cf-492f-89ab-2377ba8b0852" label="ambiguous">Collect.</l><l xml:id="m-8a780937-52b3-4021-be1c-9ec4fea9403b" facs="#m-27dd256e-3d96-42f4-b94b-914a7b6d13f6" label="lyrics-like">Eus, refúgium nostrum et vir- praesta; ut quod fidéliter pétimus,</l><l xml:id="m-1589226c-4b0c-48dd-a4e1-860bfb27c83d" facs="#m-8387ae1e-e61e-4572-af2d-4100370e6050" label="lyrics-like">U tus: adésto piis Ecclésiae tuae efficáciter consequámur. Per Dó¬</l><l xml:id="m-04139d7e-9daf-4af0-9b7c-433a527a1a12" facs="#m-dc437121-77d8-44ed-9b8c-046440d4d568" label="lyrics-like">précibus, auctor ipse pietátis, et! minum.</l><l xml:id="m-da17c879-a40e-4827-abbf-815bd4663e65" facs="#m-2ae5430a-a06f-4692-b74e-c363dd2359a3" label="ambiguous">Secret.</l><l xml:id="m-caea7ced-1f6e-4606-8ed3-6a73c8df92c6" facs="#m-01fd7599-6f8b-4984-99c9-548e017cf784" label="lyrics-like">A, miséricors Deus: ut haec] et ab ómnibus tueátur advérsis. Per</l><l xml:id="m-bb6ebf26-6483-4f96-8c8a-670bde0d075a" facs="#m-8a5652fa-32b6-4cc3-8c98-8b0103bc4343" label="lyrics-like">U salutáris oblátio et a própriis</l><l xml:id="m-849db02d-a719-434c-9b82-a9cfee667a94" facs="#m-41e949ef-aa95-4bed-9c25-0f69fc2937c7" label="lyrics-like">Dóminum.</l><l xml:id="m-f91be18f-496d-4e1b-b3cc-6c53d8eafbc5" facs="#m-54ae1dcd-109a-4762-8efb-3be5c857bda9" label="lyrics-like">nos reátibus indesinénter expédiat,</l><l xml:id="m-210ba8bc-b401-4295-8709-34dd5a2ac407" facs="#m-289c27ab-3556-41af-b7fb-f497303460a3" label="ambiguous">Postcommunion.</l><l xml:id="m-aebba9d7-67a8-4774-b5a2-d5e25f483ae9" facs="#m-b02d8382-bec1-4726-8d12-4a64d48d50bc" label="lyrics-like">QUmpsimus, Dómine, sacri dona! nem nos fácere praecepísti, in no¬</l><l xml:id="m-24c76188-c0d8-4dd8-8b97-cadd12aba62b" facs="#m-31ff4d40-e8eb-40c3-96a2-3ff1a4c487c5" label="lyrics-like">O mystérii, humsliter deprecán-strae proficiant infirmitátis auxi¬</l><l xml:id="m-29bf030f-39d9-4427-bcaf-7891c90f3969" facs="#m-cfb769b3-9822-46ca-a977-a7380f68e546" label="lyrics-like">tes : ut quae in tui commemoratió-] lium: Qui vivis et regnas.</l><l xml:id="m-fa9dd823-926b-4555-8594-d9ff042fbdea" facs="#m-00707c42-fb7d-4e79-8d00-df340eae29a4" label="text-like">At the time of an Earthquake.</l><l xml:id="m-3aade89b-6f1f-449c-aee4-9c7dd446d3cb" facs="#m-1efbd5d4-bc6d-4305-b1d2-da191a529687" label="ambiguous">Collect.</l><l xml:id="m-7add3a62-263c-4ed6-8bd5-3ed1eaff4875" facs="#m-029511a5-170e-4f85-ae00-ff14e05225ba" label="lyrics-like">Mnípotens sempitérne Deus, qui  terrae fundaménta concutiéntem</l><l xml:id="m-77d7b64b-a587-4c15-ac80-eb1d4a5e8d22" facs="#m-fae5525a-c94e-4aab-98ec-9026f8892325" label="lyrics-like">U réspicis terram, et facis eam! expávimus, cleméntiam contritió¬</l><l xml:id="m-14233481-1fb3-4367-beea-41fcb575b5ba" facs="#m-dbd0ccab-579a-4483-bb07-8ecae742793d" label="lyrics-like">trémere: parce metuéntibus, pro¬</l><l xml:id="m-7d5ac0a2-699b-4504-bbf4-f8dcf8bf535d" facs="#m-95d8f360-51cf-4cce-8b10-0c5279c03f0d" label="lyrics-like">nes ejus sanántem júgiter sentiá¬</l><l xml:id="m-57c6928e-e1c9-455b-8b9e-d8b03825050d" facs="#m-91b9b6fc-03ee-4090-8705-b8f3d87077dd" label="lyrics-like">pitiáre supplicibus; ut, cujus iram mus. Per Dóminum.</l></lg></div></section></score></mdiv></body></music>
</mei>