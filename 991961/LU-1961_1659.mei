45-2929c1786042" label="lyrics-like">et narrábo ó-pera</l><l xml:id="m-afe82204-bfff-4d89-9037-8733f3931828" facs="#m-9c732e0a-e5a1-4968-abac-8413055a662b" label="lyrics-like">Dómi-ni,</l><l xml:id="m-41c6a284-627b-43a2-a4f1-3e1fd0de0167" facs="#m-1006ddc4-04de-4e92-a90f-9b4882d50131" label="ambiguous">alle¬</l><l xml:id="m-7c461ba7-b561-46e7-92dc-6381b986d169" facs="#m-1d08dcee-88b7-4dee-91ee-dbba642afccc" label="lyrics-like">lú- ia.</l><l xml:id="m-e6df1efb-8cb1-4608-b27a-5d404c43b7c2" facs="#m-845ebbcf-e62a-4900-881d-a11182636ed3" label="ambiguous">Secret.</l><l xml:id="m-78afc6b7-76a1-4509-9626-d09e014b78b1" facs="#m-a00c9cce-ecb5-4bca-a0f8-e6e91dec3609" label="lyrics-like">NAcrificium, Dómine, quod tibi cis Filii tui, ad conteréndas potestá¬</l><l xml:id="m-dd806ce7-263c-4877-8034-1406407db586" facs="#m-5f6101aa-88aa-4c3f-adf5-83d48103a17b" label="lyrics-like">O immolámus, placátus inténde:</l><l xml:id="m-87a5dc77-686e-40b8-ae65-ea3ed04af646" facs="#m-58dde3ce-ebba-41e5-aeb6-f08b8357e1e6" label="lyrics-like">tis advérsae insídias, nos in tuae</l><l xml:id="m-786335f6-7409-460d-b366-3c4c07aef890" facs="#m-8e035af3-2503-403b-9a5d-7ba50736433a" label="lyrics-like">protectiónis securitáte constituat.</l><l xml:id="m-fbbaec02-999d-4580-b24d-f4dc0401fc2b" facs="#m-cc29e8f4-5ed1-466b-a110-050300ed373a" label="lyrics-like">ut ab omni nos éruat bellórum ne¬</l><l xml:id="m-18bb1823-edbf-4b2d-93ae-3914d76fa05d" facs="#m-c7c888a1-3d03-4663-9d53-1a077dc2aff7" label="lyrics-like">quítia, et per vexillum sanctae Cru¬Per eúmdem Dóminum.</l><l xml:id="m-1a39caef-719c-40fb-8287-53fd5bc29f9b" facs="#m-6ce152dd-cfc0-4f62-883c-be5507ea9212" label="text-like">Preface of the Cross. p. 8.</l><l xml:id="m-0bf13adf-c326-485d-a0ed-dc8cef8ee20e" facs="#m-35e75740-ff23-49b6-b9ad-c1e3ee38c7e3" label="ambiguous">comm.</l><l xml:id="m-dc34e285-fd14-43d3-965e-2a15e5266789" facs="#m-bbd061ba-f605-484c-8206-cbc6b049658c" label="ambiguous">4.</l><l xml:id="m-8c959f5d-3862-45cf-bf82-a79227c9aaa6" facs="#m-f5151c83-f516-462d-a462-42e99492f692" label="lyrics-like">de ini-mí-cis nó-stris</l><l xml:id="m-2f697346-9732-4275-ac65-1046c8b4c881" facs="#m-3cbebe04-96cb-4e6b-a206-2e64fb120b5b" label="lyrics-like">ER sígnum Crúcis</l><l xml:id="m-1039ef5f-4f01-4d9c-aa1b-87aaa1d16ea1" facs="#m-0302a5f2-de0d-4358-b3cf-46dc937a27f5" label="lyrics-like">Dé- us nó¬</l><l xml:id="m-5786780f-2c89-432b-b2d1-75938fe45c0a" facs="#m-c7a9f928-cbc3-4956-8d39-f2c8f8efc203" label="ambiguous">ster.</l><l xml:id="m-8836feb2-6a97-4939-86ca-b75c05f655dc" facs="#m-8d9f9d10-12f6-47f9-9d67-5d461efc0dbb" label="lyrics-like">líbe-ra</l><l xml:id="m-8e50104a-6cd1-4c7b-bb01-e576e8f8abdd" facs="#m-7a552ec7-ec18-46bc-8bc4-7256dbb95da5" label="ambiguous">nos,</l><l xml:id="m-d667e439-6491-4807-bdd6-1fd98a71d450" facs="#m-44ea63df-c955-49ee-aab0-8c247a866416" label="lyrics-like">T. P. Alle-lú¬</l><l xml:id="m-7f5e0b74-5de6-4fe8-93de-e6b101ec98f0" facs="#m-ffe8af96-832f-444f-a56b-fef8a6548ac8" label="ambiguous">ia.</l><l xml:id="m-5515f956-68ea-4f33-b2e8-3d619c56bbdd" facs="#m-3522e790-32d6-47d0-8401-54fc4a9a8a09" label="ambiguous">Postcommunion.</l><l xml:id="m-feb5a54d-5faf-4ab2-b158-db079cf7f492" facs="#m-c5f47d94-e39b-41b9-b1b4-8222abe42c87" label="lyrics-like">?Epléti alimónia caelésti, et spi- sanctae Crucis Filii tui, arma iustí¬</l><l xml:id="m-fec10574-382b-4ebc-9de8-e295488c8719" facs="#m-3a27db28-bc91-4c31-a225-95247b8fe46b" label="lyrics-like">At ritáli póculo recreáti, quaésu¬</l><l xml:id="m-db5f45bb-3c45-403a-a6b7-2a62ee3f3390" facs="#m-5cc61623-cc73-4774-a0ac-ac84a57cba7c" label="lyrics-like">tiae pro salúte mundi, triumpháre</l><l xml:id="m-fc1c40a2-5231-4bcd-a51f-c9c6928a6dcb" facs="#m-a7f3ba11-d042-49ea-a920-2da74d1ac4cd" label="lyrics-like">jussísti. Per eúmdem Dóminum.</l><l xml:id="m-22932880-86e4-4090-8ed2-94ce553ead5a" facs="#m-cafcd290-e24e-49e9-b32d-9b139464ecec" label="lyrics-like">mus omnípotens Deus: ut ab hoste</l><l xml:id="m-f5dd6fad-7e6e-4e8c-8e7c-c7ee60e07cdd" facs="#m-834efe24-4ff5-46bb-ba88-8d71693eec25" label="lyrics-like">maligno deféndas, quos per lignum</l></lg></div></section></score></mdiv></body></music>
