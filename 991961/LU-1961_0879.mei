 /><zone xml:id="m-c0961d6c-fa6d-434f-acab-bb07c526a2e2" ulx="37" uly="547" lrx="442" lry="580" /><zone xml:id="m-4114f385-6a7d-48cb-b2a3-853c06f656ff" ulx="481" uly="547" lrx="677" lry="580" /><zone xml:id="m-9b10b94f-0550-44df-83b4-68d28ebf926d" ulx="143" uly="600" lrx="734" lry="636" /><zone xml:id="m-8fba42b1-09ee-4d2b-87da-23b32ccfc5c3" ulx="72" uly="642" lrx="832" lry="681" /><zone xml:id="m-390c67bb-fa0c-4b08-92b9-cd6af36cdcd3" ulx="40" uly="671" lrx="834" lry="705" /><zone xml:id="m-1077e28c-6f12-4659-8a9e-00ac5f1c05ee" ulx="36" uly="697" lrx="790" lry="732" /><zone xml:id="m-e02cae00-5529-4be6-a24f-ff0767d0e2f0" ulx="162" uly="745" lrx="708" lry="787" /><zone xml:id="m-a62ca94c-cc44-42c7-a7b4-ddcf8ccb5c8e" ulx="67" uly="794" lrx="835" lry="831" /><zone xml:id="m-0b7d2e8e-fbad-4459-9c85-dac63fdd0227" ulx="38" uly="821" lrx="836" lry="852" /><zone xml:id="m-b8ab70bf-76bf-4129-ae7b-3abbba68269e" ulx="36" uly="848" lrx="835" lry="883" /><zone xml:id="m-fea7ccc2-860f-46df-a1b8-1d6b060828af" ulx="36" uly="878" lrx="817" lry="907" /><zone xml:id="m-44b0df6a-9759-4e7f-9b87-539aa73e188d" ulx="330" uly="930" lrx="545" lry="963" /><zone xml:id="m-1f32beec-4fac-42ec-9d92-f71a2b0ee77b" ulx="71" uly="976" lrx="838" lry="1012" /><zone xml:id="m-ed098c1b-1cd3-4e51-ac3e-500afcd5afe0" ulx="41" uly="1001" lrx="838" lry="1034" /><zone xml:id="m-e540c0d8-5ded-40e4-a4bd-c7e64ee8159c" ulx="36" uly="1030" lrx="838" lry="1062" /><zone xml:id="m-bf1a509b-0989-4aaf-b695-b8e07cae204c" ulx="36" uly="1058" lrx="370" lry="1089" /><zone xml:id="m-33cc69eb-127c-4687-aeec-3277a6f91662" ulx="164" uly="1089" lrx="709" lry="1124" /><zone xml:id="m-31519a80-5e30-44d4-a6e0-92d202e271a0" ulx="72" uly="1132" lrx="839" lry="1171" /><zone xml:id="m-70713e36-ce96-4fdc-ad52-30010bbce8f2" ulx="41" uly="1160" lrx="838" lry="1194" /><zone xml:id="m-5c48a933-81dd-4780-ad4e-05350e146d6a" ulx="438" uly="1188" lrx="838" lry="1222" /><zone xml:id="m-b8b9688f-31f0-4ad3-9ef4-c1c8ea1e93ae" ulx="37" uly="1192" lrx="434" lry="1223" /><zone xml:id="m-374ed360-4b77-4343-a4d8-ae8268a52f37" ulx="37" uly="1218" lrx="838" lry="1247" /><zone xml:id="m-e0812a84-5662-4490-84c5-52de351c718f" ulx="466" uly="1238" lrx="663" lry="1274" /><zone xml:id="m-9ae17f93-75e7-4383-adee-9995ba5470d8" ulx="41" uly="1241" lrx="447" lry="1275" /><zone xml:id="m-ef04019c-d606-47e0-90e6-f663372f88a1" ulx="247" uly="1298" lrx="632" lry="1332" /><zone xml:id="m-4849032f-1761-495a-8af2-466c359a3901" ulx="75" uly="1337" lrx="839" lry="1375" /><zone xml:id="m-149fd912-8831-4849-9627-a248f7e93748" ulx="43" uly="1367" lrx="840" lry="1399" /><zone xml:id="m-4f1cc0ac-6152-462a-8c7d-7fc8f3ad1d5e" ulx="41" uly="1394" lrx="838" lry="1429" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-5d0275be-8a8e-4543-a8fe-1d6ee1e04a2c" n="0879" facs="#m-9df354c4-ddcc-416d-b1cd-90035185ee46" /><div xml:id="m-9b3c1bb4-4736-467b-97ba-99f614ea3bfa">
            <lg xml:id="m-37235147-e5e5-4099-9fc0-b166bdaec99c">
              <l xml:id="m-4edcf825-9eed-41fe-9b07-419ed0cdd8cc" facs="#m-ea67d4cb-cc5a-4420-8434-1bda3ef217ed" label="text-like">The Solemn afternoon Liturgy</l><l xml:id="m-9cf9e7f2-b05f-4a4d-b1ce-837c67905d1a" facs="#m-c9ed7e8e-a84a-4fdf-bfc7-1b1f88c96161" label="ambiguous">733</l><l xml:id="m-71731c16-dc18-4f40-aa05-b22f0ad7514d" facs="#m-9d0060b2-8219-461a-b8c0-50ebdeab84ff" label="lyrics-like">Mnípotens sempitérne Deus, ut Ecclésia tua, toto orbe diffúsa,</l><l xml:id="m-8fc064b2-30be-4fb9-b821-8991550cbd4f" facs="#m-2e6a7436-66b8-4855-b270-620ca25944d6" label="lyrics-like">stábili nde in confessióne tui</l><l xml:id="m-a0ce2fcf-cd75-4417-801f-86bb191a026a" facs="#m-9124a4b3-7bfc-4bbd-89ee-b80da96dc9ea" label="lyrics-like">U qui glóriam tuam ómnibus</l><l xml:id="m-b75bb415-ee35-4e0c-b12f-191035f64f36" facs="#m-49a47674-3136-4e4f-a520-1413d0c667d5" label="lyrics-like">nóminis persevéret. Per eúmdem</l><l xml:id="m-05b3f27a-2827-4f7f-a79b-1994f28901a9" facs="#m-0433abab-264a-4764-9fb9-c93d1a3fd52f" label="lyrics-like">in Christo géntibus revelásti : "</l><l xml:id="m-3ec95c0c-df52-4f20-bff5-d139e0ee19e4" facs="#m-e5691127-8703-4536-a39d-11931f82d8e0" label="lyrics-like">custódi ópera misericórdiae tuae; Dóminum. All : W. Amen.</l><l xml:id="m-74fcc638-25b2-4975-8ff5-81c2c63ea722" facs="#m-d4b9714b-fd77-41f7-9625-b2e16912b644" label="text-like">FOR THE POPE</l><l xml:id="m-c57d5356-c7d3-4c2e-9721-bed18ba96b66" facs="#m-22f21019-0755-4513-a328-95b8908e2db9" label="lyrics-like">Rémus et pro beatíssimo Papa nostro N. : ut Deus et Dóminus</l><l xml:id="m-ebe1874d-04e5-4009-9cd5-a148d4b03237" facs="#m-fc954b85-3271-4b72-89e8-2be25e7702be" label="lyrics-like">U noster, qui elégit eum in órdine episcopátus, salvum atque</l><l xml:id="m-453c4a5d-95a1-4909-8c72-ded1ad1d25e7" facs="#m-ca649fe2-00c2-45a8-babd-31c3eaea7ebc" label="lyrics-like">incólumemcustódiat Ecclésiae suae sanctae, ad regéndum pópulum</l><l xml:id="m-8f15cd0e-42ff-4275-b22c-4a12a23a3ecc" facs="#m-d1b74f2b-e547-4994-829d-47d87bfba059" label="ambiguous">sanctum Dei.</l><l xml:id="m-50c4733d-7a64-4ef0-b9e7-f2d2760e6148" facs="#m-8a9d1a1e-d6cf-4e99-bc4e-1661fae0b49a" label="lyrics-like">C. Orémus. D. Flectámus génua. D. Leváte.</l><l xml:id="m-3e3442cd-b7f1-4f98-91b7-74601f718502" facs="#m-fe7ba6c1-46ef-4c3f-889b-60e4ff3442fa" label="lyrics-like">Mnípotens sempitérne Deus, ut christiána plebs, quae te gu¬</l><l xml:id="m-d92cbaf9-e706-401a-a107-6dc214897db1" facs="#m-02769b04-8a5f-4560-9485-0774713283e5" label="lyrics-like">U cujus judicio univérsa fun-l bernátur auctóre, sub tanto pon¬</l><l xml:id="m-30709b11-4c0c-4a2f-8aaa-6e7962ae8ee1" facs="#m-e0780cda-4fd7-4ac5-b5c1-aff9ce609361" label="lyrics-like">tifice, credulitátis suae méritis</l><l xml:id="m-cb5e49a1-ce7a-4505-b36a-94cacd0fea86" facs="#m-df0afa0d-9a30-499b-90a2-5e22ef14ece8" label="lyrics-like">dántur: * réspice propítius ad</l><l xml:id="m-0927e8aa-2e36-44c6-b6d5-88c5d7f9a1ca" facs="#m-54003f00-50a9-45ee-b5be-b8f6e60f65de" label="lyrics-like">augeátur. Per Dóminum.</l><l xml:id="m-63cbadf2-52cd-4096-a3d6-aeafb697d0c8" facs="#m-3e2edc1b-fc56-4efb-96b7-ddd4044209b0" label="lyrics-like">preces nostras, et eléctum nobis</l><l xml:id="m-9aedb5f6-4d92-480c-b395-ea8a2743cf3f" facs="#m-c0961d6c-fa6d-434f-acab-bb07c526a2e2" label="lyrics-like">Antístitem tua pietáte consérva;</l><l xml:id="m-3640a45d-adfa-4ab0-b940-086275ac914a" facs="#m-4114f385-6a7d-48cb-b2a3-853c06f656ff" label="ambiguous">All : W. Amen.</l><l xml:id="m-0530f812-6dfe-4ac9-b381-4d40e55ee772" facs="#m-9b10b94f-0550-44df-83b4-68d28ebf926d" label="text-like">FOR THE CLERGYAND THE FAITHFUL</l><l xml:id="m-a61be93a-4481-4306-8996-a4d9d442beb2" facs="#m-8fba42b1-09ee-4d2b-87da-23b32ccfc5c3" label="lyrics-like">Rémus et pro ómnibus epíscopis, presbyteris, diacónibus,</l><l xml:id="m-aec12ceb-1a20-4ac1-837e-9626c5af359a" facs="#m-390c67bb-fa0c-4b08-92b9-cd6af36cdcd3" label="lyrics-like">U subdiacónibus, acólythis, exorcistis, iectóribus, ostiáriis, con¬</l><l xml:id="m-8640af59-a97b-4ca1-8904-aaefad6ba171" facs="#m-1077e28c-6f12-4659-8a9e-00ac5f1c05ee" label="lyrics-like">fessóribus, virgínibus, víduis : et pro omni pópulo sancto Dei.</l><l xml:id="m-b18a6ca6-4416-4297-994d-56db2c5f3a8c" facs="#m-e02cae00-5529-4be6-a24f-ff0767d0e2f0" label="lyrics-like">C. Orémus. D. Flectámus génua. D. Levâte.</l><l xml:id="m-d0262e40-2881-428a-8eb8-0ba305b249ef" facs="#m-a62ca94c-cc44-42c7-a7b4-ddcf8ccb5c8e" label="lyrics-like">Mnípotens sempitérne Deus, ordínibus supplicántes; ut grá¬</l><l xml:id="m-3237352a-a3a7-4431-97ac-e768a3002911" facs="#m-0b7d2e8e-fbad-4459-9c85-dac63fdd0227" label="lyrics-like">U cujus spiritu totum corpus tiae tuae mûnere, ab ómnibus</l><l xml:id="m-5abcd886-0658-4ab5-81e0-d310a9056095" facs="#m-b8ab70bf-76bf-4129-ae7b-3abbba68269e" label="lyrics-like">Ecclésiae sanctificátur et régi- tibi grádibus fidéliter serviátur.</l><l xml:id="m-84fe581d-0797-4932-8c0a-96486f5aa597" facs="#m-fea7ccc2-860f-46df-a1b8-1d6b060828af" label="lyrics-like">tur : * exáudi nos pro univérsis! Per Dóminum. AV. Amen.</l><l xml:id="m-03be4219-8f34-444e-87c9-e99f5902e415" facs="#m-44b0df6a-9759-4e7f-9b87-539aa73e188d" label="text-like">4 FOR RULERS</l><l xml:id="m-12b1a2fc-1fd5-4ebf-90d7-37ffd7c67f1a" facs="#m-1f32beec-4fac-42ec-9d92-f71a2b0ee77b" label="lyrics-like">Rémus et pro ómnibus res públicas moderántibus, eorúmque</l><l xml:id="m-13d9bf5a-98eb-4839-a2ce-037742e09bc1" facs="#m-ed098c1b-1cd3-4e51-ac3e-500afcd5afe0" label="lyrics-like">U ministériis et potestátibus: ut Deus et Dóminus noster</l><l xml:id="m-08028b96-b81f-4e37-84d2-d4bf61df4dbb" facs="#m-e540c0d8-5ded-40e4-a4bd-c7e64ee8159c" label="lyrics-like">mentes et corda eórum secúndum voluntátem suam dírigat ad</l><l xml:id="m-f52e3fde-2b61-46bf-aace-a6947bc1f53f" facs="#m-bf1a509b-0989-4aaf-b695-b8e07cae204c" label="lyrics-like">nostram perpétuam pacem.</l><l xml:id="m-6eff1568-1823-4ef5-a63a-be37ab47778c" facs="#m-33cc69eb-127c-4687-aeec-3277a6f91662" label="lyrics-like">C. Orémus. D. Flectámus génua. D. Leváte.</l><l xml:id="m-25c8d144-4bb8-49e5-b407-3ff40c7beea8" facs="#m-31519a80-5e30-44d4-a6e0-92d202e271a0" label="lyrics-like">Mnípotens sempitérne Deus, ubique terrárum, déxtera tua</l><l xml:id="m-86cc77ef-39f3-43df-926b-4dc117ad9c65" facs="#m-70713e36-ce96-4fdc-ad52-30010bbce8f2" label="lyrics-like">U in cujus manu sunt ómnium l protegénte, et religiónis intégri¬</l><l xml:id="m-015512b4-1340-4c23-8373-18b7e762f301" facs="#m-5c48a933-81dd-4780-ad4e-05350e146d6a" label="lyrics-like">tas, et pátriae securitas indesi¬</l><l xml:id="m-1fb8af78-1504-4fe1-a322-4ea494e8e6d6" facs="#m-b8b9688f-31f0-4ad3-9ef4-c1c8ea1e93ae" label="lyrics-like">potestátes et ómnium jura popu¬</l><l xml:id="m-406b76d3-b79b-4dce-a7a1-210bce4986c9" facs="#m-374ed360-4b77-4343-a4d8-ae8268a52f37" label="lyrics-like">lórum : * réspice benígnus ad eos, nénter consístat. Per Dóminum.</l><l xml:id="m-1fefe301-23ae-4641-ad6d-a837257325f6" facs="#m-e0812a84-5662-4490-84c5-52de351c718f" label="ambiguous">All: N. Amen.</l><l xml:id="m-72415991-f838-4e26-88d9-d896684478fc" facs="#m-9ae17f93-75e7-4383-adee-9995ba5470d8" label="lyrics-like">qui nos in potestáte regunt; ut!</l><l xml:id="m-b8b9b0fd-d733-4ffa-ad07-aab0594a1976" facs="#m-ef04019c-d606-47e0-90e6-f663372f88a1" label="text-like">5. FOR THE CATECHUMENS</l><l xml:id="m-9947604d-f9d1-43a2-bb8b-2f51cb04285a" facs="#m-4849032f-1761-495a-8af2-466c359a3901" label="lyrics-like">Rémus et pro catechúmenis nostris: ut Deus et Dóminus</l><l xml:id="m-aede8dad-27ac-42a2-99c5-175d25c64ca2" facs="#m-149fd912-8831-4849-9627-a248f7e93748" label="lyrics-like">U noster adapériat aures praccordiórum ipsórum, januámque</l><l xml:id="m-c91674d8-9328-4572-937b-752b126b4076" facs="#m-4f1cc0ac-6152-462a-8c7d-7fc8f3ad1d5e" label="lyrics-like">misericórdiae; ut, per lavácrum regeneratiónis accépta remissióne</l></lg></div></section></score></mdiv></body></music>
</mei>