2" /><zone xml:id="m-f1d48468-af38-4d8d-8e38-872eb8ea49d8" ulx="253" uly="698" lrx="729" lry="738" /><zone xml:id="m-10bb7bdf-f7d2-4212-ab62-6a3a3ca3205a" ulx="417" uly="745" lrx="515" lry="784" /><zone xml:id="m-b421e97c-1244-4075-9a44-77f03a31fc37" ulx="69" uly="779" lrx="902" lry="822" /><zone xml:id="m-0babab8a-ab4d-423a-9df0-fa2f2bafb20a" ulx="29" uly="809" lrx="459" lry="845" /><zone xml:id="m-fe6be875-2045-4c8f-935c-498d54a2e7b5" ulx="471" uly="817" lrx="900" lry="843" /><zone xml:id="m-0f5bcd38-6cef-4c1c-befb-808d1bcf76db" ulx="471" uly="837" lrx="900" lry="874" /><zone xml:id="m-8f2c382e-479a-4ca3-b659-88b89c1644f2" ulx="28" uly="838" lrx="457" lry="872" /><zone xml:id="m-ad7a8ea8-214a-45ff-9d9c-dc6d236c3807" ulx="470" uly="865" lrx="806" lry="900" /><zone xml:id="m-1d158ba7-5dc1-481a-bb8a-75b4398dd016" ulx="27" uly="866" lrx="459" lry="898" /><zone xml:id="m-cc2de4a2-34dc-4342-8927-c1427f488c2a" ulx="27" uly="891" lrx="459" lry="928" /><zone xml:id="m-5572dca8-26ad-45f9-b6b9-e4c7af9bf968" ulx="234" uly="945" lrx="697" lry="979" /><zone xml:id="m-050e3ee8-5be3-4e21-803e-420ed709d105" ulx="412" uly="986" lrx="509" lry="1021" /><zone xml:id="m-db3ce151-42e8-472a-996c-ad4c7e3607aa" ulx="67" uly="1016" lrx="900" lry="1054" /><zone xml:id="m-5657021e-588a-4ff5-be64-b09bc69545fa" ulx="30" uly="1044" lrx="895" lry="1080" /><zone xml:id="m-9058a4ed-563b-469d-b7e5-1c96538b5a1b" ulx="26" uly="1069" lrx="829" lry="1107" /><zone xml:id="m-3f6c19c8-f659-45a5-b57c-f79b2a3bc1a5" ulx="27" uly="1100" lrx="462" lry="1137" /><zone xml:id="m-b782d2f9-09b9-413c-8913-cc51181f0576" ulx="62" uly="1145" lrx="861" lry="1188" /><zone xml:id="m-b33ec38b-cbb3-4e6b-90f4-93e0a3d8c37f" ulx="412" uly="1194" lrx="509" lry="1225" /><zone xml:id="m-fa761c1a-d255-4ff5-83ae-8c2fece64dc5" ulx="64" uly="1223" lrx="894" lry="1265" /><zone xml:id="m-bb0ff056-5236-4050-a722-ddee6947d18b" ulx="27" uly="1254" lrx="454" lry="1285" /><zone xml:id="m-d180ea42-5262-49e0-8776-45f062b440e8" ulx="462" uly="1255" lrx="893" lry="1292" /><zone xml:id="m-16881f34-5e5e-4b82-a20d-7ef59076e435" ulx="23" uly="1280" lrx="457" lry="1312" /><zone xml:id="m-c6f226f0-e685-47d2-95ac-fb67915ca50b" ulx="460" uly="1281" lrx="823" lry="1317" /><zone xml:id="m-f87d6ae8-7749-407d-9005-9d176f7829ec" ulx="26" uly="1306" lrx="462" lry="1340" /><zone xml:id="m-10f2565f-6995-4adb-b136-40c2ad3f9cec" ulx="36" uly="1355" lrx="886" lry="1397" /><zone xml:id="m-0b735577-3640-49c7-8dd7-3d84e4aab3d9" ulx="406" uly="1401" lrx="503" lry="1437" /><zone xml:id="m-422bc726-e4f2-4f3c-934a-b3622ef9efde" ulx="58" uly="1432" lrx="893" lry="1473" /><zone xml:id="m-5e69feac-1576-4bf6-b205-285bea96b25d" ulx="26" uly="1462" lrx="455" lry="1495" /><zone xml:id="m-9233f198-7a90-42c1-b4ae-aadaeb0a938b" ulx="458" uly="1467" lrx="892" lry="1497" /><zone xml:id="m-af04e56e-b096-4d1b-9dc1-a9ca46d40b01" ulx="22" uly="1488" lrx="455" lry="1521" /><zone xml:id="m-fa83734f-da4e-4b81-9649-c43c8f5920e9" ulx="456" uly="1491" lrx="886" lry="1529" /><zone xml:id="m-68eaad1f-7842-4dc0-8555-4c88bfb3b694" ulx="20" uly="1514" lrx="574" lry="1551" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-7f4ce519-7eeb-432c-b22d-587050f5d7e8" n="2067" facs="#m-44fc7ec7-ee12-4a3d-bbce-86abb5cf5a21" /><div xml:id="m-bf9a6058-df86-4538-862e-11d00f81e349">
            <lg xml:id="m-0879f46d-b9c0-44aa-a62b-076da9558a2f">
              <l xml:id="m-4927db34-35db-4bc5-ad56-9d958f0a449c" facs="#m-c3f5cc35-6a55-4ae8-9804-dbaf75161326" label="text-like">Various Prayers for the Absolution.</l><l xml:id="m-5d5d1d9f-d1d0-4c83-9159-4d7c2e652c63" facs="#m-6be0b9d8-7d0d-46e5-8d16-d7598d31eddc" label="ambiguous">1821</l><l xml:id="m-90a65305-ecdd-409b-8bb6-4616815fb3c3" facs="#m-5e72f4ec-c978-4797-bfe8-d9c0372e939b" label="lyrics-like">Orémus.</l><l xml:id="m-371b4c49-0b44-4321-b5b9-2c5d75ef7699" facs="#m-0dc9169b-2f36-4b32-86e6-7a039c9961a5" label="lyrics-like">I Bsólve, quaésumus Dómine, omni vinculo delictórum :ut, in re¬</l><l xml:id="m-d2e2c6d3-6d53-4982-a998-56e5304b3daa" facs="#m-7a3b4094-ad0b-48fb-885c-9e9c05b11425" label="lyrics-like">H ánimam fámuli tui N. (famulae</l><l xml:id="m-46716825-c535-40ff-907a-1f5d00255fa3" facs="#m-2018fcbd-e7ac-4fd4-ba5d-64c04a2426d4" label="lyrics-like">surrectiónis glória, inter Sanctos et</l><l xml:id="m-4210f1d0-a3e0-4a18-b3c4-2a2e941966d7" facs="#m-35f26443-1782-4ca0-b6eb-5aa84b31cf36" label="lyrics-like">tuae N., or ánimas famulórum tuó¬</l><l xml:id="m-aae84d6e-2241-4ed4-be6a-55dd7bc810aa" facs="#m-0dcb8224-f27c-4d30-878a-57ba56933b91" label="lyrics-like">eléctos tuos resuscitátus (-a) respiret</l><l xml:id="m-9a37904b-b1c9-4db4-ad24-e89d0098b8e3" facs="#m-3eae2d5e-f50c-4368-8d9f-bf132b3dc978" label="lyrics-like">rum N. et N., or ánimas famulárum</l><l xml:id="m-9c627d9c-ae85-4b6f-897f-7b4eb2ffe832" facs="#m-4a950554-237c-4a99-a13a-589c264e79c6" label="lyrics-like">(resuscitáti or resuscitátae respí¬</l><l xml:id="m-3975168f-7336-4d0e-92d5-ddb996d72c92" facs="#m-ad1c14bf-8702-44a4-80c6-567f9b2b3579" label="lyrics-like">rent). Per Christum Dóminum.</l><l xml:id="m-588ce9dd-2497-4089-8d74-2494f0c6d60e" facs="#m-30206181-d90b-4bb7-b878-105ceb806d0f" label="lyrics-like">tuárum N. et N., or ánimas famu¬</l><l xml:id="m-ae5d7165-76f4-439b-bb3e-9e21ef985e0b" facs="#m-2c15fa37-3d13-4fe3-a2d1-7c5e1dd4cf6b" label="lyrics-like">lórum famularúmque tuárum) ab</l><l xml:id="m-728b90db-bd5b-43b4-9f7f-ddaf09cbaee6" facs="#m-a4b8500c-936b-4fd2-9003-d712a350c308" label="text-like">This Prayer may be replaced by the Collect of the Mass or by one of the</l><l xml:id="m-89936ad5-8b71-485d-9e7e-64a7c7015787" facs="#m-ffd3afc9-16f4-4503-9f10-1c31b8d96722" label="ambiguous">various Prayers as indicated.</l><l xml:id="m-251edc49-5a04-4da9-84d2-0d4b5652b4ad" facs="#m-5ab32a57-6ee7-4d75-8834-a1f08ac766bb" label="lyrics-like">V. Réquiem aetérnam dóna éi Dómine.</l><l xml:id="m-393e63ef-7a7c-4583-abe4-5113096ee8a2" facs="#m-c44dbf0d-dbf3-497d-94e7-b68569897ac5" label="lyrics-like">R. Et lux perpétua lúceat éi.</l><l xml:id="m-5c41af71-56e0-4be4-8239-d63f276aa91d" facs="#m-076667a4-4fe7-4ff6-8c09-fe279af32484" label="lyrics-like">The Cantors: V. Requiéscat in páce. R. Amen. The Celebrant : Anima</l><l xml:id="m-755c4296-4919-4c82-a346-81305f7168df" facs="#m-43e034c7-6a8a-446a-9171-924e30a4788c" label="lyrics-like">éjus. and the remaining prayers as on p. 1771.</l><l xml:id="m-d8e3006c-9a18-4b88-89ee-edd9d0041905" facs="#m-230f4106-5ec8-4dba-b518-ce8f54adedef" label="text-like">VARIOUS PRAYERS FOR THE ABSOLUTION.</l><l xml:id="m-46858e4b-1339-4b07-8f72-5f02d2585d07" facs="#m-f1d48468-af38-4d8d-8e38-872eb8ea49d8" label="text-like">For a Sovereign Pontiff deceased.</l><l xml:id="m-ca05f0d1-2f7e-4fe4-a6cb-70cece71e61e" facs="#m-10bb7bdf-f7d2-4212-ab62-6a3a3ca3205a" label="text-like">Prayer.</l><l xml:id="m-a1a63e22-ebb7-40d7-bad2-eac24da24f93" facs="#m-b421e97c-1244-4075-9a44-77f03a31fc37" label="lyrics-like">Eus, qui inter summos sacerdó¬ gerébat, * sanctórum tuórum Pon¬</l><l xml:id="m-908df1eb-d49d-4b85-8238-2535d34fb35b" facs="#m-0babab8a-ab4d-423a-9df0-fa2f2bafb20a" label="lyrics-like">I tes fámulum tuum N. ineffábili</l><l xml:id="m-26fe3527-acae-4226-8cdb-1fe3479bb077" facs="#m-fe6be875-2045-4c8f-935c-498d54a2e7b5" label="lyrics-like">tíficum consórtio perpétuo aggre¬</l><l xml:id="m-6de20ce9-201e-4467-b4fd-b74da6a5ed8b" facs="#m-0f5bcd38-6cef-4c1c-befb-808d1bcf76db" label="lyrics-like">gétur. Per eúmdem Christum Dó¬</l><l xml:id="m-be98f0cc-77f7-4ecf-9e5d-2260b60ae929" facs="#m-8f2c382e-479a-4ca3-b659-88b89c1644f2" label="lyrics-like">tua dispositióne connumerári voluí¬</l><l xml:id="m-67341484-85dd-4e86-a532-e7f29697aa63" facs="#m-ad7a8ea8-214a-45ff-9d9c-dc6d236c3807" label="ambiguous">minum nostrum. E. Amen.</l><l xml:id="m-fbca26a3-558e-4fce-94a3-f41a352d1017" facs="#m-1d158ba7-5dc1-481a-bb8a-75b4398dd016" label="lyrics-like">sti : t praesta, quaésumus, ut qui</l><l xml:id="m-9607d4c1-a848-45de-9ed4-efcf2596edfb" facs="#m-cc2de4a2-34dc-4342-8927-c1427f488c2a" label="lyrics-like">unigéniti Fili tui vices in terris</l><l xml:id="m-a46fc6b2-0fc9-4016-b756-db53c47f0d86" facs="#m-5572dca8-26ad-45f9-b6b9-e4c7af9bf968" label="text-like">For a Cardinal-Bishop deceased.</l><l xml:id="m-725d54e2-8285-493e-831a-01cb39e7a861" facs="#m-050e3ee8-5be3-4e21-803e-420ed709d105" label="text-like">Prayer.</l><l xml:id="m-be946e46-c13d-4228-8f32-b884d70be6cb" facs="#m-db3ce151-42e8-472a-996c-ad4c7e3607aa" label="lyrics-like">Eus, qui inter apostólicos sacer-[quaésumus; * ut eórum quoque per¬</l><l xml:id="m-03f8e863-5cfb-4546-98d9-9d199934c0cb" facs="#m-5657021e-588a-4ff5-be64-b09bc69545fa" label="lyrics-like">I dótes fámulum tuum N. Epi-] pétuo aggregétur consórtio. Per</l><l xml:id="m-5e88cc96-f3ff-4695-b52d-a738c2eac1f8" facs="#m-9058a4ed-563b-469d-b7e5-1c96538b5a1b" label="lyrics-like">scopum Cardinálem pontificáli fe- Christum Dóminum nostrum.</l><l xml:id="m-beb697ed-037f-4e4d-b6f7-aa3625926ec0" facs="#m-3f6c19c8-f659-45a5-b57c-f79b2a3bc1a5" label="lyrics-like">císti dignitáte vigére: t praesta</l><l xml:id="m-949f8640-c196-41c3-b6d6-18c959a3fa14" facs="#m-b782d2f9-09b9-413c-8913-cc51181f0576" label="text-like">For a deceased Cardinal-Priest raised to episcopal rank.</l><l xml:id="m-59b02fe5-65ed-4aff-8b15-c6418aebe316" facs="#m-b33ec38b-cbb3-4e6b-90f4-93e0a3d8c37f" label="text-like">Prayer.</l><l xml:id="m-3a47fd90-61a8-4f3d-a5dd-694602c63c7d" facs="#m-fa761c1a-d255-4ff5-83ae-8c2fece64dc5" label="lyrics-like">Eus, qui inter apostólicos sacer-(quaésumus;* ut eórum quoque per¬</l><l xml:id="m-f0ebf78a-6980-462a-88b2-a5f7bf741566" facs="#m-bb0ff056-5236-4050-a722-ddee6947d18b" label="lyrics-like">I dótes fámulum tuum N. Pres¬</l><l xml:id="m-171684c9-b9b9-4f86-887d-84c4054bcbb9" facs="#m-d180ea42-5262-49e0-8776-45f062b440e8" label="lyrics-like">pétuo aggregétur consórtio. Per</l><l xml:id="m-d8a16ef2-3f70-4951-a252-32c1f4c173aa" facs="#m-16881f34-5e5e-4b82-a20d-7ef59076e435" label="lyrics-like">byterum Cardinálem pontificáli fe¬</l><l xml:id="m-325e12bd-145c-4368-85db-9a2b44a134fa" facs="#m-c6f226f0-e685-47d2-95ac-fb67915ca50b" label="lyrics-like">Christum Dóminum nostrum.</l><l xml:id="m-01883522-5084-4879-801e-376815013296" facs="#m-f87d6ae8-7749-407d-9005-9d176f7829ec" label="lyrics-like">císti dignitáte vigére: t praesta,</l><l xml:id="m-4a1a9770-cb82-49fe-93cc-b35319df182b" facs="#m-10f2565f-6995-4adb-b136-40c2ad3f9cec" label="text-like">For a deceased Cardinal-Priest (or Cardinal-Deacon, priest).</l><l xml:id="m-3781abf6-002b-48ef-85dd-d3167303633c" facs="#m-0b735577-3640-49c7-8dd7-3d84e4aab3d9" label="text-like">Prayer.</l><l xml:id="m-399cd13b-1238-4f05-909a-dca07d2cdfaf" facs="#m-422bc726-e4f2-4f3c-934a-b3622ef9efde" label="lyrics-like">Eus, qui inter apostólicos sacer-vigére: t praesta quaésumus; * ut</l><l xml:id="m-975c46ff-6289-477a-a842-8bf9b2e6aeb9" facs="#m-5e69feac-1576-4bf6-b205-285bea96b25d" label="lyrics-like">U dótes fámulum tuum N. Pres¬</l><l xml:id="m-33d4fc92-2080-41c5-a437-617fa7784552" facs="#m-9233f198-7a90-42c1-b4ae-aadaeb0a938b" label="lyrics-like">eórum quoque perpétuo aggregétur</l><l xml:id="m-fa207ea0-78a8-4574-91e2-8c3cfd240ec0" facs="#m-af04e56e-b096-4d1b-9dc1-a9ca46d40b01" label="lyrics-like">byterum (vel Diáconum) Cardiná¬</l><l xml:id="m-68fd9ba7-881e-4355-a1a7-de784e1d6454" facs="#m-fa83734f-da4e-4b81-9649-c43c8f5920e9" label="lyrics-like">consórtio. Per Christum Dóminum</l><l xml:id="m-0a131dc3-38b3-412e-8bb9-09c941ef7ad2" facs="#m-68eaad1f-7842-4dc0-8555-4c88bfb3b694" label="lyrics-like">lem sacerdotáli fecisti dignitate! nostrum.</l></lg></div></section></score></mdiv></body></music>
</mei>