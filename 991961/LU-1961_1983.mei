<zone xml:id="m-d5472edd-b872-48ba-9820-88937faf4b6c" ulx="137" uly="714" lrx="255" lry="752" /><zone xml:id="m-a317cf2d-388c-470f-b3f5-61a057d03dc0" ulx="714" uly="724" lrx="811" lry="754" /><zone xml:id="m-35b10e95-a48a-4448-9af9-4e566b16edd1" ulx="67" uly="753" lrx="921" lry="793" /><zone xml:id="m-7ec5296b-315b-47bf-92e8-eeeed2431d68" ulx="31" uly="787" lrx="470" lry="826" /><zone xml:id="m-a0d8100d-fec3-49a3-b9b3-28910d40007a" ulx="478" uly="789" lrx="921" lry="818" /><zone xml:id="m-d5843625-b6b0-4a6a-8408-801daa02f3c7" ulx="28" uly="815" lrx="918" lry="853" /><zone xml:id="m-a39a61e4-1043-46f5-bb81-595d0e5e6d46" ulx="29" uly="841" lrx="902" lry="877" /><zone xml:id="m-927fbefa-a08d-4675-923b-aa5a73f57622" ulx="502" uly="868" lrx="638" lry="908" /><zone xml:id="m-6a87aec2-41ff-4844-8c9f-5ee3c8072d55" ulx="29" uly="870" lrx="484" lry="907" /><zone xml:id="m-f12491a6-16d9-4ae3-a853-75af500fdb78" ulx="56" uly="911" lrx="571" lry="952" /><zone xml:id="m-a7987116-45f0-4491-b590-049a07aa3807" ulx="55" uly="942" lrx="429" lry="980" /><zone xml:id="m-13f27b7f-d93a-4c6d-b53e-cbec85c08cbc" ulx="55" uly="977" lrx="491" lry="1022" /><zone xml:id="m-b5d36055-dfc8-4b3c-bb23-aceb1fa5858d" ulx="52" uly="1032" lrx="410" lry="1072" /><zone xml:id="m-23878afe-6443-45db-beba-7d1b8ed50a01" ulx="394" uly="1101" lrx="554" lry="1136" /><zone xml:id="m-973fdcc6-e7c8-443a-b5dc-25f6d304260d" ulx="507" uly="1145" lrx="921" lry="1180" /><zone xml:id="m-76c5241d-e550-408a-8f91-8bea033fa862" ulx="156" uly="1159" lrx="339" lry="1197" /><zone xml:id="m-95d26507-4c50-4d18-8f38-34e3de70255c" ulx="480" uly="1178" lrx="921" lry="1210" /><zone xml:id="m-60a14b62-2e0b-4ea3-8fb5-c0b2015faacc" ulx="63" uly="1201" lrx="469" lry="1242" /><zone xml:id="m-6c02c5ee-eb93-46e7-88f9-843f72c0088b" ulx="480" uly="1202" lrx="563" lry="1235" /><zone xml:id="m-5e3cbfa5-b49e-45f3-88ea-c36e0cd7d259" ulx="29" uly="1228" lrx="467" lry="1268" /><zone xml:id="m-1476581a-97dc-4caf-b7d4-7312a3049453" ulx="507" uly="1230" lrx="920" lry="1265" /><zone xml:id="m-f3eae323-de1c-445a-8175-07786e4b619a" ulx="25" uly="1257" lrx="143" lry="1292" /><zone xml:id="m-b96017ab-a7ce-4764-a29f-ad4e127c7120" ulx="481" uly="1257" lrx="919" lry="1292" /><zone xml:id="m-26093985-3367-4447-a956-3fd62960057d" ulx="52" uly="1280" lrx="466" lry="1315" /><zone xml:id="m-1ca78d73-0260-4fa8-b553-f96fd2c20606" ulx="479" uly="1289" lrx="715" lry="1318" /><zone xml:id="m-8bacf4bc-5219-42d5-9a62-ed57de451a03" ulx="505" uly="1309" lrx="920" lry="1346" /><zone xml:id="m-36671d7c-eb1e-4896-a608-7465f7f0dd1c" ulx="27" uly="1313" lrx="467" lry="1350" /><zone xml:id="m-6ea774b1-b56e-47a8-b3b4-70c9ec54a1a4" ulx="27" uly="1338" lrx="257" lry="1371" /><zone xml:id="m-fe8959f2-57a6-4256-abf0-164a2859ef4e" ulx="480" uly="1338" lrx="918" lry="1376" /><zone xml:id="m-d0985500-9b6f-407a-b2fc-7c619ed1e5de" ulx="53" uly="1364" lrx="467" lry="1403" /><zone xml:id="m-53cba08a-421d-49cb-8e2b-93971fda3970" ulx="477" uly="1369" lrx="622" lry="1401" /><zone xml:id="m-041fa0f2-123a-4f7a-9665-96691f6e06cd" ulx="27" uly="1393" lrx="466" lry="1427" /><zone xml:id="m-aad4549b-3e20-4855-a1ce-ea1d64320757" ulx="504" uly="1393" lrx="918" lry="1428" /><zone xml:id="m-65c2eac8-2ede-486b-a3b0-9e1830488afd" ulx="27" uly="1422" lrx="451" lry="1455" /><zone xml:id="m-2d1b73d0-ffec-41a8-acb4-f69dcfa9e5af" ulx="481" uly="1425" lrx="919" lry="1462" /><zone xml:id="m-695fcfae-090c-4d7a-80bd-a84ecd5ee672" ulx="53" uly="1450" lrx="468" lry="1489" /><zone xml:id="m-b6234fba-8fb8-484e-b23f-9759b908d9ff" ulx="479" uly="1450" lrx="540" lry="1481" /><zone xml:id="m-211f5e3a-eb41-4833-b80b-d53d77ce03e4" ulx="505" uly="1472" lrx="918" lry="1510" /><zone xml:id="m-12c6d074-d682-4b04-ba50-7d7312a7910d" ulx="28" uly="1479" lrx="467" lry="1514" /><zone xml:id="m-8ddc7281-c4de-4a47-aa83-bc62961176fd" ulx="27" uly="1503" lrx="465" lry="1544" /><zone xml:id="m-d37fb1f2-471b-494b-8435-aa77bdcc1391" ulx="479" uly="1505" lrx="918" lry="1541" /><zone xml:id="m-f4ef41e1-07bd-4f28-93aa-a9b1d8c34ca2" ulx="473" uly="1531" lrx="677" lry="1572" /><zone xml:id="m-91c9649e-8d61-4fdd-bca1-1a2b38da0c39" ulx="28" uly="1539" lrx="128" lry="1571" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-e05c4dd3-1beb-4023-955d-c53dfa089403" n="1983" facs="#m-e41a6df9-4e90-4bdf-a514-0ef1da66ebd6" /><div xml:id="m-89cb48e4-cac0-42c7-ba07-d6b411b0a1af">
            <lg xml:id="m-3dad0ded-8c11-4437-b8ca-3017feaac3c8">
              <l xml:id="m-7cd553b9-aa30-4294-b161-0fd1426d7042" facs="#m-83ebed4f-993b-4856-9909-38f927a84046" label="ambiguous">November 2.</l><l xml:id="m-3f559224-b572-437c-b58b-1627fc0c0892" facs="#m-254f7d3e-02ae-4fd3-a834-490538c2d734" label="ambiguous">1727</l><l xml:id="m-179e62d3-1d0f-47c8-97b1-5a909440e07a" facs="#m-445cec6e-1f60-4fb5-9777-beee06ea0f8e" label="text-like">The following is then said kneeling:</l><l xml:id="m-09cdc360-ad57-4598-b3b4-446b7851ba4e" facs="#m-84dfb0e0-eb23-4b83-b198-9c2d78faa3e2" label="lyrics-like">Páter nóster. continued in silence.</l><l xml:id="m-374bafcc-78de-417b-b05d-4979cf9f6845" facs="#m-85946bcf-8195-4e7a-9ebb-43cda9041579" label="lyrics-like">V. Et ne nos indúcas in tentatiónem. K. Sed libera nos a málo.</l><l xml:id="m-029db4e1-2a61-4e84-ab5f-1d89982fcaee" facs="#m-611b09cd-65e9-4368-8f7a-aba3be8f8b88" label="lyrics-like">V. A pórta inferi. K. Erue, Dómine, ánimas eórum.</l><l xml:id="m-27b9de04-e3a6-4b88-8e92-d5aeb29ca402" facs="#m-2d0a9c3e-9c97-46c9-a0d8-cca9f9591de4" label="lyrics-like">V. Requiéscant in pâce. B. Amen.</l><l xml:id="m-15aa2163-52af-4d8b-84dc-564d838ec44e" facs="#m-135fb94e-98bf-4794-b0f3-564ba45720c8" label="lyrics-like">V. Dómine, exáudi oratiónem méam. K. Et clámor méus ad te véniat.</l><l xml:id="m-0a21496d-9655-4a57-a9d3-5cdd5c54561f" facs="#m-feb89e9e-50f7-492c-8f37-07d9dce1216e" label="lyrics-like">V. Dóminus vobíscum. K. Et cum spíritu túo.</l><l xml:id="m-d392ee92-77c7-41c7-aa99-a591ddc5b2de" facs="#m-6afa27ca-e66f-4e91-9a48-d3f1298056d5" label="lyrics-like">Orémus.</l><l xml:id="m-d9a252f5-346c-4252-b3f7-e1afa346e578" facs="#m-4622feeb-5f53-44f9-807c-825f9e458bf2" label="text-like">Prayer.</l><l xml:id="m-5f5a4a6b-e0c7-40b2-a6ee-5762da2014cf" facs="#m-89e8583c-cc04-46e7-8750-20d396a09b07" label="lyrics-like">YUpplices, Dómine, pro animábus contraxérunt humána, clemens</l><l xml:id="m-bc500323-ebfa-45a5-86dc-d28ede0a10b7" facs="#m-d6964475-58f6-4ccc-9a50-baa2dc1e2138" label="lyrics-like">O ómnium famulórum famula-lindúlgeas * et poenis eórum finem</l><l xml:id="m-a452909c-f1dc-440c-91a4-1b9bb9c11df9" facs="#m-a5eb8d77-ea3e-45a4-917f-7e3ab4793211" label="lyrics-like">rúmque tuárum preces effúndi-benignus impónas. Per Dóminum.</l><l xml:id="m-03ed8fbe-67a3-493d-ad6d-d0da4c55e5c9" facs="#m-7afddc71-1f2a-4204-9749-21f7183d79ac" label="lyrics-like">mus:t ut quidquid conversatióne</l><l xml:id="m-3b72a959-95b1-437f-9e03-5e872b17c6f1" facs="#m-63371db8-86ea-4272-976f-4b2728615aa2" label="ambiguous">K. Amen.</l><l xml:id="m-b1d268fa-4912-4f7c-8be6-5dcaf77f5174" facs="#m-1e630fea-728e-40ac-b8c3-1a7af1e01235" label="text-like">The Martyrology is then said in Choir, after which the Office ends as</l><l xml:id="m-055b8a07-1f08-4962-9bf7-0916b8703f22" facs="#m-feed2f02-8f9f-448d-adda-b89823bb3371" label="ambiguous">follows:</l><l xml:id="m-85cc31ee-a768-498f-b79c-58df45d297f3" facs="#m-a2013ddd-e0ae-43a7-9484-fc243e83795c" label="lyrics-like">V. In memória aetérna érunt jústi.</l><l xml:id="m-b6f516f2-cc1a-4554-8184-edf4abf4c424" facs="#m-45427417-d825-49d1-878c-da808ede6dc0" label="lyrics-like">R. Ab auditióne mála non timébunt.</l><l xml:id="m-b730c2d9-c388-4668-a044-44f41f0daab0" facs="#m-d5472edd-b872-48ba-9820-88937faf4b6c" label="lyrics-like">Orémus.</l><l xml:id="m-1c7c564f-88d7-4983-a331-70a5ae551202" facs="#m-a317cf2d-388c-470f-b3f5-61a057d03dc0" label="text-like">Prayer.</l><l xml:id="m-bc11200b-3aa0-4cd5-be19-1210f22ebe41" facs="#m-35b10e95-a48a-4448-9af9-4e566b16edd1" label="lyrics-like">Eus, véniae largítor et humánae!Virgine intercedénte cum ómnibus</l><l xml:id="m-1407a7c1-c2bf-49cb-83f1-ee2d09c09d68" facs="#m-7ec5296b-315b-47bf-92e8-eeeed2431d68" label="lyrics-like">U salútis amátor: t quaésumus</l><l xml:id="m-d354f55d-b18e-43fb-88c8-abe9c15ac846" facs="#m-a0d8100d-fec3-49a3-b9b3-28910d40007a" label="lyrics-like">Sanctis tuis, ad perpétuae beatitúdi¬</l><l xml:id="m-04aba630-6583-4549-9311-7365d5251cb2" facs="#m-d5843625-b6b0-4a6a-8408-801daa02f3c7" label="lyrics-like">cleméntiam tuam; ut ánimas óm- nis consórtium pervenire concédas.</l><l xml:id="m-d967e6e8-a91c-4bd0-beeb-2c539441320b" facs="#m-a39a61e4-1043-46f5-bb81-595d0e5e6d46" label="lyrics-like">nium fidélium, qui ex hoc saéculo! Per Christum Dóminum nostrum.</l><l xml:id="m-1cd44c39-3a4c-41fc-8a30-ab8c72007904" facs="#m-927fbefa-a08d-4675-923b-aa5a73f57622" label="ambiguous">K. Amen.</l><l xml:id="m-d1fa1839-df8e-46d4-b036-ba2d41219263" facs="#m-6a87aec2-41ff-4844-8c9f-5ee3c8072d55" label="lyrics-like">transiérunt, * beáta Maria semper ]</l><l xml:id="m-680ac308-6662-4bb0-bfec-b1abcd2678bf" facs="#m-f12491a6-16d9-4ae3-a853-75af500fdb78" label="lyrics-like">V. Réquiem aetérnam dóna éis, Dómine.</l><l xml:id="m-c29ba8a0-2940-441c-baff-92d7869f13c9" facs="#m-a7987116-45f0-4491-b590-049a07aa3807" label="lyrics-like">R. Et fux perpétua lúceat éis.</l><l xml:id="m-0685ffd8-bed2-4026-8a65-747beb287130" facs="#m-13f27b7f-d93a-4c6d-b53e-cbec85c08cbc" label="lyrics-like">V. Requiéscant in pâce. E. Amen.</l><l xml:id="m-5571a631-26cb-41a6-b719-2b15927b79f3" facs="#m-b5d36055-dfc8-4b3c-bb23-aceb1fa5858d" label="ambiguous">No further prayers are added.</l><l xml:id="m-afe5b79b-4b7e-4a0d-8e7c-1c6485b8dfd5" facs="#m-23878afe-6443-45db-beba-7d1b8ed50a01" label="text-like">AT TERCE.</l><l xml:id="m-083ae94b-1fd3-4802-b245-93f0ade25107" facs="#m-973fdcc6-e7c8-443a-b5dc-25f6d304260d" label="lyrics-like">Putruérunt et corrúptae sunt ci¬</l><l xml:id="m-89aff8e0-809f-47ed-b35d-835d625b1af2" facs="#m-76c5241d-e550-408a-8f91-8bea033fa862" label="ambiguous">Psalm 37. I.</l><l xml:id="m-13f326b3-d9c5-4721-bcb8-753c0467914d" facs="#m-95d26507-4c50-4d18-8f38-34e3de70255c" label="lyrics-like">catrices méae, * a fácie insipiéntide</l><l xml:id="m-2b37c242-de3c-4c4b-a699-ae5b3ce332a0" facs="#m-60a14b62-2e0b-4ea3-8fb5-c0b2015faacc" label="lyrics-like">LOmine, ne in furóre túo árguas</l><l xml:id="m-297f8585-36ad-475a-954c-a6ff19e6a935" facs="#m-6c02c5ee-eb93-46e7-88f9-843f72c0088b" label="lyrics-like">méae.</l><l xml:id="m-8308626f-a8b8-407c-bbb3-d188e7c49345" facs="#m-5e3cbfa5-b49e-45f3-88ea-c36e0cd7d259" label="lyrics-like">me*neque in íra túa corri¬</l><l xml:id="m-8f5a75da-2ff2-4a74-bfc2-98186ab74432" facs="#m-1476581a-97dc-4caf-b7d4-7312a3049453" label="lyrics-like">Miser fáctus sum, et curvátus sum</l><l xml:id="m-99a8b1da-29be-4bc1-830b-e3b4bc301e3d" facs="#m-f3eae323-de1c-445a-8175-07786e4b619a" label="ambiguous">pias me.</l><l xml:id="m-c05e5a36-2f3a-4855-a409-eceba0c7595e" facs="#m-b96017ab-a7ce-4764-a29f-ad4e127c7120" label="lyrics-like">usque in finem:* tóta die contri¬</l><l xml:id="m-47936fae-3fc4-49e6-8470-4edb9a72493b" facs="#m-26093985-3367-4447-a956-3fd62960057d" label="lyrics-like">Quóniam sagíttae túae infixae</l><l xml:id="m-0811dded-2486-40b3-b78d-341715bcc6a8" facs="#m-1ca78d73-0260-4fa8-b553-f96fd2c20606" label="lyrics-like">státus ingrediébar.</l><l xml:id="m-17cebe89-eae9-409b-8b75-313afba89b29" facs="#m-8bacf4bc-5219-42d5-9a62-ed57de451a03" label="lyrics-like">Quóniam lúmbi méi impléti sunt</l><l xml:id="m-e7f541fa-f13b-40dc-9e10-54bf5a1f580c" facs="#m-36671d7c-eb1e-4896-a608-7465f7f0dd1c" label="lyrics-like">sunt mihi:* et confirmásti super</l><l xml:id="m-8bb18eb4-ed7d-4189-bb5d-cc1163e64b96" facs="#m-6ea774b1-b56e-47a8-b3b4-70c9ec54a1a4" label="lyrics-like">me mánum túam.</l><l xml:id="m-2885b27c-3a96-46f1-b56e-dad02f31a016" facs="#m-fe8959f2-57a6-4256-abf0-164a2859ef4e" label="lyrics-like">illusiónibus : * et non est sánitas in</l><l xml:id="m-de14e9da-b694-42c7-900c-ce7c78816b04" facs="#m-d0985500-9b6f-407a-b2fc-7c619ed1e5de" label="lyrics-like">Non est sánitas in cárne méa a</l><l xml:id="m-dbf1e02c-6f31-46a2-b1b2-6ea55d56af30" facs="#m-53cba08a-421d-49cb-8e2b-93971fda3970" label="lyrics-like">cárne méa.</l><l xml:id="m-7b8f6fc5-f7dd-4d1b-8d57-a2f250c471d9" facs="#m-041fa0f2-123a-4f7a-9665-96691f6e06cd" label="lyrics-like">fácie irae tuae:* non est pax óssibus</l><l xml:id="m-5111e0ab-8752-49a9-a050-95a84cdc8de9" facs="#m-aad4549b-3e20-4855-a1ce-ea1d64320757" label="lyrics-like">Afflictus sum et humiliátus sum</l><l xml:id="m-2b8e4804-e5bd-4fce-b87c-9bf829761380" facs="#m-65c2eac8-2ede-486b-a3b0-9e1830488afd" label="lyrics-like">méis a fácie peccatórum meórum.</l><l xml:id="m-54e30ae7-8fad-40e6-98fb-8b052b9bace2" facs="#m-2d1b73d0-ffec-41a8-acb4-f69dcfa9e5af" label="lyrics-like">nimis :* rugiébam a gémitu córdis</l><l xml:id="m-3fef425a-4c89-4f46-8cda-69c3b1c378f3" facs="#m-695fcfae-090c-4d7a-80bd-a84ecd5ee672" label="lyrics-like">Quóniam iniquitátes méae super¬</l><l xml:id="m-ad98b626-aecb-4a06-9ca0-4bca4f98403e" facs="#m-b6234fba-8fb8-484e-b23f-9759b908d9ff" label="ambiguous">mei.</l><l xml:id="m-d986e312-b98f-44e4-957f-8ed971568c98" facs="#m-211f5e3a-eb41-4833-b80b-d53d77ce03e4" label="lyrics-like">Dómine, ante te ómne desidérium</l><l xml:id="m-d554d6f6-7b82-47ea-bf0a-5ab1e9f9a1ef" facs="#m-12c6d074-d682-4b04-ba50-7d7312a7910d" label="lyrics-like">gréssae sunt cáput méum:*t</l><l xml:id="m-5d64f414-5ba4-4440-9103-85b6b14e9c32" facs="#m-8ddc7281-c4de-4a47-aa83-bc62961176fd" label="lyrics-like">sicut ónus gráve gravátae sunt sú¬</l><l xml:id="m-b24b7f34-e53f-4edf-969d-f10e70136761" facs="#m-d37fb1f2-471b-494b-8435-aa77bdcc1391" label="lyrics-like">méum : * et gémitus méus a te non</l><l xml:id="m-97f13128-6b86-476d-af80-f795133f5dad" facs="#m-f4ef41e1-07bd-4f28-93aa-a9b1d8c34ca2" label="lyrics-like">est aoscónditus.</l><l xml:id="m-db739337-05e9-479a-bd56-ee14df0ced2a" facs="#m-91c9649e-8d61-4fdd-bca1-1a2b38da0c39" label="ambiguous">per me.</l></lg></div></section></score></mdiv></body></music>
</mei>