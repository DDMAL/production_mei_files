                <sb xml:id="m-3a50015a-b2f3-491b-b5b8-d7329d38d1b3" n="1" facs="#m-96a6b267-5c40-4810-aa22-5be9287a9a76" />
                <clef xml:id="m-f3c9b3c8-126e-434e-8df5-2f0cfe1bdd1a" facs="#m-f7883e81-ff96-455f-afd6-d3f757e60a53" line="4" shape="C" />
                <syllable xml:id="m-2bba4420-c9e1-4c6d-8315-b035c084d804">
                  <syl /><neume facs="#m-4d836f30-b74d-4caa-abdb-e3b6154be009" type="podatus" xml:id="m-30f666b4-6859-4c35-a85a-c090a2e82fc3">
