                <syllable xml:id="m-099e2547-b038-4413-b22a-5e5502e804e8">
                  <syl /><neume facs="#m-68cae6e9-4202-4688-a04c-75bab5f0b13d" type="podatus" xml:id="m-a174f56f-fe3b-4b68-989e-5bf29641587b">
                    <nc xml:id="m-e8dab4e6-ab9e-4f77-914a-b89ec4f7edbd" pname="d" oct="3" />
                    <nc xml:id="m-c2de2190-f52f-43c8-a168-778d427ca81f" pname="a" oct="3" />
                  </neume>
                </syllable>
                <divLine xml:id="m-484d8c62-8be5-4f51-9c64-09748f153b50" facs="#m-5ed4b7b3-6dbb-4133-842e-9379f4aeab9e" form="maxima" />
                <syllable xml:id="m-2566f0d6-535f-4c8e-8577-3579d3cd1a98">
                  <syl /><neume facs="#m-43b37bac-b261-4650-abcb-999799d90598" type="podatus" xml:id="m-321f9f1a-3b3c-45a3-b56a-82c4238ed304">
                    <nc xml:id="m-10fa4ed6-f3cb-445a-82aa-f153934e34b8" pname="g" oct="3"><episema xml:id="m-fb2bad38-605e-4632-8f25-4b6f855dfdfc" form="h" /></nc>
                    <nc xml:id="m-1b990f05-53f7-4053-aa49-f1776421e813" pname="c" oct="4" />
                  </neume>
                </syllable>
                <divLine xml:id="m-ad6bb026-096c-4bb2-9849-b1866d8155ba" facs="#m-70bbc1a0-ef20-4661-968e-0d4d7fb0ed53" form="finalis" />
              </layer>
            </staff>
            <div xml:id="m-de0c4be3-8026-449d-927a-dff32521b7d8">
              <lg xml:id="m-72736ba3-e635-4055-8996-bceaaec192e7">
                <l xml:id="m-edd14dc4-9b12-4f67-a48a-182b4e98bcb4" facs="#m-cb66f08d-d084-4967-b2a0-929009fab0d9" label="text-like">Preface to the Vatican Edition of the Roman Chant. xi.</l><l xml:id="m-af1c1052-3296-44ee-9df9-4999060c7ddd" facs="#m-11135579-0021-471a-85fa-e27e2e27a668" label="text-like">as the norm for modern Editors. The following tables give the principal form¬</l><l xml:id="m-6208e3ed-950b-4a4f-9893-fdb7f7a1d023" facs="#m-196ac068-1a93-40c2-89e6-5a0a14df3d52" label="text-like">of these notes or neums along with their names:</l><l xml:id="m-e05279f1-aab8-4ee9-81fd-6c8cb9cc29ed" facs="#m-a5bdc171-2d1b-485a-94ce-c8ed1c7ff7dd" label="ambiguous">Punctum</l><l xml:id="m-1f534264-9607-49f2-9fc8-80c35fac3133" facs="#m-87d617d5-6e55-48ae-a737-f4fbe23cd675" label="ambiguous">Virga</l><l xml:id="m-5646c307-5e89-4370-9a81-8bbef59e7aa8" facs="#m-6f9934fd-b057-43fa-95af-fa1bddcccdff" label="ambiguous">Punctum inclinatum</l><l xml:id="m-7bb3eada-7fc5-4f3e-b31b-24b556ef7523" facs="#m-e51c7f10-a62e-47d7-914f-d516cea10932" label="ambiguous">Bivirga</l><l xml:id="m-b5e35e63-e9e6-4523-b903-a6704844150e" facs="#m-e6e9cb95-b6d3-4c23-b52f-043b363e4a3e" label="ambiguous">(Diamond)</l><l xml:id="m-1e6098ae-49ca-4053-97ac-ade359f6ce6f" facs="#m-a24fc0fa-8bd6-49ad-8a95-f4360f1b5626" label="ambiguous">Cephalicus</l><l xml:id="m-8ff2e72a-49c5-4f84-8afd-39078f5b28f7" facs="#m-e8ed82ea-d424-480c-826f-b1575f85108f" label="ambiguous">Epiphonus</l><l xml:id="m-e25e3477-07e4-485a-a134-e7507a6b1d2b" facs="#m-616c12f0-0794-4f69-9488-ef36c2e3b1fa" label="text-like">Podatus or Pes Clivis or Flexa</l><l xml:id="m-bab084e1-fd84-47b3-830e-e8c7cc5e1be5" facs="#m-201342b6-0ced-4d25-ad45-8e62db22e090" label="ambiguous">Climacus</l><l xml:id="m-cb655322-acb1-4d78-a9eb-fedf3dad4c48" facs="#m-5cad1c09-6163-46ae-88fe-8b13fa832265" label="ambiguous">Scandicus</l><l xml:id="m-3bb4c562-e6c9-4117-b185-9fca449ee2ab" facs="#m-8f61e680-689b-4db2-9316-7bfeedd85ae0" label="ambiguous">Salicus</l><l xml:id="m-f4a68a06-229b-4908-b735-121c053d03a6" facs="#m-63203613-3048-42fa-a662-510e43c5c799" label="ambiguous">Ancus</l><l xml:id="m-cb584f44-17cb-4d85-baa8-6051c51c77e9" facs="#m-3cd6819f-1289-46a4-9393-a7b27a444998" label="ambiguous">Torculus resupinus Porrectus flexus</l><l xml:id="m-2dbf62ba-c2e4-4907-8ff9-6a3230af114f" facs="#m-febc7fe0-2909-430e-804b-f5b171489306" label="ambiguous">Torculus</l><l xml:id="m-d81d85c1-7791-4f3b-8e7a-1f2f112ba95a" facs="#m-9dc64baf-df5a-425b-8f71-6a8a14f4b003" label="ambiguous">Porrectus</l><l xml:id="m-a8eba9d3-f6da-44c8-9447-ce218996a434" facs="#m-802de55f-7ee8-458e-8bc2-30beb06c0331" label="ambiguous">Pes subpunctis Scandicus subpunctis Scandicus flexus Climacus resupinus</l><l xml:id="m-98432c2d-f4ae-48e8-8002-eeca1c242d5a" facs="#m-1711000b-53b8-4337-9205-7a826e974184" label="ambiguous">Strophicus</l><l xml:id="m-cb058fd2-5503-4f4a-88e9-745702035193" facs="#m-7c3c8e60-fb89-454a-bf28-7fd166ef64f9" label="ambiguous">Clivis strophica</l><l xml:id="m-1008b6c5-80e6-4708-a098-d60a6b0aa421" facs="#m-d4a1a87c-0ee4-482d-b946-ea5037b32b7f" label="ambiguous">Pes strophicus</l><l xml:id="m-4df89958-4702-485d-b690-7b9bf022b05a" facs="#m-4d110917-66fd-4be9-81a7-75483025d836" label="ambiguous">Torculus strophicus</l><l xml:id="m-134a3c00-f686-4b19-bd41-91e50ab5c7a2" facs="#m-f1ed259e-6462-4788-b1d3-433870250af5" label="text-like">or Clivis</l><l xml:id="m-f9517991-b340-4620-ac75-d64b488cef7f" facs="#m-37ff1653-9fc1-4d2c-9269-85605a21291a" label="text-like">or Torculus</l><l xml:id="m-4b9e9e66-8e62-42a8-be96-0dd580b65d41" facs="#m-c0417e54-ce6e-4f44-b783-4f55b3ddfe1c" label="text-like">with an Oriscus</l><l xml:id="m-3e1e232e-e68a-46f5-aac6-e58e442ffaaa" facs="#m-9569a155-feaa-402e-a75d-3423debb5f2a" label="text-like">with an Oriscus</l><l xml:id="m-37ffdfa7-f240-481b-986e-4690a8d703ac" facs="#m-11360ec7-515c-4eb0-a603-f2717c8b0e19" label="ambiguous">Trigon</l><l xml:id="m-aa42b38c-3840-42b4-b803-645aaee912ce" facs="#m-e19bd4ab-52e8-47f7-8035-d6c198f014bc" label="text-like">Pressus Other Pressus or apposed neums</l><l xml:id="m-92a71f3e-2892-4dcd-bda0-5af91469cc2b" facs="#m-eb948322-697c-405c-bde8-e2ef52df1a8a" label="ambiguous">Quilisma</l><l xml:id="m-e0a66dab-d290-482b-aa77-756bfe2b1fa4" facs="#m-6da2be04-2edc-4436-b68d-cb64fbc07339" label="text-like">Longer or compound Neums</l><l xml:id="m-84162e95-0665-47c8-8043-a8f299d029a7" facs="#m-566ddd37-f490-4acb-9dcf-92bbc29405b4" label="text-like">To avoid all error and doubt in the interpretation of the above notation, the</l><l xml:id="m-6a3b7e28-8871-4d38-bda1-dcfc5a3f0816" facs="#m-30e9ec11-a1cc-4008-9344-8dbd6cc361ba" label="ambiguous">following observations are to be noted:</l><l xml:id="m-e2eda9bd-7ae2-4bf3-a4ed-090190be318c" facs="#m-a3fc982e-4f46-4561-b6fc-5379139110e8" label="text-like">1. Of the two notes of the Podatus, the lower one must be sung before the</l><l xml:id="m-509d8971-63a1-4106-bd95-80b103890e7a" facs="#m-5270041b-c3cd-4565-a461-b4317f02a986" label="ambiguous">upper note immediately above it.</l><l xml:id="m-7bae5d05-83b4-42e7-a273-ffcb2eb341b6" facs="#m-0a9af2be-7923-49c1-a5cb-7e064e9e8982" label="lyrics-like">fa sol ré la sol ut</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>