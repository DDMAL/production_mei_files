lry="994" /><zone xml:id="m-a383eb28-adff-46ee-9b13-d99290fc6e4b" ulx="492" uly="977" lrx="916" lry="1018" /><zone xml:id="m-2d19446b-a091-4308-a5ef-b10ee43ebe1e" ulx="58" uly="984" lrx="482" lry="1021" /><zone xml:id="m-6e0c5ad6-05f6-4735-950f-64329f64696d" ulx="493" uly="1009" lrx="918" lry="1042" /><zone xml:id="m-b08732ba-4983-42dc-9b60-54c4c02feaaa" ulx="58" uly="1010" lrx="482" lry="1047" /><zone xml:id="m-ac4a475e-44f0-44da-82ba-f96fc771920f" ulx="496" uly="1033" lrx="918" lry="1071" /><zone xml:id="m-d786cbcb-01f0-4b68-8cc0-bf11a28903fa" ulx="59" uly="1037" lrx="482" lry="1073" /><zone xml:id="m-379c4d4c-455a-4a2e-837d-7d0139a3a25d" ulx="493" uly="1058" lrx="918" lry="1093" /><zone xml:id="m-38107e67-2134-483c-903d-bb3d22017c63" ulx="59" uly="1065" lrx="483" lry="1102" /><zone xml:id="m-61492096-7227-4505-a106-0e4234571e1e" ulx="492" uly="1085" lrx="918" lry="1120" /><zone xml:id="m-731c6bca-f6a7-449a-8d0d-48a794cd7e1a" ulx="60" uly="1089" lrx="486" lry="1127" /><zone xml:id="m-7235214e-98af-41b3-896f-ca9a906428cc" ulx="60" uly="1111" lrx="786" lry="1154" /><zone xml:id="m-89ef1bc1-959d-4f7f-9741-363326602a14" ulx="86" uly="1152" lrx="915" lry="1201" /><zone xml:id="m-db84d626-2eba-4cef-bffe-4f48166e31d1" ulx="117" uly="1207" lrx="859" lry="1247" /><zone xml:id="m-7b452bbf-b880-4253-a070-0daf2c8f0879" ulx="424" uly="1240" lrx="582" lry="1277" /><zone xml:id="m-2ef6371b-9fa9-4329-990d-00d3cb8bfcfb" ulx="78" uly="1280" lrx="917" lry="1326" /><zone xml:id="m-cd6c5db4-aab9-4771-81fd-993a71e54d34" ulx="496" uly="1310" lrx="918" lry="1345" /><zone xml:id="m-5e468389-f7ca-4ae7-a7d8-c2522a9157d9" ulx="62" uly="1313" lrx="482" lry="1349" /><zone xml:id="m-9f2d52ea-53b4-4f3f-8abc-fd1e7e9997dc" ulx="493" uly="1335" lrx="918" lry="1375" /><zone xml:id="m-df6e34fd-238f-464d-8e3e-5fcb7db1e414" ulx="61" uly="1345" lrx="487" lry="1374" /><zone xml:id="m-ebd7cdd6-fa0b-460d-aa2e-428bfe991ffa" ulx="60" uly="1365" lrx="484" lry="1402" /><zone xml:id="m-aab907f8-fc62-4055-a038-64d99b24d5a8" ulx="492" uly="1365" lrx="918" lry="1395" /><zone xml:id="m-7b3f899d-faec-40b1-9271-222e40b322fb" ulx="495" uly="1389" lrx="919" lry="1427" /><zone xml:id="m-ffd3618f-bbac-47ac-91f8-4ce6b0ee924f" ulx="61" uly="1393" lrx="485" lry="1427" /><zone xml:id="m-0fb3b9c9-ab62-458e-99fc-281500055cf4" ulx="495" uly="1416" lrx="919" lry="1453" /><zone xml:id="m-4cf799fc-cfb5-4aa6-82cf-056c47f519ee" ulx="62" uly="1424" lrx="485" lry="1457" /><zone xml:id="m-357d0956-37f4-4c80-b077-f7a0e63efe60" ulx="494" uly="1442" lrx="919" lry="1476" /><zone xml:id="m-a6d0672a-5192-461e-8d5f-4239b27df8a7" ulx="62" uly="1449" lrx="485" lry="1481" /><zone xml:id="m-b94ad64c-cf2e-44d8-899d-9600092e50c8" ulx="494" uly="1469" lrx="918" lry="1506" /><zone xml:id="m-04fb776c-e50a-4106-937f-b5da33dfed46" ulx="62" uly="1473" lrx="485" lry="1507" /><zone xml:id="m-aec5747e-68ca-4125-a15b-2ea5788e5939" ulx="806" uly="1492" lrx="893" lry="1532" /><zone xml:id="m-766b43d1-f27f-4ac0-8b9a-49d6a5af9cfc" ulx="63" uly="1496" lrx="643" lry="1540" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-ff29bbea-7a18-415b-a7ec-fea9b34edc1a" n="1595" facs="#m-4c852b33-efb0-4199-889a-b0f9d8190f24" /><div xml:id="m-e4cc6d53-b182-4c06-bd28-d2b8fe3129ea">
            <lg xml:id="m-04bfddec-5876-4d3a-9953-24a1fb9045e1">
              <l xml:id="m-6fa67b08-e62e-4d60-92e3-d6b3bfab9a89" facs="#m-0af135c7-939c-4701-b9ce-3093e49d1ec5" label="text-like">February 24 or 25.</l><l xml:id="m-200ff8e4-98ac-46d2-973d-e5af76d185e5" facs="#m-997d8b23-6da1-4e99-aad6-5b1d36cb9e6d" label="ambiguous">1391</l><l xml:id="m-5a122c92-def7-45db-b91a-ab4575192d7e" facs="#m-b5b2ef97-e54e-4c09-a50e-4c1ea529e237" label="ambiguous">S. MATTHIAS, APOSTLE.</l><l xml:id="m-e549c336-979b-44c8-81e9-7ab2ef1cb701" facs="#m-8a786534-6d2a-4f5b-8eb7-72ced8d22e6e" label="text-like">24. or 25.</l><l xml:id="m-68ec50b5-70e9-4d0f-87d3-6619a5a9adb6" facs="#m-486314ec-a946-4828-8f1a-af4df9bc65d3" label="text-like">Double of the second Class.</l><l xml:id="m-877063fb-7557-49cb-9f02-db5da2b789a4" facs="#m-e3fc76b5-54ab-45b5-8a40-fe594777b74f" label="text-like">At vespers and at the Little Hours, all as in the Common ot</l><l xml:id="m-d098bac6-1045-475c-9246-8f9fe7f9c756" facs="#m-f2e9ffd1-e03f-4ea2-a4f0-61d9dc0bee5f" label="ambiguous">Apostles, p. IIlI.</l><l xml:id="m-abb0af4f-4375-40a4-b75c-dfe917bdac79" facs="#m-72f18307-0ebb-4f67-9567-06abbecb63bb" label="text-like">AT MASS.</l><l xml:id="m-851fdbe1-12c7-4d3c-8974-9703866c92b9" facs="#m-88efa08c-de01-4749-a3fc-83c3748c6897" label="ambiguous">Intrott. Mihi autem. D.</l><l xml:id="m-792b9259-61c4-4ba2-8ee9-47465a118dc0" facs="#m-351a36f8-7599-4533-b6fc-fb6ddc691250" label="ambiguous">Collect.</l><l xml:id="m-0f11ae9a-4f6d-423f-a0cb-f93bb9d75f2c" facs="#m-2d7c828b-baa5-4916-8f9c-32ebcea357f2" label="lyrics-like">Eus, qui beátum Matthiam Apo-linterventióne, * tuae circa nos pie¬</l><l xml:id="m-e93ecc18-df57-4350-a09c-8331a7b3eb2e" facs="#m-bf49fc4b-fc09-4674-875f-ae9863a443a7" label="lyrics-like">I stolórum tuórum collégio so- tátis semper viscera sentiámus. Per</l><l xml:id="m-15248d08-9e0f-4e67-aaca-b080898c3b16" facs="#m-13e304d4-3339-4a6d-a105-6b65187444a6" label="lyrics-like">ciãsti : t tribue, quaésumus; ut ejus! Dóminum.</l><l xml:id="m-b3bc5caa-2d84-4932-a76c-c89455ef9a63" facs="#m-abbbd038-59de-4523-ab31-30c73ef56715" label="ambiguous">Lectio Actuum Apostolorum. Act. I. c.</l><l xml:id="m-e21f6d48-13ac-4957-926a-c4628cfca745" facs="#m-f16fa7cc-6af9-459c-990d-4c5abde5182c" label="lyrics-like">TN diébus illis : Exsúrgens Petrus (ea: et episcopátum ejus accipiat</l><l xml:id="m-f7392116-f423-43cf-84e1-351d02c27fc6" facs="#m-51138ef0-a423-4435-bf2c-d3ddb3891739" label="lyrics-like">alter. Opórtet ergo ex his viris, qui</l><l xml:id="m-64bab3da-8ff3-40bc-b289-a11e7b454289" facs="#m-fb47eca9-90c9-47c3-b7e9-5f1679f87d4b" label="lyrics-like">Lin médio fratrum, dixit (erat</l><l xml:id="m-5b4d6cc1-1c08-44ee-a9fe-199175f4483b" facs="#m-b9b80fcd-3661-418a-95d5-aa0194def286" label="lyrics-like">nobiscum sunt congregáti in omni</l><l xml:id="m-ac247d2c-b195-4f60-a1eb-db4bdd191dee" facs="#m-3a1fa4c1-766d-4f7f-acd6-5d542c0e1e3f" label="lyrics-like">autem turba hóminum simul, fere</l><l xml:id="m-d279816a-87f8-4121-a681-85b050c245f5" facs="#m-103cdb44-ca14-4af4-9ed2-b3228fa70f75" label="lyrics-like">témpore, quo intrávit et exivit inter</l><l xml:id="m-4d5efef3-7fae-41c9-9d46-7d3ab2419147" facs="#m-eac805ca-64ed-4080-bd51-c56144dbefc1" label="lyrics-like">centum viginti) : Viri fratres, opór¬</l><l xml:id="m-be761e2a-96e3-4e68-90f6-5398904ccf55" facs="#m-6c8f5222-a6d7-4e3e-82ef-4b809dc352a2" label="lyrics-like">nos Dóminus Jesus, incípiens a ba¬</l><l xml:id="m-c826e948-f567-48a7-abe7-df0aed46bb2f" facs="#m-3028768a-36f7-4dbb-bc2f-1cee4a8ee64d" label="lyrics-like">tet impléri Scriptúram, quam prae¬</l><l xml:id="m-e135d988-3ca7-46b3-8f89-0a2cdc8cc5e8" facs="#m-0d376852-79e7-49de-a431-110cc2f7c743" label="lyrics-like">ptísmate Joánnis usque in diem qua</l><l xml:id="m-067578b6-0164-4dfc-8152-83c71bb19232" facs="#m-dc589c1b-5d5a-4873-839c-ed14f0699c0e" label="lyrics-like">dixit Spíritus Sanctus per os David</l><l xml:id="m-a5f9665b-1deb-488f-8c62-9858719d4fde" facs="#m-4c903e37-9636-4311-a3b5-1569af70ecb5" label="lyrics-like">assúmptus est a nobis, testem resur¬</l><l xml:id="m-79e0929c-15a1-4042-8a66-a99696aa6aff" facs="#m-97f3e0b5-b180-4b76-b1bc-37a2c0ee46eb" label="lyrics-like">de Juda, qui fuit dux eórum qui</l><l xml:id="m-422f2626-2344-4c41-be3a-854fa5ff7727" facs="#m-4d2a13a4-f264-4f51-bbbe-26e454c80cb6" label="lyrics-like">rectiónis ejus nobiscum fieri unum</l><l xml:id="m-21288a1b-2eca-4e12-8e0f-148af107a19e" facs="#m-1cd85dc2-1b1d-4eb1-a994-a451a20521f0" label="lyrics-like">comprehendérunt Jesum; qui con¬</l><l xml:id="m-148a798a-67ee-4faf-a85b-53f51c59bf67" facs="#m-fed56553-0cd4-485b-a688-d470a577e7d6" label="lyrics-like">ex istis. Et statuérunt duos, Joseph</l><l xml:id="m-1eb4dfe2-f60e-4749-9c36-1091a6b940c2" facs="#m-f3f0e764-9366-4964-8b8a-93dd58141077" label="lyrics-like">numerátus erat in nobis, et sortitus</l><l xml:id="m-3605054b-a7be-449a-8eb0-fcc660892bcd" facs="#m-a08666e9-d221-445d-b860-c479a158d2c3" label="lyrics-like">qui vocabátur Bársabas, qui cogno¬</l><l xml:id="m-b20408f5-a61d-4bf3-99b7-1da954137352" facs="#m-376f7c7c-ba55-4b4a-b8c1-aabde4a767ab" label="lyrics-like">est sortem ministérii huius. Et hic</l><l xml:id="m-fb1e3e0f-3170-4118-8ea3-8c5425b2fe86" facs="#m-47ff7224-acbf-4029-90da-68129cd22210" label="lyrics-like">minátus est Justus, et Matthiam. Et</l><l xml:id="m-ce06c75b-d202-46e5-988e-0b41683af08e" facs="#m-3d1f5010-09e1-45ab-801a-d171885cbcc7" label="lyrics-like">quidem possédit agrum de mercéde</l><l xml:id="m-36cdf3f4-1b8c-4c4a-ba78-aa8ec835a9af" facs="#m-4dd36a7a-2c7d-4234-8779-969a92e891ee" label="lyrics-like">orántes dixérunt : Tu, Dómine, qui</l><l xml:id="m-b10ff92a-198f-4c7e-8b6a-f92e8e9d6255" facs="#m-47cd48dd-30a1-4007-8bc8-279900982b47" label="lyrics-like">iniquitátis, et suspénsus crépuit mé¬</l><l xml:id="m-51a11479-b5cd-40b4-b135-16b312e7b231" facs="#m-db2d8a1c-5eb8-4518-8ee8-747f813b5688" label="lyrics-like">corda nosti ómnium, osténde quem</l><l xml:id="m-ff115b8b-fb92-4245-862b-a19cf9489795" facs="#m-877dfd2c-2199-4d56-818f-1f5f2abf9e93" label="lyrics-like">dius : et diffúsa sunt ómnia víscera</l><l xml:id="m-508cc99c-3d0b-408e-9046-fdaf3b03f29b" facs="#m-eedb219e-393b-41c1-b179-8e7527b99114" label="lyrics-like">elégeris ex his duóbus unum, accí¬</l><l xml:id="m-94454781-2a3a-42f5-8e03-d5ae1d526402" facs="#m-42f34ef4-b105-4527-a90d-a9d49ac11ff1" label="lyrics-like">ejus. Et notum factum est ómnibus</l><l xml:id="m-6935b327-756d-4b5f-a12d-5cbe1ad74d63" facs="#m-a383eb28-adff-46ee-9b13-d99290fc6e4b" label="lyrics-like">pere locum ministérii hujus et apo¬</l><l xml:id="m-2a4c27d9-83fc-4af0-993a-ef8994131e38" facs="#m-2d19446b-a091-4308-a5ef-b10ee43ebe1e" label="lyrics-like">habitántibus Jerúsalem, ita ut ap¬</l><l xml:id="m-d45024a6-8c6f-42e7-8e0a-13cb24a42a03" facs="#m-6e0c5ad6-05f6-4735-950f-64329f64696d" label="lyrics-like">stolátus, de quo praevaricátus est</l><l xml:id="m-1bb8ca40-1fb3-48b1-9509-830caea260ae" facs="#m-b08732ba-4983-42dc-9b60-54c4c02feaaa" label="lyrics-like">pellarétur agẽr ille, lingua eórum,</l><l xml:id="m-f7a27590-6341-4cd9-a8aa-5d6d4e9ca3d6" facs="#m-ac4a475e-44f0-44da-82ba-f96fc771920f" label="lyrics-like">Judas, ut abíret in locum suum. Et</l><l xml:id="m-95cd76bf-2d0a-4bb0-bea5-35a8fd58a6f7" facs="#m-d786cbcb-01f0-4b68-8cc0-bf11a28903fa" label="lyrics-like">Hacéldama, hoc est, ager sángui¬</l><l xml:id="m-1cfda919-b124-4d50-a37e-83f1deb49d45" facs="#m-379c4d4c-455a-4a2e-837d-7d0139a3a25d" label="lyrics-like">dedérunt sortes eis; et cécidit sors</l><l xml:id="m-2ea52be8-3ee8-40b6-8361-26ce9c12553f" facs="#m-38107e67-2134-483c-903d-bb3d22017c63" label="ambiguous">nis. Scriptum est enim in libro Psal¬</l><l xml:id="m-25d0dfe3-ba22-434d-bdc8-466f35e106e9" facs="#m-61492096-7227-4505-a106-0e4234571e1e" label="lyrics-like">super Matthiam, et annumerátus est</l><l xml:id="m-32900cad-1b3a-4107-9cdb-21a2303f36e9" facs="#m-731c6bca-f6a7-449a-8d0d-48a794cd7e1a" label="lyrics-like">mórum: Fiat commorátio eórum</l><l xml:id="m-2e7b2b39-c1c9-43a9-975e-648337aacdf6" facs="#m-7235214e-98af-41b3-896f-ca9a906428cc" label="lyrics-like">desérta, et non sit qui inhábitet in cum úndecim Apóstolis.</l><l xml:id="m-b40e6549-49c7-4289-ae8c-c9c41e38a9a3" facs="#m-89ef1bc1-959d-4f7f-9741-363326602a14" label="lyrics-like">Gradual. Nimis honoráti sunt. p. 1326. — Tract. Desidérium. p. 1131.</l><l xml:id="m-166ff0c5-eea8-479d-98c1-e2a9e5552c7b" facs="#m-db84d626-2eba-4cef-bffe-4f48166e31d1" label="ambiguous">† Sequentia sancti Evangelii secundum Matthaeum.</l><l xml:id="m-89db5bcd-c697-43c3-a088-6d8f05b00227" facs="#m-7b452bbf-b880-4253-a070-0daf2c8f0879" label="ambiguous">Matth. 11. d.</l><l xml:id="m-ba95ecae-b0d7-418c-a871-b242e472fd05" facs="#m-2ef6371b-9fa9-4329-990d-00d3cb8bfcfb" label="lyrics-like">TN illo témpore: Respóndens Je-( nisi Filius, et cui volúerit Filius re¬</l><l xml:id="m-6552be5e-68e4-4c0c-b494-382f270b8a00" facs="#m-cd6c5db4-aab9-4771-81fd-993a71e54d34" label="lyrics-like">veláre. Venite ad me omnes, qui</l><l xml:id="m-a95c3144-f50e-4a24-be37-e209c44575fd" facs="#m-5e468389-f7ca-4ae7-a7d8-c2522a9157d9" label="ambiguous">L sus, dixit: Confiteor tibi, Pater,</l><l xml:id="m-69e8064c-9f53-4dc8-bced-5df9e24e25fc" facs="#m-9f2d52ea-53b4-4f3f-8abc-fd1e7e9997dc" label="lyrics-like">laborátis, et oneráti estis, et ego</l><l xml:id="m-58ed8362-0ae3-4e7f-8d41-29fe2eda7b52" facs="#m-df6e34fd-238f-464d-8e3e-5fcb7db1e414" label="lyrics-like">Dómine caeli et terrae, quia abscon¬</l><l xml:id="m-ddfe92ca-89bc-4982-b6cd-93ff5ef863fd" facs="#m-ebd7cdd6-fa0b-460d-aa2e-428bfe991ffa" label="lyrics-like">disti haec a sapiéntibus et prudén¬</l><l xml:id="m-70147373-4a7b-44de-aa2a-40cc43b810a7" facs="#m-aab907f8-fc62-4055-a038-64d99b24d5a8" label="lyrics-like">reficiam vos. Tóllite jugum meum</l><l xml:id="m-95829169-e382-4763-ab62-a2e2edadaa6c" facs="#m-7b3f899d-faec-40b1-9271-222e40b322fb" label="lyrics-like">super vos, et díscite a me, quia mitis</l><l xml:id="m-939779d4-901c-494e-83d1-24a4bd6f2429" facs="#m-ffd3618f-bbac-47ac-91f8-4ce6b0ee924f" label="lyrics-like">tibus, et revelásti ea párvulis. Ita</l><l xml:id="m-33ccd3b5-0a76-47e3-9832-ed24394c5a6c" facs="#m-0fb3b9c9-ab62-458e-99fc-281500055cf4" label="lyrics-like">sum, et húmilis corde: et inveniétis</l><l xml:id="m-ce5c90b9-cfad-45ac-8121-504901a143f8" facs="#m-4cf799fc-cfb5-4aa6-82cf-056c47f519ee" label="lyrics-like">Pater: quóniam sic fuit plácitum</l><l xml:id="m-dc78a24a-e284-4df2-b153-55e4288fbd20" facs="#m-357d0956-37f4-4c80-b077-f7a0e63efe60" label="lyrics-like">réquiem animábus vestris. Jugum</l><l xml:id="m-3d1ea2ce-3fe4-4856-a5d1-73c51982ce53" facs="#m-a6d0672a-5192-461e-8d5f-4239b27df8a7" label="lyrics-like">ante te. Omnia mihi trádita sunt a</l><l xml:id="m-4fb8246e-3c69-422e-91a2-f7fbe4c9f898" facs="#m-b94ad64c-cf2e-44d8-899d-9600092e50c8" label="lyrics-like">enim meum suáve est, et onus</l><l xml:id="m-8fcc4893-3d8f-45a6-8ef5-5e73511cdc0a" facs="#m-04fb776c-e50a-4106-937f-b5da33dfed46" label="ambiguous">Patre meo. Et nemo novit Filium,</l><l xml:id="m-5226cb28-090a-45a8-b47d-8bd44e83a600" facs="#m-aec5747e-68ca-4125-a15b-2ea5788e5939" label="ambiguous">Credo.</l><l xml:id="m-24bbefd9-e480-4f29-8041-6a4099e921ae" facs="#m-766b43d1-f27f-4ac0-8b9a-49d6a5af9cfc" label="ambiguous">nisi Pater; neque Patrem quis novit,l meum leve.</l></lg></div></section></score></mdiv></body></music>
</mei>