8" /><zone xml:id="m-793120c6-0d6b-4c57-aa41-f5f64145dc19" ulx="434" uly="658" lrx="542" lry="690" /><zone xml:id="m-c798515a-d556-4fec-8f2f-1d74465be28f" ulx="89" uly="687" lrx="928" lry="725" /><zone xml:id="m-29ad74e0-b575-46ef-a130-044a6751c512" ulx="48" uly="717" lrx="928" lry="757" /><zone xml:id="m-9cdc7949-d2b1-4189-ad5d-085eb64a1401" ulx="47" uly="749" lrx="927" lry="782" /><zone xml:id="m-3f9d0b6e-1cf1-4b15-a9b4-4ff9569f6c3a" ulx="46" uly="773" lrx="927" lry="811" /><zone xml:id="m-17fe3af2-b403-4553-a007-e081ead81313" ulx="48" uly="801" lrx="723" lry="836" /><zone xml:id="m-63c2bef2-9d6f-45b3-833d-05bac25c8396" ulx="47" uly="872" lrx="926" lry="918" /><zone xml:id="m-58c0e3f9-8421-4d6f-9249-e947a400946c" ulx="73" uly="920" lrx="925" lry="965" /><zone xml:id="m-375c176c-881b-4b56-aa6f-55365f652bc0" ulx="74" uly="959" lrx="648" lry="1002" /><zone xml:id="m-e8096ac8-adf4-46b1-b917-a248fbc0573a" ulx="435" uly="1000" lrx="548" lry="1035" /><zone xml:id="m-6adc18d8-f7eb-4544-8991-c0de6ea3676d" ulx="90" uly="1033" lrx="929" lry="1081" /><zone xml:id="m-27b8a7a6-a805-47dc-aa44-06650dff3875" ulx="493" uly="1065" lrx="928" lry="1098" /><zone xml:id="m-2d74b6e4-36f4-4a2c-b014-edc532e1c25d" ulx="52" uly="1066" lrx="485" lry="1109" /><zone xml:id="m-3a5e72ab-f3ea-4f73-ac0b-cb8462e17ad2" ulx="497" uly="1094" lrx="634" lry="1131" /><zone xml:id="m-6ac8f3ea-68be-4dd1-8c10-c1b9f8caa46f" ulx="51" uly="1095" lrx="486" lry="1133" /><zone xml:id="m-9c941081-4f33-494c-b51c-a16b4c4a1913" ulx="50" uly="1124" lrx="487" lry="1165" /><zone xml:id="m-2c7c7c56-5856-4872-a244-def3dd7e3cae" ulx="229" uly="1158" lrx="748" lry="1203" /><zone xml:id="m-75d0b939-5652-4654-9edf-56489b2f5d31" ulx="68" uly="1191" lrx="930" lry="1237" /><zone xml:id="m-c41cd078-027c-4234-8eb2-e212d2bf37b4" ulx="46" uly="1226" lrx="926" lry="1268" /><zone xml:id="m-59e5a334-d966-4e8a-a5f1-62452c9e3861" ulx="48" uly="1258" lrx="486" lry="1293" /><zone xml:id="m-069d4879-156d-446a-817f-85396aa108d5" ulx="488" uly="1262" lrx="926" lry="1291" /><zone xml:id="m-96158200-28cb-4a82-81dc-79f15b25b613" ulx="47" uly="1283" lrx="483" lry="1318" /><zone xml:id="m-d80219b3-3f7b-4176-8c1f-23d67f9c338a" ulx="492" uly="1283" lrx="926" lry="1316" /><zone xml:id="m-a9bb6f13-0f2c-4cd2-a660-2a0fe7e4b8eb" ulx="47" uly="1310" lrx="483" lry="1349" /><zone xml:id="m-6e41d498-fffa-418a-99af-3d9b4352fa22" ulx="493" uly="1314" lrx="928" lry="1346" /><zone xml:id="m-0a23edde-afce-4c2e-9bfa-9c90ff31c770" ulx="492" uly="1338" lrx="925" lry="1371" /><zone xml:id="m-2f73c057-7fe1-45c2-9fb2-1b882bd1c9ba" ulx="47" uly="1339" lrx="484" lry="1371" /><zone xml:id="m-391c9805-3cb7-4031-8912-ee6633ee4562" ulx="493" uly="1363" lrx="927" lry="1398" /><zone xml:id="m-30254ccf-164a-4c3c-adb7-eb8e80585942" ulx="47" uly="1365" lrx="483" lry="1404" /><zone xml:id="m-22dd9e60-4bf0-4c5f-9537-057a2edeedc2" ulx="491" uly="1392" lrx="928" lry="1429" /><zone xml:id="m-a6b52ba1-9b85-4672-bb2b-a6394205b6dd" ulx="48" uly="1394" lrx="484" lry="1428" /><zone xml:id="m-997aa08c-657c-4b85-9457-5ad4bd8d16da" ulx="48" uly="1418" lrx="484" lry="1459" /><zone xml:id="m-b7629052-87b3-403d-a5de-e0f565662e6c" ulx="490" uly="1418" lrx="927" lry="1452" /><zone xml:id="m-fc98aa1c-fd44-4dd0-98a4-db7e138c79a4" ulx="48" uly="1446" lrx="484" lry="1484" /><zone xml:id="m-fcb1e236-c806-4474-9936-b19ec664ab0e" ulx="489" uly="1447" lrx="926" lry="1483" /><zone xml:id="m-bd46857c-bb4e-422f-aa68-aa3076bbee38" ulx="48" uly="1473" lrx="731" lry="1516" /><zone xml:id="m-dc29ad8b-722b-4589-88b3-f303a90f5e0e" ulx="78" uly="1512" lrx="296" lry="1548" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-c6d85728-f835-41c4-8c75-f0e062ab2d71" n="1839" facs="#m-68b38ddd-d637-461a-bbea-0a3a5a3b9e82" /><div xml:id="m-d18856ba-e1a3-45c2-8b9a-e238dcb074e5">
            <lg xml:id="m-e1effd65-6317-4d1e-a414-ae4dd102e93e">
              <l xml:id="m-afba4cf8-ecbc-4f98-9689-82e88347392d" facs="#m-cbca4f81-1747-453c-86f7-bfa6e748da06" label="ambiguous">August 18. 19.20</l><l xml:id="m-fb1196f2-d251-4027-b0c3-bde953dbb0cc" facs="#m-5d0c1bb7-69f9-4017-860f-bcbea57fee67" label="ambiguous">ien</l><l xml:id="m-4fba5cc2-c318-4b3a-ad71-26744988bf02" facs="#m-cc85e251-915d-449f-8ebb-cd1ddfab64e7" label="ambiguous">St. Agapitus, Martyr.</l><l xml:id="m-99487018-d19b-4e56-a561-a813ef925905" facs="#m-0cbcc22c-9b72-4a0f-99c6-ac99015e307a" label="ambiguous">18.</l><l xml:id="m-2b383b7c-8e4f-48ca-92da-e0f64289238b" facs="#m-d6cca39d-a897-42d6-8e5d-0366f2f557d7" label="ambiguous">Simple.</l><l xml:id="m-0d2971b4-e6c5-461c-bcbc-dbc015322055" facs="#m-475eec07-2165-4c57-8e49-768274e547d7" label="ambiguous">Collect.</l><l xml:id="m-bb8f4f8c-b382-44d2-bd16-ecbc8f16bab8" facs="#m-6d8c1fce-2ea6-4eca-9b30-f19e4536b2f1" label="lyrics-like">Aetétur Ecclésia tua, Deus, beáti  gloriósis et devóta permáneat, et</l><l xml:id="m-83c30303-f117-44d4-b5fb-aed93f6b7733" facs="#m-3032aa9f-e332-4bed-b3c8-fc5e4652d43f" label="lyrics-like">L Agapiti Martyris tui confisa secúra consistat. Per Dominum</l><l xml:id="m-cf72e711-93de-414e-8fb6-5d15fe73000a" facs="#m-14a9bc79-ddb8-403e-9e21-0cc7b06cb1ed" label="lyrics-like">suffrágiis: * atque ejus précibus! nostrum.</l><l xml:id="m-ffad462b-db48-4b10-98f8-8f11f9265f98" facs="#m-ba9eb5e6-78b5-4681-9d8c-b748260791a3" label="ambiguous">Secret.</l><l xml:id="m-7ae5d73e-2894-480e-b355-459813239aa1" facs="#m-0bc7fef8-9452-4623-afea-2d2a3aa36779" label="lyrics-like">Uscipe, Dómine, múnera, quae mus, cujus nos confídimus patrocí¬</l><l xml:id="m-97bf8b52-4b6a-44ca-ba9b-16c7f61eae84" facs="#m-c2fdb8bd-83e1-4946-a5e5-76217e698c2c" label="lyrics-like">O in ejus tibi solemnitáte deféri-] nio liberári. Per Dóminum.</l><l xml:id="m-6adcc389-d530-4042-8141-2789114d89bf" facs="#m-507c9fc2-5398-4115-98ee-33cca0b1b7ca" label="ambiguous">Postcommunion.</l><l xml:id="m-3d0dbced-0ea7-4083-942a-048420f1588a" facs="#m-f628aae1-10a2-4c25-9a00-0749d7f6a4c1" label="lyrics-like">NAtiásti, Dómine, familiam tuam ! fove, cujus solémnia celebrámus.</l><l xml:id="m-86beffb7-811e-42a9-9df9-56905d28197f" facs="#m-85771b80-efcc-4869-882b-3ab8c9e0b827" label="lyrics-like">O munéribus sacris : ejus quaésu-Per Dóminum.</l><l xml:id="m-ff2c8a33-84d9-4268-b28d-9faeb463d503" facs="#m-64c2bc10-d2b3-4203-861d-8f576379da39" label="lyrics-like">mus semper interventióne nos ré¬</l><l xml:id="m-fa947714-daab-48d2-b5c9-dbc8e8387d8e" facs="#m-3fab90d6-945a-45c6-90e5-4752d7805797" label="ambiguous">St. John Eudes, Confessor.</l><l xml:id="m-0418576d-6c67-42ee-a7de-aaab693b98bd" facs="#m-fec8b421-cc39-459c-9925-298397056de0" label="ambiguous">19.</l><l xml:id="m-0c732fd5-8606-459d-b222-d4d5f2ce5fa1" facs="#m-0f61a300-2f83-476d-a1f3-a8269b2675b9" label="ambiguous">Double.</l><l xml:id="m-69234c16-8a1e-4caa-82c0-95e174724592" facs="#m-ca3c2ca6-3cc5-406d-9858-21b2c6adb9d4" label="lyrics-like">Mass. Os jústi. p. 1200.</l><l xml:id="m-1d169f21-7d8c-4ce1-9f1e-48d1639bb72f" facs="#m-793120c6-0d6b-4c57-aa41-f5f64145dc19" label="ambiguous">Collect.</l><l xml:id="m-e1928c9c-831f-4548-b8d1-01f81f5841a4" facs="#m-c798515a-d556-4fec-8f2f-1d74465be28f" label="lyrics-like">Eus, qui beátum Joánnem Con- Ecclésia tua familias congregáre</l><l xml:id="m-87cb41d6-8f26-44df-8f45-4792dd00f09d" facs="#m-29ad74e0-b575-46ef-a130-044a6751c512" label="lyrics-like">I fessórem tuum, ad cultum sa- voluisti : t praesta quaésumus; ut</l><l xml:id="m-46bddf28-5ec6-4011-8d31-df5ebb431dc1" facs="#m-9cdc7949-d2b1-4189-ad5d-085eb64a1401" label="lyrics-like">crórum Córdium Jesu et Maríae! cujus pia mérita venerámur. * vir¬</l><l xml:id="m-b10d430d-02da-437d-83e3-1317d53075a4" facs="#m-3f9d0b6e-1cf1-4b15-a9b4-4ff9569f6c3a" label="lyrics-like">rite promovéndum, mirabiliter in-l tútum quoque instruámur exém¬</l><l xml:id="m-a1ede57e-d2ec-4083-89f0-e41702762a61" facs="#m-17fe3af2-b403-4553-a007-e081ead81313" label="lyrics-like">flammásti, et per eum novas in! plis. Per eúmdem.</l><l xml:id="m-e3b5c007-7e1e-4c5f-be8e-2d97895b6e8d" facs="#m-63c2bef2-9d6f-45b3-833d-05bac25c8396" label="text-like">20. St. Bernard, Abbot and Doctor of the Church. Double.</l><l xml:id="m-4cac1210-4a5e-4b19-b9ca-4b3efb1f179d" facs="#m-58c0e3f9-8421-4d6f-9249-e947a400946c" label="lyrics-like">At ist and and Vespers, at Magn. Ant. O Dóctor... beâte Bernárde. p. 262s.</l><l xml:id="m-7a2ee3c3-7ffd-41e7-8cda-d5cdfc4094e9" facs="#m-375c176c-881b-4b56-aa6f-55365f652bc0" label="lyrics-like">Mass. In médio. p. 1190, except the following:</l><l xml:id="m-c2bc771a-41e6-4254-8707-5aafff5944ed" facs="#m-e8096ac8-adf4-46b1-b917-a248fbc0573a" label="ambiguous">Collect.</l><l xml:id="m-3f0a4fe4-d177-41f5-abfe-cbee6dee10d4" facs="#m-6adc18d8-f7eb-4544-8991-c0de6ea3676d" label="lyrics-like">Eus, qui pópulo tuo aetérnae habúimus in terris,intercessórem</l><l xml:id="m-17a96da6-0962-4d9e-ad8d-108a8591af1c" facs="#m-27b8a7a6-a805-47dc-aa44-06650dff3875" label="lyrics-like">habére mereámur in caelis. Per</l><l xml:id="m-5a8219c2-09b9-40b8-94e8-6c8a17449067" facs="#m-2d74b6e4-36f4-4a2c-b014-edc532e1c25d" label="lyrics-like">I salútis beãtum Bernárdum mi¬</l><l xml:id="m-37b960dd-f8b6-44b3-994c-f8a0f6f75ff7" facs="#m-3a5e72ab-f3ea-4f73-ac0b-cb8462e17ad2" label="lyrics-like">Dóminum.</l><l xml:id="m-e35759b8-3320-4bb2-9cae-4584da6bfca4" facs="#m-6ac8f3ea-68be-4dd1-8c10-c1b9f8caa46f" label="lyrics-like">nistrum tribuisti : t praesta, quaé¬</l><l xml:id="m-133c63ce-9058-4db4-bb9f-3f0d5e7cd594" facs="#m-9c941081-4f33-494c-b51c-a16b4c4a1913" label="lyrics-like">sumus; ut quem Doctórem vitae</l><l xml:id="m-4c982d99-7041-43bf-ae29-39d69fc641ce" facs="#m-2c7c7c56-5856-4872-a244-def3dd7e3cae" label="ambiguous">Lectio libri Sapientiae. Eccli. 39</l><l xml:id="m-f566df40-add7-458d-ab9b-f13276ead862" facs="#m-75d0b939-5652-4654-9edf-56489b2f5d31" label="ambiguous">TUstus cor suum tradet ad vigi-[et disciplinam, et in absconditis suis</l><l xml:id="m-58eb045d-d74c-4b88-a73a-766a85da327f" facs="#m-c41cd078-027c-4234-8eb2-e212d2bf37b4" label="lyrics-like">A landum ditúculo ad Dóminum (consiliábitur. Ipse palam fáciet di¬</l><l xml:id="m-ddc68002-833c-4e06-a3e3-fc948bd900d5" facs="#m-59e5a334-d966-4e8a-a5f1-62452c9e3861" label="lyrics-like">qui fecit illum, et in conspéctu</l><l xml:id="m-e74a5830-bf2b-4700-a3ee-aa44f5b8fb5c" facs="#m-069d4879-156d-446a-817f-85396aa108d5" label="lyrics-like">sciplínam doctrinae suae, et in lege</l><l xml:id="m-11d1222b-853b-4f0a-b0a2-edadc7def619" facs="#m-96158200-28cb-4a82-81dc-79f15b25b613" label="lyrics-like">Altíssimi deprecábitur. Apériet os</l><l xml:id="m-c4c435bb-7be8-43e8-a490-d272d0298fcb" facs="#m-d80219b3-3f7b-4176-8c1f-23d67f9c338a" label="lyrics-like">testaménti Dómini gloriábitur. Col¬</l><l xml:id="m-6827330d-12f6-4d3b-b477-bf7853e0d60e" facs="#m-a9bb6f13-0f2c-4cd2-a660-2a0fe7e4b8eb" label="lyrics-like">suum in oratióne, et pro delictis</l><l xml:id="m-bb2a5a83-5401-4428-aa04-7f1a30a7f58d" facs="#m-6e41d498-fffa-418a-99af-3d9b4352fa22" label="lyrics-like">laudábunt multi sapiéntiam ejus, et</l><l xml:id="m-eb9db216-d93c-4b10-ab33-092cd6abcec4" facs="#m-0a23edde-afce-4c2e-9bfa-9c90ff31c770" label="lyrics-like">usque in saéculum non delébitur.</l><l xml:id="m-54374df8-4707-422f-ae15-bb575afc7090" facs="#m-2f73c057-7fe1-45c2-9fb2-1b882bd1c9ba" label="lyrics-like">suis deprecábitur. Si enim Dóminus</l><l xml:id="m-c0a54a61-6288-4af6-8d36-1f2f622e1086" facs="#m-391c9805-3cb7-4031-8912-ee6633ee4562" label="lyrics-like">Non recédet memória ejus, et no¬</l><l xml:id="m-b0f5a13c-265b-4b6c-9629-3d7690028ba2" facs="#m-30254ccf-164a-4c3c-adb7-eb8e80585942" label="lyrics-like">magnus volúerit, spiritu intelligén¬</l><l xml:id="m-a1917cb3-2ed9-4c62-8962-2acb1787193e" facs="#m-22dd9e60-4bf0-4c5f-9537-057a2edeedc2" label="lyrics-like">men ejus requirétur a generatióne</l><l xml:id="m-b45af0b7-9885-4fe6-a43c-3792ec061daa" facs="#m-a6b52ba1-9b85-4672-bb2b-a6394205b6dd" label="lyrics-like">tiae replébit illum :et ipse tamquam</l><l xml:id="m-6e11f497-2616-4319-b44b-fc3fc5b80456" facs="#m-997aa08c-657c-4b85-9457-5ad4bd8d16da" label="lyrics-like">imbres mittet elóquia sapiéntiae</l><l xml:id="m-58436397-72f6-44cb-a7d7-b65432ca2a15" facs="#m-b7629052-87b3-403d-a5de-e0f565662e6c" label="lyrics-like">in generatiónem. Sapiéntiam ejus</l><l xml:id="m-bbf12b0a-3151-4783-b640-a6e5bb88b961" facs="#m-fc98aa1c-fd44-4dd0-98a4-db7e138c79a4" label="lyrics-like">suae, et in oratióne confitébibur Dó¬</l><l xml:id="m-fb973dc4-365a-4362-b55c-1405684d430b" facs="#m-fcb1e236-c806-4474-9936-b19ec664ab0e" label="lyrics-like">enarrábunt gentes, et laudem ejus</l><l xml:id="m-42fecc11-8de3-4287-9a39-8e2287416ab9" facs="#m-bd46857c-bb4e-422f-aa68-aa3076bbee38" label="lyrics-like">mino: et ipse diriget consilium ejus! enuntiábit ecclésia.</l><l xml:id="m-285d0148-1cc9-47db-bd68-095eef8e02c7" facs="#m-dc29ad8b-722b-4589-88b3-f303a90f5e0e" label="text-like">The Credo is said.</l></lg></div></section></score></mdiv></body></music>
</mei>