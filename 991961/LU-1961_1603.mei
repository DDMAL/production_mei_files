" /><zone xml:id="m-d45c82b8-0c9c-48f5-b084-471c11edd931" ulx="28" uly="841" lrx="84" lry="889" /><zone xml:id="m-1852f9c2-44ce-4d6d-bca9-790f456fa27d" ulx="190" uly="889" lrx="775" lry="931" /><zone xml:id="m-4dad1b39-36f6-4e28-bec3-07affaae4075" ulx="811" uly="889" lrx="920" lry="929" /><zone xml:id="m-79d46c70-3307-4548-9066-471febbfa4d5" ulx="52" uly="944" lrx="919" lry="989" /><zone xml:id="m-35bfad8e-a401-4b95-b46c-3a6956a9f52c" ulx="24" uly="979" lrx="120" lry="1021" /><zone xml:id="m-1338ca65-82a1-4466-bd47-e657de7f76a0" ulx="52" uly="1017" lrx="921" lry="1060" /><zone xml:id="m-00dff29e-9599-4832-9ac2-525be90da80f" ulx="25" uly="1051" lrx="152" lry="1090" /><zone xml:id="m-b9dfcba8-942f-4e2d-adb7-6886da1c6e03" ulx="417" uly="1070" lrx="531" lry="1106" /><zone xml:id="m-ce48eff9-5208-4f52-8f48-f786e3972d05" ulx="63" uly="1108" lrx="922" lry="1156" /><zone xml:id="m-ce880860-e22c-4c6d-9cc0-ccebc49ac543" ulx="30" uly="1138" lrx="921" lry="1182" /><zone xml:id="m-0e47202d-c9ce-479c-83a8-52d9b2c16986" ulx="26" uly="1169" lrx="920" lry="1211" /><zone xml:id="m-1ba93f33-9ee7-4fdb-9d52-fb64dd89b354" ulx="25" uly="1194" lrx="682" lry="1235" /><zone xml:id="m-1930bc7d-1693-4847-9748-cfe8c21bd180" ulx="244" uly="1244" lrx="697" lry="1287" /><zone xml:id="m-41c61ca2-ed98-455f-a934-6424975c5b6b" ulx="46" uly="1289" lrx="916" lry="1327" /><zone xml:id="m-689eec99-bb7f-4165-9d39-0af086e6af10" ulx="21" uly="1322" lrx="917" lry="1356" /><zone xml:id="m-d3acba07-ea73-48e7-bf6f-cd7c011dbc60" ulx="24" uly="1347" lrx="914" lry="1380" /><zone xml:id="m-c025136f-b140-4061-b7f3-93fbe90cd2da" ulx="21" uly="1373" lrx="465" lry="1411" /><zone xml:id="m-6bde0ef9-4523-45c0-ac96-979afe1ee59c" ulx="473" uly="1373" lrx="917" lry="1412" /><zone xml:id="m-9773d94c-fdb8-4039-947d-4111b83d88e8" ulx="21" uly="1403" lrx="466" lry="1439" /><zone xml:id="m-62508590-a585-4826-933f-da3e5c56f6ba" ulx="471" uly="1406" lrx="918" lry="1435" /><zone xml:id="m-60b6bedf-eb34-43a3-931d-8d62f91080cd" ulx="21" uly="1428" lrx="465" lry="1468" /><zone xml:id="m-d3508691-adb0-478f-8867-0a9da2b29aae" ulx="473" uly="1430" lrx="915" lry="1467" /><zone xml:id="m-c9fbf3c5-9458-4ed4-8bff-de9365a1eef3" ulx="474" uly="1457" lrx="917" lry="1492" /><zone xml:id="m-20b9eb2a-bf1a-4cfe-b12d-73b40d7f4fbb" ulx="22" uly="1458" lrx="464" lry="1495" /><zone xml:id="m-3f05c606-f40a-4ccd-9a95-5161b3ced0b5" ulx="22" uly="1486" lrx="467" lry="1524" /><zone xml:id="m-3ecb6d33-2992-4128-8703-cd335a69caee" ulx="473" uly="1489" lrx="918" lry="1519" /><zone xml:id="m-b738b7a0-0949-477d-9440-21fcc28667f6" ulx="22" uly="1513" lrx="465" lry="1549" /><zone xml:id="m-9662ca9d-e196-40af-b302-898bcdabf8da" ulx="474" uly="1513" lrx="918" lry="1550" /><zone xml:id="m-64fcdd3f-7981-4042-847d-de7d55be1ae8" ulx="22" uly="1539" lrx="465" lry="1580" /><zone xml:id="m-32acef84-6e31-45fe-b473-b9a4f268621a" ulx="470" uly="1543" lrx="915" lry="1581" /><zone xml:id="m-67c85093-3cbf-44ab-b9db-5d6d3df69748" ulx="22" uly="1567" lrx="719" lry="1607" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-a672b4df-b107-4989-9406-46011f752328" n="1603" facs="#m-52d903ca-6f32-40c4-9c10-e43e005e6e99" /><div xml:id="m-b5908eeb-6a65-4609-9227-bf4fb29e37d6">
            <lg xml:id="m-19fe7408-3a54-4139-b425-5750f6fe51f7">
              <l xml:id="m-e76a1558-b5c1-44da-b6e3-492ec290f950" facs="#m-c0894c6f-836d-4dc0-a53d-3c5f1ebb45d2" label="ambiguous">March 17. 18.</l><l xml:id="m-2b85639c-ae99-4a45-9e33-a7ae3f0f0353" facs="#m-54875c4f-3d36-40a4-b7eb-15d818294e18" label="ambiguous">1390</l><l xml:id="m-7c950a3a-1450-4984-a244-989f3f194ad8" facs="#m-0142ab41-8dbf-4610-842c-b281faa29c53" label="ambiguous">Secret.</l><l xml:id="m-cc935cda-d743-46d5-9885-0e2280954822" facs="#m-63441174-3a8d-4c30-aeea-a4423221b809" label="lyrics-like">HNnue nobis, quaésumus Dó- quam immolándo, totius mundi tri¬</l><l xml:id="m-9f82284c-964f-4ca6-8800-633cac61a4ed" facs="#m-f0da2c65-9f13-4c01-8edd-fd57185f304d" label="lyrics-like">A mine: ut intercessióne beáti buisti relaxári delicta. Per Dómi¬</l><l xml:id="m-33efcf05-1b34-4dfd-b199-51112cf7a9d6" facs="#m-6d9e1f58-7f91-4d94-a67b-c5358c0443ec" label="lyrics-like">Gregórii haec nobis prosit oblátio, (num nostrum.</l><l xml:id="m-3b3af167-45d6-48e7-8d2c-e57a0492a59c" facs="#m-0b31cb09-8e9c-4f1e-af86-e16fd2b983dd" label="ambiguous">Postcommunion.</l><l xml:id="m-4d5f5c3d-6e3e-4e1b-8b2a-db7a1df9f3fe" facs="#m-15c79f0d-925e-4efa-b9ab-c8e2f2684d78" label="lyrics-like">Eus, qui beátum Gregórium [ tius; ut, qui commemoratiónis ejus</l><l xml:id="m-605389fb-e50c-427f-885c-885fd851f97b" facs="#m-0efb28fd-0cc4-46ec-a6ed-ba957bbb2bf8" label="lyrics-like">U Pontificem sanctórum tuórum! festa percólimus, vitae quoque imi¬</l><l xml:id="m-e811148c-c069-4c62-9812-37818ba8ff49" facs="#m-d8084c66-cfa2-487f-bec6-3d7713659c2f" label="lyrics-like">méritis coaequásti : concéde propi-l témur exémpla. Per Dóminum.</l><l xml:id="m-cacdbb04-9eca-411f-8ad6-ba0fcfdbf8d0" facs="#m-f3ce6a66-1a58-4a04-b985-4574f8e36d20" label="ambiguous">17.</l><l xml:id="m-61de9117-a2a9-4289-9b04-de6076beca9d" facs="#m-4f5992e0-a43d-49bc-a98c-d07c3de7e1bc" label="text-like">St. Patrick, Bishop and Confessor.</l><l xml:id="m-2def30b7-da08-4d02-883f-e06b902cbd2e" facs="#m-76ec0764-bddb-474e-a2c6-547027cd206a" label="ambiguous">Double.</l><l xml:id="m-933b05ce-10d4-4a93-8935-9bfe14be6173" facs="#m-e84e1376-815a-4f4b-aefc-d5c2add4f909" label="lyrics-like">Mass. Státuit. from the Common of a Confessor Bishop, p. 1182.</l><l xml:id="m-982c4029-4779-481b-86a6-62290c401907" facs="#m-41f1698a-0b7a-41b2-8314-01a6c4195490" label="ambiguous">Collect.</l><l xml:id="m-055bbb50-3583-4a9a-ad93-fb170f314f30" facs="#m-462a1d30-9de1-4988-9d33-de7fbfbd2386" label="lyrics-like">Eus, qui ad praedicándam gén- méritis et intercessiône concéde; ut</l><l xml:id="m-eb1e20d0-4f8c-4144-b1c0-cf6afcdc1fa6" facs="#m-e8dc6714-5da5-4bd0-88c7-bf9dbe2f4939" label="lyrics-like">tibus glóriam tuam, beâtum! quae nobis agénda praécipis, * te</l><l xml:id="m-02788e57-9749-4525-bbe6-c05973914e7c" facs="#m-87854908-0b04-417e-aa15-9578a405e5c9" label="lyrics-like">Patrícium Confessórem atque Pon-] miseránte adimplère possímus. Per</l><l xml:id="m-73055439-3718-46ce-acb3-e66cfb6a94f7" facs="#m-796c4863-85ed-4f85-88e7-ae20977ee1b5" label="lyrics-like">tificem mittere dignátus es: t ejus! Dóminum.</l><l xml:id="m-117cccd6-56c9-457a-b064-15d010f3a517" facs="#m-a2442b4d-8f6f-42dd-8f9e-39a13ec02ce5" label="text-like">St. Cyril, Bishop of Jerusalem</l><l xml:id="m-327bcaf8-2879-4141-b10a-ef50e372859e" facs="#m-d45c82b8-0c9c-48f5-b084-471c11edd931" label="ambiguous">18.</l><l xml:id="m-bf3cb354-6857-4f2e-86e8-8521dcf0d45e" facs="#m-1852f9c2-44ce-4d6d-bca9-790f456fa27d" label="text-like">Confessor and Doctor of the Church.</l><l xml:id="m-ad0f0d0f-400e-49ab-857e-51e08ad065a1" facs="#m-4dad1b39-36f6-4e28-bec3-07affaae4075" label="ambiguous">Double.</l><l xml:id="m-d738a9b6-5ca1-4f5b-b576-8d374e532d7d" facs="#m-79d46c70-3307-4548-9066-471febbfa4d5" label="lyrics-like">At Ist and 2nd Vespers, at Magn. Ant. O Dóctor... beâte Cyrille.</l><l xml:id="m-2bc87caf-cabb-4c67-b76d-058c2034243f" facs="#m-35bfad8e-a401-4b95-b46c-3a6956a9f52c" label="ambiguous">262.</l><l xml:id="m-44d08976-dad4-4e74-bc9c-92d384e61a87" facs="#m-1338ca65-82a1-4466-bd47-e657de7f76a0" label="lyrics-like">Mass. In médio. from the Common of Doctors, p. 1190, except the</l><l xml:id="m-44276993-8b5c-44b5-bae6-6f0360143f05" facs="#m-00dff29e-9599-4832-9ac2-525be90da80f" label="ambiguous">foltowing.</l><l xml:id="m-d0696dc1-5f8a-4c31-a245-7b30519ac8e7" facs="#m-b9dfcba8-942f-4e2d-adb7-6886da1c6e03" label="ambiguous">Collect.</l><l xml:id="m-33450564-c3b4-4220-b3ce-efd3281504db" facs="#m-ce48eff9-5208-4f52-8f48-f786e3972d05" label="lyrics-like">Anobis, quaésumus, omnípotens! cognóscere; t ut inter oves quae</l><l xml:id="m-3a282445-fd26-485f-bc94-07b13b3c6cbe" facs="#m-ce880860-e22c-4c6d-9cc0-ccebc49ac543" label="lyrics-like">U Deus, beáto Cyrilo Pontifice vocem ejus áudiunt,*perpétuo</l><l xml:id="m-248b4b36-39fd-4743-8283-d9a57bdfce23" facs="#m-0e47202d-c9ce-479c-83a8-52d9b2c16986" label="lyrics-like">intercedénte: te solum verum Deum, ] connumerári mereámur. Per eúm¬</l><l xml:id="m-8b8c95dd-cc0c-4250-8e55-0c6d18f82ef6" facs="#m-1ba93f33-9ee7-4fdb-9d52-fb64dd89b354" label="lyrics-like">et quem misisti Jesum Christum ita! dem Dóminum.</l><l xml:id="m-512c5f00-6822-4969-9d7d-d256cdcbd968" facs="#m-1930bc7d-1693-4847-9748-cfe8c21bd180" label="ambiguous">Lectio libri Sapientiae. Aecli o</l><l xml:id="m-e78d2c1b-ad53-4f44-81c7-93bc1421a7fe" facs="#m-41c61ca2-ed98-455f-a934-6424975c5b6b" label="lyrics-like">IUstus cor suum tradet ad vigi- et disciplinam, et in abscónditis suis</l><l xml:id="m-057fcce2-d51b-4a1a-bd67-bd9407416838" facs="#m-689eec99-bb7f-4165-9d39-0af086e6af10" label="lyrics-like">CA lándum dilúculo ad Dóminum consiliábitur. Ipse palam fáciet di¬</l><l xml:id="m-5ee7114f-0192-48b7-a770-1e7e7f23a2b9" facs="#m-d3acba07-ea73-48e7-bf6f-cd7c011dbc60" label="lyrics-like">qui fecit illum, et in conspéctu! sciplínam doctrinae suae, et in lege</l><l xml:id="m-b364afdc-1ae6-42fa-a072-26397e32ec4e" facs="#m-c025136f-b140-4061-b7f3-93fbe90cd2da" label="lyrics-like">Altissimi deprecábitur. Apériet os</l><l xml:id="m-35f593c5-e5b6-4dc4-a4c6-7e2be80e40af" facs="#m-6bde0ef9-4523-45c0-ac96-979afe1ee59c" label="lyrics-like">testaménti Dómini gloriábitur. Col¬</l><l xml:id="m-79dd69fb-eb2c-4750-9ea3-ccfe29d5de72" facs="#m-9773d94c-fdb8-4039-947d-4111b83d88e8" label="lyrics-like">suum in oratióne, et pro delictis</l><l xml:id="m-6770592f-22e9-493c-a538-8a9c82910a9e" facs="#m-62508590-a585-4826-933f-da3e5c56f6ba" label="lyrics-like">laudábunt multi sapiéntiam ejus, et</l><l xml:id="m-a2b20847-3712-4973-bb23-089e7cfacf93" facs="#m-60b6bedf-eb34-43a3-931d-8d62f91080cd" label="lyrics-like">suis deprecábitur. Si enim Dóminus</l><l xml:id="m-7bf3c183-b002-43d1-a804-7d4c54ca5f2d" facs="#m-d3508691-adb0-478f-8867-0a9da2b29aae" label="lyrics-like">usque in saéculum non delébitur.</l><l xml:id="m-33dfaae9-6623-4907-9845-f9440ed1921a" facs="#m-c9fbf3c5-9458-4ed4-8bff-de9365a1eef3" label="lyrics-like">Non recédet memória ejus, et no¬</l><l xml:id="m-f2c679eb-887d-4022-982b-1b302828f7c5" facs="#m-20b9eb2a-bf1a-4cfe-b12d-73b40d7f4fbb" label="lyrics-like">magnus volúerit, spíritu intelligén¬</l><l xml:id="m-c60747a6-29c5-40c8-8d2b-55960921c45d" facs="#m-3f05c606-f40a-4ccd-9a95-5161b3ced0b5" label="lyrics-like">tiae replébit illum : et ipse tamquam</l><l xml:id="m-3e992dfd-5194-45ff-a659-d69a7dccab83" facs="#m-3ecb6d33-2992-4128-8703-cd335a69caee" label="lyrics-like">men ejus requirétur a generatióne</l><l xml:id="m-8940548a-623e-4f8e-ab4c-3afa1793ec75" facs="#m-b738b7a0-0949-477d-9440-21fcc28667f6" label="lyrics-like">imbres mittet elóquia sapiéntiae</l><l xml:id="m-1e8b7be8-ebee-4ab1-a209-6978f72fbdca" facs="#m-9662ca9d-e196-40af-b302-898bcdabf8da" label="lyrics-like">in generatiónem. Sapiéntiam ejus</l><l xml:id="m-6299e1c3-c0b3-46fd-b19a-8cc8e66bd51a" facs="#m-64fcdd3f-7981-4042-847d-de7d55be1ae8" label="lyrics-like">suae, et in oratióne confitébitur Dó¬</l><l xml:id="m-2fb01f9e-82a2-4f7e-9ffe-89666bb55a56" facs="#m-32acef84-6e31-45fe-b473-b9a4f268621a" label="lyrics-like">enarrábunt gentes, et laudem ejus</l><l xml:id="m-c6d284b8-14e9-411c-bcb8-cc88aac4ac56" facs="#m-67c85093-3cbf-44ab-b9db-5d6d3df69748" label="lyrics-like">mino: et ipse diriget consilium ejus! enuntiábit ecclésia.</l></lg></div></section></score></mdiv></body></music>
</mei>