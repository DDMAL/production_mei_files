="121" uly="1031" lrx="547" lry="1063" /><zone xml:id="m-eddf36a1-2c91-453f-820c-6529b9981b54" ulx="558" uly="1031" lrx="982" lry="1067" /><zone xml:id="m-132986a5-95eb-41af-8204-cf8d5b80bce6" ulx="122" uly="1058" lrx="548" lry="1090" /><zone xml:id="m-34ae5ac6-e7a1-4f4e-a291-ce726d5accd8" ulx="561" uly="1059" lrx="982" lry="1095" /><zone xml:id="m-6c272df9-1de4-4cc5-8fe8-12d7f81eee00" ulx="120" uly="1083" lrx="553" lry="1115" /><zone xml:id="m-f08956ff-ff5e-4807-920e-ae9ade345afa" ulx="556" uly="1088" lrx="801" lry="1120" /><zone xml:id="m-096d059c-504f-4b49-bebb-84f781f555dc" ulx="121" uly="1110" lrx="551" lry="1143" /><zone xml:id="m-83748bdf-5bf1-48e7-84c3-022136d59ec2" ulx="146" uly="1138" lrx="962" lry="1177" /><zone xml:id="m-c465bc17-ca9f-4ff8-bc62-e522c5f6afd0" ulx="146" uly="1172" lrx="576" lry="1208" /><zone xml:id="m-31b8dcaa-ebc0-465c-b89e-fef686023eda" ulx="866" uly="1172" lrx="958" lry="1211" /><zone xml:id="m-f42e85f3-7e5c-4259-bcde-7f231333782a" ulx="146" uly="1205" lrx="601" lry="1241" /><zone xml:id="m-3e77ac5d-e2b3-4ec5-b99b-0e3d9bb08d8c" ulx="505" uly="1237" lrx="602" lry="1268" /><zone xml:id="m-1fcccc61-d63d-4099-8670-fd10f6021b4a" ulx="160" uly="1265" lrx="986" lry="1302" /><zone xml:id="m-d5d82219-4528-4a1a-b307-be2be76abaa5" ulx="128" uly="1293" lrx="984" lry="1332" /><zone xml:id="m-f2283ed0-356e-4221-9241-98f32538acd0" ulx="124" uly="1321" lrx="691" lry="1359" /><zone xml:id="m-e62d8229-5b61-4b21-be0b-39fa611332b7" ulx="145" uly="1352" lrx="493" lry="1389" /><zone xml:id="m-ea89e1c0-0283-4a26-a3c4-059ec016eb71" ulx="148" uly="1380" lrx="587" lry="1419" /><zone xml:id="m-0f9f4806-0e9a-4a88-bc69-9ad76ef0a168" ulx="437" uly="1417" lrx="670" lry="1445" /><zone xml:id="m-fa5de021-d3de-4a72-8cf1-8b3280a6e5e1" ulx="140" uly="1440" lrx="981" lry="1486" /><zone xml:id="m-fa710fe1-1abd-454c-aaa9-8363307cc612" ulx="126" uly="1471" lrx="744" lry="1508" /><zone xml:id="m-c7d6e9a1-ea8a-40e9-aa54-562f5f670e22" ulx="126" uly="1498" lrx="554" lry="1534" /