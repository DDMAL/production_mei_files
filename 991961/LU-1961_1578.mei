      <graphic xml:id="m-2a3b97f9-7224-4a5e-b002-0c57009af657" target="1578_original_image.tiff" /><zone xml:id="m-95e429e0-aac6-47bd-8779-ae69310438e5" ulx="135" uly="89" lrx="212" lry="124" /><zone xml:id="m-c5b89c8f-2450-4a8a-b644-ca62c1be3c02" ulx="466" uly="89" lrx="683" lry="123" /><zone xml:id="m-725396f4-3656-49be-9fd5-6ca6df634ac9" ulx="521" uly="142" lrx="634" lry="177" /><zone xml:id="m-fe072fd5-0edd-4c57-be57-1a9ea7b6c968" ulx="173" uly="173" lrx="1020" lry="213" /><zone xml:id="m-18368e0b-0b09-4454-bad6-d0d8f937032b" ulx="134" uly="200" lrx="1023" lry="242" /><zone xml:id="m-98caff9d-ace0-407a-98f3-27145a26d475" ulx="134" uly="234" lrx="576" lry="269" /><zone xml:id="m-b1553528-bfc7-4831-986f-23415c155e72" ulx="579" uly="235" lrx="1020" lry="272" /><zone xml:id="m-74304e19-f27e-49fa-a19b-604f9d211d0c" ulx="133" uly="263" lrx="574" lry="299" /><zone xml:id="m-5e1e59be-a4f9-418f-8179-e1c41d6d7dba" ulx="584" uly="264" lrx="772" lry="301" /><zone xml:id="m-765cc95c-7642-4e7d-82e4-88320e4973c1" ulx="133" uly="288" lrx="573" lry="325" /><zone xml:id="m-403a885a-164c-4b3d-b5b5-2066dff36527" ulx="332" uly="363" lrx="822" lry="409" /><zone xml:id="m-27996873-8481-4020-8bde-5a87517e0a7b" ulx="136" uly="366" lrx="174" lry="406" /><zone xml:id="m-0e9bbfc1-b74e-4761-97ad-16a799e1ec2f" ulx="199" uly="409" lrx="775" lry="453" /><zone xml:id="m-101d435f-c41f-4347-9c67-ccc312aea677" ulx="921" uly="417" lrx="1024" lry="458" /><zone xml:id="m-b501683d-ea86-4c73-8d99-d6ce6f811d75" ulx="160" uly="467" lrx="1025" lry="503" /><zone xml:id="m-af23a3af-2b31-4f24-91db-03bf8bac981c" ulx="160" uly="499" lrx="984" lry="541" /><zone xml:id="m-6f02ac6e-adbc-436c-93d5-0127c69d9a94" ulx="524" uly="541" lrx="637" lry="577" /><zone xml:id="m-f9b2ebb0-016e-4f0f-8da9-6f707caba794" ulx="177" uly="571" lrx="1026" lry="610" /><zone xml:id="m-0825b20e-3959-4ca3-acfd-a57ac9e3d927" ulx="140" uly="604" lrx="1024" lry="639" /><zone xml:id="m-23c1e6e7-b4f0-47f6-a007-967426036739" ulx="134" uly="629" lrx="576" lry="666" /><zone xml:id="m-6300282d-71b6-4248-917d-9e935b891a63" ulx="582" uly="634" lrx="1025" lry="666" /><zone xml:id="m-afa318b7-1657-4c1a-8aea-deb691032991" ulx="135" uly="656" lrx="575" lry="693" /><zone xml:id="m-59345ddc-3865-4ff9-895e-4b3225da9b82" ulx="584" uly="665" lrx="837" lry="695" /><zone xml:id="m-35cda346-5cab-4c9b-82c0-618d22fbdcf0" ulx="135" uly="683" lrx="574" lry="723" /><zone xml:id="m-b8897787-c8d8-4c05-8a9c-105b2ee8ecef" ulx="532" uly="721" lrx="630" lry="755" /><zone xml:id="m-e4215eb5-c8a3-41d0-a946-2e571314727b" ulx="197" uly="749" lrx="1026" lry="790" /><zone xml:id="m-ffd3037a-a46e-4c20-9102-95c951463196" ulx="137" uly="770" lrx="573" lry="815" /><zone xml:id="m-f03c2020-1328-4fa6-be70-e23b32def5b4" ulx="588" uly="783" lrx="1027" lry="816" /><zone xml:id="m-fe49d8f4-4fee-4bc7-b6cf-8aaf62844e58" ulx="136" uly="807" lrx="575" lry="844" /><zone xml:id="m-5625dbc1-4e49-4a94-8ed1-79c7c017cd55" ulx="585" uly="810" lrx="1026" lry="847" /><zone xml:id="m-10420d48-4c51-43ce-bbc5-d1e8ae581f31" ulx="136" uly="838" lrx="996" lry="876" /><zone xml:id="m-cd7ff3af-20be-4c4b-9f97-091d9542f054" ulx="460" uly="872" lrx="704" lry="905" /><zone xml:id="m-487bf0aa-cd3b-4da9-be1c-480edacabc20" ulx="175" uly="902" lrx="1027" lry="940" /><zone xml:id="m-01b11360-e717-43be-9378-47bcf888943e" ulx="138" uly="929" lrx="573" lry="967" /><zone xml:id="m-d3d6eb8a-903e-45c7-b599-f783b24a9f4a" ulx="591" uly="932" lrx="1028" lry="971" /><zone xml:id="m-9014ef1f-07d6-4abc-80a6-d2522e82bdb8" ulx="138" uly="956" lrx="576" lry="996" /><zone xml:id="m-7777ac9a-c943-42c2-87ae-e84a6f779eb8" ulx="589" uly="966" lrx="685" lry="1001" /><zone xml:id="m-ccd857d2-bc00-41dd-a324-551ba45dd403" ulx="140" uly="985" lrx="576" lry="1021" /><zone xml:id="m-0afb6c20-fd73-4d69-a82c-0540676bb551" ulx="162" uly="1043" lrx="847" lry="1088" /><zone xml:id="m-1ec5d9ba-7844-4747-8bf0-7f283b9457ec" ulx="532" uly="1089" lrx="645" lry="1124" /><zone xml:id="m-2af1df81-7e6a-44c7-a72f-9558de9e4b57" ulx="181" uly="1120" lrx="1029" lry="1161" /><zone xml:id="m-0b017630-93ec-436d-bb32-6a74adc711c3" ulx="143" uly="1154" lrx="1029" lry="1191" /><zone xml:id="m-6236157e-41ef-4245-aede-4afaf6879bb2" ulx="142" uly="1185" lrx="1028" lry="1220" /><zone xml:id="m-6edf4e9a-31f1-4e0b-97ca-36112cc32619" ulx="142" uly="1208" lrx="726" lry="1244" /><zone xml:id="m-dd6ac0ae-460c-4c0f-9d83-511cea79f55c" ulx="165" uly="1250" lrx="994" lry="1283" /><zone xml:id="m-0d97a8b3-9271-434b-9c5f-42f1b1b4945f" ulx="145" uly="1320" lrx="203" lry="1363" /><zone xml:id="m-0d5598c6-31ab-4f64-98e9-59ed208adf63" ulx="412" uly="1320" lrx="767" lry="1367" /><zone xml:id="m-eb8b994d-98d3-4d2d-8cf2-9facd9f107d3" ulx="928" uly="1328" lrx="1030" lry="1364" /><zone xml:id="m-66812f35-8d9c-4f8c-a048-90351025a482" ulx="169" uly="1376" lrx="1006" lry="1417" /><zone xml:id="m-b0a33f7c-7cf1-451f-b685-d762b0261d48" ulx="531" uly="1416" lrx="644" lry="1451" /><zone xml:id="m-e8b9e651-3896-4df1-b4fa-09e9a1d3fa3a" ulx="185" uly="1451" lrx="1033" lry="1489" /><zone xml:id="m-5f816245-9a5f-4c3e-a5b4-b649e9cba193" ulx="149" uly="1478" lrx="1025" lry="1514" /><zone xml:id="m-a57d96d3-d692-4197-89c3-a9dcb16fc062" ulx="150" uly="1507" lrx="1029" lry="1539" /><zone xml:id="m-5a210568-08b5-4e83-9482-0355bff8ec93" ulx="146" uly="1533" lrx="917" lry="1573" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-bcb294de-51b6-4dff-ab2f-457adbfb1a58" n="1578" facs="#m-c894c2db-a742-4a04-b22f-64441aa328d7" /><div xml:id="m-6efef634-077f-48a0-9d6b-4efa46448765">
            <lg xml:id="m-705ffb58-854d-4a6e-9b3e-51da48065a05">
              <l xml:id="m-43c0cad5-fb37-48c3-b8a4-24e0bfda777d" facs="#m-95e429e0-aac6-47bd-8779-ae69310438e5" label="ambiguous">1374</l><l xml:id="m-102aa447-14e5-4c09-8d81-f3ad60c73115" facs="#m-c5b89c8f-2450-4a8a-b644-ca62c1be3c02" label="ambiguous">February 9. 10.</l><l xml:id="m-3b9bf424-30c1-42c8-9755-0815dcd38555" facs="#m-725396f4-3656-49be-9fd5-6ca6df634ac9" label="ambiguous">Collect.</l><l xml:id="m-aeeee9dc-9601-4d50-b574-f7e1e44924db" facs="#m-fe072fd5-0edd-4c57-be57-1a9ea7b6c968" label="lyrics-like">Eus, qui per sanctum Joánnem, quaésumus; ut, ejus suffragántibus</l><l xml:id="m-22097ad8-2b3e-4438-b4dd-fd58bf012025" facs="#m-18368e0b-0b09-4454-bad6-d0d8f937032b" label="lyrics-like">UOrdinem sanctíssimae Trinitá- méritis, “ a captivitáte córporis et</l><l xml:id="m-93b3ff5a-b864-4031-92d4-09889509b083" facs="#m-98caff9d-ace0-407a-98f3-27145a26d475" label="lyrics-like">tis, ad rediméndum de potestáte</l><l xml:id="m-f4c83244-7013-44b9-b7dc-c0e655eb8e41" facs="#m-b1553528-bfc7-4831-986f-23415c155e72" label="lyrics-like">ánimae, te adjuvánte, liberémur.</l><l xml:id="m-1798dbf7-e03b-4598-9a82-3ed6e1b70fbc" facs="#m-74304e19-f27e-49fa-a19b-604f9d211d0c" label="lyrics-like">Saracenórum captivos, caélitus in¬</l><l xml:id="m-77da28e9-6eb9-4460-bcf3-45aced3ce248" facs="#m-5e1e59be-a4f9-418f-8179-e1c41d6d7dba" label="lyrics-like">Per Dóminum.</l><l xml:id="m-c6d4897e-08b5-4777-a6cc-f50a6a800062" facs="#m-765cc95c-7642-4e7d-82e4-88320e4973c1" label="lyrics-like">stitúere dignátus es t praesta,</l><l xml:id="m-e6c79bc4-0318-4478-8448-f2470adfd271" facs="#m-403a885a-164c-4b3d-b5b5-2066dff36527" label="text-like">S. Cyril, Bishop of Alexandria.</l><l xml:id="m-4d429bcf-cbdd-47b6-818b-c21e40118d6d" facs="#m-27996873-8481-4020-8bde-5a87517e0a7b" label="ambiguous">9.</l><l xml:id="m-eb0c79f0-d8e1-4974-a4f6-578df958974c" facs="#m-0e9bbfc1-b74e-4761-97ad-16a799e1ec2f" label="text-like">Confessor and Doctor of the Church.</l><l xml:id="m-65efacbf-9873-4606-b6c5-1c679b1588c5" facs="#m-101d435f-c41f-4347-9c67-ccc312aea677" label="ambiguous">Double.</l><l xml:id="m-d41a23a6-5586-46f2-983e-d069af262672" facs="#m-b501683d-ea86-4c73-8d99-d6ce6f811d75" label="lyrics-like">At ist and and Vespers. At Magn. Ant. O Dóctor... beáte Cyrille. p. 262s.</l><l xml:id="m-77135fdf-2835-4173-b850-dafd05c87e69" facs="#m-af23a3af-2b31-4f24-91db-03bf8bac981c" label="lyrics-like">Mass. In médio. p. 1190, except the following. The Credo. is said.</l><l xml:id="m-a1300110-c0ec-496b-8142-b782095d3384" facs="#m-6f02ac6e-adbc-436c-93d5-0127c69d9a94" label="ambiguous">Collect.</l><l xml:id="m-aa1fd313-cd07-47ea-bc4c-9389e6cbf512" facs="#m-f9b2ebb0-016e-4f0f-8da9-6f707caba794" label="lyrics-like">Eus, qui beátum Cyrillum Con-l intercedénte; ut qui vere eam Ge¬</l><l xml:id="m-03826df5-e188-4ce8-9ece-819009889dc9" facs="#m-0825b20e-3959-4ca3-acfd-a57ac9e3d927" label="lyrics-like">U fessórem tuum atque Pontifi- nitricem Dei crédimus, * matérna</l><l xml:id="m-a7fd3d47-d026-4a71-9364-6fcccdae3e44" facs="#m-23c1e6e7-b4f0-47f6-a007-967426036739" label="lyrics-like">cem divinae maternitátis beatissi¬</l><l xml:id="m-84d1399f-42c2-435b-a5fd-fe62e38f86c5" facs="#m-6300282d-71b6-4248-917d-9e935b891a63" label="lyrics-like">ejúsdem protectióne salvémur. Per</l><l xml:id="m-42f8ca1d-48c7-4636-bdb6-b44cc3aca761" facs="#m-afa318b7-1657-4c1a-8aea-deb691032991" label="lyrics-like">mae Virginis Mariae assertórem</l><l xml:id="m-6a8a7c4d-9b4b-4793-a181-456b1a122835" facs="#m-59345ddc-3865-4ff9-895e-4b3225da9b82" label="lyrics-like">eúmdem Dóminum.</l><l xml:id="m-15b1a67d-ea1c-414a-a04f-280eecc8d88d" facs="#m-35cda346-5cab-4c9b-82c0-618d22fbdcf0" label="lyrics-like">invictum effecisti : t concéde, ipso</l><l xml:id="m-de3021fa-7da2-43f1-82e9-10c7c77f4524" facs="#m-b8897787-c8d8-4c05-8a9c-105b2ee8ecef" label="ambiguous">Secret.</l><l xml:id="m-a45fc679-979c-4906-8805-2017aa697efa" facs="#m-e4215eb5-c8a3-41d0-a946-2e571314727b" label="lyrics-like">Unera nostra, omnípotens! stum Dóminum nostrum in tua</l><l xml:id="m-34ed5816-f9b9-4af1-a242-93c1cbcd2686" facs="#m-ffd3037a-a46e-4c20-9102-95c951463196" label="lyrics-like">S1t peus, benignus réspice: et</l><l xml:id="m-eec84e58-c9e4-4752-9c67-7a32e4eb114b" facs="#m-f03c2020-1328-4fa6-be70-e23b32def5b4" label="lyrics-like">tecum glória coaetérnum, in córdi¬</l><l xml:id="m-e9a25e97-d357-44d4-9ee6-4e15c29c1a04" facs="#m-fe49d8f4-4fee-4bc7-b6cf-8aaf62844e58" label="lyrics-like">intercedénte beâto Cyrillo, praesta;</l><l xml:id="m-c776cc1f-90d4-46b5-b502-45f549571f9b" facs="#m-5625dbc1-4e49-4a94-8ed1-79c7c017cd55" label="lyrics-like">bus nostris digne suscipere mereá¬</l><l xml:id="m-8bc1ed14-2c9d-431d-94c3-b11b880e8618" facs="#m-10420d48-4c51-43ce-bbc5-d1e8ae581f31" label="lyrics-like">ut Unigénitum tuum Jesum Chri- mur : Qui tecum vivit et regnat.</l><l xml:id="m-353f1a53-93e1-4511-af09-5019008bd6e1" facs="#m-cd7ff3af-20be-4c4b-9f97-091d9542f054" label="ambiguous">Postcommunion.</l><l xml:id="m-57be6a63-c922-4b6a-b48f-5af534505e7b" facs="#m-487bf0aa-cd3b-4da9-be1c-480edacabc20" label="lyrics-like">AIvínis, Dómine, refécti mysté-] trici Unigéniti tui digne famulári</l><l xml:id="m-04dc09e7-a0d9-4a8c-99ce-64a2cb05112b" facs="#m-01b11360-e717-43be-9378-47bcf888943e" label="lyrics-like">Uriis, te súpplices deprecámur:</l><l xml:id="m-fed61293-2717-49e4-a544-6ebf59f4e3b3" facs="#m-d3d6eb8a-903e-45c7-b599-f783b24a9f4a" label="lyrics-like">valeámus: Qui tecum vivit et</l><l xml:id="m-24f5e063-d5cd-4097-9237-5fa35b2bc288" facs="#m-9014ef1f-07d6-4abc-80a6-d2522e82bdb8" label="lyrics-like">ut exémplis et méritis beáti Cyrilli</l><l xml:id="m-1b67d971-509c-4975-9b13-cbbeac18bc0c" facs="#m-7777ac9a-c943-42c2-87ae-e84a6f779eb8" label="ambiguous">regnat.</l><l xml:id="m-9c28fc29-1398-4df7-b7c8-749a25815e19" facs="#m-ccd857d2-bc00-41dd-a324-551ba45dd403" label="lyrics-like">Pontificis adjúti, sanctissimae Geni¬</l><l xml:id="m-61caeeab-18a0-4cc4-b4cf-b6f3d1d683fd" facs="#m-0afb6c20-fd73-4d69-a82c-0540676bb551" label="text-like">Commemoration of St. Apollonia Virgin and Martyr.</l><l xml:id="m-dbdcdc4d-b10a-429d-be06-df7cc3f835c3" facs="#m-1ec5d9ba-7844-4747-8bf0-7f283b9457ec" label="ambiguous">Collect.</l><l xml:id="m-35e72565-9d9f-4463-8ac2-0a41bde05537" facs="#m-2af1df81-7e6a-44c7-a72f-9558de9e4b57" label="lyrics-like">Eus, qui inter cétera poténtiae ! beátae Apollóniae Virginis et Már¬</l><l xml:id="m-55ed469d-f521-4865-92cf-642a6be9771c" facs="#m-0b017630-93ec-436d-bb32-6a74adc711c3" label="lyrics-like">O tuae mirácula, étiam in sexu tyris tuae natalitia cólimus, per</l><l xml:id="m-5c66b46a-04b7-4e26-987a-33736ec7869a" facs="#m-6236157e-41ef-4245-aede-4afaf6879bb2" label="lyrics-like">frágili victóriam martyrii contuli-lejus ad te exémpla gradiámur. Per</l><l xml:id="m-8efe6e0e-935f-4b6a-ba9a-f1461bb1ac94" facs="#m-6edf4e9a-31f1-4e0b-97ca-36112cc32619" label="lyrics-like">*concéde propitius; ut qui l Dóminum.</l><l xml:id="m-f3f6ad41-7d71-421f-bf96-64e1a7815955" facs="#m-dd6ac0ae-460c-4c0f-9d83-511cea79f55c" label="lyrics-like">Secret. Súscipe Dómine. and Postcommunion. Auxiliéntur nobis. p. 1220.</l><l xml:id="m-09cc60e1-84ed-4f97-938d-75f4ddd7c97a" facs="#m-0d97a8b3-9271-434b-9c5f-42f1b1b4945f" label="ambiguous">10.</l><l xml:id="m-e93417b5-266c-4862-b439-d4b213b91d6b" facs="#m-0d5598c6-31ab-4f64-98e9-59ed208adf63" label="ambiguous">St. Scholastica Virgin.</l><l xml:id="m-cee4f740-4199-4ed8-9ebf-395efe6837f5" facs="#m-eb8b994d-98d3-4d2d-8cf2-9facd9f107d3" label="ambiguous">Double.</l><l xml:id="m-906de79d-92ad-4681-bbb5-b8921b4b223b" facs="#m-66812f35-8d9c-4f8c-a048-90351025a482" label="text-like">Mass. Dilexisti. from the Common of a Virgin not a Martyr, p. 1225.</l><l xml:id="m-69a34823-1e85-456c-8b1f-fff04a006c80" facs="#m-b0a33f7c-7cf1-451f-b685-d762b0261d48" label="ambiguous">Collect.</l><l xml:id="m-41b8817f-f1cf-4028-8210-dbeec28dee80" facs="#m-e8b9e651-3896-4df1-b4fa-09e9a1d3fa3a" label="lyrics-like">Eus, qui ánimam beátae Virgi- fecísti: t da nobis ejus méritis et</l><l xml:id="m-4667eb99-a6d3-4837-841f-1852a3f2497a" facs="#m-5f816245-9a5f-4c3e-a5b4-b649e9cba193" label="lyrics-like">I nis tuae Scholásticae, ad osten- précibus ita innocénter vivere;"</l><l xml:id="m-055bc881-cd66-47c5-974d-74a0ab792813" facs="#m-a57d96d3-d692-4197-89c3-a9dcb16fc062" label="lyrics-like">déndam innocéntiae viam, in co-lut ad aetérna mereámur gáudia</l><l xml:id="m-f4d89281-c01a-4be4-b704-2bf1fe6f24a4" facs="#m-5a210568-08b5-4e83-9482-0355bff8ec93" label="lyrics-like">túmbae spécie caelum penetrâre! pervenire. Per Dóminum.</l></lg></div></section></score></mdiv></body></music>
</mei>