"975" lry="771" /><zone xml:id="m-2f31fdd9-74de-49e6-80cc-bb02e4117caf" ulx="113" uly="760" lrx="666" lry="795" /><zone xml:id="m-defeacd1-8afa-491b-a4e4-7735ccf0b154" ulx="479" uly="821" lrx="610" lry="860" /><zone xml:id="m-820f4ff8-96c9-487c-b35f-8aef47441d69" ulx="140" uly="880" lrx="977" lry="916" /><zone xml:id="m-95a216e8-962f-419e-bd4c-449e01ae7ec4" ulx="113" uly="910" lrx="973" lry="944" /><zone xml:id="m-2312ca18-0c21-48cf-9ab5-fc563aa44510" ulx="113" uly="936" lrx="540" lry="973" /><zone xml:id="m-1c04ae9c-9ccf-4730-ab6b-471a6ecea8cf" ulx="547" uly="936" lrx="976" lry="973" /><zone xml:id="m-319e5559-31d3-4029-b4ee-0347434c7d49" ulx="547" uly="961" lrx="977" lry="996" /><zone xml:id="m-0a609040-fce0-4f50-9ea5-f29f8a348934" ulx="113" uly="963" lrx="540" lry="995" /><zone xml:id="m-6a10b7e2-940a-470f-beaf-c442b2132cdd" ulx="113" uly="989" lrx="972" lry="1024" /><zone xml:id="m-8a603c60-9115-478d-b9c8-8e385ace0bfd" ulx="114" uly="1016" lrx="975" lry="1053" /><zone xml:id="m-efd0e7e5-2bca-4c6d-95eb-f5e3b2028ada" ulx="113" uly="1042" lrx="663" lry="1076" /><zone xml:id="m-f7056d6b-c3d0-4009-9dda-017882eb676a" ulx="188" uly="1104" lrx="901" lry="1147" /><zone xml:id="m-bf29cf52-fc41-481a-a7c7-2237e44f55c5" ulx="140" uly="1161" lrx="978" lry="1200" /><zone xml:id="m-49aab601-ce65-499a-827f-bba09be3be56" ulx="114" uly="1197" lrx="977" lry="1227" /><zone xml:id="m-bf17cc39-6634-4de0-829e-7050f6b4556c" ulx="117" uly="1221" lrx="974" lry="1255" /><zone xml:id="m-f0b967b6-10cd-4b85-b694-ad761b7cb040" ulx="115" uly="1246" lrx="975" lry="1285" /><zone xml:id="m-877f7ed8-8042-4548-bcfb-f3b4c550921e" ulx="436" uly="1304" lrx="650" lry="1346" /><zone xml:id="m-589db2e2-165c-4c78-ba14-6a53a8400e03" ulx="142" uly="1364" lrx="975" lry="1401" /><zone xml:id="m-15180206-37ca-4e20-b45c-26493469c756" ulx="114" uly="1392" lrx="977" lry="1426" /><zone xml:id="m-a05bd898-6a4d-4522-8fea-938fa0fe7072" ulx="118" uly="1421" lrx="975" lry="1454" /><zone xml:id="m-f7a34431-3501-4df0-ac9b-669ce7a79c60" ulx="113" uly="1445" lrx="540" lry="1484" /><zone xml:id="m-cbdf3b41-e230-41c9-a905-14e5ff16e372" ulx="552" uly="1450" lrx="976" lry="1485" /><zone xml:id="m-a826d224-c283-417e-9103-baedc5772e72" ulx="551" uly="1473" lrx="706" lry="1510" /><zone xml:id="m-9fcf7342-29ba-462b-89e1-c169fe68551c" ulx="116" uly="1474" lrx="543" lry="1507" /><zone xml:id="m-f077767f-9ec0-483e-a52f-1f3c40acce0a" ulx="117" uly="1500" lrx="549" lry="1537" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-a25d3181-35e0-44af-810c-9b878288e02e" n="0118" facs="#m-9c418a7b-66f2-4ac2-a3e8-4310739e4ec4" /><div xml:id="m-c13968ed-3266-4f59-8680-7a4000a23cfe">
            <lg xml:id="m-9c255950-b78e-4b41-83d6-ead02513a334">
              <l xml:id="m-64219f7b-a985-4b08-80a0-b31901966976" facs="#m-8036443f-17bd-4288-a6e7-28216b4536e9" label="ambiguous">~==============-===-===-===-=======-= ==-= =========-======-==-===-==c---—=c-</l><l xml:id="m-8ab0a5b1-1310-4c69-afc4-a9247217c026" facs="#m-3ed1fd6d-3227-4a67-b102-90ac2538f758" label="ambiguous">PROPER PREFACES.</l><l xml:id="m-86c64c76-7200-417f-8269-12c6e1e9a33b" facs="#m-235c4dee-e0da-4fc3-8eed-d58066cd10b9" label="text-like">The Preface for a feast is said aiso within the Octave, even on feasts</l><l xml:id="m-8a71bfad-8126-4ef3-bcf4-c0929245e7eb" facs="#m-184f42b7-b7fe-43af-8109-b4f9023502de" label="text-like">which occur auring that Octave, untess such feasts have a proper Preface.</l><l xml:id="m-687f7c83-2757-4be4-a835-89aaf6b1d1d1" facs="#m-ab5a9e8b-259c-4e89-8293-9c4678b2a79d" label="text-like">At Christmas and on the Feast of Corpus Christi.</l><l xml:id="m-1e481603-91b9-4807-aaf2-f65605e6e8af" facs="#m-27435587-9041-4353-882d-b001c9daaacd" label="lyrics-like">Vere dignum et justum est, gnóscimus, per hunc in invisibilium</l><l xml:id="m-360e8ff3-67e4-4431-ab79-0f1792045b5f" facs="#m-fbbe4540-dbd0-4694-9aff-d618b742220d" label="lyrics-like">aequum et salutáre, nos tibi sem- ãmórem rapiámur. Et ideo cum</l><l xml:id="m-63d088a1-6164-4e3f-99c6-bff8020fb664" facs="#m-570127c5-557d-47a2-a41a-9209e83920ca" label="lyrics-like">per, et ubique grátias agere: Dó- Angelis et Archángelis, cum Thronis</l><l xml:id="m-dee7d863-3f4d-4bd8-ac73-fab05647965e" facs="#m-8df5b7e2-7997-4938-99f4-9aec084c3ef3" label="ambiguous">mine sancte, Pater omnipotens,</l><l xml:id="m-7c420f48-2d36-4607-ae4a-4ebe384097d3" facs="#m-e4958826-1ac4-46a4-b2cb-54d5d158c92f" label="lyrics-like">et Dominatiónibus, cumque omni</l><l xml:id="m-f7b424a0-f73e-446d-9d7b-af7f05fbdad4" facs="#m-34ad1f8e-0024-4615-8b1f-2b0506063d1c" label="lyrics-like">militia caeléstis exércitus, hymnum</l><l xml:id="m-476b36dc-bfdf-4dbb-a8ec-2a291cdbd712" facs="#m-4ec20600-8cb1-4a50-b7d1-6f932d037aba" label="lyrics-like">aetérne Deus. Quia per incarnáti</l><l xml:id="m-499a6183-b801-4208-98bb-956f3ce520c6" facs="#m-3ee5daac-b6d6-4873-a053-4a62a920d235" label="lyrics-like">glóriae tuae cánimus, sine fine di¬</l><l xml:id="m-fd2fb672-1bf3-42d1-97da-b0b9f416550e" facs="#m-c63bc023-2d08-4e60-8f33-56b27bf05406" label="lyrics-like">Verbi mystérium, nova mentis no¬</l><l xml:id="m-9bbb8c30-bde4-4942-834b-325bc5b438b4" facs="#m-9022132a-1a61-486e-bd70-e97153f58bd5" label="lyrics-like">strae óculis lux tuae claritátis in¬</l><l xml:id="m-bf3afa33-9fe7-4bb1-b0a1-0ec1fef3c224" facs="#m-1d53f01f-10ce-4e7a-9a3f-8e813bbc8818" label="lyrics-like">céntes.</l><l xml:id="m-5f044eb3-823d-4329-8d0d-e185bfa5d1b3" facs="#m-88897fda-2bde-48ca-94f3-cf3c38c222c1" label="lyrics-like">fúlsit : ut dum visibiliter Deum co¬</l><l xml:id="m-ab540769-0ecf-482f-af61-512372047ce2" facs="#m-e657ee4a-c73d-42b2-8898-76a0cda2ba89" label="text-like">At the Epiphany.</l><l xml:id="m-bfba645c-edc0-426e-b8fd-6eee7251a879" facs="#m-08c830f0-c9ae-4b0a-bd87-8a73e50e3e43" label="lyrics-like">Vere dignum et justum est...,! talitátis appáruit, nova nos immor¬</l><l xml:id="m-518dc377-b0af-46c1-bd21-a05777d5874e" facs="#m-d010566a-8783-4d83-83ab-23f9563a2363" label="lyrics-like">aetérne Deus. Quia, cum Unigéni-talitátis suae luce reparávit. Et</l><l xml:id="m-5734d996-93e9-41d1-bfd9-53b11890fc44" facs="#m-2f31fdd9-74de-49e6-80cc-bb02e4117caf" label="lyrics-like">tus tuus in substántia nostrae mor-lideo, etc.</l><l xml:id="m-43ccb5ec-e339-447a-859c-c5cfb6f6e03a" facs="#m-defeacd1-8afa-491b-a4e4-7735ccf0b154" label="ambiguous">In Lent.</l><l xml:id="m-5661db3a-ad38-4400-9300-519f600a3eea" facs="#m-820f4ff8-96c9-487c-b35f-8aef47441d69" label="lyrics-like">Vere dignum et justum est, rant Dominatiónes, tremunt pote¬</l><l xml:id="m-cde0a4ec-9471-4b9f-81be-1f4c2f8c9123" facs="#m-95a216e8-962f-419e-bd4c-449e01ae7ec4" label="lyrics-like">aequumet salutáre..., aetérne Deus. ] státes. Caeli, caelorúmque Virtútes,</l><l xml:id="m-96dfdc08-65df-45ab-b06d-a4db6f5eefe6" facs="#m-2312ca18-0c21-48cf-9ab5-fc563aa44510" label="lyrics-like">Qui corporáli jejúnio vitia cómpri¬</l><l xml:id="m-97476e92-9321-4ae5-b833-c90147ffa593" facs="#m-1c04ae9c-9ccf-4730-ab6b-471a6ecea8cf" label="lyrics-like">ac beáta Séraphim, sócia exsuita¬</l><l xml:id="m-1d7c82ad-a272-4072-9414-db18ffe204d2" facs="#m-319e5559-31d3-4029-b4ee-0347434c7d49" label="lyrics-like">tióne concélebrant. Cum quibus et</l><l xml:id="m-bdb6338a-6c51-4f99-95d2-84b362931c0d" facs="#m-0a609040-fce0-4f50-9ea5-f29f8a348934" label="lyrics-like">mis, mentem élevas, virtútem lar¬</l><l xml:id="m-3d23b276-c5af-4b81-862b-8679034f8082" facs="#m-6a10b7e2-940a-470f-beaf-c442b2132cdd" label="lyrics-like">giris et praémia: per Christum nostras voces, ut admítti júbeas,</l><l xml:id="m-aff43fa1-84e9-4501-bc70-dab43026f9d0" facs="#m-8a603c60-9115-478d-b9c8-8e385ace0bfd" label="lyrics-like">Dóminum nostrum. Per quem ma¬ deprecámur, súpplici confessióne</l><l xml:id="m-e15098ce-3101-49ef-ac75-9ab39e6ff693" facs="#m-efd0e7e5-2bca-4c6d-95eb-f5e3b2028ada" label="lyrics-like">jestátem tuam laudant Angeli, adó- dicéntes.</l><l xml:id="m-7216b1af-8f26-479d-9dae-eebf58aaba72" facs="#m-f7056d6b-c3d0-4009-9dda-017882eb676a" label="text-like">At Masses of the Passion or of the Holy Cross.</l><l xml:id="m-047dd42f-5a33-49b9-a717-9913b0c0a547" facs="#m-bf29cf52-fc41-481a-a7c7-2237e44f55c5" label="lyrics-like">Vere dignum et justum est, mors oriebátur, inde vita resúrgeret:</l><l xml:id="m-49380879-e0b5-4b05-bb1e-89c8ef448ec8" facs="#m-49aab601-ce65-499a-827f-bba09be3be56" label="lyrics-like">aequum et salutáre..., aetérne Deus.] et qui in ligno vincébat, in ligno</l><l xml:id="m-53946a98-8738-45c7-9932-d57537ebda05" facs="#m-bf17cc39-6634-4de0-829e-7050f6b4556c" label="lyrics-like">Qui salútem humáni géneris in li- quoque vincerétur: per Christum</l><l xml:id="m-5f5e57cb-82d4-4f7c-b3ec-4222e382dccd" facs="#m-f0b967b6-10cd-4b85-b694-ad761b7cb040" label="lyrics-like">gno crucis constituísti: ut unde Dóminum nostrum. Per quem, etc.</l><l xml:id="m-ea272e75-1cf5-483e-b69c-9723d972d161" facs="#m-877f7ed8-8042-4548-bcfb-f3b4c550921e" label="text-like">At Eastertide.</l><l xml:id="m-3abbc2d2-98fc-44fe-9cbc-578e2a8f259a" facs="#m-589db2e2-165c-4c78-ba14-6a53a8400e03" label="ambiguous">Vere dignum et justum est,¡ Christus. Ipse enim verus est Agnus,</l><l xml:id="m-3865005b-1da5-4f30-be37-d0b7a4a06b04" facs="#m-15180206-37ca-4e20-b45c-26493469c756" label="lyrics-like">aequum et salutáre: Te quidem qui ábstulit peccáta mundi- Qui</l><l xml:id="m-024e6c4d-ab74-483e-b5b9-bb8f824c139e" facs="#m-a05bd898-6a4d-4522-8fea-938fa0fe7072" label="lyrics-like">Dómine omni témpore, sed in hac! mortem nostram moriéndo destrú¬</l><l xml:id="m-b81937b6-c447-4cee-bcaf-e2988cb2157b" facs="#m-f7a34431-3501-4df0-ac9b-669ce7a79c60" label="lyrics-like">potíssimum die (or in hoc potissi¬</l><l xml:id="m-d4775404-25bb-40cb-b456-31348016ebb1" facs="#m-cbdf3b41-e230-41c9-a905-14e5ff16e372" label="lyrics-like">xit, et vitam resurgéndo reparávit.</l><l xml:id="m-225a55ac-ad93-4909-85bf-0dcf996b0ce3" facs="#m-a826d224-c283-417e-9103-baedc5772e72" label="ambiguous">Et ideo, etc.</l><l xml:id="m-be44cd97-c725-475d-a1e5-49e8f85627f2" facs="#m-9fcf7342-29ba-462b-89e1-c169fe68551c" label="lyrics-like">mum) gloriósius praedicáre, cum</l><l xml:id="m-cc039b11-f8d8-468c-9b8a-f624e5cad042" facs="#m-f077767f-9ec0-483e-a52f-1f3c40acce0a" label="lyrics-like">Pascha nostrum immolátus est</l></lg></div></section></score></mdiv></body></music>
</mei>