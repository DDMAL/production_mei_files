                <divLine xml:id="m-f6b3277f-de00-4eab-808f-2e3561b66af3" facs="#m-aed7cfa7-d88d-432e-9e0b-be8e6a26d564" form="maior" />
                <syllable xml:id="m-1a374b98-2cd9-488d-81cf-6cdfc0b87f7a">
                  <syl /><neume facs="#m-0e9e868e-adaa-4813-a33c-1b8a0736d5a2" type="punctum" xml:id="m-9a8d7189-ec32-4ff2-aa75-d07952904a39">
