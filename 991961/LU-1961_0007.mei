  <music xml:id="m-03dde467-0c1e-4660-994c-0707d54a00fc">
    <facsimile xml:id="m-6966d47a-02cf-4975-8190-ff685e091b9c" type="transcription">
      <surface xml:id="m-3c1e9cbc-59e1-4de4-a758-5387c4631167" lrx="1155" lry="1832">
