8a-93e0-361f381abeb2" type="clivis" xml:id="m-4358ea04-0867-45aa-a6ba-edf4bfdf5012"><nc xml:id="m-b58d7395-6d80-4e2a-96d4-03fb12f3076f" pname="g" oct="3" /><nc xml:id="m-7b4ec4d3-b567-4921-afb7-da1364e552ba" pname="f" oct="3" /></neume></syllable><syllable xml:id="m-1b64e6ee-2b0a-4248-9892-a0c35ffb0368"><syl /><neume facs="#m-8a5c18a2-ad34-4afc-bc5a-8e3696f0a0eb" type="punctum" xml:id="m-7befac12-d157-4cca-8212-81ce0ab14d8f"><nc xml:id="m-5e069ca4-76a1-4f88-a44d-c32f81b0ba8f" pname="f" oct="3" tilt="se" /></neume></syllable><syllable xml:id="m-d21965ef-c537-4f9a-9b7e-78b3cbe31735"><syl /><neume facs="#m-0dabd9e0-9866-4000-8684-2b23ffda21ca" type="punctum" xml:id="m-bf5e4da3-e405-4a59-869c-689d137fea21"><nc xml:id="m-addc3938-5813-4219-891e-4c904cfd9e87" pname="g" oct="3" tilt="se" /></neume></syllable><syllable xml:id="m-5f9744d5-47d2-4c27-821f-4515890881d2"><syl /><neume facs="#m-5cbb39af-f9d6-4c03-93cf-0bb1013dfc5c" type="virga" xml:id="m-20b8eb8f-8c1d-422e-b6a2-184c220180d6"><nc xml:id="m-f6adb179-7297-4404-b650-84156f4d0c51" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-ef8dd624-858d-4619-b8ec-6a4d162cd38e"><syl /><neume facs="#m-b389ce8a-92aa-458f-890c-8f7f96ed9481" type="punctum" xml:id="m-9513e610-d536-4574-ae7d-7e811e0390c3"><nc xml:id="m-f8a6d81f-0396-43fc-99c8-7b5de1700386" pname="f" oct="3" tilt="se" /></neume></syllable><syllable xml:id="m-a7ceadb1-0e7e-48b9-a812-f67cab029888"><syl /><neume facs="#m-524b554d-56ca-4aab-95b3-8f678e19dfe3" type="punctum" xml:id="m-dc3cd39a-2a7d-408e-97fd-6d4d5e41b88c"><nc xml:id="m-6e204e9b-e8e7-4de8-8d6b-bc54afdd134a" pname="a" oct="3" tilt="se" /></neume></syllable><syllable xml:id="m-ea02404e-f097-498c-8f50-37ab99e77844"><syl /><neume facs="#m-07b18017-f1f9-47f5-98ae-f1e8260ce6eb" type="virga" xml:id="m-c221fdd3-5f4e-4138-9fed-47390707b78a"><nc xml:id="m-408d218b-7215-47ab-b06e-5a5ec4413baa" pname="c" oct="4" /></neume></syllable><syllable xml:id="m-b485e3ef-1f99-4a5b-8c7c-0fc0ec6de784"><syl /><neume facs="#m-d0ee23e6-6137-415f-b260-c0b6e5245ea5" type="punctum" xml:id="m-82f9480f-ac03-40fe-9bc5-8ab65fef9a93"><nc xml:id="m-36ecdfcb-b9e0-4fe2-a3d8-f5d3d0bbe13a" pname="c" oct="4" /></neume></syllable><syllable xml:id="m-8b32a9f5-90e3-4058-9cd4-cc86838ddad3"><syl /><neume facs="#m-6c3c9d50-a879-4e0f-a0ac-7c081dc813a7" type="punctum" xml:id="m-f523f7c5-6250-41c0-91a5-392be98d4479"><nc xml:id="m-3905d925-d88d-442f-9a4d-af530cb64881" pname="a" oct="3" /></neume></syllable><clef xml:id="m-a29eb883-d435-4e0a-8d5f-313aced1106e" facs="#m-54f34a06-5aa0-431b-b428-5765b17aeb05" shape="C" line="3" /></layer></staff><div xml:id="m-c086af0b-e897-48ff-abe3-69872322e959">
            <lg xml:id="m-a3d05739-b2cb-4f5e-8c03-6ac3ae7c34ef">
              <l xml:id="m-acf62422-4841-4b73-ad8f-5d1ba4050ff1" facs="#m-6cd8a889-5283-48ad-b718-61ca5f02d510" label="ambiguous">Ianuary 18.</l><l xml:id="m-7b8d2331-f0a0-4f2e-8fe6-e7a59773c66a" facs="#m-dfcea38b-f054-4f41-ba90-a32dcd8fda1d" label="ambiguous">1331</l><l xml:id="m-9df49d0f-ed81-43f9-ae5a-4679951e31a1" facs="#m-385da9fc-8e0e-4efe-9aab-2f4db35d99cb" label="text-like">A commemoration is made of St. Paul before any other commemoration</l><l xml:id="m-f6346556-189b-4eb5-b09d-e4729164287b" facs="#m-9b74e1bc-7f54-449b-8316-a7750079ad93" label="text-like">which may occur that day. An the same way. on the feasts of St. Paul, the</l><l xml:id="m-b53e2708-e1c0-4fe5-b44f-d85ea9d71c0a" facs="#m-ea1fc488-cf29-442e-972a-24d8fc5dd85b" label="lyrics-like">first commemoration is always that of St. Petẽr¬</l><l xml:id="m-30675946-b97c-40f3-bf52-1629fb95d1b4" facs="#m-d365a7d0-ad48-4dab-8990-20faeabe8e78" label="lyrics-like">Commemoration of St. Paul Apost. Ant. Sancte Pâule. p. 1350. Y. Tu es vas.</l><l xml:id="m-8e2d9415-7cc9-4f78-831d-0f290addd043" facs="#m-c338028f-90c1-48f3-ae00-0ea88734d8c2" label="lyrics-like">Prayer : Deus qui multitúdinem. as below.</l><l xml:id="m-3ef2e102-1396-4ac0-99f3-a9efc7f2f636" facs="#m-4f90b470-94b4-429d-b7e2-10972554b9c8" label="lyrics-like">Commemoration ofst. Prisca, Virgin and Martyr. Ant. Véni spónsa. p. 262a.</l><l xml:id="m-08b17056-1a31-46d9-9815-f608af21ba27" facs="#m-70517a9d-5f5e-40a0-ac67-47f3ff3519ed" label="lyrics-like">V. Spécie túa. Prayer: Da quaésumus. as below.</l><l xml:id="m-f73cf339-ff99-4c4a-924e-3fb3ab00bce0" facs="#m-5567f044-8b2c-4743-a417-a0b656f58af3" label="text-like">At Mass.</l><l xml:id="m-2aa7fa64-5c65-4184-b19b-3aa905568aaa" facs="#m-12d40fac-6dff-4975-b681-d9a920e52b04" label="lyrics-like">Introit. Státuit. p. 1182.</l><l xml:id="m-f3b75c50-2f76-4fc7-a9d5-4886530ae75c" facs="#m-5058490d-602f-492b-9f15-c49e77bf8cab" label="ambiguous">Collect.</l><l xml:id="m-c6a7df06-f268-4600-9364-ba5e7e1f9261" facs="#m-e29be5d7-9192-497c-991a-18bd24da9747" label="lyrics-like">Eus, qui beáto Petro Apóstolo ! intercessiónis ejus auxilio, * a pec¬</l><l xml:id="m-67bcf007-8fe7-4001-a792-f2cfa8a58b71" facs="#m-310dc03d-bc79-40b4-88c4-592a73653a6d" label="lyrics-like">I tuo, collátis clávibus regni cae- catórum nostrórum néxibus liberé¬</l><l xml:id="m-84b8f4bd-351d-41ed-a0c4-c03d2e422386" facs="#m-6bc275e3-e214-48a0-b9f4-988f197be6a1" label="lyrics-like">léstis, ligándi atque solvéndi pon-mur : Qui vivis et regnas cum Dec</l><l xml:id="m-e4f17868-d260-4d20-86b9-6cda3f6d76b6" facs="#m-8e78e23a-b367-45ae-a7a1-ae79b55db616" label="lyrics-like">tificium tradidísti:  concéde; ut Patre.</l><l xml:id="m-7a0781e5-c923-4127-b98f-0c4fde6d48ab" facs="#m-265fb926-9096-49a1-b8ee-d176e59a6f10" label="text-like">Commemoration of St. Paul. Collect.</l><l xml:id="m-ab44705d-2c82-4d30-9a1a-a317c9a23d52" facs="#m-003dcb9f-ef34-43ad-8963-910c1c6269a1" label="lyrics-like">Eus, qui multitúdinem géntium! mus; ut cujus commemoratiónem</l><l xml:id="m-0fcbafdc-d772-4a7f-9243-9b2d7551bb2d" facs="#m-8c97bf33-bde1-471e-af70-605b836f05c8" label="lyrics-like">U beáti Pauli Apóstoli praedica-cólimus, ejus apud te patrocinia</l><l xml:id="m-87bcad8f-c640-49ab-ac2a-42690688c9a7" facs="#m-552e610c-d22b-43e6-8543-5bee916f0ed4" label="lyrics-like">tióne docuisti :* da nobis, quaésu-Isentiámus.</l><l xml:id="m-f2e10e53-8012-4d75-9995-f6f148767cbe" facs="#m-4740106a-4e54-40c7-a192-fd008792091d" label="text-like">Commemoration of S. Prisca, Virgin et Martyr. Collect.</l><l xml:id="m-66034302-5ac1-48dc-b4f9-7ecc341ead63" facs="#m-1dd6fd79-9210-4575-94da-5f3a4d39cf52" label="lyrics-like">A, quaésumus, omnípotens ] cólimus; et ánnua solemnitáte lae¬</l><l xml:id="m-96183a37-5460-47b6-9e69-f18ecf5e2506" facs="#m-f03e7c71-d00f-4aac-8a59-bcec742f65bf" label="lyrics-like">1 Deus :* ut qui beâtae Friscae</l><l xml:id="m-04d5ce47-734a-4590-8601-66a3babd4ae3" facs="#m-81d8190a-c562-4524-ae13-3af1dc9c81ae" label="lyrics-like">témur, et tantae fidei proficiámus</l><l xml:id="m-b1a9bb1b-9587-48c6-9318-c06048ce7a3f" facs="#m-d11b86b0-912e-4c3b-bfb0-e3cd9d3a755c" label="lyrics-like">Virginis et Mártyris tuae natalitia lexémplo. Per Dóminum.</l><l xml:id="m-aa438d33-8b53-4b31-ab70-041b45c606c2" facs="#m-ce935e62-e019-408e-844c-ecfeedb117b2" label="ambiguous">Lectio Epistolae beati Petri Apostoli. T Petr. I.</l><l xml:id="m-0c6041b6-7350-4142-bd33-a8faf64db6e8" facs="#m-000f09aa-53a5-44ec-9132-e69c5573ef2c" label="lyrics-like">OEtrus Apóstolus Jesu Christi, lem, et incontaminátam, et immar¬</l><l xml:id="m-acb71569-e7b8-49e3-814b-cd1a2152bfe1" facs="#m-e0abde70-2a10-4bd8-ad77-4fa7a0affb15" label="lyrics-like">eléctis advenis dispersiónis Pon¬</l><l xml:id="m-09aa6366-2159-4838-b49d-3acda941580e" facs="#m-51d9e160-58ff-462f-ac1c-4daceaf1b4e1" label="lyrics-like">cescibilem, conservátam in caelis</l><l xml:id="m-e4131013-17df-45e7-a8cb-1d9e9fd2b86f" facs="#m-5203b146-61e3-43ee-94a9-31b50eb3bc33" label="lyrics-like">in vobis, qui in virtúte Dei custo¬</l><l xml:id="m-84c9e36f-dba6-4891-b601-e4124c893c54" facs="#m-952e7abc-db89-4e63-9aaf-16f5b57b7dc7" label="lyrics-like">ti, Galátiae, Cappadóciae, Asiae,</l><l xml:id="m-a8e82536-c253-4a3b-93cb-3f119be2e2b1" facs="#m-1733d9c1-e5ff-469b-9f61-0346985f646e" label="lyrics-like">dimini per fidem in salútem, pará¬</l><l xml:id="m-4cae49c4-3853-42ae-809c-2174f6b9528e" facs="#m-70d02e56-681e-4410-889c-19ebed9d7629" label="lyrics-like">et Bithyniae, secúndum praescién¬</l><l xml:id="m-099f69f8-7641-4dd5-a081-89d46bd42bd9" facs="#m-9a9d63f3-0b7f-4a21-83b6-3ec6f9db6c09" label="lyrics-like">tam revelári in témpore novíssimo.</l><l xml:id="m-257609b3-3bd8-4585-9877-3b3cc7a7c52b" facs="#m-d81b5e3a-701e-485b-ab6d-570b8840c15a" label="lyrics-like">tiam Dei Patris, in sanctificatiónem</l><l xml:id="m-657aa362-21ab-475d-b502-16d9278757fa" facs="#m-e0df0334-8dbf-4349-aa51-d11a54154194" label="lyrics-like">Spíritus, in obediéntiam et asper¬</l><l xml:id="m-16474fc3-1ba2-4d18-bd96-260e8fb3763e" facs="#m-9e3df411-87b5-4d7c-b9f6-0ff051358954" label="lyrics-like">In quo exsultábitis, módicum nunc</l><l xml:id="m-fcf47838-6059-4398-9694-c7345ec763b6" facs="#m-e9a790d8-6fae-4717-bfc4-05f387cd9b96" label="lyrics-like">si opórtet contristári in váriis tenta¬</l><l xml:id="m-0f6cda67-f67d-47ac-8118-9a7dfe071ef6" facs="#m-ea5da616-ac2f-431e-a937-83f66b4b14a7" label="lyrics-like">siónem sánguinis Jesu Christi : grá¬</l><l xml:id="m-81450dd0-4824-452e-9519-624fab856b59" facs="#m-9f3d55c6-932c-4ec4-ba8d-adee9ef8f18a" label="lyrics-like">tiónibus : ut probátio vestrae fidei</l><l xml:id="m-981bfd3e-311c-4e74-b5e9-01113afac249" facs="#m-6ef06283-b091-4029-a1ab-21cc5f2a61dc" label="lyrics-like">tia vobis, et pax multiplicétur.</l><l xml:id="m-d3300cd2-a588-4a32-8489-6bd7cad55b14" facs="#m-3f7d7cfb-fba2-437e-852e-56db4117e988" label="lyrics-like">multo pretiósior auro (quod per</l><l xml:id="m-b2bf0891-d779-4620-acaf-30b914542907" facs="#m-c9afbd55-5e67-4f1e-98e4-e0743f0e75e6" label="lyrics-like">Benedictus Deus, et Pater Dómini</l><l xml:id="m-636958fc-9be7-4698-a7e4-e91e55455c6e" facs="#m-4a3e0cd6-2331-41b2-9587-885f405a44f5" label="lyrics-like">ignem probátur) inveniátur in lau¬</l><l xml:id="m-5f1ffa3c-7eab-42b1-908e-e9b2703cf171" facs="#m-603a722d-5a97-48d5-85e2-e74d72666786" label="lyrics-like">nostri Jesu Christi, qui secúndum</l><l xml:id="m-9e4ec973-7557-483a-8e38-0084e08aed02" facs="#m-b80ea298-bae7-4033-869d-dd0f7f74dc70" label="lyrics-like">dem, et glóriam, et honórem, in</l><l xml:id="m-c01c204f-53b5-40c7-b9e3-96ff5c0f818f" facs="#m-1c8698a9-19f6-4dd2-99af-edcd01294d9c" label="lyrics-like">misericórdiam suam magnam rege¬</l><l xml:id="m-1bf43d1d-c7cd-49d9-af3f-14b64d763491" facs="#m-80177df1-48ab-4224-8a65-763aa379867e" label="lyrics-like">revelatióne Jesu Christi Dómini</l><l xml:id="m-76ffde91-735b-40ea-a907-4bb3462940fe" facs="#m-7521f795-fec6-4334-aaa8-7db29bfee190" label="lyrics-like">nerávit nos in spem vivam, per</l><l xml:id="m-378d3277-aa99-49ed-941b-81d7dca63826" facs="#m-f297b30b-dcea-4f8c-a152-5652293e1fec" label="lyrics-like">resurrectiónem Jesu Christi ex mór-]nostri.</l><l xml:id="m-53746338-b06d-4e38-8d80-22ea3baab4e8" facs="#m-820ab206-f958-4cdc-815e-515b8f7339af" label="lyrics-like">tuis, in haereditátem incorruptibi¬</l><l xml:id="m-ab0a694f-0f31-41b0-8b94-1bab7705d9c7" facs="#m-ba83dfa8-b906-4e04-8ccd-bad38f98e33f" label="ambiguous">Grad.</l><l xml:id="m-3636d1f9-c48c-4e95-a410-f87165b71b9c" facs="#m-cc446aa5-b155-40ca-a91a-f0cf6471c52c" label="ambiguous">5.</l><l xml:id="m-ce7fe76e-ffed-4f97-ab5a-829aad4c32dd" facs="#m-9ccd623c-ac3a-4711-9580-e3a1dd5ae7d8" label="lyrics-like">x-ál-tent é¬</l><l xml:id="m-173c3319-7e71-44b3-a9df-2c097d25c0a1" facs="#m-1ef1a981-ea26-4cf6-99bb-cae29847d20e" label="lyrics-like">um * in ecclé¬</l><l xml:id="m-c5778658-3cae-433f-b3ea-ad3412aedd04" facs="#m-8d3859dd-3d08-4dcb-ab1d-f22f5196a27d" label="ambiguous">si¬ a</l><l xml:id="m-7e1e97ab-27a0-4827-b5aa-3455fed7d581" facs="#m-734bcabd-7f6a-44c8-acae-fcd9b90e6996" label="ambiguous">seni¬</l><l xml:id="m-fc88a6f9-26f6-4185-af05-c2a597a4da67" facs="#m-8be3822e-1380-4db1-a74e-419c23b8327c" label="lyrics-like">bis: et in cáthedra</l><l xml:id="m-ffb7523f-3700-46e5-85bb-84ffb0bb2b34" facs="#m-21b95cb2-7b9c-4674-82c0-e8854c0aaa59" label="lyrics-like">plé¬</l></lg></div></section></score></mdiv></body></music>
