                    <nc xml:id="m-2fb759b2-1b06-4555-a31a-6920e6ca491e" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-e2d0861e-0784-4faf-89ef-bd769a72210f">
                  <syl /><neume facs="#m-37a06ad8-ec2e-4e40-95ae-7a5175250e24" type="cavum" xml:id="m-442831fd-4fd2-436d-b1d3-b11a485995d7">
                    <nc xml:id="m-ac8341b2-b3e1-42e0-a4f3-11dec03274d8" pname="g" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-1cb4c926-0073-421b-bbcd-73f564530c83">
                  <syl /><neume facs="#m-2192709f-4a48-47b4-af21-754ec38c2ee5" type="punctum" xml:id="m-bf99d8c1-9215-4b58-b9ff-6f9ab6f67e06">
