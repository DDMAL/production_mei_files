7" lrx="911" lry="1060" /><zone xml:id="m-29e5f3d3-27ca-4467-a0ac-82c27faca0b5" ulx="36" uly="1031" lrx="467" lry="1063" /><zone xml:id="m-c5f262d2-cef8-4209-8139-8b758a9f0f50" ulx="480" uly="1056" lrx="911" lry="1085" /><zone xml:id="m-6a6b9643-3913-4669-b19c-8cb408dc7c4f" ulx="37" uly="1057" lrx="465" lry="1092" /><zone xml:id="m-63ea167b-d2be-4003-91f0-0445cee448e6" ulx="480" uly="1081" lrx="911" lry="1113" /><zone xml:id="m-e2b517f5-527b-48ba-929d-12163ad023b3" ulx="37" uly="1085" lrx="126" lry="1124" /><zone xml:id="m-ff91176f-2169-4293-acd4-a6e870854f1f" ulx="481" uly="1105" lrx="911" lry="1145" /><zone xml:id="m-aef16d3f-f002-4d5c-b257-f6e61f16e532" ulx="67" uly="1125" lrx="436" lry="1163" /><zone xml:id="m-be6147cf-1526-424c-bc24-5d615776374f" ulx="480" uly="1134" lrx="911" lry="1172" /><zone xml:id="m-7d2f041e-9ccf-42ad-8bc6-89ca1fd0d3c1" ulx="64" uly="1161" lrx="466" lry="1196" /><zone xml:id="m-c583a363-30a7-4674-9908-ef249abe2526" ulx="479" uly="1166" lrx="911" lry="1195" /><zone xml:id="m-c2d7ac59-8b9a-4a97-a188-2ecff9681066" ulx="38" uly="1193" lrx="176" lry="1227" /><zone xml:id="m-0735012c-a983-4bd1-b360-9cdbc4d7179d" ulx="481" uly="1194" lrx="912" lry="1224" /><zone xml:id="m-860e9c8a-f717-469a-be20-5b4a51fcf5f1" ulx="480" uly="1216" lrx="910" lry="1251" /><zone xml:id="m-232c10ea-9946-4300-ae52-a346f24fee3c" ulx="63" uly="1218" lrx="468" lry="1261" /><zone xml:id="m-f734e7e5-13b5-4583-a9f1-2846f22c120f" ulx="37" uly="1248" lrx="350" lry="1284" /><zone xml:id="m-80d9298a-c697-4f67-a1d2-cf72f12704e2" ulx="481" uly="1250" lrx="908" lry="1278" /><zone xml:id="m-9af963ce-8dc4-4a87-a4a0-84bc04859d83" ulx="480" uly="1274" lrx="911" lry="1307" /><zone xml:id="m-0c4855fd-7fed-4c3f-af06-f2aaf0dd75bd" ulx="62" uly="1289" lrx="465" lry="1330" /><zone xml:id="m-8c1e8d06-ab12-487e-bc5b-1d379b878569" ulx="479" uly="1301" lrx="910" lry="1336" /><zone xml:id="m-12a98710-c2af-40bb-bee9-c9a72704380b" ulx="35" uly="1319" lrx="343" lry="1355" /><zone xml:id="m-49ca9ade-58f5-4177-b93d-9fa2ec10a4f5" ulx="479" uly="1328" lrx="909" lry="1363" /><zone xml:id="m-df400e53-2414-4c25-9724-a42a6b23c96e" ulx="61" uly="1353" lrx="910" lry="1388" /><zone xml:id="m-27952e8b-6d75-4991-83ae-4f394fed6cc5" ulx="35" uly="1386" lrx="909" lry="1419" /><zone xml:id="m-b279ae5f-3c2e-452d-ab8a-dc441bd997cd" ulx="35" uly="1410" lrx="905" lry="1451" /><zone xml:id="m-de9a2ade-998a-4f18-b6fa-9f4d5347dc5e" ulx="396" uly="1480" lrx="550" lry="1507" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-b49a3c63-ed08-4f1a-8703-bcbc46b580b5" n="0117" facs="#m-29dcb7ef-f44c-414d-a7a8-957c6b486da1" /><div xml:id="m-21ec92d0-2abc-4b9d-b70a-487500ad4fd8">
            <lg xml:id="m-5a2116fb-1c26-4f1f-b512-bd45deb58a99">
              <l xml:id="m-32f08bc5-f655-4c69-bfe0-486c93aabd05" facs="#m-2a5b4271-ea34-45a8-a7c7-76840afbc451" label="text-like">The Ordinary of the Ma¬¬</l><l xml:id="m-388f853f-bd90-46b2-98ff-8f1cc95a26c2" facs="#m-5a545e8a-80b6-4c21-bcb7-c5915fde0924" label="lyrics-like">mihi ad tutaméntum mentis et cór-l majestátis indígnus óbtuli, tibi sit</l><l xml:id="m-5a076d18-9829-43fb-8440-1559ea08af9b" facs="#m-2249eeba-d0d4-4bea-82e9-78a32397f579" label="lyrics-like">acceptábile, mihique, et ómnibus,</l><l xml:id="m-64f4e62b-8e64-4379-bd32-e59189798b73" facs="#m-d340482e-ca0f-4270-b4c9-7c38df4454c5" label="lyrics-like">poris, et ad medélam percipiéndam:</l><l xml:id="m-223f60b1-09c8-4fbb-b286-f4b5de39b773" facs="#m-825183dc-8ddd-414d-9ec4-bbd09ab502b4" label="lyrics-like">pro duibus illud óbtuli, sit, te mise¬</l><l xml:id="m-a2c98c9d-5193-41d8-85ab-a13109ebaf19" facs="#m-0167e509-128c-42e9-92d7-3542a2e22b70" label="ambiguous">qui vivis et regnas cum Deo Patre</l><l xml:id="m-7cdf914a-77a8-4216-a50b-5085fea50d42" facs="#m-cd46651a-ee8f-4f9a-81e2-5ee2fe1e01d2" label="lyrics-like">ránte, propitiabile. Per Christum</l><l xml:id="m-cf97ea9d-eccc-427c-abda-83a024382d2b" facs="#m-3a2c5639-9884-4520-9614-bc6e90855a81" label="lyrics-like">in unitáte Spinitus Sancti Deus, per</l><l xml:id="m-4f1f545e-220b-4f45-9dd9-033b20c60789" facs="#m-3dba8668-1c16-4420-9d3f-163483ab8c46" label="lyrics-like">Dóminum nostrum. Amen.</l><l xml:id="m-ed8060c3-57d3-478f-b44e-0957337b301e" facs="#m-d8e6b8b2-5b63-468a-b846-143c92ced898" label="lyrics-like">ómnia saécula saeculórum. Amen.</l><l xml:id="m-0b651205-70a5-4374-8cc7-e70ba6a436ae" facs="#m-6418bdcb-0b6c-4f85-b73d-c6fa1a9f4435" label="lyrics-like">Panem caeléstem accipiam, et</l><l xml:id="m-638c29e0-abe4-4101-b20a-d757f9227736" facs="#m-2f6e1138-4c11-444c-81b2-59e744fb526e" label="ambiguous">Benedicat vos omnipotens Deus,</l><l xml:id="m-ddb0ce25-9834-4482-bc58-1b3d418b6677" facs="#m-7e98856d-2d0e-4066-be9d-9fc292de3fd8" label="lyrics-like">nomen Dómini invocábo.</l><l xml:id="m-05e46aa4-a447-4d45-8393-fccaa94621f9" facs="#m-510a5c4f-b053-4e0e-8a72-53ecce237ec0" label="lyrics-like">Páter, et Filius, * et Spiritus Sán¬</l><l xml:id="m-21ab20d6-d18f-447c-a9d6-6b301804c7b0" facs="#m-ac242aba-5ea8-45f3-9581-85ee1886d492" label="ambiguous">ctus. K. Amen.</l><l xml:id="m-abecc567-4194-4135-ba9f-5c88d5607db0" facs="#m-06c159ec-cd52-472a-b755-f4075f8b4477" label="lyrics-like">Dómine, non sum dignus ut in¬</l><l xml:id="m-d5832c13-10f0-42f9-927a-bacbd5b2098c" facs="#m-0ea7df62-d7c4-47c0-b135-a660a60b4518" label="ambiguous">tres sub tectum meum: sed tantum</l><l xml:id="m-d298cdb5-195b-4203-987b-dd166ef142c5" facs="#m-7776a739-c48a-4fb2-95c6-112ce845ac9d" label="text-like">In Masses for the Dead, this final</l><l xml:id="m-a49782c9-e637-42bb-b2da-dd55a9160ce4" facs="#m-fd577cde-8352-4004-85da-500d7edb44a2" label="lyrics-like">dic verbo, et sanábitur ánima mea.</l><l xml:id="m-130bd905-8fbb-40c0-b0d4-2e650483f0f7" facs="#m-b61ad29b-0da5-481f-8cc4-78435f7ea557" label="text-like">Blessing is not given.</l><l xml:id="m-16a20f87-9d9e-47c3-972e-58f21e748e6f" facs="#m-6914bfa4-e31b-4375-a9e4-7a3d90b68919" label="lyrics-like">Córpus Dómini nostri Jesu Chri¬</l><l xml:id="m-5ff69e24-07f0-4e48-9f21-35632a31aab8" facs="#m-4f978425-066c-4cd2-94c6-dbe8e34f8f54" label="lyrics-like">V. Dóminus vobiscum. R. Et cum</l><l xml:id="m-b3a2af06-218a-40e5-9f95-25a4522c0fe1" facs="#m-d065c464-cb30-46fb-871a-58160b6b35bd" label="lyrics-like">sti custódiat ánimam méam in vi¬</l><l xml:id="m-7bfdbe37-2e49-41cd-bbc7-82708a60f9c1" facs="#m-bc672fab-49d5-4b9c-92c7-9b2e537ac81e" label="lyrics-like">spíritu túo.</l><l xml:id="m-ef806f82-6a6a-4f86-954a-f32fcfc0a9ad" facs="#m-0a655c13-3ed3-4b95-9c52-ce9a82f38ab3" label="lyrics-like">tam aetérnam. Amen.</l><l xml:id="m-2a6a1ae7-fa91-4c2e-8596-ea1729debd2d" facs="#m-3f75f1b5-b613-4587-98c4-eb69c987c892" label="lyrics-like">Inítium sancti Evangélii se¬</l><l xml:id="m-3696eef1-459e-47cf-9eec-68ec20e50af4" facs="#m-8873cd77-ef61-4b38-91e0-6bc993f2639c" label="lyrics-like">Quid retribuam Dómino pro óm¬</l><l xml:id="m-56e21005-e316-4c1a-852b-e7818f7a039a" facs="#m-d50db683-d34f-44eb-9a35-36f005608adb" label="lyrics-like">cúndum Joánnem. E. Glória tibi,</l><l xml:id="m-ca09368d-6fb4-49a3-80a7-e45cf48b5ac9" facs="#m-cf27f63b-52ad-49b3-85c1-4fcbdc5d353a" label="lyrics-like">nibus quae retribuit mihi? Cálicem</l><l xml:id="m-a8e8c8db-4be2-414e-b36c-ae9dfa324c9f" facs="#m-51a156a6-fa87-4c27-883a-817bcb5d903c" label="lyrics-like">Dómine.</l><l xml:id="m-0aa7b166-cb28-42d9-b2b1-6c61fe03bc4e" facs="#m-78244f7e-b285-4c41-a14c-e5cafca839f4" label="lyrics-like">salutáris accípiam, et nomen Dó¬</l><l xml:id="m-1ded034c-006a-4fbe-ac3e-6717bf204dbc" facs="#m-a5ee4f3a-398d-4c74-9618-4ed36ac33ad0" label="lyrics-like">IN princípio erat Verbum, et Ver¬</l><l xml:id="m-5881f7f1-c6a8-4b6a-89b3-961407024c5e" facs="#m-02e43982-9de8-457b-8349-ed55358f5e04" label="lyrics-like">mini invocábo. Laudans invocábo</l><l xml:id="m-916d1465-4753-4ae0-aba1-7ef8c4243d44" facs="#m-2b83543b-a8e2-4233-98fd-775fb60ce177" label="lyrics-like">Dóminum, et ab inimícis meis sal¬</l><l xml:id="m-d4122915-43fb-4446-bd2b-01dff3897a7a" facs="#m-80cff230-95ca-49db-8433-be64fdb68142" label="ambiguous">I bum erat apud Deum, et Deus</l><l xml:id="m-c595e6c6-668e-455f-bafb-c0e9496b8b56" facs="#m-981ba6c3-730b-4c29-962a-c3ae3f5e255d" label="ambiguous">vus ero.</l><l xml:id="m-667d3b92-07b6-44d7-a733-be0598a0a2b0" facs="#m-523e2757-bd9c-4a7a-ac1b-2b399d95034c" label="ambiguous">erat Verbum. Hoc erat in principio</l><l xml:id="m-b67cf865-206b-4021-971b-5ad3d34d14b4" facs="#m-cce2eb5d-193e-40fc-bee3-f7be520ec266" label="ambiguous">apud Deum. Omnia per ipsum fa¬</l><l xml:id="m-53241ad9-2366-499a-941d-db2d9596bdc9" facs="#m-b6486de2-fe81-4434-b3b4-69639864b651" label="lyrics-like">Sanguis Dómini nostri Jesu Chri¬</l><l xml:id="m-e0a83844-466d-46ed-a794-33785e79e8a6" facs="#m-b00bbb20-b69a-490c-a349-2c7fa7300772" label="ambiguous">cta sunt : et sine ipso factum est</l><l xml:id="m-e612c59c-5e7a-4446-993d-10cbd462d86f" facs="#m-ca023d96-78b2-4755-a9e7-c1a848cd0aad" label="lyrics-like">sti custódiat ánimam meam in vi¬</l><l xml:id="m-80535e12-10b4-4075-9a01-6706f2a579bd" facs="#m-bf934e99-0d4a-4b9e-900e-7b2a0bbd22bb" label="ambiguous">nihil, quod factum est : in ipso vita</l><l xml:id="m-467ef4a2-14d2-4f4a-8634-37b533906eb2" facs="#m-c86bcbad-325d-4683-b695-7c07f4c21ac7" label="lyrics-like">tam aetérnam. Amen.</l><l xml:id="m-4cfefe0a-9224-431e-a746-15c6a92d9db6" facs="#m-1b22dd2f-a0fe-47ce-847f-95bb50ee5305" label="lyrics-like">erat, et vita erat lux hóminum: et</l><l xml:id="m-7144731c-e53f-45c6-b284-64f9b9a11c29" facs="#m-bbce2e8e-7bb1-4223-9aa4-954773409a9b" label="lyrics-like">Quod ore súmpsimus, Dómine,</l><l xml:id="m-dc175014-24ef-4362-a943-ae43b442434d" facs="#m-5276ea61-6e0a-44bd-b07d-0546d554d9f1" label="lyrics-like">lux in ténebris lucet, et ténebrae</l><l xml:id="m-09d52e5e-9452-4f7f-89e6-7f2bfb6c01b8" facs="#m-9c796fdd-696b-4c2d-b1f4-0e0dff898a83" label="lyrics-like">pura mente capiámus : et de mú¬</l><l xml:id="m-7ab751f4-132d-466b-8f9d-704238597f80" facs="#m-af448286-e666-4be9-a81e-791338b3bd58" label="lyrics-like">nere temporáli fiat nobis remédium</l><l xml:id="m-eadf6afc-2f02-428d-97a3-56ed905046c7" facs="#m-3aadc180-95a7-45fd-a091-0872dcaa868a" label="ambiguous">homo missus a Deo, cui nomen erat</l><l xml:id="m-17678171-daa8-4db6-9624-ec42df27da93" facs="#m-5a9fc6bc-1628-40ef-9c62-471cc60a3c50" label="lyrics-like">sempitérnum.</l><l xml:id="m-f9227fe1-f161-4ded-8544-f5391e04c587" facs="#m-ac60f35e-bae1-43b5-ae1b-a1cbf6912110" label="lyrics-like">Joánnes. Hic venit in testimónium,</l><l xml:id="m-249ea37f-6330-43ef-b758-d33aed047128" facs="#m-0cd8e094-ef55-4ea5-8dd5-6c1f9489b32e" label="lyrics-like">Corpus tuum, Dómine, quod</l><l xml:id="m-6e405f82-76b5-4240-a631-d01fe53ef040" facs="#m-a4d48942-32bd-459a-8941-360d5e225cb6" label="lyrics-like">ut testimónium perhibéret de lúmi¬</l><l xml:id="m-bff7b158-f7fb-4a97-9685-f8509277a1c7" facs="#m-3246ac6e-b4c6-48e4-b1ee-f7c46aa58c4c" label="lyrics-like">ne, ut omnes créderent per illum.</l><l xml:id="m-7f1753d5-29bb-45a1-a00c-6376b7314570" facs="#m-c762142f-77b0-47a5-ae0e-edaab9d88ed3" label="lyrics-like">sumpsi, et Sanguis, quem potávi,</l><l xml:id="m-e577d310-0b7c-43f6-9569-508384945ad0" facs="#m-f94ee933-37d2-4044-aa25-8d65784abffe" label="lyrics-like">Non erat ille lux, sed ut testimónium</l><l xml:id="m-66c8cd61-7a57-47db-b5ac-cb554b700040" facs="#m-c0047089-4ebd-450e-922c-4599b18b1def" label="lyrics-like">adhaéreat viscéribus meis: et prae¬</l><l xml:id="m-732ceb73-695b-49ef-8e65-73512f035f76" facs="#m-889c1812-4eb7-4eb2-bfbe-5f81d18bd470" label="lyrics-like">perhibéret de lúmine. Erat lux vera,</l><l xml:id="m-279b8394-87eb-4c29-ab9c-d2b5862ec663" facs="#m-9ca43597-95d3-4eaf-8388-d5e6cdd2eb8d" label="lyrics-like">sta; ut in me non remáneat scéle¬</l><l xml:id="m-cd53fcc2-5ff9-419a-a99b-8284f5ab7afa" facs="#m-26ed04e1-a7f3-4089-967c-5798980cd015" label="lyrics-like">quae illúminat omnem hóminem</l><l xml:id="m-2cccf7a0-1eaa-42f9-9a22-26359f88ca73" facs="#m-b817c48a-14b3-4098-b8b3-6117d41692fe" label="lyrics-like">rum mácula, quem pura et sancta</l><l xml:id="m-226e265b-9d70-4d3a-933c-c5312cebbc0a" facs="#m-6cfd677f-413f-4442-8313-a7218e4b31a4" label="lyrics-like">veniéntem in hunc mundum. In</l><l xml:id="m-c0afe731-6ba3-4c79-926d-06ba74b18579" facs="#m-29e5f3d3-27ca-4467-a0ac-82c27faca0b5" label="lyrics-like">refecérunt sacraménta: Qui vivis</l><l xml:id="m-3e8faa6d-a500-4021-8594-a0cc75aed6d4" facs="#m-c5f262d2-cef8-4209-8139-8b758a9f0f50" label="ambiguous">mundo erat, et mundus per ipsum</l><l xml:id="m-49e60c73-172e-4d99-a74d-e3c28246302c" facs="#m-6a6b9643-3913-4669-b19c-8cb408dc7c4f" label="lyrics-like">et regnas in saécula saeculórum.</l><l xml:id="m-236b0149-c5ce-463e-82d3-7f5b8c61567b" facs="#m-63ea167b-d2be-4003-91f0-0445cee448e6" label="ambiguous">factus est, et mundus eum non co¬</l><l xml:id="m-4e510328-f831-4f52-9d62-df40830926a1" facs="#m-e2b517f5-527b-48ba-929d-12163ad023b3" label="ambiguous">Amen.</l><l xml:id="m-0cce9e16-678b-40ac-9af7-eb2299a8ef49" facs="#m-ff91176f-2169-4293-acd4-a6e870854f1f" label="lyrics-like">gnóvit. In própria venit, et sui eum</l><l xml:id="m-30713584-fdbb-4fb4-866e-839361da8d4d" facs="#m-aef16d3f-f002-4d5c-b257-f6e61f16e532" label="text-like">After the last Postcommunion:</l><l xml:id="m-b8d69a43-14bc-4bb7-b957-33c3accde286" facs="#m-be6147cf-1526-424c-bc24-5d615776374f" label="lyrics-like">non recepérunt. Quotquot autem</l><l xml:id="m-7954a886-d649-4b86-b99a-322fe06cc090" facs="#m-7d2f041e-9ccf-42ad-8bc6-89ca1fd0d3c1" label="lyrics-like">V. Dóminus vobiscum. K. Et cum</l><l xml:id="m-e6361762-3a20-4547-a994-05ed8518a1ce" facs="#m-c583a363-30a7-4674-9908-ef249abe2526" label="lyrics-like">recepérunt eum, dedit eis potestá¬</l><l xml:id="m-9c48fcc0-a640-41d4-9637-a985067cfa21" facs="#m-c2d7ac59-8b9a-4a97-a188-2ecff9681066" label="lyrics-like">spiritu túo.</l><l xml:id="m-e94ab951-c3f2-40de-8373-843c606d5048" facs="#m-0735012c-a983-4bd1-b360-9cdbc4d7179d" label="ambiguous">tem filios Dei fieri, his qui credunt</l><l xml:id="m-259d8a58-2195-485f-a025-f1b5e8eccdc8" facs="#m-860e9c8a-f717-469a-be20-5b4a51fcf5f1" label="lyrics-like">in nómine ejus, qui non ex sangui¬</l><l xml:id="m-3050a7af-ad2c-4111-ae33-5e0e4fac1f35" facs="#m-232c10ea-9946-4300-ae52-a346f24fee3c" label="lyrics-like">Ite, míssa est, vel Benedicámus</l><l xml:id="m-e914e3dc-db0d-43ee-ba4d-52297ad11b4e" facs="#m-f734e7e5-13b5-4583-a9f1-2846f22c120f" label="lyrics-like">Dómino. R. Déo grátias.</l><l xml:id="m-dc414bd9-b744-45dc-b98a-60feaef701e4" facs="#m-80d9298a-c697-4f67-a1d2-cf72f12704e2" label="lyrics-like">nibus, neque ex voluntáte carnis,</l><l xml:id="m-5c7f9ed7-c890-44c4-a7b5-404adbdead42" facs="#m-9af963ce-8dc4-4a87-a4a0-84bc04859d83" label="lyrics-like">neque ex voluntáte viri, sed ex Deo</l><l xml:id="m-9eb68c70-1b2b-4333-ac8c-456a26843184" facs="#m-0c4855fd-7fed-4c3f-af06-f2aaf0dd75bd" label="lyrics-like">In Masses for the Dead : Requié¬</l><l xml:id="m-f341b607-9f2d-4f92-8dde-f303a22d4835" facs="#m-8c1e8d06-ab12-487e-bc5b-1d379b878569" label="ambiguous">nati sunt. ET VERBUM CARO FA¬</l><l xml:id="m-c553cf48-ffe0-476d-b39e-ac47eb2e4d39" facs="#m-12a98710-c2af-40bb-bee9-c9a72704380b" label="lyrics-like">scant in pá̂ce. R. Amen.</l><l xml:id="m-d62e4f7c-7794-4385-9e7c-0c003772e9f8" facs="#m-49ca9ade-58f5-4177-b93d-9fa2ec10a4f5" label="lyrics-like">CTUX EST, et habitávit in nobis:</l><l xml:id="m-a863dfe3-6e2d-4e7c-b969-5353e00c932f" facs="#m-df400e53-2414-4c25-9724-a42a6b23c96e" label="lyrics-like">Pláceat tibi, sancta Trínitas, ob-let vidimus glóriam ejus, glóriam</l><l xml:id="m-80912970-029c-4b17-9f6f-0bca8e936777" facs="#m-27952e8b-6d75-4991-83ae-4f394fed6cc5" label="lyrics-like">séquium servitútis meae : et prae-quasi Unigéniti a Patre, plenum</l><l xml:id="m-5a3f11fa-4e33-4053-a3a4-faa246cdeccf" facs="#m-b279ae5f-3c2e-452d-ab8a-dc441bd997cd" label="lyrics-like">sta; ut sacrificium, quod óculis tuae! grátiae et veritátis. B. Deo grátias.</l><l xml:id="m-d74934dc-85a9-443d-a7d1-50561d545920" facs="#m-de9a2ade-998a-4f18-b6fa-9f4d5347dc5e" label="ambiguous">— mv–—</l></lg></div></section></score></mdiv></body></music>
</mei>