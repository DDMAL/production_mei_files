y="996" /><zone xml:id="m-4e01e243-d919-486c-8330-a4fce2519a51" ulx="37" uly="963" lrx="433" lry="996" /><zone xml:id="m-1a7a42d4-1d25-4269-8a3c-53c590337d7c" ulx="446" uly="986" lrx="843" lry="1024" /><zone xml:id="m-d6fb681e-db3f-40ea-a396-5f69b1cde3f1" ulx="36" uly="989" lrx="434" lry="1020" /><zone xml:id="m-2332e3bb-a313-4f7f-af3c-a48a96f73505" ulx="444" uly="1014" lrx="843" lry="1047" /><zone xml:id="m-ad26073a-3cb5-4659-9697-a573044d6185" ulx="35" uly="1015" lrx="435" lry="1051" /><zone xml:id="m-65f32db9-c212-4258-8fd8-8b0159ba9119" ulx="442" uly="1040" lrx="843" lry="1077" /><zone xml:id="m-041e8214-3acf-4486-93df-564c9d7ca483" ulx="35" uly="1045" lrx="433" lry="1074" /><zone xml:id="m-b8425f26-0634-4f9d-8142-88fa56c75fb2" ulx="37" uly="1067" lrx="589" lry="1101" /><zone xml:id="m-65c5d91d-91d7-4bfd-9590-b37afcb18f97" ulx="62" uly="1097" lrx="844" lry="1138" /><zone xml:id="m-caefce5e-a04a-45d4-afe5-50e0bd272aad" ulx="35" uly="1128" lrx="316" lry="1162" /><zone xml:id="m-debc7d2b-f64a-439f-b25f-1afa53b3ee79" ulx="132" uly="1170" lrx="287" lry="1202" /><zone xml:id="m-9e06ad15-a6ab-4c7a-9fa8-7a406c526beb" ulx="433" uly="1170" lrx="843" lry="1203" /><zone xml:id="m-f6d73c96-e6fa-43fe-817d-7b9fa08590e7" ulx="84" uly="1234" lrx="104" lry="1268" /><zone xml:id="m-bcb448fc-720a-4f50-87da-d8a24134a4a3" ulx="66" uly="1257" lrx="127" lry="1332" /><zone xml:id="m-30252ca9-eea4-4619-bdaf-b7055ca53c3e" ulx="155" uly="1297" lrx="290" lry="1335" /><zone xml:id="m-ba5f96b9-aa3e-420b-a457-fd672902a9de" ulx="531" uly="1297" lrx="839" lry="1334" /><zone xml:id="m-4869416c-8ad9-4428-9233-e8e85f36438f" ulx="60" uly="1425" lrx="110" lry="1466" /><zone xml:id="m-e82c5951-c8e2-4102-8893-3d3b079a5080" ulx="336" uly="1427" lrx="508" lry="1466" /><zone xml:id="m-580db377-ae4c-4de6-adfd-78e65b12ae98" ulx="643" uly="1427" lrx="790" lry="1469" /><zone xml:id="m-3ec3810f-0364-4ee6-8fbd-ded4383a78f4" ulx="169" uly="1430" lrx="223" lry="1467" /></surface>
    </facsimile>
    <body xml:id="m-175208e1-0a9e-484b-8299-56fa8c9410a8">
      <mdiv xml:id="m-e8f052dc-fdd1-4da1-93c8-ff7560ecd869" type="solesmes">
        <score xml:id="m-98c94dc6-be63-4c41-b363-999de78c099f">
          <scoreDef xml:id="m-f3839bf9-f0bb-403b-be8f-c45309b6e37b">
            <staffGrp xml:id="m-20e2b3d9-7d2f-4544-b1fb-c96d6815f41a">
              <staffDef xml:id="m-cc68bdcc-a09d-4b36-ab08-e7faecf1eb03" n="1" notationtype="neume" lines="4" />
            </staffGrp>
          </scoreDef>
          <section xml:id="m-6815f182-2856-4554-94f6-b6a31504935e">
            <pb xml:id="m-8899a378-1998-47a6-9016-374c1e2181c6" n="867" facs="#m-5f51ce05-eba3-4f92-bb8e-71678fe45c05" />
            <staff xml:id="m-89be2cc3-ebdb-4d37-b934-bcf238fa3f25" n="1">
              <layer xml:id="m-79a23a0e-83ee-48f7-96bb-5e40159e6225" n="1">
                <sb xml:id="m-86f8cb8a-131b-402f-aeab-09e123676799" n="1" facs="#m-559fbd48-4247-4da9-ae5f-1dfb94bc404a" />
                <sb xml:id="m-cc44fb89-e0e9-4148-b069-3aa73bf051d0" n="2" facs="#m-3ed12faf-f78c-4a70-8c2c-755afab4e34e" />
              </layer>
            </staff>
            <div xml:id="m-2b313e81-2c3e-471e-af90-e64498942ad2">
              <lg xml:id="m-e2d54915-0c8b-4af1-bedf-bbe94ae5618b">
                <l xml:id="m-1899c01f-8680-48e3-b4d0-318fe5f60299" facs="#m-687ba4d2-690d-4f9d-be0b-a495eebcc4fb" label="text-like">The Solemn afternoon Liturgy</l><l xml:id="m-2db4f77b-bb42-4937-9dca-bf37152d52b8" facs="#m-9f2417df-0b9a-426b-a879-2b3185453d2a" label="ambiguous">721</l><l xml:id="m-d94dd97a-b24f-4521-900a-75f064bcc01a" facs="#m-fc4fd729-55dc-457f-9685-1e97d48ac0d7" label="text-like">before the altar, while the rest go to their places in choir and remain Eneelins</l><l xml:id="m-f5071336-83cb-4b74-a5a5-9c577e2b516c" facs="#m-337ee99f-529b-4af1-a52b-8649c4876dac" label="text-like">and bouing Hhe servers Eneel in the sanctuary, bouing near the celebranil.</l><l xml:id="m-84b1eaf5-c05a-4a17-8cb4-a8d0a30886db" facs="#m-023506aa-3da2-48f9-a54d-5e21eb50775b" label="text-like">All pray in silence for a litile while.</l><l xml:id="m-ff012c41-89ad-4d9e-b5c5-8770352cb985" facs="#m-3e509d93-488c-4811-a1d8-3b656fd4a8a1" label="text-like">6. When the sien is given, the bow is ended but all remain kneeling; the</l><l xml:id="m-c57f6a2a-4706-4263-95bd-0e6ec928ec35" facs="#m-77d35a90-7884-4aef-902b-24add26d5791" label="text-like">celebrant alone stands facing the altar steps, and uith his hands joined sines</l><l xml:id="m-23eae6a5-1ae8-4512-ab8a-11460b98793d" facs="#m-4b1ef1b2-22f0-4295-b876-0038955ba5d5" label="lyrics-like">the follouing Prayer tó the ferial tone E (or ancient simple tone):</l><l xml:id="m-74f4eac9-99dd-4622-bcfb-2bc37b52ed5e" facs="#m-e171626a-eb22-4edf-99c1-aab37395766a" label="text-like">Prayer.</l><l xml:id="m-d06f629d-298d-4d83-92fb-b78c1cca8d77" facs="#m-8ce99e3c-17b7-498f-8d56-06bcbfd9395a" label="lyrics-like">Eus, qui peccáti véteris here¬em terrénae natúrae necessitáte</l><l xml:id="m-05dfe8bc-7dde-47a9-8ece-fec4db5f0701" facs="#m-f43d8bae-2e07-4e88-bdbf-7de1fdb9825b" label="lyrics-like">Uditáriam mortem, in qua po¬portávimus, *ita imáginem</l><l xml:id="m-f1c2fc55-699e-4aad-9a39-9d29effb5b6e" facs="#m-a9506530-138a-4fa1-8399-9e316791dba8" label="lyrics-like">caeléstis grátiae sanctificatióne</l><l xml:id="m-daa0632f-e384-42a8-9c3c-8f6f4dbef20f" facs="#m-d5582d2b-d398-4ba6-a616-a9f8e36bb668" label="lyrics-like">steritátis genus omne succés¬</l><l xml:id="m-2d8b8b65-c314-4224-99b8-803e8f79edc0" facs="#m-8e5bf363-1ac1-411a-8398-ddc40d1165d8" label="lyrics-like">serat, Christi tui, Dómini nostri,</l><l xml:id="m-5454db5a-8db1-48fa-bfd5-4b3e7b874321" facs="#m-76bcdd0b-60c5-4eb9-8734-ea4ee9dcd905" label="lyrics-like">portémus. Per eúmdem Christum</l><l xml:id="m-e7aed809-6b0b-49ce-8ba6-2dbff579961e" facs="#m-181efbb4-cc3b-43f5-87fc-72c76942d4ac" label="lyrics-like">passióne solvísti : f da, ut, con¬Dóminum nostrum.</l><l xml:id="m-e6f911a8-ffae-4c71-96a9-e4aeb562957b" facs="#m-6d2581b0-3b06-4051-9397-76be70ef5bfc" label="lyrics-like">fôrmes eidem facti; sicut imági¬er:Amen.</l><l xml:id="m-eb1f92ab-3010-46b3-a53e-bd3dedf04cb2" facs="#m-7afecded-8355-49ac-9fe6-4b583e8d1387" label="text-like">7. After the Prayer the celebrant and the ministers lor serversl go back to</l><l xml:id="m-7984f00d-7f32-40fc-9b01-d761b18f3d4a" facs="#m-beeb0952-a62c-4b6b-b83e-c1784697e15c" label="text-like">their places. Meanwhile an unadorned lectern is placed in the sanctuary and</l><l xml:id="m-bee49f3c-9278-4aa4-92b0-c20e1638599f" facs="#m-0fe7f088-e539-4750-98c8-20f0c980eb81" label="text-like">a reader sings the first Lesson, while all sit and listen. The Lesson begins</l><l xml:id="m-39e2abc5-d5f3-488b-bc23-dac8c6d594c6" facs="#m-ce7331db-0f40-4f25-b24a-5cde86e09082" label="text-like">without a tiile, and Tu autem is not said at the end.</l><l xml:id="m-2d6d0df2-458d-4472-95bc-31046392312c" facs="#m-0c32bf14-427e-44e0-9481-2b7c2662af1a" label="text-like">t7a. If the liturgy is sung and there is a capable reader, a lectern, uncovered,</l><l xml:id="m-7c877776-730a-4d43-8a6b-76150fd45fdb" facs="#m-7cc1aa26-33c2-4cc9-8b98-18637b95ae95" label="text-like">is placed in the middle of ihe sanctuary and the reader, in surplice, sings the</l><l xml:id="m-d24cc16c-4099-4ff4-80ae-e87b39c749f2" facs="#m-c0a689b3-17c6-4c9b-b647-5067196ba3bc" label="lyrics-like">first Lesson without title. The celebrant, servers and people sit aná lisien.</l><l xml:id="m-c7ee0326-16d6-4e22-8e80-92b6b051b496" facs="#m-ddf10c06-9e1e-4bc1-8e00-1911f6d9ad58" label="text-like">If the liturgy is not sung, or there is no reader, the celebrant himself,</l><l xml:id="m-cbd49dd6-0bff-4a90-837a-3487b8cf535e" facs="#m-1850be64-1662-4941-bcc9-39498e8c344a" label="text-like">standing in his place before an uncovered lectern, sings or reads the Lessonl.</l><l xml:id="m-4c7316d3-9a49-4873-9103-8b1014998e00" facs="#m-8a742768-a111-4453-9900-dde1dabcea4b" label="ambiguous">Os. 6, 1-6</l><l xml:id="m-ca652fb5-d16d-4496-ba1e-a530dc54fe2b" facs="#m-099d26f4-879b-4cb3-a459-9233f4068234" label="ambiguous">LESSON I</l><l xml:id="m-e558c0e3-05a4-4c1b-9ac9-1dde54b54c80" facs="#m-a0fecfec-eca0-4ec3-9f20-75ae3b4cbbe7" label="lyrics-like">KÆC dicit Dóminus : In tribu- nobis temporáneus, et seróti¬</l><l xml:id="m-e51872c7-bf23-46c4-a721-ebb7d60b8537" facs="#m-63342a84-802a-4d37-b804-a614264f30f3" label="lyrics-like">nus terrae. Quid fáciam tibi,</l><l xml:id="m-99e7a1e7-fc03-41a0-b17b-95e58c3c8ce9" facs="#m-5d95ef32-bfad-46be-a1c4-8ff09dff95ff" label="lyrics-like">Et latióne sua mane consúrgent</l><l xml:id="m-0e2b4594-a007-4e84-a496-38c5686dc19f" facs="#m-f5d0fbcd-c0e4-4e41-80d8-8a8f33dd80f0" label="lyrics-like">ad me : Venite, et revertámur</l><l xml:id="m-70d624a4-2dcd-4c31-b99d-4ff0a340c1e5" facs="#m-0ed4095c-dd08-486a-a03e-bcbde41e704c" label="lyrics-like">Ephraim? Quid fáciam tibi. Juda?</l><l xml:id="m-f792bf5a-fd35-4791-90f1-db65be19828d" facs="#m-261aec1a-e0f4-4b4b-ba48-a3bfc72391cf" label="lyrics-like">ad Dóminum: quia ipse cepit,</l><l xml:id="m-8b02c9a9-14c1-49b9-b100-ffe9f02c42ad" facs="#m-32533ad8-9935-43d5-9512-2755505946e2" label="lyrics-like">misericórdia vestra quasi nubes</l><l xml:id="m-26178bed-cce2-4c6f-a567-958cbdc91a41" facs="#m-f2ba8f18-76d7-4e47-84e4-29bc6cb29eca" label="lyrics-like">et sanábit nos: percútiet, et</l><l xml:id="m-2b047000-3c62-41ff-9761-2c7e094b188d" facs="#m-fe317dd2-e9a7-43f6-ac51-04221be7d36f" label="lyrics-like">matutína: et quasi ros mane</l><l xml:id="m-a1103172-de31-4cb3-ba4a-ba42454907d9" facs="#m-b83aa63e-72aa-40eb-b82a-73c704489871" label="lyrics-like">pertránsiens. Propter hoc dolávi</l><l xml:id="m-9a3de360-f57b-4c98-a5ae-19361ddbad0b" facs="#m-8da8b60d-e196-4e8b-b469-1758c49e1672" label="lyrics-like">curábit nos. Vivinicábit nos post</l><l xml:id="m-92f46d3b-8976-4daa-a7ee-8b9780fe3fcc" facs="#m-3c085369-8b97-4001-98aa-f7fa272cd973" label="lyrics-like">in prophétis, occidi eos in verbis</l><l xml:id="m-6a81ddfc-69ac-4637-b077-2bef8d7162eb" facs="#m-cd60323e-885a-4563-bb92-018d722d1e50" label="lyrics-like">duos dies : in die tértia suscitábit</l><l xml:id="m-5eaaa486-e379-413a-b21b-43340376ed70" facs="#m-0d6ffc1c-ca2d-4093-86d4-daa3c6a936f7" label="lyrics-like">oris mei: et judícia tua quasi</l><l xml:id="m-94581fcc-e383-4943-9ea6-8e6df6fac841" facs="#m-4e01e243-d919-486c-8330-a4fce2519a51" label="lyrics-like">nos, et vivémus in conspéctu</l><l xml:id="m-c8bbbaa4-b180-44ea-9935-26c55e4fda88" facs="#m-1a7a42d4-1d25-4269-8a3c-53c590337d7c" label="lyrics-like">lux egrediéntur. Quia misericór¬</l><l xml:id="m-e8d03cee-0255-4052-b1ad-20be333f57ba" facs="#m-d6fb681e-db3f-40ea-a396-5f69b1cde3f1" label="lyrics-like">ejus. Sciémus, sequemúrque, ut</l><l xml:id="m-73bc8a2d-a111-44af-82b5-d457da08fc75" facs="#m-2332e3bb-a313-4f7f-af3c-a48a96f73505" label="lyrics-like">diam vólui, et non sacrificium,</l><l xml:id="m-2de212d6-d702-4193-9545-134addb69c22" facs="#m-ad26073a-3cb5-4659-9697-a573044d6185" label="lyrics-like">cognoscámus Dóminum: quasi</l><l xml:id="m-705c0e81-5b55-472d-aa71-5f2ac82e9afc" facs="#m-65f32db9-c212-4258-8fd8-8b0159ba9119" label="lyrics-like">et sciéntiam Dei plus quam</l><l xml:id="m-6cc587d6-472f-4a0f-98c1-87f898e294ea" facs="#m-041e8214-3acf-4486-93df-564c9d7ca483" label="lyrics-like">dilúculum praeparátus est egrés¬</l><l xml:id="m-b5d15c3d-e77a-435c-b142-34d41e0f298e" facs="#m-b8425f26-0634-4f9d-8142-88fa56c75fb2" label="lyrics-like">sus ejus, et véniet quasi imber holocáusta.</l><l xml:id="m-19237803-14f9-4fce-b203-b96eb67c10c0" facs="#m-65c5d91d-91d7-4bfd-9590-b37afcb18f97" label="text-like">The follouing Responsory is sung by the schola and clergy, or recited by the</l><l xml:id="m-24706ab1-aa0b-430e-b0f4-0f09e82d38bb" facs="#m-caefce5e-a04a-45d4-afe5-50e0bd272aad" label="lyrics-like">celebrant uith ĩhe servers:</l><l xml:id="m-1920d9d0-6471-4d0c-b171-8952d73bac09" facs="#m-debc7d2b-f64a-439f-b25f-1afa53b3ee79" label="ambiguous">Responsory</l><l xml:id="m-a01265a6-dbba-497b-addd-8eaba0cc06e2" facs="#m-9e06ad15-a6ab-4c7a-9fa8-7a406c526beb" label="text-like">Prayer of the prophet Habacue, 3, 1-3.</l><l xml:id="m-7b367610-8dc2-496c-873d-d308d277239c" facs="#m-f6d73c96-e6fa-43fe-817d-7b9fa08590e7" label="ambiguous">2</l><l xml:id="m-66499fc9-afc3-40b2-8052-fd8e40f6402e" facs="#m-bcb448fc-720a-4f50-87da-d8a24134a4a3" label="ambiguous">D</l><l xml:id="m-00900181-af7d-4232-82c9-c35e3883e3c7" facs="#m-30252ca9-eea4-4619-bdaf-b7055ca53c3e" label="ambiguous">Omi- ne,</l><l xml:id="m-c1a43f1e-d3b6-44ad-9222-9ebf172353a4" facs="#m-ba5f96b9-aa3e-420b-a457-fd672902a9de" label="lyrics-like">audí-vi audí-tum</l><l xml:id="m-1760d73e-95b4-4aa7-be6f-b27c51f5e823" facs="#m-4869416c-8ad9-4428-9233-e8e85f36438f" label="lyrics-like">tú¬</l><l xml:id="m-85fd6437-f237-400c-94b7-07cb382cfb87" facs="#m-e82c5951-c8e2-4102-8893-3d3b079a5080" label="lyrics-like">et tí-mu-i:</l><l xml:id="m-a1503055-f4e1-49aa-8f2d-d739fd5f2614" facs="#m-580db377-ae4c-4de6-adfd-78e65b12ae98" label="lyrics-like">conside rá¬</l><l xml:id="m-6fed36c6-3d38-4263-aa4b-c83bc357159a" facs="#m-3ec3810f-0364-4ee6-8fbd-ded4383a78f4" label="ambiguous">um,</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>