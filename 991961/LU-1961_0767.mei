43d4-8653-5ba819b179fb" ulx="27" uly="1277" lrx="429" lry="1307" /><zone xml:id="m-5c9ccefd-d737-46ef-8a44-49a70a420288" ulx="440" uly="1279" lrx="599" lry="1308" /><zone xml:id="m-1376fbd1-250c-4f7e-82d7-717da92e4106" ulx="465" uly="1303" lrx="837" lry="1334" /><zone xml:id="m-da3f16b7-deac-4f3a-9b31-d3eab2b1cac9" ulx="28" uly="1306" lrx="428" lry="1335" /><zone xml:id="m-a0ddba7b-a08d-4fb8-ac0f-01b309acbc45" ulx="26" uly="1329" lrx="428" lry="1364" /><zone xml:id="m-c33fa60f-a21a-4e4a-87db-578896220a3b" ulx="438" uly="1331" lrx="837" lry="1364" /><zone xml:id="m-4b47220f-c230-450d-b80a-e35b9364a32f" ulx="28" uly="1356" lrx="426" lry="1387" /><zone xml:id="m-dcb278f7-84e6-489f-aa62-91a2ee894429" ulx="439" uly="1357" lrx="837" lry="1387" /><zone xml:id="m-ceb47498-40dc-4b05-a605-491e674d3bbb" ulx="437" uly="1382" lrx="836" lry="1415" /><zone xml:id="m-d3f90dc1-a049-439f-b3a7-de83bff6b7f2" ulx="30" uly="1387" lrx="429" lry="1412" /><zone xml:id="m-553a7941-9d76-4813-987c-5aeed0c53337" ulx="27" uly="1407" lrx="835" lry="1443" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-ed914846-020f-4c43-8256-2f0e2f5ffbfa" n="0767" facs="#m-469a3aa9-dc08-46c4-b01a-f82b9cfdaa98" /><div xml:id="m-e5566295-c04f-4131-920e-64c31d157165">
            <lg xml:id="m-5fbf50a1-7c68-4ddd-a2da-d1ea7b75d666">
              <l xml:id="m-dcba6e81-b344-4dac-9850-aa6254c5c195" facs="#m-a05bf0e5-0148-4d68-9921-e7eb72e0628f" label="ambiguous">Wednesday in Holy Week</l><l xml:id="m-0d379bd0-9d56-47f4-b768-c1ed3a7ab034" facs="#m-c8c8b03d-6757-4b76-ad54-308667f56ce7" label="ambiguous">621</l><l xml:id="m-733e0a0b-d3a3-4675-970f-81e9d4357ba7" facs="#m-0eed4f7e-1d0d-4062-a694-b5dfc39083be" label="ambiguous">Passio Domini nostri Jesu Christi secundum Lucam</l><l xml:id="m-63572e97-ddce-4423-ab33-7921c584208c" facs="#m-3ede2a4c-949a-4d93-a3ef-1f6d78d041de" label="lyrics-like">N illo témpore: Egréssus Jesus tidie vobíscum fúerim in templo,</l><l xml:id="m-ab5924d3-f26b-4bdf-856e-f57e7cd217c1" facs="#m-7cd98107-ce8a-4755-b55d-cdf3ae4e79c6" label="lyrics-like">L ibat secúndum consuetúdinem</l><l xml:id="m-6b5d7286-b8cc-4461-8c4d-199256d6fb21" facs="#m-e4ecd29b-e0dd-452b-a6a8-44778f0d6b6e" label="lyrics-like">non extendístis manus in me:</l><l xml:id="m-735122e4-f551-448a-bf16-77b47580f407" facs="#m-280bc2c2-52cb-4597-aa8c-6bba539c0b9c" label="lyrics-like">in montem Olivárum. Secúti</l><l xml:id="m-9e26d454-9b37-42bb-bc81-44d766a321bb" facs="#m-df3dc40a-fb20-4b5d-90cd-affe8a9939b9" label="ambiguous">sed haec est hora vestra, et</l><l xml:id="m-f8f58923-40dc-4768-90b3-c1ab19151334" facs="#m-ff1485dd-1060-4c95-bd58-be24f7b682ce" label="lyrics-like">sunt autem illum et discípuli.</l><l xml:id="m-56c50619-15fd-4264-aa36-f3baee4db971" facs="#m-1a003a57-a403-406d-a153-be89dfe66c39" label="lyrics-like">potéstas tenebrárum.</l><l xml:id="m-ade9c72b-2832-4c28-88ee-b1e242883582" facs="#m-c4dd6cd9-f17b-4451-8b9d-8bc6c185c8a5" label="ambiguous">Et cum pervenisset ad locum,</l><l xml:id="m-0ae9e4c4-e80b-428e-b44d-9ec4c89eb239" facs="#m-8b31f135-0d67-4c93-b203-c6264de8deba" label="lyrics-like">C. Comprehendéntes autem</l><l xml:id="m-a492de77-d729-47a5-a21f-b92609bf31ad" facs="#m-c23d9f10-9db9-4973-8a22-ea51e94083ee" label="lyrics-like">dixit illis : 4 oráte, ne intrétis</l><l xml:id="m-b68bc548-0e93-437e-ace4-33b41cc16737" facs="#m-9733c249-39a1-44ee-9379-c0ffeea15f5c" label="lyrics-like">eum, duxérunt ad domum prin¬</l><l xml:id="m-588086e1-3ff4-4a49-9007-e798dd0dd973" facs="#m-40185329-8574-499b-b5cf-68893a0947d3" label="lyrics-like">in tentatiónem. C. Et ipse avúl¬</l><l xml:id="m-26636e90-6751-45be-827d-a9eed151bf76" facs="#m-42e66f02-1f5f-41b2-8d7a-6a851b52e943" label="lyrics-like">cipis sacerdótum: Petrus vero</l><l xml:id="m-817c0dbe-e1b3-48f1-9bb4-2cd5b2a13084" facs="#m-63642d12-c8e5-49f9-b0b2-f4650a191db8" label="ambiguous">sus est ab eis quantum jactus</l><l xml:id="m-cb2d68ef-ad43-4b37-a709-70b299b756f0" facs="#m-ef47f3f6-1150-4400-afc8-6b76e77d0642" label="lyrics-like">sequebátur a longe. Accénso</l><l xml:id="m-7e5c9ff3-ef85-4a5d-a09f-bc4c2db69dfb" facs="#m-c4d63dbf-aa0f-410a-a7b0-da24f3cfa157" label="lyrics-like">est lápidis, et pósitis génibus</l><l xml:id="m-a2a4d4ca-29d6-4b96-9e51-d6a92b75145e" facs="#m-a4ce5c6b-fd94-4dac-8539-7b31dc36c5d7" label="lyrics-like">autem igne in médio átrii, et</l><l xml:id="m-a23dab95-6ab1-4aab-a525-6816d5916dd7" facs="#m-0fc194d2-a847-448c-a48d-345d55f3d3a6" label="lyrics-like">orábat, dicens:  Pater, si vis,</l><l xml:id="m-7a62f6a4-22dd-4103-98a9-c956255db283" facs="#m-cecaf996-8e0b-4cf0-ac9d-a8bc10270c9b" label="lyrics-like">circumsedéntibus illis, erat Pe¬</l><l xml:id="m-f9cbeeb8-b880-4ec2-af06-484ffedbefe2" facs="#m-2acfbbcf-66e2-4427-ab9f-b7040118ee0c" label="lyrics-like">trus in médio eórum. Quem</l><l xml:id="m-10e2251a-6bde-48bd-a9fe-a0d4e259a56e" facs="#m-ebf5ef6f-19a3-4f96-a2cc-6f98a6310034" label="lyrics-like">transfer cálicem istum a me</l><l xml:id="m-d0a59bf0-5f4f-40d0-abe2-f824b966303e" facs="#m-ecc11d53-8218-4c8c-a663-e5c85bee3e81" label="lyrics-like">verúmtamen non mea volúntas,</l><l xml:id="m-63724d68-9e42-40f3-9cbb-cea083f3d066" facs="#m-4ca17cdd-b95f-4efd-b27d-97e3c3f2af9e" label="ambiguous">cum vidisset ancilla quaedam</l><l xml:id="m-f63098fc-c398-4a63-9493-a4f10c1461a6" facs="#m-56616b5c-c946-426c-b7ea-368726e78584" label="lyrics-like">sed tua fiat. C. Appáruit autem</l><l xml:id="m-6ecbe1c1-89c6-4ecb-9dd0-290cca90346b" facs="#m-0099644c-3717-4ac0-92a2-1fce8fc73507" label="lyrics-like">sedéntem ad lumen, et eum</l><l xml:id="m-04815730-9d8a-40ba-b076-b208ef34ef02" facs="#m-34f5c8fb-f0fe-4766-8b56-cc72f7a5d80b" label="ambiguous">fuisset intuita, dixit : S. Et hic</l><l xml:id="m-99d4cc8c-ea63-4d75-b6c7-e668e97cdf51" facs="#m-2be0a154-cd12-4b68-af40-56fdb14b1aea" label="lyrics-like">illi ángelus de caelo confórtans</l><l xml:id="m-90251c0d-1bee-4877-8138-59b28c05de64" facs="#m-ebd382ab-5ecd-464d-bc21-eba034980085" label="lyrics-like">cum illo erat. C. At ille negávit</l><l xml:id="m-580be756-fea0-4eb1-bfbd-f75af5c4dc56" facs="#m-d60fb6be-5775-4203-85f2-837804d230c9" label="lyrics-like">eum. Et factus in agonía, pro¬</l><l xml:id="m-e0b2d181-40d1-4050-8c3f-4a889474b8de" facs="#m-825d1803-c33e-4262-84cb-8bb9eaff2ebc" label="lyrics-like">eum, dicens: S. Múlier, non</l><l xml:id="m-2f3c369a-ae08-4b45-a88f-d137a267adc0" facs="#m-7fe045a6-b678-42ac-a74a-032f11cf0ba8" label="lyrics-like">lixius orábat. Et factus est sudor</l><l xml:id="m-22bc6ccc-01f5-48d0-bf05-5d24ccc18d2d" facs="#m-a1289bb2-e499-42d1-8525-4fee58a9dfeb" label="lyrics-like">ejus, sicut guttae sánguinis de¬</l><l xml:id="m-6e129944-8d03-4520-932b-ba0d5ebded08" facs="#m-3d17a458-5792-4e5f-9431-a35955cc61df" label="ambiguous">novi illum. C. Et post pusillum</l><l xml:id="m-eab98248-c7b4-4376-8138-e12859d9a002" facs="#m-8a1ac881-b5ee-4749-89c6-e292fb48b977" label="lyrics-like">curréntis in terram. Et cum</l><l xml:id="m-903d58fc-44b1-42a7-8e37-9eaab5d95886" facs="#m-e489d4f8-7804-46d7-9a21-6075cb6cae5f" label="lyrics-like">álius videns eum, dixit : S. Et</l><l xml:id="m-4ad75968-4adb-4e45-89bf-2abd470ed94c" facs="#m-9e02fb98-31aa-4a46-8245-fe5db17a4807" label="lyrics-like">surrexísset ab oratióne, et ve¬</l><l xml:id="m-5a644470-7e9c-4890-af3c-643dc15782ea" facs="#m-0eb0755d-1c3a-48c8-bf0b-982c42bdc00b" label="ambiguous">tu de illis es. C. Petrus vero</l><l xml:id="m-10028720-bb2d-49d4-ac3c-3ea9c9f85e40" facs="#m-c383117a-67cd-443c-9cb7-796b46ebac24" label="ambiguous">ait: S. O homo, non sum.</l><l xml:id="m-dfac9478-960d-474c-8fc5-b56b2411f051" facs="#m-9c3de91d-beed-4488-9247-7a5227233aea" label="lyrics-like">nisset ad discipulos suos, invénit</l><l xml:id="m-2beb923f-8a23-48b4-842e-42864dfea221" facs="#m-05a365d6-f2a1-4dc5-8324-07dfbb46f0d5" label="lyrics-like">C. Et intervállo facto quasi</l><l xml:id="m-0d3f0f4a-d754-4fc6-8461-7d7b542b25fb" facs="#m-b1891833-f0ff-40ea-8520-30798e7845b0" label="lyrics-like">cos dormiéntes prae tristítia.</l><l xml:id="m-0bdcb780-cd70-4b02-8737-ba0fe46311b8" facs="#m-665442ac-cb17-42a5-9130-6b586865a90d" label="lyrics-like">horae unius, álius quidam affir¬</l><l xml:id="m-380149c0-b6f9-453c-bbd7-1ed68f733ba4" facs="#m-47068053-82c0-44d5-81b3-335b0577aac3" label="lyrics-like">Et ait illis:  Quid dormítis?</l><l xml:id="m-0498af15-32ed-47d4-976d-3dff3d83e9ce" facs="#m-a8cea8d8-e07f-4653-8c79-b3a064e8c015" label="lyrics-like">mábat, dicens: S. Vere et hic</l><l xml:id="m-1ac3e3d0-551b-4b51-be38-96636aa24f90" facs="#m-96f38fc5-0cc4-4694-a4d5-305a485f2eb1" label="lyrics-like">súrgite, orâte, ne intrétis in</l><l xml:id="m-23e38a30-9b3c-4a3e-a8c4-4a59785fc43e" facs="#m-62f5f887-9f17-4f1d-bfc4-de9e481b10a6" label="lyrics-like">cum illo erat : nam et Galilaéus</l><l xml:id="m-8533bffb-6a02-4457-ab3b-cd364f4c1160" facs="#m-5205cb84-c0ce-40db-a76f-26bd6dfb6abd" label="lyrics-like">tentatiónem.</l><l xml:id="m-0c2d8f37-3185-433a-8e03-f95cf6b40d1c" facs="#m-de2d0237-1f7a-42ec-a3cb-f5dcc01f6c45" label="lyrics-like">C. Adhuc eo loquénte, ecce</l><l xml:id="m-93217d90-1ace-41f7-948e-918fd704050d" facs="#m-5ef3285b-afed-4211-a0bd-543e172536de" label="ambiguous">est. C. Et ait Petrus: S. Homo,</l><l xml:id="m-153bb178-384b-4ca9-ae7d-6c943f279233" facs="#m-173f6615-fd51-4a06-89d4-efcc00ea189e" label="lyrics-like">néscio quid dicis. C. Et continuo</l><l xml:id="m-d882691d-6b98-45ae-a3f0-3bca54ba4e0f" facs="#m-ba6d2174-4f71-4837-8c83-b67866e6d9f7" label="lyrics-like">turba: et qui vocabátur Judas,</l><l xml:id="m-44b513bb-acfe-42f6-bfad-3e0a1f4e00a0" facs="#m-865ff6fd-0369-4edf-99be-d8549803d053" label="lyrics-like">unus de duódecim, antecẽdébat</l><l xml:id="m-8563cc6d-4688-46fd-931e-e4636dd378bf" facs="#m-686aaa04-35be-4b41-974b-3916cce73fe7" label="lyrics-like">adhuc illo loquénte cantávit gal¬</l><l xml:id="m-4d2f8064-5221-47e1-84db-547817d78313" facs="#m-8695262a-89ba-4335-af1c-30123668ee5d" label="lyrics-like">lus. Et convérsus Dóminus re¬</l><l xml:id="m-3714df38-9d7d-4fb2-8ff9-66118667d6fa" facs="#m-fec7aee5-a6b9-4cd7-8456-2b5bb6bf8120" label="lyrics-like">eos: et appropinquávit Jesu, ut</l><l xml:id="m-cd76ecc1-5386-4127-ad39-72685b0547c2" facs="#m-87222bd6-eaa5-45e8-a44c-8fb0f945f891" label="lyrics-like">spéxit Petrum. Et recordátus</l><l xml:id="m-5d991051-73f5-48cd-a2c7-f5174bd70e53" facs="#m-9e00d213-53e7-4561-8d2d-ee709095e587" label="lyrics-like">oscularétur eum. Jesus autem</l><l xml:id="m-b188e95e-e6ab-47f5-88c1-047545c1a76a" facs="#m-4cddcc1d-17f4-4284-b06d-a78c64ca03fc" label="lyrics-like">dixit illi : 4 Juda, ósculo Filium</l><l xml:id="m-3dd056bf-6f3e-4f81-8718-bc2068d50a6b" facs="#m-7e8858f7-f2ec-44b7-9875-a2e9fc02e83d" label="lyrics-like">est Petrus verbi Dómini, sicut</l><l xml:id="m-b29e45d5-aba9-490f-aea8-6a2610b86a26" facs="#m-76e1dd57-ad83-4ff6-9456-ec5208d7c831" label="lyrics-like">dixerat: Quia priúsquam gallus</l><l xml:id="m-5b20efd2-4d64-4730-beeb-1947d1005a19" facs="#m-f278b9ae-a696-487c-bc4c-71cd23a5028f" label="lyrics-like">hóminis tradis? C. Vidéntes au¬</l><l xml:id="m-02bfa542-e1c5-46e7-9e00-c44479dbdb94" facs="#m-810f435a-a9be-440c-9b25-448210ab8e24" label="lyrics-like">cantet, ter me negábis. Et egrés¬</l><l xml:id="m-4c59bc8a-1098-4d85-869f-7b09bcb8ed74" facs="#m-2e8c540a-f815-4a0c-b637-d6692f5a2fa4" label="ambiguous">tem hi, qui circa ipsum erant,</l><l xml:id="m-891d924f-672a-42f7-8be2-f67ab2c4c75b" facs="#m-c82e3a76-1ea2-4d49-92f2-233e2e428dec" label="lyrics-like">quod futúrum erat, dixérunt ei :</l><l xml:id="m-fdc386f8-3e41-462d-8652-68d5f7ef97e7" facs="#m-166186d4-f975-4a42-8a87-063d261a96d1" label="ambiguous">sus foras Petrus flevit amare.</l><l xml:id="m-cccb2117-7fa8-46a0-9568-6816e10f3d14" facs="#m-a2f014b9-7dd2-4c3f-9253-10ba342f6737" label="lyrics-like">S. Dómine, si percútimus in</l><l xml:id="m-6a2f8e24-65c6-46a9-bbf2-9e8dea5ded18" facs="#m-c2d5c81a-3431-4499-a056-5e8e8b43de2c" label="lyrics-like">Et viri, qui tenébant illum,</l><l xml:id="m-66cdb62f-116c-401b-8a4c-98ae6cf51c06" facs="#m-e283b547-1d29-4078-93b9-afcf8a6bcedd" label="lyrics-like">illudébant ei, caedéntes. Et ve¬</l><l xml:id="m-99a56651-eb07-4bf9-8d47-006f246c0c9d" facs="#m-19ae9e04-feb9-4637-88ed-95fd1de6a40f" label="lyrics-like">gládio? C. Et percússit unus ex</l><l xml:id="m-9e7b5b78-c7d7-4b59-9c24-2b8d671af10a" facs="#m-1093ecd2-667f-4381-9281-0e4593356008" label="lyrics-like">iilis servum principis sacerdó¬</l><l xml:id="m-9d3e4ebc-3903-4865-b05d-6be36e7efe18" facs="#m-47354622-8394-4664-ac92-f12c7740405a" label="lyrics-like">lavérunt eum, et percutiébant</l><l xml:id="m-7b899704-0677-4577-985e-8c19fa03d376" facs="#m-5fc98754-47ff-43e7-82b8-45a4c81c740f" label="lyrics-like">fáciem ejus: et interrogábant</l><l xml:id="m-0e6c77cd-727a-4197-b164-812c07183195" facs="#m-de69f46e-3884-4594-812c-5f55a3cac170" label="lyrics-like">tum, et amputávit aurículam</l><l xml:id="m-48a4509c-e9c8-4ded-bb3c-793fa790f85e" facs="#m-9bbb6893-d1ce-4b7d-acdb-ccbee60608ec" label="lyrics-like">ejus déxteram. Respondens au¬</l><l xml:id="m-9d98d7d6-02c0-4cdf-af4c-09269618b7ba" facs="#m-4420be56-9e45-4c56-bb82-0c7faa88c174" label="lyrics-like">eum, dicéntes: S. Prophetiza,</l><l xml:id="m-57fb6d9c-5427-42a5-9dfb-00c422655794" facs="#m-36973b63-49ed-48ac-9b66-be7e6be501ef" label="ambiguous">tem Jesus, ait:  Sinite usque</l><l xml:id="m-2076ae90-f678-47c5-92e5-52bd929ad1a1" facs="#m-28ba7e96-9006-4176-a7bc-d6df8aaa7713" label="lyrics-like">quis est, qui te percússit? C. Et</l><l xml:id="m-c2b2a789-a8e8-418c-88eb-5501dbd093cd" facs="#m-5b8781f7-d9ea-4ad5-8599-fac1cb5b3791" label="lyrics-like">huc. C. Et cum tetigísset aurí¬</l><l xml:id="m-93ca93db-bdb1-4676-9f42-e97f3714d680" facs="#m-69f0b656-6091-4fee-b0a3-72ab0da7a970" label="lyrics-like">áia muita blasphemántes dicé¬</l><l xml:id="m-80645c18-c95e-495d-aca0-ff7981df7464" facs="#m-0275763e-35ed-43d4-8653-5ba819b179fb" label="lyrics-like">culam ejus, sanávit eum. Dixit</l><l xml:id="m-97a1621f-4791-48c1-a774-cdac7fcf3aff" facs="#m-5c9ccefd-d737-46ef-8a44-49a70a420288" label="ambiguous">bant in eum.</l><l xml:id="m-8479e9ed-9774-4586-899a-efca4a022880" facs="#m-1376fbd1-250c-4f7e-82d7-717da92e4106" label="lyrics-like">Et ut factus est dies, convené¬</l><l xml:id="m-28d0f404-3f43-43e5-9b49-b4a56859af1d" facs="#m-da3f16b7-deac-4f3a-9b31-d3eab2b1cac9" label="lyrics-like">autem Jesus ad eos, qui vénerant</l><l xml:id="m-6418f03b-9e3e-46ba-bf96-5c1ee66fe526" facs="#m-a0ddba7b-a08d-4fb8-ac0f-01b309acbc45" label="lyrics-like">ad se, principes sacerdótum, et</l><l xml:id="m-01ee8510-9c22-492c-8876-52976780be8b" facs="#m-c33fa60f-a21a-4e4a-87db-578896220a3b" label="lyrics-like">runt senióres plebis, et principes</l><l xml:id="m-92a980a9-b7ad-46a8-b3b4-62933cafdafe" facs="#m-4b47220f-c230-450d-b80a-e35b9364a32f" label="lyrics-like">magistrátus templi, et senióres:</l><l xml:id="m-44e80c14-aa03-4616-ace0-d6e8aca8d43f" facs="#m-dcb278f7-84e6-489f-aa62-91a2ee894429" label="lyrics-like">sacerdótum, et scribae, et duxé¬</l><l xml:id="m-27f49225-b009-45cf-87af-269eb4ec5282" facs="#m-ceb47498-40dc-4b05-a605-491e674d3bbb" label="ambiguous">runt illum in concslium suum,</l><l xml:id="m-6bd27564-3b9f-4442-a6e2-a83bbe321fbf" facs="#m-d3f90dc1-a049-439f-b3a7-de83bff6b7f2" label="lyrics-like">Quasi ad latrónem exístis cum</l><l xml:id="m-af0e7651-fa21-4761-a51c-66ffcf5af709" facs="#m-553a7941-9d76-4813-987c-5aeed0c53337" label="lyrics-like">gládiis, et fústibus? Cum quo- dicéntes: S. Si tu es Christus,</l></lg></div></section></score></mdiv></body></music>
</mei>