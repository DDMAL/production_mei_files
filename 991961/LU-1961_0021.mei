                  <syl /><neume facs="#m-033f41fa-ab79-42c0-9970-4532bc206782" type="podatus" xml:id="m-1b40b5ff-106e-4576-b6b9-1fdb0446cb51">
                    <nc xml:id="m-7277349f-44a0-4e95-8e01-ad656f8a872a" pname="g" oct="4" />
                    <nc xml:id="m-cb3a0095-5043-4ffa-aafd-7163806e5787" pname="a" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-fd11e35b-1050-4012-b791-739ededc49f7">
                  <syl /><neume facs="#m-7f2d158f-3652-4338-8c33-f97843b29948" type="torculus" xml:id="m-bf4b1816-3bd5-4859-a9bb-aaa4460045dd">
                    <nc xml:id="m-3898ae5a-a069-4195-8ea8-1bf02bbca8d9" pname="a" oct="4" />
                    <nc xml:id="m-5992e7cf-d565-44dc-90df-b9e1f25eecd7" pname="b" oct="4" />
