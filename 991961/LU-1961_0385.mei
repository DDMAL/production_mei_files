            <div xml:id="m-5f8c2d51-743f-4a7d-938c-453838e5dd6c">
              <lg xml:id="m-8e002ea6-3fd2-4e81-a6c7-bc4cd18164bc">
                <l xml:id="m-07af2b37-637f-46ff-a117-ef57fcfefe09" facs="#m-a898a96e-086b-4268-bc48-d583fcfe263f" label="text-like">The Common Commemorations of Saints.</l><l xml:id="m-517cd688-5a80-40fe-9553-06d9bad44365" facs="#m-e49d5a59-27d0-48d3-817b-5a28a17ea804" label="ambiguous">262</l><l xml:id="m-ea18e750-4d7c-4696-a65a-a177a61d3f20" facs="#m-bbfd99a4-f633-442b-bf20-cd37b4ad20c5" label="text-like">FOR SEVERAL HOLY WOMEN.</l><l xml:id="m-2e787e83-9818-42dd-bf4b-7465fcc0ce46" facs="#m-517f5244-b7a8-4d6e-80c2-74691dfcf828" label="text-like">At I. and II. Vespers.</l><l xml:id="m-73cfd271-ba81-422e-9a34-73a1216f2b44" facs="#m-d1b8c41b-7b46-43d3-8d33-0332a2396f70" label="ambiguous">Ant.</l><l xml:id="m-52b057ce-52e0-43c8-9c63-e8be4117d9de" facs="#m-2ae3544d-0bf3-45bb-a726-22b009f39912" label="ambiguous">8.</l><l xml:id="m-9fc635aa-7167-42c6-abc6-6db921aab679" facs="#m-aed7a8c4-0d57-49a6-a914-8ba7e8593aa6" label="lyrics-like">stárum est enim</l><l xml:id="m-f292924b-3d3c-45d8-a785-ad43f232559e" facs="#m-a51d35d1-4cbe-49e0-997d-987c98ca92d2" label="lyrics-like">régnum caeló-rum, quae con¬</l><l xml:id="m-d06d974c-a845-452c-8c15-0edce41fb198" facs="#m-82dd5636-c65f-4664-ba68-2a3de1d54ee6" label="ambiguous">-</l><l xml:id="m-26c1eeb2-eabe-46d2-a170-d89cd18c15ec" facs="#m-d3a7b80a-c4fe-4220-b88d-8f18d914d083" label="lyrics-like">tempsérunt ví-tam múndi,</l><l xml:id="m-2cdb6531-c961-40c3-9d3c-d961352cdf89" facs="#m-4136ba3b-8cdd-47ef-84db-d25ee9ea5e0b" label="lyrics-like">et pervenérunt ad praémi¬a</l><l xml:id="m-5061459e-d05b-4d93-9933-181833178370" facs="#m-3c402370-4a26-40d0-9ff0-c5a3e9728b1c" label="lyrics-like">et lavé-runt stó-las sú¬</l><l xml:id="m-6e4fc231-41ee-454d-84fa-66d2908d769a" facs="#m-432a6345-12ad-46bb-bec1-93420f452570" label="ambiguous">in</l><l xml:id="m-e22c087c-0a03-442a-9015-f31e2c714847" facs="#m-9829fad8-de65-4069-b9d6-74276664400b" label="lyrics-like">sán-guine</l><l xml:id="m-8188155e-1a89-40a5-9989-c07a98e6c3c4" facs="#m-abfabf31-5248-41cd-b6f2-29b45a34d85c" label="lyrics-like">régni,</l><l xml:id="m-61659f44-feb9-44b0-8885-4c2c18019d6f" facs="#m-daa24df0-8fb8-4eea-ba9f-4766dc6176eb" label="ambiguous">as</l><l xml:id="m-faa4460b-d920-41b8-807a-59f97d731221" facs="#m-699cc832-b11a-4c09-9925-795c6b5e7b63" label="ambiguous">Agni.</l></lg>
