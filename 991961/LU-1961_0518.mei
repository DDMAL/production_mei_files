                  <syl /><neume facs="#m-164fb1e5-b5c9-4d22-abab-d57a69dd0432" type="punctum" xml:id="m-2e3bb7c6-ec84-4928-b666-6f535ba79f59">
                    <nc xml:id="m-e7a08e23-518d-4f4e-80d5-a6f179566a04" pname="c" oct="4" />
                  </neume>
