                  <nc xml:id="m-e159e689-5210-4b9a-844b-c9d08dfae51b" pname="g" oct="3">
                    <signifLet xml:id="m-7288a295-091b-42ac-9029-7873eaf9dd70" /></nc></neume></syllable><sb xml:id="m-fe6e77b5-d372-4ada-93e8-2d858070147d" n="3" facs="#m-0e24a058-9190-48fd-99ad-7227d9212516" /><divLine xml:id="m-300fa272-5fd0-4119-b071-b021ca240010" facs="#m-1bd63b87-69ab-45cd-a972-37297a890108" form="finalis" /><syllable xml:id="m-2a10e682-f006-48e6-8e26-b6349e613991">
                <syl /><neume facs="#m-0f182780-179e-477f-a13a-3d21b6e5a39e" type="punctum" xml:id="m-62bc094a-261a-4e13-a4bd-adb4be43086c">
                  <nc xml:id="m-855aa5bf-39c4-476f-9a7b-64f5e81fa03e" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-a37a7446-35fb-465a-a66a-e3cdb1df4191">
                <syl /><neume facs="#m-eff4bf86-0d10-4a2a-9b00-8ec0e4afed02" type="punctum" xml:id="m-18494853-4f26-4af7-8b99-419a53a12fd4">
