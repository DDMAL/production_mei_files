b8c22" ulx="208" uly="1450" lrx="1162" lry="1518" /><zone xml:id="m-7b24818b-b520-4a25-86a7-25e6c89cbaf8" ulx="283" uly="1518" lrx="1112" lry="1589" /><zone xml:id="m-16eb5f87-ad00-482c-93e2-40c36de2f0cd" ulx="209" uly="1607" lrx="1638" lry="1689" /><zone xml:id="m-cac67978-da6e-499a-bd1d-172a67954108" ulx="283" uly="1675" lrx="1461" lry="1747" /><zone xml:id="m-b8dd79db-5a5f-49ba-8019-7d197d6ec2cb" ulx="213" uly="1761" lrx="1638" lry="1831" /><zone xml:id="m-34167539-7759-4408-8862-85be84edb7d0" ulx="281" uly="1832" lrx="1112" lry="1904" /><zone xml:id="m-89fd9a10-a215-4449-9f83-7d94c57d521c" ulx="286" uly="1900" lrx="1858" lry="1969" /><zone xml:id="m-99e7bd5f-f270-4bad-8ba6-bce4ad03b52a" ulx="339" uly="1956" lrx="1858" lry="2023" /><zone xml:id="m-f71e9632-b879-4ae0-8867-f2b6d97b4d0e" ulx="211" uly="2040" lrx="1860" lry="2114" /><zone xml:id="m-5bef7253-6be7-4efc-962d-436a3491b3fc" ulx="288" uly="2110" lrx="1458" lry="2182" /><zone xml:id="m-d29683aa-c0b7-4f1f-99ba-d69136b2a700" ulx="290" uly="2180" lrx="1862" lry="2246" /><zone xml:id="m-08f2a06b-075d-48ee-922e-3d6482b043d4" ulx="342" uly="2234" lrx="1865" lry="2294" /><zone xml:id="m-6f62f8fc-882a-4ede-b51c-c2cb5a1e417b" ulx="335" uly="2285" lrx="1681" lry="2350" /><zone xml:id="m-240ea9f9-77b4-4461-b82a-eab2703ca4e5" ulx="192" uly="2369" lrx="1863" lry="2439" /><zone xml:id="m-f263f8ad-c521-4f14-9228-8cb35d383b46" ulx="339" uly="2426" lrx="1757" lry="2495" /><zone xml:id="m-74423696-f3ac-40cb-9043-a23508a31541" ulx="293" uly="2496" lrx="1232" lry="2563" /><zone xml:id="m-37df804b-d7be-4510-81b0-a53b4f4a8f7f" ulx="194" uly="2587" lrx="1842" lry="2654" /><zone xml:id="m-2f1a337e-7245-4795-b812-14322dafd1ee" ulx="194" uly="2666" lrx="1862" lry="2741" /><zone xml:id="m-6a9542d6-c73b-4f97-8cff-5b124be39369" ulx="293" uly="2737" lrx="1500" lry="2809" /><zone xml:id="m-e2fafb4a-fb3f-4b4c-8c7c-61fee813d5e6" ulx="195" uly="2818" lrx="1542" lry="2889" /><zone xml:id="m-31b10df3-1936-434b-bb24-eaec22987384" ulx="293" uly="2889" lrx="1369" lry="2959" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-3fd26426-5572-48ae-9a09-9ae8baf8b700" n="0094" facs="#m-7ef55805-58de-4aba-8e82-467622d098c2" /><div xml:id="m-6e91eccc-e4ff-48aa-8191-7dae51bbb7cd">
            <lg xml:id="m-4eec4c62-91f5-44bb-a528-66b817d64810">
              <l xml:id="m-7c9ad4b9-ef70-4dee-b5fa-fa75fb691eae" facs="#m-1d241a98-f0e5-48e4-9ca2-79616ad60a45" label="text-like">Changes in the Liber Usualis.</l><l xml:id="m-61714d87-bbf9-4d63-8253-1b9e09158302" facs="#m-3acb0058-6f02-46b4-9274-c8e916c6d6be" label="ambiguous">xciv.</l><l xml:id="m-d06c9ae4-883e-4130-ab4d-fb36074d87f6" facs="#m-9d6157aa-d4e9-4856-b1fe-e5c7283ee633" label="text-like">FEASTS OF JULY</l><l xml:id="m-00536c01-f8ec-4112-a8b6-997f6d0721ab" facs="#m-a7f43c01-1c2c-49a4-bdb6-56f9abe40b22" label="text-like">1. THE PRECIOUS BLOOD OF OUR LORD, I class.</l><l xml:id="m-99636570-4591-418a-a859-885ab3cc3fd1" facs="#m-159d7169-10f7-4040-99c9-d93702dfa2ae" label="text-like">Festive Office. — All as pp. 1528-1538, except the following:</l><l xml:id="m-7f7d3dae-ece1-4d91-b92e-4d274f9aa623" facs="#m-43b5f8ca-b0b1-4f67-9453-01471134f3ba" label="text-like">No com. of occurring Sunday at Lauds, either Vespers, or at</l><l xml:id="m-4955bba8-adf1-4dde-ba0b-a5d94aae3353" facs="#m-09c8dc2e-ba04-4e4c-8a3c-7f352af83850" label="text-like">Mass. At Prime, short lesson of season.</l><l xml:id="m-446c52d4-1674-417d-b723-77ef5cb5cd9f" facs="#m-4dde368e-58d4-48b3-ad01-b5271150a17d" label="text-like">2. VISITATION OF OUR LADY, II class. — Semi-fest. Office.</l><l xml:id="m-190056cb-edb9-4e4a-be7a-9c2a1ad71e84" facs="#m-0b89afc5-940b-4c7a-ae0a-575672d9fb8f" label="text-like">At lesser Hours, hymns n° 1 of Sunday, ant. and pss. of day</l><l xml:id="m-141f1dc0-876e-4a70-88ce-b848d468d86a" facs="#m-b219ab57-3256-4a88-876b-6934109346f3" label="text-like">occurring, pp. 279A ff.; the rest, of the feast; at Prime,</l><l xml:id="m-336eac62-6ed2-4cfb-abb0-8318f565f600" facs="#m-cdef38b1-cdc9-4898-a3e7-d748599b9928" label="text-like">short lesson of season.</l><l xml:id="m-aa7e54ac-536d-4d98-82dd-bb27e5c77d01" facs="#m-136a5489-4f7b-44b1-87a2-822543bf6dc5" label="text-like">Mass, p. 1539 (if conventual, com. of SS. MM.).</l><l xml:id="m-063cd9ba-f04a-4719-b69d-960150cea95d" facs="#m-d725c220-1ab9-4ffa-9ba4-7bd449ea6279" label="text-like">Vesp. of feast, p. 1540 (Sat. com. of Sun.). Compline of Sun.</l><l xml:id="m-5a3830a1-0846-4af1-871f-4f40497e5fec" facs="#m-c15772b8-b927-4413-9290-451c7ae504cc" label="text-like">Where the feast is I class: it is commemorated at Vesp. of Precious</l><l xml:id="m-d2813a29-b049-4b22-91ef-5a023f8c2cf4" facs="#m-568e259d-30e5-4d49-b2ad-96dfb0e050d3" label="ambiguous">Blood, see p. 1538v.</l><l xml:id="m-6479a1f9-3872-43bc-9454-0bcfa6c90bfa" facs="#m-b3b79501-c0b2-4c66-b0e6-6f72b33ca2b8" label="text-like">At lesser Hours, ant. as in Liber Usualis for feast, pss. of Sunday</l><l xml:id="m-15b5f117-78fd-4a63-9009-6403f626c4c0" facs="#m-54c6b4e5-ca22-4038-af2a-b7eb9d2e5669" label="text-like">(at Prime, n° HI).</l><l xml:id="m-dc5e5f77-8abe-499a-bfcb-21bbadbf31af" facs="#m-f6ccc12f-fc70-4948-b9f4-fe263ce64d56" label="text-like">Mass, p. 1539 (com. of Sunday occurring only).</l><l xml:id="m-5cb6542e-2d13-44e9-b68d-f09997f6a561" facs="#m-6481d473-5646-4a40-ab23-02c768b61656" label="text-like">Vesp. of feast (com. of Sunday if it occurs).</l><l xml:id="m-2400a86e-7502-4058-ae06-094fb15eb2bf" facs="#m-13938d2e-4e61-47b9-8fbf-34176d3b8c22" label="ambiguous">3. ST. IRENAEUS, Bp. M., HII class.</l><l xml:id="m-ed3780ff-7b88-468c-b97c-9ca0ade6b579" facs="#m-7b24818b-b520-4a25-86a7-25e6c89cbaf8" label="text-like">Ordinary Office. Mass, p. 1511.</l><l xml:id="m-df0ca3f3-e3f8-4877-8b12-fe82dd2ed64b" facs="#m-16eb5f87-ad00-482c-93e2-40c36de2f0cd" label="ambiguous">5. ST. ANTHONY MARY ZACCARIA, Conf. III class.</l><l xml:id="m-64f5b562-f337-4dae-b9f3-b1384384a5a8" facs="#m-cac67978-da6e-499a-bd1d-172a67954108" label="text-like">Ordinary Office. Mass, p. 1543, without com.</l><l xml:id="m-41088c9f-4acf-49bd-8940-f11d86e4d562" facs="#m-b8dd79db-5a5f-49ba-8019-7d197d6ec2cb" label="text-like">7. SS. CYRIL and METHODIUS, Bpp. Conf., III class.</l><l xml:id="m-28a51ea0-52c6-4a24-99e5-a8decee3781e" facs="#m-34167539-7759-4408-8862-85be84edb7d0" label="text-like">Ordinary Office. Mass, p. 1550.</l><l xml:id="m-2a2213d5-defc-4d38-b079-1d8da0858188" facs="#m-89fd9a10-a215-4449-9f83-7d94c57d521c" label="text-like">At Vesp., ants. and pss. of day occurring, pp. 280 ff., chap.</l><l xml:id="m-0f79cea1-174e-4a7f-8ece-63f5ac829ecc" facs="#m-99e7bd5f-f270-4bad-8ba6-bce4ad03b52a" label="lyrics-like">Ecce sacérdos, p. 1177, hymn, V. and ant. to Magn. p. 1551.</l><l xml:id="m-ce6e3317-93bb-4388-bb60-8d546302f0c5" facs="#m-f71e9632-b879-4ae0-8867-f2b6d97b4d0e" label="ambiguous">8. ST. ELIZABETH, Queen, Widow, III class.— Ordinary Office.</l><l xml:id="m-76726d14-3e30-43c6-9aad-fe91d03dd651" facs="#m-5bef7253-6be7-4efc-962d-436a3491b3fc" label="lyrics-like">Mass Cognóvi, p. 1239, except collect, p. 1553.</l><l xml:id="m-1ce00738-db58-45fd-b5bf-faa39dc691b8" facs="#m-d29683aa-c0b7-4f1f-99ba-d69136b2a700" label="text-like">At Vesp., ants. and pss. of day occurring, pp. 280 ff., chap.</l><l xml:id="m-5c97499b-e87a-4144-bb75-8e892623a2eb" facs="#m-08f2a06b-075d-48ee-922e-3d6482b043d4" label="lyrics-like">Mulierem fórtem, p. 1233, hymn that follows; V. Ora pro</l><l xml:id="m-6ff22dd5-fba2-48ed-8016-60d2b899ccec" facs="#m-6f62f8fc-882a-4ede-b51c-c2cb5a1e417b" label="lyrics-like">nóbis, p. 1553, ant. to Magn. and prayer that follow.</l><l xml:id="m-5571b403-a9e6-4681-b7a0-d8012a3b86c9" facs="#m-240ea9f9-77b4-4461-b82a-eab2703ca4e5" label="text-like">10. THE SEVEN HOLY BROTHERS, MM. and SS. RUFINA</l><l xml:id="m-35bc77ae-e92f-4dc5-9057-2e7faeaf26d4" facs="#m-f263f8ad-c521-4f14-9228-8cb35d383b46" label="text-like">and SECUNDA, VV. MM., HI class. — Ordinary Office.</l><l xml:id="m-d5ecafe8-54f2-4325-83aa-13c3c43212eb" facs="#m-74423696-f3ac-40cb-9043-a23508a31541" label="text-like">The Mass is not in the Liber Usualis.</l><l xml:id="m-e8ff38c4-b3e2-4e93-aab5-7022b8f0730b" facs="#m-37df804b-d7be-4510-81b0-a53b4f4a8f7f" label="text-like">11. Mass of feria (or St. Pius I, Pope, M., Si diligis me, p. 11221).</l><l xml:id="m-552a03fb-2090-4062-bb45-d7b4cb4715d1" facs="#m-2f1a337e-7245-4795-b812-14322dafd1ee" label="ambiguous">12. ST. JOHN GUALBERT, Abbot, III class. — Ordinary office.</l><l xml:id="m-8d7d2db6-a751-483f-b919-2c45c2d68e87" facs="#m-6a9542d6-c73b-4f97-8cff-5b124be39369" label="text-like">Mass, p. 1554 (if conventual, com. of SS. MM.).</l><l xml:id="m-7beab045-561f-433e-a2f2-f5281ffd0d12" facs="#m-e2fafb4a-fb3f-4b4c-8c7c-61fee813d5e6" label="ambiguous">14. ST. BONAVENTURE, Bp. Conf. Doct., HII class.</l><l xml:id="m-7383bf2b-d108-41ca-9587-6effb9d9bbec" facs="#m-31b10df3-1936-434b-bb24-eaec22987384" label="text-like">Ordinary Office. Mass, p. 1555, no Creed.</l></lg></div></section></score></mdiv></body></music>
</mei>