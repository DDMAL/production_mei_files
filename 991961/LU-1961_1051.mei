                    <nc xml:id="m-0b3170f9-9a57-45e6-bf8d-75e53ac4da31" pname="f" oct="3"><episema xml:id="m-d2b56f8a-bcb9-4c47-857e-512fc1200268" form="v" /></nc>
                    <nc xml:id="m-fe0bac02-623d-45c0-b818-85eaab5190ae" pname="g" oct="3" />
                    <nc xml:id="m-84feacd3-3d63-48f2-958f-5f1ee34e5b09" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-bcbd53c3-c656-42e3-bd64-86134b5b601b">
                  <syl /><neume facs="#m-64a91084-59bd-41f1-9ddd-4c663145576c" type="clivis" xml:id="m-4f0327a3-9092-4a50-9c7b-9009a2deda57">
                    <nc xml:id="m-55e209ad-08c7-450a-8dad-9624dc2987b6" pname="a" oct="3" />
                    <nc xml:id="m-04f4c838-96c3-4476-b48b-a16a3dff8332" pname="g" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-13633886-f28b-42aa-ba46-38dd974f9f65">
                  <syl /><neume facs="#m-4f319ca5-4f11-432b-b940-cc481f1ad2df" type="porrectus" xml:id="m-3c711eaf-7b5f-43d9-a723-44780f535b26">
                    <nc xml:id="m-02331d18-581d-4965-b8e6-0bb3c5527cc7" pname="g" oct="3" />
                    <nc xml:id="m-b0e233cf-0039-4620-aba6-aec3b9043a2e" pname="f" oct="3" />
                    <nc xml:id="m-6d41378f-8de3-44c0-a2d4-c9debc0201cc" pname="g" oct="3" />
