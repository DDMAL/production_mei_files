                <syllable xml:id="m-fa22db5d-4e2c-4af1-bbc9-a3b7cd870220">
                  <syl /><neume facs="#m-9e0eb838-c4dc-4b29-a4cb-ad403e32fa91" type="clivis" xml:id="m-fa3b50f3-2a77-45d4-891d-0a8111bc0d60">
                    <nc xml:id="m-df038f1e-783c-4f7f-bb7e-d2290d78d2ff" pname="g" oct="3">
