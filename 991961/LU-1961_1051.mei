                <syllable xml:id="m-00584bae-ced3-44f6-a7a3-cc463a11ce56">
                  <syl /><neume facs="#m-bda92ed1-4d98-4707-957e-1fd2900d914c" type="scandicus" xml:id="m-65d0f48b-ecb3-4fcc-965a-adb69b6b655c">
