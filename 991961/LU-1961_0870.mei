lx="533" uly="1046" lrx="932" lry="1073" /><zone xml:id="m-4ff3d68a-73cf-4d5b-b853-e3d2b4fe49cd" ulx="533" uly="1067" lrx="931" lry="1099" /><zone xml:id="m-be48f049-25b1-4f5b-9b34-04058fca647f" ulx="126" uly="1072" lrx="525" lry="1099" /><zone xml:id="m-ac605089-53cd-4f04-82ad-07e769ef6850" ulx="537" uly="1092" lrx="933" lry="1123" /><zone xml:id="m-c39cde03-52e4-42a0-927c-892e29ae6c60" ulx="126" uly="1097" lrx="525" lry="1128" /><zone xml:id="m-2dd36ac5-ddf5-4f67-812e-52f211ea9f53" ulx="535" uly="1120" lrx="932" lry="1154" /><zone xml:id="m-bbefcf13-5b1e-4445-b5f3-5d8f8cfb4c8a" ulx="129" uly="1121" lrx="525" lry="1155" /><zone xml:id="m-f441bd2b-0da3-44ad-8746-0a8882345bed" ulx="536" uly="1144" lrx="932" lry="1177" /><zone xml:id="m-7819872b-fad2-4a8f-b633-b70f129f860d" ulx="127" uly="1146" lrx="525" lry="1177" /><zone xml:id="m-b926e178-192c-430e-8e9c-bac9438c9f7a" ulx="537" uly="1171" lrx="932" lry="1203" /><zone xml:id="m-f41a6820-bba4-4846-93ad-ef4812f7bc5f" ulx="128" uly="1177" lrx="525" lry="1203" /><zone xml:id="m-d0f4b78d-0567-4a77-ac38-908fda3c6537" ulx="536" uly="1196" lrx="930" lry="1230" /><zone xml:id="m-0dfc42a6-7915-4948-aa42-13ebe42ed685" ulx="128" uly="1201" lrx="526" lry="1229" /><zone xml:id="m-ec35bf04-e95e-409b-b977-1ffc2648bdc5" ulx="536" uly="1223" lrx="930" lry="1259" /><zone xml:id="m-69ed5214-8dba-4ec7-b0e2-8461955055d2" ulx="128" uly="1225" lrx="524" lry="1256" /><zone xml:id="m-1b351ca7-3e0a-4628-925f-af618f8425d8" ulx="536" uly="1248" lrx="929" lry="1286" /><zone xml:id="m-99465562-3784-4e5b-9f9b-78dea4a08fe0" ulx="129" uly="1251" lrx="525" lry="1284" /><zone xml:id="m-79609878-115d-47a9-ac38-4ed70bbabe64" ulx="535" uly="1274" lrx="919" lry="1307" /><zone xml:id="m-10f439b4-1cdc-40df-b3b2-8eb22b66669c" ulx="130" uly="1277" lrx="527" lry="1309" /><zone xml:id="m-b872c9cc-b857-42c1-af04-9888a6e4b2ae" ulx="538" uly="1302" lrx="925" lry="1339" /><zone xml:id="m-cfb7cebb-c65c-42a2-8d36-64deddf50965" ulx="131" uly="1306" lrx="527" lry="1334" /><zone xml:id="m-8528e094-d6ee-4e71-810c-d3928ecc5db4" ulx="130" uly="1329" lrx="528" lry="1365" /><zone xml:id="m-36032fdd-64cc-4c98-97c9-54d5d25885cb" ulx="539" uly="1329" lrx="660" lry="1364" /><zone xml:id="m-273117b7-00b5-46cb-9790-64f33bfa8e38" ulx="131" uly="1356" lrx="527" lry="1388" /><zone xml:id="m-7d0af8e4-8a59-449a-a3e9-9acf9cf591b3" ulx="154" uly="1388" lrx="706" lry="1427" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-a269a340-abf7-4835-8560-400b5ac6f0c1" n="0870" facs="#m-6b0aa2e3-745f-4543-93c4-125ba1899467" /><div xml:id="m-4e663063-a2bb-45c8-8e14-c9f69ceb80d6">
            <lg xml:id="m-322dd790-85e2-47a3-b776-fac700c340b7">
              <l xml:id="m-69cf0ade-b2eb-41db-9a94-03c0d494aae0" facs="#m-843f9721-4d53-4dae-829f-c759bb6016f0" label="ambiguous">124</l><l xml:id="m-fc6507af-a3e5-4608-be32-b6bb28162662" facs="#m-3d203dbc-7ad3-4ca2-a142-e3bae6d28a5e" label="ambiguous">Good Friday</l><l xml:id="m-c61f7caf-f60b-4333-ba59-82e900f0f08a" facs="#m-920206cb-cc4f-4001-a88b-c1dc243c34cc" label="text-like">All kneel with the celebrant to pray in silence for a few moments.</l><l xml:id="m-3ea5ee3e-3e08-45cc-b724-16adb3205966" facs="#m-a3d9ad06-788c-4c7e-b0d6-7d4315184f57" label="text-like">The deacon:</l><l xml:id="m-45ccbf73-01b9-4393-934c-22dc02adc51c" facs="#m-039d1191-07b0-4ed2-a9d5-7821ab1975ff" label="text-like">tor the priestl</l><l xml:id="m-473c7b7f-5440-4c13-84ec-83b4a7fa13b5" facs="#m-098dd0b9-d2fc-47d3-9f3c-9d7bab0f8219" label="lyrics-like">Levá-te.</l><l xml:id="m-3e1772e2-64e7-428f-b4c5-c4ae8fe382e1" facs="#m-f36a5109-14df-4029-9d04-b12b7fda2b28" label="text-like">All rise; and the celebrant, his hands joined, sings the Prayer to the ferial</l><l xml:id="m-1046ea32-37b1-481c-9446-80cb31fbada8" facs="#m-96f6e91a-b5c1-4e68-bc8c-817b00412aad" label="text-like">tone A (or the ancient solemn tone), an acolyte Iserverl holding the book.</l><l xml:id="m-301fcdca-6894-43de-ba78-333b20b67ac0" facs="#m-44aa2309-426e-4b52-b336-4469c5a74e24" label="text-like">Prayer</l><l xml:id="m-13b763ff-064b-471a-9e35-9f267e278e12" facs="#m-d3434a15-fffe-470a-b067-b0b42db63d1d" label="lyrics-like">Eus, a quo et Judas reátus ster, divérsa utrisque intulit sti¬</l><l xml:id="m-6bbc419c-81a2-4ce8-9372-f43befeeb33d" facs="#m-a7787ccc-a0eb-4f01-a29a-8fb6535f0264" label="lyrics-like">U sui pœnam, et confessiónis péndia meritórum;*a nobis,</l><l xml:id="m-cc9b6dc7-1dee-4f17-a763-248dd5bc8224" facs="#m-82cf4f5b-0a66-455b-b822-aba934f7ebb0" label="lyrics-like">suae latro praémium sumpsit, abláto vetustátis errôre, resur¬</l><l xml:id="m-f184cfbe-32ef-4bdf-bca0-32d2e258cb44" facs="#m-13aba7ac-2add-40ac-9412-deccbc74aa1e" label="lyrics-like">concéde nobis tuae propitiatiónis rectiónis suae grátiam largiátur :</l><l xml:id="m-48bc2a86-d835-4ce8-91fc-0e1000b5c713" facs="#m-02cddcdb-e2d0-47ea-b119-18cb84e79e08" label="lyrics-like">efféctum : * ut, sicut in passióne Qui tecum vivit et regnat in</l><l xml:id="m-ab33dc74-38de-4551-8eee-040e83b4984d" facs="#m-b6733675-642a-4629-bc29-4066c1ba9f7c" label="lyrics-like">sua Jesus Christus, Dóminus no-lunitâte Spiritus...</l><l xml:id="m-2c05bbec-3d6c-4a93-b652-5667a272c8c0" facs="#m-bf449506-0295-4133-a2ff-878340250818" label="text-like">9. Atter the Prayer there is another Lesson, sung at the lectern by the</l><l xml:id="m-6be2e6c6-ffad-4876-a386-7aa6f53ece3d" facs="#m-828dff61-d437-46cd-a9f2-d47c63c3c7ce" label="lyrics-like">subdeacon, lihewise without a title and without Déo grátias at the end.</l><l xml:id="m-a120bc56-6ea5-4d41-9593-a766ec31f88c" facs="#m-389bbcf2-3c12-4616-b31c-0345d88d0118" label="text-like">The celebrant and all the others sit and listen.</l><l xml:id="m-b1ec631e-4378-4ae1-b601-2d7a7677b376" facs="#m-f0d190f1-addb-4f61-8496-1e9858ef02e5" label="text-like">I9a. A reader reads the Lesson at the lectern, or else the celebrant does so</l><l xml:id="m-1c2c01ca-d78f-47fd-ba97-4b497bbcd480" facs="#m-790dc3f4-90ab-4864-998f-09666abc115a" label="ambiguous">sandine in his place.]</l><l xml:id="m-cceda48c-f33e-406a-a26a-7aba5f202f1c" facs="#m-e6260617-7d6c-478c-b17d-52edc3039780" label="ambiguous">LESSON II</l><l xml:id="m-4052ff74-f728-4c55-bba4-72c1e51dca86" facs="#m-770a93be-1f4a-4c77-a4a4-7c7912bb5d43" label="ambiguous">Ex. 12, 1-11</l><l xml:id="m-9dfd0c47-04c5-4313-8636-d032ec26bb4f" facs="#m-adb47086-35b1-4f8c-928c-51f14f39f5d9" label="lyrics-like">TN diébus illis : Dixit Dóminus Israël ad vésperam. Et sument</l><l xml:id="m-b902e083-6463-4666-a182-d22fe9c8f533" facs="#m-eb1a1457-6115-4349-9782-2ab9adef999e" label="lyrics-like">L ad Móysen et Aaron in terra</l><l xml:id="m-ecb3af20-ecb0-415f-aa85-207dab482fa7" facs="#m-342ae319-16c5-4282-b825-41854f64862f" label="lyrics-like">de sánguine ejus, ac ponent</l><l xml:id="m-b90311c0-5f57-46f4-8c1c-3878eb1355ba" facs="#m-6fa0f716-656a-47e8-a3cf-009b855a5633" label="ambiguous">Ægypti: « Mensis iste, vobis</l><l xml:id="m-a81224a5-1d4c-4f2b-a115-33b68cbfe21b" facs="#m-adbb06d1-6a20-409f-9d8b-d159dfe872ea" label="lyrics-like">super utrúmque postem, et in</l><l xml:id="m-84192670-41e5-48c6-b869-3a3345d00fd1" facs="#m-0e4e793d-55b6-4fc8-b6a9-0bf3f493c41b" label="lyrics-like">principium ménsium: primus</l><l xml:id="m-e8db3f95-02e5-4fb7-a465-39aa5a351671" facs="#m-2388a0f3-8c03-4e05-8888-bd42e75f140e" label="lyrics-like">superlimináribus domórum, in</l><l xml:id="m-49c888f0-f032-4305-9557-68dac01e3378" facs="#m-9b050ee9-4335-4bd2-a23f-a52245ffce15" label="lyrics-like">erit in ménsibus anni. Loquimini</l><l xml:id="m-89bb40a9-a380-410e-b7d3-43343ed06040" facs="#m-7a5f14d3-5553-4b16-bbfd-df5c49100afa" label="lyrics-like">quibus cómedent illum. Et edent</l><l xml:id="m-120c2f83-46bd-4125-874f-82f1cb941fdd" facs="#m-cb1ea134-1695-4e1c-81f8-c4a40366a30d" label="lyrics-like">ad univérsum cœtum filiórum</l><l xml:id="m-a0a6978c-8521-403b-97b1-3c495891f5ec" facs="#m-e9302a1a-f855-4fc6-b79b-5d482745994c" label="ambiguous">carnes nocte illa assas igni, et</l><l xml:id="m-f5ff325b-4134-48a3-91ea-3e9d7237aa1f" facs="#m-ec0b5864-644e-42a3-95d5-6a81153e2161" label="lyrics-like">Israël, et dicite eis: Décima</l><l xml:id="m-d66f2346-4ed7-4782-8165-5fb6cac53e78" facs="#m-cf55c71e-d203-44bb-b98c-5f0f9a6cf29d" label="lyrics-like">ázymos panes cum lactúcis agré¬</l><l xml:id="m-d680b873-19e3-4b94-8e5f-f2a4abffa334" facs="#m-cdb7ae56-b7ee-4d0e-917a-2f78111e802e" label="ambiguous">die mensis hujus tollat unus¬</l><l xml:id="m-629426d5-68a6-4ce0-ae0d-7ffca6cf9183" facs="#m-339bf835-9171-45c3-9268-f051ebff22bb" label="lyrics-like">stibus. Non comedétis ex co</l><l xml:id="m-7c24d674-4ccc-43b2-8d94-aa04f7c1b054" facs="#m-1394a07c-6347-4c27-ba70-8a28426240bd" label="ambiguous">quisque agnum per famslias et</l><l xml:id="m-1dead4c8-7b2f-495c-9883-62f3163c3706" facs="#m-118ac1ba-e750-47bf-a99a-06a89612ccba" label="ambiguous">crudum quid, nec coctum aqua,</l><l xml:id="m-5fd42818-617c-404e-a9c2-e60bde7190d5" facs="#m-57906cb1-e635-4e9d-8762-eaeeafe9c87a" label="ambiguous">domos suas. Sin autem minor</l><l xml:id="m-91fddb41-6a46-4cda-89db-5611c451c524" facs="#m-6f9e3cb4-9fc0-4724-8025-b9b8aedfe433" label="ambiguous">sed tantum assum igni: caput</l><l xml:id="m-6fd85d9e-5c99-4228-aca4-690bf0ecf3ca" facs="#m-4ff3d68a-73cf-4d5b-b853-e3d2b4fe49cd" label="lyrics-like">cum pédibus ejus, et intestinis</l><l xml:id="m-122f30a2-413b-4171-b81f-355d64f7bcb4" facs="#m-be48f049-25b1-4f5b-9b34-04058fca647f" label="lyrics-like">est númerus, ut suffícere possit</l><l xml:id="m-b00ac19b-664a-402b-841d-e1c028173d7b" facs="#m-ac605089-53cd-4f04-82ad-07e769ef6850" label="lyrics-like">vorábitis. Nec remanébit quid¬</l><l xml:id="m-f1227234-b59a-41c3-bc16-d5d4d06bb667" facs="#m-c39cde03-52e4-42a0-927c-892e29ae6c60" label="lyrics-like">ad vescéndum agnum, assúmet</l><l xml:id="m-4ee48428-3f0f-4765-822d-172c98608ba9" facs="#m-2dd36ac5-ddf5-4f67-812e-52f211ea9f53" label="ambiguous">quam ex eo usque mane. Si</l><l xml:id="m-b98d6a27-3990-4731-aef3-44278fbb86c5" facs="#m-bbefcf13-5b1e-4445-b5f3-5d8f8cfb4c8a" label="ambiguous">vicinum suum, qui junctus est</l><l xml:id="m-3fc1e83f-ccef-48c9-b80d-9362407227fd" facs="#m-f441bd2b-0da3-44ad-8746-0a8882345bed" label="lyrics-like">quid resíduum fúerit, igne com¬</l><l xml:id="m-3ede6024-e230-4549-a53e-3fb87c8708d3" facs="#m-7819872b-fad2-4a8f-b633-b70f129f860d" label="lyrics-like">dómui suae, juxta númerum ani¬</l><l xml:id="m-c5b5a292-a252-4123-b8d5-7f0c46a66092" facs="#m-b926e178-192c-430e-8e9c-bac9438c9f7a" label="lyrics-like">burétis. Sic autem comedétis</l><l xml:id="m-06936230-4046-4dfa-852d-3c3e68bd8d49" facs="#m-f41a6820-bba4-4846-93ad-ef4812f7bc5f" label="lyrics-like">márum, quae sufficere possunt</l><l xml:id="m-c9b47dbc-f46e-4eb4-b9a8-fa281cf76b6d" facs="#m-d0f4b78d-0567-4a77-ac38-908fda3c6537" label="lyrics-like">illum : Renes vestros accingétis,</l><l xml:id="m-af8f08a9-e345-4d1d-8b39-b9bc9b6616f1" facs="#m-0dfc42a6-7915-4948-aa42-13ebe42ed685" label="ambiguous">ad esum agni. Erit autem agnus</l><l xml:id="m-aed51c80-b6ae-463a-9fd1-60d18ca92564" facs="#m-ec35bf04-e95e-409b-b977-1ffc2648bdc5" label="lyrics-like">et calceaménta habébitis in pé</l><l xml:id="m-8fab46ec-2f9e-4526-b1f2-243eaeb3163c" facs="#m-69ed5214-8dba-4ec7-b0e2-8461955055d2" label="lyrics-like">absque mácula, másculus, anní¬</l><l xml:id="m-3a4e3141-7726-4c1e-99f8-02d348d4f25a" facs="#m-1b351ca7-3e0a-4628-925f-af618f8425d8" label="lyrics-like">dibus, tenéntes báculos in má</l><l xml:id="m-55799a3e-9716-4dcd-b9a9-a29093a571f5" facs="#m-99465562-3784-4e5b-9f9b-78dea4a08fe0" label="lyrics-like">culus : juxta quem ritum tollétis</l><l xml:id="m-aca39901-96e7-4d05-8c47-2f1ba0d6ae8e" facs="#m-79609878-115d-47a9-ac38-4ed70bbabe64" label="lyrics-like">nibus, et comedétis festinánter</l><l xml:id="m-a1d17fb5-8bfc-42ca-9c06-74f4e645d96e" facs="#m-10f439b4-1cdc-40df-b3b2-8eb22b66669c" label="lyrics-like">et haedum. Et servábitis eum</l><l xml:id="m-4bc428f9-b9a1-4383-b055-9cac12271a3c" facs="#m-b872c9cc-b857-42c1-af04-9888a6e4b2ae" label="lyrics-like">est enim Phase, id est tránsitus</l><l xml:id="m-f351ffb4-5f5c-407d-a939-8f53efc0dc08" facs="#m-cfb7cebb-c65c-42a2-8d36-64deddf50965" label="lyrics-like">usque ad quartam décimam diem</l><l xml:id="m-7aacd9d9-acad-4d85-a8c1-bb5ff6a06fb8" facs="#m-8528e094-d6ee-4e71-810c-d3928ecc5db4" label="ambiguous">mensis hujus: immolabitque</l><l xml:id="m-cf889534-3160-4b1e-8f61-8b477ea4077d" facs="#m-36032fdd-64cc-4c98-97c9-54d5d25885cb" label="lyrics-like">Dómini ».</l><l xml:id="m-d055e136-8222-4e7a-a477-c944f220bed7" facs="#m-273117b7-00b5-46cb-9790-64f33bfa8e38" label="lyrics-like">eum univérsa multitúdo filiórum</l><l xml:id="m-23aac2e4-ea4a-46b1-8716-8924cc0eda30" facs="#m-7d0af8e4-8a59-449a-a3e9-9acf9cf591b3" label="text-like">The Responsory is sung by the schola or by the clergy.</l></lg></div></section></score></mdiv></body></music>
</mei>