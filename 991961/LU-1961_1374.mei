                <syllable xml:id="m-45fc8932-a6dc-4dc5-a5ed-597fe87f8716">
                  <syl /><neume facs="#m-83e074bb-d80e-4dff-83e2-548711ebc031" type="torculus" xml:id="m-7f3a5f6e-3a13-4287-8363-92ae781ce584">
