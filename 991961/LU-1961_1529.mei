4" /><zone xml:id="m-facabaa5-3761-4688-bef1-ea01d17c8ae0" ulx="421" uly="730" lrx="535" lry="763" /><zone xml:id="m-4cb41e3d-c2b1-439b-aeb5-e24cf49dc4c1" ulx="60" uly="752" lrx="908" lry="797" /><zone xml:id="m-66e39452-965a-437b-98b3-d029b367b999" ulx="479" uly="783" lrx="778" lry="823" /><zone xml:id="m-a1090a79-c553-4fdd-a587-a646e5d45308" ulx="45" uly="785" lrx="473" lry="822" /><zone xml:id="m-d2e4b369-cbdd-4fda-a077-9142fad8ee60" ulx="43" uly="816" lrx="474" lry="849" /><zone xml:id="m-e34a8fb9-c50a-49f9-b44a-b293917898cc" ulx="49" uly="849" lrx="913" lry="898" /><zone xml:id="m-b20af40c-e779-485d-adcb-653eb54edc71" ulx="53" uly="889" lrx="912" lry="940" /><zone xml:id="m-1e205c32-c6d8-4423-b9dd-e86d57cc580a" ulx="484" uly="919" lrx="912" lry="957" /><zone xml:id="m-d1050ef1-b8c0-4d34-8c35-a37f95e027d9" ulx="50" uly="927" lrx="473" lry="965" /><zone xml:id="m-e107a3ac-9c79-49c3-b1b6-e0052e2ad7f3" ulx="483" uly="946" lrx="912" lry="981" /><zone xml:id="m-ef704aeb-e5da-461f-8ecc-7f6e7a9ca2aa" ulx="46" uly="952" lrx="473" lry="991" /><zone xml:id="m-4a1d8315-6b94-4a7c-9775-489fc5ea01d8" ulx="484" uly="972" lrx="912" lry="1008" /><zone xml:id="m-d94da7d2-1821-4038-ac50-860a2d078f24" ulx="46" uly="978" lrx="472" lry="1014" /><zone xml:id="m-8666d8c6-ff8c-4651-a34e-bfa5dabe09f0" ulx="483" uly="998" lrx="911" lry="1037" /><zone xml:id="m-53297259-b13d-4c49-a14a-2f4103dbff41" ulx="46" uly="1006" lrx="473" lry="1043" /><zone xml:id="m-e561744e-564f-42a9-b595-84f78d3447b9" ulx="484" uly="1027" lrx="912" lry="1065" /><zone xml:id="m-55aa273c-101c-47cd-9958-6f3ad129d147" ulx="46" uly="1032" lrx="471" lry="1070" /><zone xml:id="m-f30951d2-c013-4b8c-ad73-755a7e74b570" ulx="483" uly="1054" lrx="912" lry="1091" /><zone xml:id="m-d86d119e-9389-409e-b53c-5138bbe25295" ulx="47" uly="1059" lrx="473" lry="1099" /><zone xml:id="m-1f1763ae-1367-4765-b5a2-b2a0db338de0" ulx="482" uly="1084" lrx="913" lry="1117" /><zone xml:id="m-43b9a0c0-f798-451f-8c52-9872381127bc" ulx="47" uly="1087" lrx="474" lry="1125" /><zone xml:id="m-956a6be3-8dad-44e6-b6c6-ed6bd66ef51e" ulx="484" uly="1107" lrx="913" lry="1146" /><zone xml:id="m-61299fad-cbab-490d-84ba-455f098997d6" ulx="46" uly="1112" lrx="472" lry="1148" /><zone xml:id="m-8d0fef63-febe-4477-a2a0-344dd560482a" ulx="51" uly="1135" lrx="910" lry="1180" /><zone xml:id="m-917cccb6-7776-4bcb-95d2-ded17f0a19d7" ulx="46" uly="1162" lrx="910" lry="1207" /><zone xml:id="m-6f71b7b6-4256-4afb-abee-6a0c02b02938" ulx="70" uly="1207" lrx="488" lry="1246" /><zone xml:id="m-47a65678-8d07-4033-a689-19121dfb9ba5" ulx="68" uly="1238" lrx="653" lry="1277" /><zone xml:id="m-d947c134-fb5f-4089-941c-1aa609e6a003" ulx="64" uly="1276" lrx="906" lry="1318" /><zone xml:id="m-994ee5be-9b1b-47dd-9c70-eff6bf697d96" ulx="42" uly="1308" lrx="439" lry="1346" /><zone xml:id="m-9ccd4744-861e-4925-a2ea-53063af21ca3" ulx="67" uly="1338" lrx="494" lry="1378" /><zone xml:id="m-89e14399-a4ca-4b7a-88d4-fcfbac8a7cfd" ulx="68" uly="1368" lrx="841" lry="1414" /><zone xml:id="m-f0cdf20e-9b15-46c9-b91a-9e9dff4063a6" ulx="67" uly="1404" lrx="612" lry="1443" /><zone xml:id="m-b323127a-4b7a-4543-b25a-7e5909b28faf" ulx="69" uly="1432" lrx="798" lry="1476" /><zone xml:id="m-0b5d5188-9dc1-4613-99c2-da4e11978187" ulx="68" uly="1467" lrx="526" lry="1506" /><zone xml:id="m-f6b83264-4cb8-477f-a3ce-0dfc3032bf3e" ulx="68" uly="1498" lrx="684" lry="1539" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-5a40cb0d-9dc7-4875-9de7-a2945d652dcf" n="1529" facs="#m-4ff487f5-3328-4f9b-82c5-f755ec455d29" /><div xml:id="m-a86192f5-44fa-464c-969a-39374fced39f">
            <lg xml:id="m-450dc2f3-8535-4221-b31f-57c870407ad7">
              <l xml:id="m-3c94dbf8-28a7-4ddc-9a79-255dd4f22179" facs="#m-77417f8c-9ba7-4c95-b58a-e19b9f338b4a" label="ambiguous">Ianuary 15.</l><l xml:id="m-fd96caa9-d75c-45b7-8304-98d4c62d5a76" facs="#m-8bc599e7-fba6-4423-8e5f-133f61a99a60" label="ambiguous">1329</l><l xml:id="m-dae3e012-9fcb-4748-9fbd-2e03b5fd5875" facs="#m-6c691146-16d7-4ed6-ad98-4fec7982ac74" label="ambiguous">Secret.</l><l xml:id="m-3ad2b63a-7572-41f4-ac03-da6c540f91f1" facs="#m-131b2f70-9f88-4b73-9dab-a47d75c189ea" label="lyrics-like">Ostias tibi, Dómine, beáti Fe-l tuum nobis tribue provenire sub¬</l><l xml:id="m-b55d8cef-d52d-4d08-9578-8d4f683e2231" facs="#m-e388afa3-8c8a-4927-acd5-1fdbf31f296c" label="lyrics-like">It licis Mártyris tui dicátas méri- sidium. Per Dóminum nostrum.</l><l xml:id="m-f2317d7c-dc83-4345-9800-7a151b362887" facs="#m-87fa0798-27c4-479f-9b7b-f522bf873d1c" label="lyrics-like">tis, benígnus assúme: et ad perpé¬</l><l xml:id="m-a6c8a8e8-8f08-4af0-98d8-b4c8376a8b95" facs="#m-b0b27f54-445e-4d91-bbdb-4683db67aee7" label="ambiguous">Postcommunion.</l><l xml:id="m-81cdfb14-a0bc-4fe2-a4ab-cb12e348dd4a" facs="#m-3329d952-3d15-4c50-a796-0b0536bf6dd4" label="lyrics-like">Uaésumus, Dómine, salutáribus celebrámus, oratiónibus adjuvémur.</l><l xml:id="m-450194ce-a781-4c0c-a2df-98920232a52e" facs="#m-0e293b4a-fd37-4308-97a8-04cc76c8bc02" label="lyrics-like">L repléti mystéris : ut beáti Feli¬</l><l xml:id="m-0191bfc2-a6ef-42af-a1e8-78d12c33876e" facs="#m-d6228268-255a-406f-b1ef-cce985dc4121" label="lyrics-like">Per Dóminum nostrum.</l><l xml:id="m-2ba2b789-9ce3-44eb-bef0-212f845ae5e0" facs="#m-4a4de570-3c53-49f7-bbf1-bd83aa640762" label="lyrics-like">cis Mártyris tui, cujus solémnia</l><l xml:id="m-709d579d-4616-4115-a286-0fdf50cf0f90" facs="#m-7cc2283d-2b53-40c4-b9aa-b020ee2e2a67" label="text-like">15. S. Paul. The First Hermit. Confessor.</l><l xml:id="m-f01edd10-c792-4e34-ad12-81887c31e116" facs="#m-4d631e72-cfe0-4f2b-b087-ad1aaa1d3243" label="ambiguous">Double.</l><l xml:id="m-19f41dcf-ffea-478b-877f-fc601ceb9a0a" facs="#m-e97cc85c-ce30-4877-9382-83cc0af697bb" label="text-like">At Mass.</l><l xml:id="m-2aebf4d1-7181-497a-89d9-0bd3407aa3b2" facs="#m-2eb699cb-d53c-4cc1-9b9a-552890f1d2f7" label="lyrics-like">Introit. Jústus ut pálma. D. 1204.</l><l xml:id="m-13c95b08-dca9-46c4-9aef-9fac8a7cb0e2" facs="#m-9cb5352b-da33-4f38-80b0-46eec7b00f5a" label="ambiguous">Collect.</l><l xml:id="m-f7793a2f-148e-436b-b5d3-36adb0b900f0" facs="#m-1466a04d-fd21-4e32-9587-63620e2f6704" label="lyrics-like">Eus, qui nos beáti Pauli Con-[cujus natalitia cólimus, “étiam</l><l xml:id="m-103da6fc-8f1e-4eb1-a1e6-d00b907011b5" facs="#m-27b7de6d-ec86-4147-acd7-3b0fbee30e9c" label="lyrics-like">U fessóris tui ánnua solemnitâte actiónes imitémur. Per Dóminum.</l><l xml:id="m-e977db0a-cb50-40bc-a388-dbebd70c708b" facs="#m-1b0985dd-e7ce-4085-9542-a4005803b324" label="lyrics-like">laetíficas:t concéde propstius: ut</l><l xml:id="m-fc45307e-1db1-42c6-a034-a8fcbf75c02d" facs="#m-81062e53-974e-4a1f-b3f0-ce049e7d7ae8" label="text-like">Commemoration of St. Maurus. Abbot.— Mass. Os justi. 1206.</l><l xml:id="m-18f1ebbf-9dd5-4221-b8c4-cb7554d4ef65" facs="#m-facabaa5-3761-4688-bef1-ea01d17c8ae0" label="ambiguous">Collect.</l><l xml:id="m-7bd55080-12a7-448e-82e5-717be46c75d5" facs="#m-4cb41e3d-c2b1-439b-aeb5-e24cf49dc4c1" label="lyrics-like">TNtercéssio nos, quaésumus Dó-] non valémus, ejus patrocinio asse¬</l><l xml:id="m-0d1cebe7-2e8f-47fd-b623-088d2339088f" facs="#m-66e39452-965a-437b-98b3-d029b367b999" label="lyrics-like">quámur. Per Dóminum.</l><l xml:id="m-8820d4d5-ce2f-4157-987b-bbcd09d4e84e" facs="#m-a1090a79-c553-4fdd-a587-a646e5d45308" label="lyrics-like">L mine, beáti Mauri Abbátis com¬</l><l xml:id="m-5fa6bdd1-2e43-446f-a039-88e6095facaa" facs="#m-d2e4b369-cbdd-4fda-a077-9142fad8ee60" label="lyrics-like">méndet :* ut quod nostris méritis</l><l xml:id="m-41b507d1-5654-407d-a5a9-1ade760b31e5" facs="#m-e34a8fb9-c50a-49f9-b44a-b293917898cc" label="ambiguous">Lectio Epistolae beati Pauli Apostoli ad Philippenses. Phil. 3. b.</l><l xml:id="m-b64773f8-dd79-4688-add5-d2d7f52eddc8" facs="#m-b20af40c-e779-485d-adcb-653eb54edc71" label="lyrics-like">L'Ratres: Quae mihi fuérunt fide est Christi Jesu: quae ex Deo</l><l xml:id="m-22f443b5-61b0-4ce1-b874-cb303d3d28ab" facs="#m-1e205c32-c6d8-4423-b9dd-e86d57cc580a" label="lyrics-like">est justitia in fide, ad cognoscéndum</l><l xml:id="m-444fa9af-d243-4e46-83f4-0160a7fab2a1" facs="#m-d1050ef1-b8c0-4d34-8c35-a37f95e027d9" label="lyrics-like">1 lucra, haec arbitrátus sum pro¬</l><l xml:id="m-755ff9bc-2c20-479e-9db8-7575efa70a80" facs="#m-e107a3ac-9c79-49c3-b1b6-e0052e2ad7f3" label="lyrics-like">illum, et virtútem resurrectiónis</l><l xml:id="m-4c25e4cf-fe5f-41f6-915c-bd7f20775387" facs="#m-ef704aeb-e5da-461f-8ecc-7f6e7a9ca2aa" label="lyrics-like">pter Christum detriménta. Verüm¬</l><l xml:id="m-d73eb372-e46f-4eb0-9778-4c026ec152d4" facs="#m-4a1d8315-6b94-4a7c-9775-489fc5ea01d8" label="lyrics-like">ejus, et societátem passiónum il¬</l><l xml:id="m-cc784b1b-2b36-49cd-bcfb-34cf5bf31b28" facs="#m-d94da7d2-1821-4038-ac50-860a2d078f24" label="lyrics-like">tamen exístimo ómnia detrimén¬</l><l xml:id="m-2b0ac601-f69a-4ce4-bbfb-6c17b45b76fd" facs="#m-8666d8c6-ff8c-4651-a34e-bfa5dabe09f0" label="lyrics-like">lius: configurátus morti ejus: si</l><l xml:id="m-1ecbcc78-eb14-48e5-81b1-f179b517a033" facs="#m-53297259-b13d-4c49-a14a-2f4103dbff41" label="lyrics-like">tum esse, propter eminéntem scién¬</l><l xml:id="m-26ade4ac-29b3-4bfe-a6c3-f8a7adddc877" facs="#m-e561744e-564f-42a9-b595-84f78d3447b9" label="lyrics-like">quo modo occúrram ad resurre¬</l><l xml:id="m-7aa16ad7-81fe-4746-bf3b-fc0b2be91b0a" facs="#m-55aa273c-101c-47cd-9958-6f3ad129d147" label="lyrics-like">tiam Jesu Christi Dómini mei:</l><l xml:id="m-f95da3f4-ec1f-4c3b-97d6-bb88c633d0c6" facs="#m-f30951d2-c013-4b8c-ad73-755a7e74b570" label="lyrics-like">ctiónem, quae est ex mórtuis: non</l><l xml:id="m-4e9728fd-9c4a-4d16-8d23-2b7e76159e76" facs="#m-d86d119e-9389-409e-b53c-5138bbe25295" label="lyrics-like">propter quem ómnia detriméntum</l><l xml:id="m-afe66093-f2cf-4227-b7c2-3dd8045ddd4d" facs="#m-1f1763ae-1367-4765-b5a2-b2a0db338de0" label="lyrics-like">quod jam accéperim, aut jam per¬</l><l xml:id="m-92a793c4-ec09-41d1-a379-bbc55e76176f" facs="#m-43b9a0c0-f798-451f-8c52-9872381127bc" label="lyrics-like">feci, et árbitror ut stércora, ut</l><l xml:id="m-52a7e7b6-2344-40fb-a8a2-2aa90ec09da7" facs="#m-956a6be3-8dad-44e6-b6c6-ed6bd66ef51e" label="lyrics-like">féctus sim: sequor autem, si quo</l><l xml:id="m-21889350-7c34-4b1e-b38e-801a99468fe8" facs="#m-61299fad-cbab-490d-84ba-455f098997d6" label="lyrics-like">Christum lucrifáciam, et invéniar</l><l xml:id="m-2f8f076f-d600-4ad6-b206-e7e7cdfd475e" facs="#m-8d0fef63-febe-4477-a2a0-344dd560482a" label="lyrics-like">in illo, non habens meam justitiam, modo comprehéndam, in quo' e</l><l xml:id="m-8dd51e02-552d-4ee8-b8e8-7f78ff32b925" facs="#m-917cccb6-7776-4bcb-95d2-ded17f0a19d7" label="lyrics-like">quae ex lege est, sed illam, quae exl comprehénsus sum a Christó Jesu.</l><l xml:id="m-679d7d5f-a6e8-47c1-910f-0049ada39c16" facs="#m-6f71b7b6-4256-4afb-abee-6a0c02b02938" label="lyrics-like">Gradaat. Jústus ut pálma. p. 1204.</l><l xml:id="m-c10c3491-e4f5-4962-88e4-8fd4889d1bfe" facs="#m-47a65678-8d07-4033-a689-19121dfb9ba5" label="lyrics-like">Alleluia, allelúia. V. Jústus germinábit. p. 1192.</l><l xml:id="m-7f2d0110-f2fd-4626-955b-e036eca996cd" facs="#m-d947c134-fb5f-4089-941c-1aa609e6a003" label="text-like">After Septuagesima, the Alleluia. and its Verse are omitted. The Tract</l><l xml:id="m-c4ab2944-986c-47c5-a260-cf66180ef215" facs="#m-994ee5be-9b1b-47dd-9c70-eff6bf697d96" label="lyrics-like">Beátus vir. p. 1134. is said instead.</l><l xml:id="m-8f2aac71-a085-4c53-9e9a-b4a2ed2d1c1c" facs="#m-9ccd4744-861e-4925-a2ea-53063af21ca3" label="lyrics-like">Gospel. Respóndens Jesus. p. 1391.</l><l xml:id="m-a810ee49-a274-43c6-b486-6334e082273b" facs="#m-89e14399-a4ca-4b7a-88d4-fcfbac8a7cfd" label="lyrics-like">offertory. In virtúte túa. p. 1205. — Secret. Laudis tibi. p. 1203.</l><l xml:id="m-f2f36d57-0e5e-4ec4-bdbb-4f9f2f0d9e6c" facs="#m-f0cdf20e-9b15-46c9-b91a-9e9dff4063a6" label="lyrics-like">of St. Maurus. Secret. Sacris altáribus. p. 1209.</l><l xml:id="m-3dfecff9-8c0a-4883-a673-5f51947682ab" facs="#m-b323127a-4b7a-4543-b25a-7e5909b28faf" label="lyrics-like">Communion. Laetábitur. p. 1149. without Allelúia. at the end.</l><l xml:id="m-cff44552-72a5-4cca-9ad8-243f625ea251" facs="#m-0b5d5188-9dc1-4613-99c2-da4e11978187" label="lyrics-like">Postcommunton. Refécti cibo. p. 1203.</l><l xml:id="m-bff29a02-5600-47e0-87b0-78b6eaeb3ed8" facs="#m-f6b83264-4cb8-477f-a3ce-0dfc3032bf3e" label="lyrics-like">of st. Maurus. Postcommunion. Prótegat nœ. p. 1209.</l></lg></div></section></score></mdiv></body></music>
</mei>