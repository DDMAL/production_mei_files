                <syllable xml:id="m-00b13c34-b7ed-458b-81b5-11512dcdb0af">
                  <syl /><neume facs="#m-076097b4-1e9b-4238-97ea-e4b4218cd68c" type="punctum" xml:id="m-a0a4f872-ce27-421e-ad4a-42f09b0d6f43">
                    <nc xml:id="m-4ce9544f-1135-4b5e-8196-58106ff7f3bf" pname="g" oct="3">
                      <signifLet xml:id="m-4557c168-3579-4613-a737-3787af9f492d" />
                    </nc>
                  </neume>
