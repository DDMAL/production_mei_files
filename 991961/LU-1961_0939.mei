      <graphic xml:id="m-b2c55893-c68e-4b80-b072-8a9ed2ddf1c2" target="0939_original_image.tiff" /><zone xml:id="m-99fac773-7213-4951-9693-425a6b0e3f99" ulx="312" uly="81" lrx="620" lry="112" /><zone xml:id="m-c16dc7a7-e6a3-4eaf-abd0-1452c31c57d2" ulx="797" uly="82" lrx="865" lry="115" /><zone xml:id="m-41ab645c-efcd-4bbd-a272-fb9cd4e27199" ulx="59" uly="124" lrx="863" lry="159" /><zone xml:id="m-67dbe1ee-2bb5-4298-b400-3d4d170aa69a" ulx="59" uly="152" lrx="456" lry="185" /><zone xml:id="m-2ce83870-772c-430f-bd33-8e85fc751921" ulx="466" uly="159" lrx="863" lry="186" /><zone xml:id="m-c3406e29-386c-4583-be33-4e002ef91f72" ulx="58" uly="180" lrx="320" lry="211" /><zone xml:id="m-48d576a1-36a3-41f5-91ef-29aa30a4510d" ulx="468" uly="181" lrx="863" lry="214" /><zone xml:id="m-e3a11323-9742-4507-bbda-e783f657df2c" ulx="83" uly="204" lrx="453" lry="241" /><zone xml:id="m-a547a5e3-3842-4832-825a-0a4508ecc707" ulx="467" uly="207" lrx="863" lry="242" /><zone xml:id="m-f94ec698-1fbd-4cac-a31b-9ebc417f0f82" ulx="58" uly="231" lrx="454" lry="268" /><zone xml:id="m-714a955c-8ef3-4f3b-a36d-0e97bca26b09" ulx="465" uly="232" lrx="863" lry="267" /><zone xml:id="m-154abc6f-4bac-456f-8b15-63883320b8cb" ulx="465" uly="258" lrx="862" lry="291" /><zone xml:id="m-c06db62a-5d6d-4213-bb7b-852a3dbfc2eb" ulx="57" uly="260" lrx="454" lry="292" /><zone xml:id="m-a7c842be-9b45-4928-a3b0-35214144b68f" ulx="56" uly="286" lrx="456" lry="320" /><zone xml:id="m-a2317de3-635d-4d06-b1e6-c203945fb8dc" ulx="463" uly="286" lrx="863" lry="324" /><zone xml:id="m-df3551c8-f43e-4286-a502-35ec4c538c1b" ulx="58" uly="314" lrx="452" lry="347" /><zone xml:id="m-ae0cac50-f23d-4fa6-bb59-f7699aedf902" ulx="468" uly="315" lrx="861" lry="348" /><zone xml:id="m-f41cc721-e4f7-4c31-a0cd-78aab9112a7d" ulx="467" uly="342" lrx="809" lry="375" /><zone xml:id="m-cda5aa10-35a1-4811-b2e3-002d9188393e" ulx="56" uly="343" lrx="454" lry="372" /><zone xml:id="m-7f03a171-3cd3-400d-ad13-93fafed7f080" ulx="490" uly="368" lrx="863" lry="403" /><zone xml:id="m-ff4723a6-2369-409b-ada3-86ca3f22d17e" ulx="57" uly="370" lrx="454" lry="401" /><zone xml:id="m-df2a343e-c8cb-4470-9ab7-4cad7168fce6" ulx="56" uly="393" lrx="453" lry="428" /><zone xml:id="m-0530306b-a0f4-4aac-83fa-12f1e8be6c46" ulx="464" uly="395" lrx="861" lry="427" /><zone xml:id="m-c64f74f8-c432-4806-acfd-102587a907e5" ulx="59" uly="423" lrx="859" lry="452" /><zone xml:id="m-c0a6b464-4cd5-433b-984b-8483933551b7" ulx="59" uly="449" lrx="861" lry="478" /><zone xml:id="m-8a7feb2d-38b4-4a45-90d8-6b2f058f4d4f" ulx="56" uly="473" lrx="861" lry="507" /><zone xml:id="m-1ca70ce9-42fd-45ec-bcd3-2a408d02b686" ulx="56" uly="498" lrx="718" lry="533" /><zone xml:id="m-a637f061-14af-4c24-a554-0287844fb4d4" ulx="78" uly="531" lrx="219" lry="564" /><zone xml:id="m-928b1436-e1c7-4684-8870-0f0b15d84b82" ulx="80" uly="561" lrx="858" lry="601" /><zone xml:id="m-762fe4d1-ae42-4e26-a1f7-6d16d92b6fc2" ulx="396" uly="684" lrx="515" lry="724" /><zone xml:id="m-7f0ec2a2-5535-4017-9fb0-820f21499ea2" ulx="114" uly="753" lrx="244" lry="784" /><zone xml:id="m-5b98554f-047d-458a-a458-c5cc0d77b0f2" ulx="84" uly="777" lrx="251" lry="811" /><zone xml:id="m-9fed61c5-f3d5-408b-8c06-b83bec086e03" ulx="318" uly="819" lrx="570" lry="860" /><zone xml:id="m-90a126df-d8d6-43b6-b8ed-481a32083d72" ulx="50" uly="861" lrx="856" lry="898" /><zone xml:id="m-4ee530ed-3124-483e-b473-4b5b1536b8da" ulx="50" uly="888" lrx="451" lry="922" /><zone xml:id="m-fbb4fab3-60ae-43fe-8ae7-4e60ee5fbb8b" ulx="379" uly="1010" lrx="501" lry="1050" /><zone xml:id="m-94850841-cd15-44d3-a487-203056cbf332" ulx="47" uly="1041" lrx="854" lry="1077" /><zone xml:id="m-23b37070-a441-42a1-921a-cbbe21439e2e" ulx="48" uly="1068" lrx="852" lry="1107" /><zone xml:id="m-408d83cf-fb7f-463e-b4ab-896b55a314f0" ulx="47" uly="1095" lrx="138" lry="1131" /><zone xml:id="m-4bf67553-d5df-44cd-a2aa-ce56c3ca00d5" ulx="402" uly="1127" lrx="498" lry="1159" /><zone xml:id="m-865b3963-95cc-4acc-bde3-fa148fa8f53f" ulx="89" uly="1151" lrx="856" lry="1191" /><zone xml:id="m-70d42e83-4937-4430-80c0-7bd9e6556e57" ulx="55" uly="1180" lrx="855" lry="1219" /><zone xml:id="m-7715ff2e-ab91-4ed3-a4d1-5b106daf2fbc" ulx="50" uly="1209" lrx="445" lry="1244" /><zone xml:id="m-f758c625-f916-4674-a308-0c6885022ea3" ulx="459" uly="1209" lrx="856" lry="1241" /><zone xml:id="m-c6c5e4ff-166f-4603-925f-f07ccf31ac0e" ulx="457" uly="1232" lrx="853" lry="1267" /><zone xml:id="m-e6b3b4ba-5174-46d4-a0d9-02b7898cc4fe" ulx="50" uly="1236" lrx="448" lry="1268" /><zone xml:id="m-a7429393-a05f-4755-a2f2-57502e5600b4" ulx="50" uly="1262" lrx="450" lry="1299" /><zone xml:id="m-dd791dcb-fc46-44a0-a6a6-8305aa7a3d44" ulx="458" uly="1264" lrx="833" lry="1295" /><zone xml:id="m-edd18868-9955-4373-81b2-f46d313d65df" ulx="487" uly="1287" lrx="620" lry="1326" /><zone xml:id="m-53adbe5e-2f35-4d2f-99d1-8f7ea035b5fe" ulx="50" uly="1289" lrx="456" lry="1326" /><zone xml:id="m-8a403e6f-9e9f-4254-8b8c-253195ab58ca" ulx="527" uly="1331" lrx="787" lry="1371" /><zone xml:id="m-826a7607-338c-47f8-b851-6b894a27494c" ulx="142" uly="1334" lrx="310" lry="1372" /><zone xml:id="m-b7828b3f-0416-4107-aaf9-059569c8e8d0" ulx="73" uly="1365" lrx="857" lry="1404" /><zone xml:id="m-4cae67c7-fbd3-46e7-9e82-d206051d0312" ulx="459" uly="1392" lrx="857" lry="1429" /><zone xml:id="m-37cd439f-4c33-4595-8336-38697c4c3531" ulx="53" uly="1394" lrx="451" lry="1428" /><zone xml:id="m-6199205d-6279-46eb-b199-83fb397a334c" ulx="53" uly="1418" lrx="856" lry="1459" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-e4ba0c11-274a-47eb-8762-f8a0b022de5a" n="0939" facs="#m-16474a2f-3a6f-42af-b4be-ec4b1e0629a9" /><div xml:id="m-180b05f4-9606-40c1-8e61-ca8804ebd7ad">
            <lg xml:id="m-f8d3b82d-819c-4e15-b378-dc1e7bb3017a">
              <l xml:id="m-65bf954c-9519-40a4-b48b-68a4c93d64d7" facs="#m-99fac773-7213-4951-9693-425a6b0e3f99" label="text-like">The readings or lessons</l><l xml:id="m-758b6944-1ab9-40ca-a978-164df08ceb29" facs="#m-c16dc7a7-e6a3-4eaf-abd0-1452c31c57d2" label="ambiguous">7760</l><l xml:id="m-9aa82aca-a9fd-452e-a65d-a9ba2cef851a" facs="#m-41ab645c-efcd-4bbd-a272-fb9cd4e27199" label="lyrics-like">imáginem suam: ad imáginem cunctis animántibus terrae, om¬</l><l xml:id="m-5dcc85b5-55da-4e6e-bc99-1a5113f93251" facs="#m-67dbe1ee-2bb5-4298-b400-3d4d170aa69a" label="lyrics-like">Dei creávit illum, másculum et</l><l xml:id="m-d412f7f8-dd1b-4c52-a338-539c4c717e82" facs="#m-2ce83870-772c-430f-bd33-8e85fc751921" label="lyrics-like">nique vólucri caeli, et univérsis</l><l xml:id="m-841b3a6e-5167-46d3-be2e-7e3a62221a82" facs="#m-c3406e29-386c-4583-be33-4e002ef91f72" label="lyrics-like">féminam creávit eos.</l><l xml:id="m-d198dec4-7bff-49b4-a944-50a292a20b5f" facs="#m-48d576a1-36a3-41f5-91ef-29aa30a4510d" label="lyrics-like">quae movéntur in terra, et in</l><l xml:id="m-00f98951-9e41-406a-967b-82dfbcba899c" facs="#m-e3a11323-9742-4507-bbda-e783f657df2c" label="ambiguous">Benedixitque illis Deus, et ait:</l><l xml:id="m-5b204499-cca6-4bf9-a14c-d338d28316ca" facs="#m-a547a5e3-3842-4832-825a-0a4508ecc707" label="lyrics-like">quibus est ánima vivens, ut</l><l xml:id="m-f83e34c5-8a6e-4149-b451-b7310dc7c1dc" facs="#m-f94ec698-1fbd-4cac-a31b-9ebc417f0f82" label="lyrics-like">«Créscite, et multiplicámini, et</l><l xml:id="m-54f0ad85-b5b0-4d68-ac8f-30d92f5d25a7" facs="#m-714a955c-8ef3-4f3b-a36d-0e97bca26b09" label="lyrics-like">hábeant ad vescéndum ». Et</l><l xml:id="m-230969db-7efa-4a81-8f46-99f32f1abff4" facs="#m-154abc6f-4bac-456f-8b15-63883320b8cb" label="ambiguous">factum est ita. Viditque Deus</l><l xml:id="m-59c4699c-512d-4ec4-8854-826814a5c760" facs="#m-c06db62a-5d6d-4213-bb7b-852a3dbfc2eb" label="lyrics-like">repléte terram, et subjicite eam,</l><l xml:id="m-e676ae26-8253-4a8e-b05a-c13b7f2f22a1" facs="#m-a7c842be-9b45-4928-a3b0-35214144b68f" label="lyrics-like">et dominámini piscibus maris, et</l><l xml:id="m-53286613-7a69-4271-a292-78101d5ad0f6" facs="#m-a2317de3-635d-4d06-b1e6-c203945fb8dc" label="lyrics-like">cuncta, quae fécerat: et erant</l><l xml:id="m-675448ca-1852-4ae5-8306-20a24db79492" facs="#m-df3551c8-f43e-4286-a502-35ec4c538c1b" label="lyrics-like">volatflibus caelí, et univérsis ani¬</l><l xml:id="m-cb0c3cba-f82e-4e04-bd47-7d010faf5dae" facs="#m-ae0cac50-f23d-4fa6-bb59-f7699aedf902" label="lyrics-like">valde bona. Et factum est vé¬</l><l xml:id="m-c67d3ad7-3f08-4fdd-8d80-074cdef6b53b" facs="#m-f41cc721-e4f7-4c31-a0cd-78aab9112a7d" label="ambiguous">spere, et mane, dies sextus.</l><l xml:id="m-6d867c33-6914-4de2-b5db-9466dcdda0ab" facs="#m-cda5aa10-35a1-4811-b2e3-002d9188393e" label="lyrics-like">mántibus, quae movéntur super</l><l xml:id="m-1006deac-323d-4e0e-ab82-8993d7a4f049" facs="#m-7f03a171-3cd3-400d-ad13-93fafed7f080" label="lyrics-like">Igitur perfécti sunt caeli, et</l><l xml:id="m-37b0b63a-191f-4586-949f-a9de65d8491d" facs="#m-ff4723a6-2369-409b-ada3-86ca3f22d17e" label="ambiguous">terram ». Dixitque Deus: « Ecce</l><l xml:id="m-c7745dee-72a7-4e78-beb5-5b036bc1d06f" facs="#m-df2a343e-c8cb-4470-9ab7-4cad7168fce6" label="ambiguous">dedi vobis omnem herbam affe¬</l><l xml:id="m-91ea5d45-fa2e-42f1-a6a2-2331c875664f" facs="#m-0530306b-a0f4-4aac-83fa-12f1e8be6c46" label="lyrics-like">terra, et omnis ornátus eórum.</l><l xml:id="m-4803042a-4aec-4e76-b0fa-4b3bdd9a468f" facs="#m-c64f74f8-c432-4806-acfd-102587a907e5" label="lyrics-like">réntem semen super terram, et! Complevitque Deus die séptimo</l><l xml:id="m-c1eac97a-351c-4e76-93a3-bd740fb84915" facs="#m-c0a6b464-4cd5-433b-984b-8483933551b7" label="lyrics-like">univérsa ligna, quae habent in lopus suum quod fécerat: et</l><l xml:id="m-f6ef5f16-a51e-4198-ae44-ec070d727023" facs="#m-8a7feb2d-38b4-4a45-90d8-6b2f058f4d4f" label="lyrics-like">semetipsis seméntem géneris sui, lrequiévit die séptimo ab univérso</l><l xml:id="m-d345515e-accd-4965-9040-dfd8cfc56f4b" facs="#m-1ca70ce9-42fd-45ec-bcd3-2a408d02b686" label="lyrics-like">ut sint vobis in escam: et ópere quod patrárat.</l><l xml:id="m-144d108d-db2a-4af2-bab4-60b1b265dc6e" facs="#m-a637f061-14af-4c24-a554-0287844fb4d4" label="ambiguous">All now rise.</l><l xml:id="m-15f9a526-1cb1-4c01-b3d3-f245b967595a" facs="#m-928b1436-e1c7-4684-8870-0f0b15d84b82" label="text-like">The celebrant lor the priest standing at the lectern or at his seatl says:</l><l xml:id="m-acdf97c1-3ef1-41c1-9785-c77be8bd3fa6" facs="#m-762fe4d1-ae42-4e26-a1f7-6d16d92b6fc2" label="lyrics-like">Orémus.</l><l xml:id="m-ff8af1f2-6588-45da-b437-1a6de6226950" facs="#m-7f0ec2a2-5535-4017-9fb0-820f21499ea2" label="text-like">The deacon</l><l xml:id="m-40c5d4eb-f725-42f1-8cd7-e8bd42a985b5" facs="#m-5b98554f-047d-458a-a458-c5cc0d77b0f2" label="text-like">tor the priesil :</l><l xml:id="m-7b858abf-bdf5-4280-809d-63d96859fd2f" facs="#m-9fed61c5-f3d5-408b-8c06-b83bec086e03" label="lyrics-like">Flectámus génu-a.</l><l xml:id="m-71f10ddb-7c21-4c5d-8f1c-c994abd3307e" facs="#m-90a126df-d8d6-43b6-b8ed-481a32083d72" label="text-like">and all kneel woith the celebrant to pray in silence for a few moments. When</l><l xml:id="m-8b7f3138-c6d9-4f1c-881e-e8b194c58a2e" facs="#m-4ee530ed-3124-483e-b473-4b5b1536b8da" label="text-like">the deacon lor the celebrantl has said:</l><l xml:id="m-90766aa2-d5f2-4bb0-95dc-b1047dc28509" facs="#m-fbb4fab3-60ae-43fe-8ae7-4e60ee5fbb8b" label="lyrics-like">Le-vá-te,</l><l xml:id="m-7c33a11b-db92-4b56-bea9-c30c9ce3171f" facs="#m-94850841-cd15-44d3-a487-203056cbf332" label="text-like">all rise; the celebrant, vith his hands joined, sings the Collect to the ferial</l><l xml:id="m-fe16786c-bcaf-47f9-8e36-1806e7fbbbb3" facs="#m-23b37070-a441-42a1-921a-cbbe21439e2e" label="text-like">tone A (or the ancient solemn tone), while an acolyte Iserverl holds the book</l><l xml:id="m-273e4523-02cc-40c5-b2d5-1a97f1862d09" facs="#m-408d83cf-fb7f-463e-b4ab-896b55a314f0" label="text-like">for him.</l><l xml:id="m-99a28ef3-ba26-45af-8722-a8d26a35a850" facs="#m-4bf67553-d5df-44cd-a2aa-ce56c3ca00d5" label="text-like">Prayer</l><l xml:id="m-8c37469c-6caa-464c-b7a7-58ea15a85151" facs="#m-865b3963-95cc-4acc-bde3-fa148fa8f53f" label="lyrics-like">Eus, qui mirabiliter creásti pervenire. Per Dóminum no¬</l><l xml:id="m-51919378-f774-4a23-89dd-354147ee5c6e" facs="#m-70d42e83-4937-4430-80c0-7bd9e6556e57" label="lyrics-like">U hóminem, et mirabilius red-lstrum Jesum Christum Filium</l><l xml:id="m-bf048010-e637-413c-bcee-4e64c6d063d5" facs="#m-7715ff2e-ab91-4ed3-a4d1-5b106daf2fbc" label="lyrics-like">emisti : * da nobis, quaésumus,</l><l xml:id="m-bd8ee025-9b65-4d94-b3e2-d81fc3290e26" facs="#m-f758c625-f916-4674-a308-0c6885022ea3" label="ambiguous">tuum:"Qui tecum vivit et regnat</l><l xml:id="m-ea4034b8-d2d3-434c-9cf5-091cc70cc340" facs="#m-c6c5e4ff-166f-4603-925f-f07ccf31ac0e" label="lyrics-like">in unitáte Spíritus Sancti Deus:</l><l xml:id="m-48066423-ebbc-49bf-b483-e2932da62f33" facs="#m-e6b3b4ba-5174-46d4-a0d9-02b7898cc4fe" label="lyrics-like">contra oblectaménta peccáti.</l><l xml:id="m-b2a17d93-075b-41ab-8ccd-39cf44ac123b" facs="#m-a7429393-a05f-4755-a2f2-57502e5600b4" label="lyrics-like">mentis ratióne persistere; ut</l><l xml:id="m-c42547c3-72dd-44c2-9588-52b1d00cde23" facs="#m-dd791dcb-fc46-44a0-a6a6-8305aa7a3d44" label="lyrics-like">per ómnia saécula saeculórum.</l><l xml:id="m-0295d220-4cbf-4f89-9037-f56fff6abae5" facs="#m-edd18868-9955-4373-81b2-f46d313d65df" label="ambiguous">W. Amen.</l><l xml:id="m-b3069960-41e9-45f2-91ec-789c9814bc35" facs="#m-53adbe5e-2f35-4d2f-99d1-8f7ea035b5fe" label="lyrics-like">mereámur ad actérna gáudia</l><l xml:id="m-d65d9756-8b36-40e5-b84f-ca6bc9c3211f" facs="#m-8a403e6f-9e9f-4254-8b8c-253195ab58ca" label="text-like">Ex. 14, 24-31 and 15, 1</l><l xml:id="m-c21b924b-37ad-4bb4-949d-bbd0eee066d0" facs="#m-826a7607-338c-47f8-b851-6b894a27494c" label="ambiguous">LESSON II</l><l xml:id="m-262eec08-efdc-4a77-9656-92c03b921621" facs="#m-b7828b3f-0416-4107-aaf9-059569c8e8d0" label="lyrics-like">N diébus illis: Factum est Ægyptiórum per colúmnam</l><l xml:id="m-d42addeb-20ec-49c2-8a27-769fc7446678" facs="#m-4cae67c7-fbd3-46e7-9e82-d206051d0312" label="lyrics-like">ignis et nubis, interfécit exér¬</l><l xml:id="m-6ba7c6f1-1428-4079-9070-386e3b8ab79a" facs="#m-37cd439f-4c33-4595-8336-38697c4c3531" label="ambiguous">Lin vigilia matutina, et ecce</l><l xml:id="m-c0a25cb7-f6fd-4091-a259-b4ab44ddd986" facs="#m-6199205d-6279-46eb-b199-83fb397a334c" label="lyrics-like">respíciens Dóminus super castral citum eórum : et subvértit rotas</l></lg></div></section></score></mdiv></body></music>
</mei>