                  <syl /><neume facs="#m-60192e33-7816-46ab-a8f1-4d65f069a346" type="punctum" xml:id="m-f45b7dbe-a6ec-481f-b7ed-455974fb3e3b">
                    <nc xml:id="m-23621289-3577-4680-b29f-be9c15fb96bb" pname="c" oct="4" />
