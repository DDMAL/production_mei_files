                    <nc xml:id="m-530ca288-98de-41f4-826e-8550c8d6f798" pname="c" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-64286340-677c-4be6-9e59-44b76791370d">
                  <syl /><neume facs="#m-133fed03-1e86-41b3-afac-701f91d2bbdb" type="punctum" xml:id="m-07f87c40-00d2-43e6-9910-44c08b7992ee">
                    <nc xml:id="m-89b2a46d-d252-4d3f-a6e3-6f195ec0bc63" pname="c" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-16e9ce8a-2168-4f70-987a-fd17075f240f">
                  <syl /><neume facs="#m-27db2712-7097-4f2a-8256-7db7d5e9a2e6" type="punctum" xml:id="m-397ba755-c631-4241-a178-b5153b9fe44c">
                    <nc xml:id="m-9a91a059-7f80-4ec1-af73-9ea143f1c0ba" pname="d" oct="4"><episema xml:id="m-69b9aa0e-b62a-46d5-89a7-e4165fe7be44" form="v" /></nc>
                  </neume>
                </syllable>
                <syllable xml:id="m-239d6185-199c-412f-a6c3-07ab7d09c572">
                  <syl /><neume facs="#m-da636019-09a8-40c3-8eb4-69b238072c19" type="punctum" xml:id="m-44ffa455-624f-4faf-9041-c8721858fd6b">
                    <nc xml:id="m-b7b9cc34-b35f-4fa2-8fd2-200419c648e0" pname="c" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-f25cd109-45ca-45e9-a024-5cde422de8db">
                  <syl /><neume facs="#m-1ef5226c-13f3-40a9-b66c-9af6a34d4e0e" type="punctum" xml:id="m-a43bc946-1326-4b7c-9186-1b73be856b07">
                    <nc xml:id="m-bb0594d9-54e4-411c-95bf-e361fc702e76" pname="b" oct="3">
                      <signifLet xml:id="m-3960d774-c4c7-493e-a46d-37168806af4f" />
                    </nc>
                  </neume>
                </syllable>
                <syllable xml:id="m-e1bc9c37-25f3-479d-bf4c-88fe611ffb0f">
                  <syl /><neume facs="#m-9a52df0c-a47c-442d-bbe7-b2e85d52f685" type="punctum" xml:id="m-28d8dc5b-8bef-42c4-b425-28dbbfb5358e">
                    <nc xml:id="m-9fb750dc-58aa-4e4c-a381-3ef66333c258" pname="b" oct="3">
                      <signifLet xml:id="m-c989245b-28e3-4d7e-a9f2-a1388eae737e" />
