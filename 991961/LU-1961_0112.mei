 /><zone xml:id="m-e7e4d4c8-3ce4-4d4b-929f-809d2428e6c3" ulx="553" uly="1250" lrx="983" lry="1280" /><zone xml:id="m-ab22cf6c-b2b8-467a-aa33-1fe291d4d15e" ulx="110" uly="1257" lrx="535" lry="1292" /><zone xml:id="m-a4830800-e335-4222-88f8-4d1769d44e35" ulx="553" uly="1274" lrx="981" lry="1308" /><zone xml:id="m-4c6b815e-9217-4788-b82e-261d23bf9d34" ulx="112" uly="1281" lrx="536" lry="1320" /><zone xml:id="m-91c57c20-d25e-4764-ba52-e95a1d00b00c" ulx="552" uly="1300" lrx="982" lry="1336" /><zone xml:id="m-a762f620-7ba3-493c-838c-aef2e8ad4aa0" ulx="110" uly="1308" lrx="289" lry="1346" /><zone xml:id="m-580fcaf5-2d9e-4b2c-bda0-c5f64cfbf0eb" ulx="552" uly="1329" lrx="979" lry="1363" /><zone xml:id="m-c543a6d8-dcae-427e-8b25-d959c0052522" ulx="196" uly="1344" lrx="454" lry="1387" /><zone xml:id="m-b2e2add7-4af3-4c90-b935-f4db096cc39b" ulx="552" uly="1353" lrx="981" lry="1388" /><zone xml:id="m-fe99716f-8903-404d-ad44-bb0c6f7c3d00" ulx="552" uly="1380" lrx="982" lry="1418" /><zone xml:id="m-dbf39330-c434-4d49-9a93-be972fb50067" ulx="162" uly="1382" lrx="533" lry="1424" /><zone xml:id="m-e3cbfea6-cb00-40e2-b814-7a0b5fc129a6" ulx="112" uly="1404" lrx="539" lry="1447" /><zone xml:id="m-a9b39e1a-f870-4fd5-9e3f-2c8bd08b9219" ulx="553" uly="1409" lrx="982" lry="1444" /><zone xml:id="m-aa854075-d092-40a3-a188-6879100d3eef" ulx="553" uly="1439" lrx="888" lry="1470" /><zone xml:id="m-fffbb11e-00b5-40c2-837f-d5c6665d9fd6" ulx="112" uly="1441" lrx="539" lry="1476" /><zone xml:id="m-f2f6961d-ac93-4e85-b1ba-a96a65e9a6b6" ulx="580" uly="1464" lrx="982" lry="1509" /><zone xml:id="m-cbdd44b7-cd3a-4189-8638-2afde94fdbba" ulx="111" uly="1468" lrx="540" lry="1504" /><zone xml:id="m-ca524890-a992-415f-993f-f1eb0a10ce9d" ulx="112" uly="1496" lrx="686" lry="1533" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-f97a2a7a-e34f-45a6-a9ba-1cda3b58efab" n="0112" facs="#m-f67b10c9-f3c1-4e85-9dee-ef706398c505" /><div xml:id="m-87bd6935-ebdc-4b43-8d54-71bbff00eb52">
            <lg xml:id="m-bde092b9-ef87-4ae1-b704-ca633c4330b5">
              <l xml:id="m-1da21f88-202a-4d9a-b9fb-5ebc0fd13bfe" facs="#m-a6f7bf2c-4692-49fd-a0da-f6f2ddcfeeb3" label="text-like">The Ordinary of the Mass.</l><l xml:id="m-a990096b-4d31-49e4-84b0-7d7c2f9ac9c3" facs="#m-4f6b9a90-d499-414b-8234-15feaa4bf925" label="ambiguous">2</l><l xml:id="m-3a1aabab-9cd5-4e10-96d3-3b924c72360c" facs="#m-5be1baa3-77bd-4732-a8f7-d865db6ee6d9" label="lyrics-like">Orémus.</l><l xml:id="m-264cfe9b-07fd-46ed-9ca7-89bd4cf0b531" facs="#m-f1daf85b-6f83-4ab8-a86a-8836dd591baf" label="lyrics-like">Evangélium tuum digne váleam</l><l xml:id="m-2860d8b0-fc76-44ec-b6bf-749cdae90951" facs="#m-f4351878-b6cd-4a54-a681-a1c8c8689e43" label="lyrics-like">nuntiãre. Per Christum Dóminum</l><l xml:id="m-de14c919-da8d-4028-914d-50e098fa5faf" facs="#m-2bee351d-3bda-448e-98ef-82c37f882f2a" label="lyrics-like">IUfer a nobis, quaésumus Dómi¬</l><l xml:id="m-39224a03-a152-4831-bcbe-8b59b3332daf" facs="#m-654c5d19-386f-417c-8b3f-89857d7f24a0" label="ambiguous">nostrum. Amen.</l><l xml:id="m-3be4068a-62ae-4d55-b4aa-ea2c27c205e5" facs="#m-f92a34cd-785c-466f-80db-0035dac7b482" label="lyrics-like">I ne, iniquitátes nostras: ut ad</l><l xml:id="m-75e98972-cb2a-4908-9808-2fdb128178c6" facs="#m-46ecb1b8-fdcb-4185-ade3-c089981473a5" label="lyrics-like">Jube Dómine benedicere.</l><l xml:id="m-18a74705-2341-4145-b9f3-f319eade167e" facs="#m-ef7304a6-5d13-428c-82ca-b7e2664edffd" label="lyrics-like">Sancta sanctórum puris mereámur</l><l xml:id="m-0a4c6a88-7847-4a6d-95a9-34f393d0432c" facs="#m-d5d917ae-8dad-4b46-b686-9b3fb90415b7" label="lyrics-like">méntibus introire. Per Christum Dó¬</l><l xml:id="m-95922922-43ec-497d-8f4a-3193d5144eb3" facs="#m-31ec1936-724b-4fee-b0bb-27b875b4523f" label="lyrics-like">Dóminus sit in corde meo, et in</l><l xml:id="m-a98eefe8-7579-4833-a0cb-162fb9c07dd1" facs="#m-17873b13-68e2-489c-a630-0a51831f3260" label="ambiguous">minum nostrum. Amen.</l><l xml:id="m-4d1ce389-6db8-4bb3-b495-46f9077e80ad" facs="#m-20ece4d5-01e8-4b0e-b366-1401bab1926f" label="lyrics-like">lábiis meis : ut digne et competén¬</l><l xml:id="m-7859e607-f480-4df0-ac25-26893687f75c" facs="#m-c97e5fb4-638f-4885-9a3e-e8094f578829" label="lyrics-like">Orámus te, Dómine, per mérita</l><l xml:id="m-9c4a5cd7-492b-44cb-9a90-23571f08f325" facs="#m-bea02c05-15fc-4789-a664-084063352160" label="lyrics-like">ter annúntiem Évangélium suum.</l><l xml:id="m-259dd852-84dc-4eaf-8ef2-ee6d48ec508b" facs="#m-a6738174-6236-48b8-8733-23850fe22844" label="lyrics-like">sanctórum tuórum, quorum relí¬</l><l xml:id="m-a773ad72-a696-41af-9dca-24a5cb334f70" facs="#m-feb748b9-92a0-46ce-943e-00edf5cb7d24" label="ambiguous">Amen.</l><l xml:id="m-1cebc869-d905-479f-b410-1630a52d9a93" facs="#m-afb5f510-941c-452b-aa41-27d2d80cb2e9" label="lyrics-like">quiae hic sunt, et ómnium sanctó¬</l><l xml:id="m-31914dce-a098-4564-ab1a-48ece35d9869" facs="#m-1ef03cdc-07ac-4fef-97b6-b25386ff2ef9" label="lyrics-like">V. Dóminus vobiscum. H. Et cum</l><l xml:id="m-b2cf0382-e787-41f6-bc4d-12389b45f9a8" facs="#m-b9e237d0-f41b-43e6-a862-c4d482c486ab" label="lyrics-like">rum : ut indulgére dignéris ómnia</l><l xml:id="m-ef8597ed-f182-4f4c-99f3-1e5becd87cd6" facs="#m-9fc657ff-6ca3-4415-8e01-fbf22fe007e8" label="ambiguous">spiritu tuo.</l><l xml:id="m-c14c6632-9bdd-49fc-84d6-8fde12732ddf" facs="#m-8e2b955e-40a9-4fa1-b13f-73eded071b57" label="lyrics-like">peccáta mea. Amen.</l><l xml:id="m-37c66827-0cd2-4cae-a171-937cc4404bad" facs="#m-a8a72194-a527-4c5f-aa0d-85e2ce0d6742" label="lyrics-like">Initium or Sequéntia sancti</l><l xml:id="m-101f4fbe-e659-410d-8835-a8ef6a3a9d48" facs="#m-dc9b6894-ba9e-4980-8b00-d125aa687036" label="text-like">The Priest reaas the Introit. Then</l><l xml:id="m-ad981acc-a358-41bf-b0a7-ea4a0d6667b4" facs="#m-c9a8c89a-b2b2-4bcd-9055-5f4f38b90fed" label="lyrics-like">Evãngélii secúndum N.</l><l xml:id="m-4f4843bc-d9cd-44c4-9162-51a891326898" facs="#m-55bc19a5-8353-4746-9745-7daa8c21da4e" label="text-like">he says atternatety with the servers.</l><l xml:id="m-6905e2e3-c979-44dd-b14a-a53d0e1c7699" facs="#m-db4a6e14-c60e-4775-8208-f01751634419" label="lyrics-like">E. Glória tibi Dómine.</l><l xml:id="m-89dc080b-1a2c-4405-a371-5ce12f4a3939" facs="#m-62d6e53a-09c1-4914-a233-ab484c7a0c8c" label="lyrics-like">Kyrie eléison. Kyrie eléison. Ky¬</l><l xml:id="m-86a461ef-8373-4b9a-990a-88ad53b11f8d" facs="#m-8f2b6b01-b26c-4e4c-ad1e-2dd5a49cd0e9" label="lyrics-like">After the Gospel: Laus tíbi,</l><l xml:id="m-dae90491-24a8-4b55-82b8-3d8281b7bdab" facs="#m-eb81dd93-20f5-482b-93bd-add11dd5e783" label="lyrics-like">rie eléison.</l><l xml:id="m-2b572310-64db-490c-abdc-bf8c8ec6d64f" facs="#m-3aa491b7-61b6-43db-a0dc-f048ce2d75cf" label="ambiguous">Christe.</l><l xml:id="m-ccb13968-871c-4839-980d-ad61aca78ebd" facs="#m-5b24a44a-638f-457a-b829-50ac1908d1f4" label="lyrics-like">Christe eléison. Christe eléison.</l><l xml:id="m-872f9c0a-c126-459a-85e5-86df2cf80a60" facs="#m-d23e17f6-09a2-4693-b80d-1d63f6ac954b" label="lyrics-like">(Rédo in únum Déum, Pâtrem</l><l xml:id="m-76ae83e2-a61f-4bbb-967f-67497a1691fe" facs="#m-bc0be395-c84c-402d-9b7b-54f2fb1ca637" label="lyrics-like">Christe eléison.</l><l xml:id="m-b994c2bf-7756-4fd4-823a-8b83b5e5b9f7" facs="#m-075447e3-94b8-4e25-bf91-e2e07ff80a78" label="lyrics-like">Kyrie eléison. Kyrie eléison. Ky.</l><l xml:id="m-abf09b35-5aad-4b6c-b11f-297a5f250f62" facs="#m-5e72f391-a0d0-48f5-923e-ba3d3dc346ee" label="lyrics-like">L omnipoténtem, factórem caéli</l><l xml:id="m-532dc8cc-1d93-4826-ae45-bae96cde4d1b" facs="#m-37d26edd-90e5-4520-8529-f9dce005956b" label="ambiguous">rie eleison.</l><l xml:id="m-c7995d80-32d7-41d4-b9b3-c2a0416f4b34" facs="#m-1c6846d3-1608-483d-804a-6759f383ef58" label="lyrics-like">et térrae, visibilium ómnium et in¬</l><l xml:id="m-c5a1fbb0-9f11-46a2-8eaf-085be1313f64" facs="#m-5b370798-ff86-4068-a3d1-8c8758ef112b" label="lyrics-like">visibilium. Et in únum Dóminum</l><l xml:id="m-edc9fec5-d04d-4d9c-aec9-fa212f791f1c" facs="#m-cddfae9b-9079-42be-a7ab-602b6714f31d" label="lyrics-like">Lória in excélsis Déo. Et in térra</l><l xml:id="m-edc616d1-f7b6-4641-9cea-4ea2bc34455a" facs="#m-bc7be3d0-b95b-405a-b7cb-c7b7a6c6df80" label="lyrics-like">Jésum Christum, Filium Déi unigé¬</l><l xml:id="m-2dd1c78a-827a-4134-b8b6-0734d4933b37" facs="#m-b7232ff9-90bb-4895-9421-3d7624108887" label="lyrics-like">(Y pax hominibus bónae voluntá¬</l><l xml:id="m-49104747-0e22-4a0a-a8e4-55c49dfd0d8f" facs="#m-8dd6dedb-98b0-4e95-8449-745e7f4e3497" label="lyrics-like">nitum. Et ex Pâtre nátum ante</l><l xml:id="m-58181400-5b4a-4d85-8d80-a66f9e580171" facs="#m-08a7e75b-d909-4c82-a73b-0617da1891c0" label="lyrics-like">tis. Laudámus te. Benedicimus te.</l><l xml:id="m-e9df36cc-2e5d-4a21-aad6-d6efd9de2248" facs="#m-58b44841-3d12-4ce1-b036-f4de853991f3" label="lyrics-like">ómnia saécula. Déum de Déo, lúmen</l><l xml:id="m-25cbf851-80de-4606-a5aa-3ae1971ff2c9" facs="#m-27445cb9-76a2-433a-bf54-87ae982fe4c6" label="lyrics-like">Adorámus te. Glorificámus te. Grá¬</l><l xml:id="m-acd1a642-dfa0-4358-be48-a41380b83073" facs="#m-4d154b39-a950-453c-9462-94f4d3848851" label="lyrics-like">de lúmine, Déum vérum de Déo</l><l xml:id="m-68833214-d848-4acf-9f7e-229d90c57095" facs="#m-add094ab-6911-4169-886c-5c7d3e14cb0d" label="lyrics-like">tias ágimus tíbi propter mágnam</l><l xml:id="m-c96c874e-0c37-4b93-be81-2e4375501ecc" facs="#m-11636131-a136-4868-bccb-58d4522e699f" label="lyrics-like">véro. Génitum, non fáctum, con¬</l><l xml:id="m-9b989494-e66a-4c2d-8af8-848fc312b02f" facs="#m-e4567b02-c61e-499c-91cb-cfd46b94d511" label="lyrics-like">glóriam túam. Dómine Déus, Rex</l><l xml:id="m-3482e3d3-6c45-482a-bc1e-e08e8581f393" facs="#m-32fbd3f3-e96f-4ee3-a3ca-8ef9ad36e333" label="lyrics-like">substantiálem Pátri : per quem óm¬</l><l xml:id="m-e8584a62-88c9-40f1-90fa-922706c312a2" facs="#m-221d0a8b-9dd9-412e-94ba-fb96301ed6e5" label="lyrics-like">caeléstis, Déus Páter omnipotens.</l><l xml:id="m-b8c35a8c-9027-4901-9e46-690b731913af" facs="#m-580ea624-3999-493f-b5f9-3e58fc841f76" label="lyrics-like">nia fácta sunt. Qui propter nos hó¬</l><l xml:id="m-45a76468-0c02-4fdf-a0bb-473026608e1a" facs="#m-e93d3d7d-b9df-487d-b665-8438795dfc81" label="lyrics-like">Dómine Fili unigénite Jésu Christe.</l><l xml:id="m-af3084dc-324d-4eee-bd67-a963a356305b" facs="#m-c2c83541-6f1e-4f1f-80d2-10473596ba0b" label="lyrics-like">mines, et propter nóstram salútem</l><l xml:id="m-faccb1fc-9f17-4272-90ba-a44980987b10" facs="#m-46439086-03c5-4fc1-94bb-83cfa9e70760" label="lyrics-like">Dómine Déus, Agnus Déi, Filius</l><l xml:id="m-b56d9299-1d99-4ea8-8344-470da4c90f13" facs="#m-3b3208aa-42b4-4e01-a31b-40d45fc08d81" label="lyrics-like">descéndit de caélis. Et incarnátus</l><l xml:id="m-23f89500-f860-4684-98f8-81ee3810b681" facs="#m-99ff50eb-08b0-425d-a2f6-904c4bc49a5e" label="lyrics-like">Pátris. Qui tóllis peccáta múndi,</l><l xml:id="m-118632f7-c8cc-4df6-b2b8-169cf2024038" facs="#m-f1faa1a4-13af-43ad-9dcc-af1d345ccd34" label="lyrics-like">est de Spíritu Sáncto ex Maria Vir¬</l><l xml:id="m-dd22fcc4-8134-4343-baee-4cd4fdad8a25" facs="#m-155f3914-2b4b-4e3e-8e64-ca676dd574e5" label="lyrics-like">miserére nóbis. Qui tóllis peccáta</l><l xml:id="m-b92836ab-fbed-4c1d-813a-a2896fed037a" facs="#m-73a30032-ee17-4096-b9c1-416e916d5102" label="ambiguous">gine: Er HOMO FACTUS EST. Cru¬</l><l xml:id="m-54c0acfa-b9e2-4a98-9290-5f63a14e0eeb" facs="#m-eec7f11b-495d-49c5-8340-12d29260070c" label="lyrics-like">múndi, súscipe deprecatiónem nó¬</l><l xml:id="m-c00fc972-036d-4d7f-9565-96d44e3280f3" facs="#m-2edef761-333f-4c03-b831-eb0181c2f151" label="lyrics-like">cifixus étiam pro nóbis sub Póntio</l><l xml:id="m-f8e55bd3-ef48-4811-aef3-b58912a6c0b4" facs="#m-7442f5a2-e1db-4ea3-85fa-103c2105d93f" label="lyrics-like">stram. Qui sédes ad déxteram Pá¬</l><l xml:id="m-f257a9c7-6413-4232-987f-c5bc20ebd75f" facs="#m-82ecbbaf-86bf-442f-a89a-0dd2d0c073e1" label="lyrics-like">Piláto : pássus, et sepúltus est. Et</l><l xml:id="m-dec95f6a-f23f-47e0-aa58-b71b902217cd" facs="#m-517cdfa6-df56-4fc6-9648-63f1bf1f8681" label="lyrics-like">tris, miserére nóbis. Quóniam tu</l><l xml:id="m-17224189-7cac-436c-ba91-63315462385b" facs="#m-87500e53-0e6e-4608-8156-0760354394a2" label="lyrics-like">resurréxit tértia die, secúndum</l><l xml:id="m-50031569-49d9-42a5-8537-bb31a7e1395c" facs="#m-07775723-d938-41e2-81d0-09b9c09511c3" label="lyrics-like">sólus sánctus. Tu sólus Dóminus.</l><l xml:id="m-90c88719-f0de-4dab-908c-b3c2007bbc60" facs="#m-cd1262b5-bb4f-4d76-9f69-f8b00fe26d0d" label="lyrics-like">Scriptúras. Et ascéndit in caélum:</l><l xml:id="m-96cfdd9b-eb39-4411-9a0a-632670cca937" facs="#m-3549c781-15d7-49af-a0e5-3c65105a09d9" label="lyrics-like">Tu sólus altissimus, Jésu Christe.</l><l xml:id="m-d4a51944-f6e9-47fc-b5e6-b3d17d429993" facs="#m-fd9fa6ce-56dc-4e4b-8b00-afeb94dc185f" label="lyrics-like">sédet ad déxteram Pátris. Et íterum</l><l xml:id="m-854e494f-4710-4604-b3b9-6d0c1f9a2423" facs="#m-61fcc50c-30f8-47ac-8c7c-03ee83018925" label="lyrics-like">Cum Sáncto Spiritu, in glória Déi</l><l xml:id="m-a680c65f-e9ee-4e1c-9922-0e7cc821df5b" facs="#m-6fd719b0-cbbf-4c09-82bb-8f083e5f1407" label="lyrics-like">ventúrus est cum glória judicâre</l><l xml:id="m-38fc43f1-8c28-4201-8f25-8deb5398cd7e" facs="#m-6d85c96b-8549-410e-84db-cf5e8c91cb0e" label="lyrics-like">Pátris. Amen.</l><l xml:id="m-36183618-0c32-447a-b0ff-06715fa86632" facs="#m-7e147940-9d86-4938-89eb-4b4f2a37b55d" label="lyrics-like">vívos et mórtuos: cújus régni non</l><l xml:id="m-618d82f7-770d-4cc4-bf58-75e757c7320d" facs="#m-74157f35-be67-4d13-a6fc-87f1ea567c8c" label="lyrics-like">V. Dóminus vobíscum. K. Et cum</l><l xml:id="m-91b4cc0d-2733-4eb0-903d-51e88168d885" facs="#m-dff4660e-0943-4cc8-b879-34903bc787f5" label="lyrics-like">érit finis. Et in Spiritum Sanctum</l><l xml:id="m-e028fe5a-ffa3-45b5-9a22-b6360f664dcb" facs="#m-3b6fdf62-9443-4349-9261-ff9643c8cae7" label="lyrics-like">spíritu túo.</l><l xml:id="m-73b9e331-eb13-4690-8cdd-aeb3a958d9f0" facs="#m-543adb79-2e8a-4cde-bbee-fff84b09c77c" label="lyrics-like">Dóminum, et vivificantem : qui ex</l><l xml:id="m-cb9fdf7b-04ea-42d5-bc97-1ca99e6f9a5e" facs="#m-661bc0ee-90ee-4fe4-b78a-182475e37cc8" label="lyrics-like">Pâtre, Filióque procédit. Qui cum</l><l xml:id="m-dbc4a635-c419-44fa-a3a9-ff9d8eeb163a" facs="#m-258c6eec-87f0-4073-b808-85d419a73ce7" label="text-like">The Collect or Collects are next</l><l xml:id="m-c09adbdc-eff8-4d86-81f9-5d41730a20e0" facs="#m-e7e4d4c8-3ce4-4d4b-929f-809d2428e6c3" label="lyrics-like">Pâtre, et Filio simul adorãtur, et</l><l xml:id="m-41a767ff-29ad-40c2-9bdd-20a14dc845ee" facs="#m-ab22cf6c-b2b8-467a-aa33-1fe291d4d15e" label="text-like">then the Epistie, Gradual,</l><l xml:id="m-420cdc31-d0ae-4868-8d96-b4f59e7a95b4" facs="#m-a4830800-e335-4222-88f8-4d1769d44e35" label="lyrics-like">conglorificátur : qui locútus est per</l><l xml:id="m-f4092e3a-d674-4636-96f8-fa9198c30e09" facs="#m-4c6b815e-9217-4788-b82e-261d23bf9d34" label="text-like">Tract or Alleluia, and the Sequence</l><l xml:id="m-5d040de8-4a4f-496f-9df2-81ec9d2c884d" facs="#m-91c57c20-d25e-4764-ba52-e95a1d00b00c" label="lyrics-like">Prophétas. Et únam, sánctam, ca¬</l><l xml:id="m-547607d5-1f63-44c7-a455-774c0021d186" facs="#m-a762f620-7ba3-493c-838c-aef2e8ad4aa0" label="ambiguous">if there be one.</l><l xml:id="m-ae426d9c-2479-41eb-ae87-d4f9fabc5294" facs="#m-580fcaf5-2d9e-4b2c-bda0-c5f64cfbf0eb" label="lyrics-like">thólicam et apostólicam Ecclésiam.</l><l xml:id="m-03360f95-6353-42c7-9c95-eec9047dadff" facs="#m-c543a6d8-dcae-427e-8b25-d959c0052522" label="text-like">The Priest then says:</l><l xml:id="m-e436a0c0-5f19-4b94-97e3-7358bdbdcccd" facs="#m-b2e2add7-4af3-4c90-b935-f4db096cc39b" label="lyrics-like">Confiteor únum baptisma in remis¬</l><l xml:id="m-bb403ca6-1536-40e4-8723-c35f6f5daf29" facs="#m-fe99716f-8903-404d-ad44-bb0c6f7c3d00" label="lyrics-like">siónem peccatórum. Et exspécto</l><l xml:id="m-cf8d6018-3bd9-4185-a5ef-1ba4b1f9617e" facs="#m-dbf39330-c434-4d49-9a93-be972fb50067" label="lyrics-like">Unda cor meum, ac lábia mea</l><l xml:id="m-762118e7-9a96-43ca-bae4-a4f7d414f241" facs="#m-e3cbfea6-cb00-40e2-b814-7a0b5fc129a6" label="ambiguous">1L omnipotens Deus, qui labia</l><l xml:id="m-ecbddb7e-d7e3-4052-90b3-12550017f07d" facs="#m-a9b39e1a-f870-4fd5-9e3f-2c8bd08b9219" label="lyrics-like">resurrectiónem mortuórum. Et vi¬</l><l xml:id="m-962ca402-f6e7-47be-81c8-42256da8b02c" facs="#m-aa854075-d092-40a3-a188-6879100d3eef" label="lyrics-like">tam ventúri saéculi. Amen.</l><l xml:id="m-043caf50-5a17-4981-9436-302610986b39" facs="#m-fffbb11e-00b5-40c2-837f-d5c6665d9fd6" label="lyrics-like">Isaiae Prophétae cálculo mundásti</l><l xml:id="m-a5d1aac2-9895-4a50-94c1-c267ddffd36d" facs="#m-f2f6961d-ac93-4e85-b1ba-a96a65e9a6b6" label="lyrics-like">V. Dóminus vobiscum. R. Etcum</l><l xml:id="m-ea9470d7-5282-4800-a0ff-f9eec8e884df" facs="#m-cbdd44b7-cd3a-4189-8638-2afde94fdbba" label="lyrics-like">igníto : ita me tua grata misera¬</l><l xml:id="m-509aa90d-5281-4dcc-824f-d7f50cc2873d" facs="#m-ca524890-a992-415f-993f-f1eb0a10ce9d" label="lyrics-like">uóne dignáre mundáre, ut sanctum ! spiritu túo.</l></lg></div></section></score></mdiv></body></music>
</mei>