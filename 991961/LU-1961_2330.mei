m-7381726f-3c9a-4d17-8a50-7fac8e01616c" facs="#m-cbd7980f-9794-4e0d-a09b-160255bc7aa7" label="lyrics-like">A ctiónis fidem, qui in Sanctó¬</l><l xml:id="m-89fe85ac-8822-4b57-86fd-c48a815e25dd" facs="#m-60645cd4-afd2-4003-9410-7d23556ebda0" label="lyrics-like">córum cinéribus pignora vene¬</l><l xml:id="m-73394d3e-7193-4ed0-a9c6-2b3a00705971" facs="#m-3025b4c4-0395-47ce-af83-b66059bd5e45" label="lyrics-like">rámur. Per Dóminum nostrum</l><l xml:id="m-f34d69c6-ac9c-49f9-8dd6-81d4dc18667a" facs="#m-27ee203a-4368-40fe-8f85-431dc77059c5" label="lyrics-like">rum tuórum Reliquiis mirabilia</l><l xml:id="m-aa64ea36-1deb-4aa6-9ff7-1122dc6771e5" facs="#m-e2635141-bdce-4e93-97f4-e2ab8faec4bc" label="lyrics-like">operáris: t et fac nos immortális !Jesum Christum.</l><l xml:id="m-778cac0d-a1cf-43a7-900d-4dfcc5870a39" facs="#m-45af5f34-e63a-497f-89d4-4686ae683549" label="lyrics-like">Epistle. Hi viri misericórdiae. p. 1507.</l><l xml:id="m-c090e258-b137-4617-a1bd-93e2556077cc" facs="#m-fb084033-41e6-47d1-b456-7c2b2d2a88c2" label="ambiguous">Grad.</l><l xml:id="m-a20f6b09-b5d4-497e-a606-e81523851746" facs="#m-4d3b2c35-970f-4e3d-b672-e9512a29e1ed" label="ambiguous">2.</l><l xml:id="m-cbe75c15-4f3b-427a-bf23-ea6b422a4604" facs="#m-2dec3185-2cea-413e-874d-adcefba40a62" label="lyrics-like">Xsultá-bunt" sán¬</l><l xml:id="m-6135dfeb-8b85-4656-a39d-3be8aca1beab" facs="#m-bd777a3a-11c8-4e8e-a24a-4ec302577915" label="lyrics-like">gló¬</l><l xml:id="m-c23010c3-8061-48b6-a153-b34d9cd9ea0e" facs="#m-fe5d4ce2-18e1-4a19-aba8-b72dc0fc3c4e" label="ambiguous">cti in</l><l xml:id="m-e5c4f700-08db-4adf-81d6-3185d8284266" facs="#m-e4e348ee-b0dd-424a-969e-148540566713" label="lyrics-like">lae-tabún¬</l><l xml:id="m-1d2eef7d-95c8-46e4-a1b4-9c0bcf97588e" facs="#m-a2fa18a2-c8c5-4510-a881-62d15ef7db0f" label="ambiguous">in cu¬</l><l xml:id="m-a21d367c-b826-43b2-b89a-db5c1a831b90" facs="#m-92e73591-478f-4ca4-a30a-4704ced74c56" label="ambiguous">tur</l><l xml:id="m-d1831a44-25f9-41a2-b635-22a1cb725f1a" facs="#m-6df9df3c-0eb3-4ad8-893d-ba98cfee0a4b" label="ambiguous">ri-a:</l><l xml:id="m-bccb179d-a3f0-45e0-927d-b807fcd4c4f1" facs="#m-46c6f7c8-0171-4dab-874f-f4622ed9f7a5" label="lyrics-like">V. Cántá¬</l><l xml:id="m-34171b5d-295b-4c70-95ff-946851328a55" facs="#m-69422744-00c3-4e35-934d-8c73f9eb4784" label="lyrics-like">bi- libus sú¬ is.</l><l xml:id="m-e7bb9dbd-ab62-41f0-9d90-82be54e6a80e" facs="#m-a11bfef8-0f6a-4dc1-92ba-91dee2e1068b" label="lyrics-like">te Dó¬</l><l xml:id="m-ef734bff-84d1-4eeb-8e91-bfe9d2742fc7" facs="#m-960878a5-1464-4d37-b817-a297adab37c8" label="ambiguous">mi-no</l><l xml:id="m-53f9bebf-aefd-41c8-84e2-db4aa61a71fe" facs="#m-d6061886-d35e-469d-a4d0-788efdfa0698" label="lyrics-like">ti-cum nó¬</l><l xml:id="m-fac02afc-a7ec-437f-be9c-6a4d3febae1d" facs="#m-e55acc09-211e-422c-8dde-c20d562182c7" label="lyrics-like">cán¬</l><l xml:id="m-c1754f49-126a-496a-b13c-fbb4da5611db" facs="#m-95675ffc-ca8f-4026-9392-9f852afeb59a" label="ambiguous">vum: laus</l></lg></div></section></score></mdiv></body></music>
