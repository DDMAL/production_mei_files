763" lry="771" /><zone xml:id="m-e2e49e9e-3ff6-4dc4-9ba2-bef835606491" ulx="415" uly="779" lrx="626" lry="811" /><zone xml:id="m-80b0a86f-798b-4fbc-9c72-85560f935fb6" ulx="156" uly="808" lrx="913" lry="847" /><zone xml:id="m-276e4f19-39e6-4b6c-8ed9-8ea4c192efe0" ulx="128" uly="839" lrx="914" lry="872" /><zone xml:id="m-b057d2b6-62dd-46a3-96a5-14087af9d68b" ulx="127" uly="869" lrx="916" lry="899" /><zone xml:id="m-60d2008f-612a-45db-a4bb-943dfa2ddf53" ulx="127" uly="891" lrx="652" lry="924" /><zone xml:id="m-a27c51d8-0856-499e-84cf-35ee37e6056b" ulx="455" uly="994" lrx="592" lry="1026" /><zone xml:id="m-effcf88b-c805-4e80-9522-fb24f79e8027" ulx="267" uly="1037" lrx="777" lry="1082" /><zone xml:id="m-b6ec799a-c1d1-4d6f-86b6-af1f142e4b67" ulx="469" uly="1087" lrx="584" lry="1122" /><zone xml:id="m-ee688833-e498-49b5-a42e-a32dc642069c" ulx="424" uly="1130" lrx="626" lry="1165" /><zone xml:id="m-b4b3e121-521f-4201-95a0-7a2596bb0426" ulx="153" uly="1184" lrx="838" lry="1228" /><zone xml:id="m-25b76743-f276-44e0-8195-2b0a7e3ca747" ulx="481" uly="1234" lrx="577" lry="1268" /><zone xml:id="m-e9b5cacd-b188-470c-816d-e88d5b2c7175" ulx="169" uly="1273" lrx="921" lry="1309" /><zone xml:id="m-c7795cf2-21e3-44ef-9abf-2e28dd7a1687" ulx="132" uly="1298" lrx="920" lry="1335" /><zone xml:id="m-e225c955-4cb7-43e4-a7ae-86e8aadd41f9" ulx="132" uly="1326" lrx="522" lry="1360" /><zone xml:id="m-55f34174-7d8f-4bd6-9fcb-a1024144859e" ulx="527" uly="1327" lrx="917" lry="1356" /><zone xml:id="m-db3a9fa4-d0d5-482d-8e3d-d00288fa46a2" ulx="530" uly="1352" lrx="919" lry="1391" /><zone xml:id="m-9c27e26f-fb6d-4360-b3b4-ba99a55b84c6" ulx="132" uly="1355" lrx="520" lry="1387" /><zone xml:id="m-02ae914a-f389-457a-b744-159d122629ac" ulx="132" uly="1378" lrx="606" lry="1415" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-314cb7fc-f334-4370-af6c-016128ab65fe" n="2286" facs="#m-672aced8-7716-4c00-beae-c626b4e32553" /><div xml:id="m-6ceec1a7-67a7-4d2d-9220-6ce6cd2d0a3a">
            <lg xml:id="m-9a1c8ea1-9ff6-4746-8a77-65bb07305c24">
              <l xml:id="m-ed9afff3-bdf3-4be2-99e6-dd027c862280" facs="#m-62b202cb-3356-41d4-a913-72f2208f7d82" label="ambiguous">29</l><l xml:id="m-84336ecc-edb8-40fa-a9da-d0ca78ab594a" facs="#m-ba4bb738-f10e-4d76-becc-a66d60b67a0d" label="text-like">Proper feasts of U. S. A.</l><l xml:id="m-550b8502-c193-497a-b701-f3b1557187ab" facs="#m-ad011b24-8599-4ca6-bd21-8235f3151cdb" label="ambiguous">MARCH 15</l><l xml:id="m-1fe1479b-6c28-4083-841e-37398b826b5e" facs="#m-83d199a8-22d4-4536-a049-5ddfc882c5da" label="ambiguous">St. Louise de Marillac, Widow</l><l xml:id="m-390488a1-5d10-45d1-852f-19387b7bdf5b" facs="#m-139c6b35-97d3-434e-91ae-fbf467ceba99" label="text-like">Co-Foundress of the Congregation</l><l xml:id="m-ea204d2d-f6bf-48a9-82ea-46bc6a362f7f" facs="#m-671f07f8-ccb1-414c-ac09-32289e1ae103" label="text-like">of the Daughters of Charity</l><l xml:id="m-629dd604-2e05-40f3-9393-ef15cf025737" facs="#m-ff792b41-d2d0-4269-9394-67f065603d29" label="text-like">For the Vincentian Fathers and the Daughters of Charity</l><l xml:id="m-b387ee14-2188-42b0-b8b1-714e3b2de222" facs="#m-ee5babba-925a-4327-91dc-33b287a324b2" label="text-like">In the diocese of Salt Lake, HII class</l><l xml:id="m-cbeafde0-6d15-488e-aeee-8cb5d3734234" facs="#m-fcb78b0e-f659-4f0b-99ab-359faf66a69c" label="ambiguous">Collect</l><l xml:id="m-a7e77c70-d152-4a0c-a7f0-092780a7ffcb" facs="#m-d9746119-ec2c-40c2-8d51-e3b2a2b24ef2" label="lyrics-like">Eus, caritátis auctor et praé-] voluisti : f da, quaésumus; ut,</l><l xml:id="m-520907f8-4589-4100-bf12-72a178f46110" facs="#m-4f896cad-bbed-492f-8db7-434fd53baa5d" label="lyrics-like">U mium, qui novam in Ecclésia! caritátis ópera exercéntes, * pro¬</l><l xml:id="m-bdd1385b-f5ac-405c-9f25-50d48e871763" facs="#m-1c7db5fb-eb64-4961-8eab-786b00c79a9b" label="lyrics-like">míssam in caelis mercédem ásse¬</l><l xml:id="m-0b8bb703-5a11-47f7-b715-21dac2dd520f" facs="#m-932264e7-a4d8-499e-93c2-bb271c5be648" label="lyrics-like">tua familiam suscitásti, ejúsque</l><l xml:id="m-0d4693be-f4b6-42aa-8fec-5b75d2401c29" facs="#m-510dfdee-f560-49e9-bf32-ee4001124476" label="lyrics-like">matrem beátam Ludovicam esse! qui mereámur. Per Dóminum.</l><l xml:id="m-50708e9c-5f56-4290-aee6-c30a27bed01a" facs="#m-3cfe5117-1cd9-4519-870e-f080e707789c" label="ambiguous">Secret</l><l xml:id="m-c9e82053-e536-49cc-bbeb-ba03d3a6f13f" facs="#m-43322d0f-f180-4ec1-a81e-dd9e6cdfdf21" label="lyrics-like">DEspice, Dómine, oblatiónes nos in ómnibus vitae sémitis</l><l xml:id="m-69b5873e-ad6c-4b15-8bf7-15eb1db77c80" facs="#m-3243c6cc-6425-4cbb-8ac0-9b7c96d58ec8" label="lyrics-like">It nostras in honórem beâtae fácias et a periculis tutos et ad</l><l xml:id="m-cbcb3468-914a-4a67-abd7-95ed746c7ffe" facs="#m-145aaf27-e64c-4d30-a423-94a8a87fd641" label="lyrics-like">virtútes júgiter expeditos. Per</l><l xml:id="m-810c412d-786f-4ee3-8af7-76a5188e60df" facs="#m-b1b708fb-0732-4dd8-8de0-c33b5af2cfa6" label="lyrics-like">Ludovícae tibi reverénter exhi¬</l><l xml:id="m-41191c81-f153-4199-b97c-427c38babeb8" facs="#m-b43ac9f7-b6f6-4e5d-b865-751a74e01d07" label="lyrics-like">bitas; et per ejus intercessiónem! Dóminum nostrum.</l><l xml:id="m-89d548c8-db53-40eb-8ab9-14ba4573df41" facs="#m-e2e49e9e-3ff6-4dc4-9ba2-bef835606491" label="ambiguous">Postcommunion</l><l xml:id="m-bbd7d0ca-9dd1-4d07-8406-d3fd22542257" facs="#m-80b0a86f-798b-4fbc-9c72-85560f935fb6" label="lyrics-like">AEvótio nostra, Dómine, inter-quam intus fovémus in corde,</l><l xml:id="m-d055a055-6dac-4c67-9ac8-4bfd344ac0ee" facs="#m-276e4f19-39e6-4b6c-8ed9-8ea4c192efe0" label="lyrics-like">U cedénte beáta Ludovica, con-létiam foris exhibeámus in ópere.</l><l xml:id="m-5b54c81c-2e93-4980-923a-5bafd5f8d1c1" facs="#m-b057d2b6-62dd-46a3-96a5-14087af9d68b" label="lyrics-like">tinuum e refectióne caelésti sumat ] Per Dóminum nostrum Jesum</l><l xml:id="m-f9cdcc43-9fd8-4e45-aa90-3aeb6ead7c86" facs="#m-60d2008f-612a-45db-a4bb-943dfa2ddf53" label="ambiguous">auxilium; ut divinam fidem, Christum.</l><l xml:id="m-8e826f8a-618c-4fd3-aef7-e465620e1b96" facs="#m-a27c51d8-0856-499e-84cf-35ee37e6056b" label="ambiguous">MARCH 22</l><l xml:id="m-84ce7de7-a812-4dc4-9ec1-6b0b778eb30c" facs="#m-effcf88b-c805-4e80-9522-fb24f79e8027" label="text-like">St. Catharine of Genoa, Widow</l><l xml:id="m-4917a872-23e1-4f7c-aec4-1e7283ac99a4" facs="#m-b6ec799a-c1d1-4d6f-86b6-af1f142e4b67" label="ambiguous">I class</l><l xml:id="m-1fd5cb0a-b96d-4d17-8f35-0fc4ab103acf" facs="#m-ee688833-e498-49b5-a42e-a32dc642069c" label="ambiguous">In some dioceses</l><l xml:id="m-182d26dc-861c-44fa-ae18-69a0e07518da" facs="#m-b4b3e121-521f-4201-95a0-7a2596bb0426" label="lyrics-like">Mass. Cognóvi. p. 1239, with the proper Collect as below.</l><l xml:id="m-ee5784c9-9434-4c20-8b27-91d5b14fcab8" facs="#m-25b76743-f276-44e0-8195-2b0a7e3ca747" label="ambiguous">Collect</l><l xml:id="m-d8fbdb74-bf9f-4feb-b54c-be2cf73559c5" facs="#m-e9b5cacd-b188-470c-816d-e88d5b2c7175" label="lyrics-like">Eus, qui beátam Catharinam, flammam caritátis accéndas, * et</l><l xml:id="m-6da27dc8-f30a-4f85-be58-a8e55a1bb9f5" facs="#m-c7795cf2-21e3-44ef-9abf-2e28dd7a1687" label="lyrics-like">Uin contemplánda Fili tuí ejúsdem passiónis participes di¬</l><l xml:id="m-13f7b16c-1e47-47f3-8512-3ae31d792651" facs="#m-e225c955-4cb7-43e4-a7ae-86e8aadd41f9" label="lyrics-like">passióne, divini amóris igne</l><l xml:id="m-117b8404-b3bd-4ab8-8c59-f0896bf50d9b" facs="#m-55f34174-7d8f-4bd6-9fcb-a1024144859e" label="lyrics-like">gnánter effícias. Per eúmdem</l><l xml:id="m-12a0704d-2148-488c-8472-b621bec2f759" facs="#m-db3a9fa4-d0d5-482d-8e3d-d00288fa46a2" label="lyrics-like">bóminum nostrum Jesum Chri¬</l><l xml:id="m-5f01aa76-f21e-4318-8b94-ff37e1f70946" facs="#m-9c27e26f-fb6d-4360-b3b4-ba99a55b84c6" label="lyrics-like">flagráre fecisti : t quaésumus; ut,</l><l xml:id="m-d0df4af4-6166-4e94-bc5d-d6882b696cb6" facs="#m-02ae914a-f389-457a-b744-159d122629ac" label="lyrics-like">ipsa intercedénte, tuae in nobis stum.</l></lg></div></section></score></mdiv></body></music>
</mei>