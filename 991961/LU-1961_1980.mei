 xml:id="m-c7dfab2a-9a7b-4b73-933f-2cf532408e01" ulx="570" uly="1093" lrx="1012" lry="1132" /><zone xml:id="m-01bd52b1-9dc4-4c24-a93c-20e3bd87e30b" ulx="117" uly="1120" lrx="557" lry="1157" /><zone xml:id="m-a69b8d64-0457-4c5e-9f4f-b24770bca877" ulx="570" uly="1123" lrx="1012" lry="1156" /><zone xml:id="m-5fa22dd9-8023-4e36-a926-5f2327b3ba43" ulx="117" uly="1149" lrx="557" lry="1186" /><zone xml:id="m-4de20c9b-d7eb-4bd4-b1d7-24be04b0b22c" ulx="570" uly="1152" lrx="1011" lry="1183" /><zone xml:id="m-c07a00de-567f-4ef3-8c04-7b9ca1dc6822" ulx="119" uly="1181" lrx="558" lry="1211" /><zone xml:id="m-285a3cb0-aa0d-489d-a9ca-c6d6c83edd0c" ulx="572" uly="1181" lrx="1011" lry="1212" /><zone xml:id="m-3bf2e6fb-372b-4b1d-b670-290dea15ce1f" ulx="121" uly="1204" lrx="557" lry="1240" /><zone xml:id="m-2439d91e-2c4d-45eb-bb79-99b5399febbf" ulx="572" uly="1204" lrx="1012" lry="1246" /><zone xml:id="m-d43d5041-65da-4cb7-90c2-cd4519b684d1" ulx="119" uly="1233" lrx="670" lry="1268" /><zone xml:id="m-c97e893c-1611-4304-bbc4-8b8af36c4c11" ulx="146" uly="1275" lrx="445" lry="1316" /><zone xml:id="m-a08b2c55-2f65-4bfd-9068-56443b56ff58" ulx="222" uly="1323" lrx="413" lry="1364" /><zone xml:id="m-2a248c63-c8a4-4d92-851c-d79aeabcf1fb" ulx="730" uly="1330" lrx="910" lry="1363" /><zone xml:id="m-1e73504b-68e7-44fd-93b0-bef33929e787" ulx="134" uly="1359" lrx="1016" lry="1395" /><zone xml:id="m-251d4d41-fb4f-42c5-b989-e6c67248948b" ulx="122" uly="1388" lrx="563" lry="1429" /><zone xml:id="m-2fdf6c4f-bde4-443a-9b7d-7070c0fff20d" ulx="570" uly="1393" lrx="1015" lry="1425" /><zone xml:id="m-0ddd3bc4-f631-4c98-b56f-6ec9f3800691" ulx="572" uly="1419" lrx="1015" lry="1451" /><zone xml:id="m-7224e3de-85c0-49e6-9ab8-4e8030e2737a" ulx="123" uly="1421" lrx="563" lry="1453" /><zone xml:id="m-b5e815af-1843-40ad-9a5c-2d93f77ee130" ulx="122" uly="1445" lrx="563" lry="1481" /><zone xml:id="m-b8ff576d-8d91-47de-8748-f3692660c2d0" ulx="572" uly="1445" lrx="1015" lry="1484" /><zone xml:id="m-6f6fd7c1-c6cc-49ab-9997-459daa8d6577" ulx="122" uly="1473" lrx="565" lry="1508" /><zone xml:id="m-c6f575e6-caae-4b94-a7e3-a58f0b033faf" ulx="571" uly="1475" lrx="1016" lry="1507" /><zone xml:id="m-3dc94de9-30e2-40bc-9428-8be6b72a08eb" ulx="122" uly="1500" lrx="561" lry="1537" /><zone xml:id="m-3b76d407-9527-4de6-a967-89d1f6da1a42" ulx="573" uly="1500" lrx="1016" lry="1535" /><zone xml:id="m-f146ac46-a3d0-4b0e-9973-79e8b1095615" ulx="573" uly="1528" lrx="1017" lry="1561" /><zone xml:id="m-52831b4a-119a-4b57-87b0-ceeebf0bf6dc" ulx="122" uly="1533" lrx="562" lry="1563" /><zone xml:id="m-e8175a08-2047-4c34-970b-c4c33717ea67" ulx="122" uly="1559" lrx="1014" lry="1594" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-9775529c-ff4c-4b0d-b3d7-9e044474ac14" n="1980" facs="#m-69f5650c-8868-4183-bfb2-50c78557b3e5" /><div xml:id="m-a47ac78b-7b0f-41c1-8b26-1750a5684697">
            <lg xml:id="m-067b12b7-3c4a-4336-9c58-cc19aa2e440e">
              <l xml:id="m-b1a5a396-17d1-4ecf-a3c6-2354c7a6b130" facs="#m-c283fe2d-30da-4993-b823-774ca6268542" label="ambiguous">1734</l><l xml:id="m-04dc66c3-4ad2-4225-b8cf-03717d3e55b9" facs="#m-0ae77807-1c3d-4657-88f5-2efffaf2bd5b" label="ambiguous">November 2.</l><l xml:id="m-9c3c9145-47af-4582-b6d3-bb4ef030dbdb" facs="#m-e7034d6f-3c79-4a0e-8e29-97f371c8ff91" label="ambiguous">Lesson VI.</l><l xml:id="m-3327b303-9a42-4ad1-901e-fbb994644650" facs="#m-af6b485a-7069-43e0-8945-b075cb595f28" label="ambiguous">Cap. 18.</l><l xml:id="m-fe92b5fe-cc99-4296-b876-a0c4422a5392" facs="#m-06f68803-e3f6-4075-ab83-cd9626deff5b" label="lyrics-like">Uae cum ita sint, non existi-( suis, quo pro illo fiat simíliter a suis.</l><l xml:id="m-618893b1-5c12-4c0a-aec4-c49e986a4c26" facs="#m-0e032344-1985-468e-ae96-836e335124b8" label="lyrics-like">U mémus ad mórtuos, pro quibus</l><l xml:id="m-c73cbb12-e6c4-4d7c-82a0-659ff30f6036" facs="#m-581c7e8e-8799-46bb-8ee4-b2383a63fc18" label="lyrics-like">Córpori autem humándo quidquid</l><l xml:id="m-519437bd-6531-45b6-9687-e9bbb9e5e291" facs="#m-69cf441f-8cbf-4cab-a1da-ef752ec4001a" label="lyrics-like">impénditur, non est praesidium sa¬</l><l xml:id="m-882d0132-6c08-4175-8071-08657ef381bf" facs="#m-13dd4653-fe84-4665-b3df-fbab523598f9" label="lyrics-like">curam gérimus, pervenire, nisi quod</l><l xml:id="m-aa6bc009-4862-4cf6-a419-0659d1840c39" facs="#m-fb99dd8d-a092-4957-811a-022be7564402" label="lyrics-like">lútis, sed humanitatis officium,</l><l xml:id="m-c250c11b-bed4-46a3-8cf8-9edce08a1068" facs="#m-26b511d9-d015-4ae0-bea4-7e52e8f98e1a" label="lyrics-like">pro eis sive altáris, sive oratiónum,</l><l xml:id="m-5a352a86-4c07-4012-b3a2-8a567a897034" facs="#m-043a04dd-961a-431d-b7c4-59fa06302634" label="lyrics-like">sive eleemosynárum sacrificiis so¬</l><l xml:id="m-332fe494-2866-48d8-885d-a65e08564e01" facs="#m-85cc97d6-4ad6-47f9-a3fc-21248c1ccd21" label="lyrics-like">secúndum afféctum, quo nemo</l><l xml:id="m-50793f26-5ffc-4444-9509-830d4a7cb694" facs="#m-c8c75957-bdcb-41e6-ba7e-cc883f65ca69" label="lyrics-like">lémniter supplicámus: quamvis non</l><l xml:id="m-9ae85a05-6f82-4178-aeb5-5a7698030748" facs="#m-a30417e3-b13a-4a71-a3e4-1f95aadf8278" label="lyrics-like">umquam carnem suam ódio habet.</l><l xml:id="m-341a429f-6541-4b33-b412-b6717020375a" facs="#m-7b0d35e5-53f7-4455-bff2-a9a605daad42" label="lyrics-like">pro quibus fiunt, ómnibus prosint;</l><l xml:id="m-c421e1fe-6175-49bd-81e2-d4df8ccc9d18" facs="#m-f8241e31-51f9-4127-8a73-d094918626ef" label="lyrics-like">Unde opórtet ut quam potest pro</l><l xml:id="m-92dfe13b-b29d-4db2-833f-361f317653c5" facs="#m-6e4ba0b7-cf82-443a-a14d-a4190e56c24d" label="ambiguous">sed iis tantum pro quibus, dum</l><l xml:id="m-239182f9-c240-4f82-a54a-f32f7aaec22c" facs="#m-398c356a-47a1-4361-b7db-0d22c17a79ca" label="lyrics-like">carne próximi curam gerat, cum</l><l xml:id="m-8e405257-e1ab-4cfa-9c18-8eb6ee4cecc1" facs="#m-d51f962d-c0d0-4df8-b029-1ecdf6acfaf2" label="lyrics-like">ille inde recésserit, qui gerébat. Et</l><l xml:id="m-13cc4e96-d725-4e54-aae9-4ad39a2ffdb9" facs="#m-d7706f44-8355-4078-82f8-74120e1c4493" label="lyrics-like">vivunt, comparátur ut prosint. Sed</l><l xml:id="m-f06650c5-e868-40d3-a371-132e634ce6a5" facs="#m-e6d67848-1941-4ab7-8e6e-c5231c6102c1" label="lyrics-like">quia non discérnimus qui sint, opór¬</l><l xml:id="m-b73195d3-e9a6-4979-b987-20c0cc918ab5" facs="#m-c17f3e32-50d2-4f4f-a29c-eb3f6babe3f2" label="lyrics-like">si haec fáciunt qui carnis resurre¬</l><l xml:id="m-80081f8e-07a1-45bd-9e57-64b0d9fe780d" facs="#m-de1cbd9a-6c34-465d-b02d-8e7464b57daa" label="lyrics-like">ctiónem non credunt, quanto ma¬</l><l xml:id="m-9a6e18a6-5550-4213-bce4-7702af001814" facs="#m-7725e016-8f3f-4e66-83bd-aa9bb2913b7e" label="lyrics-like">tet ea pro regenerátis ómnibus fá¬</l><l xml:id="m-f3048fde-c141-4d2c-a865-1b9274d8e22e" facs="#m-c3b9868f-7767-41e4-8929-c2b4bd96c4de" label="lyrics-like">gis debent fácere qui credunt; ut</l><l xml:id="m-56acb312-eacc-4c1d-93ab-c8caeb01ac15" facs="#m-f1fb4ab7-2b23-4c43-8ddb-caa0ef4343b4" label="lyrics-like">cere, ut nullus eórum praetermittá¬</l><l xml:id="m-869d2897-c2fc-4437-9a60-46849da2658c" facs="#m-0e21473d-4b62-46c3-9b7e-1635871ff90c" label="ambiguous">tur, ad quos haec beneficia possint</l><l xml:id="m-d7cb587e-b77c-45db-ac2a-246452e995cd" facs="#m-77fce951-f681-41b0-b67c-bb5fb3811752" label="lyrics-like">córpori mórtuo, sed tamen resurre¬</l><l xml:id="m-2f5c9176-8025-414d-8ba0-1dea448d0662" facs="#m-34e0d2d7-6a60-4475-b9c4-091522abced4" label="lyrics-like">ctúro et in aeternitáte mansúro, im¬</l><l xml:id="m-96dff8af-310e-4424-a438-bbb2f2ddce38" facs="#m-586532c5-3758-4c5b-8b37-13a446be9d10" label="lyrics-like">et débeant pervenire. Mélius enim</l><l xml:id="m-c82e5b97-1846-4b8f-823d-22858967fa31" facs="#m-465ebdca-9190-42e7-9f32-d46017c1bd8f" label="lyrics-like">supérerunt ista eis, quibus nec ob¬</l><l xml:id="m-34f12bb3-f72b-474a-a023-df9ee9e3e4a4" facs="#m-de092315-f592-47c8-9b83-36cac556c06c" label="lyrics-like">pénsum ejúsmodi officium sit étiam</l><l xml:id="m-ac15346a-329d-4972-940f-09a0c4da5717" facs="#m-1bd33cf3-40a8-428b-b42d-84bd256de287" label="lyrics-like">quodámmodo ejúsdem fidei testi¬</l><l xml:id="m-495db488-d1f0-487e-a858-fbef62d625dd" facs="#m-16f49763-9f6a-4471-840a-b916096f4f6f" label="lyrics-like">sunt nec prosunt; quam eis déerunt,</l><l xml:id="m-7c8adee6-c365-48e2-b2f3-cacea3f2d81e" facs="#m-5608ce5e-0b20-4942-bca7-99efdeffd014" label="lyrics-like">quibus prosunt. Diligéntius tamen mónium!</l><l xml:id="m-78bf0d45-0de0-4922-a8eb-b95a006bab6c" facs="#m-ebb0da29-122e-43f0-a775-e47a2d510772" label="lyrics-like">facit haec quisque pro necessáriis</l><l xml:id="m-71114811-84e1-4737-92d0-e61464397b46" facs="#m-4917eee2-ed91-48d4-85a1-894a9f457a9a" label="lyrics-like">K. Ne recordéris. p. 1792.</l><l xml:id="m-e05b31aa-4ba3-4725-9e37-3a8734efe5e1" facs="#m-82e48c4e-712a-468c-8ef5-125d332f8029" label="ambiguous">INTHE THIRD NOCTURN.</l><l xml:id="m-5ddb38f1-db82-4a26-9659-bdcba46c209e" facs="#m-7d055e2d-df72-4fab-b224-d91952bd3a10" label="ambiguous">Cap. 15, 12-22.</l><l xml:id="m-02f3e79e-dc28-460f-a08b-5757ff5e42db" facs="#m-392b064d-4418-4cdc-a14d-0af0f470970f" label="ambiguous">Lesson VII.</l><l xml:id="m-eb92645b-600f-4766-8d47-2c39f5520bf1" facs="#m-b288933e-2d05-4334-bcbc-3c9ffc858949" label="lyrics-like">resúrgunt. Nam, si mórtui non re¬</l><l xml:id="m-f688b3c2-7539-495b-89b8-6f4136bff29e" facs="#m-396ddcd6-ffac-4033-8355-120fb6e3ba52" label="lyrics-like">De Epístola prima beáti Pauli Apó¬</l><l xml:id="m-57b955b8-bd5a-4215-b376-29c3fa8a4edf" facs="#m-242767f6-0f10-49e5-9f5e-9a5333a1f88f" label="lyrics-like">súrgunt, neque Christus resurréxit.</l><l xml:id="m-b4dce241-b349-4905-ac7a-50cef5ad7380" facs="#m-872ba497-dee2-47f2-8e12-4c80d0494f1a" label="ambiguous">stoli ad Corinthios.</l><l xml:id="m-1df9e8a2-6274-4b4c-bdb5-f193afe21903" facs="#m-9dd57cf7-32e9-45ea-b3f8-4210acd7d279" label="lyrics-like">Quod si Christus non resurréxit,</l><l xml:id="m-4516a531-125e-4884-8a0b-cb770b8be6ed" facs="#m-7a4721c7-9840-477a-88e2-552667fadfe2" label="lyrics-like">QI Christus praedicátur quod re¬</l><l xml:id="m-d4913c26-e7e9-4012-aa59-5503474851ca" facs="#m-553f3198-03e5-4ece-939d-89c3d7d6d44d" label="lyrics-like">vana est fídes vestra; adhuc enim</l><l xml:id="m-c813fb53-6040-473b-b244-4377302e6e1a" facs="#m-272faa82-898e-420f-8df7-e6254b377e46" label="lyrics-like">O surréxit à mórtuis, quómodo</l><l xml:id="m-329422d6-1c47-442a-bb93-6c9a3a8c1147" facs="#m-28c7bc06-f67f-463e-9b0a-9902e31e7584" label="lyrics-like">estis in peccátis vestris. Ergo et qui</l><l xml:id="m-40964588-fdf9-4370-a741-b7f4b60f4cd7" facs="#m-c3aa6958-64ab-4767-80bd-a7a50690042c" label="lyrics-like">quidam dicunt in vobis quóniam</l><l xml:id="m-36ca6a5d-c3bf-448e-a7da-2068ad9e3ee8" facs="#m-24c4f1ad-11df-478d-9c24-edd386038718" label="lyrics-like">dormiérunt in Christo, periérunt.</l><l xml:id="m-2cf6b3cf-e20b-45f7-9697-debd70fa1247" facs="#m-9293ca27-9eec-4bd0-a7dc-61a8880d310f" label="ambiguous">Si in hac vita tantum in Christo</l><l xml:id="m-5bea6785-d071-48e8-a782-43024679b266" facs="#m-38905304-b4db-4a74-aa15-eca86246b405" label="lyrics-like">resurréctio mortuórum non est? Si</l><l xml:id="m-5de71142-c2c4-45b2-a5dd-3eb6b68f1b47" facs="#m-5c7987cf-7be4-407c-9b53-7750e9cc7e9d" label="lyrics-like">sperántes sumus, miserabilióres su¬</l><l xml:id="m-7fe1c91f-5013-4968-9775-ce5363a29445" facs="#m-82a05578-9055-4cf6-b7fc-ae94e9edcc71" label="lyrics-like">autem resurréctio mortuórum non</l><l xml:id="m-6fb16f76-7cd3-4395-8595-03a1ad24002a" facs="#m-3a963f29-ee55-441b-9783-1ec527b8efd0" label="lyrics-like">mus ómnibus hominibus. Nunc au¬</l><l xml:id="m-21f5c787-93ff-4096-9de3-528f83246b73" facs="#m-cbd54ffc-322c-40c3-9774-a4aa1ac202f7" label="lyrics-like">est, neque Christus resurréxit. Si</l><l xml:id="m-592800c3-8b48-482f-b4f2-cb346c68236e" facs="#m-f0317009-b662-43ad-89af-6d2711df1f7a" label="lyrics-like">autem Christus non resurréxit, iná¬</l><l xml:id="m-3c6a6a7d-cb7e-4bd1-90e6-93f7f25f47e1" facs="#m-0fcbe595-e0b2-47bc-8882-fd911a596623" label="lyrics-like">tem Christus resurréxit a mórtuis,</l><l xml:id="m-ff73fed5-992b-4565-a2d2-d90b867fa0cd" facs="#m-7c799be7-a3ea-4891-b8c8-6bc62248b640" label="lyrics-like">nis est ergo praedicátio nostra,</l><l xml:id="m-ddbfb979-c5cc-4d98-a9cb-cbe4d0c91a0d" facs="#m-c7dfab2a-9a7b-4b73-933f-2cf532408e01" label="lyrics-like">primitiae dormiéntium: quóniam</l><l xml:id="m-c55ea794-a176-4d53-9109-905958ace12f" facs="#m-01bd52b1-9dc4-4c24-a93c-20e3bd87e30b" label="lyrics-like">inánis est et fides vestra. Invenimur</l><l xml:id="m-3e3c3db9-5d9a-41dd-8bb9-9110825d0268" facs="#m-a69b8d64-0457-4c5e-9f4f-b24770bca877" label="lyrics-like">quidem per hóminem mors, et per</l><l xml:id="m-65c9dcaf-827f-4d8a-8eba-cb3b68b620a0" facs="#m-5fa22dd9-8023-4e36-a926-5f2327b3ba43" label="lyrics-like">autem et falsi testes Dei: quó¬</l><l xml:id="m-554c8451-67ce-4ff9-b757-d7723f6e3ce4" facs="#m-4de20c9b-d7eb-4bd4-b1d7-24be04b0b22c" label="lyrics-like">hóminem resurréctio mortuórum.</l><l xml:id="m-a2e05044-b47a-48cd-acc5-3397289de8f2" facs="#m-c07a00de-567f-4ef3-8c04-7b9ca1dc6822" label="lyrics-like">niam testimónium diximus advérsus</l><l xml:id="m-0fa2bbe3-13c7-419c-b7cb-dd6696b1785f" facs="#m-285a3cb0-aa0d-489d-a9ca-c6d6c83edd0c" label="lyrics-like">Et sicut in Adam omnes moriúntur,</l><l xml:id="m-77849ff8-a8b9-4eac-9015-ceda140d0bd0" facs="#m-3bf2e6fb-372b-4b1d-b670-290dea15ce1f" label="lyrics-like">Deum, quod suscitáverit Christum,</l><l xml:id="m-79472907-420a-4246-a5b4-32b122227fc5" facs="#m-2439d91e-2c4d-45eb-bb79-99b5399febbf" label="ambiguous">ita et in Christo omnes vivifica¬</l><l xml:id="m-1670c76c-ee97-46ed-b679-397aa528f62d" facs="#m-d43d5041-65da-4cb7-90c2-cd4519b684d1" label="lyrics-like">quem non suscitávit, si mórtui non l búntur.</l><l xml:id="m-bfd6d160-8e8d-4adf-8730-b13380223523" facs="#m-c97e893c-1611-4304-bbc4-8b8af36c4c11" label="lyrics-like">R. Peccántem. p. 1797.</l><l xml:id="m-7675bd8f-797c-4c9a-a4a0-a3e7bb7e0c58" facs="#m-a08b2c55-2f65-4bfd-9068-56443b56ff58" label="ambiguous">Lesson VIII.</l><l xml:id="m-657bcdb7-fe65-4aa9-bc11-a734750406e1" facs="#m-2a248c63-c8a4-4d92-851c-d79aeabcf1fb" label="ambiguous">Cap. 15, 35-44.</l><l xml:id="m-3c6dfb6a-b166-4013-8d97-f70c462e891b" facs="#m-1e73504b-68e7-44fd-93b0-bef33929e787" label="lyrics-like">NED dicet áliquis : Quómodo re-l dat illi corpus sicut vult: et unicui¬</l><l xml:id="m-9ae4047b-0c8f-4a1a-95ae-e774ee1c367c" facs="#m-251d4d41-fb4f-42c5-b989-e6c67248948b" label="lyrics-like">D súrgunt mórtui? qualive cór¬</l><l xml:id="m-816bcca4-c8e5-491b-a319-4e0d3e8fdb0c" facs="#m-2fdf6c4f-bde4-443a-9b7d-7070c0fff20d" label="lyrics-like">que séminum próprium corpus. Non</l><l xml:id="m-2b6715b6-606e-4f55-a3a6-03d2df920e8f" facs="#m-0ddd3bc4-f631-4c98-b56f-6ec9f3800691" label="lyrics-like">omnis caro, éadem caro: sed ália</l><l xml:id="m-3e25e15c-992b-4068-9b72-6395aa423389" facs="#m-7224e3de-85c0-49e6-9ab8-4e8030e2737a" label="lyrics-like">pore vénient? Insípiens, tu quod</l><l xml:id="m-60ce1bc1-24f5-4dda-b33d-908905b97dd4" facs="#m-b5e815af-1843-40ad-9a5c-2d93f77ee130" label="lyrics-like">séminas non vivificátur, nisi prius</l><l xml:id="m-a6880c2d-ccf1-4189-95d3-e70f3ee8f6ac" facs="#m-b8ff576d-8d91-47de-8748-f3692660c2d0" label="lyrics-like">quidem hóminum, ália vero péco¬</l><l xml:id="m-52a24305-17e1-4699-ac13-9c4ce5c47a57" facs="#m-6f6fd7c1-c6cc-49ab-9997-459daa8d6577" label="lyrics-like">moriátur. Et quod séminas, non</l><l xml:id="m-e3a3dbd6-0a49-4336-a10a-77eb30f09511" facs="#m-c6f575e6-caae-4b94-a7e3-a58f0b033faf" label="lyrics-like">rum, alia vólucrum, ália autem pí¬</l><l xml:id="m-639f4818-72da-408a-a753-f05c9f7ad6d2" facs="#m-3dc94de9-30e2-40bc-9428-8be6b72a08eb" label="lyrics-like">corpus, quod futúrum est, séminas;</l><l xml:id="m-2f43ff56-e38a-486a-ad8c-0b8bf29f3903" facs="#m-3b76d407-9527-4de6-a967-89d1f6da1a42" label="lyrics-like">scium. Et córpora caeléstia, et cór¬</l><l xml:id="m-c0d3516b-6fe6-4872-a651-beb234cc044e" facs="#m-f146ac46-a3d0-4b0e-9973-79e8b1095615" label="lyrics-like">pora terréstria : sed ália quidem</l><l xml:id="m-e7252aa6-e193-4ca8-ae68-bc470669bd0a" facs="#m-52831b4a-119a-4b57-87b0-ceeebf0bf6dc" label="ambiguous">sed nudum granum, ut puta tritici.</l><l xml:id="m-af48ed43-b2f2-4012-8848-e3588de8bf75" facs="#m-e8175a08-2047-4c34-970b-c4c33717ea67" label="lyrics-like">aut alicújus ceterórum. Deus autem l caeléstium glória, ália autem terré¬</l></lg></div></section></score></mdiv></body></music>
</mei>