ly="774" lrx="923" lry="804" /><zone xml:id="m-e30cf642-0ca6-43e0-9029-49df5f1ca890" ulx="107" uly="797" lrx="510" lry="833" /><zone xml:id="m-6c2aa648-39dd-413b-b017-a84d1841dfdf" ulx="522" uly="802" lrx="923" lry="831" /><zone xml:id="m-74f496c9-c2a0-4d6c-951f-fba7e6e4da01" ulx="106" uly="825" lrx="509" lry="859" /><zone xml:id="m-18df99cf-e27c-4c80-b7b0-d7a3bd7e60b7" ulx="521" uly="826" lrx="923" lry="859" /><zone xml:id="m-cd9f6bcd-b5c4-4480-a6ad-d9951f3172c8" ulx="107" uly="853" lrx="508" lry="887" /><zone xml:id="m-684a25f3-44b0-4f1e-9d53-454ac5b8a5f8" ulx="522" uly="856" lrx="923" lry="883" /><zone xml:id="m-e5bab600-16fc-40fb-8cd6-f39504626141" ulx="108" uly="878" lrx="512" lry="912" /><zone xml:id="m-d0c54658-e327-4a26-8551-4fbce9c1a2ce" ulx="519" uly="878" lrx="922" lry="914" /><zone xml:id="m-5ff1d293-3263-4bd0-a17c-ad7fd8309f13" ulx="108" uly="904" lrx="512" lry="938" /><zone xml:id="m-56e906d1-db92-413d-86b2-cdeb4e0e307e" ulx="521" uly="905" lrx="924" lry="940" /><zone xml:id="m-e16f9686-3581-48b1-8bb1-2c07b7225643" ulx="108" uly="931" lrx="509" lry="962" /><zone xml:id="m-283b100e-86e6-48fb-8b87-1198c2e7a9bb" ulx="524" uly="933" lrx="697" lry="964" /><zone xml:id="m-9f56bd96-432a-4bd8-b99e-8912b6dbb907" ulx="108" uly="958" lrx="507" lry="996" /><zone xml:id="m-d8eeb7d8-b897-44f9-8af9-75d831f840ff" ulx="132" uly="1017" lrx="924" lry="1046" /><zone xml:id="m-f92d0e57-3076-428f-b3f5-8a58a8007172" ulx="110" uly="1043" lrx="925" lry="1069" /><zone xml:id="m-cb5cde3f-189e-4133-b705-39a998c7eb13" ulx="109" uly="1065" lrx="925" lry="1098" /><zone xml:id="m-0cc5f8f0-0980-4455-b469-dc387dd3739f" ulx="110" uly="1092" lrx="654" lry="1121" /><zone xml:id="m-4c8593d6-56c4-4240-8d07-99bf9cbe45a2" ulx="130" uly="1121" lrx="926" lry="1151" /><zone xml:id="m-4c11fbbd-637e-4d46-a772-bf987fbd314a" ulx="109" uly="1145" lrx="926" lry="1176" /><zone xml:id="m-dcdb94c7-d34e-4d83-8dda-871132a8565a" ulx="110" uly="1171" lrx="924" lry="1199" /><zone xml:id="m-4435f3e4-7b69-42cc-a3ee-473cd4d52327" ulx="110" uly="1193" lrx="810" lry="1221" /><zone xml:id="m-60332266-0452-40cf-8fa4-46f0436c1eac" ulx="130" uly="1224" lrx="926" lry="1258" /><zone xml:id="m-d08d4ce3-cfc6-4354-a032-50ae0ffdd6f1" ulx="111" uly="1252" lrx="524" lry="1284" /><zone xml:id="m-73bf2624-32e2-4c3e-9be9-e4c48edf8365" ulx="130" uly="1282" lrx="926" lry="1314" /><zone xml:id="m-87d96862-70ff-439c-a14c-48b4806235a4" ulx="110" uly="1309" lrx="926" lry="1337" /><zone xml:id="m-4091925f-c59a-4376-bb6b-ece53176ad51" ulx="110" uly="1329" lrx="926" lry="1361" /><zone xml:id="m-74b13b6b-8b3f-4a74-90ec-0e58d1173a6e" ulx="111" uly="1355" lrx="756" lry="1388" /><zone xml:id="m-14d05c98-05e8-4378-ab0e-b20d7e4b0570" ulx="138" uly="1394" lrx="486" lry="1435" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-5f00cad8-ef75-4f7f-83f8-8d3b20bea16d" n="0816" facs="#m-741cf1b3-7b18-4a16-8546-4176e2622c41" /><div xml:id="m-c34bc0a8-784c-410c-ae3d-6758589bc350">
            <lg xml:id="m-39812ba4-cbcb-4231-b79d-28b718373cbb">
              <l xml:id="m-f7e6bcf3-0b29-4929-8449-12090298a39c" facs="#m-efd61b57-2902-4037-9f4f-41ca84fcb52d" label="ambiguous">670</l><l xml:id="m-d6226e00-93bb-432c-bac8-438df041ef33" facs="#m-598116c9-d045-4a68-b571-71e5bf0805cc" label="ambiguous">Maundy Thursday</l><l xml:id="m-44ea5873-0f7d-4b2d-936d-59ca5d47bd19" facs="#m-8e8ca40d-a82e-4d7f-a5f9-f7fecf68d564" label="lyrics-like">11. Munda cor meum, Jube, domne (Dómine), and Dóminus sit in corde</l><l xml:id="m-f801874c-cc44-48ed-8d6d-1d232ea675c6" facs="#m-c6a2d1a9-4632-489b-8378-efa9c2516b81" label="text-like">tuo (meo), are said as usual.</l><l xml:id="m-47c8bf6b-1634-45cc-bb4a-f647ae5ce616" facs="#m-adb97410-7e0a-40ed-a807-32b16738a4c5" label="ambiguous">Sequentia sancti Evangelii secundum Joannem</l><l xml:id="m-f31f14d5-9694-470b-ad96-06b1f53a8dd3" facs="#m-0e24be79-4213-485f-aac4-3979d56a30da" label="text-like">Our Lord prepares the apostles to receive the Holy Eucharist,</l><l xml:id="m-06626eea-8854-44bb-8faa-5a992582e9e9" facs="#m-ba522a01-cbd1-4824-9cb1-29842d4aef9b" label="text-like">the sien of His Love, by washing their feet. J5</l><l xml:id="m-e84944e5-af0c-42d6-b900-19d4035ed5ae" facs="#m-8cbdfc8a-2a05-4ef1-9fa1-e5e741f7d876" label="lyrics-like">HNte diem festum Paschae, «Si non lávero te, non habébis</l><l xml:id="m-6c722f0e-8954-47f4-b309-d42b0da1fd1a" facs="#m-25d495f9-2264-46db-9364-15fcd3e744f8" label="ambiguous">Al sciens Jesus quia venit hora partem mecum ». Dicit ei Simon</l><l xml:id="m-6baafeae-b85a-44e4-85b5-2a0d7a85680f" facs="#m-af56506d-e3da-49da-a24b-4315e1a1afbf" label="lyrics-like">Petrus: « Dómine, non tantum</l><l xml:id="m-aed6846a-be3f-4ec7-87fd-efdcf09a28a9" facs="#m-6ff3c738-f95b-4323-ac95-dc9da69fb7b6" label="lyrics-like">ejus, ut tránseat ex hoc mundo</l><l xml:id="m-4fd595b3-fbb7-4af4-b4b5-2f2a1bed0f1e" facs="#m-f667d492-2bb7-4db4-a9de-ffeab469a0c9" label="lyrics-like">ad Patrem, cum dilexísset suos,</l><l xml:id="m-0aefe1b2-ee89-4b9b-ba66-c42afb82f4b7" facs="#m-ac5e9fd9-8f23-4130-a283-02fdb411110b" label="ambiguous">pedes meos, sed et manus, et</l><l xml:id="m-8568c5b9-8f4f-4f42-b69b-8ded3dd0cf9f" facs="#m-0f7cafa2-9473-4ab0-b12e-9b34b16c5dae" label="ambiguous">qui erant in mundo, in finem</l><l xml:id="m-730921fd-4f8b-4f75-9e26-5f80cce92017" facs="#m-474edd5f-0df2-4215-9cf1-acea5fb55e95" label="ambiguous">caput ». Dicit ei Jesus: « Qui</l><l xml:id="m-d9677008-27fd-416d-9dc9-eb632927d605" facs="#m-57863967-eaf4-471f-941c-5c03e055db40" label="lyrics-like">diléxit cos. Et cena facta, cum</l><l xml:id="m-07770418-fdd8-4de1-86db-d5ea08fd874c" facs="#m-8958ff3b-c302-4b8d-a8b4-ad6743115fa7" label="ambiguous">lotus est, non indiget nisi ut</l><l xml:id="m-ea1e6f46-9e6f-4204-bf8c-534acc308452" facs="#m-842c5eb7-2784-4ec9-a671-2da918c94b25" label="lyrics-like">diábolus jam misísset in cor, ut</l><l xml:id="m-5b7c844a-6c4f-4868-bf2a-7f6015750cb2" facs="#m-9173687d-340d-472f-89bb-78d7a5403175" label="ambiguous">pedes lavet, sed est mundus</l><l xml:id="m-51d6d31e-1beb-49f0-8bfd-664727142827" facs="#m-cb065726-c1d1-46ea-8f90-0f5922089c64" label="lyrics-like">tráderet eum Judas Simónis Isca¬</l><l xml:id="m-b926ce1d-8491-43d9-a7e7-d861683e317b" facs="#m-914a4544-bab7-4435-ae02-90d85154dd5e" label="ambiguous">totus. Et vos mundi estis. sed</l><l xml:id="m-69d017f4-e7ce-4f66-a3d0-f5c049773375" facs="#m-45922a07-91e8-4a5d-8ebb-8d7a0b5b5278" label="lyrics-like">riótae; sciens quia ómnia dedit</l><l xml:id="m-f6bb0f98-0a2c-4f6c-a24d-7f7ab3c30d2d" facs="#m-5dc95fa1-db99-4974-97bd-2c0941994064" label="lyrics-like">non omnes ». Sciébat enim quis¬</l><l xml:id="m-3323d2a6-de73-40e4-9579-dfe78a074495" facs="#m-27a9e6a7-7c23-4df8-a636-2986d35804e7" label="ambiguous">ei Pater in manus, et quia a Deo</l><l xml:id="m-2529a752-0987-4a7c-a0c7-86840916d7bf" facs="#m-460720dd-f31f-4f40-af31-f786b0f98187" label="lyrics-like">nam esset qui tráderet eum;</l><l xml:id="m-49cf0418-0306-407f-945c-fcc582e6a41f" facs="#m-aba3bd00-c017-4ecc-83f1-eda78c439da5" label="lyrics-like">proptérea dixit : Non estis mundi</l><l xml:id="m-46936532-1af7-414c-b33b-0cf03cc6af6a" facs="#m-4c50d91d-0c0c-43eb-ad68-c82a65136206" label="ambiguous">exivit et ad Deum vadit; surgit</l><l xml:id="m-a211539b-f692-4a00-a1f4-ab1916fb4b66" facs="#m-a0efa9da-74fb-4524-bdbe-cfba44d9d9e9" label="lyrics-like">a cena, et ponit vestiménta sua;</l><l xml:id="m-1f31494d-65f9-4f1b-b1f4-1ac1ca602ff6" facs="#m-9e7130eb-e342-4222-b3eb-8bea47db791f" label="ambiguous">omnes. Postquam ergo lavit</l><l xml:id="m-d73f9873-2c68-43e2-9165-a04d05306099" facs="#m-4aeee2fb-63df-40cd-a5c8-64374e710fcf" label="lyrics-like">pedes córum, et accépit vesti¬</l><l xml:id="m-4dcbf4e6-7846-43bd-9e0b-a8d38f64ede9" facs="#m-07bca703-ae25-4bb6-ae2f-47b90e2839ae" label="lyrics-like">et cum accepisset línteum, prae¬</l><l xml:id="m-ddddfa64-327c-4ee3-9e90-5fa81d1f0560" facs="#m-7d3f2d5a-2481-497c-9c20-053a5cbe2147" label="ambiguous">cinxit se. Deinde mittit aquam</l><l xml:id="m-209623e3-1476-4c0d-af4b-5b6f0144d040" facs="#m-2335c985-9329-4a7c-a273-ec2d208654a8" label="lyrics-like">ménta sua, cum recubuisset</l><l xml:id="m-e78dd85f-8be2-4994-bf4f-d69f4771ac34" facs="#m-f88d0d68-6ab3-4df4-b2ea-476d943fca1c" label="ambiguous">sterum, dixit eis: « Scitis quid</l><l xml:id="m-24944aa8-2728-43ba-ad14-0f9b98abedf8" facs="#m-fbc8906e-fd11-465f-91f8-d37976e6210f" label="lyrics-like">in pelvim, et cœpit laváre pedes</l><l xml:id="m-c08255ab-0721-4c9d-86c7-a2356f63be7e" facs="#m-8a26e0e6-7cc8-4de1-b346-96627dd3c05b" label="lyrics-like">fécerim vobis? Vos vocátis me</l><l xml:id="m-a2ea6fe2-ddec-4a02-9934-2792b15b8818" facs="#m-32ff7982-65d3-4ca0-b71b-672d8a73e04b" label="lyrics-like">discipulórum, et extérgere linteo,</l><l xml:id="m-eb00294d-a270-4e01-9231-794b99b2a6de" facs="#m-063a45b7-0811-4d14-b1dd-ce77187c4ce2" label="lyrics-like">Magíster et Dómine, et bene</l><l xml:id="m-bfe6dd1c-1169-43d5-b68b-13070480a406" facs="#m-d2a36611-e0a4-4894-a0b8-c177ef53daa3" label="ambiguous">quo erat praecinctus. Venit ergo</l><l xml:id="m-ed68abe6-95ad-4747-8fe9-27154069cbb3" facs="#m-f277a529-c126-4d16-8347-d9064f7dd866" label="lyrics-like">ad Simónem Petrum. Et dicit</l><l xml:id="m-e4559096-3974-42f9-bdff-d00db51fd437" facs="#m-289db236-23ac-444d-8830-37cdf211060e" label="lyrics-like">dícitis; sum étenim. Si ergo</l><l xml:id="m-c8b12058-9bcb-41ff-87e5-dc20cf98b86e" facs="#m-e30cf642-0ca6-43e0-9029-49df5f1ca890" label="lyrics-like">ei Petrus: « Dómine, tu mihi</l><l xml:id="m-cbb6b140-74eb-48e0-b449-e0c8d9a08ece" facs="#m-6c2aa648-39dd-413b-b017-a84d1841dfdf" label="lyrics-like">ego lavi pedes vestros, Dóminus</l><l xml:id="m-a68460d7-5b0e-4bac-9c74-3bcfbf64256d" facs="#m-74f496c9-c2a0-4d6c-951f-fba7e6e4da01" label="lyrics-like">lavas pedes?» Respóndit Jesus</l><l xml:id="m-50459d48-bb3c-4572-94d7-e6892e87c7b6" facs="#m-18df99cf-e27c-4c80-b7b0-d7a3bd7e60b7" label="lyrics-like">et Magister : et vos debétis alter</l><l xml:id="m-d798a48d-c7db-4400-891d-37cf3479cc33" facs="#m-cd9f6bcd-b5c4-4480-a6ad-d9951f3172c8" label="lyrics-like">et dixit ei: «Quod ego fácio,</l><l xml:id="m-7e1414b4-3878-40dd-8216-8d755255a0f8" facs="#m-684a25f3-44b0-4f1e-9d53-454ac5b8a5f8" label="lyrics-like">altérius laváre pedes. Exémplum</l><l xml:id="m-db274f22-bb50-4a96-a7d6-b88084fba245" facs="#m-e5bab600-16fc-40fb-8cd6-f39504626141" label="ambiguous">tu nescis modo, scies autem</l><l xml:id="m-675c7bb2-eb7e-45d2-9225-d9300e5e8741" facs="#m-d0c54658-e327-4a26-8551-4fbce9c1a2ce" label="lyrics-like">enim dedi vobis, ut, quemád¬</l><l xml:id="m-3649375f-0161-4161-9cda-75317985c848" facs="#m-5ff1d293-3263-4bd0-a17c-ad7fd8309f13" label="lyrics-like">póstea ». Dicit ei Petrus : « Non</l><l xml:id="m-1ea67a9d-a509-47f0-8c79-74e40e2ca8c2" facs="#m-56e906d1-db92-413d-86b2-cdeb4e0e307e" label="ambiguous">modum ego feci vobis, ita et</l><l xml:id="m-8b0c91b0-2baf-47ee-a794-ebde6eb6431b" facs="#m-e16f9686-3581-48b1-8bb1-2c07b7225643" label="lyrics-like">lavábis mihi pedes in actér¬</l><l xml:id="m-75a949d8-136a-4f67-b200-73dff577545f" facs="#m-283b100e-86e6-48fb-8b87-1198c2e7a9bb" label="lyrics-like">vos faciátis ».</l><l xml:id="m-3708ca32-6062-4d67-a800-49be2ea8264e" facs="#m-9f56bd96-432a-4bd8-b99e-8912b6dbb907" label="lyrics-like">num ». Respóndit ei Jesus:</l><l xml:id="m-95ba358e-f23b-4a25-bfad-299283396c10" facs="#m-d8eeb7d8-b897-44f9-8af9-75d831f840ff" label="text-like">13. It is most suitable to have a brief sermon after the Gospel to explain</l><l xml:id="m-ef35573e-b506-492a-b193-752636ebd55d" facs="#m-f92d0e57-3076-428f-b3f5-8a58a8007172" label="text-like">the principal mysteries which this Mass recalls, i. e. the institution of the</l><l xml:id="m-3a3533c2-82cb-4ee9-8b5d-9cbd847334c7" facs="#m-cb5cde3f-189e-4133-b705-39a998c7eb13" label="text-like">Holy Eucharist and of the Order of Priests, and also the commandment</l><l xml:id="m-0d402756-022d-47ce-a0a5-74d1024adafc" facs="#m-0cc5f8f0-0980-4455-b469-dc387dd3739f" label="text-like">(mandatum) of Our Lord about fraternal charity.</l><l xml:id="m-96216da4-8bbf-4b0c-9b7b-b3d1c568d28e" facs="#m-4c8593d6-56c4-4240-8d07-99bf9cbe45a2" label="text-like">Let the faithful be instructed about Our Lord’s love for men, shewn by</l><l xml:id="m-c19a16d8-6260-4212-9507-811b45b5b043" facs="#m-4c11fbbd-637e-4d46-a772-bf987fbd314a" label="text-like">his institution “on the day before He suffered" of the Holy Eucharist</l><l xml:id="m-3be20d2f-af75-438f-888b-213517820585" facs="#m-dcdb94c7-d34e-4d83-8dda-871132a8565a" label="text-like">which is both sacrifice and sacrament, the perpetual memorial of His</l><l xml:id="m-1c5e1620-5215-41d5-98ef-349a7fb82b08" facs="#m-4435f3e4-7b69-42cc-a3ee-473cd4d52327" label="text-like">Passion, to be celebrated for all time by the ministry of priests.</l><l xml:id="m-c785f714-6371-4e14-b1a8-7b898ce9d5b1" facs="#m-60332266-0452-40cf-8fa4-46f0436c1eac" label="text-like">Let the faithful also be invited to come and give their due adoration</l><l xml:id="m-4b416407-990d-4247-bb74-4218f923b9ec" facs="#m-d08d4ce3-cfc6-4354-a032-50ae0ffdd6f1" label="text-like">to the Blessed Sacrament after Mass.</l><l xml:id="m-7f1bf864-f65d-41d0-9937-c00b5e9738f1" facs="#m-73bf2624-32e2-4c3e-9be9-e4c48edf8365" label="text-like">Lastly, where the rite of the Washing of the Feet takes place in church,</l><l xml:id="m-ff7b10af-99b1-4016-a8ed-3987d02a9682" facs="#m-87d96862-70ff-439c-a14c-48b4806235a4" label="text-like">let the faithful be instructed about its deep meaning as the sign of Our</l><l xml:id="m-6b8eb277-1502-4e52-a7b1-2a08cbde9e4f" facs="#m-4091925f-c59a-4376-bb6b-ece53176ad51" label="text-like">Lord's commandment of fraternal charity, and let them be encouraged</l><l xml:id="m-c0908000-ddf8-42ab-9050-c1802f068410" facs="#m-74b13b6b-8b3f-4a74-90ec-0e58d1173a6e" label="text-like">to practice abundantly this day works of Christian charity.</l><l xml:id="m-4839bb47-6123-4127-8865-c1fdcc26f849" facs="#m-14d05c98-05e8-4378-ab0e-b20d7e4b0570" label="text-like">14. To-day the Credo is omitted.</l></lg></div></section></score></mdiv></body></music>
</mei>