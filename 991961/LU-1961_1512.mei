      <graphic xml:id="m-9559616b-70a0-4a82-a659-9b2eda5aa279" target="1512_original_image.tiff" /><zone xml:id="m-4560dab4-92da-47cb-a384-3ecc2638700a" ulx="154" uly="97" lrx="224" lry="133" /><zone xml:id="m-5d8adcdb-11ef-4730-9149-45a069c12fbe" ulx="485" uly="99" lrx="688" lry="133" /><zone xml:id="m-68926ae4-03bb-4678-b650-0604f4a15d13" ulx="155" uly="161" lrx="202" lry="204" /><zone xml:id="m-15bc30d9-4411-4ff4-bf56-7882754dc137" ulx="292" uly="162" lrx="877" lry="203" /><zone xml:id="m-93c6e96e-7b00-4971-a06f-f6c131f1cf06" ulx="531" uly="206" lrx="644" lry="243" /><zone xml:id="m-dafb1e32-47c3-41a0-88c2-a079f985d79a" ulx="171" uly="236" lrx="1015" lry="278" /><zone xml:id="m-f11099c0-4f86-4e89-983f-1d8266b8fa52" ulx="156" uly="269" lrx="995" lry="309" /><zone xml:id="m-1d52e5ce-95b2-4375-ac81-7aa71a831ff0" ulx="157" uly="304" lrx="596" lry="331" /><zone xml:id="m-c29ddc36-1fc8-4360-a423-2f384a989f8f" ulx="178" uly="328" lrx="936" lry="367" /><zone xml:id="m-dbf2f340-7e13-4766-a8e8-1f521aa30c64" ulx="314" uly="402" lrx="884" lry="450" /><zone xml:id="m-7bda9d72-0582-4688-baf7-40c85914fdb5" ulx="157" uly="408" lrx="201" lry="448" /><zone xml:id="m-5631852b-ad8f-4ac9-a162-35f55818587e" ulx="905" uly="408" lrx="1022" lry="450" /><zone xml:id="m-cab6187e-b69f-49a7-996b-332739f15098" ulx="531" uly="456" lrx="658" lry="496" /><zone xml:id="m-a1f58d71-1540-4dee-bc2c-1685ddf03a34" ulx="179" uly="487" lrx="957" lry="532" /><zone xml:id="m-f1a0b37c-497f-441c-82d8-23b3cc9ec5fa" ulx="535" uly="532" lrx="647" lry="563" /><zone xml:id="m-22a75b5b-a50d-4bf7-b39a-67d40c91814b" ulx="196" uly="552" lrx="1024" lry="594" /><zone xml:id="m-1ad139f3-e5ea-405f-95ee-ea649a414205" ulx="158" uly="586" lrx="1025" lry="621" /><zone xml:id="m-4983492d-c5b1-4201-84dd-c28e70b87400" ulx="156" uly="613" lrx="666" lry="652" /><zone xml:id="m-6f287346-3a53-4cd4-aaa0-5dd9a1910a76" ulx="175" uly="657" lrx="1009" lry="692" /><zone xml:id="m-9abc3d3f-cba8-434d-b6fa-e7091cd2a313" ulx="167" uly="689" lrx="1027" lry="736" /><zone xml:id="m-c99b0040-58f9-4e43-b5da-c74c105717f5" ulx="161" uly="721" lrx="1024" lry="759" /><zone xml:id="m-01f876a9-4497-44a0-a5a8-3fe0e862da52" ulx="162" uly="750" lrx="1025" lry="783" /><zone xml:id="m-18df9e05-1b26-4f65-b588-b14f7079fe8c" ulx="594" uly="774" lrx="1026" lry="813" /><zone xml:id="m-d84f08d1-c4ce-499e-a141-8d7bce4ec86f" ulx="158" uly="775" lrx="588" lry="812" /><zone xml:id="m-ff1ab750-6057-455e-8295-3b25435171c0" ulx="159" uly="802" lrx="1027" lry="838" /><zone xml:id="m-ec5707ce-c227-48ba-aa88-febd09e44a2c" ulx="592" uly="830" lrx="1020" lry="863" /><zone xml:id="m-d440d75b-f894-4d25-bddb-ddbdfaf7126d" ulx="158" uly="833" lrx="589" lry="862" /><zone xml:id="m-7a44a95b-4ebc-4732-970d-dd5a817f5c6d" ulx="593" uly="855" lrx="1026" lry="889" /><zone xml:id="m-961fe678-ca60-4830-8fae-13a17448e55c" ulx="159" uly="856" lrx="587" lry="893" /><zone xml:id="m-df08bfe6-3b3c-4b7a-b080-9004b9c3bc36" ulx="158" uly="882" lrx="1027" lry="915" /><zone xml:id="m-4806fed8-77ac-4854-991a-d632055626fa" ulx="159" uly="914" lrx="1028" lry="942" /><zone xml:id="m-38fa8183-f6a6-4a2e-ac47-64c7bc83567e" ulx="158" uly="935" lrx="590" lry="968" /><zone xml:id="m-7363771d-215e-4e1b-9d2c-19465cc3e82f" ulx="595" uly="936" lrx="1027" lry="969" /><zone xml:id="m-b008d7cb-95cf-4053-8868-382f11f03059" ulx="159" uly="962" lrx="1027" lry="995" /><zone xml:id="m-99e1f9c4-990b-4b02-b69a-4487fb02b371" ulx="159" uly="994" lrx="1027" lry="1025" /><zone xml:id="m-ba1387b1-957b-48ab-a8d1-d122a43a7d1f" ulx="160" uly="1016" lrx="1027" lry="1053" /><zone xml:id="m-2a8358d3-ed0d-4fa3-b992-6a92c8704edf" ulx="161" uly="1044" lrx="1026" lry="1077" /><zone xml:id="m-ba9aefae-0cbc-4508-8a37-1dc5ab2f2ea1" ulx="160" uly="1069" lrx="1026" lry="1106" /><zone xml:id="m-1f89164e-594f-4686-bbb5-5a004589be50" ulx="160" uly="1096" lrx="979" lry="1131" /><zone xml:id="m-1a32ff1d-e9d4-439e-8c52-142352408fb4" ulx="186" uly="1133" lrx="1019" lry="1175" /><zone xml:id="m-7754e787-e31c-48ac-b2e2-0a01582627ce" ulx="159" uly="1161" lrx="259" lry="1200" /><zone xml:id="m-6fbc9a84-45b6-4b41-9b07-c831b69d7256" ulx="185" uly="1193" lrx="718" lry="1235" /><zone xml:id="m-54ed6287-9ef0-4c6d-b9cf-817543fba35a" ulx="186" uly="1225" lrx="578" lry="1266" /><zone xml:id="m-1f2ecdd0-83ff-4599-bfff-e95a2bc1cdbf" ulx="547" uly="1262" lrx="647" lry="1297" /><zone xml:id="m-29742aea-4140-48a3-a446-73deac044641" ulx="184" uly="1289" lrx="1018" lry="1330" /><zone xml:id="m-1c364190-5ff4-429c-95e6-db1f95fbd127" ulx="163" uly="1317" lrx="1018" lry="1355" /><zone xml:id="m-b44e288e-4ae2-40ee-a056-01879c2021eb" ulx="162" uly="1346" lrx="714" lry="1379" /><zone xml:id="m-55514376-06ed-4b6b-872c-1af175f7b697" ulx="166" uly="1372" lrx="599" lry="1410" /><zone xml:id="m-8800d56b-225c-440d-b90e-bdaaef30fb22" ulx="187" uly="1402" lrx="613" lry="1442" /><zone xml:id="m-574f1154-042f-481a-88f9-d7ea40cc41e8" ulx="479" uly="1443" lrx="718" lry="1477" /><zone xml:id="m-783b1794-3050-4c04-9e6c-0b7fa16a49c7" ulx="175" uly="1470" lrx="1010" lry="1506" /><zone xml:id="m-38ef228e-4167-4aa1-968d-25501594f433" ulx="167" uly="1501" lrx="737" lry="1539" /><zone xml:id="m-e92d4593-5fb6-4ab4-9160-db7305356129" ulx="165" uly="1526" lrx="601" lry="1565" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-4510587f-2fd8-47ce-b905-2b389d5b3501" n="1512" facs="#m-db4bbaf7-a18d-4682-88a2-c1b4325320d6" /><div xml:id="m-6bfc4f0f-b2ec-48ab-a5ae-455a884befce">
            <lg xml:id="m-a95e1af2-cb6f-482a-b883-8049de211a3c">
              <l xml:id="m-fd8fcf6c-cac4-451f-b29a-56669e271be7" facs="#m-4560dab4-92da-47cb-a384-3ecc2638700a" label="ambiguous">1312</l><l xml:id="m-7b222136-6abe-4cc6-954a-4f90c49225dc" facs="#m-5d8adcdb-11ef-4730-9149-45a069c12fbe" label="ambiguous">December 5. 6.</l><l xml:id="m-609f7c17-d658-4933-8b3c-9e4e8c59d9ec" facs="#m-68926ae4-03bb-4678-b650-0604f4a15d13" label="ambiguous">5.</l><l xml:id="m-71d5ba83-d65c-4965-8624-9c95bf4a22df" facs="#m-15bc30d9-4411-4ff4-bf56-7882754dc137" label="text-like">Commemoration of St. Sabbas, Abbot.</l><l xml:id="m-e4f01c13-83dc-4648-8384-e605a8485803" facs="#m-93c6e96e-7b00-4971-a06f-f6c131f1cf06" label="ambiguous">Collect.</l><l xml:id="m-1318a0e8-d23e-481a-b4f0-51f978b47175" facs="#m-dafb1e32-47c3-41a0-88c2-a079f985d79a" label="lyrics-like">TNtercéssio nos, quaésumus Dó-] non valémus, ejus patrocinio asse</l><l xml:id="m-c7ba6050-a53f-4872-b800-064223a34c0e" facs="#m-f11099c0-4f86-4e89-983f-1d8266b8fa52" label="lyrics-like">L mine, beáti Sabbãe Abbátis com-lquámur. Per Dóminum nostrum.</l><l xml:id="m-3167f924-9c0a-41ff-bfe4-82be03d6127d" facs="#m-1d52e5ce-95b2-4375-ac81-7aa71a831ff0" label="lyrics-like">méndet :* ut quod nostris méritis!</l><l xml:id="m-a60b7f89-5419-4d44-b35c-9814afabb441" facs="#m-c29ddc36-1fc8-4360-a423-2f384a989f8f" label="lyrics-like">Secret. Sacris altáribus. and Postcommunion. Prótegat nos. p. 1209.</l><l xml:id="m-04f70a50-885c-4bdd-99a5-cf7e658ad410" facs="#m-dbf2f340-7e13-4766-a8e8-1f521aa30c64" label="text-like">St. Nicholas, Bishop and Confessor.</l><l xml:id="m-bcd30148-099b-4d4a-a9ab-2b0a4e3b94a9" facs="#m-7bda9d72-0582-4688-baf7-40c85914fdb5" label="ambiguous">6.</l><l xml:id="m-4cc6e197-de56-4595-a948-2bbbf755c342" facs="#m-5631852b-ad8f-4ac9-a162-35f55818587e" label="ambiguous">Double.</l><l xml:id="m-fc4315ba-c5c1-41ab-befd-5cd30d2067b3" facs="#m-cab6187e-b69f-49a7-996b-332739f15098" label="text-like">At Mass.</l><l xml:id="m-fa273488-a36e-4374-8eb3-15846df71c76" facs="#m-a1f58d71-1540-4dee-bc2c-1685ddf03a34" label="lyrics-like">Intrott. Státuit. From the Common of a Confessor Bishop, p. 1182.</l><l xml:id="m-c07c54c1-0718-41f9-ac1b-b52307e794fd" facs="#m-f1a0b37c-497f-441c-82d8-23b3cc9ec5fa" label="ambiguous">Collect.</l><l xml:id="m-bf982192-5816-4f73-9d65-0b2b0993d056" facs="#m-22a75b5b-a50d-4bf7-b39a-67d40c91814b" label="lyrics-like">Eus, qui beátum Nicoláum Pon-lejus méritis et précibus * a gehén¬</l><l xml:id="m-1feba8ba-7ce7-40d3-b6fd-ee8c96649157" facs="#m-1ad139f3-e5ea-405f-95ee-ea649a414205" label="lyrics-like">I tificem innúmeris decorásti mi-l nae incéndiis liberémur. Per Dómi¬</l><l xml:id="m-b8da15de-fe9b-4e98-b12a-509e45501fa1" facs="#m-4983492d-c5b1-4201-84dd-c28e70b87400" label="lyrics-like">ráculis: t tribue, quaésumus; ut! num.</l><l xml:id="m-94417f71-0600-46d7-89d2-6d1a35b6effc" facs="#m-6f287346-3a53-4cd4-aaa0-5dd9a1910a76" label="ambiguous">Lectio Epistolae beati Pauli Apostoli ad Hebraeos. Hebr. 13. b.</l><l xml:id="m-b6f98b2d-c4f9-467e-87e8-bb744e1f6291" facs="#m-9abc3d3f-cba8-434d-b6fa-e7091cd2a313" label="lyrics-like">HRatres : Mementóte praepositó-] pter quod et Jesus, ut sanctificáret</l><l xml:id="m-1c42aff1-06de-4c89-90d8-6eaf429f336f" facs="#m-c99b0040-58f9-4e43-b5da-c74c105717f5" label="lyrics-like">Trum vestrórum, qui vobis locúti per suum sánguinem pópulum,</l><l xml:id="m-ac18c8da-5db4-4771-8229-5642db6ca259" facs="#m-01f876a9-4497-44a0-a5a8-3fe0e862da52" label="lyrics-like">sunt verbum Dei : quorum intuén-extra portam passus est. Exeámus</l><l xml:id="m-1406ff06-bf31-47a5-b69c-672478ed081e" facs="#m-18df9e05-1b26-4f65-b588-b14f7079fe8c" label="ambiguous">igitur ad eum extra castra, impro¬</l><l xml:id="m-12cdbf7a-162c-4b07-ab50-bc8781994afe" facs="#m-d84f08d1-c4ce-499e-a141-8d7bce4ec86f" label="lyrics-like">tes éxitum conversatiónis, imitá¬</l><l xml:id="m-3627d3f7-98ba-4632-9ccb-a2020974bbce" facs="#m-ff1ab750-6057-455e-8295-3b25435171c0" label="lyrics-like">mini fidem. Jesus Christus heri, et périum ejus portántes. Non enim</l><l xml:id="m-23479c65-6594-4a3d-86c7-0c65487b3deb" facs="#m-ec5707ce-c227-48ba-aa88-febd09e44a2c" label="lyrics-like">habémus hic manéntem civitátem,</l><l xml:id="m-5d227bb8-8acb-4251-bbf0-325a2b4d03db" facs="#m-d440d75b-f894-4d25-bddb-ddbdfaf7126d" label="lyrics-like">hódie : ipse et in saécula. Doctrinis</l><l xml:id="m-bee4f7d0-5991-4274-9cb2-45b55e22c949" facs="#m-7a44a95b-4ebc-4732-970d-dd5a817f5c6d" label="lyrics-like">sed futúram inquírimus. Per ipsum</l><l xml:id="m-e309145f-2dde-428c-9a1b-f3fd46e68b24" facs="#m-961fe678-ca60-4830-8fae-13a17448e55c" label="lyrics-like">váriis et peregrinis nolite abdúci.</l><l xml:id="m-8c64a8af-1d00-439d-9e1d-94a212d55fff" facs="#m-df08bfe6-3b3c-4b7a-b080-9004b9c3bc36" label="lyrics-like">Optimum est enim grátia stabilirel ergo offerámus hóstiam laudis sem¬</l><l xml:id="m-d9475801-00e9-4bd9-b2ba-73f7cc1bac14" facs="#m-4806fed8-77ac-4854-991a-d632055626fa" label="lyrics-like">cor, non escis, quae non profuérunt! per Deo, id est, fructum labiórum</l><l xml:id="m-0deaaeff-8e01-41fe-bddd-1f9aed65047c" facs="#m-38fa8183-f6a6-4a2e-ac47-64c7bc83567e" label="lyrics-like">ambulántibus in eis. Habémus al¬</l><l xml:id="m-eae4becc-2c03-4fdd-ae8b-6f74ad356907" facs="#m-7363771d-215e-4e1b-9d2c-19465cc3e82f" label="lyrics-like">confiténtium nómini ejus. Benefi¬</l><l xml:id="m-75d6fe16-8c2d-4160-8a14-7c2fc46ff97a" facs="#m-b008d7cb-95cf-4053-8868-382f11f03059" label="lyrics-like">táre, de quo édere non habent! céntiae autem et communiónis no¬</l><l xml:id="m-79297842-1a1a-4a87-9672-beb9ee1812be" facs="#m-99e1f9c4-990b-4b02-b69a-4487fb02b371" label="lyrics-like">potestátem, qui tabernáculo desér- lite oblivísci : tálibus enim hóstiis</l><l xml:id="m-0d47716c-b00e-4884-a13f-41a048daee30" facs="#m-ba1387b1-957b-48ab-a8d1-d122a43a7d1f" label="lyrics-like">viunt. Quorum enim animálium promerétur Deus. Obedite praepó¬</l><l xml:id="m-fe70ba91-30bc-430c-98b7-69bb3ccaa113" facs="#m-2a8358d3-ed0d-4fa3-b992-6a92c8704edf" label="lyrics-like">infértur sanguis pro peccáto in sitis vestris, et subjacéte eis. Ipsi</l><l xml:id="m-eabd7333-151b-46d7-8621-daac4bdd82ae" facs="#m-ba9aefae-0cbc-4508-8a37-1dc5ab2f2ea1" label="lyrics-like">Sancta per Pontificem, horum cór-lenim pervígilant, quasi ratióném</l><l xml:id="m-6bf9fbb7-7b5d-4ac9-9402-bf1557f228e1" facs="#m-1f89164e-594f-4686-bbb5-5a004589be50" label="lyrics-like">pora cremántur extra castra. Pro-l pro animábũs vestris redditúri.</l><l xml:id="m-f0577106-6370-42eb-b756-bcaea94b23d6" facs="#m-1a32ff1d-e9d4-439e-8c52-142352408fb4" label="lyrics-like">Gradual. Invéni. D. 1130. — Alleluia, alleluia. V. Jústus ut pálma</l><l xml:id="m-080d9b2e-e884-4478-94d6-bd82729478d7" facs="#m-7754e787-e31c-48ac-b2e2-0a01582627ce" label="ambiguous">. 1207.</l><l xml:id="m-5e593928-d211-4e47-9807-c54663232b37" facs="#m-6fbc9a84-45b6-4b41-9b07-c831b69d7256" label="lyrics-like">Gospel. Homo péregre proficiscens. D. 1184.</l><l xml:id="m-a14e1c28-e1ce-4b9c-8729-dceec72daa7d" facs="#m-54ed6287-9ef0-4c6d-b9cf-817543fba35a" label="lyrics-like">offertory. Véritas méa. p. 1203.</l><l xml:id="m-f35d2d24-72c3-49fe-8fa3-6a6322331a89" facs="#m-1f2ecdd0-83ff-4599-bfff-e95a2bc1cdbf" label="ambiguous">Secret.</l><l xml:id="m-431c200e-7edd-4fd0-a3b0-d271187d3e18" facs="#m-29742aea-4140-48a3-a446-73deac044641" label="lyrics-like">YAnctífica, quaésumus Dómine nostra inter advérsa et prósper¬</l><l xml:id="m-19bca502-00d5-4d2c-ad3a-f2e89303d93b" facs="#m-1c364190-5ff4-429c-95e6-db1f95fbd127" label="lyrics-like">S Deus, haec múnera, quae in lubique dirigátur. Per Dóminur</l><l xml:id="m-f3553f79-b001-421e-8813-e3dea19781fb" facs="#m-b44e288e-4ae2-40ee-a056-01879c2021eb" label="lyrics-like">solemnitáte sancti Antístitis tui l nostrum.</l><l xml:id="m-9380478a-f9ec-4485-b8df-5c602d838e2c" facs="#m-55514376-06ed-4b6b-872c-1af175f7b697" label="lyrics-like">Nicolái offérimus : ut per ea, vita!</l><l xml:id="m-4fba8462-d94b-4cfe-a099-578880e8fb8b" facs="#m-8800d56b-225c-440d-b90e-bdaaef30fb22" label="lyrics-like">Communion. Semel jurávi. p. 1132.</l><l xml:id="m-bc9b4d9b-5257-4e47-bc13-a4de98367916" facs="#m-574f1154-042f-481a-88f9-d7ea40cc41e8" label="ambiguous">Postcommunion.</l><l xml:id="m-c518d4ef-4899-4c33-bfb1-ce12b49c9bce" facs="#m-783b1794-3050-4c04-9e6c-0b7fa16a49c7" label="lyrics-like">NAcrificia, quae súmpsimus, Dó-] nos protectióne consérvent. P</l><l xml:id="m-3e372ba5-3f7c-4689-a218-2a3bfec5058c" facs="#m-38ef228e-4167-4aa1-968d-25501594f433" label="lyrics-like">O mine, pro solemnitáte sancti! Dóminum.</l><l xml:id="m-6937181e-8984-46c1-90be-cf1cee84bcb7" facs="#m-e92d4593-5fb6-4ab4-9160-db7305356129" label="lyrics-like">Pontificis tui Nicolái, sempitérna!</l></lg></div></section></score></mdiv></body></music>
</mei>