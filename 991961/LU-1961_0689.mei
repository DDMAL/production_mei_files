"568" /><zone xml:id="m-bdb5051a-4aae-4b4d-b1e4-63761821b817" ulx="485" uly="535" lrx="914" lry="568" /><zone xml:id="m-9de6aa0e-9bde-4a52-956c-b1bc255cbafe" ulx="49" uly="561" lrx="475" lry="597" /><zone xml:id="m-d133cdba-9759-4459-a56f-e5d646a9e832" ulx="485" uly="563" lrx="911" lry="601" /><zone xml:id="m-32dca047-4162-41a7-a9ee-3c01ba0c4154" ulx="49" uly="588" lrx="474" lry="621" /><zone xml:id="m-763bec4c-3ae2-4da1-803d-a6b672d65fd1" ulx="485" uly="592" lrx="910" lry="626" /><zone xml:id="m-e8c4bb8c-0db5-43a5-9acc-840918ae8061" ulx="49" uly="616" lrx="912" lry="651" /><zone xml:id="m-58a62003-0391-4f77-9f45-8a9b987de800" ulx="48" uly="643" lrx="641" lry="677" /><zone xml:id="m-29579915-e633-4420-a724-51bae3e93472" ulx="73" uly="692" lrx="415" lry="724" /><zone xml:id="m-c3ffe45f-b4e4-4128-8925-96c42e873d6f" ulx="72" uly="721" lrx="545" lry="760" /><zone xml:id="m-56029058-694a-48b3-a5c4-f24924a111ae" ulx="431" uly="769" lrx="538" lry="802" /><zone xml:id="m-82b0f545-22ac-4f1e-be10-dee08fd0465e" ulx="59" uly="801" lrx="904" lry="839" /><zone xml:id="m-05652d0c-3798-4139-9a2e-5a2e8c520ab7" ulx="50" uly="832" lrx="912" lry="870" /><zone xml:id="m-f19aa607-cbb6-4f59-ae27-8e6985b49284" ulx="50" uly="860" lrx="725" lry="896" /><zone xml:id="m-e9235a58-6ae9-4ae5-9d5f-8f4868030dba" ulx="75" uly="904" lrx="910" lry="949" /><zone xml:id="m-c1388309-5013-4fc2-ad08-7bc5cb93bc3c" ulx="49" uly="937" lrx="619" lry="972" /><zone xml:id="m-617ba630-cc7e-4feb-b65a-978c5e830763" ulx="75" uly="975" lrx="632" lry="1016" /><zone xml:id="m-2eb7283a-a80a-4d26-9b62-11ae1eb2790f" ulx="74" uly="1011" lrx="548" lry="1051" /><zone xml:id="m-5a1916b3-4ba0-4a1c-8f89-83309dee9b56" ulx="74" uly="1046" lrx="683" lry="1083" /><zone xml:id="m-0b348971-5a5c-4a82-bf39-e0dd55ce1c47" ulx="76" uly="1106" lrx="886" lry="1146" /><zone xml:id="m-28dd6608-0633-4e1d-b9ba-ace5cc0951fa" ulx="426" uly="1138" lrx="569" lry="1172" /><zone xml:id="m-d9da07f3-95e4-4233-b659-b5082f1a3695" ulx="62" uly="1180" lrx="915" lry="1228" /><zone xml:id="m-c4ec6b1f-96b1-4478-8c95-718fe1023956" ulx="51" uly="1212" lrx="915" lry="1253" /><zone xml:id="m-78d5b4b6-1201-4f10-9cfb-ebe1c27380a9" ulx="484" uly="1242" lrx="913" lry="1275" /><zone xml:id="m-c8c6f13c-5bf2-4a50-b9dd-56fe99b7ca9f" ulx="48" uly="1243" lrx="478" lry="1275" /><zone xml:id="m-53803277-8a71-4b89-ac8e-94a4d398068a" ulx="48" uly="1268" lrx="477" lry="1301" /><zone xml:id="m-812df767-a9e2-4cb5-9ef9-37e6d1bc4aa7" ulx="483" uly="1269" lrx="915" lry="1300" /><zone xml:id="m-6930fe01-dcd8-4991-819f-096bc644f976" ulx="487" uly="1294" lrx="914" lry="1333" /><zone xml:id="m-6a4df43a-47a5-4c03-ba6e-374f4276cf4f" ulx="48" uly="1298" lrx="476" lry="1332" /><zone xml:id="m-48e04a32-eda4-4250-b581-e25e3110e4b6" ulx="487" uly="1322" lrx="915" lry="1355" /><zone xml:id="m-d01561c5-c74d-42c5-ba29-53d031bfa160" ulx="48" uly="1324" lrx="477" lry="1355" /><zone xml:id="m-54dc2797-e1ce-4619-8a1a-5b65d09bd742" ulx="488" uly="1350" lrx="915" lry="1387" /><zone xml:id="m-761d0c27-0634-497b-9b78-10687fff9363" ulx="48" uly="1353" lrx="476" lry="1388" /><zone xml:id="m-f51f7b7a-3b31-46f3-a5db-00bb8e8f86a8" ulx="486" uly="1376" lrx="914" lry="1412" /><zone xml:id="m-bcdac45a-c69b-43ba-bce0-ae23e449107a" ulx="50" uly="1378" lrx="476" lry="1410" /><zone xml:id="m-55e62e91-dd62-4c18-8bd9-2581584301d5" ulx="486" uly="1403" lrx="913" lry="1440" /><zone xml:id="m-2afcdc0d-8e23-4c55-9b69-c403ac2fd882" ulx="49" uly="1405" lrx="476" lry="1439" /><zone xml:id="m-2dbd6452-4a6b-43c3-9054-bc7dfbc25bd2" ulx="49" uly="1431" lrx="598" lry="1467" /><zone xml:id="m-ce37802d-f6d1-4f94-a119-18c84d057695" ulx="78" uly="1473" lrx="479" lry="1514" /><zone xml:id="m-e2d403f6-f4c2-4163-a9f5-ff138975fbd4" ulx="76" uly="1512" lrx="772" lry="1548" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-01daa491-1fc4-4e35-beb7-d73119cb4598" n="0689" facs="#m-b9b9149e-cee1-40e1-b522-cfb12640745e" /><div xml:id="m-f428a941-83bc-48ca-a41e-e397afd6aa2f">
            <lg xml:id="m-3b075ccb-a1f4-4a0c-a749-60e1b0f1e684">
              <l xml:id="m-19c6fd9f-17a1-4bf9-a6ba-9f2bbab895b8" facs="#m-d078eae2-567f-4a66-ac84-343cdb85bc5e" label="text-like">Saturday in Ember week of Lent.</l><l xml:id="m-91feb71c-959b-4fcd-85e1-20e99cd1f264" facs="#m-a740534d-2ca8-4172-8e33-f2703418cd61" label="ambiguous">543</l><l xml:id="m-45e10b47-cc3a-4d8a-a769-14e9bb2933ff" facs="#m-228a44e9-45aa-4d32-877c-18f751678ecf" label="ambiguous">Collect.</l><l xml:id="m-1885b573-a6ff-408e-8bdd-d82a68460e17" facs="#m-20fbeaec-bf79-410c-b996-74a30368c317" label="lyrics-like">DReces pópuli tui, quaésumus mur, pro tui nóminis glória miseri¬</l><l xml:id="m-89308746-fff8-44bf-9830-856b9e683f7e" facs="#m-8530d74b-a086-4c85-b10c-fbb56409bc67" label="lyrics-like">LDómine, cleménter exáudi: ut, córditer liberémur. Per Dóminum.</l><l xml:id="m-5b5b4137-7478-434d-bddc-3fc84ba0b000" facs="#m-e5be9b49-e7b6-417b-879c-ccf952b52560" label="lyrics-like">qui juste pro peccátis nostris affligi¬</l><l xml:id="m-2617c885-7d83-4d48-8580-e357d03b2192" facs="#m-53e92bd7-6f38-4e3e-af4d-092cd0807a59" label="ambiguous">Lesson IV.</l><l xml:id="m-8265ec1f-aafa-4598-8c65-97dcefca217e" facs="#m-44954a23-5ef8-4f8a-9c05-cce63698fbf7" label="lyrics-like">Léctio libri Sapiéntiae. Eccli. 36.</l><l xml:id="m-1a0246b5-fca9-4431-98b8-90e16d776b42" facs="#m-cab48c39-1016-48bf-92d7-58ddb90e8ace" label="lyrics-like">Iserére nostri, Deus ómnium, nostro magnificáberis in eis, ut</l><l xml:id="m-a547c980-50c8-443d-b235-f10c323a453f" facs="#m-67986817-4eeb-492b-877d-8ff49bcf29d5" label="lyrics-like">1L et réspice nos, et osténde no¬</l><l xml:id="m-168b8537-ef4b-4386-8448-87bcefa62a21" facs="#m-d1e69cde-11af-4269-bfb7-9407796255d3" label="lyrics-like">cognóscant te, sicut et nos cognó¬</l><l xml:id="m-3d953012-9ddf-45e8-87ee-fb03cbb84aa3" facs="#m-8f2401ba-142c-47f7-955a-d4f8eecbe086" label="lyrics-like">bis lucem miseratiónum tuárum : et</l><l xml:id="m-8e3a3439-5817-43ee-b463-ca1b54355716" facs="#m-1fb8f9ca-ad4e-42ba-babf-25e6e926d604" label="lyrics-like">vimus, quóniam non est Deus</l><l xml:id="m-959b6283-a650-434e-8754-5cc762ea110e" facs="#m-6e2030df-fdf9-4507-a610-5cc9c6e68e21" label="lyrics-like">immitte timórem tuum super gen¬</l><l xml:id="m-e684bb00-ec8e-4f23-ad32-b660510252e7" facs="#m-896135b3-d0d4-4f84-8b01-ff6e529d89d7" label="lyrics-like">praeter té, Dómine. Innova signa,</l><l xml:id="m-a06a9685-0061-45e7-9438-32fb2960ffb2" facs="#m-259ce939-3003-4f85-8d42-4683342d8d68" label="lyrics-like">tes, quae non exquisiérunt te, ut</l><l xml:id="m-73df32c6-d5a2-483c-93de-b200a382a85c" facs="#m-9fbfc83c-37ba-4208-a732-7af2859e6fd1" label="lyrics-like">et immúta mirabilia. Glorifica ma¬</l><l xml:id="m-b450c4e5-48a7-4436-b625-7ce8c4269659" facs="#m-6ab0ffa2-54fd-41cd-8171-2b4a32c2ba40" label="lyrics-like">cognóscant, quia non est Deus nisi</l><l xml:id="m-c619a26f-c8ab-47a9-8798-319ea2fc833f" facs="#m-1a9f0ea1-d517-4f44-aad9-6188bda17530" label="lyrics-like">num, et bráchium dextrum. Excita</l><l xml:id="m-6a2972f7-3482-4c59-924f-8861cb27b471" facs="#m-ea3ce65a-bc26-49d5-aad8-a60010353663" label="lyrics-like">tu, et enárrent magnália tua. Alle¬</l><l xml:id="m-69ac9873-96b9-4d0a-ac78-c7359aec9737" facs="#m-bdb5051a-4aae-4b4d-b1e4-63761821b817" label="lyrics-like">furórem, et effúnde iram. Tolle</l><l xml:id="m-98d52865-a5d0-4b8f-9463-0d3bf859a06e" facs="#m-9de6aa0e-9bde-4a52-956c-b1bc255cbafe" label="lyrics-like">va manum tuam super gentes alié¬</l><l xml:id="m-5a16cda7-a316-4157-9d64-04a60bdc5106" facs="#m-d133cdba-9759-4459-a56f-e5d646a9e832" label="lyrics-like">adversárium, et afflige inimicum.</l><l xml:id="m-39bda868-50d3-454b-8be3-1d4716dc8167" facs="#m-32dca047-4162-41a7-a9ee-3c01ba0c4154" label="lyrics-like">nas, ut videant poténtiam tuam.</l><l xml:id="m-d1036c4b-7f20-4ea7-827a-0ac3df4cc1fa" facs="#m-763bec4c-3ae2-4da1-803d-a6b672d65fd1" label="lyrics-like">Festína tempus, et meménto finis,</l><l xml:id="m-803d8d1d-49cc-41c2-a358-25bdf81ec754" facs="#m-e8c4bb8c-0db5-43a5-9acc-840918ae8061" label="lyrics-like">sicut enim in conspéctu eórum san-ut enárrent mirabilia tua, Dómine</l><l xml:id="m-93f175f2-f4fe-4ea0-8d17-dfcaf96f2383" facs="#m-58a62003-0391-4f77-9f45-8a9b987de800" label="lyrics-like">ctificátus es in nobis, sic in conspéctu! Deus noster.</l><l xml:id="m-4f1ee99c-1099-48b2-8190-cb484cc92e0d" facs="#m-29579915-e633-4420-a724-51bae3e93472" label="lyrics-like">Graduat. Dirigátur. p. 1060.</l><l xml:id="m-eb0a0368-a9fa-4297-8979-a91958e1b9e7" facs="#m-c3ffe45f-b4e4-4128-8925-96c42e873d6f" label="lyrics-like">Orémus. Flectámus génua. R. Leváte.</l><l xml:id="m-2b26cf37-6489-4d4d-9e2a-b78cd14a53c4" facs="#m-56029058-694a-48b3-a5c4-f24924a111ae" label="ambiguous">Collect.</l><l xml:id="m-c4d3016e-0f60-49c5-8ea2-0f63a0836da3" facs="#m-82b0f545-22ac-4f1e-be10-dee08fd0465e" label="lyrics-like">HCtiónes nostras, quaésumus! nostra orátio et operátio a te sem</l><l xml:id="m-c4c7f1c1-0892-4c04-b828-90d4f92adf3d" facs="#m-05652d0c-3798-4139-9a2e-5a2e8c520ab7" label="lyrics-like">H Dómine, aspirándo praéveni, et per incipiat, et per te coepta finia¬</l><l xml:id="m-b576f942-2353-48b4-9956-fc833dd2dbdd" facs="#m-f19aa607-cbb6-4f59-ae27-8e6985b49284" label="lyrics-like">adjuvándo proséquere: ut cunctal tur. Per' Dóminum.</l><l xml:id="m-8715c068-236b-4a79-81bc-ad93caf8ec13" facs="#m-e9235a58-6ae9-4ae5-9d5f-8f4868030dba" label="lyrics-like">Lesson V. In diébus illis : Angelus Dómini, and Hymn. Benedictus es.</l><l xml:id="m-44dd8717-5728-4ec7-b470-761862efeb2c" facs="#m-c1388309-5013-4fc2-ad08-7bc5cb93bc3c" label="text-like">as on Saturday in Ember weex of Advent, p. 348.</l><l xml:id="m-0d6fcaec-e88d-4a29-9bfa-e1de2e2a624d" facs="#m-617ba630-cc7e-4feb-b65a-978c5e830763" label="lyrics-like">V. Dóminus vobiscum. K. Et cum spíritu túo.</l><l xml:id="m-57045203-b36d-4dae-9e6b-07334db4c736" facs="#m-2eb7283a-a80a-4d26-9b62-11ae1eb2790f" label="lyrics-like">Collect. Deus, qui tribus púeris. p. 350.</l><l xml:id="m-d1212b9e-713a-4bea-a04b-8ceb509a7aef" facs="#m-5a1916b3-4ba0-4a1c-8f89-83309dee9b56" label="text-like">The other Collects are as on Ash Wednesday, P. 526.</l><l xml:id="m-4b2f40f1-bfef-4a3d-b709-dcd1a2594adc" facs="#m-0b348971-5a5c-4a82-bf39-e0dd55ce1c47" label="ambiguous">Lectio Epistolae beati Pauli Apostoli ad Thessalonicenses.</l><l xml:id="m-5c097f32-5618-4553-96da-3136188b96d3" facs="#m-28dd6608-0633-4e1d-b9ba-ace5cc0951fa" label="ambiguous">1. Thess. 5.</l><l xml:id="m-2a0aff8d-dea7-491d-b440-e0642a249d75" facs="#m-d9da07f3-95e4-4233-b659-b5082f1a3695" label="lyrics-like">LRatres: Rogámus vos, corrípite) in ómnibus vobis. Spíritum nolite</l><l xml:id="m-62c23033-90f7-422f-bade-845e4c1ee9da" facs="#m-c4ec6b1f-96b1-4478-8c95-718fe1023956" label="lyrics-like">T inquiétos, cersolámini pusillá-exstínguere. Prophetias nolite spér¬</l><l xml:id="m-93fc3ced-e67e-497f-a0f8-a11058e1bd3a" facs="#m-78d5b4b6-1201-4f10-9cfb-ebe1c27380a9" label="lyrics-like">nere. Ômnia autem probá̂te : quod</l><l xml:id="m-ab4827d5-28ae-481a-b23f-d67cac417279" facs="#m-c8c6f13c-5bf2-4a50-b9dd-56fe99b7ca9f" label="lyrics-like">nimes, suscipite infirmos, patiéntes</l><l xml:id="m-08816130-4fc9-4450-bda0-dfe5c5370d45" facs="#m-53803277-8a71-4b89-ac8e-94a4d398068a" label="lyrics-like">estóte ad omnes. Vidéte ne quis</l><l xml:id="m-951af64f-0048-425e-83c2-86e0dd8085f9" facs="#m-812df767-a9e2-4cb5-9ef9-37e6d1bc4aa7" label="lyrics-like">bonum est tenéte. Ab omni spécie</l><l xml:id="m-70feaf0e-cedd-4e4c-839a-192ddf338aca" facs="#m-6930fe01-dcd8-4991-819f-096bc644f976" label="lyrics-like">mala abstinéte vos. Ipse autem</l><l xml:id="m-72c45e31-dad3-477f-a39f-93a24fa1a475" facs="#m-6a4df43a-47a5-4c03-ba6e-374f4276cf4f" label="ambiguous">malum pro malo alicui reddat: sed</l><l xml:id="m-8e6cc043-5e89-49a3-b36d-ef7e9af3b77b" facs="#m-48e04a32-eda4-4250-b581-e25e3110e4b6" label="lyrics-like">Deus pacis sanctíficet vos per óm¬</l><l xml:id="m-53c2c0a5-845e-44af-a9ac-1e1c720ccc95" facs="#m-d01561c5-c74d-42c5-ba29-53d031bfa160" label="lyrics-like">semper quod bonum est sectámini</l><l xml:id="m-99eb8a0b-e4cb-4b92-9581-d30b425e7938" facs="#m-54dc2797-e1ce-4619-8a1a-5b65d09bd742" label="ambiguous">nia: ut integer spiritus vester, et</l><l xml:id="m-19fb1eec-c279-4301-a8b7-dd90456b7128" facs="#m-761d0c27-0634-497b-9b78-10687fff9363" label="ambiguous">in invicem, et in omnes. Semper</l><l xml:id="m-827e7295-7432-4630-a309-9598cbd3f55e" facs="#m-f51f7b7a-3b31-46f3-a5db-00bb8e8f86a8" label="lyrics-like">ánima, et corpus sine queréla, in</l><l xml:id="m-22b150e1-0f9a-4528-aaad-3c596d0ddd5b" facs="#m-bcdac45a-c69b-43ba-bce0-ae23e449107a" label="lyrics-like">gaudéte. Sine intermissióne oráte.</l><l xml:id="m-cd0cdd4c-e74a-4ae2-ad92-5bbf255ec3cf" facs="#m-55e62e91-dd62-4c18-8bd9-2581584301d5" label="lyrics-like">advéntu Dómini nostri Jesu Christi</l><l xml:id="m-ac58eb20-75fc-49d7-a125-395fd28e2d03" facs="#m-2afcdc0d-8e23-4c55-9b69-c403ac2fd882" label="lyrics-like">In ómnibus grátias ágite : haec est</l><l xml:id="m-9e915291-e546-4a7b-8d02-9ba3cd1cbef8" facs="#m-2dbd6452-4a6b-43c3-9054-bc7dfbc25bd2" label="lyrics-like">enim volúntas Dei in Christo Jesu servétur.</l><l xml:id="m-0c145737-c563-4e21-9371-591cbab1688b" facs="#m-ce37802d-f6d1-4f94-a119-18c84d057695" label="lyrics-like">Tract. Laudáte Dóminum. P. 760.</l><l xml:id="m-f93356c9-11ce-4306-86f3-e2565855061c" facs="#m-e2d403f6-f4c2-4163-a9f5-ff138975fbd4" label="lyrics-like">Gospel. Assúmpsit Jesus. as on 2nd Sunday of Lent, p. 548.</l></lg></div></section></score></mdiv></body></music>
</mei>