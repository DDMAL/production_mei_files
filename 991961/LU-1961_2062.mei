      <graphic xml:id="m-b7368a3a-52f0-4c9d-a4d4-0ef587e85087" target="2062_original_image.tiff" /><zone xml:id="m-f8aa288b-a0ad-41c5-b472-f7be612349ca" ulx="107" uly="89" lrx="178" lry="119" /><zone xml:id="m-c29d975a-f332-4f3a-b2f2-edb0bac9ecc6" ulx="391" uly="90" lrx="688" lry="121" /><zone xml:id="m-278a1b85-d32d-4f21-8608-516a808d3829" ulx="130" uly="138" lrx="974" lry="166" /><zone xml:id="m-10ec3a94-ed91-41f6-82ef-bc97e276fe3a" ulx="107" uly="160" lrx="974" lry="189" /><zone xml:id="m-68d482d8-e4d3-4942-9160-2d79cd75e470" ulx="107" uly="185" lrx="973" lry="219" /><zone xml:id="m-d7ff0388-868a-414c-9a0f-af78a04957dc" ulx="106" uly="209" lrx="393" lry="243" /><zone xml:id="m-9065866f-22ad-41e2-a799-d4f2b95b318d" ulx="133" uly="233" lrx="974" lry="269" /><zone xml:id="m-03026d7d-3e61-4cf4-b456-960c630fa540" ulx="107" uly="267" lrx="974" lry="299" /><zone xml:id="m-c8ea810e-9ef7-4c4f-bd82-62b656cbebff" ulx="487" uly="297" lrx="593" lry="325" /><zone xml:id="m-1c3b002b-2547-4a64-9e2a-cc95a2ad3fc1" ulx="150" uly="320" lrx="974" lry="355" /><zone xml:id="m-b1a5c9d8-9e8e-4d2d-b22b-4d1c794f5817" ulx="110" uly="350" lrx="974" lry="386" /><zone xml:id="m-2988c812-0ce4-4b36-b84c-d88ba9a9449e" ulx="108" uly="379" lrx="533" lry="409" /><zone xml:id="m-382bacc9-e87b-41fc-b16b-96020a37b38a" ulx="542" uly="384" lrx="974" lry="411" /><zone xml:id="m-cbc6aafc-ed46-4657-9c14-369aef057f15" ulx="108" uly="403" lrx="972" lry="443" /><zone xml:id="m-776fdaab-83a4-4951-a840-76c9c0b8b367" ulx="492" uly="443" lrx="587" lry="468" /><zone xml:id="m-74035617-f6b2-4d19-84b0-eab239999624" ulx="160" uly="465" lrx="974" lry="503" /><zone xml:id="m-1b336a61-8c96-40b7-959a-9f3195fc091b" ulx="110" uly="498" lrx="974" lry="531" /><zone xml:id="m-781967d9-98fa-46f2-8c71-664410a3a306" ulx="108" uly="521" lrx="846" lry="559" /><zone xml:id="m-d436adaa-a0d7-47e9-85fc-4ad57457bc8f" ulx="424" uly="552" lrx="662" lry="586" /><zone xml:id="m-e05225f3-c011-4db8-9331-1587e2cfd06b" ulx="120" uly="578" lrx="