/><zone xml:id="m-80336f81-bb1d-4de1-91c4-c04b16ec9955" ulx="24" uly="610" lrx="877" lry="642" /><zone xml:id="m-f4ed0d6e-297b-4ced-b9b6-f2369aca66ff" ulx="24" uly="629" lrx="649" lry="666" /><zone xml:id="m-5b1735d7-4290-4a5f-8215-b909eb52dfae" ulx="48" uly="662" lrx="877" lry="697" /><zone xml:id="m-cac693ce-95d0-4068-b95f-84b2fa45513e" ulx="26" uly="683" lrx="305" lry="718" /><zone xml:id="m-3aa564d1-b496-4314-8064-e3b03cd366a0" ulx="49" uly="713" lrx="370" lry="747" /><zone xml:id="m-dcd1a725-ad15-478a-9864-0fbada2be14d" ulx="128" uly="754" lrx="245" lry="787" /><zone xml:id="m-0ebcae76-03c6-4e2c-87f6-ecf34ed8cc52" ulx="678" uly="755" lrx="772" lry="788" /><zone xml:id="m-a76e4a59-2788-434a-90e6-af2281b79ecb" ulx="61" uly="784" lrx="877" lry="826" /><zone xml:id="m-10bc3445-e997-48b2-9b95-a8df0e7dc0c1" ulx="26" uly="814" lrx="446" lry="851" /><zone xml:id="m-20ae6818-85bf-4f26-8275-722916bca401" ulx="457" uly="815" lrx="876" lry="849" /><zone xml:id="m-af6a680e-11a8-408f-b5a7-5fd432283843" ulx="456" uly="843" lrx="510" lry="876" /><zone xml:id="m-e9bbb5ac-414d-42ee-a6cc-8379d118a095" ulx="24" uly="844" lrx="447" lry="874" /><zone xml:id="m-3121c3c9-e781-4733-a625-c5f76595058c" ulx="24" uly="872" lrx="443" lry="900" /><zone xml:id="m-00c02b59-aca5-45c2-8b33-71294f6c4b66" ulx="491" uly="882" lrx="878" lry="919" /><zone xml:id="m-cdcd57d9-ef37-4241-acf1-193270659ddd" ulx="24" uly="898" lrx="412" lry="932" /><zone xml:id="m-695c57d3-4d24-4e3e-969c-28778d796430" ulx="460" uly="907" lrx="878" lry="944" /><zone xml:id="m-85624b63-4eb4-4d28-a21b-707cedc4fcff" ulx="56" uly="932" lrx="445" lry="975" /><zone xml:id="m-da0b5032-58b8-4830-a71c-8efbea9d444f" ulx="457" uly="935" lrx="878" lry="971" /><zone xml:id="m-6b2e6ca5-dc78-4691-9850-c21dd2b6960d" ulx="457" uly="961" lrx="878" lry="995" /><zone xml:id="m-030ac9f3-86d7-432f-9781-dc94fb669441" ulx="24" uly="962" lrx="445" lry="997" /><zone xml:id="m-9478174c-6930-4573-8bc7-1c6ab303dfdf" ulx="24" uly="989" lrx="446" lry="1021" /><zone xml:id="m-87519349-637a-4b6a-8dff-9f201f402426" ulx="456" uly="989" lrx="877" lry="1024" /><zone xml:id="m-fe908a25-5e36-4db4-8ab0-3b476b166f23" ulx="25" uly="1018" lrx="447" lry="1052" /><zone xml:id="m-dc8f38bc-ce51-4fa3-b910-e748fc13c1b8" ulx="457" uly="1019" lrx="878" lry="1050" /><zone xml:id="m-9ba2d227-54bd-41d4-9213-122cedde88d3" ulx="456" uly="1040" lrx="876" lry="1075" /><zone xml:id="m-e4959231-faae-44c9-87fd-c378bb1773d2" ulx="24" uly="1044" lrx="446" lry="1076" /><zone xml:id="m-dc944b38-46f3-49c2-9d74-8ba45b69454f" ulx="24" uly="1072" lrx="448" lry="1103" /><zone xml:id="m-2b1e278a-bd9e-4f49-80a0-fe3813efae35" ulx="453" uly="1075" lrx="786" lry="1110" /><zone xml:id="m-3b269ba5-5cdd-4236-919e-546d5f713bb8" ulx="27" uly="1095" lrx="452" lry="1130" /><zone xml:id="m-59d85c21-c374-4549-badc-358eb073eaf8" ulx="50" uly="1136" lrx="540" lry="1172" /><zone xml:id="m-0b7e0d83-71e8-4b9a-b075-78dfa13cbd0f" ulx="50" uly="1164" lrx="412" lry="1204" /><zone xml:id="m-1cb1d5c8-f6db-4ff0-97ff-a969f4a5457c" ulx="52" uly="1201" lrx="630" lry="1234" /><zone xml:id="m-c9b27eff-3334-406f-96f3-447ae1b12474" ulx="49" uly="1239" lrx="877" lry="1276" /><zone xml:id="m-e8833446-607a-4399-b212-a307e71d9abe" ulx="24" uly="1264" lrx="636" lry="1300" /><zone xml:id="m-4840869a-115d-45b8-bb62-0cdaa3b30d31" ulx="47" uly="1295" lrx="439" lry="1329" /><zone xml:id="m-9a2a0ffe-4df4-4765-8a09-6574458cf800" ulx="50" uly="1330" lrx="583" lry="1364" /><zone xml:id="m-1d86ae63-1911-4d4e-87ed-05df710d286d" ulx="50" uly="1359" lrx="443" lry="1392" /><zone xml:id="m-4c7ad6ac-3d02-4e9a-ad00-1a67da85a4ef" ulx="51" uly="1388" lrx="805" lry="1431" /><zone xml:id="m-42ac04ab-d5ba-489f-97b9-80960683f05c" ulx="51" uly="1420" lrx="659" lry="1458" /><zone xml:id="m-ea081cc6-0280-4b3e-8fe7-a3d653fd8a8a" ulx="52" uly="1452" lrx="472" lry="1490" /><zone xml:id="m-c16d1072-207f-4a99-9d7b-5cc84ed9ca16" ulx="52" uly="1480" lrx="873" lry="1523" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-b1988402-570f-4b58-97de-d9aefb55dc5b" n="2089" facs="#m-ca26a3ba-e84b-45e4-9892-76cd86557afe" /><div xml:id="m-3fdda85e-3cfe-450e-b827-3c1612d5ab23">
            <lg xml:id="m-6a54267d-2151-401e-a867-0db8a8d0fa4e">
              <l xml:id="m-7c02bb47-1bbe-4f9a-9c21-765d7ceb858c" facs="#m-3546ec7c-a720-4f03-a636-03d48f5df003" label="text-like">The Pastoral Visit.</l><l xml:id="m-a7dc983c-305e-46b5-80c2-332c6f3e0f96" facs="#m-4693f9fe-b61f-4107-bd9d-a6bdd6943506" label="ambiguous">1843</l><l xml:id="m-97c0a729-4deb-40e4-b92a-fdecfdca595a" facs="#m-6cc511b2-3143-4b60-a05d-e7e97c8dd983" label="text-like">During the Pater, the Bishop sprinkles holy water and incenses three</l><l xml:id="m-6246b973-364c-4365-b063-81c53cea0ac5" facs="#m-9db1517d-6b3d-406f-a668-7bb9df0477ba" label="text-like">times; he then says the following Versicles:</l><l xml:id="m-abadb17e-a421-438e-a5aa-4ac210fed4d5" facs="#m-fb269883-a32d-4fc6-a9d2-93ef8ba474a4" label="lyrics-like">V. Et ne nos indúcas in tentatiónem. K. Sed líbera nos a málo.</l><l xml:id="m-af31a514-7bc8-4b37-9ae6-1ecde3ee04cc" facs="#m-798d7ccb-2f61-4c45-96d6-daa1223e3652" label="lyrics-like">V. In memória aetérna érunt jústi.</l><l xml:id="m-3c61ece8-fa5a-4840-b9cf-cba4f20a2720" facs="#m-909a90c1-9dd5-4f89-a1fc-f6028285925d" label="lyrics-like">R. Ab auditióne mála non timébunt.</l><l xml:id="m-345449a8-d870-49bb-b75f-6d37202775fb" facs="#m-cf38c363-94fe-4e85-9ed2-7c8d71dc03df" label="lyrics-like">V. A pórta inferi. H. Erue Dómine ánimas eórum.</l><l xml:id="m-141ba6cb-4159-4cd3-a61e-bc8aff3c2a6d" facs="#m-82c3e355-5c06-4270-a95f-0dadd621f720" label="lyrics-like">v. Réquiem aetérnam dóna éis Dómine.</l><l xml:id="m-01bfd53b-0b4e-4539-976a-f1453feabcda" facs="#m-337d01d2-87d4-4ae0-a14e-6c779983557b" label="lyrics-like">K. Et lux perpétua lúceat éis.</l><l xml:id="m-b0a9ba1d-1e28-4029-9a9f-db16f8ce80d8" facs="#m-301d566d-a1ba-45a3-9fed-d31b9f48de22" label="lyrics-like">V. Dómine exáudi oratiónem méam. B. Et clámor méus ad te véniat.</l><l xml:id="m-a2df6b60-8061-4277-88fd-18de12602f52" facs="#m-2ac073f1-d490-4e3b-9576-acb31b959e83" label="lyrics-like">V. Dóminus vobiscum. B. Et cum spíritu túo.</l><l xml:id="m-765f8b8f-ce95-4053-be51-d48ff73633a1" facs="#m-9c6cf105-5c27-4138-bf9d-5c5c7e514232" label="lyrics-like">Orémus.</l><l xml:id="m-09584872-a87e-4c2a-828e-2bded43ac714" facs="#m-672f7882-a868-43d3-adec-dcfb7a815d6d" label="text-like">Prayer.</l><l xml:id="m-c7093700-0b6d-41bb-8395-37ae88e6d794" facs="#m-96a05e48-1686-428f-adde-511b529f427b" label="lyrics-like">Eus, qui inter Apostólicos sa- perpétuo aggregénturconsórtio. Per</l><l xml:id="m-cfb92f75-24f0-4c41-a5ac-9ce0d4c9e1cd" facs="#m-f012baf4-523a-4f89-9b55-1a8a2699ea66" label="lyrics-like">cerdótes fámulos tuos pontifi-lChristum Bóminum nostrum.</l><l xml:id="m-ed96beb7-c83a-40a7-b845-064d6d8049cd" facs="#m-c9934824-cad0-4ef3-adb6-de3e4c3688d3" label="ambiguous">R. Amen.</l><l xml:id="m-53b604b7-a22f-4a2e-9785-f065a2303905" facs="#m-8dd4c3c7-cda8-4d39-94f1-9af3ac3ba5a0" label="lyrics-like">cáli fecísti dignitâte vigére : prae¬</l><l xml:id="m-a3c1d199-a83a-4b8d-b4be-bd91c0312c5f" facs="#m-e055ca9a-446c-4d59-ae64-aec5392b2305" label="lyrics-like">sta, quaésumus; ut eórum quoque</l><l xml:id="m-e872c4b2-abc2-481e-be70-6834a47bea9f" facs="#m-1a4ca7ba-dc07-4401-b76e-766a008a1928" label="text-like">A procession is then formed and goes to the cemetery, singing the Respon¬</l><l xml:id="m-88d58382-adac-43fa-b774-d7b4a560e5bd" facs="#m-80336f81-bb1d-4de1-91c4-c04b16ec9955" label="lyrics-like">sory Qui Lázarum. 1786. during which the Bishop recites, with his assistants,</l><l xml:id="m-30798fa3-c165-4c4a-94fd-416c17ee878a" facs="#m-f4ed0d6e-297b-4ced-b9b6-f2369aca66ff" label="lyrics-like">the Ant. Si iniquitátes. and the Ps. De profúndis. p. 1763.</l><l xml:id="m-753e4d17-dfcc-42f3-8c14-171aa79297c4" facs="#m-5b1735d7-4290-4a5f-8215-b909eb52dfae" label="text-like">In the middle of the cemetery, the Responsory Libera. is sung, p. 1767.</l><l xml:id="m-72624ea1-ba13-41d0-b59f-f830b9fa4d1e" facs="#m-cac693ce-95d0-4068-b95f-84b2fa45513e" label="lyrics-like">Then : Kyrie eléison. etc.</l><l xml:id="m-ea6e7f29-4eef-4e1b-85fa-17e64b6d98e2" facs="#m-3aa564d1-b496-4314-8064-e3b03cd366a0" label="lyrics-like">Páter nóster. etc. as above.</l><l xml:id="m-37c2dd82-f92e-4a12-bbd6-83ee11686914" facs="#m-dcd1a725-ad15-478a-9864-0fbada2be14d" label="lyrics-like">Orémus.</l><l xml:id="m-dfa6f054-7184-45c3-9ff9-bb163e4071f1" facs="#m-0ebcae76-03c6-4e2c-87f6-ecf34ed8cc52" label="text-like">Prayer.</l><l xml:id="m-b4362a64-0930-49ba-b697-e0b3af0a18c1" facs="#m-a76e4a59-2788-434a-90e6-af2281b79ecb" label="lyrics-like">Eus, qui inter Apostólicos sa- Sanctis tuis, ad perpétuae beatitú¬</l><l xml:id="m-3829d6e3-fbc3-4a95-bc8f-0e7e7f3b3dfa" facs="#m-10bc3445-e997-48b2-9b95-a8df0e7dc0c1" label="lyrics-like">cerdótes fámulos tuos sacerdo¬</l><l xml:id="m-7c30ed2d-0c19-4577-a8e9-60edaf963164" facs="#m-20ae6818-85bf-4f26-8275-722916bca401" label="lyrics-like">dinis consórtium pervenire concé¬</l><l xml:id="m-4f360f7c-1cb6-4a42-8797-39b90f4f8264" facs="#m-af6a680e-11a8-408f-b5a7-5fd432283843" label="ambiguous">das.</l><l xml:id="m-97cf1426-99b2-4d70-a6d4-c80480d43ed0" facs="#m-e9bbb5ac-414d-42ee-a6cc-8379d118a095" label="lyrics-like">táli fecísti dignitáte vigére :t prae¬</l><l xml:id="m-df0a67b3-b7c5-4489-bba3-1fc2a6ea790b" facs="#m-3121c3c9-e781-4733-a625-c5f76595058c" label="lyrics-like">sta quaésumus; * ut eórum quoque</l><l xml:id="m-64369a4e-63b4-4f27-b411-64fae47b45b0" facs="#m-00c02b59-aca5-45c2-8b33-71294f6c4b66" label="lyrics-like">Eus, cujus miseratióne ánimae</l><l xml:id="m-9275d9e0-585e-41e3-a949-34d34d4b0999" facs="#m-cdcd57d9-ef37-4241-acf1-193270659ddd" label="lyrics-like">perpétuo aggregéntur consórtio.</l><l xml:id="m-596a126f-33dd-4763-9637-c0d2d1ee723b" facs="#m-695c57d3-4d24-4e3e-969c-28778d796430" label="lyrics-like">U fidélium requiéscunt : t fámulis</l><l xml:id="m-63a4cbb7-2d9f-4eb9-8c5a-e7b30d126524" facs="#m-85624b63-4eb4-4d28-a21b-707cedc4fcff" label="lyrics-like">LEus, véniae largitor, et humá¬</l><l xml:id="m-c78b5644-b05a-4e4e-8a8b-1e1e2960d6f0" facs="#m-da0b5032-58b8-4830-a71c-8efbea9d444f" label="lyrics-like">et famulábus tuis ómnibus, hic et</l><l xml:id="m-8e6218fe-578e-4091-baea-2f746e35f81b" facs="#m-6b2e6ca5-dc78-4691-9850-c21dd2b6960d" label="lyrics-like">ubique in Christo quiescéntibus, da</l><l xml:id="m-81cdcf4f-7b17-41db-afc5-8c61b214a569" facs="#m-030ac9f3-86d7-432f-9781-dc94fb669441" label="lyrics-like">U nae salútis amátor : t quaésu¬</l><l xml:id="m-1135d8ad-2bd5-42a2-a5a6-7077e33292fb" facs="#m-9478174c-6930-4573-8bc7-1c6ab303dfdf" label="lyrics-like">mus cleméntiam tuam, ut nostrae</l><l xml:id="m-5cda2b2b-0a5a-4860-98b3-147ed83b4468" facs="#m-87519349-637a-4b6a-8dff-9f201f402426" label="lyrics-like">propitius véniam peccatórum;*ut a</l><l xml:id="m-af05aecc-06ae-4a90-b4a3-55affd500e77" facs="#m-fe908a25-5e36-4db4-8ab0-3b476b166f23" label="lyrics-like">congregatiónis fratres, propínquos</l><l xml:id="m-240f7a95-e179-48e4-bef6-b04124057e63" facs="#m-dc8f38bc-ce51-4fa3-b910-e748fc13c1b8" label="lyrics-like">cunctis reátibus absolúti, tecum sine</l><l xml:id="m-8d58a1a4-af9e-4870-8711-d20b5f4e91cb" facs="#m-9ba2d227-54bd-41d4-9213-122cedde88d3" label="lyrics-like">fine laeténtur. Per Christum Dó¬</l><l xml:id="m-fd7dfce9-385e-4c88-9a81-47b4abc76581" facs="#m-e4959231-faae-44c9-87fd-c378bb1773d2" label="lyrics-like">et benefactóres, qui ex hoc saéculo</l><l xml:id="m-e2505de4-1888-4ad9-9b0c-a9a264f7da91" facs="#m-dc944b38-46f3-49c2-9d74-8ba45b69454f" label="lyrics-like">transiérunt, * beáta Maria semper</l><l xml:id="m-096f23bb-4a13-4762-b116-b0fe0b85cb17" facs="#m-2b1e278a-bd9e-4f49-80a0-fe3813efae35" label="ambiguous">minum nostrum. B. Amen.</l><l xml:id="m-bd3eba99-86c2-46d6-9d1a-e6df45685c56" facs="#m-3b269ba5-5cdd-4236-919e-546d5f713bb8" label="lyrics-like">Virgine intercedénte, cum ómnibus</l><l xml:id="m-89f76687-424d-4b5d-9f01-b0a53c05cd38" facs="#m-59d85c21-c374-4549-badc-358eb073eaf8" label="lyrics-like">V. Réquiem aetérnam dóna éis Dómine.</l><l xml:id="m-d74bbee2-1c0f-48cc-9df3-fa23d342886a" facs="#m-0b7e0d83-71e8-4b9a-b075-78dfa13cbd0f" label="lyrics-like">B. Et lux perpétua lúceat éis.</l><l xml:id="m-e1ca00d1-8d3f-413c-af61-1407b0d23d92" facs="#m-1cb1d5c8-f6db-4ff0-97ff-a969f4a5457c" label="lyrics-like">The Cantors : V. Requiéscant in pâce. R. Amen.</l><l xml:id="m-ea3c7256-3d88-4a8c-9aee-4d36a3d60685" facs="#m-c9b27eff-3334-406f-96f3-447ae1b12474" label="lyrics-like">On the way back to the church, the Ps. Miserére. p. 1763, is recited with</l><l xml:id="m-37d5ae4f-e434-4607-996f-aefcf0b41d7d" facs="#m-e8833446-607a-4399-b212-a307e71d9abe" label="lyrics-like">Réquiem aetérnam. at the end. This psalm is not sung.</l><l xml:id="m-07dd3033-60c1-467c-aec9-7d272f0a6d57" facs="#m-4840869a-115d-45b8-bb62-0cdaa3b30d31" label="text-like">Before the Altar, the Bishop says:</l><l xml:id="m-b43c9acf-1fe5-443f-a261-c6edcfe88f62" facs="#m-9a2a0ffe-4df4-4765-8a09-6574458cf800" label="lyrics-like">Kyrie eléison. Christe eléison. Kyrie eléison.</l><l xml:id="m-f1b092b7-5d49-4a8e-8b96-4147b28560c4" facs="#m-1d86ae63-1911-4d4e-87ed-05df710d286d" label="lyrics-like">Páter nóster. continued in silence.</l><l xml:id="m-3ee011ef-a1f9-41c6-b98a-098aea4f97c8" facs="#m-4c7ad6ac-3d02-4e9a-ad00-1a67da85a4ef" label="lyrics-like">V. Et ne nos indúcas in tentatiónem. K. Sed libera nos a málo.</l><l xml:id="m-ee1e0f0b-6719-4119-9efc-f80c830d01c3" facs="#m-42ac04ab-d5ba-489f-97b9-80960683f05c" label="lyrics-like">V. A pórta inferi. K. Erue Dómine ánimas eórum.</l><l xml:id="m-de867bc8-76bb-4fed-8b9f-40f2aa5ff414" facs="#m-ea081cc6-0280-4b3e-8fe7-a3d653fd8a8a" label="lyrics-like">V. Requiéscant in páce. B. Amen.</l><l xml:id="m-e8dc0e46-43a9-4090-8cbe-6c2e23d91792" facs="#m-c16d1072-207f-4a99-9d7b-5cc84ed9ca16" label="lyrics-like">V. Dómine exáudi oratiónem méam. H. Et clámor méus ad te véniat.</l></lg></div></section></score></mdiv></body></music>
</mei>