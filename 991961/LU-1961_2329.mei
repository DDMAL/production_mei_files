="1083" /><zone xml:id="m-060c3230-c705-4954-b9ec-499641541c4e" ulx="49" uly="1075" lrx="847" lry="1109" /><zone xml:id="m-2a3cfe12-443e-4f77-aaa6-6073f6974faf" ulx="44" uly="1102" lrx="443" lry="1138" /><zone xml:id="m-6d788020-8db6-430c-a8cf-e8807e0f9484" ulx="449" uly="1104" lrx="849" lry="1139" /><zone xml:id="m-eedc219b-53ef-4e65-9490-a2e11fda1648" ulx="45" uly="1127" lrx="843" lry="1164" /><zone xml:id="m-308c8799-cd2e-465f-af85-f8f48035be6e" ulx="404" uly="1174" lrx="490" lry="1203" /><zone xml:id="m-00ce8e3b-64be-41c2-952a-bfedf8d611b1" ulx="60" uly="1201" lrx="845" lry="1242" /><zone xml:id="m-960d7bd7-f4fa-4f25-8f97-8c345341e703" ulx="42" uly="1232" lrx="442" lry="1267" /><zone xml:id="m-a7f86c57-d5d2-4a64-bff3-d70fd96ed292" ulx="447" uly="1232" lrx="846" lry="1268" /><zone xml:id="m-80c8b0c3-6bb3-49c0-abf9-0933c82f4698" ulx="45" uly="1259" lrx="845" lry="1291" /><zone xml:id="m-1b5ae4f3-2bf4-4d72-9ffa-caf5778ed1b5" ulx="42" uly="1287" lrx="739" lry="1323" /><zone xml:id="m-cb84129b-c9eb-4251-8611-2c8bf265ab12" ulx="339" uly="1332" lrx="554" lry="1363" /><zone xml:id="m-18b9c3ee-0836-45d7-9e1f-98cfea2d83d6" ulx="54" uly="1361" lrx="843" lry="1398" /><zone xml:id="m-232baae0-80c3-40d5-834c-2c908dd26bf5" ulx="46" uly="1391" lrx="437" lry="1426" /><zone xml:id="m-364ba1a0-3dd1-43cd-86fe-d008a53f9dcf" ulx="448" uly="1396" lrx="846" lry="1421" /><zone xml:id="m-8d854e96-a2e9-4405-859c-4a6d7b2227f5" ulx="42" uly="1416" lrx="844" lry="1452" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-755e5c40-1a39-42d3-951d-34880d7c50cb" n="2329" facs="#m-2221f0d1-e155-45aa-af3d-58a2630aa312" /><div xml:id="m-b2230579-29c7-4317-9bc4-8707b20540c6">
            <lg xml:id="m-3639f8da-54f0-4855-b2a9-9386204c7ada">
              <l xml:id="m-d8f33c34-bea0-4bcc-9a20-93728d60499c" facs="#m-2cc93bb8-7bf4-4876-91d1-4563b73c059e" label="ambiguous">November3: Bd Martin Porres</l><l xml:id="m-91ba7f3c-37c7-41fe-ae8c-f76ff0625280" facs="#m-cdf14e98-0253-4a19-be9b-65fefcdb1c67" label="ambiguous">(67)</l><l xml:id="m-b2369573-e8da-47de-8734-e1c609dcaf47" facs="#m-75836915-5aba-498c-b7ab-5b2b9f9e6eb9" label="ambiguous">OCTOBER 21</l><l xml:id="m-710e6c0f-883a-4c91-8cd0-f0fd65c83339" facs="#m-9f90a893-d3c8-4513-8f64-44276c6e0500" label="text-like">St. Ursula and Companions, Virgins and Martyrs</l><l xml:id="m-8f4d3a78-963d-4e41-86ae-9426008a99a8" facs="#m-b97743fa-b9ae-4501-b344-5b66cca29f2c" label="lyrics-like">Mass. Loquébar. p. 1215, except : Collect, Secret, Postcommunion.</l><l xml:id="m-875257e3-be5a-413d-a39a-a923ea30032b" facs="#m-52c324db-6e38-4b59-8683-628accd9f9c5" label="ambiguous">p. 1698.</l><l xml:id="m-d939b132-a135-4943-92d0-122510df3557" facs="#m-35c15956-172c-4489-9c91-e2d844081379" label="text-like">In the diocese of Portland</l><l xml:id="m-9dbb3760-861a-49a7-b933-44952fbea731" facs="#m-ed32d813-5632-461d-aec9-08f1e49dd081" label="lyrics-like">Introit. Me exspectavérunt. p. 1220.</l><l xml:id="m-27fc8c9a-e2b9-4b0a-bc00-a2cf522d9c4f" facs="#m-3a5c159c-eda9-46f0-8be2-b2163bdcb3aa" label="ambiguous">Collect, Secret, Postcommunion. p. 1698.</l><l xml:id="m-6e916175-17cb-4b61-b7bd-d1bea9cf8a88" facs="#m-9807333d-2dad-4063-a885-1f6d5766680a" label="ambiguous">Epistle. De virginibus. p. 1230.</l><l xml:id="m-e5676dd2-376e-4134-b8ea-620d161e2a3a" facs="#m-d0dece1a-60ff-4362-a018-7e8a6748bf42" label="lyrics-like">Fron the Gradual onwards, al in the Mass: Loquébar.</l><l xml:id="m-a1db8843-901c-4cd5-8620-2543ef822db6" facs="#m-298fab59-b30c-4e95-bf9e-70cd1eee091b" label="ambiguous">p. 1216.</l><l xml:id="m-179a690b-5fa1-421d-ba02-271fefd4f4ba" facs="#m-dddfa8b3-30dc-4a4b-b6aa-a35652dff48e" label="ambiguous">NOVEMBER 3 (</l><l xml:id="m-c0750bf4-d86f-4a42-aa03-d67a184bd8ac" facs="#m-0e5e3820-be63-43e7-b08c-da89b297740d" label="ambiguous">Bd Martin Porres, Confessor</l><l xml:id="m-87c8c3b9-e36a-4ae1-8818-da7e9bf3a987" facs="#m-32ba9aa0-a1ea-476d-972b-cc977e78b742" label="ambiguous">In some dioceses</l><l xml:id="m-51494fb4-6bab-48d0-aef2-5411ba459633" facs="#m-22d5a88b-7e6b-4466-b5cb-ba23117dc590" label="text-like">Nov. 5, in the archdiocese of New-Orleans and e oceses</l><l xml:id="m-1d72dc64-fe3d-4d34-aaf0-35134ce348e3" facs="#m-e3625aa5-10dd-4c70-a346-2d54649ff975" label="text-like">of Lafayette and Naichez.</l><l xml:id="m-d3e3d38e-8d06-4c83-beeb-c989c6a67200" facs="#m-629751c8-f30d-41fb-98d9-e3b3c4ccad23" label="lyrics-like">Mass. Jústus ut pálma. p. 1204, except the Prayers:</l><l xml:id="m-931ad620-be21-4cb1-8bce-41277d5c132f" facs="#m-28425c9f-cde3-492f-a7a9-e6536e84749f" label="ambiguous">Collect</l><l xml:id="m-626e3b92-9438-4b37-80e4-29dcaf20d83e" facs="#m-50be92e4-4e2d-4c6e-b797-9f19efb2009c" label="lyrics-like">Eus, humilium celsitúdo, qui lintercessióne concéde. nos ejus</l><l xml:id="m-e1a177ac-23a2-483c-ace5-462490f54a49" facs="#m-060c3230-c705-4954-b9ec-499641541c4e" label="lyrics-like">U beátum Martinum Confessó-hmilitátem ita imitári in ter¬</l><l xml:id="m-0abb4008-5994-41a1-8c6b-661a2b1e076c" facs="#m-2a3cfe12-443e-4f77-aaa6-6073f6974faf" label="lyrics-like">rem tuum ad caeléstia regna</l><l xml:id="m-1e23f371-944a-4c39-a0bf-cc2b628d1ad3" facs="#m-6d788020-8db6-430c-a8cf-e8807e0f9484" label="lyrics-like">ris; * ut cum ipso exaltári me¬</l><l xml:id="m-b8512ce0-1f72-418c-ac5e-799943751f53" facs="#m-eedc219b-53ef-4e65-9490-a2e11fda1648" label="lyrics-like">transire fecisti : :ejus méritis et reámur in caelis. Per Dóminum.</l><l xml:id="m-7d24d85f-4b00-4103-b297-1941b0fc125a" facs="#m-308c8799-cd2e-465f-af85-f8f48035be6e" label="ambiguous">Secret</l><l xml:id="m-f80463ef-4ce3-4120-a564-4cf9ed38550a" facs="#m-00ce8e3b-64be-41c2-952a-bfedf8d611b1" label="lyrics-like">z Anc hóstiam, Dómine, quam sta; ut ejus pia intercessióne</l><l xml:id="m-4d028ad7-7077-49ef-a63f-1ada002b8e83" facs="#m-960d7bd7-f4fa-4f25-8f97-8c345341e703" label="lyrics-like">1t tibi in honórem beáti Marti¬</l><l xml:id="m-203f78c7-750a-4718-abfe-55261c50f48e" facs="#m-a7f86c57-d5d2-4a64-bff3-d70fd96ed292" label="lyrics-like">nobis efféctum tuae salvatiónis</l><l xml:id="m-122454b7-9e0f-4f1f-ae79-eda3c9b0495a" facs="#m-80c8b0c3-6bb3-49c0-abf9-0933c82f4698" label="lyrics-like">ni Confessóris sacrándam offéri-impéndat. Per Dóminum no¬</l><l xml:id="m-0f54dbcc-74a1-421e-876d-a022f8ef9749" facs="#m-1b5ae4f3-2bf4-4d72-9ffa-caf5778ed1b5" label="lyrics-like">mus, benignus súscipe, et prae- strum Jesum Christum.</l><l xml:id="m-b3a93bf6-ebac-4762-8482-3495057f27ef" facs="#m-cb84129b-c9eb-4251-8611-2c8bf265ab12" label="ambiguous">Postcommunion</l><l xml:id="m-1695df81-150a-471a-8566-afe5ec764da5" facs="#m-18b9c3ee-0836-45d7-9e1f-98cfea2d83d6" label="lyrics-like">(Aeléstibus aliméntis enutriti ! Martino Confessóre pro nobis</l><l xml:id="m-8f96ec61-8f38-45d1-be02-9707edb2b6f5" facs="#m-232baae0-80c3-40d5-834c-2c908dd26bf5" label="lyrics-like">U súpplices te rogámus, Dó¬</l><l xml:id="m-54ed02aa-70d6-4e27-a76d-0d7e56617c74" facs="#m-364ba1a0-3dd1-43cd-86fe-d008a53f9dcf" label="lyrics-like">intercedénte, tuis semper valeá¬</l><l xml:id="m-bcc8a7aa-d892-4b15-8f61-c718131c9a5f" facs="#m-8d854e96-a2e9-4405-859c-4a6d7b2227f5" label="lyrics-like">mine Deus noster: ut beáto mus obedire mandátis. Per Dñm.</l></lg></div></section></score></mdiv></body></music>
</mei>