                    <nc xml:id="m-33f907c4-3f93-4ac6-a992-93aee371f22f" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-f373d652-25c8-4834-84e0-88ce8718f396">
                  <syl /><neume facs="#m-086f0163-aa75-45f4-9ce0-e1b475ffface" type="punctum" xml:id="m-f5fc3ab8-d5c4-4a18-8e33-8caff85bdbef">
                    <nc xml:id="m-83808c66-2562-4254-9fc1-d6fc45cb1d72" pname="g" oct="3">
                      <signifLet xml:id="m-0eba0b4a-064e-44ab-b031-7df6c12b3571" />
                    </nc>
                  </neume>
                </syllable>
                <syllable xml:id="m-e2e595ee-7290-480b-9239-e8190e1498f6">
                  <syl /><neume facs="#m-fafd7021-6bdc-4ee6-a784-4af901c88175" type="punctum" xml:id="m-3c0542af-e5ca-4f7f-847b-8bee7cd21f23">
                    <nc xml:id="m-9bb3138b-c737-45e0-95d3-3f659c31683b" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-ec811027-0f74-40a9-9387-22a0b4dd04b4">
                  <syl /><neume facs="#m-6bbf31a8-d411-4064-85c0-f00cf2006554" type="punctum" xml:id="m-d707f7fd-2e33-4c8d-ae1b-f8375ab16686">
                    <nc xml:id="m-5b23a486-654e-4052-90c6-154aa5ae88e0" pname="a" oct="3" />
