                  <syl /><neume facs="#m-6024a8d1-5ba7-48b8-a4d4-72cd1e7035fd" type="punctum" xml:id="m-18f9205b-ee89-4b2a-976b-8bb54484cc36">
                    <nc xml:id="m-1cd69a87-123f-4054-bed9-c4597d98e764" pname="a" oct="3"><episema xml:id="m-7894b8bd-670c-4679-87d6-a047000b00cf" form="v" /></nc>
                  </neume>
