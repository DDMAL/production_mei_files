                <syllable xml:id="m-84243133-ab26-473b-bdd4-15d83e34e3fc">
                  <syl /><neume facs="#m-db0d93f0-ffce-4921-8a1d-e52f1ea5dda4" type="punctum" xml:id="m-ca7b5492-3708-48cf-b558-66bde3494dc6">
                    <nc xml:id="m-f071d42d-022c-4887-9b08-cbbc236ae0e5" pname="b" oct="3" />
