" lry="732" /><zone xml:id="m-3d20c840-a9f2-4568-ae8a-56a43b2a153a" ulx="482" uly="705" lrx="915" lry="734" /><zone xml:id="m-e1ff1d06-c73e-4a88-b2b8-a22ff7cb1e57" ulx="35" uly="724" lrx="139" lry="764" /><zone xml:id="m-58d58a11-79e4-48cd-bdb7-a1e5fdd0f68e" ulx="482" uly="726" lrx="890" lry="761" /><zone xml:id="m-fe299057-de9a-43f7-8c90-386791adaa2e" ulx="60" uly="752" lrx="467" lry="787" /><zone xml:id="m-8a2f8693-8c3b-4ea4-879a-e7d14ee11fab" ulx="507" uly="754" lrx="915" lry="786" /><zone xml:id="m-6a08a77c-518c-4a49-8e1a-fafd27831515" ulx="34" uly="781" lrx="468" lry="821" /><zone xml:id="m-67a0fbc6-5518-4c6a-addc-8f80a696cefa" ulx="482" uly="782" lrx="915" lry="821" /><zone xml:id="m-c9abdbb7-2f5f-413b-831b-5efa5f5a46b4" ulx="34" uly="807" lrx="155" lry="840" /><zone xml:id="m-df5436d8-61dd-4455-9fac-61fdd2ab25cb" ulx="481" uly="808" lrx="661" lry="844" /><zone xml:id="m-99d662a7-c9dd-4f87-ab1a-ba2ac2b01c01" ulx="61" uly="833" lrx="468" lry="868" /><zone xml:id="m-568d9703-10a0-4b54-895e-504c8eb4f58d" ulx="508" uly="833" lrx="912" lry="875" /><zone xml:id="m-a4226f15-f531-48ca-945f-51dd6bf1e890" ulx="35" uly="862" lrx="587" lry="906" /><zone xml:id="m-97866fd8-60f2-460d-a307-22b821afce1f" ulx="507" uly="887" lrx="866" lry="928" /><zone xml:id="m-e2849379-fda7-4855-b20a-3c89b3d7dee1" ulx="35" uly="889" lrx="121" lry="924" /><zone xml:id="m-329fa123-4866-49a5-abda-e4a75749d08f" ulx="60" uly="920" lrx="582" lry="963" /><zone xml:id="m-5b1930b8-eb18-4e0d-942f-df9fb34208c0" ulx="61" uly="958" lrx="385" lry="1002" /><zone xml:id="m-137b152b-547a-49f5-be4f-3ae1aa1adca6" ulx="372" uly="1011" lrx="577" lry="1052" /><zone xml:id="m-777a78bb-5861-4923-ad71-a2501ab3fa5d" ulx="60" uly="1057" lrx="916" lry="1094" /><zone xml:id="m-93b3a2c7-535f-40e8-b5a8-80d9b23cbbbc" ulx="35" uly="1080" lrx="227" lry="1115" /><zone xml:id="m-c9619ddc-22d9-4721-9d8f-a8c286a5e69e" ulx="59" uly="1111" lrx="915" lry="1153" /><zone xml:id="m-3e64a753-86bb-4310-952c-01f499ff0ce3" ulx="34" uly="1142" lrx="259" lry="1178" /><zone xml:id="m-a0d92208-8157-49a9-8ca5-542d36957742" ulx="62" uly="1172" lrx="471" lry="1211" /><zone xml:id="m-799b1386-4c21-42eb-85a0-b50f8e7fed98" ulx="64" uly="1204" lrx="842" lry="1244" /><zone xml:id="m-240e2bb3-f71a-4b40-a7ba-2bd253390421" ulx="63" uly="1235" lrx="706" lry="1274" /><zone xml:id="m-09658bae-eeb6-41fd-829c-f904af81d001" ulx="64" uly="1268" lrx="496" lry="1304" /><zone xml:id="m-dc3dfd32-f1a2-4f4e-891a-a4bdac014d45" ulx="64" uly="1294" lrx="915" lry="1340" /><zone xml:id="m-a1b139e7-ff43-4ddd-88b4-22a7f70cf300" ulx="64" uly="1327" lrx="632" lry="1368" /><zone xml:id="m-40e44f95-9bd7-4137-8db2-91206d9ace8a" ulx="142" uly="1369" lrx="261" lry="1412" /><zone xml:id="m-2d196aa1-f8df-4b51-b9d3-c93d574e5675" ulx="710" uly="1374" lrx="808" lry="1403" /><zone xml:id="m-cfcaf46a-80a1-4d56-83de-3079c56648bf" ulx="51" uly="1400" lrx="915" lry="1447" /><zone xml:id="m-e5fe9f9e-6972-41c7-bc8c-c1be3f020a0d" ulx="82" uly="1434" lrx="916" lry="1469" /><zone xml:id="m-985d94aa-651e-4359-831e-a1f80ef97e84" ulx="41" uly="1438" lrx="69" lry="1472" /><zone xml:id="m-e158ebb2-66ba-4a08-a346-1d6b433df12e" ulx="43" uly="1458" lrx="916" lry="1499" /><zone xml:id="m-1e7a2adc-4722-41a4-b899-603a5c7aba0b" ulx="38" uly="1486" lrx="919" lry="1523" /><zone xml:id="m-0caf0fd9-341d-4b3f-a01d-4430a7fd66f4" ulx="39" uly="1512" lrx="870" lry="1554" /><zone xml:id="m-f2e4a17d-99e3-4dd4-9f7d-cf04e50e287c" ulx="65" uly="1546" lrx="915" lry="1594" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-c941a287-b4a6-4f8f-b655-445af860048c" n="1987" facs="#m-188b5b24-263c-4073-824c-126bd2416cf7" /><div xml:id="m-df6f7360-9096-4f7d-a81e-f4ea1e90a783">
            <lg xml:id="m-c49f8991-3086-4138-9628-863eb59436eb">
              <l xml:id="m-0f634fea-a9d9-491e-b6f9-b6ea97ceb0df" facs="#m-d6a0281e-f85f-45c7-97a7-eb7996643590" label="ambiguous">1741</l><l xml:id="m-8fc90f9a-cf67-438e-a5d5-2c9b9b9c75a0" facs="#m-071802ec-21e9-4c56-b184-d1ac59bc0ed1" label="ambiguous">November 2.</l><l xml:id="m-a6eaa9ce-58f3-453b-a51c-687badfd813b" facs="#m-8ba458ec-8fc5-446a-9e9f-4e06fbd524c9" label="lyrics-like">In conveniéndo pópulos in únum,"</l><l xml:id="m-caab7618-e784-4421-9616-ab45019e34c2" facs="#m-cfacaf62-1c4a-4d45-9628-30918b1c0871" label="ambiguous">Psalm Iol. 1I.</l><l xml:id="m-ea492492-93fb-486b-a8cf-5944b1e6e42f" facs="#m-27601a30-bf81-4b43-8ce7-b8fdee2dadc0" label="lyrics-like">et réges ut sérviant Dómino.</l><l xml:id="m-07ad62d9-d746-4c74-90fa-ca27bfac0721" facs="#m-bae55ada-30f3-46a2-9737-42ea3ccb5cd2" label="lyrics-like">HIU exsúrgens miseréberis Sion::</l><l xml:id="m-235e0c87-e848-4212-a87f-f4b0ae71ed1a" facs="#m-f3424c3e-604a-41db-a4d3-3766dea4775b" label="lyrics-like">Réquiem actérnam* dóna éis,</l><l xml:id="m-0e910a39-bc55-4b48-bf94-279fb5fd594a" facs="#m-8511925e-8f11-49ca-bf32-444a712574d5" label="lyrics-like">Dómine.</l><l xml:id="m-c7c326c6-b93a-47bf-b637-78b9750de3fc" facs="#m-52c5b4aa-50ba-41a2-9d89-e7814354ec2e" label="lyrics-like">1 quia témpus miseréndi éjus,</l><l xml:id="m-850b57b1-d888-4375-b214-b42055d63acc" facs="#m-b84fd922-f48f-49fd-a979-cd6f30bf49da" label="lyrics-like">Et lux perpétua * lúceat éis.</l><l xml:id="m-ae63843b-4cd1-442c-846e-cc0c7726b4ef" facs="#m-cdca2aab-f0e9-4cc9-bc98-9b26c5cda4f6" label="lyrics-like">quia vénit tempus.</l><l xml:id="m-2f17a3b6-46b6-406b-bc0e-2299fd7cd7c7" facs="#m-5899062c-d47f-4a47-be4c-bd8a059c9cf9" label="lyrics-like">Quóniam placuérunt sérvis túis</l><l xml:id="m-d77821fb-b798-4bf4-85a5-6492638c77d8" facs="#m-17c63e40-a459-42e6-aa52-5c7b446b812c" label="ambiguous">Psalm I01. III.</l><l xml:id="m-a357bdbc-f88b-4b60-8e5e-daf2264c2952" facs="#m-6ed5ff18-d375-4bf7-b42c-e8c68a701efa" label="lyrics-like">lápides éjus :* et térrae éjus mise¬</l><l xml:id="m-31626b6e-ac8f-42b5-8e11-dd3577eccc09" facs="#m-461fd719-36df-4c93-86ea-6b405e3c8fe3" label="lyrics-like">2 Espondit éi in vía virtútis súae:</l><l xml:id="m-edd107d9-9bf5-47f3-a98f-8b4f8ad4dd5c" facs="#m-09c999eb-790c-4d51-b025-59c1c836b817" label="lyrics-like">rebúntur.</l><l xml:id="m-59a70cfd-31d6-47c5-b7c6-491a2be4f64c" facs="#m-329d2dc5-20f3-4141-9156-c63e6ad01ade" label="lyrics-like">Et timébunt géntes nómen túum,</l><l xml:id="m-fa4230d9-7498-4377-bf7c-3c5d7b940e0a" facs="#m-77e939c3-412c-470c-9f88-191faceefa01" label="lyrics-like">1t Paucitátem diérum meórum</l><l xml:id="m-680664b7-15b9-4b37-8b2b-4aee7d2a47b9" facs="#m-b358cc70-a506-4bf1-bc25-948215bb1085" label="lyrics-like">Dómine, * et ômnes réges térrae</l><l xml:id="m-b109b0f7-10ad-4397-a084-e40cb1931890" facs="#m-f082bd47-c0b1-4cd4-a71c-f6f3c0680d1b" label="lyrics-like">núntia mihi.</l><l xml:id="m-5e8ebd95-7adc-478a-8704-a40c554b7f68" facs="#m-c449123a-d9c8-45de-89d3-cfe5142a5dab" label="lyrics-like">glóriam túam.</l><l xml:id="m-57630406-9219-4dbe-8c1b-756588faed21" facs="#m-ec9fdb2a-7445-4d55-8696-8a79134f6383" label="lyrics-like">Ne révoces me in dimídio diérum</l><l xml:id="m-4c6198a8-7db5-4825-b1ae-9857e735370e" facs="#m-668c9e3e-fa7b-4036-a5dc-91b026380466" label="lyrics-like">Quia aedificávit Dóminus Sion:</l><l xml:id="m-9bb2d466-5c66-4047-9696-581d0ec49b92" facs="#m-64ba7ca5-94c6-4dd7-ab21-12b1f4509fea" label="lyrics-like">meórum*in generatiónem et</l><l xml:id="m-05defc12-20d3-4b23-9e42-6bd0e2c82634" facs="#m-0b089211-f21f-4b53-b6d5-6d57c7f45968" label="lyrics-like">et vidébitur in glória sua.</l><l xml:id="m-af14a866-891e-4255-b8bc-ef33d746f8e8" facs="#m-ea2c0e5d-6a3d-423d-8b53-0a0e35fa11b3" label="lyrics-like">generatiónem anni tui.</l><l xml:id="m-c23fc96c-408a-4b70-9ef1-b4692830b241" facs="#m-d92af665-2cd9-4133-a00a-89d3c3fc1949" label="lyrics-like">Initio tu, Dómine, térram fundã¬</l><l xml:id="m-2c8a2fc2-4abc-4d84-b229-99f96d742e33" facs="#m-75ab8a58-b5ab-47ec-a6ed-278f4c863a10" label="lyrics-like">Respéxit in oratiónem humi¬</l><l xml:id="m-c7812e1d-6c56-4f5f-b9a9-7990ffc305a6" facs="#m-d8a78b12-6d79-454a-b91a-bb3f3eff5832" label="lyrics-like">lium: * et non sprévit précem</l><l xml:id="m-1b2db739-4d5a-444f-a065-4e1f295144cc" facs="#m-1a6659ba-0633-4d1c-98d1-cbbfb3b84020" label="lyrics-like">sti: * et ópera mánuum tuárum</l><l xml:id="m-adc6fdf6-1518-4735-a9ca-873cc4ae8a75" facs="#m-a110fc0b-dde6-4fae-a89e-fce1aaa2be1b" label="lyrics-like">sant caéli.</l><l xml:id="m-7493dd07-c87b-4f3e-b453-f50ff1e0f386" facs="#m-d0c8e24c-e0c7-4e26-922a-a7471efbd0b8" label="lyrics-like">eórum.</l><l xml:id="m-272351cf-5fdd-46a3-8226-be96fbe92e12" facs="#m-dec3342c-e57f-4ce1-9cfe-bc6148dc48fa" label="lyrics-like">Scribántur haec in generatióne</l><l xml:id="m-d3bf388f-4bd7-4ba0-80a6-84d8840fe206" facs="#m-c621d0d4-28b8-42ae-856c-25ba3396f496" label="lyrics-like">Ipsi peribunt, tu autem pérma¬</l><l xml:id="m-46a5f4e4-ae93-472b-a8a9-68539df38568" facs="#m-5c346c8d-21ea-49f3-ab6d-c4e07ab4d736" label="lyrics-like">áltera :* et pópulus qui creábitur</l><l xml:id="m-622a0e81-338f-4e28-8b98-12e22261fe1f" facs="#m-f96cd45c-b9a4-4556-b6ba-8d95e7a48c36" label="lyrics-like">nes: *'et ómnes sicut vestiméntum</l><l xml:id="m-f3aa987c-95b3-4de6-9487-9816cb8f036e" facs="#m-41ab13fd-a62a-46e5-b09a-daa1f6f547a5" label="lyrics-like">laudábit Dóminum:</l><l xml:id="m-86d37b52-9060-4886-96ea-b56e58aed28b" facs="#m-e99454f1-4372-41c3-b5e9-e35824105630" label="lyrics-like">veteráscent.</l><l xml:id="m-965c5b38-bc31-47e2-8e12-c83a481c59eb" facs="#m-0c80911c-fe0f-4e10-ba9a-9d55cfb4af80" label="lyrics-like">Et sicut opertórium mutábis éos,</l><l xml:id="m-b7764018-64aa-4411-823f-81f89c0dbc36" facs="#m-5ff6c0f2-7ba4-41aa-a191-02cc8a3551ff" label="lyrics-like">Quia prospéxit de excélso sáncto</l><l xml:id="m-1ff08ece-a0e2-4be7-ab3f-9415fca7e311" facs="#m-4c6fa7ee-2127-40fb-982a-bbb2149e52c9" label="lyrics-like">suõ:* Dóminus de caélo in térram</l><l xml:id="m-bd208f05-b388-4292-af8c-431de8e3d746" facs="#m-3d20c840-a9f2-4568-ae8a-56a43b2a153a" label="lyrics-like">et mutabúntur; * tu autem ídem</l><l xml:id="m-6ec63d4d-854a-468e-a4bc-32696f4eb186" facs="#m-e1ff1d06-c73e-4a88-b2b8-a22ff7cb1e57" label="lyrics-like">aspéxit.</l><l xml:id="m-bb622404-f848-4f12-8bbe-e348d5fa9c86" facs="#m-58d58a11-79e4-48cd-bdb7-a1e5fdd0f68e" label="lyrics-like">ipse es, et ánni tui non deficient.</l><l xml:id="m-8d2304f6-f3f8-494b-b4ed-6b2fc7ae1cd0" facs="#m-fe299057-de9a-43f7-8c90-386791adaa2e" label="lyrics-like">Ut audíret gémitus compeditó¬</l><l xml:id="m-d5c15f2a-9b2e-471a-a432-4c96027c21b2" facs="#m-8a2f8693-8c3b-4ea4-879a-e7d14ee11fab" label="lyrics-like">Filii servórum tuórum habitá¬</l><l xml:id="m-ad963dc0-968d-4b32-af83-9cf5d7ad4143" facs="#m-6a08a77c-518c-4a49-8e1a-fafd27831515" label="lyrics-like">rum:*ut sólveret filios interem¬</l><l xml:id="m-2bbda00b-7bb4-45bf-9dc1-9981a4dda4cf" facs="#m-67a0fbc6-5518-4c6a-addc-8f80a696cefa" label="lyrics-like">bunt :* et sémen eórum in saécu¬</l><l xml:id="m-5ca4d73a-a375-4642-8de9-6f985d157d34" facs="#m-c9abdbb7-2f5f-413b-831b-5efa5f5a46b4" label="lyrics-like">ptórum:</l><l xml:id="m-b1e7eb0f-6f90-405e-87de-5a2c9b9b490a" facs="#m-df5436d8-61dd-4455-9fac-61fdd2ab25cb" label="lyrics-like">lum dirigétur.</l><l xml:id="m-21210fa6-8853-44cf-b8f5-031a200e8a4a" facs="#m-99d662a7-c9dd-4f87-ab1a-ba2ac2b01c01" label="lyrics-like">Ut annúntient in Sion nómen Dó¬</l><l xml:id="m-cb3608f9-6c51-4912-908e-7b7d3abf31dc" facs="#m-568d9703-10a0-4b54-895e-504c8eb4f58d" label="lyrics-like">Réquiem aetérnam* dóna éts,</l><l xml:id="m-1bc6bd5f-9e12-4b31-8d5b-06bbe109bcb4" facs="#m-a4226f15-f531-48ca-945f-51dd6bf1e890" label="lyrics-like">*et láudem éjus in Jeru-Domine.</l><l xml:id="m-253d0401-a8fe-4a92-9a17-b932a6e06985" facs="#m-97866fd8-60f2-460d-a307-22b821afce1f" label="lyrics-like">Et lux perpétua * lúceat éis.</l><l xml:id="m-4e3c8d7e-0e65-4e01-89e8-f027d307409d" facs="#m-e2849379-fda7-4855-b20a-3c89b3d7dee1" label="ambiguous">salem.</l><l xml:id="m-5ce2dcc1-bf83-4d8d-9706-714217f25933" facs="#m-329fa123-4866-49a5-abda-e4a75749d08f" label="text-like">Mass for alt the Faithfut Departed, p. 1806.</l><l xml:id="m-16c4e1c5-2739-4a13-8e98-abcd70c3e068" facs="#m-5b1930b8-eb18-4e0d-942f-df9fb34208c0" label="text-like">The Absolution, p. 1820.</l><l xml:id="m-7ce6d36d-3c96-4c74-9259-70c164d3850b" facs="#m-137b152b-547a-49f5-be4f-3ae1aa1adca6" label="text-like">AT VESPERS.</l><l xml:id="m-cbae9037-c9cd-41fe-b8d5-efdd89845bbd" facs="#m-777a78bb-5861-4923-ad71-a2501ab3fa5d" label="text-like">The Vespers of the Dead are sung, beginning directly by the Antiphon</l><l xml:id="m-7b42ee07-123a-4800-a2f3-ad8153fd9c04" facs="#m-93b3a2c7-535f-40e8-b5a8-80d9b23cbbbc" label="lyrics-like">Placébo. p. 1772.</l><l xml:id="m-4ae339b4-60b1-463a-b728-67c88e92550a" facs="#m-c9619ddc-22d9-4721-9d8f-a8c286a5e69e" label="text-like">After the repetition of the Antiphon of the Magnificat all kneel for the</l><l xml:id="m-611fd910-5898-49b3-9bcc-1d63f3dbd2f7" facs="#m-3e64a753-86bb-4310-952c-01f499ff0ce3" label="ambiguous">following prayers:</l><l xml:id="m-06e53516-805f-47f8-9052-dd99fae7de86" facs="#m-a0d92208-8157-49a9-8ca5-542d36957742" label="lyrics-like">Páter nóster. continued in silence.</l><l xml:id="m-0e65aca1-99f3-4856-9c7a-18506febe585" facs="#m-799b1386-4c21-42eb-85a0-b50f8e7fed98" label="lyrics-like">V. Et ne nos indúcas in tentatiónem. E. Sed libera nos a málo.</l><l xml:id="m-0b155cc0-58ee-4fec-bd85-21bf4adfe666" facs="#m-240e2bb3-f71a-4b40-a7ba-2bd253390421" label="lyrics-like">V. A pórta inferi. R. Erue, Dómine, ánimas eórum.</l><l xml:id="m-fbac64d1-286a-4611-8015-2b35a3016d23" facs="#m-09658bae-eeb6-41fd-829c-f904af81d001" label="lyrics-like">V. Requiéscant in pâce. R. Amen.</l><l xml:id="m-2d644733-9544-43b9-913c-c4ff5e10065e" facs="#m-dc3dfd32-f1a2-4f4e-891a-a4bdac014d45" label="lyrics-like">X. Dómine, exáudi oratiónem méam. E. Et clámor méus ad te véniat.</l><l xml:id="m-731befd2-bb0f-4b13-8130-835856e549b6" facs="#m-a1b139e7-ff43-4ddd-88b4-22a7f70cf300" label="lyrics-like">V. Dóminus vobiscum. B. Et cum spiritu túo.</l><l xml:id="m-ce8a1c8e-692a-4dc5-a8cc-80e771cfc018" facs="#m-40e44f95-9bd7-4137-8db2-91206d9ace8a" label="lyrics-like">Orémus.</l><l xml:id="m-97675b91-0235-49dd-89ae-13b98b2b4412" facs="#m-2d196aa1-f8df-4b51-b9d3-c93d574e5675" label="text-like">Prayer.</l><l xml:id="m-7f278638-7954-4740-85d4-5dd9d2bcb710" facs="#m-cfcaf46a-80a1-4d56-83de-3079c56648bf" label="lyrics-like">LrIdélium, Deus, ómnium Cóndi-[semper optavérunt, * piis supplica¬</l><l xml:id="m-ddbbe05c-4ef8-4655-99aa-0ca4d5d60d4a" facs="#m-e5fe9f9e-6972-41c7-bc8c-c1be3f020a0d" label="lyrics-like">tor et Redémptor, animábus tiónibus consequántur. Qui vivis et</l><l xml:id="m-6dec08cf-a423-4c5c-926f-ef25bf7be44d" facs="#m-985d94aa-651e-4359-831e-a1f80ef97e84" label="ambiguous">F</l><l xml:id="m-c538633d-62f5-4ee8-bc3e-1614a994532a" facs="#m-e158ebb2-66ba-4a08-a346-1d6b433df12e" label="lyrics-like">famulórum famularúmque tuárum  regnas cum Deo Patre in unitáte</l><l xml:id="m-d39d422f-9065-4c1b-96aa-39c28811f32e" facs="#m-1e7a2adc-4722-41a4-b899-603a5c7aba0b" label="lyrics-like">remissiónem cunctórum tribue pec-lSpiritus Sancti Deus,* per ómnia</l><l xml:id="m-3b0208c1-ba5f-4b77-84a6-4ee98f7e3a16" facs="#m-0caf0fd9-341d-4b3f-a01d-4430a7fd66f4" label="lyrics-like">catórum : t ut indulgéntiam, quam! saécula saeculórum. K. Amen.</l><l xml:id="m-1689d255-7f14-4a46-88b5-67ff0a2876eb" facs="#m-f2e4a17d-99e3-4dd4-9f7d-cf04e50e287c" label="lyrics-like">V. Réquiem aetérnam dóna éis, Dómine. B. Et lux perpétua lúceat éis.</l></lg></div></section></score></mdiv></body></music>
</mei>