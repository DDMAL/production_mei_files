                  <syl /><neume facs="#m-ab20dfba-2535-4ced-9bcf-6b39f8b4b856" type="cavum" xml:id="m-5f645a0c-3cea-4bfc-8c9e-87753d3eefb0">
                    <nc xml:id="m-8edb14e8-ccfb-4787-b6ff-0385da62907c" pname="c" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-fff66c3f-fc0d-49d6-82d0-1b4478f7e701">
                  <syl /><neume facs="#m-44cdf1a0-af33-41ac-84ec-597fe6957493" type="clivis" xml:id="m-0279ed0e-3375-47ab-bd58-d51ef50af5c7">
                    <nc xml:id="m-95067d60-045a-4f43-9fef-ebbcc7c9a83d" pname="b" oct="3" />
                    <nc xml:id="m-2715356f-afb5-4f33-b2b9-2ae403cb2979" pname="a" oct="3" />
                  </neume>
