 lry="986" /><zone xml:id="m-216020bf-92c7-4cb8-95b6-08f45db4624e" ulx="32" uly="977" lrx="988" lry="1019" /><zone xml:id="m-92ac7cb8-8e73-4e99-bb7c-a4b35360e7fe" ulx="32" uly="1012" lrx="985" lry="1049" /><zone xml:id="m-dbb7e7bd-6298-415a-b68d-3779138de205" ulx="32" uly="1042" lrx="987" lry="1082" /><zone xml:id="m-ca0b52da-63e7-4462-bf77-b947261a8387" ulx="32" uly="1075" lrx="184" lry="1116" /><zone xml:id="m-189b4ca4-b6cd-4a31-9091-93943a95017e" ulx="62" uly="1123" lrx="224" lry="1165" /><zone xml:id="m-14beba88-52b5-446c-a703-72043991892d" ulx="551" uly="1124" lrx="706" lry="1172" /><zone xml:id="m-24880cfa-2799-4934-836c-193849dbd563" ulx="66" uly="1165" lrx="255" lry="1210" /><zone xml:id="m-bded7034-7835-4077-8fe9-b5ad6d879315" ulx="553" uly="1166" lrx="774" lry="1212" /><zone xml:id="m-a7519341-76a6-4245-a1fb-6f05e5c8983b" ulx="62" uly="1197" lrx="399" lry="1244" /><zone xml:id="m-5d9c947e-251b-44d3-8718-5991cd114e92" ulx="550" uly="1200" lrx="883" lry="1244" /><zone xml:id="m-b2af5550-0ef7-440b-aa0f-0808379a74ad" ulx="62" uly="1245" lrx="508" lry="1281" /><zone xml:id="m-e2f76aab-732e-49a4-85d9-b55de2a74695" ulx="548" uly="1245" lrx="991" lry="1284" /><zone xml:id="m-2ea052fb-dede-4659-be06-fd67d80e7f45" ulx="31" uly="1275" lrx="507" lry="1308" /><zone xml:id="m-67c3255b-29b8-4ea0-ab70-b837445dc6fa" ulx="516" uly="1276" lrx="991" lry="1309" /><zone xml:id="m-6b04dfb0-7ec8-4388-a797-461c7ab73d38" ulx="30" uly="1303" lrx="506" lry="1334" /><zone xml:id="m-181ac15d-7b54-4eaa-ac98-e7d90bc79a3e" ulx="517" uly="1306" lrx="991" lry="1336" /><zone xml:id="m-af0c23e3-03a2-4d05-b18c-f7b66f9d8510" ulx="32" uly="1328" lrx="506" lry="1364" /><zone xml:id="m-49db4b3a-c0ae-4817-b3ac-e4a21266a308" ulx="517" uly="1333" lrx="992" lry="1363" /><zone xml:id="m-b1d67d17-a25e-4dde-a4c9-c15bd9e0fe2a" ulx="35" uly="1359" lrx="988" lry="1394" /><zone xml:id="m-189a301d-bf75-40a2-8042-e3c177f51e9c" ulx="509" uly="1382" lrx="980" lry="1420" /><zone xml:id="m-83e73be7-2005-4997-b38f-1681dd67f851" ulx="32" uly="1387" lrx="281" lry="1418" /><zone xml:id="m-b1ec4023-79a9-44ac-ab2b-869697cab2e2" ulx="60" uly="1425" lrx="992" lry="1468" /><zone xml:id="m-b6d0e457-4b48-4dfe-9196-f2df1e24f8ca" ulx="32" uly="1465" lrx="989" lry="1501" /><zone xml:id="m-04f9446d-cab7-428d-a56b-415ebf7b0b90" ulx="33" uly="1490" lrx="185" lry="1531" /><zone xml:id="m-8ffc4ae9-cb43-4b5f-8e37-24886a542e49" ulx="545" uly="1513" lrx="993" lry="1554" /><zone xml:id="m-31e126aa-16d9-4e28-b3f8-87d95dc4a7aa" ulx="519" uly="1543" lrx="993" lry="1578" /><zone xml:id="m-e2649de9-309d-4c49-a1ee-7991e4703e9b" ulx="519" uly="1570" lrx="993" lry="1604" /><zone xml:id="m-18df3581-3c15-4892-aa4c-b173b21842f3" ulx="520" uly="1598" lrx="993" lry="1633" /><zone xml:id="m-b1ce7bf1-8e0a-4a08-8b95-00cac7dc4d5d" ulx="520" uly="1626" lrx="900" lry="1661" /><zone xml:id="m-fefb0fe9-72e7-4200-b13b-5f09202428bb" ulx="548" uly="1655" lrx="992" lry="1694" /><zone xml:id="m-4dd33bcc-9ce2-4c05-bb55-1de3ce32877e" ulx="62" uly="1656" lrx="506" lry="1700" /><zone xml:id="m-f6571950-1934-4420-8182-6a397c3545bc" ulx="513" uly="1685" lrx="924" lry="1729" /><zone xml:id="m-7cda5f0d-a555-4898-bdd5-0d7582ace884" ulx="33" uly="1690" lrx="471" lry="1732" /></surface>
    </facsimile>
    <body xml:id="m-da640b43-99fd-4f06-a759-8a923375d47e">
      <mdiv xml:id="m-f485cc67-f8ee-415c-8bed-7c2c6b30800c" type="solesmes">
        <score xml:id="m-830f7612-f61a-4044-a27e-b0d3ea399f79">
          <section xml:id="m-f4e26c27-d0ae-420e-990f-87c32932966c">
            <pb xml:id="m-b96cfd71-c03a-45b2-9693-708015474feb" n="0949" facs="#m-4f30cdcd-49d4-4062-9cbd-c8ffb1d41172" />
            <div xml:id="m-8d20ace6-707d-41f1-ae2e-2a8649686e30">
              <lg xml:id="m-d7743bc2-78a4-4fa2-95e3-d3c0b5946363">
                <l xml:id="m-70893c06-c24d-48ee-969e-c40ef9bb8fc0" facs="#m-511aa402-fe2c-48da-9a4e-428f66ca880e" label="ambiguous">77644</l><l xml:id="m-357ba5d7-6676-40e1-8f2c-fef66a838d90" facs="#m-a65ed937-fae0-4a33-b089-c3b767626361" label="text-like">The sacrament of Baptism</l><l xml:id="m-bfe5ee97-a62c-416d-98cc-517637a842f4" facs="#m-44636406-0e8a-45a9-8d14-6714bf3ff9ea" label="lyrics-like">Credis et in Spíritum Sanctum, sanctam Ecclésiam cathólicam,</l><l xml:id="m-8858d9ff-9b57-4379-9c4a-7604fe531715" facs="#m-a77a4558-2089-43bf-8708-5779ab731f06" label="lyrics-like">Sanctórum communiónem, remissiónem peccatórum, carnis resur¬</l><l xml:id="m-2acd45f7-c4c7-4fd7-aaa5-b78fbb924198" facs="#m-155fa145-ee4d-441e-88c8-acb0bc2b95d6" label="lyrics-like">rectiónem, et vitam aetérnam. W. Credo.</l><l xml:id="m-23bbaa20-23a4-447a-8abc-661f64941a6b" facs="#m-0883cf40-373e-4c3b-803d-bac6e50410ff" label="text-like">Immediately afterwards the cele¬</l><l xml:id="m-ac1e1702-1c23-498c-8be8-ee0308234d00" facs="#m-22937354-1850-4239-94eb-fd0db0e04dbf" label="ambiguous">N. Quid petis?</l><l xml:id="m-26935991-860c-4112-8c9c-36b168ae092c" facs="#m-29609b84-84f3-44ef-9ef7-50f426a0ccee" label="text-like">brant ashs by name each one who is to</l><l xml:id="m-0d5c4c93-28c6-470b-9030-b404cb3dfebd" facs="#m-e2bba5d6-e7fd-4252-9a2c-5f66182837d9" label="lyrics-like">He answers: Baptísmum.</l><l xml:id="m-faf8f9d6-b7eb-480f-affc-b1ada6acb790" facs="#m-c493f78a-f784-45ca-a5a8-31d4aba4210b" label="ambiguous">be baptized:</l><l xml:id="m-bb62dbf1-b650-438e-9c62-22c5375d6e8e" facs="#m-2cf4c8e0-cfeb-4bc0-b12e-17052ffe1c1e" label="lyrics-like">Vis baptizári?</l><l xml:id="m-c645e620-27dc-4ce1-bc3b-1086e9cb2785" facs="#m-873cfdec-5e48-4580-be74-cdd0552450bf" label="lyrics-like">N. Vis baptizári?</l><l xml:id="m-1c3472f6-3b84-4ab1-b67e-d74a9908790a" facs="#m-1360100c-5532-4787-b919-f51976d3fb97" label="ambiguous">He answers : Volo.</l><l xml:id="m-da522ee3-9f34-4acd-a38e-78f2d8262bf5" facs="#m-371f3e95-7350-431f-afb2-2006595110a9" label="text-like">The godfather answers : Volo.</l><l xml:id="m-3cbfb68b-345b-436f-9f01-66c624a12bf1" facs="#m-3c850464-0ed0-4785-87eb-28590900c999" label="text-like">The candidate, with his head and</l><l xml:id="m-9074a31f-cca5-4827-b86e-86267ec8baae" facs="#m-c0d37510-e476-478b-91c9-a16104f5da99" label="text-like">Then the godfather or the godmother</l><l xml:id="m-47c15cf7-1b47-4ff9-b4bc-946700252f68" facs="#m-136adb45-5f92-49f0-918d-f8ab684034de" label="text-like">neck bare, leans over the basin. </l><l xml:id="m-ca617482-1547-457a-b87b-c0de765021e1" facs="#m-009fa08d-a05e-466f-b325-389599f00732" label="lyrics-like">(or both) holã the child. The cele¬</l><l xml:id="m-12ff4537-9870-4e59-911d-1178571ede52" facs="#m-8ff08588-83a5-4957-bba0-cdbd4991b23b" label="text-like">the same time the godfather or god¬</l><l xml:id="m-d199c277-de70-4771-8552-31bafa1e112f" facs="#m-7dfd31e4-7e57-4deb-99c2-d6d2076709a2" label="text-like">brant takes the baptismal water and</l><l xml:id="m-9f397853-9c0b-48e0-ab93-7879af7c4a0d" facs="#m-687474a3-3772-4fe1-bb55-3f6724337a71" label="text-like">mother (or both) place a hand on his</l><l xml:id="m-3a166822-0c36-4bc2-8529-dafaeb2add8f" facs="#m-3622132d-ca01-42fc-b45a-a05c0f6030e8" label="text-like">pours it three times in the form of</l><l xml:id="m-3465b263-9a98-4285-8b2b-ff36974973eb" facs="#m-1064072b-29c2-4811-8396-42efcac8d214" label="text-like">shoulder. The celebrant takes some</l><l xml:id="m-3a6e69cc-1b16-42ce-867a-7bba18121bbb" facs="#m-48292b4a-4d92-426b-b460-e44ab9212036" label="text-like">a cross on the child's head. At the</l><l xml:id="m-c4c12239-660d-45cc-978f-640454a32922" facs="#m-3deb6e97-34e2-4a0b-ab6f-1be417afaf49" label="ambiguous">baptismal water, pours it three times</l><l xml:id="m-fb0e45f8-2825-4d02-b654-aedff8c0bffc" facs="#m-ebfc8998-ec43-45f6-b711-c0e7f2e5e806" label="text-like">same time he says distinctly and</l><l xml:id="m-fcb2d3b6-4e79-4008-992c-0f080d45285e" facs="#m-5af7a879-cf73-45f3-965e-a6f62183cd8f" label="text-like">in the form of a cross on the head of</l><l xml:id="m-dd6179e9-190d-4d7f-8b87-eae9ff116f2f" facs="#m-07c82d06-c72b-4604-8e57-63d20fbda407" label="text-like">attentively the follouing words to</l><l xml:id="m-6acb65d0-6f90-4cbb-91c4-5d06c60bc679" facs="#m-e1d2c04d-02a2-4c27-a7c5-adcafd1784a1" label="text-like">the candidate, and at the same time</l><l xml:id="m-bf656db4-499b-44a8-8e20-a5221a7f0189" facs="#m-bf749867-69ba-4fb9-b875-b9bc99eed4b9" label="text-like"> distincily and attentively the</l><l xml:id="m-fa450697-be18-4e4d-b45f-da77b4cfadaa" facs="#m-0ca20d53-92b4-45f5-b751-2d64ef7f78cc" label="ambiguous">each one:</l><l xml:id="m-fae1510f-bfa1-40cd-95e4-137c7ea90bc9" facs="#m-9178971b-1e61-486b-b011-72dc273b30e5" label="lyrics-like">following word̃s to each one:</l><l xml:id="m-0f6f0a1f-63c5-4478-95d8-0385860ec9a1" facs="#m-d6669af6-e14e-4fd7-93fc-93e8f416054e" label="text-like">N. EGO TE BAPTIZO IN NOMINE PAFTRIS, he pours a l time, ET</l><l xml:id="m-91c8bdf6-1486-435f-85e4-083e798f485b" facs="#m-fbadf246-bafe-43d5-a003-d4c31c8bb294" label="text-like">FITLII, he pours a 2 time, ET SPIRITUS4 SANCTI, he pours a 3 time.</l><l xml:id="m-43bec730-c54d-43e2-b68f-ba2804714934" facs="#m-39f6db30-efb0-47bc-8a31-496dd57cdef8" label="text-like">The water which flozos from the head of the baptized person must be</l><l xml:id="m-047fc37f-5928-4989-b1d9-bc4bd02ce8ce" facs="#m-d144c575-789d-41f2-87eb-58600e302fe2" label="text-like">received into a basin, aohich is afterwvards emptied inio ihe font.</l><l xml:id="m-044f312c-e38d-45d9-8580-cc05400af925" facs="#m-e722ebcd-6bd5-4290-97d0-096037f1d0f1" label="text-like">Then-the celebrant tahes some holyl Then the celebrant tabes some holy</l><l xml:id="m-e477d8ec-2d5d-4741-a991-f827b84b14bb" facs="#m-38ed4a0a-9909-4d11-a737-b6914cf1b541" label="text-like">Chrism with his thumb, and traces Chrism with his thumb, and traces the</l><l xml:id="m-f4f6524d-cc28-4d87-b101-5a4db6bce1a0" facs="#m-bc5b22a1-3f17-489a-a892-3327c061df55" label="lyrics-like">te sign of the cross on the top of the sign of the cross on the tõp of the head of</l><l xml:id="m-1b925ded-9a68-49a5-a0f1-fecf95ffd2e2" facs="#m-47e11125-f0b5-4fec-bd3b-c57fb494cd63" label="ambiguous">child's head, saying to each one:</l><l xml:id="m-04f86d24-c296-4c79-9898-a707ed9902d4" facs="#m-ba8be0fb-396d-4777-b95d-336722984089" label="text-like">l the person baptized, saving to each one:</l><l xml:id="m-a6469c75-f50f-4450-a4e3-d10b3a3189df" facs="#m-2cd9a668-166b-4cc4-b009-b93b75d7aeba" label="lyrics-like">Deus omnípotens, Pater Dómini nostri Jesu Christi, qui te rege¬</l><l xml:id="m-ad5d7ab1-dc3f-41eb-b4c0-ae9d83c143e5" facs="#m-216020bf-92c7-4cb8-95b6-08f45db4624e" label="lyrics-like">nerávit ex aqua et Spíritu Sancto, quique dedit tibi remissiónem</l><l xml:id="m-8a547a9a-ecfc-49fa-a51b-8435e741c44b" facs="#m-92ac7cb8-8e73-4e99-bb7c-a4b35360e7fe" label="lyrics-like">ómnium peccãtórum (he marks the sign of the cross), ipse te liniat 4</l><l xml:id="m-cd83bcbd-7641-46b3-93b4-6b54092c77fa" facs="#m-dbb7e7bd-6298-415a-b68d-3779138de205" label="lyrics-like">Chrísmate salútis in códem Christo Jesu Dómino nostro in vitam</l><l xml:id="m-6da3bd51-2e08-40e9-a655-9f436a34a6be" facs="#m-ca0b52da-63e7-4462-bf77-b947261a8387" label="lyrics-like">aetérnam.</l><l xml:id="m-77387fdf-b3d8-4fed-8808-9eead14f5555" facs="#m-189b4ca4-b6cd-4a31-9091-93943a95017e" label="ambiguous">W. Amen.</l><l xml:id="m-4c45d839-55cc-42e2-9e3f-48b2388f7973" facs="#m-14beba88-52b5-446c-a703-72043991892d" label="ambiguous">W. Amen.</l><l xml:id="m-a4c8a216-b645-474d-834b-a525571a9544" facs="#m-24880cfa-2799-4934-836c-193849dbd563" label="ambiguous">V. Pax tibi.</l><l xml:id="m-046de308-b58b-45b1-a058-b2ed8f5ae278" facs="#m-bded7034-7835-4077-8fe9-b5ad6d879315" label="lyrics-like">V. Pax técum.</l><l xml:id="m-e38ce601-6580-461e-a253-0b729aff0994" facs="#m-a7519341-76a6-4245-a1fb-6f05e5c8983b" label="lyrics-like">H. Et cum spíritu túo.</l><l xml:id="m-99652234-b730-49b8-a158-d917449ee672" facs="#m-5d9c947e-251b-44d3-8718-5991cd114e92" label="lyrics-like">F. Et cum spíritu túo.</l><l xml:id="m-9d4c7291-15e8-49c8-ad1d-4d79f866a035" facs="#m-b2af5550-0ef7-440b-aa0f-0808379a74ad" label="text-like">The celebrant wipes his fingers with</l><l xml:id="m-9419a41f-1bfd-4a61-afb5-406a42183180" facs="#m-e2f76aab-732e-49a4-85d9-b55de2a74695" label="text-like">The celebrant wipes his fingers vith</l><l xml:id="m-00047866-fa8d-4216-937b-e5d542361f36" facs="#m-2ea052fb-dede-4659-be06-fd67d80e7f45" label="lyrics-like">cotton-wool and also the heãd which</l><l xml:id="m-5dfc6bf6-5a83-4f04-85b5-5021b09cd78d" facs="#m-67c3255b-29b8-4ea0-ab70-b837445dc6fa" label="text-like">cotton-wool and also the head which</l><l xml:id="m-73f7c6ac-7eb1-4710-a711-247f215efc75" facs="#m-6b04dfb0-7ec8-4388-a797-461c7ab73d38" label="ambiguous">he has just anointed. He then places</l><l xml:id="m-bc6260c2-1efc-419d-9874-63fa023203d5" facs="#m-181ac15d-7b54-4eaa-ac98-e7d90bc79a3e" label="text-like">he has just anointed. He then places on</l><l xml:id="m-ac24ddf9-d7ec-42fe-9af5-241b483d2973" facs="#m-af0c23e3-03a2-4d05-b18c-f7b66f9d8510" label="text-like">on the child's head a white linen cloth</l><l xml:id="m-e8be38a6-907d-4bae-b9dc-0dd4ac8f147d" facs="#m-49db4b3a-c0ae-4817-b3ac-e4a21266a308" label="text-like">the head of the nezoly-baptized person</l><l xml:id="m-de11b27b-b1b5-41fe-affc-96cc7e60d270" facs="#m-b1d67d17-a25e-4dde-a4c9-c15bd9e0fe2a" label="text-like">to take the place of a white garment, a white linen cloth and gives him a</l><l xml:id="m-3cc6a29b-9261-4f32-a8a4-59ce5533cec5" facs="#m-189a301d-bf75-40a2-8042-e3c177f51e9c" label="ambiguous">lwhite garment. He says to each one:</l><l xml:id="m-a3d2c23f-f38c-4f7e-9349-7354dd53aeca" facs="#m-83e73be7-2005-4997-b38f-1681dd67f851" label="ambiguous">saying to each one:</l><l xml:id="m-3edda1b4-05f4-4421-a4dd-7f9424b5813f" facs="#m-b1ec4023-79a9-44ac-ab2b-869697cab2e2" label="lyrics-like">Accipe vestem cándidam, quam pérferas immaculátam ante</l><l xml:id="m-8d14543d-dfbf-4970-8301-2ae4c80d90c6" facs="#m-b6d0e457-4b48-4dfe-9196-f2df1e24f8ca" label="lyrics-like">tríbunal Dómini nostri Jesu Christi, ut hábeas vitam aetérnam.</l><l xml:id="m-8e7bf065-459a-429a-99fa-324ad08cee55" facs="#m-04f9446d-cab7-428d-a56b-415ebf7b0b90" label="ambiguous">W. Amen.</l><l xml:id="m-64f0bf3b-8a23-40c9-bf74-79d4d73344ed" facs="#m-8ffc4ae9-cb43-4b5f-8e37-24886a542e49" label="text-like">And the newly baptized person</l><l xml:id="m-73bf4491-ecf1-49c0-b771-8e8acbe9c592" facs="#m-31e126aa-16d9-4e28-b3f8-87d95dc4a7aa" label="text-like">tabes off his cloihes to put on the new</l><l xml:id="m-388516ff-9f4b-438e-bee3-6320c7d19f9f" facs="#m-e2649de9-309d-4c49-a1ee-7991e4703e9b" label="text-like">white garment, which the celebrant</l><l xml:id="m-9227301b-eab0-4801-b15c-2b6840f07aad" facs="#m-18df3581-3c15-4892-aa4c-b173b21842f3" label="text-like">has just given him, or at least puts</l><l xml:id="m-08346074-a342-44aa-a01f-6aa7831c4dac" facs="#m-b1ce7bf1-8e0a-4a08-8b95-00cac7dc4d5d" label="text-like">it on over his ordinary clothes.</l><l xml:id="m-90d238ef-ffe7-4b6e-b60b-d6e526cb54df" facs="#m-fefb0fe9-72e7-4200-b13b-5f09202428bb" label="text-like">Then the celebrant places a lighted</l><l xml:id="m-8a9b6499-f310-4d3a-bd17-83907ef42ed3" facs="#m-4dd33bcc-9ce2-4c05-bb55-1de3ce32877e" label="text-like">He then gives to the child or the</l><l xml:id="m-af9c96d3-d7a9-4d6b-9e51-00a9fd27dc4f" facs="#m-f6571950-1934-4420-8182-6a397c3545bc" label="ambiguous">candle in his rient hand, savine:</l><l xml:id="m-967d7be2-7640-4bdf-979b-7c0def95daec" facs="#m-7cda5f0d-a555-4898-bdd5-0d7582ace884" label="ambiguous">godfather a lighted candle, savins:</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>