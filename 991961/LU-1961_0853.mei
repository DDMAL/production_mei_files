                  <syl /><neume facs="#m-041e860e-4b48-4f4d-b848-71584eb3fba4" type="punctum" xml:id="m-e5f2e560-69c2-4783-a19b-8e8ca2f3ba7d">
                    <nc xml:id="m-0602fb14-33d6-4289-b3db-acccc41d3ccc" pname="c" oct="4" />
