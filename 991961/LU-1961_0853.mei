                <syllable xml:id="m-dbd3c98b-c91a-4b03-9684-da4f845d2c9a">
                  <syl /><neume facs="#m-8cb81e6b-7982-4971-8516-a2ff0eac9f32" type="punctum" xml:id="m-69593f11-cc7d-4497-9d51-f5df57def61e">
