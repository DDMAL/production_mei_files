                  <syl /><neume facs="#m-dc8f7f23-f5af-4b8c-9796-09a5e3b5bb5c" type="punctum" xml:id="m-6cbd8740-d024-4a31-b919-c1b49e06bbaa">
                    <nc xml:id="m-64ae43fa-9107-4fa5-b9ad-0ef312f0b3e7" pname="c" oct="4" />
                  </neume>
