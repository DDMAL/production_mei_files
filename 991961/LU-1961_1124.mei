                  <syl /><neume facs="#m-1e93dbdf-b6af-46fc-ba28-2cfaf2dbd71b" type="punctum" xml:id="m-18b9db1b-9dc6-4de1-ac4f-d1ea569a8d2f">
                    <nc xml:id="m-3a57d0fc-73c6-478c-8f4e-00824673f184" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-7431926c-cfcc-4976-9d2a-74b639af69df">
                  <syl /><neume facs="#m-ad9fb7cc-fd49-4f5e-a5a9-5898da050824" type="punctum" xml:id="m-25311ebb-406e-4f12-8b12-676f6310e60e">
                    <nc xml:id="m-bb4ef1da-3b5a-48d0-b477-74bbcbbe3b5c" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-aac689a4-b72b-4ba2-acd3-6c1976cef8bc">
                  <syl /><neume facs="#m-44376370-00ae-4540-be6d-067fd262c029" type="punctum" xml:id="m-a9cde8b6-bb25-4e89-9e3c-045e12534955">
                    <nc xml:id="m-e7e65768-a599-4d8f-bde5-e7e402e0b11c" pname="a" oct="3" />
                  </neume>
