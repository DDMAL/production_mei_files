rx="576" lry="647" /><zone xml:id="m-38d699a7-f646-4c47-968e-f4555bedf2ea" ulx="170" uly="650" lrx="962" lry="696" /><zone xml:id="m-186a6c71-479b-4d5f-b14c-861563854452" ulx="377" uly="735" lrx="775" lry="780" /><zone xml:id="m-087a4bd5-6b18-41b2-adc7-81bc6a475d99" ulx="145" uly="736" lrx="203" lry="780" /><zone xml:id="m-dca3633f-6af2-4c2a-9ff2-75312ec6d048" ulx="913" uly="747" lrx="1011" lry="780" /><zone xml:id="m-68030143-ba87-4573-ad4c-1aecdf1dbbaa" ulx="173" uly="796" lrx="715" lry="836" /><zone xml:id="m-ec7af014-3398-4acf-ae2f-9119f0ea77a0" ulx="524" uly="849" lrx="643" lry="892" /><zone xml:id="m-c6cae936-2da5-4cc6-a5ca-ef93f73b148c" ulx="654" uly="869" lrx="672" lry="892" /><zone xml:id="m-5d006828-15bd-4303-8f2d-0cd05692be18" ulx="163" uly="895" lrx="1010" lry="930" /><zone xml:id="m-ba86fb93-7e2d-45bf-96b0-77dbd272ee06" ulx="147" uly="924" lrx="1009" lry="965" /><zone xml:id="m-039c0232-8dfd-4877-9b12-f289beaf19ed" ulx="147" uly="951" lrx="583" lry="988" /><zone xml:id="m-0698bbef-9603-49c1-8135-6f7f556f53ae" ulx="170" uly="1011" lrx="797" lry="1051" /><zone xml:id="m-ecf27ba9-5e8f-417d-8c17-c067a28f195d" ulx="521" uly="1065" lrx="631" lry="1099" /><zone xml:id="m-755a354c-fa86-491c-970f-5986e9d057f5" ulx="167" uly="1107" lrx="1010" lry="1151" /><zone xml:id="m-be1e05a7-c60b-4adb-ba2b-4cd59aaf23d2" ulx="150" uly="1137" lrx="1012" lry="1174" /><zone xml:id="m-3b565858-8d6e-4794-a3f4-826f08e0798c" ulx="148" uly="1166" lrx="825" lry="1203" /><zone xml:id="m-4a341b2f-09e0-4e85-b4b4-c90c2bf2faff" ulx="148" uly="1216" lrx="1010" lry="1256" /><zone xml:id="m-96ea97a6-7c82-4ec2-9f19-4691b47f6697" ulx="158" uly="1256" lrx="1011" lry="1294" /><zone xml:id="m-7e00136e-438f-4a5a-8ea2-690992bc79ba" ulx="150" uly="1287" lrx="574" lry="1324" /><zone xml:id="m-9f60734e-479c-4f66-b380-88e51dcf4e7a" ulx="581" uly="1291" lrx="1009" lry="1323" /><zone xml:id="m-4b3152df-d785-47b0-9553-da9220e48420" ulx="584" uly="1316" lrx="1009" lry="1346" /><zone xml:id="m-a571cb74-c23a-4f45-a6e1-f075ef0f8b6d" ulx="150" uly="1317" lrx="572" lry="1348" /><zone xml:id="m-80091c16-ba45-45db-8edc-bbe18a07416b" ulx="150" uly="1341" lrx="574" lry="1377" /><zone xml:id="m-f264632c-c5f1-4e8a-afda-c9ecf60ce152" ulx="581" uly="1341" lrx="1008" lry="1376" /><zone xml:id="m-0ed926b4-46d3-41b9-b91a-b027bc1d9aec" ulx="150" uly="1367" lrx="573" lry="1403" /><zone xml:id="m-61135330-1b34-44e7-b5ed-d9cce3fe2deb" ulx="581" uly="1367" lrx="1008" lry="1404" /><zone xml:id="m-bca57f4c-dec1-4865-af5d-465c0b1b87eb" ulx="585" uly="1395" lrx="1008" lry="1426" /><zone xml:id="m-99e0a4ba-b60a-41fa-8b02-17eb2a214b37" ulx="152" uly="1399" lrx="575" lry="1427" /><zone xml:id="m-5018b7c9-002d-4edd-9cc1-c3388bf12c7e" ulx="584" uly="1423" lrx="1008" lry="1454" /><zone xml:id="m-ee226259-e9ab-44e0-b569-05fa4dc7035b" ulx="154" uly="1425" lrx="576" lry="1454" /><zone xml:id="m-b8ddf9d6-5937-421a-baa8-065602538a30" ulx="151" uly="1447" lrx="571" lry="1485" /><zone xml:id="m-c7766af5-b91e-4828-855c-d87861f35eb3" ulx="586" uly="1447" lrx="1004" lry="1485" /><zone xml:id="m-ccd1aa2c-9990-4b4f-b0d6-0e005c471ab7" ulx="152" uly="1475" lrx="574" lry="1510" /><zone xml:id="m-65e4b518-9370-40c5-9e67-9897ef3ffc8d" ulx="588" uly="1479" lrx="1004" lry="1516" /><zone xml:id="m-19671fdc-d259-402a-9eca-075cb97eff02" ulx="152" uly="1504" lrx="579" lry="1539" /><zone xml:id="m-9d7fbc4a-8d6f-498e-b8b7-e567008f1cc1" ulx="873" uly="1511" lrx="960" lry="1541" /><zone xml:id="m-aada6668-ed87-486b-8c35-45220ca180d3" ulx="779" uly="1512" lrx="836" lry="1547" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-d3f07af8-5fb0-498a-a4f2-df16be1fc43b" n="1776" facs="#m-2b895bc5-107d-4255-a1a4-a2825a3b4538" /><div xml:id="m-b37282f6-c32b-4fa7-8898-53acb0a004a4">
            <lg xml:id="m-8ef26045-5059-4a05-b754-c60359ba34d9">
              <l xml:id="m-d53378ce-7c50-4a4e-982e-a6c64ffe1e76" facs="#m-bce1455a-8df7-427e-9939-7fc2655f7479" label="ambiguous">1554</l><l xml:id="m-d95a22ee-7e17-496e-aefa-ffede192b0a8" facs="#m-f614a670-91ab-4df2-937c-dd20feec05e4" label="ambiguous">Iuly II. 12.</l><l xml:id="m-56369291-aa3f-4cbd-993b-8c16fc2cb18e" facs="#m-325c92db-5088-4e6b-b39c-dda64e6736ef" label="ambiguous">Secret.</l><l xml:id="m-1c6e9348-a213-43c8-a4cb-a9b068a25395" facs="#m-44167c04-b5ec-4651-983f-0591f75c75b7" label="lyrics-like">NAcrificiis praeséntibus, quaésu-l votioni nostrae proficiant et salúti.</l><l xml:id="m-41e39b34-e413-45ec-b54f-6a990212f1c6" facs="#m-14188289-33d2-4c8a-95c9-2b01841bd730" label="lyrics-like">D mus, Dómine, inténde placátus:</l><l xml:id="m-4bf77ac8-d669-4605-882a-9db55b101470" facs="#m-9922773c-2653-4a3d-8914-3b1baeed9d07" label="lyrics-like">Per Dóminum nostrum.</l><l xml:id="m-66244894-8a62-4ce0-ac99-46ec19455d85" facs="#m-e95158df-30cb-4ce4-880b-ba769d6ba501" label="lyrics-like">et intercedéntibus Sanctis tuis, de¬</l><l xml:id="m-58b2a9db-d15a-4565-9a2f-72bdaa217f1d" facs="#m-fdb3878b-2ec4-463e-b47b-e1a93d2775be" label="ambiguous">Postcommunion.</l><l xml:id="m-de78ffea-50b7-4fc8-8c51-820023b78c08" facs="#m-4b7a2339-6dda-45d2-a1e3-7f7400f7419c" label="lyrics-like">Uaésumus, omnípotens Deus: cujus per haec mystéria pignus ac¬</l><l xml:id="m-372cac6f-235a-4eb4-92d3-69a46e23a881" facs="#m-2d5ff695-33e2-429d-b0d3-43e66073ae0f" label="lyrics-like">U ut intercedéntibus Sanctis tuis,</l><l xml:id="m-74aa020d-59bd-450a-95e8-289c7e55b99d" facs="#m-0876cad3-055e-4c16-8663-848282dd6dc5" label="lyrics-like">cépimus. Per Dóminum nostrum.</l><l xml:id="m-af85be74-6fc4-4250-a708-808fc484d9ba" facs="#m-1aea1749-1408-403a-9c93-29b5f78e98cc" label="lyrics-like">ilius salutáris capiámus efféctum;</l><l xml:id="m-a614f3aa-f33e-4495-b762-95fb1cccf303" facs="#m-60fc586b-ca51-4f7f-9061-a93612c08a99" label="text-like">St. Pius I, Pope and Martyr.</l><l xml:id="m-776d987b-3717-4c0f-81cc-7c4e0328cb05" facs="#m-6969d0f7-f04a-496b-b589-f3017c75e066" label="ambiguous">I1.</l><l xml:id="m-06f4beb0-1d52-418c-b27b-09f44d141dfe" facs="#m-901bc9b6-93ec-4577-a0c7-08ab2b3b539b" label="ambiguous">Simple.</l><l xml:id="m-828b2a74-5c90-476d-b6e8-88f61d9bef5c" facs="#m-02c3f348-b1ee-43d6-8ab1-7e2332a8c6fb" label="ambiguous">Collect.</l><l xml:id="m-bdf8b6f9-a7b7-40b4-b4a5-68d081c0bfc4" facs="#m-9a2f66a8-0c86-425c-a62c-25142af00d7f" label="lyrics-like">(Regem tuum, Pastor aetérne,l protectióne custódi; * quem totius</l><l xml:id="m-1e9b2eb0-b28a-44e3-8852-d7092a99f1ca" facs="#m-7d84369a-529e-463b-a825-0927e5f5ba8b" label="lyrics-like">(Y placátus inténde : t et per beä-lEcclésiae praestitisti esse pastórem.</l><l xml:id="m-3d0455e4-fadc-4411-9dbd-67055a8c100f" facs="#m-d1bfd219-df51-41b7-89ec-5ed4c2b27874" label="lyrics-like">tum Pium Mártyrem tuum atque Per Dóminum.</l><l xml:id="m-ff2bf271-1410-40e6-b94e-a40a918eb9fd" facs="#m-f74e7192-33b4-487b-b98e-94a5238277a1" label="lyrics-like">Summum Pontíficem, perpétua</l><l xml:id="m-f8941c0e-2e00-4cb2-8a7b-217730fe4cda" facs="#m-38d699a7-f646-4c47-968e-f4555bedf2ea" label="lyrics-like">Secret. Oblátis. p. 1122e. and Postcommunion. Refectióne, p. 1123.</l><l xml:id="m-6482d4ab-cc72-42aa-b5fa-83e5c072b112" facs="#m-186a6c71-479b-4d5f-b14c-861563854452" label="ambiguous">St. John Gualbert, Abbot.</l><l xml:id="m-77487c91-d42b-48e1-b464-733b9ddd9812" facs="#m-087a4bd5-6b18-41b2-adc7-81bc6a475d99" label="ambiguous">12.</l><l xml:id="m-1d5310da-2a77-4835-9869-df58c85629a4" facs="#m-dca3633f-6af2-4c2a-9ff2-75312ec6d048" label="ambiguous">Double.</l><l xml:id="m-9325997a-c08f-4f80-b1de-b9b59b98aec8" facs="#m-68030143-ba87-4573-ad4c-1aecdf1dbbaa" label="lyrics-like">Mass. Os jústi. p. 1206, except the foltowing:</l><l xml:id="m-6724bdcb-efdb-4e78-8e2c-8756ffc61bc0" facs="#m-ec7af014-3398-4acf-ae2f-9119f0ea77a0" label="ambiguous">Collect.</l><l xml:id="m-988bab2c-da96-4b68-9e2c-23d0ece85a7b" facs="#m-c6cae936-2da5-4cc6-a5ca-ef93f73b148c" label="ambiguous">:</l><l xml:id="m-75f0583f-4ad9-41ad-8228-5e8fb972b0e6" facs="#m-5d006828-15bd-4303-8f2d-0cd05692be18" label="lyrics-like">TNtercéssio nos, quaésumus Dó-l non valémus, * ejus patrocinio as¬</l><l xml:id="m-406defa4-21d3-4bd6-b1b4-4e97fac3fc64" facs="#m-ba86fb93-7e2d-45bf-96b0-77dbd272ee06" label="lyrics-like">L mine, beáti Joánnis Abbátis com-[ sequámur. Per Dóminum nostrum.</l><l xml:id="m-7f3545c7-31db-48ea-9c30-24c32d233486" facs="#m-039c0232-8dfd-4877-9b12-f289beaf19ed" label="lyrics-like">méndet : † ut quod nostris méritis</l><l xml:id="m-fbd142cc-2e6a-490c-b917-e25955e5fd3f" facs="#m-0698bbef-9603-49c1-8135-6f7f556f53ae" label="text-like">Commemoration or SS. Nabor and Felix, Martyrs.</l><l xml:id="m-835b1849-c734-4f06-814f-13bcd5473ac0" facs="#m-ecf27ba9-5e8f-417d-8c17-c067a28f195d" label="ambiguous">Collect.</l><l xml:id="m-c01fe5a5-6b3e-4c3d-96b9-20cb2986b781" facs="#m-755a354c-fa86-491c-970f-5986e9d057f5" label="lyrics-like">ORaesta, quaésumus Dómine :*]litia celebránda non déserunt; ita</l><l xml:id="m-1cc06631-a054-4ea3-9895-71ce8d0f6e3b" facs="#m-be1e05a7-c60b-4adb-ba2b-4cd59aaf23d2" label="lyrics-like">ut sicut nos sanctórum Márty-ljúgiter suffrágiis comiténtur. Per</l><l xml:id="m-197eacd9-8414-428e-9718-4f43d79c2ec5" facs="#m-3b565858-8d6e-4794-a3f4-826f08e0798c" label="lyrics-like">rum tuórum Náboris et Felicisnata-l Dóminum nostrum.</l><l xml:id="m-4b393804-7375-4e4b-a478-a775910eb468" facs="#m-4a341b2f-09e0-4e85-b4b4-c90c2bf2faff" label="ambiguous">†Sequentia sancti Evangelii secundum Matthaeum. Matth. S.6</l><l xml:id="m-18d67366-9441-46f6-b3fc-199aa1b14067" facs="#m-96ea97a6-7c82-4ec2-9f19-4691b47f6697" label="lyrics-like">TN illo témpore: Dixit Jesus discí-] et malos, et pluit super justos et</l><l xml:id="m-7822ffa8-923e-4a42-8981-5fb30ddb84ea" facs="#m-7e00136e-438f-4a5a-8ea2-690992bc79ba" label="lyrics-like">L pulis suis : Audístis quia dictum</l><l xml:id="m-a23ac030-932c-491b-89e4-8451522c14dd" facs="#m-9f60734e-479c-4f66-b380-88e51dcf4e7a" label="lyrics-like">injústos. Si enim dilígitis eos qu</l><l xml:id="m-2837e4a9-da21-4cf8-9654-42c725219376" facs="#m-4b3152df-d785-47b0-9553-da9220e48420" label="lyrics-like">võs díligunt, quam mercédem habé.</l><l xml:id="m-7642141b-c9a4-43c9-ab0a-cd9c948eb8b3" facs="#m-a571cb74-c23a-4f45-a6e1-f075ef0f8b6d" label="lyrics-like">est : Diliges próximum tuum, et</l><l xml:id="m-c86de614-83b8-47f3-b152-24e1b94f6268" facs="#m-80091c16-ba45-45db-8edc-bbe18a07416b" label="lyrics-like">ódio habébis inimícum tuun. Ego</l><l xml:id="m-5def0bb5-703d-4474-8a1f-67d7ec28efbe" facs="#m-f264632c-c5f1-4e8a-afda-c9ecf60ce152" label="lyrics-like">bitis? Nonne et publicáni hoc fá</l><l xml:id="m-b940aa72-e189-486f-9fcc-fcdfc76a3ecf" facs="#m-0ed926b4-46d3-41b9-b91a-b027bc1d9aec" label="ambiguous">autem dico vobis : Diligite irimicos</l><l xml:id="m-1a2aa6e5-020b-4831-8b2b-1288784ed877" facs="#m-61135330-1b34-44e7-b5ed-d9cce3fe2deb" label="lyrics-like">ciunt? Et si salutavéritis fratres</l><l xml:id="m-86f0dc6f-899a-43d9-b722-56fae8725292" facs="#m-bca57f4c-dec1-4865-af5d-465c0b1b87eb" label="lyrics-like">vestros tantum, quid ámplius fáci</l><l xml:id="m-ed26bc3b-1216-4ab7-85b2-c4c27ae6bedc" facs="#m-99e0a4ba-b60a-41fa-8b02-17eb2a214b37" label="lyrics-like">vestros, benefácite his qui cdérunt</l><l xml:id="m-393488e4-a26c-4cb0-8307-172efbaf4742" facs="#m-5018b7c9-002d-4edd-9cc1-c3388bf12c7e" label="lyrics-like">tis? Nonne et éthnici hoc̃ fáciunti</l><l xml:id="m-587890bb-dac1-4a32-9b28-eecd32fd0ed9" facs="#m-ee226259-e9ab-44e0-b569-05fa4dc7035b" label="lyrics-like">vos, et oráte pro persequénibus et</l><l xml:id="m-8e2a4ee3-2a59-4b2d-88d0-2143769ba7cd" facs="#m-b8ddf9d6-5937-421a-baa8-065602538a30" label="lyrics-like">calumniántibus vos; ut stis filii</l><l xml:id="m-2460850c-9439-47f7-aef6-3caaae562ad6" facs="#m-c7766af5-b91e-4828-855c-d87861f35eb3" label="lyrics-like">Estóte ergo vos perfécti, sicut e</l><l xml:id="m-e5bd7153-6995-4675-941a-aab670e197f2" facs="#m-ccd1aa2c-9990-4b4f-b0d6-0e005c471ab7" label="ambiguous">Patris vestri qui in caelis est : qui</l><l xml:id="m-9cbccc53-ab42-4bc8-a84b-d4030d51fe65" facs="#m-65e4b518-9370-40c5-9e67-9897ef3ffc8d" label="lyrics-like">Pater vester caeléstis perféctus est</l><l xml:id="m-0772d239-278b-42e9-b5ab-8042ad37664b" facs="#m-19671fdc-d259-402a-9eca-075cb97eff02" label="ambiguous">solem suum oriri facit super bonos</l><l xml:id="m-e0d5ae4c-c6bd-4a69-b96f-172b4e2a3496" facs="#m-9d7fbc4a-8d6f-498e-b8b7-e567008f1cc1" label="ambiguous">R</l><l xml:id="m-aef0e5c2-c3df-4506-8697-ed0bb111b0de" facs="#m-aada6668-ed87-486b-8c35-45220ca180d3" label="lyrics-like">eñ¬</l></lg></div></section></score></mdiv></body></music>
