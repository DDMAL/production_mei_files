" /><zone xml:id="m-52c0ae22-cad2-4f11-a5ff-d69cd12c2a3b" ulx="463" uly="607" lrx="599" lry="642" /><zone xml:id="m-a8bc11f5-3918-4159-bc07-c45d3e64a0f9" ulx="21" uly="631" lrx="463" lry="668" /><zone xml:id="m-47869459-4b06-4bb2-b766-9f2220a9c33a" ulx="48" uly="667" lrx="822" lry="707" /><zone xml:id="m-8e2bb2d8-d20d-49ca-a458-de73442badf5" ulx="409" uly="713" lrx="511" lry="746" /><zone xml:id="m-9d1d2920-85ca-4758-a90a-4ee0e07384b2" ulx="31" uly="746" lrx="894" lry="779" /><zone xml:id="m-270d8c2f-4a92-4dbb-9784-85add19a69ae" ulx="24" uly="771" lrx="891" lry="808" /><zone xml:id="m-6587d6a5-dbdc-4d95-88ce-0f8c7f0fb535" ulx="21" uly="801" lrx="707" lry="838" /><zone xml:id="m-f3caba94-ea8c-47ee-a900-df9a585e30b1" ulx="295" uly="840" lrx="617" lry="875" /><zone xml:id="m-0d8878d8-69e5-47f3-ac67-8f349107d9c9" ulx="33" uly="874" lrx="891" lry="914" /><zone xml:id="m-ef0cfbee-c908-419c-98a2-9ad1dfdfd304" ulx="23" uly="910" lrx="874" lry="945" /><zone xml:id="m-b27e5cbd-efe7-4d99-9ef2-78fd7bc2e192" ulx="22" uly="937" lrx="463" lry="971" /><zone xml:id="m-96e8f0c7-0ead-4afd-8fff-9d03f1cf47af" ulx="338" uly="967" lrx="577" lry="1003" /><zone xml:id="m-ce3f61d7-720d-47a6-b6c2-b71b24ddc18c" ulx="64" uly="994" lrx="893" lry="1040" /><zone xml:id="m-4c78933f-544a-40b9-817e-10e5b54908f6" ulx="24" uly="1024" lrx="455" lry="1065" /><zone xml:id="m-1a3f68d7-2f04-4fd5-90f5-ef0ad3e3ca56" ulx="466" uly="1027" lrx="601" lry="1060" /><zone xml:id="m-061c6489-8e8b-48e8-bb80-2ee3c5e7c3f6" ulx="22" uly="1056" lrx="453" lry="1095" /><zone xml:id="m-054abfdd-2937-400f-ba7b-2ab43ebf0784" ulx="227" uly="1097" lrx="689" lry="1134" /><zone xml:id="m-a8b6d49a-415b-4e87-bc7e-11d4b75e4676" ulx="42" uly="1131" lrx="894" lry="1176" /><zone xml:id="m-4e262aea-20bb-4803-8d50-0a08c9205b55" ulx="24" uly="1165" lrx="895" lry="1206" /><zone xml:id="m-305f869c-ea96-43d5-bf38-fc486e01d319" ulx="22" uly="1196" lrx="604" lry="1235" /><zone xml:id="m-27ff8cd6-4091-49c4-a784-760413cde9de" ulx="18" uly="1271" lrx="802" lry="1324" /><zone xml:id="m-b4e18414-1e5f-47bd-9d36-074778376803" ulx="363" uly="1323" lrx="550" lry="1362" /><zone xml:id="m-f42f5a45-3a72-4bfb-bf9a-fc1371d46e8c" ulx="312" uly="1374" lrx="595" lry="1412" /><zone xml:id="m-fa7bcc2a-58b3-49e3-b3f9-381d37325e87" ulx="43" uly="1417" lrx="891" lry="1452" /><zone xml:id="m-9483f215-0cb5-41a6-9b5a-e1dbed04974a" ulx="18" uly="1444" lrx="475" lry="1477" /><zone xml:id="m-aab7c4e5-d9d8-49da-93d7-cdde2f3c4300" ulx="46" uly="1481" lrx="585" lry="1514" /><zone xml:id="m-bd2a7f0e-7bf5-4b74-aa77-88e663bea426" ulx="45" uly="1506" lrx="689" lry="1540" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-895bfe9c-e33b-49f7-b200-43e6569d2342" n="1849" facs="#m-651fe336-53ab-40eb-b0ee-5316f87ab098" /><div xml:id="m-12a0fe5b-46d2-465c-8f27-85c5bedd9be2">
            <lg xml:id="m-371381cf-34ee-4eea-890f-d99a1daca211">
              <l xml:id="m-c307ed3a-9b14-4902-aa10-45f5c5c8ca1b" facs="#m-e195eaeb-95ee-46ae-a3a8-85105e26ef90" label="ambiguous">August 28. 29.</l><l xml:id="m-5793467a-8ab0-4ee9-b12e-3ba3a0a854bf" facs="#m-bf0997a8-b2e4-4fe9-bdc7-e3dc2794f5d1" label="ambiguous">iei7</l><l xml:id="m-6ef3f2b3-e6e0-471a-bc59-9cb6d5345722" facs="#m-59a47cfb-8e57-4e0a-ae2e-cf260a7a6580" label="text-like">28. St. Augustine, Bishop, Conf. and Doctor of the Church.</l><l xml:id="m-1169340e-274b-48c7-acad-1d150197232f" facs="#m-44fa8eaa-9fd3-48aa-8323-7555fd4c2a75" label="ambiguous">Double.</l><l xml:id="m-8bb71e56-3137-453e-a4c6-8204da3e4f30" facs="#m-bd45ee9b-ebfc-485a-8376-87eafe427f4b" label="lyrics-like">At Ist ana 2nd Vespers, at Magn. Ant. O Dóctor... beâte Augustine.</l><l xml:id="m-02dc3ef0-fbf6-4d51-8159-b89241e1f04a" facs="#m-eebba274-b5a5-4300-8174-e1ad238c3a90" label="ambiguous">p. 262t.</l><l xml:id="m-b79434cb-0754-498f-a827-a363a5a416b6" facs="#m-48edbf41-53a2-4b8a-8031-400bd115600e" label="lyrics-like">Mass. In médio. p. 1190, except the following:</l><l xml:id="m-cae8fd0b-0937-4fb4-a127-1b631a1fdf8f" facs="#m-6db113d9-b8ac-4adc-a7dd-5220ac2828ce" label="ambiguous">Collect.</l><l xml:id="m-77b4e6ae-5a1f-4c20-8482-94f2f9f3e3e6" facs="#m-d7cc8067-3b93-47b2-8309-b6877ed11801" label="lyrics-like">HDésto supplicatiónibus nostris (Confessóre tuo atque Pontifice,</l><l xml:id="m-e053e5a4-c825-44dd-966e-2535cfbea2eb" facs="#m-12e75b64-fd56-46f4-9fb4-887962dbd920" label="ambiguous">A omnipotens Deus: t et quibus</l><l xml:id="m-9a28d77f-0e9e-46c6-9c63-cfe87028296b" facs="#m-c5e8fd6f-cd4d-479a-98cc-4b157460f956" label="lyrics-like">consuétae misericórdiae tribue be¬</l><l xml:id="m-008e1d9a-bec2-4786-88df-46bfc37ea9c5" facs="#m-79d971b0-edbf-40ba-a5c4-56dd84c3629e" label="lyrics-like">niduciam sperándae pietátis indúl¬</l><l xml:id="m-2d4b9f88-2c56-4b3f-b5d1-d915643776f7" facs="#m-6584ce76-b705-4dac-8f24-50b0918bb873" label="lyrics-like">nignus efféctum. Per Dóminum.</l><l xml:id="m-65aa6761-bfc6-48d8-910b-c89c29ce8d07" facs="#m-3670fb83-6029-46bc-9a6c-194ce1734574" label="lyrics-like">ges, intercedénte beâto Augustino</l><l xml:id="m-6b3048c0-a214-4d2e-bc25-34a51ba980bf" facs="#m-8bf77d03-d36a-440b-bd79-43427339697a" label="text-like">Commemoration of S. Hermes Martyr.</l><l xml:id="m-5f2f74e3-6e18-4572-aa0f-f6149657875f" facs="#m-cef3f2a3-2e3f-4f85-8e1e-5a25ddade704" label="ambiguous">Collect.</l><l xml:id="m-13dc72c9-a5db-467d-84f6-e6013d8b8979" facs="#m-3cc53bbe-5b24-4736-ba14-21188160f4e3" label="lyrics-like">Eus, qui beátum Hermétem Már-] tuo próspera mundi despícere, et</l><l xml:id="m-c5f465fc-da65-45ba-9f37-c42bd64e6202" facs="#m-77090b01-64fc-4948-82e5-f66814706db6" label="lyrics-like">U tyrem tuum virtúte constántiae</l><l xml:id="m-edfa1ae4-1d5d-4acb-b007-d42a4bd15c38" facs="#m-0cb21428-c179-4526-aa0e-5681c68427f5" label="lyrics-like">nulla ejus advérsa formidáre. Per</l><l xml:id="m-c7934fb9-3668-47bb-97f2-e7575fd33254" facs="#m-e206d526-2d0b-4761-8569-fac911470988" label="lyrics-like">in passióne roborásti: * ex eius</l><l xml:id="m-dd555a5d-7910-4257-a6e9-9e08fd1b47a4" facs="#m-52c0ae22-cad2-4f11-a5ff-d69cd12c2a3b" label="lyrics-like">Dóminúm.</l><l xml:id="m-0b6de060-bfca-4d1f-a431-dd9f2359fce5" facs="#m-a8bc11f5-3918-4159-bc07-c45d3e64a0f9" label="lyrics-like">nobis imitatióne tribue; pro amóre!</l><l xml:id="m-66308d3b-94ca-48de-8677-acc0ab83e657" facs="#m-47869459-4b06-4bb2-b766-9f2220a9c33a" label="lyrics-like">Alleluia, allelúia. V. Invéni David. p. 1489. The Credo. 1s said.</l><l xml:id="m-98787895-3caf-4ee0-b307-632810b51ae4" facs="#m-8e2bb2d8-d20d-49ca-a458-de73442badf5" label="ambiguous">Secret.</l><l xml:id="m-70d7f586-db17-4931-985f-38bd16c2e0c3" facs="#m-9d1d2920-85ca-4758-a90a-4ee0e07384b2" label="lyrics-like">CAncti Augustíni Pontíficis tui nera nostra conciliet, et tuam nobis</l><l xml:id="m-ef59513b-2aab-4b7c-807d-4bc9a266afde" facs="#m-270d8c2f-4a92-4dbb-9784-85add19a69ae" label="lyrics-like">D atque Doctóris nobis, Dómine, indulgéntiam semper obtineat. Per</l><l xml:id="m-b176604c-b11b-44ee-971d-4ae3863522fb" facs="#m-6587d6a5-dbdc-4d95-88ce-0f8c7f0fb535" label="lyrics-like">pia non desit orátio: quae et mú- Dóminum nostrum.</l><l xml:id="m-32a7d3aa-2d43-4ef5-a9b5-ea3fe1ff14ce" facs="#m-f3caba94-ea8c-47ee-a900-df9a585e30b1" label="text-like">Of St. Hermes. Secret.</l><l xml:id="m-f297c866-1c4d-41b4-9f33-144f17915af1" facs="#m-0d8878d8-69e5-47f3-ac67-8f349107d9c9" label="lyrics-like">NAcrificium tibi Dómine laudis ]ut quod illis cóntulit glóriam, nobis</l><l xml:id="m-2533f18b-db4e-4e58-945a-1be5e8fbd307" facs="#m-ef0cfbee-c908-419c-98a2-9ad1dfdfd304" label="lyrics-like">D offérimus in tuórum commemo- prosit ad salútem. Per Dóminum.</l><l xml:id="m-3274bd60-118b-4d2c-9101-7b3b76857a01" facs="#m-b27e5cbd-efe7-4d99-9ef2-78fd7bc2e192" label="lyrics-like">ratióne sanctórum : da quaésumus;</l><l xml:id="m-74525063-76eb-45a3-b701-f3fb5eba87b5" facs="#m-96e8f0c7-0ead-4afd-8fff-9d03f1cf47af" label="ambiguous">Postcommunion.</l><l xml:id="m-8089f1e9-ee32-42d6-b343-ec7769822941" facs="#m-ce3f61d7-720d-47a6-b6c2-b71b24ddc18c" label="lyrics-like">T nobis Dómine tua sacrificia quaésumus, precátor accédat. Per</l><l xml:id="m-f3bd46f7-274c-4475-afe1-1854da4628f4" facs="#m-4c78933f-544a-40b9-817e-10e5b54908f6" label="lyrics-like">Ul dent salútem, beátus Augustínus</l><l xml:id="m-e24cf92f-e532-4b44-8531-55bd0c817ebc" facs="#m-1a3f68d7-2f04-4fd5-90f5-ef0ad3e3ca56" label="lyrics-like">Dóminum.</l><l xml:id="m-4fe0e6ff-df5d-4d1f-962d-b6796b22b706" facs="#m-061c6489-8e8b-48e8-bb80-2ee3c5e7c3f6" label="lyrics-like">Póntifex tuus et Doctor egrégius,</l><l xml:id="m-b3d75949-82e1-46ab-bace-d3f9a3a37fa4" facs="#m-054abfdd-2937-400f-ba7b-2ab43ebf0784" label="text-like">of St. Hermes. Postcommunion.</l><l xml:id="m-5b68ee0f-b591-4e6c-90e8-79dc87ebc6aa" facs="#m-a8b6d49a-415b-4e87-bc7e-11d4b75e4676" label="lyrics-like">OEpléti Dómine benedictióne cae-] méte Mártyre tuo, quae humiliter</l><l xml:id="m-9f53c80d-f502-4d58-9500-8d583b6c620c" facs="#m-4e262aea-20bb-4803-8d50-0a08c9205b55" label="lyrics-like">L iésti, quaésumus cleméntiam gérimus, salúbriter sentiámus. Per</l><l xml:id="m-5dae76b2-4f40-4d7d-bd16-714fa0628118" facs="#m-305f869c-ea96-43d5-bf38-fc486e01d319" label="lyrics-like">tuam : ut intercedénte beâto Her-) Dóminum.</l><l xml:id="m-2ecb25ba-5109-45dc-bec3-248f4d74903d" facs="#m-27ff8cd6-4091-49c4-a784-760413cde9de" label="text-like">29. The Beheading of St. John the Baptist.</l><l xml:id="m-662ff102-3f38-41ac-a7a3-84c53942065a" facs="#m-b4e18414-1e5f-47bd-9d36-074778376803" label="ambiguous">Dauble major.</l><l xml:id="m-09e038f6-8b11-4cfc-aae8-037bbd917dce" facs="#m-f42f5a45-3a72-4bfb-bf9a-fc1371d46e8c" label="text-like">AT FIRST VESPERS.</l><l xml:id="m-8648b542-5266-49ec-817a-599ee07bdd24" facs="#m-fa7bcc2a-58b3-49e3-b3f9-381d37325e87" label="lyrics-like">All as at second Vespers, p. 1620, except the fifth psalm, which is Laudáte</l><l xml:id="m-4f71c817-ed45-40aa-b137-1c0c6b0276e5" facs="#m-9483f215-0cb5-41a6-9b5a-e1dbed04974a" label="lyrics-like">Dóminum. 4. A. 167, and the following:</l><l xml:id="m-c521dda3-daa9-4218-ab8d-45804e55f1e8" facs="#m-aab7c4e5-d9d8-49da-93d7-cdde2f3c4300" label="lyrics-like">V. Glória et honóre coronásti éum Dómine.</l><l xml:id="m-050284cf-5f0a-430f-8621-6dbecebd8027" facs="#m-bd2a7f0e-7bf5-4b74-aa77-88e663bea426" label="lyrics-like">R. Et constituisti éum super ópera mánuum tuárum.</l></lg></div></section></score></mdiv></body></music>
</mei>