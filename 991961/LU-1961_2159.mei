" xml:id="m-e3f6f491-7f84-406e-8a85-6ddcd9282a8b"><nc xml:id="m-c099bb36-226c-4178-81d4-c24b3224f090" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-bd68a9b0-7e5e-4fca-befb-eb92a83cd480"><syl /><neume facs="#m-24f0f5b1-7e8f-48ee-b167-faa7764c7343" type="punctum" xml:id="m-c056c643-e9ec-4818-9dda-ba8ea73b42a2"><nc xml:id="m-c91d1a58-06c4-43e3-9202-0fc59e9f914d" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-95a5bdac-027d-4d6f-beed-ec29d1587864"><syl /><neume facs="#m-2dc20d0f-85f8-4e1a-b4ac-19531747b7d6" type="punctum" xml:id="m-fb92f5fc-5f1d-4781-8216-0fe07295b3d2"><nc xml:id="m-179ce1a3-cde4-46b4-b4d5-5192c922403c" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-cffc987b-6919-4540-b0ea-0a7831608706"><syl /><neume facs="#m-e2e320ff-ae9d-4c0d-b454-683761456273" type="punctum" xml:id="m-4844be76-434a-4f0b-89fa-5d988030b046"><nc xml:id="m-67e636bc-8fd5-491a-b1f2-566612770d5a" pname="a" oct="3" /></neume></syllable><divLine xml:id="m-9b0ea406-9f4a-4a64-8299-1a47fd7e9321" facs="#m-88760652-bb80-49cc-8ab4-e555ce289210" form="maxima" /><syllable xml:id="m-003ac02b-e067-4a56-a9b3-05910ed7574f">
