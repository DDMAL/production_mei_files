" /><zone xml:id="m-29c0000a-4d11-4263-8fc3-2159878e974c" ulx="50" uly="631" lrx="484" lry="669" /><zone xml:id="m-22ee699a-8679-47a1-900c-7e852fff9c90" ulx="495" uly="632" lrx="930" lry="671" /><zone xml:id="m-2320a338-7b65-4931-9326-7ee2d9dcf6e7" ulx="75" uly="659" lrx="485" lry="693" /><zone xml:id="m-488f689b-dabf-4d6e-aba1-ab5819181dcf" ulx="496" uly="664" lrx="929" lry="695" /><zone xml:id="m-37940cf6-5177-4722-8906-cb40de076ed1" ulx="50" uly="689" lrx="927" lry="723" /><zone xml:id="m-78cfaa12-9bb6-4c08-89a3-9526f930b3a5" ulx="50" uly="727" lrx="930" lry="762" /><zone xml:id="m-a0d8a016-0232-444f-b95b-43e94027844e" ulx="74" uly="754" lrx="487" lry="791" /><zone xml:id="m-856466ba-18b7-4fea-95d1-94adc99ad802" ulx="496" uly="756" lrx="864" lry="787" /><zone xml:id="m-90351086-3a8e-4719-bcd0-674c534fa10b" ulx="51" uly="783" lrx="490" lry="821" /><zone xml:id="m-58638ab9-2f50-45ba-96df-99c2fe29034a" ulx="51" uly="823" lrx="485" lry="862" /><zone xml:id="m-034ffefd-4836-4f21-b722-88163ae270a0" ulx="496" uly="826" lrx="931" lry="859" /><zone xml:id="m-d5c4ddcd-0da7-4558-ab6b-9117b96b8782" ulx="77" uly="852" lrx="487" lry="890" /><zone xml:id="m-e591fbd6-155e-4f36-938c-cc1155ecaf41" ulx="495" uly="856" lrx="931" lry="885" /><zone xml:id="m-1533f850-84f6-430e-8fdd-03f34952a0b7" ulx="495" uly="878" lrx="931" lry="914" /><zone xml:id="m-dbe998fe-f303-4001-accc-56d478739869" ulx="50" uly="881" lrx="486" lry="917" /><zone xml:id="m-e553378d-4ce3-4715-906d-a877db628f69" ulx="494" uly="907" lrx="931" lry="940" /><zone xml:id="m-580df1f9-715f-4596-9f6f-4e279b46e8a3" ulx="50" uly="910" lrx="487" lry="944" /><zone xml:id="m-d0597839-a5d4-400f-b1d9-99db00aed69d" ulx="495" uly="933" lrx="929" lry="966" /><zone xml:id="m-59396fdb-00fc-4cac-a86e-d5a71b435393" ulx="52" uly="936" lrx="487" lry="972" /><zone xml:id="m-983a41d6-8974-4643-af4c-c60cd8e0da4c" ulx="496" uly="959" lrx="932" lry="994" /><zone xml:id="m-905bde94-0a9d-463a-aa7e-5cf7e73cd352" ulx="52" uly="962" lrx="487" lry="1002" /><zone xml:id="m-b0f0393d-e1d8-4551-96ad-aee3e7c071ee" ulx="57" uly="986" lrx="928" lry="1030" /><zone xml:id="m-4c16937d-5062-4cff-83ec-7ed6f6cc6a29" ulx="57" uly="1016" lrx="926" lry="1058" /><zone xml:id="m-84bd9915-0630-4c95-bc8a-7a06e80c96e2" ulx="53" uly="1040" lrx="693" lry="1082" /><zone xml:id="m-4d9220ff-43b5-4424-ac70-02ecefc2fd3c" ulx="82" uly="1091" lrx="552" lry="1136" /><zone xml:id="m-1ce96119-97e4-426d-be11-99ea457ca096" ulx="83" uly="1136" lrx="547" lry="1179" /><zone xml:id="m-fe1a73cd-b62f-47cc-8250-7281d16e5467" ulx="81" uly="1166" lrx="488" lry="1205" /><zone xml:id="m-eef88b9d-ce29-40d3-8447-ec8002975f85" ulx="84" uly="1217" lrx="609" lry="1259" /><zone xml:id="m-29ea933d-dd45-4f5f-a9a0-a0f3e42d8e3c" ulx="77" uly="1267" lrx="719" lry="1300" /><zone xml:id="m-891e0e23-39ea-457e-9498-ac4398d5bf14" ulx="76" uly="1299" lrx="515" lry="1330" /><zone xml:id="m-a0bc5e1e-db63-473e-ab22-90f82c4ebe42" ulx="77" uly="1342" lrx="537" lry="1380" /><zone xml:id="m-6dff1474-635c-46b7-a0d6-afb1fb78e924" ulx="75" uly="1385" lrx="861" lry="1429" /><zone xml:id="m-9750a3fd-f5cb-4fc5-a4d9-41c67d2cb332" ulx="74" uly="1414" lrx="208" lry="1454" /><zone xml:id="m-638a0bc5-10bf-42fc-ba2a-8f755ec657a0" ulx="73" uly="1465" lrx="926" lry="1507" /><zone xml:id="m-4c5a3afe-0bbb-441b-8e9a-143e4412949d" ulx="48" uly="1495" lrx="353" lry="1531" /><zone xml:id="m-3b674b38-9e26-4d4d-a72b-c406a965620c" ulx="72" uly="1536" lrx="637" lry="1573" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-ce501562-48cf-4cb1-a633-0a9275abb471" n="2133" facs="#m-9a4f4377-bd14-4af6-8527-34c21605a6c6" /><div xml:id="m-2c9b8993-51f2-44f5-95b2-f32f8dab0899">
            <lg xml:id="m-5774286c-e971-43f8-a075-1120e9a33976">
              <l xml:id="m-610d083f-d8e9-41cf-8ae0-ae05dab7013c" facs="#m-c5156b53-641d-4e37-8f44-8e45f2c3eadf" label="text-like">Prayers for the Forty Hours.</l><l xml:id="m-cc0c5c2c-ba9a-4515-a0c1-1967f3815f7e" facs="#m-f28fc1dd-3f08-42d9-8305-9c369aa4cbab" label="text-like">From Christmas to the Purification:</l><l xml:id="m-03bc77bf-1ae1-47bb-b8e0-b2fd445ece42" facs="#m-822728a3-fae8-4d85-a590-374d55210e0a" label="lyrics-like">Eus, qui salútis aetérnae, beátae [nobis intercédere sentiámus,* per</l><l xml:id="m-cbb31424-a4df-400f-a168-269023323155" facs="#m-2efd83b4-0142-43bd-8f70-def8a8d92fe2" label="lyrics-like">I Mariae virginitâte fecúnda, hu¬</l><l xml:id="m-ce7d1376-c33c-4870-9b98-1b7fb3866ba3" facs="#m-459493f1-7ec5-479c-9fcb-75ef3a34e880" label="lyrics-like">quam meruimus auctórem vitae</l><l xml:id="m-dc4b3c24-7292-45bb-ba19-9f23fa37bb15" facs="#m-4fd937ec-7805-48b5-92bd-f0c79a86e1c1" label="lyrics-like">máno géneri praémia praestitisti : t</l><l xml:id="m-25462bc0-140d-4227-8e5d-ce7ab37c15f2" facs="#m-72d3d784-8e5d-4160-920d-b258843ab82d" label="lyrics-like">suscipere, Dóminum nostrum Jesum</l><l xml:id="m-617cc6e4-85cd-455b-a3c3-7c92345eab8a" facs="#m-6a34df5d-53b5-4e04-a566-7196898174ae" label="lyrics-like">tribue, quaésumus; ut ipsam prol Christum Filium tuum.</l><l xml:id="m-e78f3278-e9ba-4d24-b11e-cee726d9f4f5" facs="#m-b6056a46-cb24-475d-bcde-b46981fbacf8" label="text-like">From the Purification until Advent, except during Paschal Time:</l><l xml:id="m-40435068-7d0b-4fdd-bc88-c294dc6be6c3" facs="#m-53269971-57c8-45bb-a72a-43359932432f" label="lyrics-like">vOncéde nos fámulos tuos, quaé-[ semper Virginis intercessióne, * a</l><l xml:id="m-abf90e0e-928f-4c7a-b514-650368a454f4" facs="#m-5e93878e-9c0c-431b-95fa-21c6acdd7437" label="lyrics-like">L sumus, Dómine Deus, perpétua</l><l xml:id="m-ce406229-c1c4-4786-9346-b3387ca08c17" facs="#m-44417a5d-05f1-4d75-9af5-0f2496688c9c" label="lyrics-like">praésénti liberári tristitia, et aetér¬</l><l xml:id="m-8d8e2bcc-0ffa-48d4-9dea-d12ba3994bd7" facs="#m-f8f80aba-a065-4f6d-a7fb-107e7638e455" label="lyrics-like">na pérfrui laetitia.</l><l xml:id="m-0326f669-e807-47a0-8dae-c77a42d0b7ed" facs="#m-0f82bcb0-023c-461b-ad67-e37f77c14758" label="lyrics-like">mentis et córporis sanitáte gaudé¬</l><l xml:id="m-deb07436-0a4a-456f-ba49-a319e59681fa" facs="#m-c9dab02e-c134-409a-b372-6f61a87a5058" label="lyrics-like">re:t et gloriósa beâtae Mariae</l><l xml:id="m-1ba23e58-4bf0-4dcd-93a9-f0cf91e207ff" facs="#m-d7619095-dde0-4a82-a945-a2d221599bcd" label="text-like">In Paschal Time:</l><l xml:id="m-6ec51772-506a-46b8-8545-4139efc9d29d" facs="#m-95b040fd-1c2c-410a-8db9-415468373f1a" label="lyrics-like">Eus, qui per resurrectiónem ¡es : t praesta, quaésumus; ut, per</l><l xml:id="m-8b0bde3b-5a4e-4ef7-93e5-5d49d3e7ad7d" facs="#m-972b4760-265a-4c59-a5b4-eb06ab68b2e7" label="lyrics-like">U Fili tui, Dómini nostri Jesu</l><l xml:id="m-14289380-cb19-435f-b382-ac0d3a6a512b" facs="#m-d76d13da-4259-4696-9d27-0c542245fef9" label="lyrics-like">ejus Genitricem Virginem Maríam"</l><l xml:id="m-1dfed4da-ad39-478d-8e35-80e986356537" facs="#m-4ffdec8a-9432-47ea-a377-b3715da2a566" label="lyrics-like">Christi, mundum laetificáre dignátus ! perpétua capiámus gáudia vitae.</l><l xml:id="m-0d4bf797-8224-4011-be2a-09661da24688" facs="#m-29c0000a-4d11-4263-8fc3-2159878e974c" label="lyrics-like">3. AMnipotens, sempitérne Deus,</l><l xml:id="m-10a016fb-7b21-4dc7-b1c6-f78bd2238f6d" facs="#m-22ee699a-8679-47a1-900c-7e852fff9c90" label="lyrics-like">tuam cleméntiam in viam salútis</l><l xml:id="m-89697e59-9cb2-414d-bb6c-6d5a1b02d9e0" facs="#m-2320a338-7b65-4931-9326-7ee2d9dcf6e7" label="lyrics-like">U miserére fámulo tuo Pontifici</l><l xml:id="m-fb2ecc1a-16bd-46fc-84fa-bea441d2ff7a" facs="#m-488f689b-dabf-4d6e-aba1-ab5819181dcf" label="lyrics-like">aetérnae:* ut, te donánte, tibi plá¬</l><l xml:id="m-40618a78-68d1-4705-93ed-a9b4a939e223" facs="#m-37940cf6-5177-4722-8906-cb40de076ed1" label="lyrics-like">nostro N., t et dirige eum secúndum! cita cúpiat, et tota virtúte perficiat.</l><l xml:id="m-4324788c-6d9e-4e82-bb79-7892ec09fd3b" facs="#m-78cfaa12-9bb6-4c08-89a3-9526f930b3a5" label="lyrics-like">4. HEuS, refúgium nostrum, et !et praesta; * ut, quod fidéliter péti¬</l><l xml:id="m-088d0893-3282-46e1-aab3-da3d930d9808" facs="#m-a0d8a016-0232-444f-b95b-43e94027844e" label="lyrics-like">I virtus: t adésto piis Ecclésiae</l><l xml:id="m-a2e7ec07-61a6-487d-80b7-e783d627ff34" facs="#m-856466ba-18b7-4fea-95d1-94adc99ad802" label="lyrics-like">mus, efficáciter consequámur.</l><l xml:id="m-2e69205e-f112-4e53-8100-25a211abfe13" facs="#m-90351086-3a8e-4719-bcd0-674c534fa10b" label="lyrics-like">tuae précibus, auctor ipse pietátis,</l><l xml:id="m-5e4e66d3-13ab-4d24-87f5-e1fdc5a3f4ab" facs="#m-58638ab9-2f50-45ba-96df-99c2fe29034a" label="lyrics-like">5.AMnipotens, sempitérne Deus,</l><l xml:id="m-212af1af-77fa-4575-9598-5cd75c637765" facs="#m-034ffefd-4836-4f21-b722-88163ae270a0" label="lyrics-like">córpore suscépit, * intercedéntibus</l><l xml:id="m-3ad2538b-9e98-4211-a828-307775179727" facs="#m-d5c4ddcd-0da7-4558-ab6b-9117b96b8782" label="lyrics-like">U qui vivórum domináris simui</l><l xml:id="m-4641b6d0-e5a7-4713-8d6b-8df4e83c8c0b" facs="#m-e591fbd6-155e-4f36-938c-cc1155ecaf41" label="lyrics-like">ómnibus Sanctis tuis, pietátis tuae</l><l xml:id="m-b807d116-80af-49b4-895c-90ed45cf7432" facs="#m-1533f850-84f6-430e-8fdd-03f34952a0b7" label="lyrics-like">cleméntia ómnium delictórum suó¬</l><l xml:id="m-932c71f7-fb38-4164-ad9d-96767b10e6cf" facs="#m-dbe998fe-f303-4001-accc-56d478739869" label="lyrics-like">et mortuórum, omniúmque miseré¬</l><l xml:id="m-fcbb5255-557a-4a08-ae00-0d68fad8d72d" facs="#m-e553378d-4ce3-4715-906d-a877db628f69" label="lyrics-like">rum véniam consequántur. Per Dó¬</l><l xml:id="m-e912a91d-2304-498d-943d-e07409029fd1" facs="#m-580df1f9-715f-4596-9f6f-4e279b46e8a3" label="lyrics-like">ris, quos tuos fide et ópere futúros</l><l xml:id="m-d880950e-9255-453f-b0b5-917365864f5e" facs="#m-d0597839-a5d4-400f-b1d9-99db00aed69d" label="ambiguous">minum nostrum Jesum Christum,</l><l xml:id="m-372bb667-946c-452e-a7d6-f73fc2eb4e0f" facs="#m-59396fdb-00fc-4cac-a86e-d5a71b435393" label="lyrics-like">esse praenóscis: t te súpplices exo¬</l><l xml:id="m-ce83182d-2f10-4c74-9f7b-8e589dadccbe" facs="#m-983a41d6-8974-4643-af4c-c60cd8e0da4c" label="ambiguous">Filium tuum: Qui tecum vivit et</l><l xml:id="m-5bbb81eb-0292-42a2-a2ba-1cfdbae247c4" facs="#m-905bde94-0a9d-463a-aa7e-5cf7e73cd352" label="lyrics-like">rámus; ut, pro quibus effúndere</l><l xml:id="m-54602cce-f25f-42e5-a69b-760f506c8be2" facs="#m-b0f0393d-e1d8-4551-96ad-aee3e7c071ee" label="lyrics-like">preces decrévimus, quosque vell regnat in unitâte Spiritus Sancti</l><l xml:id="m-f59753fb-d698-40fc-8dde-607be8b2e4ae" facs="#m-4c16937d-5062-4cff-83ec-7ed6f6cc6a29" label="lyrics-like">praesens saéculum adhuc in carne Deus, per ómnia saécula saeculó¬</l><l xml:id="m-cf6809b9-cd93-4497-8399-8ca21bbccb95" facs="#m-84bd9915-0630-4c95-bc8a-7a06e80c96e2" label="lyrics-like">rétinet, vel futúrum jam exútos rum. E. Amen.</l><l xml:id="m-4ce32944-6f06-4fa4-ac74-28c90eababe3" facs="#m-4d9220ff-43b5-4424-ac70-02ecefc2fd3c" label="text-like">The Celebrant kneels douon and sings:</l><l xml:id="m-a35629cb-1200-4620-967a-aebef2cfaa9e" facs="#m-1ce96119-97e4-426d-be11-99ea457ca096" label="lyrics-like">V. Dómine, exáudi oratiónem méam.</l><l xml:id="m-54b93254-2b08-4e67-af15-c5ad4816272e" facs="#m-fe1a73cd-b62f-47cc-8250-7281d16e5467" label="lyrics-like">F. Et clámor méus ad te véniat.</l><l xml:id="m-4f520f23-9f47-4d90-ba2d-0c3f0758fcec" facs="#m-eef88b9d-ce29-40d3-8447-ec8002975f85" label="text-like">The Cantors (ahere it is the custom) sing.</l><l xml:id="m-a9cd0a79-f3a8-44c4-94c7-e90881c7c8e7" facs="#m-29ea933d-dd45-4f5f-a9a0-a0f3e42d8e3c" label="lyrics-like">V. Exáudiat nos omnípotens et miséricors Dóminus.</l><l xml:id="m-70075a59-0eed-4251-830f-6e3ba4eeeaa2" facs="#m-891e0e23-39ea-457e-9498-ac4398d5bf14" label="lyrics-like">K. Et custódiat nos semper. Amen.</l><l xml:id="m-127cf168-5ddf-40a2-a8f2-c9886ba7152c" facs="#m-a0bc5e1e-db63-473e-ab22-90f82c4ebe42" label="text-like">The Celebrant sings on a lower note:</l><l xml:id="m-7eb3cf36-e384-4cd8-b4a3-7a36733ab401" facs="#m-6dff1474-635c-46b7-a0d6-afb1fb78e924" label="lyrics-like">V. Fidélium ánimae per misericórdiam Dei requiéscant in páce.</l><l xml:id="m-f1625637-f192-4441-817b-f52d72b88560" facs="#m-9750a3fd-f5cb-4fc5-a4d9-41c67d2cb332" label="ambiguous">K. Amen.</l><l xml:id="m-27341f1d-d07c-4c0b-9abf-0ff43a5f24a6" facs="#m-638a0bc5-10bf-42fc-ba2a-8f755ec657a0" label="text-like">On the day of Exposition, after a short prayer in silence, the Celebrant</l><l xml:id="m-0d665393-23f5-4e3d-a92e-f54954dce06b" facs="#m-4c5a3afe-0bbb-441b-8e9a-143e4412949d" label="text-like">and Ministers vithdraw.</l><l xml:id="m-00b37f6e-b808-4ce1-868e-49e3a38248f8" facs="#m-3b674b38-9e26-4d4d-a72b-c406a965620c" label="text-like">On the day of Deposition Benediction follows.</l></lg></div></section></score></mdiv></body></music>
</mei>