21-b2f6-a60334391dd4" ulx="384" uly="3076" lrx="3418" lry="3201" /><zone xml:id="m-c931b111-b46a-4baf-9370-0ab3fa9814b3" ulx="557" uly="3191" lrx="2687" lry="3326" /><zone xml:id="m-6ff13676-bdb8-4d7b-87d5-6d9a8dd7db00" ulx="388" uly="3361" lrx="2093" lry="3483" /><zone xml:id="m-88a94911-3f97-4d82-8449-cd45fe73e58e" ulx="557" uly="3476" lrx="2632" lry="3605" /><zone xml:id="m-6a8a1768-50cb-4a10-95df-34e33bb5c69a" ulx="391" uly="3646" lrx="3424" lry="3774" /><zone xml:id="m-59f90f68-c56d-47cc-994c-b4fddfc2319b" ulx="567" uly="3768" lrx="2764" lry="3906" /><zone xml:id="m-6ff2a8bc-4a76-4ce2-b427-2db5ca36c52e" ulx="391" uly="3931" lrx="3011" lry="4060" /><zone xml:id="m-c62826dc-4659-47a6-9d9d-a494876306a8" ulx="567" uly="4053" lrx="2549" lry="4172" /><zone xml:id="m-98e3d2f8-49d5-41d6-88ef-dee764a023d2" ulx="397" uly="4213" lrx="3052" lry="4351" /><zone xml:id="m-6b217ef8-74d8-4b16-b912-e6b8ea814b10" ulx="567" uly="4342" lrx="2542" lry="4457" /><zone xml:id="m-c143238b-2518-4b82-aeef-64051bc2d5f0" ulx="394" uly="4502" lrx="3434" lry="4627" /><zone xml:id="m-bf50102a-2f44-4f47-8057-47e3f430acdb" ulx="676" uly="4601" lrx="2440" lry="4729" /><zone xml:id="m-cf2ff98a-f2a7-4f2c-8f6e-b1e13725db33" ulx="397" uly="4761" lrx="2966" lry="4893" /><zone xml:id="m-7ad15bd2-fee9-4178-b9d4-d2b99f7d1f36" ulx="570" uly="4886" lrx="2074" lry="5014" /><zone xml:id="m-32126f56-488f-4b4e-8d0b-c419798f0910" ulx="397" uly="5047" lrx="3440" lry="5178" /><zone xml:id="m-96dcb3ec-0237-4d8c-add1-1ba9f725ce9e" ulx="570" uly="5175" lrx="3440" lry="5309" /><zone xml:id="m-185513d8-21a9-4b2f-94d3-ec112c0e3a8e" ulx="673" uly="5271" lrx="1529" lry="5402" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-aa0697ca-6d95-4550-8966-8f850cf3b91b" n="0092" facs="#m-e41ba19a-fa68-441a-91d5-3ae0c0778faa" /><div xml:id="m-f4efb067-fc54-44b1-9cf8-fd766f5ae8c1">
            <lg xml:id="m-f25562c6-aa6f-48e9-804d-091efb9d52a4">
              <l xml:id="m-d3b5671b-9bdf-4653-85cd-6d80274d6a83" facs="#m-c0363d65-c2b4-46d1-8e0b-849f505a80a8" label="ambiguous">xcii.</l><l xml:id="m-a233265b-539d-441d-a5cb-2d81778fbd1d" facs="#m-caa93166-dc73-4307-85e7-87fe274e31ac" label="text-like">Changes in the Liber Usualis.</l><l xml:id="m-2db11921-f471-4d2c-bbb6-0cc7c271066a" facs="#m-6c651f56-020d-46c7-9b1d-7abd8328b64d" label="text-like">31. OUR LADY THE QUEEN, II class. — Semi-festive Office.</l><l xml:id="m-e6521a04-db9c-4218-97aa-0cf932cc2d8a" facs="#m-8a8c5fd5-73b7-4a09-9773-92eee27e91e6" label="ambiguous">As pp. 14764 ff., without I Vesp.</l><l xml:id="m-8c5abfd9-7617-45cf-b0e8-bd8c8517a452" facs="#m-4c6c34af-13e6-4067-9114-d4ef2db66803" label="text-like">At lesser Hours, hymn n° 1 of Sunday. At Prime, short</l><l xml:id="m-d938a026-a29c-41d0-a396-e6e6ccd77ed5" facs="#m-ae4f434d-6d2c-4add-9d06-cc2878d83b65" label="text-like">lesson of season.</l><l xml:id="m-18a2c205-6236-4520-b8e7-f877a4173be8" facs="#m-fc184a11-1a65-4232-8af2-69f8f4498081" label="text-like">At conventual Mass, com. of St. Petronilla.</l><l xml:id="m-c66421cc-e824-4a89-b978-d6a25ab088d6" facs="#m-9dd1af90-9644-4922-92b1-29ae94949d92" label="text-like">At Vesp. of Sat., com. of Sunday.</l><l xml:id="m-b6eaec5e-0dd4-47e1-bd80-c311151fc845" facs="#m-aad319b7-85dd-42a5-bc2e-493098eea32b" label="text-like">FEASTS OF JUNE</l><l xml:id="m-9794d391-1367-4fbc-8042-0808e1276eb6" facs="#m-1c653433-e5ff-402d-8f76-5f0612d1e4aa" label="ambiguous">1. ST. ANGELA MERICI, V., HI class.</l><l xml:id="m-f3427851-00c2-40fd-862f-83275f3c2cde" facs="#m-93252322-0b58-4ece-a8b2-1937ef34b95f" label="text-like">Ordinary Office. Mass, p. 1477.</l><l xml:id="m-5fa67ead-34ec-45e4-8772-f7a5b72dd730" facs="#m-8180f165-0674-4793-a022-48a6a51414eb" label="text-like">2. Mass of feria (or SS. Marcellinus, Peter and Erasmus, MM.).</l><l xml:id="m-fc8733c7-80df-4937-91fc-f1b9e8976eab" facs="#m-ceb322f5-f7ea-4baf-a3c2-a2aa068d7a85" label="ambiguous">4. ST. FRANCIS CARACCIOLO, Conf. III class.</l><l xml:id="m-6ac1b2bd-d414-478b-ad7c-11b300436129" facs="#m-3ce6271b-e7ee-426f-b990-7c1334ce752b" label="text-like">Ordinary Office. Mass, p. 1477.</l><l xml:id="m-dc7a0bf4-9283-4c9c-aba5-8f46215f2358" facs="#m-06eae343-b0c8-466c-b652-3651c73defaa" label="ambiguous">5. ST. BONIFACE, Bp. M., HII class.</l><l xml:id="m-8608d6d7-0321-4e7d-8fd5-926e1745cb5f" facs="#m-63b4cebe-f922-4b44-a476-fd96162e8518" label="text-like">Ordinary Office. Mass, p. 1481.</l><l xml:id="m-366a1fd2-9194-4010-8763-647425012b5b" facs="#m-781c94e5-3f7e-4b9f-bb8b-d9edd0b281ed" label="ambiguous">6. ST. NORBERT, Bp. Conf., III class.</l><l xml:id="m-4a756be8-c454-4ffc-920e-250d5214d790" facs="#m-175e01b9-f778-406e-82a6-e7aeed03debc" label="text-like">Ordinary Office. Mass, p. 1485.</l><l xml:id="m-40f0283b-944a-4f92-b320-8dd09e4969eb" facs="#m-554028b5-d933-402a-ae2e-739b8f05ea23" label="text-like">9. Mass of feria (or SS. Primus and Felician, MM.).</l><l xml:id="m-fe32f7c9-5b49-4e82-8a9e-69decc0b9d78" facs="#m-4dfa9c65-01c4-4821-b2f6-a60334391dd4" label="ambiguous">10. ST. MARGARET, Queen, Widow, III class. — Ordinary Office.</l><l xml:id="m-d4f8b6e9-be3b-4e5e-89aa-55d3525587da" facs="#m-c931b111-b46a-4baf-9370-0ab3fa9814b3" label="lyrics-like">Mass Cognóvi, p. 1239, except collect, p. 1486.</l><l xml:id="m-daf474ba-466b-4e05-9bf0-d4cec05c491e" facs="#m-6ff13676-bdb8-4d7b-87d5-6d9a8dd7db00" label="ambiguous">11. ST. BARNABAS, Ap., III class.</l><l xml:id="m-37dd66ab-8046-4535-9b71-5a6098b08697" facs="#m-88a94911-3f97-4d82-8449-cd45fe73e58e" label="text-like">Ordinary Office. Mass, p. 1486, with Creed.</l><l xml:id="m-12c4af39-ff24-4875-9806-51c06a2cf3ed" facs="#m-6a8a1768-50cb-4a10-95df-34e33bb5c69a" label="text-like">12. ST. JOHN OF SAN FACUNDO, Conf. II class. — Ord. Off.</l><l xml:id="m-511ba271-3ef3-42d1-bd97-1cc5a983c563" facs="#m-59f90f68-c56d-47cc-994c-b4fddfc2319b" label="text-like">Mass, p. 1488 (if conventual, com. of SS. MM.).</l><l xml:id="m-dd1723ae-7940-4053-a597-4e43e1b0d2a9" facs="#m-6ff2a8bc-4a76-4ce2-b427-2db5ca36c52e" label="text-like">13. ST. ANTHONY OF PADUA, Conf. Doct., III class.</l><l xml:id="m-55d835b0-30a0-4f52-af9f-01c74c3038c1" facs="#m-c62826dc-4659-47a6-9d9d-a494876306a8" label="text-like">Ordinary Office. Mass, p. 1489, no Creed.</l><l xml:id="m-fcc7ff4e-2571-483b-9cc8-dd353b074a31" facs="#m-98e3d2f8-49d5-41d6-88ef-dee764a023d2" label="text-like">14. ST. BASIL THE GREAT, Bp. Conf. Doct., HI class.</l><l xml:id="m-7d41cc13-9d91-4409-9067-8007e396dc03" facs="#m-6b217ef8-74d8-4b16-b912-e6b8ea814b10" label="text-like">Ordinary Office. Mass, p. 1489, no Creed.</l><l xml:id="m-738f4744-a969-4053-bbe0-bace38f80154" facs="#m-c143238b-2518-4b82-aeef-64051bc2d5f0" label="text-like">15. Mass of feria (or SS. Vitus, Modestus and Crescentia, MM.</l><l xml:id="m-26aec28b-7172-4699-a738-352162f22b8a" facs="#m-bf50102a-2f44-4f47-8057-47e3f430acdb" label="text-like">This Mass is not in the Liber Usualis).</l><l xml:id="m-29b4ee69-8edd-4df7-8ec5-ca28cfdbf0e8" facs="#m-cf2ff98a-f2a7-4f2c-8f6e-b1e13725db33" label="ambiguous">17. ST. GREGORY BARBARIGO, Bp. Conf., III class.</l><l xml:id="m-b59a793e-20eb-4f27-b250-834f7e1532f0" facs="#m-7ad15bd2-fee9-4178-b9d4-d2b99f7d1f36" label="text-like">Ordinary Office. Mass, p. 1490.</l><l xml:id="m-01286a71-5fb0-45cc-89c3-9245720c5de4" facs="#m-32126f56-488f-4b4e-8d0b-c419798f0910" label="text-like">18. ST. EPHRAEM THE SYRIAN, Deacon, Conf. Doct., HI class.</l><l xml:id="m-d80cf53c-ffc8-4a75-9bb8-903835883f04" facs="#m-96dcb3ec-0237-4d8c-add1-1ba9f725ce9e" label="text-like">Ordinary Office. Mass, p. 1490, no Creed; (if conventual,</l><l xml:id="m-ddd35ce5-0ae6-4d8e-8d78-111a5c025b20" facs="#m-185513d8-21a9-4b2f-94d3-ec112c0e3a8e" label="text-like">com. of SS. MM.).</l></lg></div></section></score></mdiv></body></music>
</mei>