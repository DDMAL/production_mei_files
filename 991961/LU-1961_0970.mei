                  <syl /><neume facs="#m-5a01fed4-c691-4b1d-93fc-5a6c7ecaff7b" type="punctum" xml:id="m-b1c74291-7c73-4c7e-bb6a-b096ca54ef9e">
                    <nc xml:id="m-ace2a587-0941-4bfc-8f37-8402e0703608" pname="d" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-26682fa5-e4f6-4945-afb0-2bfef8ebc0d8">
