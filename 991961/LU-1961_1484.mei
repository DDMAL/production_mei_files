      <graphic xml:id="m-17239b28-43c4-4644-b569-9bcbfdebd21a" target="1484_original_image.tiff" /><zone xml:id="m-64e235db-849e-4ace-8fbe-66460ea587b0" ulx="133" uly="95" lrx="222" lry="131" /><zone xml:id="m-11a99605-f573-4235-84fd-6e7d8a625b84" ulx="276" uly="96" lrx="858" lry="125" /><zone xml:id="m-e2e15b1a-8dae-40d6-80fb-f66a7eea5785" ulx="132" uly="175" lrx="1011" lry="219" /><zone xml:id="m-539feca7-61c2-41b9-ab75-4bb75d49d038" ulx="190" uly="225" lrx="946" lry="275" /><zone xml:id="m-2f510851-7432-496b-a433-7cd6b92125e6" ulx="159" uly="288" lrx="546" lry="330" /><zone xml:id="m-3394c8d7-beb6-4013-9cde-c59e70d83d22" ulx="514" uly="328" lrx="623" lry="370" /><zone xml:id="m-9e92ce40-38de-4952-9d13-e4de1515a184" ulx="169" uly="360" lrx="1012" lry="403" /><zone xml:id="m-f6612def-c990-44a3-87b5-d3f75bedc06b" ulx="140" uly="393" lrx="570" lry="432" /><zone xml:id="m-5a5efaa4-8c57-427c-8a86-20566fc25a3d" ulx="577" uly="393" lrx="1011" lry="427" /><zone xml:id="m-b92a34af-e949-488c-b440-80e9a6b39e30" ulx="575" uly="419" lrx="1011" lry="456" /><zone xml:id="m-dbcbee0e-ec6d-47fe-a218-716f2fa02d82" ulx="139" uly="421" lrx="572" lry="455" /><zone xml:id="m-1fd16646-fc63-4d4f-8127-4f3eaa3dc0e5" ulx="136" uly="445" lrx="998" lry="491" /><zone xml:id="m-ab488962-cd38-4afe-9747-83525ea829db" ulx="160" uly="498" lrx="994" lry="534" /><zone xml:id="m-14e78c85-f38f-4109-82fe-2d965515afcd" ulx="148" uly="541" lrx="1012" lry="583" /><zone xml:id="m-615cddd8-2217-41b3-948d-9b4d6912530b" ulx="579" uly="570" lrx="1014" lry="608" /><zone xml:id="m-aa73ce1b-4057-4c6d-b38e-a57682e1004a" ulx="177" uly="571" lrx="571" lry="604" /><zone xml:id="m-24ad402e-9f86-4319-8b98-91f15851b71c" ulx="141" uly="575" lrx="166" lry="608" /><zone xml:id="m-73cf449a-889c-4312-a379-6c7dbe88a352" ulx="579" uly="597" lrx="1014" lry="635" /><zone xml:id="m-1589c965-147b-4a72-853e-a0ff43c6dc29" ulx="138" uly="600" lrx="572" lry="635" /><zone xml:id="m-ab61cd04-5847-4b7c-9ad8-40cb0897802b" ulx="137" uly="625" lrx="572" lry="659" /><zone xml:id="m-0983068b-a2c6-4608-b0df-92ce8d127d18" ulx="581" uly="626" lrx="1014" lry="662" /><zone xml:id="m-862d1434-114a-42bf-a1cf-585d4a8fe68a" ulx="137" uly="652" lrx="571" lry="686" /><zone xml:id="m-10165b9b-ab50-4cd6-8749-30c349a9d9be" ulx="582" uly="652" lrx="1011" lry="689" /><zone xml:id="m-7af875b1-ed8c-4484-9a12-802d5b1fe5c9" ulx="138" uly="680" lrx="571" lry="719" /><zone xml:id="m-4c27768f-81a8-46a7-a925-f3c8a3bebbf1" ulx="581" uly="681" lrx="797" lry="717" /><zone xml:id="m-e70bfd41-4229-432b-95a0-677908cf8d85" ulx="139" uly="708" lrx="576" lry="746" /><zone xml:id="m-d34af388-0260-49c2-9078-1cff7f80358c" ulx="163" uly="745" lrx="582" lry="781" /><zone xml:id="m-37fbaee4-60e1-4a6f-8fb8-0ac78615c5d7" ulx="163" uly="777" lrx="743" lry="819" /><zone xml:id="m-a39a8997-0c73-4979-a488-000b1fd752a8" ulx="160" uly="818" lrx="1017" lry="855" /><zone xml:id="m-451cab82-cc5f-4849-a56e-1983f85e911c" ulx="138" uly="846" lrx="536" lry="880" /><zone xml:id="m-08e6eb14-6650-4eab-adf5-7220017c812b" ulx="160" uly="872" lrx="1018" lry="907" /><zone xml:id="m-ec1b79b0-1f87-476e-9ca9-25b0f3127bf8" ulx="138" uly="900" lrx="1009" lry="937" /><zone xml:id="m-2aaba2ef-6979-411f-9611-0f2e21c97cab" ulx="157" uly="945" lrx="1008" lry="980" /><zone xml:id="m-3a13275c-3375-42f3-92e0-b006c111e869" ulx="157" uly="992" lrx="1020" lry="1033" /><zone xml:id="m-2d0cf6fb-0a7a-441c-b31f-59a87189c5a5" ulx="144" uly="1023" lrx="1019" lry="1060" /><zone xml:id="m-af2a4066-e624-4f11-b8a6-5e858c32a7b3" ulx="143" uly="1052" lrx="1020" lry="1083" /><zone xml:id="m-10a01518-0c63-46ee-96fc-4cf4774ee03f" ulx="583" uly="1079" lrx="1021" lry="1116" /><zone xml:id="m-4d3ea00c-d89f-4f2a-8144-d55fc00a33cc" ulx="142" uly="1081" lrx="575" lry="1116" /><zone xml:id="m-5368e40b-2802-4fd3-816b-73e753da7497" ulx="143" uly="1107" lrx="1018" lry="1141" /><zone xml:id="m-4ce40669-0406-4df5-93d4-2d850a4a5971" ulx="142" uly="1136" lrx="1020" lry="1170" /><zone xml:id="m-bc14fdcf-8b1d-49a0-a05a-003783a50645" ulx="145" uly="1160" lrx="786" lry="1201" /><zone xml:id="m-69a53740-2f13-4f8a-a067-382534643eae" ulx="899" uly="1160" lrx="992" lry="1198" /><zone xml:id="m-40972ce9-76c1-4a82-a782-0e85e6099781" ulx="168" uly="1200" lrx="563" lry="1241" /><zone xml:id="m-e5c9034a-ab68-4d9e-a1f6-00893fe4a911" ulx="534" uly="1243" lrx="631" lry="1280" /><zone xml:id="m-d0c5c24b-b539-4472-a373-9a0f820eece2" ulx="182" uly="1276" lrx="1020" lry="1317" /><zone xml:id="m-04af8494-38f7-4eb1-ab27-8a68e9b55e32" ulx="147" uly="1307" lrx="1020" lry="1348" /><zone xml:id="m-ec51c222-d390-404f-a2c6-0db4a3b08220" ulx="145" uly="1333" lrx="585" lry="1372" /><zone xml:id="m-95a8e501-15d4-4d29-b93e-fbefcc01db95" ulx="170" uly="1371" lrx="613" lry="1411" /><zone xml:id="m-4e985cbb-7925-41f9-b86b-20a512b1de58" ulx="463" uly="1417" lrx="702" lry="1452" /><zone xml:id="m-b6776a36-e2b0-4055-a370-a4aece8a00e1" ulx="194" uly="1448" lrx="1016" lry="1487" /><zone xml:id="m-5904f17f-4011-4f41-94bd-5a58bc81aa14" ulx="145" uly="1472" lrx="577" lry="1514" /><zone xml:id="m-2be00527-7cf1-408f-bce6-c5ae007d529a" ulx="588" uly="1479" lrx="1017" lry="1518" /><zone xml:id="m-517eddc6-562c-4258-be6d-256536ffa3b3" ulx="145" uly="1504" lrx="577" lry="1541" /><zone xml:id="m-99c2cc16-7bb9-4cb8-8b65-cf0372c9072b" ulx="588" uly="1504" lrx="773" lry="1542" /><zone xml:id="m-0d7f46ec-01f1-4249-b040-379264b9a683" ulx="146" uly="1535" lrx="575" lry="1573" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-65822653-77c7-4fe0-bc3e-8cdb3efa86d4" n="1484" facs="#m-dbcb8b88-f755-4f94-a031-f2ff2dd55cde" /><div xml:id="m-e5df27a8-c48e-4196-bb54-0d49f5aca13e">
            <lg xml:id="m-4074b23d-33ba-471b-823e-202a2ac77f0e">
              <l xml:id="m-c1c525fa-2100-489b-b00d-b261e51972d4" facs="#m-64e235db-849e-4ace-8fbe-66460ea587b0" label="ambiguous">1284</l><l xml:id="m-039ea604-78c3-4f92-82ff-376b9bc76294" facs="#m-11a99605-f573-4235-84fd-6e7d8a625b84" label="text-like">Mass on Anniv. of Election of a Bishop.</l><l xml:id="m-32658c90-e84d-449a-b366-6abedf354c23" facs="#m-e2e15b1a-8dae-40d6-80fb-f66a7eea5785" label="text-like">Mass on the Anniversary days of the Election and</l><l xml:id="m-b60950ea-e0de-40ca-a5ed-c2ede294e982" facs="#m-539feca7-61c2-41b9-ab75-4bb75d49d038" label="text-like">Consecration of the Bishop of the Diocese.</l><l xml:id="m-84ec8b63-04cf-452d-ba8d-c491e7370889" facs="#m-2f510851-7432-496b-a433-7cd6b92125e6" label="lyrics-like">Intrott. Sacerdótes túi. p. 1186.</l><l xml:id="m-6c6610ae-5222-4258-a09f-be3f3a800c66" facs="#m-3394c8d7-beb6-4013-9cde-c59e70d83d22" label="ambiguous">Collect.</l><l xml:id="m-1717ab92-2a60-4ef4-bd1b-5388387d5f99" facs="#m-9e92ce40-38de-4952-9d13-e4de1515a184" label="lyrics-like">Eus, ómnium fidélium pastor et  quaésumus, verbo et exémplo, qui¬</l><l xml:id="m-5b4c44e7-112c-47c3-883b-ea1c9683f948" facs="#m-f6612def-c990-44a3-87b5-d3f75bedc06b" label="lyrics-like">I rector, fámulum tuum N., quem</l><l xml:id="m-89b3328c-259b-4c73-a566-975e85c9751e" facs="#m-5a5efaa4-8c57-427c-8a86-20566fc25a3d" label="ambiguous">bus praeest, proficere; ut ad vitam,</l><l xml:id="m-8d270b9b-c6a1-40ff-a98f-5ebdbadb12fe" facs="#m-b92a34af-e949-488c-b440-80e9a6b39e30" label="lyrics-like">una cum grege sibi crédito, pervé¬</l><l xml:id="m-a3b54ed9-c495-47fb-8aca-47292326b2f5" facs="#m-dbcbee0e-ec6d-47fe-a218-716f2fa02d82" label="lyrics-like">pastórem ecclésiae N. praeésse vo¬</l><l xml:id="m-9d4f5064-1937-438f-a131-60350f57f2a5" facs="#m-1fd16646-fc63-4d4f-8127-4f3eaa3dc0e5" label="lyrics-like">luisti, propitius réspice: da ei, niat sempitérnam. Per Dóminum.</l><l xml:id="m-8c5facd3-b57e-4b80-a609-85fc1d8c2d2b" facs="#m-ab488962-cd38-4afe-9747-83525ea829db" label="ambiguous">Lectio Epistolae beati Pauli Apostoli ad Hebraeos. Hebr. 5.</l><l xml:id="m-59581930-a9da-474d-a8d7-fa2c284aefa0" facs="#m-14e78c85-f38f-4109-82fe-2d965515afcd" label="lyrics-like">LRatres: Omnis póntifex ex ho-linfirmitáte: et proptérea debet,</l><l xml:id="m-7a0c257d-7c5a-49b4-90fc-210db8b26a7a" facs="#m-615cddd8-2217-41b3-948d-9b4d6912530b" label="lyrics-like">quemádmodum pro pópulo, ita</l><l xml:id="m-1e900fcf-606a-4000-bf90-db6607a80fc6" facs="#m-aa73ce1b-4057-4c6d-b38e-a57682e1004a" label="lyrics-like">mínibus assúmptus. pro homí¬</l><l xml:id="m-d5a2ea70-751d-4d90-8f3b-82d4171220cd" facs="#m-24ad402e-9f86-4319-8b98-91f15851b71c" label="ambiguous">F</l><l xml:id="m-8e9798cc-037a-46dd-82b3-10a93dc63c50" facs="#m-73cf449a-889c-4312-a379-6c7dbe88a352" label="lyrics-like">étiam et pro semetipso offérre pro</l><l xml:id="m-2d7b3b64-7f10-426e-abb5-c2195863ec72" facs="#m-1589c965-147b-4a72-853e-a0ff43c6dc29" label="ambiguous">nibus constituitur in iis, quae sunt</l><l xml:id="m-38702510-fff6-49f9-a065-d97fa22cd66f" facs="#m-ab61cd04-5847-4b7c-9ad8-40cb0897802b" label="lyrics-like">ad Deum, ut ófferat dona, et sacri¬</l><l xml:id="m-9b5e7242-9286-41bd-919a-482cc9a3caf9" facs="#m-0983068b-a2c6-4608-b0df-92ce8d127d18" label="lyrics-like">peccátis. Nec quisquam sumit sibi</l><l xml:id="m-3015ec19-0056-4457-8cd8-ef8433995b96" facs="#m-862d1434-114a-42bf-a1cf-585d4a8fe68a" label="lyrics-like">ficia pro peccátis : qui condolére</l><l xml:id="m-c65871a8-16da-463b-97b8-57a039376a7e" facs="#m-10165b9b-ab50-4cd6-8749-30c349a9d9be" label="lyrics-like">honórem, sed qui vocátur a Deo,</l><l xml:id="m-cc53e514-703d-4be7-80e0-5678137c60b9" facs="#m-7af875b1-ed8c-4484-9a12-802d5b1fe5c9" label="lyrics-like">possit is, qui ignórant, et errant:</l><l xml:id="m-707d022e-43fa-4f61-bb5e-5d3f03deef30" facs="#m-4c27768f-81a8-46a7-a925-f3c8a3bebbf1" label="ambiguous">tamquam Aaron.</l><l xml:id="m-f463a6db-62a6-4355-afb7-b060b84afd7a" facs="#m-e70bfd41-4229-432b-95a0-677908cf8d85" label="lyrics-like">quóniam et ipse circúmdatus est</l><l xml:id="m-3557b07d-de5f-4549-a85e-5f9c89867d91" facs="#m-d34af388-0260-49c2-9078-1cff7f80358c" label="lyrics-like">Gradual. Sacerdótes éjus. p. 1187.</l><l xml:id="m-eb844ed6-e361-4a72-976f-0c241d20072b" facs="#m-37fbaee4-60e1-4a6f-8fb8-0ac78615c5d7" label="lyrics-like">Alleluia, allelúia. V. Jurávit Dóminus. D. 1187.</l><l xml:id="m-9137b4df-841e-4560-a54c-ac58564dc472" facs="#m-a39a8997-0c73-4979-a488-000b1fd752a8" label="text-like">After Septuagesima, the Alleluia. and its Verse are omitted; the Tract</l><l xml:id="m-5d2ed3ef-d9ec-49f9-bad0-7299ebc8ac29" facs="#m-451cab82-cc5f-4849-a56e-1983f85e911c" label="lyrics-like">Beátus vir. D. 1184, is said instead.</l><l xml:id="m-9ac06cb6-3c1e-4ac4-b662-da41a91ed781" facs="#m-08e6eb14-6650-4eab-adf5-7220017c812b" label="lyrics-like">In Paschal Time, the Gradual is omitted. The Alleluia, allelúia. V. Jurávit</l><l xml:id="m-ab513213-a750-4ec6-b7b4-041077f2954c" facs="#m-ec1b79b0-1f87-476e-9ca9-25b0f3127bf8" label="lyrics-like">Dominus. p. 1187, is sung instead, and then Alleluia. Y. Amavit éum. p. 1191.</l><l xml:id="m-26247ea5-ec20-411f-9140-3f676e5805f5" facs="#m-2aaba2ef-6979-411f-9611-0f2e21c97cab" label="ambiguous">4 Sequentia sancti Evangelii secundum Marcum. Marc. 13. d.</l><l xml:id="m-e2b538d5-13b4-4809-814f-a5d7e95a6b05" facs="#m-3a13275c-3375-42f3-92e0-b006c111e869" label="lyrics-like">TN illo témpore: Dixit Jesus disci-Ivígilet. Vigiláte ergo, (nescitis enim</l><l xml:id="m-0498ff5c-be38-4909-8605-66860e67aedb" facs="#m-2d0cf6fb-0a7a-441c-b31f-59a87189c5a5" label="lyrics-like">L pulis suis: Vidéte, vigilâte, et quando dóminus domus véniat:</l><l xml:id="m-8cc58a95-f250-4b5e-a841-27524e71a254" facs="#m-af2a4066-e624-4f11-b8a6-5e858c32a7b3" label="lyrics-like">orâte : nescítis enim quando tem-lsero, an média nocte, an galli</l><l xml:id="m-208b3abc-7761-4b50-b9e6-7c118596c768" facs="#m-10a01518-0c63-46ee-96fc-4cf4774ee03f" label="lyrics-like">cantu, an mane) ne cum vénerit</l><l xml:id="m-9d76e03f-909a-408b-bc47-4eb2737f4836" facs="#m-4d3ea00c-d89f-4f2a-8144-d55fc00a33cc" label="lyrics-like">pus sit. Sicut homo, qui péregre</l><l xml:id="m-cc091d4c-e06b-4c49-8055-b8ee6cad512e" facs="#m-5368e40b-2802-4fd3-816b-73e753da7497" label="lyrics-like">proféctus reliquit domum suam, et repénte, invéniat vos dormiéntes.</l><l xml:id="m-4c272e86-ecc8-42c5-b4fc-e5467671fb40" facs="#m-4ce40669-0406-4df5-93d4-2d850a4a5971" label="lyrics-like">dedit servis suis potestátem cujús-Quod autem vobis dico, ómnibus</l><l xml:id="m-62bbb186-4a63-4a01-8538-c4709ae7c0ad" facs="#m-bc14fdcf-8b1d-49a0-a05a-003783a50645" label="lyrics-like">que óperis, et janitóri praecépit ut ! dico : Vigiláte.</l><l xml:id="m-3ddc916b-78cc-4c50-bd11-f12b5695b00a" facs="#m-69a53740-2f13-4f8a-a067-382534643eae" label="ambiguous">Credo.</l><l xml:id="m-ac4904ce-6730-4258-b904-7621eadabb73" facs="#m-40972ce9-76c1-4a82-a782-0e85e6099781" label="lyrics-like">offertory. Véritas méa. p. 1203.</l><l xml:id="m-949ad742-a3fe-47b6-a04e-0398007a3332" facs="#m-e5c9034a-ab68-4d9e-a1f6-00893fe4a911" label="ambiguous">Secret.</l><l xml:id="m-9364388a-2feb-4156-ae93-57911bb35761" facs="#m-d0c5c24b-b539-4472-a373-9a0f820eece2" label="lyrics-like">Blátis, quaésumus, Dómine, pla-[siae N. pracésse voluisti, assídua</l><l xml:id="m-b3ca3ee7-c8c2-4b90-ab92-f515b457a133" facs="#m-04af8494-38f7-4eb1-ab27-8a68e9b55e32" label="lyrics-like">U cáre munéribus: et fámulum protectióne gubérna. Per Dóminum.</l><l xml:id="m-cde9d3b6-d801-4d6f-9019-2a13c424cce7" facs="#m-ec51c222-d390-404f-a2c6-0db4a3b08220" label="lyrics-like">tuum N., quem pastórem ecclé¬</l><l xml:id="m-89cf5e6d-f81c-4ffe-832f-523c86f04572" facs="#m-95a8e501-15d4-4d29-b93e-fbefcc01db95" label="lyrics-like">Communion. Beatus sérvus. p. 1203.</l><l xml:id="m-fc503c0d-f490-46e8-8dcc-6fcc8346589f" facs="#m-4e985cbb-7925-41f9-b86b-20a512b1de58" label="ambiguous">Postcommunion.</l><l xml:id="m-afd0415b-a8d8-46d0-b11f-58f6fdc7f8f3" facs="#m-b6776a36-e2b0-4055-a370-a4aece8a00e1" label="lyrics-like">AEC nos, quaésumus, Dómine,l voluísti; una cum commísso sib</l><l xml:id="m-3cf7e837-27df-4ca1-9991-78f3fd214989" facs="#m-5904f17f-4011-4f41-94bd-5a58bc81aa14" label="lyrics-like">I divini sacraménti percéptio</l><l xml:id="m-8657cc70-a16a-48a2-af25-0eb8f48fa6e7" facs="#m-2be00527-7cf1-408f-bce6-c5ae007d529a" label="lyrics-like">grege, salvet semper, et múniat</l><l xml:id="m-91e83b42-abb6-4b9f-923a-980eea35c41e" facs="#m-517eddc6-562c-4258-be6d-256536ffa3b3" label="lyrics-like">prótegat: et fámulum tuum N.,</l><l xml:id="m-8c06fb9b-b4d6-42be-bab9-fc4d0ecc8857" facs="#m-99c2cc16-7bb9-4cb8-8b65-cf0372c9072b" label="lyrics-like">Per Dóminum.</l><l xml:id="m-8fbf1a6c-d6fa-4bc9-a93e-41a208966c10" facs="#m-0d7f46ec-01f1-4249-b040-379264b9a683" label="lyrics-like">quem pastóremecclésiae N. praeésse</l></lg></div></section></score></mdiv></body></music>
</mei>