      <graphic xml:id="m-5e65ce62-017e-402b-9059-765bbac4542a" target="0894_original_image.tiff" /><zone xml:id="m-0d77b3c6-02b6-4bdc-82b1-355d838a2c06" ulx="97" uly="65" lrx="154" lry="97" /><zone xml:id="m-3d87469f-7350-432c-83b2-6b262e686fa9" ulx="409" uly="70" lrx="579" lry="98" /><zone xml:id="m-3086cb1b-cd5e-4316-b917-33eef15cef77" ulx="95" uly="114" lrx="896" lry="146" /><zone xml:id="m-e3994b29-f1d8-4444-ab49-ed02f4a42da8" ulx="95" uly="139" lrx="489" lry="170" /><zone xml:id="m-ea05b470-f5a0-4396-8d87-2fdb6031c2c1" ulx="497" uly="140" lrx="895" lry="170" /><zone xml:id="m-e82912d4-ebe1-4e42-8284-073670767e5f" ulx="500" uly="167" lrx="895" lry="197" /><zone xml:id="m-6a812683-f9f3-49dd-bf9c-faa63dee4043" ulx="93" uly="168" lrx="488" lry="198" /><zone xml:id="m-285688ba-1b68-4bd0-9bef-e91a30685aaa" ulx="502" uly="193" lrx="896" lry="227" /><zone xml:id="m-3b846a2c-ea2c-4eb2-ae61-66f3c810b30c" ulx="95" uly="194" lrx="489" lry="225" /><zone xml:id="m-e4e792f1-8f60-42c6-9446-6f9163a6182c" ulx="96" uly="218" lrx="489" lry="250" /><zone xml:id="m-d6a4ceff-f4de-404d-8ca2-00cc76697fcb" ulx="502" uly="225" lrx="896" lry="253" /><zone xml:id="m-55dc37c8-0a9a-4331-8908-00253e820af1" ulx="97" uly="244" lrx="744" lry="281" /><zone xml:id="m-c462f759-761a-4a18-a495-3225fb6f3dc0" ulx="122" uly="276" lrx="362" lry="307" /><zone xml:id="m-dacb3fa3-20bf-4b78-b1e4-eaca0b19581e" ulx="119" uly="313" lrx="895" lry="346" /><zone xml:id="m-34721389-f733-45e9-8c90-89fc8bc6d1a4" ulx="96" uly="337" lrx="835" lry="371" /><zone xml:id="m-56372540-0151-4b3d-a0db-957c6baee006" ulx="109" uly="366" lrx="897" lry="402" /><zone xml:id="m-3cb100eb-379c-4452-86dd-357a80c6ab25" ulx="99" uly="396" lrx="493" lry="430" /><zone xml:id="m-c7bf8452-08e4-461a-bbc0-8b02c05309e8" ulx="500" uly="396" lrx="899" lry="429" /><zone xml:id="m-fdbfec30-bd56-425f-9cf3-33c4145bfa1b" ulx="501" uly="425" lrx="899" lry="451" /><zone xml:id="m-c5cfb163-72b1-471a-a4e2-ccb8d8b3046e" ulx="98" uly="426" lrx="493" lry="455" /><zone xml:id="m-76f487eb-8e8b-490f-a240-a5fafbf4d2dc" ulx="98" uly="446" lrx="491" lry="483" /><zone xml:id="m-dde9fcd5-8437-4bf2-bf00-8a08faf722d2" ulx="503" uly="448" lrx="898" lry="483" /><zone xml:id="m-1c81f09b-a88a-4c53-a11c-ec4e50940587" ulx="98" uly="474" lrx="492" lry="507" /><zone xml:id="m-9a3d6f9a-4fe8-4c65-9b00-e78c7a336867" ulx="503" uly="475" lrx="836" lry="507" /><zone xml:id="m-40fa3943-485e-4607-9ed2-d15cc5408926" ulx="98" uly="499" lrx="493" lry="532" /><zone xml:id="m-754e2e97-f59e-4dbb-b242-5940886ddf4a" ulx="123" uly="537" lrx="902" lry="572" /><zone xml:id="m-d8ff8a24-5f08-470b-984e-117c447e91be" ulx="98" uly="562" lrx="902" lry="596" /><zone xml:id="m-01e61917-006c-470d-9722-32d4ca38b8be" ulx="99" uly="588" lrx="469" lry="619" /><zone xml:id="m-61eb499b-a063-47d2-ac72-903a53555b48" ulx="133" uly="618" lrx="900" lry="654" /><zone xml:id="m-3f107b30-5a47-4240-8fc5-d8e2069a57ef" ulx="100" uly="645" lrx="717" lry="675" /><zone xml:id="m-1a207514-8770-403e-b841-37205ee5b68a" ulx="126" uly="681" lrx="901" lry="715" /><zone xml:id="m-d1359789-1b18-4afb-991a-a951f38afe2a" ulx="98" uly="704" lrx="308" lry="736" /><zone xml:id="m-3a3d0ee8-4496-4ac9-ad9b-698723549d64" ulx="120" uly="738" lrx="900" lry="773" /><zone xml:id="m-0c3ecb64-095f-4639-a557-0c9c6fe0cc18" ulx="107" uly="764" lrx="500" lry="799" /><zone xml:id="m-12c14787-b674-460d-b3a9-87a8eb782c05" ulx="124" uly="805" lrx="900" lry="836" /><zone xml:id="m-d1c4eb3b-8169-4df2-8996-d5f2fc429e42" ulx="100" uly="832" lrx="489" lry="859" /><zone xml:id="m-a6f6a2d0-4157-4812-a80c-a0e1a7dca769" ulx="125" uly="860" lrx="900" lry="891" /><zone xml:id="m-55c7c9e8-c294-47b0-8abf-6463c1348f24" ulx="100" uly="885" lrx="900" lry="915" /><zone xml:id="m-bb64d652-3882-4801-b6a7-03065022d17d" ulx="100" uly="908" lrx="889" lry="942" /><zone xml:id="m-5cc31ddf-7645-4562-997c-c07e9fe66e11" ulx="128" uly="939" lrx="811" lry="979" /><zone xml:id="m-463e418e-4800-4c1b-81ba-2afacb4b0aae" ulx="127" uly="978" lrx="391" lry="1012" /><zone xml:id="m-596eed1e-a2b2-461c-865e-d03e82e116b6" ulx="127" uly="1012" lrx="735" lry="1052" /><zone xml:id="m-22ce7d09-018d-42d5-ae57-7f699e52fd18" ulx="126" uly="1050" lrx="902" lry="1084" /><zone xml:id="m-472ae3a3-6247-47be-a38f-ce231c68e609" ulx="101" uly="1077" lrx="902" lry="1108" /><zone xml:id="m-2d309d75-4b87-4ad5-9886-36effe70a879" ulx="102" uly="1105" lrx="277" lry="1135" /><zone xml:id="m-15344c2d-c3d0-42f8-9fa2-fb50634bad66" ulx="129" uly="1129" lrx="693" lry="1166" /><zone xml:id="m-0afc822e-6dbb-4b13-8b66-96af92a0491c" ulx="126" uly="1169" lrx="414" lry="1203" /><zone xml:id="m-d8316605-cdef-40e1-a743-83689ecff136" ulx="129" uly="1203" lrx="904" lry="1238" /><zone xml:id="m-47513daf-f097-4e64-abca-fda8eac5f6dd" ulx="103" uly="1232" lrx="641" lry="1267" /><zone xml:id="m-79443f12-1221-4da6-9137-ca3018b6a27b" ulx="124" uly="1265" lrx="905" lry="1300" /><zone xml:id="m-e85337ee-4ddb-4a78-8490-c4430b402441" ulx="106" uly="1292" lrx="781" lry="1324" /><zone xml:id="m-88840934-14da-4e13-bfc1-093ca93e02b6" ulx="127" uly="1319" lrx="905" lry="1353" /><zone xml:id="m-5b9da938-4c90-45cd-be3c-25c122e5690c" ulx="104" uly="1346" lrx="907" lry="1378" /><zone xml:id="m-da2c0559-c343-4b0d-9100-f1f272b05a84" ulx="104" uly="1368" lrx="905" lry="1404" /><zone xml:id="m-93c0c33b-a859-4c7a-8722-380057a083f4" ulx="104" uly="1394" lrx="439" lry="1427" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-b0bef7e7-8ba7-435e-b6ef-f8f3e6c3f9d3" n="0894" facs="#m-96ecf050-37ab-4763-a035-dfcb6c734878" /><div xml:id="m-3a3aa6c5-43b2-426c-b238-65a57207e34e">
            <lg xml:id="m-e0883cdd-8be2-492a-8c3c-9077d7f8399c">
              <l xml:id="m-7a105f3b-6b30-4248-836e-664502cea1a6" facs="#m-0d77b3c6-02b6-4bdc-82b1-355d838a2c06" label="ambiguous">748</l><l xml:id="m-4ca8c6e6-eaea-478c-8f05-722022556021" facs="#m-3d87469f-7350-432c-83b2-6b262e686fa9" label="ambiguous">Good Friday</l><l xml:id="m-92bdfeee-e8cb-4db8-a771-c7ebffeb3fef" facs="#m-3086cb1b-cd5e-4316-b917-33eef15cef77" label="lyrics-like">stolis tuis Petro et Paulo, atque omni perturbatióne secúri. Per</l><l xml:id="m-97303eac-d467-4d73-85e8-f2454b3f81f3" facs="#m-e3994b29-f1d8-4444-ab49-ed02f4a42da8" label="lyrics-like">Andréa, et ómnibus Sanctis, he</l><l xml:id="m-650c1a05-5953-47fb-a089-6b027524b04a" facs="#m-ea05b470-f5a0-4396-8d87-2fdb6031c2c1" label="lyrics-like">eúmdem Dóminum nostrum Je¬</l><l xml:id="m-8c1c042e-a8b7-4266-ad48-e9ce16ea7f37" facs="#m-e82912d4-ebe1-4e42-8284-073670767e5f" label="ambiguous">sum Christum Filium tuum : Qui</l><l xml:id="m-cb74485f-15d5-4015-84e1-1015c30a4a2e" facs="#m-6a812683-f9f3-49dd-bf9c-faa63dee4043" label="ambiguous">does noi cross himself da propitius</l><l xml:id="m-f286dfb1-6264-4524-b661-56afbb19b667" facs="#m-285688ba-1b68-4bd0-9bef-e91a30685aaa" label="lyrics-like">tecum vivit et regnat in unitãte</l><l xml:id="m-589c7660-5aa2-4b0a-af84-2d2419ca629e" facs="#m-3b846a2c-ea2c-4eb2-ae61-66f3c810b30c" label="lyrics-like">pacem in diébus nostris; ut, ope</l><l xml:id="m-d77c4b36-967d-4d53-8f5f-cb6b3c0356a8" facs="#m-e4e792f1-8f60-42c6-9446-6f9163a6182c" label="lyrics-like">misericórdiae tuae adjúti, et a</l><l xml:id="m-5f207304-625b-475c-a0ed-a4a02ee31d89" facs="#m-d6a4ceff-f4de-404d-8ca2-00cc76697fcb" label="lyrics-like">Spiritus Sancti Deus, per ómnia</l><l xml:id="m-0e1e6c50-3e2e-4577-8f59-c70c7ebae543" facs="#m-55dc37c8-0a9a-4331-8908-00253e820af1" label="lyrics-like">peccáto simus semper liberi et ab! saécula saeculórum.</l><l xml:id="m-c1cdb261-da70-459d-86a8-eb493214b189" facs="#m-c462f759-761a-4a18-a495-3225fb6f3dc0" label="ambiguous">All answer : Amen.</l><l xml:id="m-60f65367-06cb-4658-893b-8bb6e87da133" facs="#m-dacb3fa3-20bf-4b78-b1e4-eaca0b19581e" label="text-like">28. The celebrant at once recites in a subdued voice the following prayer:</l><l xml:id="m-bd76761a-0ba1-46d0-a6ad-ec9849eb6602" facs="#m-34721389-f733-45e9-8c90-89fc8bc6d1a4" label="text-like">he makes the usual inclination and places his joined hands on the aliar:</l><l xml:id="m-1f69c02e-f978-4596-b0ec-cfeedf55f555" facs="#m-56372540-0151-4b3d-a0db-957c6baee006" label="lyrics-like">DErcéptio Córporis tui, Dómine, mentis et córporis, et ad medé¬</l><l xml:id="m-bfba071d-c484-44f0-a20b-dc8c3e77b2a0" facs="#m-3cb100eb-379c-4452-86dd-357a80c6ab25" label="lyrics-like">L Jesu Christe, quod ego indí¬</l><l xml:id="m-163c2df0-d842-4468-8e0f-29f19a4f6e8c" facs="#m-c7bf8452-08e4-461a-bbc0-8b02c05309e8" label="lyrics-like">lam percipiéndam : Qui vivis et</l><l xml:id="m-ddab7cbb-706d-4282-864b-4a8f90f1f369" facs="#m-fdbfec30-bd56-425f-9cf3-33c4145bfa1b" label="lyrics-like">regnas cum Deo Patre in unitáte</l><l xml:id="m-60029cd5-90a2-442c-aef0-ffa060bdda6f" facs="#m-c5cfb163-72b1-471a-a4e2-ccb8d8b3046e" label="lyrics-like">gnus súmere praesúmo, non mihi</l><l xml:id="m-27707ae0-388d-448c-8cc8-328b78d15573" facs="#m-76f487eb-8e8b-490f-a240-a5fafbf4d2dc" label="lyrics-like">provéniat in judicium et con¬</l><l xml:id="m-83df4c75-fc6a-4eb4-ba05-9df2c2c88829" facs="#m-dde9fcd5-8437-4bf2-bf00-8a08faf722d2" label="lyrics-like">Spiritus Sancti Deus, per ómnia</l><l xml:id="m-bceacd2f-e79b-4483-a05b-2d2f18235ef1" facs="#m-1c81f09b-a88a-4c53-a11c-ec4e50940587" label="lyrics-like">demnatiónem: sed pro tua pie¬</l><l xml:id="m-e69491d3-a492-4869-a45a-547c274ba3a0" facs="#m-9a3d6f9a-4fe8-4c65-9b00-e78c7a336867" label="lyrics-like">saécula sacculórum. Amen.</l><l xml:id="m-a40580df-00d4-448f-a382-e74fd75058b2" facs="#m-40fa3943-485e-4607-9ed2-d15cc5408926" label="lyrics-like">táte prosit mihi ad tutaméntum</l><l xml:id="m-dcba88f7-3e70-4d04-8ba0-f21dbb821d3b" facs="#m-754e2e97-f59e-4dbb-b242-5940886ddf4a" label="text-like">29. The deacon Ior the celebrantl uncovers the ciborium; the celebrant</l><l xml:id="m-66f7e199-856d-43ed-ac3e-2b94a4d2e1b4" facs="#m-d8ff8a24-5f08-470b-984e-117c447e91be" label="text-like">genuflecis, takes one of the hosts holding it over the ciborium, bows and</l><l xml:id="m-e1560787-2e8d-4e1e-a317-21b7b67f9b9e" facs="#m-01e61917-006c-470d-9722-32d4ca38b8be" label="ambiguous">striing his breast says three times:</l><l xml:id="m-63cca50c-38c9-44a5-8778-0821e2425089" facs="#m-61eb499b-a063-47d2-ac72-903a53555b48" label="lyrics-like">Omine, non sum dignus, ut sed tantum dic verbo, et saná¬</l><l xml:id="m-59aedd0f-d991-4326-888f-782c124f5636" facs="#m-3f107b30-5a47-4240-8fc5-d8e2069a57ef" label="lyrics-like">Uintres sub tectum meum: bitur ánima mea.</l><l xml:id="m-b63bd0be-6e29-4877-883c-f62a195407d7" facs="#m-1a207514-8770-403e-b841-37205ee5b68a" label="text-like">30. After this he signs himself with the Blessed Sacrament, and then adds</l><l xml:id="m-ef42edc2-1bdf-4587-977c-5d2dbeddbaeb" facs="#m-d1359789-1b18-4afb-991a-a951f38afe2a" label="ambiguous">in a subdued voice:</l><l xml:id="m-890de8e3-d412-4e1d-bfe1-6747079daa12" facs="#m-3a3d0ee8-4496-4ac9-ad9b-698723549d64" label="lyrics-like">vorpus Dómini nostri Jesu meam in vitam actérnam. Amen.</l><l xml:id="m-fad50046-54b9-4ea0-b43f-19a61283fe90" facs="#m-0c3ecb64-095f-4639-a557-0c9c6fe0cc18" label="lyrics-like">L Christi custódiat ánimam</l><l xml:id="m-dc22dbb5-7420-48ea-b872-4e49e2a192fd" facs="#m-12c14787-b674-460d-b3a9-87a8eb782c05" label="text-like">He reverently receives Holy Communion and then waits a little while</l><l xml:id="m-fce0e300-d5a6-4333-828f-e8d3f8f7e8ec" facs="#m-d1c4eb3b-8169-4df2-8996-d5f2fc429e42" label="text-like">meditating on the Blessed Sacrament.</l><l xml:id="m-65de9933-d1f5-40cb-bef8-1fdfdc0aa89c" facs="#m-a6f6a2d0-4157-4812-a80c-a0e1a7dca769" label="text-like">31. At once the deacon lor servers and the others who are presentl say</l><l xml:id="m-91dfd25e-51b9-48f4-95c3-e6a4a70ec275" facs="#m-55c7c9e8-c294-47b0-8abf-6463c1348f24" label="text-like">the Confiteor in the usual way. The celebrant genuflects, turns towards the</l><l xml:id="m-a2e5202e-4fab-4342-a9a8-a0a1d8716a97" facs="#m-bb64d652-3882-4801-b6a7-03065022d17d" label="text-like">people vith his hands joined before his breast, and says in an audible voice:</l><l xml:id="m-ce37cf4b-fc1a-4559-b38a-8a5f69c72a2f" facs="#m-5cc31ddf-7645-4562-997c-c07e9fe66e11" label="lyrics-like">Misereátur vestri omnipotens Deus... All answer : Amen.</l><l xml:id="m-be1ae073-f032-4b62-b69c-c9b365ac5ea3" facs="#m-463e418e-4800-4c1b-81ba-2afacb4b0aae" label="text-like">The celebrant continues:</l><l xml:id="m-90760643-7720-4fb5-8bc5-4e8ea37ee3fa" facs="#m-596eed1e-a2b2-461c-865e-d03e82e116b6" label="lyrics-like">Indulgéntiam, absolutiónem... All answer: Amen.</l><l xml:id="m-86c8ed2b-dbe5-4cbe-86df-177325ca1886" facs="#m-22ce7d09-018d-42d5-ae57-7f699e52fd18" label="text-like">32. He then turns towards the altar, genuflects and takes the ciborium;</l><l xml:id="m-c6f93aef-fa81-4b37-b844-361e65bb7542" facs="#m-472ae3a3-6247-47be-a38f-ce231c68e609" label="text-like">he turns back towards the people in the usual way in the middle of the altar</l><l xml:id="m-37d75345-2f03-4a21-ad38-c2a720392af6" facs="#m-2d309d75-4b87-4ad5-9886-36effe70a879" label="text-like">and says aloud:</l><l xml:id="m-cadca138-f622-4456-85bf-281550361fc0" facs="#m-15344c2d-c3d0-42f8-9fa2-fb50634bad66" label="lyrics-like">Ecce Agnus Dei, ecce qui tollit peccáta mundi.</l><l xml:id="m-409406cb-3df3-4389-99b3-7ddefc3c67ab" facs="#m-0afc822e-6dbb-4b13-8b66-96af92a0491c" label="ambiguous">He then adds, three times:</l><l xml:id="m-16aa83c3-b1dc-4ca3-b8b5-8d63287d237f" facs="#m-d8316605-cdef-40e1-a743-83689ecff136" label="lyrics-like">Dómine, non sum dignus, ut intres sub tectum meum: sed</l><l xml:id="m-b0f2f9db-bc9b-4b37-af13-99abd2337ca5" facs="#m-47513daf-f097-4e64-abca-fda8eac5f6dd" label="lyrics-like">tantum dic verbo, et sanábitur ánima mea.</l><l xml:id="m-78797527-7a33-439c-b59b-788339aa0cc2" facs="#m-79443f12-1221-4da6-9137-ca3018b6a27b" label="text-like">And he begins to distribute Holy Communion as indicated for Maundy</l><l xml:id="m-d67fb1be-4a5c-4f1c-a440-3cd698297ce6" facs="#m-e85337ee-4ddb-4a78-8490-c4430b402441" label="text-like">Thursday, p. 679, n. 29. Priests and deacons wvear purple stoles.</l><l xml:id="m-aa18feaf-366f-4033-8d96-03f9375bccf9" facs="#m-88840934-14da-4e13-bfc1-093ca93e02b6" label="text-like">If there is a great number of communicants, other priests, wearing surplice</l><l xml:id="m-ec2c5abe-a5d3-44a9-8846-304d49c3df06" facs="#m-5b9da938-4c90-45cd-be3c-25c122e5690c" label="text-like">and purple stole, may distribuie Holy Communion, either uith the celebrant</l><l xml:id="m-f1599b76-4039-46ca-b468-7c2ea548c2f6" facs="#m-da2c0559-c343-4b0d-9100-f1f272b05a84" label="lyrics-like">at the räils, or at some other fit place, provided all care is taben for the good</l><l xml:id="m-1a1af2db-6e66-4e78-ac2c-f9c7cc0846ff" facs="#m-93c0c33b-a859-4c7a-8722-380057a083f4" label="text-like">order and devotion of the people.</l></lg></div></section></score></mdiv></body></music>
</mei>