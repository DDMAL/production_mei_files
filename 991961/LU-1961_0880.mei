 /><zone xml:id="m-5a07c8ec-e57b-4c5e-a141-0ab7c961b96f" ulx="93" uly="647" lrx="491" lry="681" /><zone xml:id="m-5832a750-4017-4f13-9b97-5cd90bcf874a" ulx="501" uly="652" lrx="711" lry="679" /><zone xml:id="m-4e99576e-25dc-4630-a01b-6288e2e04454" ulx="95" uly="672" lrx="506" lry="706" /><zone xml:id="m-2d87af54-a710-4241-968b-a08314729357" ulx="523" uly="673" lrx="720" lry="707" /><zone xml:id="m-af7232f5-e982-418e-927f-a004bdc0e2fb" ulx="233" uly="738" lrx="755" lry="771" /><zone xml:id="m-64a72a43-24a9-4842-82ac-06c7038b3a21" ulx="132" uly="785" lrx="895" lry="821" /><zone xml:id="m-c0bd5330-1e80-4c52-b15e-0d6df6140852" ulx="98" uly="815" lrx="895" lry="845" /><zone xml:id="m-4f50a613-ffe8-47fe-8b97-79ceefacfdd3" ulx="93" uly="842" lrx="808" lry="875" /><zone xml:id="m-0db7cf99-3ccc-4aab-baa5-87624ca280a8" ulx="221" uly="874" lrx="768" lry="916" /><zone xml:id="m-8d9c2da1-c182-45c1-85ce-63f52ed44263" ulx="128" uly="923" lrx="895" lry="958" /><zone xml:id="m-787e48e1-0fa5-4ee8-8dec-f2d14e3adfab" ulx="500" uly="948" lrx="897" lry="978" /><zone xml:id="m-01bae74d-5858-41b7-96bd-f887c460f893" ulx="99" uly="949" lrx="490" lry="979" /><zone xml:id="m-e91ab9af-b8dd-40d5-a1e5-4bdd0ea3178a" ulx="500" uly="973" lrx="896" lry="1009" /><zone xml:id="m-59065674-9f7d-4c14-915f-5b31eb5696aa" ulx="96" uly="974" lrx="491" lry="1006" /><zone xml:id="m-0e2c5cca-adef-4ca2-be9e-a346211cb3ec" ulx="94" uly="999" lrx="491" lry="1032" /><zone xml:id="m-0158f0d8-0c3f-4ac0-a52a-b61ed476cccc" ulx="501" uly="1005" lrx="818" lry="1035" /><zone xml:id="m-323b896a-1ec6-4ac8-ac2d-ba89b0da8266" ulx="95" uly="1025" lrx="500" lry="1063" /><zone xml:id="m-aea09317-9866-440e-88fb-0fbf6f9afeb9" ulx="528" uly="1025" lrx="722" lry="1060" /><zone xml:id="m-8d7fae1d-6560-421b-94ab-cacf77ff0509" ulx="207" uly="1097" lrx="777" lry="1131" /><zone xml:id="m-284df1dd-4529-4ae8-a19c-b0a61b0d4c65" ulx="129" uly="1137" lrx="901" lry="1178" /><zone xml:id="m-169c600b-9727-4165-a352-efdad1d94e63" ulx="98" uly="1168" lrx="900" lry="1205" /><zone xml:id="m-2ea636cf-4504-484a-b827-3f5e14f9b99a" ulx="94" uly="1194" lrx="453" lry="1227" /><zone xml:id="m-a4abc4bd-a0ed-4b8c-8c86-b7652268e1a9" ulx="224" uly="1229" lrx="768" lry="1268" /><zone xml:id="m-96f18f3f-33ed-46d5-9fc0-1e25a07eb98b" ulx="130" uly="1273" lrx="899" lry="1313" /><zone xml:id="m-314ed6da-5320-457f-bdfc-dcf2fe323f73" ulx="102" uly="1301" lrx="900" lry="1337" /><zone xml:id="m-1285fbae-f68e-44bc-94d9-e58886b13d1c" ulx="504" uly="1328" lrx="900" lry="1362" /><zone xml:id="m-4b014c68-4ddd-41f0-b48b-06f701bbbad8" ulx="96" uly="1330" lrx="492" lry="1365" /><zone xml:id="m-74e78240-e12a-4b04-866a-5c8a7ea57f47" ulx="97" uly="1357" lrx="493" lry="1391" /><zone xml:id="m-83c33539-6cb1-4751-bcdf-0d24e0391669" ulx="505" uly="1357" lrx="710" lry="1388" /><zone xml:id="m-de86eb14-cad2-4d2b-9e8c-7b1875bd0c74" ulx="531" uly="1380" lrx="717" lry="1418" /><zone xml:id="m-3f229f17-2008-47dc-97ea-4685cc3ba250" ulx="97" uly="1381" lrx="491" lry="1419" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-1ad79fe3-ecb8-42e5-b28a-811050a00a9b" n="0880" facs="#m-f23c79b3-a31e-4118-a338-eaa137e82dc0" /><div xml:id="m-134f092a-032a-446f-86ec-ea6678dc90ee">
            <lg xml:id="m-16e04718-6d18-4a19-b032-e55dbffd3df4">
              <l xml:id="m-92f8ee13-8f0d-44f3-be35-a16b7f9a8fd9" facs="#m-8768806d-1ce9-402f-92bb-53565c5c4fe5" label="ambiguous">734</l><l xml:id="m-f1af59b5-1e3b-4bdb-acf3-ebca5a7ec2f0" facs="#m-87146ddf-310c-4e0b-8476-a712ffc2773d" label="ambiguous">Good Friday</l><l xml:id="m-7de373b2-4a7c-44d5-889c-6558bda6db1f" facs="#m-a09c8d43-3140-45c4-9dac-16923fd577a2" label="lyrics-like">ómnium peccatórum, et ipsi inveniántur in Christo Jesu Dómino</l><l xml:id="m-314e1228-a095-4692-bc64-6dc3d4e128bf" facs="#m-4f01ecf1-3290-45a0-a7bc-f06210c34f96" label="ambiguous">nostro.</l><l xml:id="m-c2ec7e27-a084-4e6b-835b-6fe3affd0e60" facs="#m-8fcbe820-4e04-44c1-825a-84ea682d61f0" label="lyrics-like">C. Orémus. D. Flectámus génua. D. Leváte.</l><l xml:id="m-790549a4-18e8-4f0a-a1f9-593575434e67" facs="#m-f065333b-f228-4f1e-9c33-a9b2ff97f928" label="lyrics-like">Mnípotens sempitérne Deus, (nis nostris; ut, renáti fonte ba¬</l><l xml:id="m-7eddef18-f0a0-4da1-b0e8-3a14e5fe4428" facs="#m-288c7022-0d65-46f1-b77a-cec3fabfedbe" label="lyrics-like">U qui Ecclésiam tuam nova ptismatis, adoptiónis tuae flliis</l><l xml:id="m-75090783-fa45-4b71-adbe-f13d472e80c7" facs="#m-a71d2b49-03e8-49a0-90c4-5e656a7b298e" label="lyrics-like">semper prole fecúndas: “auge l aggregéntur. Per Dóminum.</l><l xml:id="m-e65e1377-9451-41ce-8e5e-d60a9f1d97ba" facs="#m-081928e5-fe83-41fe-b799-e8c295bb0c23" label="lyrics-like">áu : M. Amen.</l><l xml:id="m-9c8be38d-ee53-414c-b6da-330715efcd94" facs="#m-08a1cbb9-28f2-412c-a903-6814da1b86ce" label="lyrics-like">nidem et intelléctum catechúme¬</l><l xml:id="m-daf5931d-c336-45b8-b958-9f4c0f57eff3" facs="#m-f98c66bc-1af0-4169-80c7-c5c0f08040f1" label="text-like">G. FOR THE NECESSITY OF THE FAITHFUL</l><l xml:id="m-af7b71b2-c92c-4739-8a53-765e4a6d3bbf" facs="#m-a51f7f2c-9639-426c-a1ae-8312e673b87a" label="lyrics-like">Rémus, dilectíssimi nobis, Deum Patrem omnipoténtem, ut</l><l xml:id="m-57d88e4f-4059-45c7-bc6e-a9f4359cfbc5" facs="#m-f0cae66f-f322-44bc-bc3a-96ccab162ead" label="lyrics-like">U cunctis mundum purget erróribus: morbos áuferat: famem</l><l xml:id="m-2cbfb390-d5b4-43a1-ba12-e5b3fa57079e" facs="#m-42765906-2490-4d17-b138-c91a7479681c" label="lyrics-like">depéllat: apériat cárceres: víncula dissólvat: peregrinántibus</l><l xml:id="m-e44c07eb-a963-4742-a7ac-ece595f339a2" facs="#m-67cf5157-c306-47cd-bce0-f8722bcaa39c" label="lyrics-like">réditum: infirmántibus sanitátem : navigántibus portum salútis</l><l xml:id="m-23d98e57-7ce3-4b52-aaec-63f2dccdf2c0" facs="#m-31a5b352-62f5-4e7d-aced-6264ad36acf8" label="lyrics-like">indúlgeat.</l><l xml:id="m-b6f1a866-5253-4bb3-9dce-4f59deb4f1d9" facs="#m-e7a34967-d6ca-4350-afbb-7250cd24cf7f" label="lyrics-like">C. Orémus. D. Flectámus génua. D. Leváte.</l><l xml:id="m-e8f855de-9280-47c5-af94-393026d9950a" facs="#m-8e0e1668-51a1-4707-b943-376eec75c4cc" label="lyrics-like">Mnípotens sempitérne Deus, omnes sibi in necessitátibus suis</l><l xml:id="m-58323826-338a-4726-831b-416040a53803" facs="#m-805c3781-5f90-4478-91a1-4ad744202482" label="lyrics-like">U maestórum consolátio, labo-l misericórdiam tuam gáudeant</l><l xml:id="m-20e22689-1861-4357-adf0-6388eb200590" facs="#m-59a0d57f-8963-4733-bafe-c35c5a5ba407" label="lyrics-like">rántium fortitúdo : * pervéniant affuisse. Per Dóminum nostrum</l><l xml:id="m-e945852d-75e2-41de-82dc-13a944d5a814" facs="#m-5a07c8ec-e57b-4c5e-a141-0ab7c961b96f" label="lyrics-like">ad te preces de quacúmque</l><l xml:id="m-b888e59c-e4d7-4ef1-bb89-a2b63008a43b" facs="#m-5832a750-4017-4f13-9b97-5cd90bcf874a" label="ambiguous">Jesum Christum.</l><l xml:id="m-b7f3ad4c-7bb0-49c8-8cbb-9931951ee21a" facs="#m-4e99576e-25dc-4630-a01b-6288e2e04454" label="lyrics-like">tribulatióne clamántium; ut</l><l xml:id="m-c9b4851c-ec13-449c-8a04-38d1549c05b4" facs="#m-2d87af54-a710-4241-968b-a08314729357" label="ambiguous">All : K. Amen.</l><l xml:id="m-465da140-e430-47e5-a5b6-f26f15357e3b" facs="#m-af7232f5-e982-418e-927f-a004bdc0e2fb" label="text-like">T. FOR THE UNITY OF THE CHURCH</l><l xml:id="m-f4a2da34-4308-4c42-bc63-5ae6ef539277" facs="#m-64a72a43-24a9-4842-82ac-06c7038b3a21" label="lyrics-like">Rémus et pro haeréticis et schismáticis: ut Deus et Dóminus</l><l xml:id="m-b8a6ae4a-de48-4339-9f8b-597989677540" facs="#m-c0bd5330-1e80-4c52-b15e-0d6df6140852" label="lyrics-like">U noster éruat eos ab erróribus univérsis; et ad sanctam matrem</l><l xml:id="m-4b63e241-db3c-4589-8335-4867749af8dc" facs="#m-4f50a613-ffe8-47fe-8b97-79ceefacfdd3" label="lyrics-like">Ecclésiam cathólicam atque apostólicam revocâre dignétur.</l><l xml:id="m-fc99c19e-f534-465a-b70d-e69a5b3b3766" facs="#m-0db7cf99-3ccc-4aab-baa5-87624ca280a8" label="lyrics-like">C. orémus. D. Flectámus génua. D. Leváte.</l><l xml:id="m-420385e2-d724-44d3-80a5-b2d2c965d803" facs="#m-8d9c2da1-c182-45c1-85ce-63f52ed44263" label="lyrics-like">Mnípotens sempitérne Deus, depósita, errántium corda resi¬</l><l xml:id="m-9b403398-9c97-4bf7-ba5e-cc81a268912e" facs="#m-787e48e1-0fa5-4ee8-8dec-f2d14e3adfab" label="lyrics-like">píscant, et ad veritátis tuae</l><l xml:id="m-956c2e9d-23d0-4ef8-a782-c2bf526c13b6" facs="#m-01bae74d-5858-41b7-96bd-f887c460f893" label="lyrics-like">U qui salvas omnes, et némi¬</l><l xml:id="m-3585101a-edbe-481f-9aec-6f10594a3ef8" facs="#m-e91ab9af-b8dd-40d5-a1e5-4bdd0ea3178a" label="lyrics-like">rédeant unitátem. Per Dóminum</l><l xml:id="m-87cfc8a2-b7be-48c6-8c09-fc179943ffc9" facs="#m-59065674-9f7d-4c14-915f-5b31eb5696aa" label="lyrics-like">nem vis perire:*réspice ad</l><l xml:id="m-f787e7e4-0655-4265-85a5-e2a3eaf00a5f" facs="#m-0e2c5cca-adef-4ca2-be9e-a346211cb3ec" label="lyrics-like">ánimas diabólica fraude decé¬</l><l xml:id="m-8d7b1ce2-deed-4c94-916a-3e9535c0c1d8" facs="#m-0158f0d8-0c3f-4ac0-a52a-b61ed476cccc" label="ambiguous">nostrum Jesum Christum.</l><l xml:id="m-82b778e7-b191-4cf3-92f2-faf85f6ffbcc" facs="#m-323b896a-1ec6-4ac8-ac2d-ba89b0da8266" label="lyrics-like">ptas;ut, omni haerética pravitáte</l><l xml:id="m-1d96ed5c-6bcb-4ff1-8a0f-8614935ff578" facs="#m-aea09317-9866-440e-88fb-0fbf6f9afeb9" label="ambiguous">Al: W. Amen.</l><l xml:id="m-c56fb37a-2677-4118-865f-7961598afd56" facs="#m-8d7fae1d-6560-421b-94ab-cacf77ff0509" label="text-like">S. FOR THE CONVERSION OF THE JEWS</l><l xml:id="m-60128f59-afba-416e-9866-cc40e6eb3180" facs="#m-284df1dd-4529-4ae8-a19c-b0a61b0d4c65" label="lyrics-like">Rémus et pro Judaéis: ut Deus et Dóminus noster áuferat</l><l xml:id="m-710197b1-80ae-4bbc-bf5b-8cf5e6931a5e" facs="#m-169c600b-9727-4165-a352-efdad1d94e63" label="lyrics-like">U velámen de córdibus eórum; ut et ipsi agnóscant Jesum</l><l xml:id="m-9d22851c-7546-40ef-ae7f-495aa4648b3c" facs="#m-2ea636cf-4504-484a-b827-3f5e14f9b99a" label="lyrics-like">Christum Dóminum nostrum.</l><l xml:id="m-15ebe27b-48a0-4794-aa18-f29673714a73" facs="#m-a4abc4bd-a0ed-4b8c-8c86-b7652268e1a9" label="lyrics-like">C. Orémus. D. Flectámus génua. D. Leváte.</l><l xml:id="m-1e28ea30-1651-4486-b923-9acb5410b9af" facs="#m-96f18f3f-33ed-46d5-9fc0-1e25a07eb98b" label="lyrics-like">Mnípotens sempitérne Deus, ut, ágnita veritátis tuae luce,</l><l xml:id="m-881a6a30-d79a-4031-9f09-b1f3af6800e6" facs="#m-314ed6da-5320-457f-bdfc-dcf2fe323f73" label="lyrics-like">U qui Judaéos étiam a tua mise-quae Christus est, a suis téne¬</l><l xml:id="m-de4524d6-7b20-4d89-bbae-0ca8cae667ca" facs="#m-1285fbae-f68e-44bc-94d9-e58886b13d1c" label="lyrics-like">bris eruántur. Per eúmdem Dó¬</l><l xml:id="m-d800bf13-13de-4942-96ee-43f142272795" facs="#m-4b014c68-4ddd-41f0-b48b-06f701bbbad8" label="lyrics-like">ricórdia non repéllis: udi</l><l xml:id="m-8cb61d58-5b47-4481-b740-9965a8a4412d" facs="#m-74e78240-e12a-4b04-866a-5c8a7ea57f47" label="ambiguous">preces nostras, quas pro illius</l><l xml:id="m-b972d439-55d4-4a07-88fc-167e770b4cc1" facs="#m-83c33539-6cb1-4751-bcdf-0d24e0391669" label="ambiguous">minum nostrum.</l><l xml:id="m-3822d9e0-4426-4303-94bb-701519ae3ad9" facs="#m-de86eb14-cad2-4d2b-9e8c-7b1875bd0c74" label="ambiguous">Al: W. Amen.</l><l xml:id="m-ac6d6e5c-a534-47f1-881b-c6def2d052a6" facs="#m-3f229f17-2008-47dc-97ea-4685cc3ba250" label="lyrics-like">pópuli obcaecatióne deférimus;</l></lg></div></section></score></mdiv></body></music>
</mei>