="1000" lry="683" /><zone xml:id="m-37188ff0-2bfa-47f8-aebf-b0442cd3e54f" ulx="122" uly="675" lrx="1002" lry="709" /><zone xml:id="m-d312c063-b4dc-47ec-8713-95b6adc5118d" ulx="563" uly="704" lrx="1001" lry="742" /><zone xml:id="m-aa400ffd-7bdc-43c5-89ca-9eec4beaf0ce" ulx="122" uly="705" lrx="559" lry="740" /><zone xml:id="m-46051087-e095-4616-9a3c-d55b3bd0f341" ulx="121" uly="733" lrx="558" lry="764" /><zone xml:id="m-aecf7d54-9c47-40c7-8b23-eb10ff69bafb" ulx="565" uly="737" lrx="849" lry="766" /><zone xml:id="m-25457285-40b3-4a8a-9d55-59826f4bc0c1" ulx="121" uly="757" lrx="558" lry="797" /><zone xml:id="m-15bfe2f7-165d-479e-9a5b-0778acad1eda" ulx="122" uly="825" lrx="180" lry="868" /><zone xml:id="m-d9e66e6f-9951-4204-aa61-e7f33432205d" ulx="403" uly="825" lrx="740" lry="871" /><zone xml:id="m-597158ce-1f8a-440b-af2b-2bb10e38491c" ulx="901" uly="833" lrx="1002" lry="868" /><zone xml:id="m-87a10b9f-630e-4713-8d28-b748365fba4d" ulx="146" uly="870" lrx="782" lry="910" /><zone xml:id="m-3b7b6b87-b502-499e-a251-ab8fc8082b06" ulx="505" uly="900" lrx="615" lry="933" /><zone xml:id="m-cc74317d-cd5e-4e69-b4ed-324e446235c0" ulx="146" uly="926" lrx="1003" lry="963" /><zone xml:id="m-836e807c-a472-47a9-8d4d-2580011c0817" ulx="128" uly="957" lrx="999" lry="992" /><zone xml:id="m-936cb9f4-5229-43dd-96b8-f5cc2e9d8df5" ulx="122" uly="984" lrx="557" lry="1019" /><zone xml:id="m-4ecf7b3c-25e7-4fb0-a60c-10526df666fc" ulx="566" uly="986" lrx="1001" lry="1018" /><zone xml:id="m-9cc731d6-0db3-4a26-8181-0ad2773e7e29" ulx="569" uly="1012" lrx="867" lry="1052" /><zone xml:id="m-cb9d6219-2577-4cba-abd0-84d66372c5cf" ulx="122" uly="1015" lrx="555" lry="1044" /><zone xml:id="m-f9fb1871-6c09-4375-b2ca-436b066b91c3" ulx="122" uly="1039" lrx="560" lry="1075" /><zone xml:id="m-2812e917-6cf7-418a-977b-1255a852bbd0" ulx="146" uly="1076" lrx="977" lry="1115" /><zone xml:id="m-a8148961-ee7b-48f1-85eb-c893ca26cf07" ulx="504" uly="1110" lrx="618" lry="1146" /><zone xml:id="m-63d5f59f-6168-4d02-add0-9ba1199dfbfd" ulx="134" uly="1137" lrx="1004" lry="1180" /><zone xml:id="m-bcab2364-4fb7-4c39-91d8-ebecf4c05434" ulx="123" uly="1169" lrx="1004" lry="1203" /><zone xml:id="m-144ebaf3-168b-4b01-a750-273015f77c08" ulx="124" uly="1195" lrx="838" lry="1234" /><zone xml:id="m-5070d1c6-7465-4342-bb08-07f96c7ad22a" ulx="515" uly="1233" lrx="616" lry="1266" /><zone xml:id="m-88e8ee86-417e-4380-9fb4-081a470f2fa8" ulx="166" uly="1264" lrx="1006" lry="1298" /><zone xml:id="m-79a9150e-7611-46e2-aa2c-0f1de681364b" ulx="126" uly="1292" lrx="1004" lry="1332" /><zone xml:id="m-c37436aa-18f0-4fda-a1e2-6b8136affa2d" ulx="123" uly="1321" lrx="1002" lry="1356" /><zone xml:id="m-507069d8-2a2a-4423-b261-db2cbb67da09" ulx="124" uly="1347" lrx="710" lry="1385" /><zone xml:id="m-0e3aa0dc-7a4e-4bb4-b290-d9f53030a5bf" ulx="144" uly="1380" lrx="625" lry="1420" /><zone xml:id="m-2beaa52c-cfe2-47c4-9e88-c3b7e93177fb" ulx="439" uly="1417" lrx="682" lry="1450" /><zone xml:id="m-be3b32e1-2526-48a5-a2b6-548c2f4c7ce5" ulx="157" uly="1449" lrx="1000" lry="1485" /><zone xml:id="m-a297c315-9195-4299-b1a8-9366a83c8d29" ulx="122" uly="1474" lrx="998" lry="1512" /><zone xml:id="m-fdd69868-3a0c-4bb5-87ed-aec553db556e" ulx="122" uly="1501" lrx="859" lry="1542" /><zone xml:id="m-84e2e0d6-075d-46a6-a06f-08b376470b02" ulx="145" uly="1536" lrx="842" lry="1577" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-ff69e0fe-3268-4c90-bf5b-e0d99809e319" n="2008" facs="#m-7dc062d0-1df4-4596-a6cc-7d4ae15c14d3" /><div xml:id="m-f1117be5-ac76-42f2-8892-2478b5f72924">
            <lg xml:id="m-c8910ded-4d35-4589-8266-a27307300265">
              <l xml:id="m-732a7046-7ae0-4415-ba70-55a44d4916b3" facs="#m-dd681f05-f23c-4d19-b61d-91dd0abdbd9c" label="ambiguous">1762</l><l xml:id="m-1129a667-7579-4351-af6c-79021a6e9480" facs="#m-df460beb-639d-4fb7-8e63-75560c31f35f" label="ambiguous">November. 25. 26.</l><l xml:id="m-ee0ccafc-d432-474c-bdb5-9ff5b9862735" facs="#m-68cc2109-b569-400b-a0f1-884324d87c40" label="text-like">Commemoration of St. Chrysogonus, Martyr.</l><l xml:id="m-6be95ae7-6bac-4005-8cc6-89300f6ee586" facs="#m-356b4558-0e43-4b55-9f57-f0150daef661" label="ambiguous">Collect.</l><l xml:id="m-4f0f91f8-8e7c-4c98-88c2-1b482c284fef" facs="#m-2deb2a07-d13f-40c9-8070-8eb4ff9b56d2" label="lyrics-like">I Désto, Dómine, supplicatiónibus beáti Chrysógoni Mártyris tui inter¬</l><l xml:id="m-6721298f-e53c-44bb-9abe-51b4f63381e1" facs="#m-82add1e4-1bdb-45b2-a0e9-2d5de1a4eacb" label="lyrics-like">H nostris :* ut qui ex iniquitáte cessióne liberémur. Per Dóminum</l><l xml:id="m-5be576e4-56a3-46be-b52d-87a9c6a47d1c" facs="#m-ed060adc-790e-47cf-8e0e-6b05710a53de" label="lyrics-like">nostra reos nos esse cognóscimus,l nostrum.</l><l xml:id="m-ca56961a-8861-4649-8fb6-585ff2d61cc4" facs="#m-75337a2f-b460-41d6-bd4a-8e5b7e74da1e" label="ambiguous">Secret.</l><l xml:id="m-9b334f3f-9e19-4b54-bbaf-6262e999f501" facs="#m-a94fa60d-3945-4876-b31b-8dac49aaf811" label="lyrics-like">Blátis, quaésumus Dómine, pla-l tuo, a cunctis nos defénde periculis.</l><l xml:id="m-f38ed048-fab2-412a-b455-85ddcaa6007f" facs="#m-da51c51a-eb6b-4ea4-97ce-38344be574f6" label="lyrics-like">U cáre munéribus: et, interce-l Per Dóminum.</l><l xml:id="m-7bd10778-f371-40f3-babb-73f76c6e08dc" facs="#m-edcb0827-5506-479d-9f2e-f6ccf07ddf29" label="lyrics-like">dénte beato Chrysógono Mártyre</l><l xml:id="m-330d7652-cd8f-4bdf-9979-08acf97811d9" facs="#m-ae2a3db3-3a2f-448d-bcee-93a4b88d9f66" label="ambiguous">Postcommunion.</l><l xml:id="m-5c777f8c-d84e-4316-b5c0-5ea449713c3a" facs="#m-9ec11821-8a27-4dda-9d40-f5ab14c5a600" label="lyrics-like">TUI Dómine perceptióne sacra-] occúltis, et ab hóstium liberémur</l><l xml:id="m-d6d45557-8c86-4572-a731-0c39e4a49c5e" facs="#m-75fee8e7-59fe-4d23-a80b-61046649b7c1" label="lyrics-like">I ménti, et a nostris mundémur linsidiis. Per Dóminum.</l><l xml:id="m-a4fc6e21-356f-408b-b50c-49ed68f0e6dd" facs="#m-91fbf838-b863-4d25-bb59-b3a1cd9a6850" label="text-like">St. Catherine, Virgin and Martyr.</l><l xml:id="m-9ae14d46-bfd8-42a3-9983-bfc40374b372" facs="#m-dd09fe3f-c936-4aa2-8339-b7f25aa0dd4e" label="ambiguous">25.</l><l xml:id="m-65a18b32-e223-4a46-8490-76952a36d4f4" facs="#m-2ae57ddf-1dcd-4a34-9d66-96244bcc19b6" label="ambiguous">Double.</l><l xml:id="m-490cc028-efb1-496f-aa7d-0ea93a4bf82b" facs="#m-2c85ee1c-53c5-42c5-bd6d-d1b9e86f87fe" label="lyrics-like">Mass. Loquébar. p. 1215.</l><l xml:id="m-9dbdc2ac-8fcd-4596-b51e-b663e85f93f7" facs="#m-d664d5ac-2ebf-4ff5-b61f-9e5db298dd79" label="ambiguous">Collect.</l><l xml:id="m-e65ca56f-f1cd-4800-aec2-fa2f382c88d3" facs="#m-c1b1f3d2-03ba-46a7-85c7-3c37ff4efba8" label="lyrics-like">Eus, qui dedísti legem Móysi] collocásti : t praesta, quaésumus;</l><l xml:id="m-906d7dce-61ea-4fe6-8199-73a0694fc285" facs="#m-37188ff0-2bfa-47f8-aebf-b0442cd3e54f" label="lyrics-like">I in summitáte montis Sinai, et lut ejus méritis et intercessióne, “ ad</l><l xml:id="m-bdab04a7-abf2-4f6a-82f1-048c65e4d758" facs="#m-d312c063-b4dc-47ec-8713-95b6adc5118d" label="ambiguous">montem qui Christus est, perventre</l><l xml:id="m-1e022122-4b28-4adf-9eb6-eeef2da4605d" facs="#m-aa400ffd-7bdc-43c5-89ca-9eec4beaf0ce" label="lyrics-like">in códem loco per sanctos Angelos</l><l xml:id="m-820d8758-3c03-4809-a089-253746387031" facs="#m-46051087-e095-4616-9a3c-d55b3bd0f341" label="lyrics-like">tuos corpus beátae Catharinae Vir¬</l><l xml:id="m-8aa37a34-44f2-40a6-9650-364f0b487a3b" facs="#m-aecf7d54-9c47-40c7-8b23-eb10ff69bafb" label="lyrics-like">valeámus : Qui tecum.</l><l xml:id="m-9eca8bdb-3616-444b-b260-4ddbd26cea8f" facs="#m-25457285-40b3-4a8a-9d55-59826f4bc0c1" label="lyrics-like">ginis et Mártyris tuae mirabiliter</l><l xml:id="m-2d313786-3527-404c-bade-d68840baa3d1" facs="#m-15bfe2f7-165d-479e-9a5b-0778acad1eda" label="ambiguous">26.</l><l xml:id="m-db1f9f43-5afc-4710-ab0f-0f9e474fa22d" facs="#m-d9e66e6f-9951-4204-aa61-e7f33432205d" label="ambiguous">St. Sylvester, Abbot.</l><l xml:id="m-e716791a-5977-4e42-8e65-7eea177f39ed" facs="#m-597158ce-1f8a-440b-af2b-2bb10e38491c" label="ambiguous">Double.</l><l xml:id="m-5cc2d554-dcec-409c-9bf0-849bd288617d" facs="#m-87a10b9f-630e-4713-8d28-b748365fba4d" label="lyrics-like">Mass. Os jústi. from the Common of Abbots, p. 1206.</l><l xml:id="m-1b63e46f-48db-41ee-8c11-ae078816a062" facs="#m-3b7b6b87-b502-499e-a251-ab8fc8082b06" label="ambiguous">Collect.</l><l xml:id="m-27572e9b-c230-4ce8-9ed7-0eeaec8b05e7" facs="#m-cc74317d-cd5e-4e69-b4ed-324e446235c0" label="lyrics-like">VLementissime Deus, qui sanctum ! dignátus es: t te súpplices exorá¬</l><l xml:id="m-17e7e233-46ea-4c2b-a466-98e84820c6f0" facs="#m-836e807c-a472-47a9-8d4d-2580011c0817" label="lyrics-like">L silvéstrum Abbátem, saéculi ! mus; ut ejus exémplo terréna despi¬</l><l xml:id="m-9a929582-6ff4-46ed-a90b-817f95651e8a" facs="#m-936cb9f4-5229-43dd-96b8-f5cc2e9d8df5" label="lyrics-like">hujus vanitátem in apérto túmulo</l><l xml:id="m-39a0e017-5a62-4fab-8f4e-db740edb8b9e" facs="#m-4ecf7b3c-25e7-4fb0-a60c-10526df666fc" label="lyrics-like">ciéntes, * tui consõrtio perfruámur</l><l xml:id="m-383b1323-34f6-4dc9-90dd-e13bed82c695" facs="#m-9cc731d6-0db3-4a26-8181-0ad2773e7e29" label="lyrics-like">aetérnó. Per Dóminum.</l><l xml:id="m-57d22bd3-5959-4a24-9e55-57243f85dd43" facs="#m-cb9d6219-2577-4cba-abd0-84d66372c5cf" label="lyrics-like">pie meditántem, ad erémum vocáre,</l><l xml:id="m-dae25a33-8ab9-42ef-af60-238c4e75972b" facs="#m-f9fb1871-6c09-4375-b2ca-436b066b91c3" label="lyrics-like">et praecláris vitae méritis decoráre</l><l xml:id="m-3fcaf053-980b-468d-8259-c1d21787aae6" facs="#m-2812e917-6cf7-418a-977b-1255a852bbd0" label="text-like">Commemoration of St. Peter of Alexandria, Bishop and Martyr.</l><l xml:id="m-af80b3c3-8aed-4655-ab81-01f7f68d932a" facs="#m-a8148961-ee7b-48f1-85eb-c893ca26cf07" label="ambiguous">Collect.</l><l xml:id="m-09d2c1b5-e19d-4efd-9f94-1a73475e9c87" facs="#m-63d5f59f-6168-4d02-add0-9ba1199dfbfd" label="lyrics-like">TNfirmitátem nostram réspice, Ibeáti Petri Mártyris tui atque Pon¬</l><l xml:id="m-a43d8891-e1e7-44e3-a8b3-a765086f958a" facs="#m-bcab2364-4fb7-4c39-91d8-ebecf4c05434" label="lyrics-like">L omnípotens Deus:“ et quia l tíficis intercéssio gloriósa nos pró¬</l><l xml:id="m-d0e19979-59b0-45da-adbc-5c5c985c2547" facs="#m-144ebaf3-168b-4b01-a750-273015f77c08" label="lyrics-like">pondus própriae actiónis gravat,l tegat. Per Dóminum.</l><l xml:id="m-47c3f115-6798-4cf2-9577-152a4355f047" facs="#m-5070d1c6-7465-4342-bb08-07f96c7ad22a" label="ambiguous">Secret.</l><l xml:id="m-e91ffc9d-2909-41a1-84c1-77d71a4f7492" facs="#m-88e8ee86-417e-4380-9fb4-081a470f2fa8" label="lyrics-like">Uaésumus Dómine, ut dum haec! beáti Silvéstri Abbátis imitatóres</l><l xml:id="m-8b2195b9-0af0-4e55-b543-dc5832db8a59" facs="#m-79a9150e-7611-46e2-aa2c-0f1de681364b" label="lyrics-like">U múnera divinae majestáti tuael effécti, corpus et sánguinem Fili</l><l xml:id="m-e409896d-9c35-4c73-863e-7c7381450f72" facs="#m-c37436aa-18f0-4fda-a1e2-6b8136affa2d" label="lyrics-like">reverénter offérimus; pia mentis! tui sancte percipere mereámur</l><l xml:id="m-7f8a9f7c-3178-4dbc-9394-8618090ae06c" facs="#m-507069d8-2a2a-4423-b261-db2cbb67da09" label="lyrics-like">praeparatióne et cordis puritáte,! Qui tecum.</l><l xml:id="m-5490d805-9232-4997-862c-3880317f6105" facs="#m-0e3aa0dc-7a4e-4bb4-b290-d9f53030a5bf" label="lyrics-like">of St. Peter. Secret. Hóstias tibi. p. 1182.</l><l xml:id="m-4ae85ede-9676-41b1-8da0-f469a0874e4b" facs="#m-2beaa52c-cfe2-47c4-9e88-c3b7e93177fb" label="ambiguous">Postcommunion.</l><l xml:id="m-b07f7a23-ceb6-47fb-84fe-ac1de6a6da12" facs="#m-be3b32e1-2526-48a5-a2b6-548c2f4c7ce5" label="lyrics-like">AIvína dape reféctis tribue, quaé-] copiósam mercédem in regno glé¬</l><l xml:id="m-82b95eaf-2244-4148-84cd-066f84007b7e" facs="#m-a297c315-9195-4299-b1a8-9366a83c8d29" label="lyrics-like">O sumus Dómine, sancti Silvéstri l riae tuae cum sanctis habeámus.</l><l xml:id="m-21e65fc8-ea70-48b7-ae2e-d0609c5f6cc7" facs="#m-fdd69868-3a0c-4bb5-87ed-aec553db556e" label="lyrics-like">Abbátis vestigiis ita inhaerére: ut Per Dóminum nostrum.</l><l xml:id="m-7c184fe2-0d0b-4765-8c31-eb8b11dbe7e5" facs="#m-84e2e0d6-075d-46a6-a06f-08b376470b02" label="lyrics-like">orSt Peter. Postcommunion. Refécti participatióne. p. 1182.</l></lg></div></section></score></mdiv></body></music>
</mei>