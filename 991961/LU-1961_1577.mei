/><zone xml:id="m-f0978420-5d05-487d-8d25-c72e64c233ad" ulx="467" uly="684" lrx="898" lry="712" /><zone xml:id="m-f8ea8d44-e951-4498-b532-c99f5140561f" ulx="37" uly="708" lrx="462" lry="740" /><zone xml:id="m-9c92dbb6-3cee-40e4-a039-a26d92dec68e" ulx="472" uly="713" lrx="897" lry="741" /><zone xml:id="m-b32b72fa-1f30-4615-963a-675beed262d9" ulx="35" uly="736" lrx="461" lry="768" /><zone xml:id="m-01251bf2-ebfa-4218-b074-c02967cebe2f" ulx="472" uly="737" lrx="899" lry="764" /><zone xml:id="m-53a273fb-e4b5-482f-8694-def46236cf3d" ulx="471" uly="758" lrx="900" lry="795" /><zone xml:id="m-d6975386-ef59-465f-88ff-75c9937b4e1f" ulx="36" uly="760" lrx="464" lry="795" /><zone xml:id="m-56611d72-fcfb-427d-b269-87f754d3d713" ulx="471" uly="786" lrx="900" lry="823" /><zone xml:id="m-7bba9041-7b6a-4e89-9437-338d258f6f59" ulx="36" uly="787" lrx="463" lry="822" /><zone xml:id="m-cc30decf-38ee-45f9-9bce-f3e902cc8547" ulx="473" uly="814" lrx="899" lry="846" /><zone xml:id="m-5ecb8360-0411-4f98-8edc-1ecface1b578" ulx="36" uly="816" lrx="463" lry="849" /><zone xml:id="m-eace615c-ffad-4459-98d2-54547ab89e30" ulx="473" uly="840" lrx="899" lry="873" /><zone xml:id="m-12f8e263-59d0-4ebb-86e7-700dab084a50" ulx="36" uly="844" lrx="463" lry="876" /><zone xml:id="m-bb79a563-1329-4fee-9e12-98a2c3062655" ulx="473" uly="868" lrx="898" lry="902" /><zone xml:id="m-411812b5-6bde-4722-8d27-b6bde5631392" ulx="36" uly="873" lrx="463" lry="901" /><zone xml:id="m-44652bad-b200-4296-a458-47eb54303cc8" ulx="38" uly="896" lrx="462" lry="931" /><zone xml:id="m-352d9afd-d792-413b-bb7e-fa95ee166822" ulx="473" uly="897" lrx="900" lry="927" /><zone xml:id="m-026d6eab-daeb-40ae-8d39-d9f49b48ae34" ulx="474" uly="921" lrx="899" lry="953" /><zone xml:id="m-b7383d4f-ba11-4c52-86ae-e4d5f7fd86b9" ulx="37" uly="922" lrx="461" lry="961" /><zone xml:id="m-6f68c1be-ec27-4b06-a3aa-5685561bb37f" ulx="37" uly="947" lrx="463" lry="986" /><zone xml:id="m-09eac13c-4d5c-49c7-83db-e40b012ecb59" ulx="473" uly="947" lrx="900" lry="980" /><zone xml:id="m-47326f7b-c118-4c15-845f-dfbd1748e858" ulx="37" uly="976" lrx="464" lry="1013" /><zone xml:id="m-9f309c29-1e9c-4497-ac73-3c3bc79480ed" ulx="474" uly="978" lrx="898" lry="1011" /><zone xml:id="m-996e0d6f-d80a-4add-8b87-8c252b12d829" ulx="37" uly="1000" lrx="462" lry="1043" /><zone xml:id="m-72b5cecc-6311-4df2-83ae-21ad4ce3b13f" ulx="61" uly="1036" lrx="899" lry="1075" /><zone xml:id="m-d1bf8c1e-101c-426f-b53a-8038820fe1f2" ulx="37" uly="1065" lrx="306" lry="1097" /><zone xml:id="m-3134bbe9-ec9d-4329-b9b7-29eda9cca7af" ulx="251" uly="1150" lrx="560" lry="1193" /><zone xml:id="m-682791a1-38f3-49ec-b5a1-277ba3e8c462" ulx="42" uly="1153" lrx="72" lry="1196" /><zone xml:id="m-5d4dcbfd-6338-43c3-ad36-92d0f3ff5164" ulx="803" uly="1156" lrx="900" lry="1195" /><zone xml:id="m-3bef6cc0-0e5e-4f41-8ea8-4c9d2757234f" ulx="60" uly="1211" lrx="679" lry="1247" /><zone xml:id="m-bf27a1ee-2b97-4dd0-ac2f-4c51b7ee9104" ulx="410" uly="1248" lrx="519" lry="1285" /><zone xml:id="m-e9d60ec1-8c4a-4345-94f3-802b59426631" ulx="49" uly="1284" lrx="897" lry="1326" /><zone xml:id="m-45879bb6-705e-4200-b0c7-28429fea2299" ulx="34" uly="1313" lrx="812" lry="1348" /><zone xml:id="m-8f3949ed-653c-445c-8e69-d2f1814151cf" ulx="33" uly="1345" lrx="462" lry="1377" /><zone xml:id="m-e50c2699-21bd-4152-a1c7-dc9592054915" ulx="183" uly="1424" lrx="636" lry="1470" /><zone xml:id="m-27d91f59-1a00-4a10-aba2-0eb7a58176a4" ulx="35" uly="1431" lrx="80" lry="1471" /><zone xml:id="m-05f55386-dca3-4633-a640-6743ec60a3cd" ulx="800" uly="1433" lrx="899" lry="1476" /><zone xml:id="m-01ef8145-3004-4d11-8220-2ba4a5c04d99" ulx="58" uly="1473" lrx="895" lry="1516" /><zone xml:id="m-79f85711-ec72-4a9a-a84b-e66198e29535" ulx="33" uly="1510" lrx="282" lry="1549" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-05413daa-334d-495d-b664-9e44b24871f2" n="1577" facs="#m-1d54f02c-7c07-4caf-ada3-8dfaa1becc8e" /><div xml:id="m-36f511b0-aad1-4f01-8974-73db0e294521">
            <lg xml:id="m-5c432e42-502a-4b28-af9e-5dc5821f48eb">
              <l xml:id="m-12bcea45-3d5a-4966-9ffb-4b87a53a328a" facs="#m-5725ba23-28fd-4fb9-9ffa-72e7411ae393" label="ambiguous">February 6. 7. 8.</l><l xml:id="m-05fd73f3-c3e4-4cc8-bdcd-3d542e46a8bd" facs="#m-fec80aee-b93e-4b9e-97f1-334064a5ba78" label="ambiguous">1373</l><l xml:id="m-6b6a6aec-6799-46ff-9cb4-408ae8f7a7da" facs="#m-dcb38ed1-1cf0-40c3-a94c-6a461a8bb9da" label="text-like">S. Titus, Bishop and Confessor.</l><l xml:id="m-4bc99358-718f-4fcc-8143-4308d9b95368" facs="#m-07d20610-630f-4532-a223-51cd27495931" label="ambiguous">6.</l><l xml:id="m-39dc098e-2733-4657-a96f-19da55f05c9d" facs="#m-cdbe6cbb-2237-42f5-ad0d-0a35c3340215" label="lyrics-like">Douóle.</l><l xml:id="m-2bccc648-b6c7-43e9-8771-7ef463e5224b" facs="#m-e0bc7864-84d1-44f0-9427-9eda09d4f304" label="lyrics-like">Mass. Státuit. from the Common of a Confessor Bishop, p. 1182 except</l><l xml:id="m-ef2c988b-f9b3-4877-a1f8-00cf69f4b59a" facs="#m-5808870b-9956-4d08-a912-57a2d1b94bbe" label="text-like">the foltowing:</l><l xml:id="m-84e95f38-7358-4851-8141-f423e6e699ee" facs="#m-3dc3ab92-0133-4c9d-8ba2-5ee90f58d09e" label="ambiguous">Collect.</l><l xml:id="m-f2e348db-3d6b-4fe8-a943-da268dd496aa" facs="#m-2c6a057f-7ab5-4f3a-87ae-21eebab2fb75" label="lyrics-like">Eus, qui beátum Titum Confes- de; ut juste et pie vivéntes in hoc</l><l xml:id="m-be7e97fe-9a01-4f8a-9011-cd058bacdcc9" facs="#m-c34ba917-9455-45c6-96a9-bdec437d45b3" label="lyrics-like">U sórem tuum atque Pontificem saéculo, ad caeléstem pátriam</l><l xml:id="m-6245d85e-8e76-4f08-accf-6dd726700f40" facs="#m-fee0a7cc-39fa-4079-afcc-55e835712c5f" label="lyrics-like">apostólicis virtútibus decorásti: tl pervenire mereámur. Per Dóminum</l><l xml:id="m-e93a849e-3fa6-4637-a9b1-716d63c4b0ba" facs="#m-290aba33-e092-4fec-bfd1-ee33d32d6bbd" label="lyrics-like">ejus méritis et intercessióne concé-l nostrum.</l><l xml:id="m-fcfb814f-06e5-4cfb-ae05-19aab5021aba" facs="#m-d5ad65f9-bd76-482f-ba31-70f12ffb4f50" label="text-like">Commemoration of St. Dorothy, Virgin and Martyr.</l><l xml:id="m-353934bf-06a3-41a4-b7e3-4c6a1994db76" facs="#m-ede95599-1eeb-4f64-ac88-a0201b449a0c" label="ambiguous">Collect.</l><l xml:id="m-6b28c19e-36f7-4518-b75f-0a69115e0290" facs="#m-cd6e2f0f-45ab-417d-9fd1-d6f03abba11a" label="lyrics-like">(Ndulgéntiam nobis, quaésumus l grata semper éxstitit et mérito ca¬</l><l xml:id="m-a1697c1b-da97-45bc-a0d9-6d51f47b3402" facs="#m-984c452a-2114-464a-8278-b50738afaf36" label="lyrics-like">L Dómine, beata Doróthea Virgo stitátis, et tuae professióne virtótis.</l><l xml:id="m-e9633ffa-3000-41ed-9932-c9c17d0e89f8" facs="#m-88570726-1367-4319-a7fb-d257d98dbba4" label="lyrics-like">et Martyr implóret: * quae tibi! Per Dóminum.</l><l xml:id="m-d61252f4-9565-447b-b0db-cdaa5e016d30" facs="#m-be3687b7-1790-478c-b312-d554a4f47f14" label="ambiguous">† Sequentia sancti Evangelii secundum Lucam. Luc. 1o.</l><l xml:id="m-62cae9ef-36e9-4d1a-892e-117e52c5ba98" facs="#m-a10da243-bfdf-400b-92b9-e4e4b9f136d0" label="lyrics-like">N illo témpore: Designávit Dó¬ mum dícite: Pax huic dómui : et si</l><l xml:id="m-ec8c2321-ba34-4beb-b5a5-a6d021451a58" facs="#m-db275645-79ee-4fa6-a053-244eccac0ebe" label="ambiguous">L minus et alios septuaginta duos;</l><l xml:id="m-19ef3de7-7827-4079-bcb4-69b4b60bb1e7" facs="#m-f0978420-5d05-487d-8d25-c72e64c233ad" label="lyrics-like">ibi fúerit filius pacis, requiéscet su¬</l><l xml:id="m-99f9c02a-4518-4c9d-920a-52cf442f1295" facs="#m-f8ea8d44-e951-4498-b532-c99f5140561f" label="lyrics-like">et misit illos binos ante fáciem</l><l xml:id="m-86fa1d2c-33d9-4804-9f06-bc3615bc054a" facs="#m-9c92dbb6-3cee-40e4-a039-a26d92dec68e" label="ambiguous">per illum pax vestra: sin autem,</l><l xml:id="m-150e5527-67c1-4ee8-8d3a-bca87295b8f5" facs="#m-b32b72fa-1f30-4615-963a-675beed262d9" label="lyrics-like">suam in omnem civitátem et locum,</l><l xml:id="m-037618af-010d-4606-a2b4-230e01d7fbc6" facs="#m-01251bf2-ebfa-4218-b074-c02967cebe2f" label="lyrics-like">ad vos revertétur. In eádem autem</l><l xml:id="m-e1eaa926-aab2-445e-9229-f5dded69420b" facs="#m-53a273fb-e4b5-482f-8694-def46236cf3d" label="lyrics-like">domo manéte, edéntes et bibéntes</l><l xml:id="m-fb984698-74d5-4012-844a-51b90451d26e" facs="#m-d6975386-ef59-465f-88ff-75c9937b4e1f" label="lyrics-like">quo erat ipse ventúrus. Et dicébat</l><l xml:id="m-76ba5eb4-b869-4f73-b9f6-af8ec1a8d3b4" facs="#m-56611d72-fcfb-427d-b269-87f754d3d713" label="ambiguous">quae apud illos sunt: dignus est</l><l xml:id="m-f6f8f184-02ef-4401-9faf-c0edd9973e8b" facs="#m-7bba9041-7b6a-4e89-9437-338d258f6f59" label="lyrics-like">illis : Messis quidem multa, operá¬</l><l xml:id="m-6ff9dd6d-82c9-4d5b-8479-a65c862d2f5c" facs="#m-cc30decf-38ee-45f9-9bce-f3e902cc8547" label="lyrics-like">enim operárius mercéde suã. Nolste</l><l xml:id="m-bb17baee-11af-4dac-a146-d4090258ab42" facs="#m-5ecb8360-0411-4f98-8edc-1ecface1b578" label="lyrics-like">ri autem pauci. Rogáte ergo dómi¬</l><l xml:id="m-05c793d6-7fdf-4c81-86f6-f543003afa09" facs="#m-eace615c-ffad-4459-98d2-54547ab89e30" label="ambiguous">transire de domo in domum. Et in</l><l xml:id="m-3d70801e-8940-4be2-a179-ce905f569ff3" facs="#m-12f8e263-59d0-4ebb-86e7-700dab084a50" label="lyrics-like">num messis, ut mittat operários in</l><l xml:id="m-75509883-9701-4dcd-89ea-303f55529947" facs="#m-bb79a563-1329-4fee-9e12-98a2c3062655" label="lyrics-like">quamcúmque civitátem intravéritis,</l><l xml:id="m-4034a4c7-c39b-49cc-bdd9-63c6456e2600" facs="#m-411812b5-6bde-4722-8d27-b6bde5631392" label="ambiguous">messem suam. Ite : ecce ego mitto</l><l xml:id="m-a92754ad-1f93-4d8e-9991-99cf57280aaf" facs="#m-44652bad-b200-4296-a458-47eb54303cc8" label="ambiguous">vos sicut agnos inter lupos. Nolite</l><l xml:id="m-87d7d6b6-c662-4e55-86ff-f0f49aeca399" facs="#m-352d9afd-d792-413b-bb7e-fa95ee166822" label="lyrics-like">et suscéperint vos, manducáte quae</l><l xml:id="m-861bda1f-2d3a-477c-83b6-45759d7d488d" facs="#m-026d6eab-daeb-40ae-8d39-d9f49b48ae34" label="lyrics-like">apponúntur vobis: et curáte infir¬</l><l xml:id="m-2ca8feaa-6eb1-4848-baf7-9d0e1a2dc13a" facs="#m-b7383d4f-ba11-4c52-86ae-e4d5f7fd86b9" label="lyrics-like">portáre sácculum, neque peram,</l><l xml:id="m-1db7b422-cd91-4964-9d09-7852ba32ff61" facs="#m-6f68c1be-ec27-4b06-a3aa-5685561bb37f" label="lyrics-like">neque calceaménta: et néminem</l><l xml:id="m-f3e40851-626b-43eb-a687-e15fc4cc696e" facs="#m-09eac13c-4d5c-49c7-83db-e40b012ecb59" label="lyrics-like">mos qui in illa sunt, et dícite illis:</l><l xml:id="m-c5a61823-7b9c-4acc-a2b9-83e380a83619" facs="#m-47326f7b-c118-4c15-845f-dfbd1748e858" label="lyrics-like">per viam salutavéritis. In quam¬</l><l xml:id="m-8ac6f734-2067-4618-ba3b-2e6cb6d7aa28" facs="#m-9f309c29-1e9c-4497-ac73-3c3bc79480ed" label="lyrics-like">Appropinquávit in vos regnum Dei.</l><l xml:id="m-909b2f27-ae0b-4277-8516-5a8ab87cb7c6" facs="#m-996e0d6f-d80a-4add-8b87-8c252b12d829" label="lyrics-like">cúmque domum intravéritis, pri¬</l><l xml:id="m-0a306c64-8952-488c-a90b-24f0b1f56127" facs="#m-72b5cecc-6311-4df2-83ae-21ad4ce3b13f" label="lyrics-like">Commemoration of St. Dorothy. Secret. Hóstias tibi. and Postcommunion.</l><l xml:id="m-68962ce9-2392-4955-b9eb-ff89f2709b73" facs="#m-d1bf8c1e-101c-426f-b53a-8038820fe1f2" label="lyrics-like">Divíni múneris. p. 1224.</l><l xml:id="m-80ef4339-ed68-4f12-af18-4c9f28e25213" facs="#m-3134bbe9-ec9d-4329-b9b7-29eda9cca7af" label="ambiguous">S. Romuald, Abbot.</l><l xml:id="m-bc0e37cb-8e50-489d-8a4b-cff9556f6ab8" facs="#m-682791a1-38f3-49ec-b5a1-277ba3e8c462" label="ambiguous">7.</l><l xml:id="m-d4b3be3c-115f-486e-af2b-b472f55902b9" facs="#m-5d4dcbfd-6338-43c3-ad36-92d0f3ff5164" label="ambiguous">Double.</l><l xml:id="m-1879fe40-6ab5-443d-8a0f-08febb60e0b8" facs="#m-3bef6cc0-0e5e-4f41-8ea8-4c9d2757234f" label="lyrics-like">Mass. Os jústi. from the Common of Abbots, p. 1206.</l><l xml:id="m-c501a502-6d4a-4105-95e5-435dd9948ac3" facs="#m-bf27a1ee-2b97-4dd0-ac2f-4c51b7ee9104" label="ambiguous">Collect.</l><l xml:id="m-4e665dc6-9ef5-4f51-8451-866a61593154" facs="#m-e9d60ec1-8c4a-4345-94f3-802b59426631" label="lyrics-like">(Ntercéssio nos, quaésumus Dómi- non valémus, * ejus patrocinio</l><l xml:id="m-c82bb038-4a31-44ea-a346-e65274769baf" facs="#m-45879bb6-705e-4200-b0c7-28429fea2299" label="lyrics-like">L ne, beáti Romuáldi Abbátis com-lassequámur. Per Dóminum.</l><l xml:id="m-61273c2a-841c-4a8c-b7c7-b0bc088e3a68" facs="#m-8f3949ed-653c-445c-8e69-d2f1814151cf" label="lyrics-like">méndet:t ut quod nostris méritis</l><l xml:id="m-a6fb9824-1ee2-4483-bfca-09ff992c48da" facs="#m-e50c2699-21bd-4152-a1c7-dc9592054915" label="text-like">St. John of Matha, Confessor.</l><l xml:id="m-671aa74a-f55d-4b69-b4d9-65557f48790b" facs="#m-27d91f59-1a00-4a10-aba2-0eb7a58176a4" label="ambiguous">8.</l><l xml:id="m-72f259f8-c9c6-417c-abc7-3069fd1e058f" facs="#m-05f55386-dca3-4633-a640-6743ec60a3cd" label="lyrics-like">Douöle.</l><l xml:id="m-ebedd1ae-adf6-4e33-82b3-64c4041f591e" facs="#m-01ef8145-3004-4d11-8220-2ba4a5c04d99" label="lyrics-like">Mass. Os jústi. from the Common of a Confessor not a Bishop, p. 1200,</l><l xml:id="m-66ea3028-d979-4c3e-b088-9e79ee9c158a" facs="#m-79f85711-ec72-4a9a-a84b-e66198e29535" label="text-like">excent the follouing:</l></lg></div></section></score></mdiv></body></music>
</mei>