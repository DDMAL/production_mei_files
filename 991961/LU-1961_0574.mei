                <syllable xml:id="m-4c02ca53-9de8-4c61-9f3d-f4371965ec48">
                  <syl /><neume facs="#m-5e47308d-aeb9-47e7-9588-bc61355d04e1" type="clivis" xml:id="m-791c372c-d8b8-4d36-9a0a-a45d04d77f4a">
                    <nc xml:id="m-32c988c1-77df-4bea-98e4-803a1c837b9d" pname="g" oct="3" />
