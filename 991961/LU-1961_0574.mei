                    <nc xml:id="m-0cabb8c7-bdf8-41d5-805b-8a536d70c926" pname="f" oct="3" tilt="se" />
                  </neume>
                </syllable>
                <syllable xml:id="m-23f114eb-72f7-4e8f-85f7-37a2bbd44cfc">
                  <syl /><neume facs="#m-87a27ed4-773c-40a0-89e1-ab4181cfc7bb" type="clivis" xml:id="m-3a33efaa-fb55-4eae-b70c-83103d206b05">
                    <nc xml:id="m-527f2b56-1f47-4108-a87f-06fee5a58abc" pname="a" oct="3" />
                    <nc xml:id="m-e52fb660-463d-46a5-8909-9b5e6c513365" pname="g" oct="3" />
                  </neume>
