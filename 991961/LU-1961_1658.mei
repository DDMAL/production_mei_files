                  <nc xml:id="m-867194b5-775c-43b3-9b58-7fc98274fa82" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-a2956ab6-db2a-4fa2-9aed-70cb0338a9b4">
                <syl /><neume facs="#m-1017dbce-4412-48da-9e74-d87b871f8572" type="clivis" xml:id="m-b1bc0529-aec3-490b-a0da-a8d177895f70">
                  <nc xml:id="m-a1386a38-4fbc-4f51-a78e-0ad7cf1c89a3" pname="a" oct="3" /><nc xml:id="m-7e83445b-eb73-4899-af92-a26cd1d42746" pname="g" oct="3" /></neume></syllable><syllable xml:id="m-da62b2a0-0336-4b95-a233-1193657b5004">
                <syl /><neume facs="#m-39936a20-f36d-4985-ab66-e2d187fd5007" type="torculus" xml:id="m-0a868a5f-e691-4847-ab5b-8ffffbd526a3">
                  <nc xml:id="m-aa7b8329-75d5-48b9-9998-7768365a1ff9" pname="a" oct="3"><episema xml:id="m-5d011d65-c1ba-4298-b95b-493723efc004" form="h" /></nc><nc xml:id="m-50335b4f-5c82-4b53-bc4d-7f4e1ba9d046" pname="b" oct="3" /><nc xml:id="m-a166529e-14d5-4d65-b374-9a27164e1702" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-7744310b-2883-493f-ae72-b3f7ef182425">
                <syl /><neume facs="#m-0b1249a5-c853-4b56-a11f-9f85dafbabb7" type="clivis" xml:id="m-03ae095a-3054-4156-8e21-839c9a74a2dc">
                  <nc xml:id="m-45525e77-1a6e-417e-9f80-e5b4e5a64c04" pname="a" oct="3" /><nc xml:id="m-5b54e149-cd6d-4242-9b5f-677ca4e4f4e7" pname="g" oct="3">
                    <signifLet xml:id="m-b08636ec-5ddf-4247-8d64-493dac2b8054" /></nc></neume></syllable><divLine xml:id="m-ac79d030-3ad8-4a82-9381-fb6f00178705" facs="#m-f8b80b5b-c540-44d5-bb0f-bd5fd1c1751b" form="finalis" /></layer></staff><div xml:id="m-f4ce9347-ac14-43c1-a00a-4ecea445c706"><lg xml:id="m-f39241d4-8b15-4ab0-8106-b04af174206f"><l xml:id="m-678ec7ae-a30d-4971-9157-8371b9801f26" facs="#m-0f577fef-4e5a-4d56-ba3e-6fbef7a9f771" label="ambiguous">1456</l><l xml:id="m-b2cc1fae-2623-45c8-a990-79c96d4e19fd" facs="#m-4aecced2-719a-444a-8d3c-65edf27c4fd6" label="ambiguous">May 3.</l><l xml:id="m-145a70b9-cbf7-4ad2-9d18-320656b20d37" facs="#m-f759491b-a869-4ee7-9a00-e8eca63618ee" label="ambiguous">8.</l><l xml:id="m-55f84aa7-2ec1-42ab-85c1-be0ea48be107" facs="#m-671651ec-a71c-45fe-a63e-9b857bea71d1" label="ambiguous">H</l><l xml:id="m-a2568070-81c9-4fae-8eae-740b554862dd" facs="#m-da3de689-1eae-4627-9a8f-ce16bed14a6a" label="lyrics-like">Lle-lú¬</l><l xml:id="m-7cfa3c9b-55fb-4b1c-9e4b-68ed25102e82" facs="#m-c0e1645f-7fbc-47cf-8cf6-93bb2cc302b7" label="ambiguous">ia.</l><l xml:id="m-de0fdf33-3cee-469c-aa08-790779e135ab" facs="#m-64855141-ba93-4c0d-8feb-249cf48b592f" label="lyrics-like">V. Dúlce li¬</l><l xml:id="m-db655619-3f12-494f-a48e-abb3e57df19c" facs="#m-126305d0-1457-414f-9864-9046cc9e219d" label="lyrics-like">gnum, dúlces clávos,</l><l xml:id="m-f9aee1a8-e0b4-4a30-8387-ba8f754a36e1" facs="#m-735976b9-cb4e-48be-ad53-b7a4f92ac127" label="lyrics-like">dúlci-a</l><l xml:id="m-e15d14ba-714f-4a10-aff0-d3be119a68c0" facs="#m-e07317c1-bfcb-4c76-9c1f-915be9eaf9bf" label="lyrics-like">fé¬</l><l xml:id="m-27707c9a-890e-487b-9b10-2fc6ddeb7332" facs="#m-f757e5db-c07d-41c2-b44c-f0a70d8c8b9a" label="lyrics-like">dera: quae sóla fu-ísti dí¬</l><l xml:id="m-68177316-f9ce-41cb-b552-3c5959777753" facs="#m-702de329-570a-4b81-9f22-f71fc25d3407" label="lyrics-like">rens pón¬</l><l xml:id="m-80ffb91d-16e7-4cd3-aa9c-8acefed825c2" facs="#m-ffb57458-7987-4106-ad3d-458d8ff94626" label="lyrics-like">gna susti-né¬</l><l xml:id="m-e0e5fd06-94a5-40fe-8975-807cba983d04" facs="#m-84497330-8e46-40c1-8c23-4f7409674af4" label="ambiguous">rum“ et</l><l xml:id="m-b4ce2eb6-7362-47dc-98ef-7353f4b0e896" facs="#m-db8c2394-cb9b-4774-b605-39dbed74656c" label="lyrics-like">re régem caeló¬</l><l xml:id="m-d62380e6-be64-4d0e-83bb-adbdb20199c6" facs="#m-0b3ebf1b-cd26-45e2-81d2-e710abea26cb" label="lyrics-like">Dó-mi- num.</l><l xml:id="m-bd3199e8-7755-469e-8c61-9743db07c8ce" facs="#m-4d9d89e7-e82d-4778-8753-b4237c49324a" label="ambiguous">FSequentia sancti Evangelii secundum Joannem. Joann. 3.</l><l xml:id="m-93c1d252-62a4-48a3-a275-11dca7335fa2" facs="#m-95ee7700-9d2d-41bd-9ad6-812edf4dfb2a" label="lyrics-like">TN illo témpore: Erat bomo ex dénuo. Spiritus ubi vult spirat, et</l><l xml:id="m-df85523e-b368-4b3d-ab5a-d20012f37e35" facs="#m-6c218802-c189-49d0-857c-e413751b1bc1" label="lyrics-like">1 Pharisaéis, Nicodémus nómine,</l><l xml:id="m-2c253dd1-267a-4f99-b6dc-83c8740a1bde" facs="#m-49a85918-e158-4e5b-be0c-05de66d8b11f" label="ambiguous">vocem ejus audis, sed nescis, unde</l><l xml:id="m-1d980e85-1b0c-4285-8cb0-676a5857431a" facs="#m-8cd88ba6-dae5-45ce-a2a4-650881493a6f" label="lyrics-like">princeps Judaeórum. Hic venit ad</l><l xml:id="m-e7f4c4c1-1c8b-4a5a-8ef9-ff25e4f6a99b" facs="#m-e420118e-a821-4b66-8320-38af4fc487e8" label="lyrics-like">véniat aut quo vadat: sic est omnis</l><l xml:id="m-8345862a-5fd7-4f70-a774-9cd2a07e22b4" facs="#m-fdfc21bf-d2a9-459a-93ea-2474858ded61" label="ambiguous">Jesum nocte, et dixit ei: Rabbi,</l><l xml:id="m-f48958ca-5550-45b0-bc16-7fd6a023357b" facs="#m-458effb2-0fd4-4b64-98d6-511fcd257604" label="lyrics-like">qui natus est ex spíritu. Respóndit</l><l xml:id="m-0fd83506-cee9-4f03-b49c-a53c6f94cf7a" facs="#m-06cca5ff-9c35-4352-a5a7-4520ccf7ba08" label="lyrics-like">Nicodémus et dixit ei uomodo</l><l xml:id="m-e2a7ccc9-3e45-4bcd-b454-7603a41c61d6" facs="#m-a38607cb-132b-4246-a5ee-6bcd75273cc3" label="lyrics-like">scimus quia a Deo venísti magíster:</l><l xml:id="m-91c86ac3-d5e9-413e-9967-13688f752a85" facs="#m-01d75e1f-7a0d-4a09-bd10-78545e7bf9bc" label="lyrics-like">nemo enim potest haec signa fá¬</l><l xml:id="m-52eeaee9-cb23-4c57-8641-3a0e4031ff1a" facs="#m-93a3ceb4-3432-4e71-8413-6adb7ebf8569" label="lyrics-like">possunt haec fieri? Respóndit Jesus</l><l xml:id="m-34ebfa42-bc8f-4f58-aa5a-582adffae02f" facs="#m-fd17e07a-9f55-4e5a-8c63-ea32306e1d01" label="lyrics-like">cere quae tu facis, nisi fúerit Deus</l><l xml:id="m-05044f78-9147-4a62-ad59-ccacaabf466f" facs="#m-e7abfcdb-43b1-4d95-9d3b-cdc0b1567cc4" label="ambiguous">et dixit ei: Tu es magister in Israel,</l><l xml:id="m-3050ce61-a976-44bc-8b41-90db88db4ac8" facs="#m-76c8ef6a-06c8-4d56-99ab-d7e23a7d5fe8" label="lyrics-like">cum eo. Respóndit Jesus, et dixit</l><l xml:id="m-33149ce4-9dd3-4688-b7ce-04b10524d2ca" facs="#m-1ab0e0fb-3eb9-4a78-9a68-ddb86d0494d4" label="lyrics-like">et haec ignóras? Amen, amen, dico</l><l xml:id="m-9fffce8a-1a4c-45df-affc-9a46d1bdc22e" facs="#m-4bf2f255-6e95-4484-8d85-b6e2a279a5fc" label="ambiguous">ei: Amen, amen, dico tibi, nisi quis</l><l xml:id="m-aa33425c-9972-4ab7-888d-2d02c341da61" facs="#m-e54d4edf-9854-4f36-9dc5-6d0be5b62be9" label="lyrics-like">tibi, quia, quod scimus, lóquimur, et</l><l xml:id="m-7b99e084-9740-4600-8cce-400ce3e58d75" facs="#m-cd9f2897-3716-44cb-86e0-95be494367e7" label="lyrics-like">renátus fúerit dénuo, non potest</l><l xml:id="m-6ee80aed-d9e6-429e-b966-3d36720dc972" facs="#m-a91f9222-45e9-46b8-a6c2-ca6e8e9831e2" label="lyrics-like">quod vídimus, testámur, et testimó¬</l><l xml:id="m-1d499fae-40ed-41bb-b2e6-e5f14e17cb38" facs="#m-6f6ffb08-d00c-4088-ac40-5f5d4f4d877a" label="lyrics-like">nium nostrum non accípitis. Si ter¬</l><l xml:id="m-beebd29c-617e-402e-a40e-43dc1ee33ead" facs="#m-b58c5bdb-7670-46a5-bcf4-b69c857b56dc" label="lyrics-like">vidére regnum Dei. Dicit ad eum</l><l xml:id="m-0173aa66-8228-4f82-a8da-567b83062f2d" facs="#m-0f2cebc7-d563-4675-bc90-a44bd38300e5" label="lyrics-like">Nicodémus : Quómodo potest homo</l><l xml:id="m-1ee86092-c267-4e4a-9d00-49080fb80b35" facs="#m-0506ab9e-a3d1-43ff-8e1c-4d2f72dd6a47" label="lyrics-like">réna dixi vobis, et non créditis:</l><l xml:id="m-d755836e-5379-4c75-8af7-682ae6e31b6a" facs="#m-4c0b8362-7822-4d51-afdb-a1eae42edcb9" label="ambiguous">nasci, cum sit senex? Numquid po¬</l><l xml:id="m-23ef4bf1-4892-4eb9-a614-71134807e898" facs="#m-b7e77047-dbf7-4777-aca2-9113b1791342" label="lyrics-like">quómodo, si dixero vobis caeléstia,</l><l xml:id="m-f13e2e7c-66a7-47c1-a0fc-8d7c11a561d3" facs="#m-0ce5a0b6-f2fc-4267-b2d6-903924a15820" label="lyrics-like">credétis? Et nemo ascéndit in cae¬</l><l xml:id="m-0c1ed47e-0a25-4c0f-8852-26c5fcfb5c48" facs="#m-36b2056c-9b34-4117-9b1d-8fa1b73fd6e7" label="lyrics-like">test in ventrem matris suae iteráto</l><l xml:id="m-c7f70d63-94ec-4b7f-b650-8ecd7ad5106a" facs="#m-a4bad461-1e9c-4706-a5f5-4513fbeefcc1" label="lyrics-like">introire et renásci? Respóndit Je¬</l><l xml:id="m-5d2093ef-bfb6-4646-a76f-a3da9a9915c3" facs="#m-6ee375c3-4056-4e94-9bed-31d31e4d0269" label="lyrics-like">lum, nisi qui descéndit de caelo.</l><l xml:id="m-dbf3d0f0-f5f4-4911-9042-a117d5b9f1d6" facs="#m-d70def6d-6746-4d60-8917-4cd07723195b" label="ambiguous">sus: Amen, amen, dico tibi, nisi</l><l xml:id="m-62cc3a52-c37e-4810-b73a-7cdff2717927" facs="#m-f37ea42a-f6f8-45fb-bf18-f9cd40b52b6d" label="lyrics-like">Filius hóminis, qui est in caelo. Et</l><l xml:id="m-d8234d08-02af-4644-a3ec-5d96a5b796b8" facs="#m-33e63084-de4e-4526-9f1a-ae31c470c4c8" label="lyrics-like">quis renátus fúerit ex aqua et Spi¬</l><l xml:id="m-69b921f5-5540-43a2-9ae9-9a0ac611c8a2" facs="#m-5af4fd3d-7b1e-4693-a448-4305f2eeaa8a" label="lyrics-like">sicut Móyses exaltávit serpéntem</l><l xml:id="m-c5539b57-06e4-4fc0-8fde-96a508e5e059" facs="#m-0e1d9b84-c23b-499f-ae4b-9775bef37233" label="ambiguous">ritu Sancto, non potest introire in</l><l xml:id="m-1ba512ae-bb86-429f-84aa-10c8f44f0bea" facs="#m-aae12aea-be05-419b-a4b9-0aa67ae6b163" label="lyrics-like">in desértó; ita exaltári opórtet Fi¬</l><l xml:id="m-43a8e263-1fc5-4a5a-a9bf-f83b6f958a5b" facs="#m-885f7369-1392-49f5-9687-1e08c8e40bcb" label="ambiguous">regnum Dei. Quod natum est ex</l><l xml:id="m-6c8fe764-d274-4bfa-bb27-598a471c19a0" facs="#m-bd78efc8-8f95-4516-9c99-1e94b1cbaebd" label="lyrics-like">lium hóminis, ut omnis qui credit</l><l xml:id="m-cb95e5ed-d2e5-40cc-828e-1b0c703f3122" facs="#m-78151ab1-b893-4e0b-be6e-7de701a4fd07" label="lyrics-like">in ipsum, non péreat, sed hábeat</l><l xml:id="m-888ad95f-fbc3-45f1-b083-88c068d7ff5e" facs="#m-324706b7-63a4-4cfa-8097-4dcbf2aa0399" label="ambiguous">carne, caro est : et quod natum est</l><l xml:id="m-209f95f8-a92d-4c99-8e6b-649f9c150f80" facs="#m-23fc5207-6898-48d9-a599-0192daab7315" label="lyrics-like">ex spíritu, spiritus est. Non miréris</l><l xml:id="m-83d4a2a7-31db-46fa-8016-e486eef0b670" facs="#m-91e68cde-30e7-494d-bf10-3a495bc34822" label="lyrics-like">vitam aetérnam.</l><l xml:id="m-68c85e9c-6b43-4b6e-8967-e7cbdbd4411f" facs="#m-42a6edd5-8268-4a3e-9758-27a297452a31" label="ambiguous">Credo.</l><l xml:id="m-815f6df0-15ea-46f5-a194-aa1861dee6d5" facs="#m-31910822-973c-4db0-847d-2401a2be9639" label="lyrics-like">quia dixi tibi: Opórtet vos nasci</l></lg></div></section></score></mdiv></body></music>
</mei>