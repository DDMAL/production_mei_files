                  <nc xml:id="m-c74326a8-791a-4aec-b3e8-31223126776b" pname="b" oct="3" /><nc xml:id="m-42eaa089-6fb2-48a0-afe0-239c5e060ca9" pname="c" oct="4" /><nc xml:id="m-769378b4-efbd-4692-9c8e-82d285bfb8b0" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-79c2ad57-33fc-4153-8baa-62141db7a8df">
