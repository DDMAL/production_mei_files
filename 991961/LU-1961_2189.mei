                  <nc xml:id="m-12443241-fa9c-4dbf-adc4-c2cf2b8e0328" pname="c" oct="4"><episema xml:id="m-b10d01f6-f723-44b7-bad1-a95c86c73f69" form="h" /></nc></neume></syllable><sb xml:id="m-91041cd6-d3d9-4d1f-9628-142bb9933969" n="5" facs="#m-a755a296-f455-4744-9b6b-d5706f99f4b3" /><clef xml:id="m-80d9aa65-136b-4127-97ab-3ba1eead3945" facs="#m-a140ceab-9547-4030-b4ef-51ec85fdb6f9" shape="C" line="4" /><syllable xml:id="m-e2394a6a-4dc5-4031-a9ac-e6b45d3165c0">
