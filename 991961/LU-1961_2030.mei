            <layer xml:id="m-1684d570-c59e-4ee7-b660-f79244418419" n="1">
              <sb xml:id="m-2f4a2825-b503-44b7-aea2-37eeb2eea0c0" n="5" facs="#m-f78103f2-d62a-4199-b37c-2fa7b8d827c3" /><clef xml:id="m-704f1b06-a866-48ab-80cb-c24b01cbcd53" facs="#m-4215d5fa-c33f-461d-8cd5-a24aa345e17b" line="4" shape="C" /><syllable xml:id="m-f70a8453-0130-4e10-b5a3-446c10ef3fba">
                <syl /><neume facs="#m-f1140dc6-2098-42f4-b94c-9a094922e15b" type="punctum" xml:id="m-920cb59c-8af6-411e-bcf3-8517ed15fd50">
