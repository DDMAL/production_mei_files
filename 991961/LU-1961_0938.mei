1268" /><zone xml:id="m-c7130e60-1803-43a6-9197-bb8f63e2e847" ulx="526" uly="1234" lrx="924" lry="1268" /><zone xml:id="m-e7a1c1cd-56de-4eed-8ba4-2c7f33d37382" ulx="523" uly="1261" lrx="923" lry="1292" /><zone xml:id="m-5e767656-5947-4cff-b649-dc4f5da455ce" ulx="114" uly="1266" lrx="511" lry="1292" /><zone xml:id="m-f0c0261d-9e20-481f-87c4-3c5d3424b2b2" ulx="114" uly="1286" lrx="513" lry="1322" /><zone xml:id="m-d89c4b64-c956-4873-99be-bd434cb568a2" ulx="525" uly="1290" lrx="922" lry="1320" /><zone xml:id="m-2186a082-0430-4eaa-8336-05b638a443ce" ulx="524" uly="1313" lrx="924" lry="1348" /><zone xml:id="m-4831014e-a4d2-432c-a09d-5435151c043b" ulx="115" uly="1314" lrx="512" lry="1346" /><zone xml:id="m-8c98bb49-c3c6-46e9-92c8-355b8d4d879e" ulx="527" uly="1337" lrx="924" lry="1371" /><zone xml:id="m-93f6ed41-62bb-4595-b4dd-509c57c41f09" ulx="114" uly="1339" lrx="511" lry="1374" /><zone xml:id="m-ef6fdb20-26d1-407a-8ff1-161d7be482fa" ulx="528" uly="1365" lrx="924" lry="1400" /><zone xml:id="m-4f1b2101-9f56-4d4d-a98b-bf28ff2ed429" ulx="114" uly="1366" lrx="377" lry="1399" /><zone xml:id="m-ce099fb0-df15-4fbc-a1d2-017e7b863789" ulx="140" uly="1390" lrx="515" lry="1427" /><zone xml:id="m-14734dbb-e9fa-4e5d-a401-215e06d4370f" ulx="526" uly="1390" lrx="921" lry="1428" /><zone xml:id="m-74f1e834-53d9-496f-9f9f-9015607a32ad" ulx="114" uly="1417" lrx="516" lry="1453" /><zone xml:id="m-ed731175-8c3d-4866-8563-0ae38c5d88f8" ulx="524" uly="1417" lrx="923" lry="1454" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-b74ed7e6-015d-4462-bcf1-c18db1aa5d8e" n="0938" facs="#m-1fbc6fee-468b-430c-a408-1a5225a1fd96" /><div xml:id="m-655f4c6f-23fd-471c-aeec-490f36e19220">
            <lg xml:id="m-e9ffb574-9812-4edb-8f24-a4cd2dfa6f42">
              <l xml:id="m-1c60e89f-6a5b-4b9f-9a8a-e1dacc131b4c" facs="#m-6038f75b-0236-4aea-b375-d0b69e63571b" label="ambiguous">776r</l><l xml:id="m-75452685-0c28-4506-9447-456b83437af6" facs="#m-b8ae6f9a-5e61-4329-a3f1-0b1c8ee70020" label="text-like">The Paschal Vigi</l><l xml:id="m-ebcd52d8-b9c6-40e4-82c2-de9d4c39973b" facs="#m-399f2e67-4b98-417e-ad02-163bf130f3ac" label="ambiguous">LESSON I</l><l xml:id="m-202419f4-b920-4d28-b197-d2cd9aeb006b" facs="#m-6aaa8269-6171-43f3-8437-005586991820" label="text-like">Gen. 1, 1-31 and 2, 1-2</l><l xml:id="m-d3686b41-3d1f-4d0e-b6f8-a6a41fe4e864" facs="#m-9ac6d4a7-ee8a-4f87-a714-ee8801daa794" label="lyrics-like">N principio creávit Deus cae¬ dividant diem ac noctem, et sint</l><l xml:id="m-f7b98610-d9f1-4f35-b46c-8878c76d6c98" facs="#m-9e1667d4-a354-4e1c-9103-d939c0e7d5e1" label="ambiguous">1 lum et terram.</l><l xml:id="m-a4dd16ac-9b13-4ef9-b40b-c53219b12e0b" facs="#m-64eb3bc9-2ff7-4a6a-9584-d616503afa1a" label="lyrics-like">in signa, et témpora, et dies, et</l><l xml:id="m-e036e7fc-0d30-42a4-8788-a19a6cac3496" facs="#m-bbe9e3fb-e151-4eba-94bc-0410c661c0bd" label="lyrics-like">Terra autem erat inánis, et vá¬</l><l xml:id="m-24a963c4-3c97-46d3-af7b-1c556467126e" facs="#m-d2b8074e-7372-485e-bb98-9638c16d7825" label="lyrics-like">annos : ut lúceant in firmaménto</l><l xml:id="m-e3935111-975d-40e8-b29e-436a314314e3" facs="#m-232e6987-eab6-459e-bda1-70863f5afe8d" label="lyrics-like">cua, et ténebrae erant super fá¬</l><l xml:id="m-5c8d8699-7596-40c7-b581-7562552c5e44" facs="#m-01a767f7-1103-496d-acc7-828c29b65b81" label="lyrics-like">caeli, et illúminent terram ». Et</l><l xml:id="m-07e7d9d6-17da-4a86-ba83-4559ff22319f" facs="#m-6d0c69e0-57b9-4de0-9094-61159de31bb1" label="ambiguous">ciem abyssi: et Spiritus Dei</l><l xml:id="m-dd07a1c1-73bd-48e1-9618-bcc62fdc1d31" facs="#m-10a8bc91-8072-494b-81c7-63de2ceccd6a" label="ambiguous">factum est ita. Fecitque Deus</l><l xml:id="m-e444fd83-cbed-488e-a2bd-75696a3c65d8" facs="#m-64c699c2-dffc-4829-b992-1c0723201cd7" label="lyrics-like">ferebátur super aquas.</l><l xml:id="m-6d112199-dac3-44af-a7f2-124dd3d7927f" facs="#m-8b921ef2-225d-4f42-86b5-f7c7d4528945" label="lyrics-like">duo luminária magna: lumináre</l><l xml:id="m-84a884e3-3dc2-4b28-9168-39dbfd4e8397" facs="#m-13efea82-967a-4d99-aedf-c853ce374e2f" label="ambiguous">Dixitque Deus: « Fiat lux ».</l><l xml:id="m-6720bdf5-408b-40a1-8eab-a6f22fe9e12e" facs="#m-b14a7ba7-f773-472e-ad28-a14415b77f78" label="lyrics-like">majus, ut pracésset diéi: et</l><l xml:id="m-9de5c155-d582-48a3-bbb1-ee242a233042" facs="#m-c09a5913-3ae7-4553-b48e-dac03b3a276a" label="ambiguous">Et facta est lux. Et vidit Deus</l><l xml:id="m-052ca942-802d-4610-b454-c677301c2899" facs="#m-6d54a3aa-3a5e-4ed3-b83b-af9b1e565e1b" label="lyrics-like">lumináre minus, ut pracésset</l><l xml:id="m-b692789a-c5e9-4da2-9dd8-690e28268bff" facs="#m-ba81fddd-66f9-4bbb-bdc5-216103fa3805" label="ambiguous">lucem quod esset bona: et divi¬</l><l xml:id="m-619e0b75-8f72-4994-8101-62638335383f" facs="#m-201e9245-f6ea-40b1-9fb2-5cb89b49b278" label="lyrics-like">nocti : et stellas. Et pósuit eas</l><l xml:id="m-7ad37cac-7cdf-4be7-ad88-8657d2dd9e3f" facs="#m-763cd32f-820b-424c-8a12-c860f4582069" label="lyrics-like">sit lucem a ténebris. Appella¬</l><l xml:id="m-cbadfbe6-b2f6-4cf8-afde-0bf4fce107c5" facs="#m-b751fb62-546d-452d-a876-7e2defaa519e" label="lyrics-like">in firmaménto caeli, ut lucérent</l><l xml:id="m-65e8e5d4-9e27-4786-9541-8a0bab8a905b" facs="#m-6917a80f-45f9-4245-b59a-d1975ddbca11" label="lyrics-like">vitque lucem Diem, et ténebras</l><l xml:id="m-9103fbe1-21e4-4b43-8311-d1f5c65e6a40" facs="#m-8053b2c5-3f63-42c4-8014-558e6a08587f" label="lyrics-like">super terram, et pracéssent diéi</l><l xml:id="m-8280c1d0-3b30-4321-b746-f98e280fbfb2" facs="#m-d6d9f125-7d6a-41ab-a433-21c5a5789c37" label="lyrics-like">Noctem: factúmque est véspere,</l><l xml:id="m-70b04a7c-29fe-4314-b1b4-49a7b037a59d" facs="#m-14bade9c-f386-4c44-8697-67f5690187c5" label="ambiguous">ac nocti, et dividerent lucem</l><l xml:id="m-e22de136-e9df-4183-a5aa-53c3bdca0955" facs="#m-a9ce5794-98f2-4318-9f70-842cb31f318b" label="ambiguous">et mane, dies unus.</l><l xml:id="m-27d14eea-d534-4899-883e-478e5011938f" facs="#m-bb23fe7e-d0a1-41a5-be4f-df915447a93a" label="lyrics-like">ac ténebras. Et vidit Deus quod</l><l xml:id="m-63c62ef9-5342-4670-b34e-12293d9193f0" facs="#m-bfb110ad-97d4-4783-879f-fad2fd7aab6f" label="ambiguous">Dixit quoque Deus: Fat</l><l xml:id="m-55977da5-7aeb-4487-a605-1dd2508f2f2d" facs="#m-4a90bc27-2e1d-4015-b27e-d35d28c3100e" label="ambiguous">esset bonum. Et factum est</l><l xml:id="m-ff386478-8f99-4c30-a175-9552d032289d" facs="#m-13fc3920-2c90-46c9-b298-0f6aee38c88f" label="lyrics-like">firmaméntum in médio aquárum:</l><l xml:id="m-db33bc2f-b2e5-4cf0-a040-c46e6713d113" facs="#m-6e9efe95-6fac-43bf-b2f1-a7e4cfa1fc45" label="lyrics-like">véspere, et mane, dies quartus.</l><l xml:id="m-71d93984-6150-4137-b81f-b45cc824004a" facs="#m-4adac956-2cf9-4fb8-93b9-90a948208fe2" label="ambiguous">et dividat aquas ab aquis ». Et</l><l xml:id="m-9188b489-ec41-41ef-87d2-624633c282c6" facs="#m-d9301e8d-6edf-4350-b81e-ef3e5629dbd1" label="lyrics-like">pixit étiam Deus: « Prodúcant</l><l xml:id="m-faf185fd-77d4-4963-95db-3eac4a9c225f" facs="#m-9756c45b-4e69-4468-8677-0ada9f23f470" label="lyrics-like">aquae réptile ánimae vivéntis,</l><l xml:id="m-6b2a7dc1-c4f8-44ac-8432-69460d4f3739" facs="#m-ab5b8b43-a079-42e5-9bc0-b54d749c4b5a" label="lyrics-like">fecit Deus firmaméntum, divi¬</l><l xml:id="m-9b0bbd21-7caf-44f7-a2af-6effa436b85e" facs="#m-773cd7f5-0c25-4508-9fe0-8d311338f434" label="ambiguous">sitque aquas, quae erant sub</l><l xml:id="m-dcf123da-a44f-48fa-8e09-0fd47d2cea45" facs="#m-072419ea-723d-4166-ab9a-f719af4f622d" label="lyrics-like">et volátile super terram sub</l><l xml:id="m-73bd8b69-46c4-41e9-85d7-d1cd2dfd9e88" facs="#m-d42159b7-c167-45de-a7d4-f0da7f534af9" label="lyrics-like">firmaménto, ab his, quae erant</l><l xml:id="m-495332b8-7647-4ef6-abe4-f531fec6f72c" facs="#m-f18ca4b4-531e-4a27-9a7c-58e909038b4d" label="lyrics-like">firmaménto caeli ». Creavitque</l><l xml:id="m-c3061ab3-6dfe-4506-820f-3a36f0360885" facs="#m-98b6ac57-05c1-4b5a-805f-2594cde0957d" label="lyrics-like">super firmaméntum. Et factum</l><l xml:id="m-de3959a5-725a-49ee-9b7b-679136a58590" facs="#m-2a33abb5-0f73-4442-bbcf-5af9dce83055" label="lyrics-like">Deus cete grándia, et omnem</l><l xml:id="m-4a15a19f-d578-448f-adc2-8d10f97fd481" facs="#m-28d2c240-25c4-41b5-aa39-79b936417dc2" label="lyrics-like">ánimam vivéntem atque motá¬</l><l xml:id="m-fbd84c1f-0f57-4a41-9810-b1d8435e435c" facs="#m-fd87896f-5306-4149-9ff9-9fe04c563713" label="ambiguous">est ita. Vocavitque Deus firma¬</l><l xml:id="m-dce31119-f7f2-4cbf-8810-9885ab5c3401" facs="#m-c968a4f6-c9d5-4ce4-a645-2edb86133cbd" label="lyrics-like">méntum Caelum : et factum est</l><l xml:id="m-5276e0ee-d338-4b6e-8beb-251cd2f1f742" facs="#m-30564b20-1619-451e-87a7-f95d5a3ef698" label="lyrics-like">bilem, quam prodúxerant aquae</l><l xml:id="m-5ca7563a-9fd3-44a7-a3b7-83cadd5fe90d" facs="#m-808f58c1-8de2-48c7-b991-b816fdbf45ec" label="lyrics-like">in spécies suas, et omne volátile</l><l xml:id="m-f1719521-fad2-4d0f-926f-65552097727a" facs="#m-0d64d77e-e777-4b65-a25f-d3342cfac0cf" label="lyrics-like">véspere, et mane, dies secúndus.</l><l xml:id="m-ba06126f-557c-41dd-b5a2-76d152e68487" facs="#m-d403e973-198d-4293-a49f-954f38212e63" label="lyrics-like">secúndum genús suum. Et vidit</l><l xml:id="m-9decda3a-1f68-4c7d-92b7-e122d1ee2d26" facs="#m-3a01097c-2bdf-4c9a-9469-c9a7e7673e8c" label="lyrics-like">Dixit vero Deus: « Congregén¬</l><l xml:id="m-ac3694fe-619c-471d-a662-ddae4ea9f001" facs="#m-436fd954-3f57-4894-aea3-219eea2f4bff" label="ambiguous">tur aquae, quae sub caelo sunt,</l><l xml:id="m-dcf4d6ec-5916-411b-915a-4cde3f669067" facs="#m-c7c05814-50ee-43f2-bd59-32ef271a6ba9" label="ambiguous">Deus quod esset bonum. Bene¬</l><l xml:id="m-b3a93143-f9dc-4581-a193-3728ea570455" facs="#m-a5a456e8-9179-403e-9d7a-d864d1e37fae" label="lyrics-like">in locum unum: et appáreat</l><l xml:id="m-ea7c2b26-50e6-48d6-8037-4cbd00bb5c9b" facs="#m-33915e29-8adb-4803-a4c4-20f04fdac955" label="lyrics-like">dixitque eis, dicens: « Créscite,</l><l xml:id="m-27515832-0a22-4c46-a495-4d41a621b9e3" facs="#m-eae90d03-c6f0-43fe-bfca-2e7e379b2c15" label="lyrics-like">árida ». Et factum est 'ita. Et</l><l xml:id="m-e10fb5ef-d5b4-462d-88de-764a891df41c" facs="#m-fc215f06-e26e-452b-a541-048510126ba1" label="lyrics-like">et multiplicámini, et repléte</l><l xml:id="m-8e4fb4e8-fbbf-4a8f-9597-738a8bad67aa" facs="#m-611c2f02-ffa9-4d60-bf15-a2e2b84800c1" label="lyrics-like">vocávit Deus áridam, Terram:</l><l xml:id="m-92724957-2f9f-4599-8dd6-7de4dcb3a986" facs="#m-22041ae0-ae9f-450a-91ce-93af5cab4a81" label="lyrics-like">aquas maris : avésque multipli¬</l><l xml:id="m-95804ffa-cecc-4609-a2d6-527746249210" facs="#m-c4868e65-3474-4905-bed0-139b3438b043" label="lyrics-like">congregationésque aquárum ap¬</l><l xml:id="m-70f6eda2-83ee-48ab-a4c6-40e52d8eb87f" facs="#m-66c2710d-360e-4c16-9477-1659f21b1c81" label="lyrics-like">céntur super terram ». Et fa¬</l><l xml:id="m-57a402b6-f6eb-46f5-af69-a2121421614b" facs="#m-9fadf0da-aada-4d44-bf4f-a1c9717c1186" label="lyrics-like">pellávit Mária. Et vidit Deus</l><l xml:id="m-0bd93492-245c-4e67-a2d6-68580f355c36" facs="#m-f8badc95-6894-4be1-9ba3-f66bf6f50684" label="lyrics-like">ctum est véspere, et mane, dies</l><l xml:id="m-34bbebcd-419d-4b73-a264-0ff449ae33eb" facs="#m-fd16cb1d-d857-48ba-89ac-1b7ee8c01de5" label="ambiguous">quod esset bonum.</l><l xml:id="m-eaf0e41f-3ce9-4873-9b9e-f4978515fccb" facs="#m-c7f15b9d-cfdf-453c-905e-040f7aaceb8c" label="ambiguous">quintus.</l><l xml:id="m-ff9b8e5a-ef4f-478b-a057-b90a3859f73f" facs="#m-d97903c3-77bb-4c0c-a6e3-6f45a5dbbab6" label="lyrics-like">Dixit quoque Deus: « Prodúcat</l><l xml:id="m-8992acec-8023-4b90-81b0-994cd7fdb9da" facs="#m-4123e904-5906-48ae-9a5b-7c28405776c5" label="lyrics-like">Et ait: «Gérminet terra herbam</l><l xml:id="m-3343b419-434c-4caf-90e7-5ff2ad3bcabc" facs="#m-e2803a9c-19f3-46f4-b386-506ca91805a7" label="lyrics-like">viréntem, et faciéntem semen, et</l><l xml:id="m-f570968d-9138-470a-8174-17a6c4c2d998" facs="#m-03624b96-ec31-49ba-821a-e2b07d591f41" label="lyrics-like">terra ánimam vivéntem in génere</l><l xml:id="m-8021ba3a-0d0e-4c07-92e2-38512aed653c" facs="#m-8e2b91c8-3ee8-4ad2-8ba4-31e3925bb5fd" label="lyrics-like">lignum pomiferum fáciens fru¬</l><l xml:id="m-02c566cd-641c-4691-84fd-8b555067e004" facs="#m-1eda3a48-600d-44dd-b978-b0b7f00db9c5" label="lyrics-like">suo : juménta, et reptilia, et bé¬</l><l xml:id="m-040e5ad8-29e8-46ff-b212-607a33214587" facs="#m-86d22016-5720-472e-ab27-a8d9e21799b2" label="lyrics-like">stias terrae secúndum spécies</l><l xml:id="m-1bd88c11-1b08-42c4-b77a-30ffb7738298" facs="#m-52a13a3d-f55d-4b7d-a336-f5c55b862bec" label="ambiguous">ctum juxta genus suum, cujus</l><l xml:id="m-d32ceab1-de9d-47fa-9a15-2c02d29ce338" facs="#m-5a0e9877-ada5-4197-a46f-216e0922a342" label="lyrics-like">suas ». Factúmque est ita. Et fe¬</l><l xml:id="m-a9b2d259-7573-46c3-80e0-45cd02e255b0" facs="#m-b3b207a8-a3a8-4b6e-8f03-6b98a3c5cc9e" label="lyrics-like">semen in semetípso sit super</l><l xml:id="m-c4f6706b-0bf4-45a0-9485-68c052f9ba65" facs="#m-7d57a34b-a81f-4ce8-b4d4-210ce87b6824" label="lyrics-like">cit Deus béstias terrae juxta spé¬</l><l xml:id="m-0cbf71fc-32a3-4a90-be5f-a3c685ae7e0d" facs="#m-6bd252db-5f55-42de-aac2-b9087f7f889c" label="ambiguous">terram ». Et factum est ita. Et</l><l xml:id="m-9117d192-3bee-44a1-aaa0-c4a0b1f58224" facs="#m-583b35d8-782b-453d-b4bc-7848a458abde" label="lyrics-like">prótulit terra herbam viréntem,</l><l xml:id="m-9a7c05f4-727e-4e6c-a022-44df9b75f845" facs="#m-8665d6bb-6455-42a6-b794-29ae94b10315" label="lyrics-like">cies suas, et juménta, et omne</l><l xml:id="m-51b18554-1214-4cd8-8b26-e31901449b65" facs="#m-5b9166e0-17f5-4414-9c0f-bdaba2bcbd2c" label="lyrics-like">réptile terrae in génere suo. Et</l><l xml:id="m-7b07c7a9-e76a-486f-b68e-ae5ef5d58f2c" facs="#m-22c554b0-3514-4480-be74-042ed67f2ce2" label="lyrics-like">et faciéntem semen juxta genus</l><l xml:id="m-d6aeae07-3a2b-4c57-8da5-ffdcd2a12954" facs="#m-76e13a61-5594-4740-a3a6-78d34f23dfe9" label="lyrics-like">suum, lignúmque fáciens fru¬</l><l xml:id="m-8801b31e-8b06-4ada-b472-1e094a99d470" facs="#m-c7130e60-1803-43a6-9197-bb8f63e2e847" label="ambiguous">vidit Deus quod esset bonum, et</l><l xml:id="m-69c018a1-023b-467f-948c-95ee4d02e12c" facs="#m-e7a1c1cd-56de-4eed-8ba4-2c7f33d37382" label="lyrics-like">ait : « Faciámus hóminem ad imá¬</l><l xml:id="m-6e6975b1-b6a3-466e-a2b2-79a4ca275005" facs="#m-5e767656-5947-4cff-b649-dc4f5da455ce" label="lyrics-like">ctum, et habens unumquódque</l><l xml:id="m-6a958be8-09b5-433f-8003-3fb67e387a41" facs="#m-f0c0261d-9e20-481f-87c4-3c5d3424b2b2" label="lyrics-like">seméntem secúndum spéciem</l><l xml:id="m-77da2306-3784-4ab9-bc92-fd9fccef7c9f" facs="#m-d89c4b64-c956-4873-99be-bd434cb568a2" label="lyrics-like">ginem, et similitúdinemnostram:</l><l xml:id="m-9739d075-9c24-494b-80e3-0bdc96534a93" facs="#m-2186a082-0430-4eaa-8336-05b638a443ce" label="ambiguous">et praesit piscibus maris, et</l><l xml:id="m-302b9a57-952a-4efb-83ff-82ef4428bd45" facs="#m-4831014e-a4d2-432c-a09d-5435151c043b" label="ambiguous">suam. Et vidit Deus quod esset</l><l xml:id="m-3ddf4766-478e-42f6-b72a-94175eb1e4b2" facs="#m-8c98bb49-c3c6-46e9-92c8-355b8d4d879e" label="lyrics-like">volatilibus caeli, et béstiis, uni¬</l><l xml:id="m-29f868b9-0bac-4a37-a461-f8ebafb1e62f" facs="#m-93f6ed41-62bb-4595-b4dd-509c57c41f09" label="lyrics-like">bonum. Et factum est véspere,</l><l xml:id="m-58b41a2f-2e0f-41d8-b2bd-d3022fd70568" facs="#m-ef6fdb20-26d1-407a-8ff1-161d7be482fa" label="lyrics-like">versaéque terrae, omnique ré¬</l><l xml:id="m-b18d9036-b62b-4777-a651-2109e9a90218" facs="#m-4f1b2101-9f56-4d4d-a98b-bf28ff2ed429" label="lyrics-like">et mane, dies tértius.</l><l xml:id="m-3c23cdde-ca95-453d-a35b-a1cbe1321087" facs="#m-ce099fb0-df15-4fbc-a1d2-017e7b863789" label="ambiguous">pixit autem Deus:Fant</l><l xml:id="m-79137dd2-0887-40ca-908c-c59aaba34cce" facs="#m-14734dbb-e9fa-4e5d-a401-215e06d4370f" label="lyrics-like">ptili, quod movétur in terra ».</l><l xml:id="m-f3f57859-ebe0-46a5-87e0-25c7b60eec12" facs="#m-74f1e834-53d9-496f-9f9f-9015607a32ad" label="lyrics-like">luminária in firmaménto caeli, et</l><l xml:id="m-2ece5c87-0963-4b8c-b59a-470748894804" facs="#m-ed731175-8c3d-4866-8563-0ae38c5d88f8" label="lyrics-like">Et creávit Deus hóminem ad</l></lg></div></section></score></mdiv></body></music>
</mei>