="387" /><zone xml:id="m-94d059af-ac9d-4340-8e37-3e557ab5fd5b" ulx="91" uly="373" lrx="288" lry="408" /><zone xml:id="m-057a27ff-a01e-48a6-9ee1-40126be8cac8" ulx="542" uly="376" lrx="979" lry="415" /><zone xml:id="m-04740798-08ab-4144-b847-9563c66ddc80" ulx="115" uly="402" lrx="528" lry="444" /><zone xml:id="m-3606976a-d2ff-466d-ba84-2ac34764c717" ulx="541" uly="405" lrx="897" lry="441" /><zone xml:id="m-e8fd062c-50a9-461e-aca1-1720b36a759f" ulx="90" uly="433" lrx="528" lry="468" /><zone xml:id="m-2d09a9c5-8286-43fb-8830-026c579c5904" ulx="573" uly="439" lrx="959" lry="476" /><zone xml:id="m-2b7ae46c-a993-4355-8c99-b09c1f1f54e4" ulx="90" uly="461" lrx="333" lry="499" /><zone xml:id="m-282411ee-8b52-4ebb-82af-a1d2592fe2de" ulx="541" uly="469" lrx="980" lry="509" /><zone xml:id="m-c5a9cdf9-e020-4a86-943d-e048aac5c926" ulx="541" uly="496" lrx="643" lry="530" /><zone xml:id="m-613c4359-97ce-4eaf-9cf7-a597df6ff4ba" ulx="219" uly="514" lrx="403" lry="546" /><zone xml:id="m-b0fd587f-ad8b-4ec1-817d-d963a24a1633" ulx="571" uly="533" lrx="980" lry="564" /><zone xml:id="m-4e772c02-d41d-4082-8fe7-b7f72c8c6004" ulx="107" uly="547" lrx="522" lry="589" /><zone xml:id="m-85ffcbde-123a-4db1-a5dc-fa98e19ce26b" ulx="542" uly="555" lrx="979" lry="598" /><zone xml:id="m-ec318bfc-8264-4cbf-afd6-e9eb1e8120fe" ulx="98" uly="578" lrx="527" lry="618" /><zone xml:id="m-ca35542d-52d9-4b97-8b72-d1949d0c3e0e" ulx="542" uly="587" lrx="607" lry="619" /><zone xml:id="m-9478b464-daf8-441c-b7fb-a7e69b3060eb" ulx="92" uly="606" lrx="527" lry="645" /><zone xml:id="m-e2509569-50aa-4483-99d1-e4a643ff120a" ulx="570" uly="614" lrx="982" lry="656" /><zone xml:id="m-db06284c-d2ed-4b0a-ad9f-9b623bcb053e" ulx="91" uly="634" lrx="233" lry="672" /><zone xml:id="m-113f5a40-32cf-4ee4-9b79-0e605832ed56" ulx="544" uly="644" lrx="740" lry="685" /><zone xml:id="m-e15b4acd-f75e-448b-ba38-dd8346d130f5" ulx="133" uly="662" lrx="528" lry="699" /><zone xml:id="m-bf67d27d-b819-41c5-9ed5-97352c0ff499" ulx="570" uly="680" lrx="983" lry="721" /><zone xml:id="m-0b7bee4b-dfdb-4c6e-acc7-765fa352289d" ulx="93" uly="692" lrx="529" lry="726" /><zone xml:id="m-a3732fb4-ac0b-4965-9752-1b0a9d286c71" ulx="545" uly="711" lrx="981" lry="749" /><zone xml:id="m-d5e544ce-a0f5-497c-96af-8d1c3980a497" ulx="92" uly="719" lrx="529" lry="756" /><zone xml:id="m-118cc17d-1038-47d8-b0b8-5d625a493fc8" ulx="546" uly="740" lrx="787" lry="774" /><zone xml:id="m-0754e9ab-35d4-4d54-b0d3-d4aa83352528" ulx="93" uly="748" lrx="294" lry="782" /><zone xml:id="m-c8af4718-5621-4bf2-bbec-ac3ebb24c9c6" ulx="135" uly="774" lrx="533" lry="812" /><zone xml:id="m-cfe69d89-baf7-4abe-a1de-1418759d0067" ulx="664" uly="796" lrx="859" lry="833" /><zone xml:id="m-ba534ca3-5300-4820-951d-c295adaadcca" ulx="93" uly="805" lrx="532" lry="844" /><zone xml:id="m-51cee4dd-0e13-460e-8545-c60de92e040a" ulx="93" uly="833" lrx="233" lry="868" /><zone xml:id="m-a84e09d3-33de-41ec-a1c4-e76dfadef8ec" ulx="554" uly="839" lrx="976" lry="878" /><zone xml:id="m-bed8c463-3e77-45c5-a409-b2937447e3e9" ulx="135" uly="859" lrx="530" lry="896" /><zone xml:id="m-8fa81ad2-f6fb-4ed4-82ba-2a25c48e8180" ulx="554" uly="868" lrx="902" lry="907" /><zone xml:id="m-dacbf512-c842-4974-91fc-94cbe30ee4df" ulx="92" uly="893" lrx="531" lry="924" /><zone xml:id="m-0a5aed09-3f62-4d53-bcf8-644ed6b57658" ulx="585" uly="900" lrx="983" lry="940" /><zone xml:id="m-9e5ce974-7bf1-403a-ad9a-3e98565335e8" ulx="94" uly="921" lrx="221" lry="955" /><zone xml:id="m-40c9004c-4f82-4321-8d9c-57558c180ab7" ulx="546" uly="929" lrx="982" lry="967" /><zone xml:id="m-21aae539-a5c5-427e-874e-1d6b98183972" ulx="134" uly="945" lrx="530" lry="987" /><zone xml:id="m-c988406a-b08a-410e-ad9f-07808cfe8f53" ulx="546" uly="960" lrx="829" lry="996" /><zone xml:id="m-860ad75c-8ff0-4850-878e-9612c4bc80a3" ulx="93" uly="976" lrx="530" lry="1014" /><zone xml:id="m-b831df7c-2425-4656-b4ad-6f3eab766b02" ulx="585" uly="989" lrx="983" lry="1027" /><zone xml:id="m-2585ffb4-ab3b-4505-a69f-70d94fef4de0" ulx="94" uly="1004" lrx="212" lry="1041" /><zone xml:id="m-fc6b206c-90c6-41cc-a49c-7fa9612174bc" ulx="547" uly="1021" lrx="984" lry="1055" /><zone xml:id="m-ab48dc40-2841-4cc3-ae7f-9a391587c9ff" ulx="135" uly="1032" lrx="530" lry="1072" /><zone xml:id="m-b1c8ff67-e243-40c5-a9b6-f88e81231e43" ulx="547" uly="1047" lrx="984" lry="1085" /><zone xml:id="m-a323aa28-50cf-4196-ba6a-8a147ee2c7bd" ulx="95" uly="1061" lrx="530" lry="1100" /><zone xml:id="m-d47678d7-88d2-4f95-bb95-a60e2c23d025" ulx="545" uly="1072" lrx="719" lry="1108" /><zone xml:id="m-5b899909-e592-49c9-b7d3-b8631da7a309" ulx="96" uly="1090" lrx="347" lry="1125" /><zone xml:id="m-f29b4970-297d-410b-ad0b-04c5d5aa40c5" ulx="587" uly="1104" lrx="984" lry="1144" /><zone xml:id="m-cc11b92f-0edb-40fa-93ad-f485c1b944a5" ulx="137" uly="1117" lrx="499" lry="1158" /><zone xml:id="m-fab94332-2b41-462b-93ad-7d8682922938" ulx="509" uly="1120" lrx="524" lry="1147" /><zone xml:id="m-2753928e-ef67-43fb-a59b-06f5370eea55" ulx="545" uly="1137" lrx="891" lry="1173" /><zone xml:id="m-37969df1-ad6e-4075-b4e9-89e6b8398bcd" ulx="95" uly="1148" lrx="378" lry="1181" /><zone xml:id="m-2bdf20f6-dd58-489b-aa4e-3580845e65e9" ulx="586" uly="1166" lrx="983" lry="1202" /><zone xml:id="m-a3f12695-08e4-4f54-8eb9-f2b0f303d6cd" ulx="135" uly="1175" lrx="532" lry="1212" /><zone xml:id="m-05e96cf0-244b-401b-954e-4d30f6a73dd8" ulx="548" uly="1196" lrx="974" lry="1227" /><zone xml:id="m-7fe676cc-0a17-4cb9-8b6a-73b89f13c80b" ulx="97" uly="1210" lrx="532" lry="1245" /><zone xml:id="m-9f082406-08ad-41a0-a662-a0cc49f95e1e" ulx="548" uly="1222" lrx="983" lry="1260" /><zone xml:id="m-b8c26d98-6bbf-4359-bfd9-b920e936a533" ulx="95" uly="1231" lrx="370" lry="1267" /><zone xml:id="m-506cbe39-6ced-471e-8c77-021e13829a31" ulx="549" uly="1251" lrx="651" lry="1284" /><zone xml:id="m-09d3a0f1-310f-4b8d-944f-fa7377d56534" ulx="135" uly="1260" lrx="535" lry="1297" /><zone xml:id="m-214593f0-dbbf-466a-aad9-79c46964f689" ulx="588" uly="1281" lrx="984" lry="1317" /><zone xml:id="m-f515ce6f-c2b0-405a-91ff-7bbdd98099f0" ulx="96" uly="1291" lrx="535" lry="1327" /><zone xml:id="m-903a8ce5-7501-448b-b3a2-1df4ac85c35a" ulx="551" uly="1314" lrx="984" lry="1352" /><zone xml:id="m-e5058a2c-5e8b-4b78-8f92-dcc1b77012f7" ulx="96" uly="1317" lrx="535" lry="1357" /><zone xml:id="m-b11c616e-0c0a-41e2-9e7a-7426326add1b" ulx="95" uly="1345" lrx="201" lry="1379" /><zone xml:id="m-2bf7c5c6-0a23-4690-993c-1826819da3ad" ulx="551" uly="1345" lrx="984" lry="1378" /><zone xml:id="m-269100df-d271-4cb3-aea4-a92f4f93209a" ulx="591" uly="1370" lrx="985" lry="1409" /><zone xml:id="m-73a6ad9f-b4bc-426e-93a6-a79ea701e5dc" ulx="124" uly="1375" lrx="537" lry="1409" /><zone xml:id="m-63d7452f-202d-466a-a779-f20d29062043" ulx="550" uly="1400" lrx="984" lry="1435" /><zone xml:id="m-70d37a6a-38c6-4806-8a3b-18e4cca9b44d" ulx="97" uly="1404" lrx="531" lry="1443" /><zone xml:id="m-38df5f2c-0225-4020-a912-8b7f76f92766" ulx="97" uly="1431" lrx="535" lry="1471" /><zone xml:id="m-68bb38b0-dbb0-42ff-9bd3-497c529a71fd" ulx="588" uly="1432" lrx="985" lry="1468" /><zone xml:id="m-66ca045c-e423-424c-bc77-b5ab8261d686" ulx="98" uly="1458" lrx="176" lry="1498" /><zone xml:id="m-db634a84-054d-4ffc-af00-0b30bc26c50d" ulx="551" uly="1460" lrx="986" lry="1498" /><zone xml:id="m-772daef5-3b75-4e91-a6a1-0de9b2928272" ulx="551" uly="1488" lrx="985" lry="1529" /><zone xml:id="m-7411b9ea-1e66-464e-a01a-328116ae49a5" ulx="126" uly="1489" lrx="536" lry="1529" /><zone xml:id="m-d19a7fcc-2578-4bc0-9cec-c88786cdb642" ulx="98" uly="1516" lrx="361" lry="1557" /><zone xml:id="m-a8fee0e1-6ef7-4b43-88f0-151c8197466b" ulx="550" uly="1520" lrx="627" lry="1555" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-0f28c96a-d038-487f-bc84-5a09c7338d92" n="0666" facs="#m-027c5178-a69d-455f-b021-c270acfcfb2b" /><div xml:id="m-02b960fe-e7be-4e98-9653-b0ce120fd533">
            <lg xml:id="m-4e1f5902-4118-425e-b762-6b7cba29c0f7">
              <l xml:id="m-5ec48979-9319-43c1-9267-1504a39ff213" facs="#m-6d742fc7-3ae0-4c98-8a9e-e400ef7a03ec" label="ambiguous">520</l><l xml:id="m-495ed289-cc37-4f14-a5e6-50a6b2d09765" facs="#m-5a5627fc-b725-42ef-9893-98ea97f037d2" label="ambiguous">Ash Wednesday.</l><l xml:id="m-4c00c02c-606f-45c4-b0b9-c74cd9944682" facs="#m-c64eaf65-f4aa-4360-a6a5-bdb6ac2767c1" label="lyrics-like">12. Quoniam si inimicus méus</l><l xml:id="m-975ad4a8-6db5-4588-bf65-3f2ba8aaa69f" facs="#m-8a6ac8bf-e4e0-4162-8882-978735c4f4bc" label="lyrics-like">5. Avérte mála inimícis méis:"</l><l xml:id="m-3bc33b0d-a291-4d4c-806c-371c88c8d5f1" facs="#m-9e66f31a-c5f1-4f5d-a02d-b8242123ac64" label="lyrics-like">maledixisset míhi, sustinutssem</l><l xml:id="m-149927cc-5cf7-405a-b5ef-0ec7b06913f5" facs="#m-1097579c-5c19-4fbc-a045-a4d72c32274b" label="lyrics-like">et in veritáte túa dispérde illos.</l><l xml:id="m-00d15da0-f9f9-493b-b444-4e6876694352" facs="#m-f7cc33da-5bd2-4d88-be32-f6f4626501bb" label="lyrics-like">útique.</l><l xml:id="m-3ce7d8fe-80ec-4e57-a9dd-c5cdf6c53563" facs="#m-99277631-169d-4482-b6a8-13301dac7169" label="lyrics-like">6. Voluntárie sacrificábo tíbi,</l><l xml:id="m-bb3d2fac-4a44-4dcb-960e-cb41e2b1d933" facs="#m-6d5e40b1-68a2-4384-9e8d-172e37407c89" label="lyrics-like">13. Et si is, qui óderat me, super</l><l xml:id="m-4f636490-cc62-4b53-b711-61ccbb54ef73" facs="#m-90220107-78f8-4dc3-8c33-5f285358532b" label="lyrics-like">et confitébor nómini túo, Dómine:</l><l xml:id="m-16560da4-2d83-433d-83fb-64c00307bfea" facs="#m-37c61bd4-75a9-437a-8634-ef8248fa3118" label="lyrics-like">quóniam bónum est:</l><l xml:id="m-88515a5b-218f-42f3-871e-a0fafe173d1f" facs="#m-a68425e3-8a6d-42ef-81f9-8f064125e27b" label="lyrics-like">me mágna locútus fuisset,“ abscon¬</l><l xml:id="m-256372ba-e6ae-46ff-81cf-925eedf9e2d7" facs="#m-6f106213-76bd-413b-91ba-758021d48c9a" label="lyrics-like">dissem me fórsitan ab éo.</l><l xml:id="m-b40c722e-7820-4b45-9b38-8c1eb553a510" facs="#m-10dffe94-3e90-4586-b3b4-1720b2306745" label="lyrics-like">7. Quóniam ex ómni tribulatióne</l><l xml:id="m-f1f82186-4a14-4a57-9158-fa581f56706b" facs="#m-57178679-af7d-42ba-b5c9-1cf8cb5fc7cf" label="lyrics-like">14. Tu véro, hómo unánimis:</l><l xml:id="m-689ea214-58f0-4528-b1f2-f567f8cdff38" facs="#m-84b17b15-34b3-49da-9c23-c8989b76e487" label="ambiguous">eripuisti me: * et super inimicos</l><l xml:id="m-25fe8d09-6c00-401c-b06d-e58a6d305cca" facs="#m-ab99446b-cce5-433a-984d-17533bed7fd3" label="lyrics-like">méos despéxit óculus méus.</l><l xml:id="m-c4eefeac-09ab-46bf-aa39-12107dcbc301" facs="#m-6f00a979-9095-4d5e-b595-e1fab4de29ec" label="lyrics-like">dux méus, et nótus méus:</l><l xml:id="m-a2c850d1-4016-4949-9406-c6c57219b562" facs="#m-68842a7c-cf33-4f04-9a8a-0be6deead684" label="lyrics-like">8. Glória Patri, et Filio, * et</l><l xml:id="m-ead9c9e3-7bba-4435-9105-7ca60e77f7d6" facs="#m-877c3119-855d-4036-8496-614396f4b9e2" label="lyrics-like">15. Qui símul mécum dúlces</l><l xml:id="m-5996c0f7-fa0f-4eb7-932e-a13fb8d77e33" facs="#m-94d059af-ac9d-4340-8e37-3e557ab5fd5b" label="lyrics-like">Spiritui Sáncto.</l><l xml:id="m-d89fc1d1-f6ba-414b-abec-16b198b2340f" facs="#m-057a27ff-a01e-48a6-9ee1-40126be8cac8" label="lyrics-like">capiébas cibos: “in dómo Déi</l><l xml:id="m-aaf4183c-c003-4459-a947-18ceb89694e6" facs="#m-04740798-08ab-4144-b847-9563c66ddc80" label="lyrics-like">9. sicut érat in principio, et</l><l xml:id="m-37d4974a-41fe-4239-aa9f-f1cd147dc03e" facs="#m-3606976a-d2ff-466d-ba84-2ac34764c717" label="lyrics-like">ambulávimus cum consénsu.</l><l xml:id="m-07cbdb80-ff90-4ac8-894a-ce28c32f0017" facs="#m-e8fd062c-50a9-461e-aca1-1720b36a759f" label="lyrics-like">nunc, et sémper, “ in saécula</l><l xml:id="m-3cf9ff96-f11e-4b53-8ba2-ee9dffe3e42a" facs="#m-2d09a9c5-8286-43fb-8830-026c579c5904" label="lyrics-like">16. Véniat mors super illos:</l><l xml:id="m-57592e99-1d67-4a2b-b282-cf89b352a0f4" facs="#m-2b7ae46c-a993-4355-8c99-b09c1f1f54e4" label="lyrics-like">saecutórum. Amen.</l><l xml:id="m-1727f5c9-6d7d-4d48-84da-fc226cea554c" facs="#m-282411ee-8b52-4ebb-82af-a1d2592fe2de" label="lyrics-like">et descéndant in inférnum vi¬</l><l xml:id="m-8d3eab27-e903-4868-a3c9-7d5c06e544d2" facs="#m-c5a9cdf9-e020-4a86-943d-e048aac5c926" label="lyrics-like">véntes:</l><l xml:id="m-ebe3fca6-1570-4146-b39a-43f24e85c71f" facs="#m-613c4359-97ce-4eaf-9cf7-a597df6ff4ba" label="ambiguous">Psalm 54. I.</l><l xml:id="m-ce7289e7-600b-48db-8fce-4ba47b0ef96c" facs="#m-b0fd587f-ad8b-4ec1-817d-d963a24a1633" label="lyrics-like">17. Quóniam nequítiae in habi¬</l><l xml:id="m-5057649e-161f-45d3-a3d9-8a8ff34fe462" facs="#m-4e772c02-d41d-4082-8fe7-b7f72c8c6004" label="lyrics-like">xáudi, Déus, oratiónem méam, i</l><l xml:id="m-291759ab-e7b7-45c5-9309-a70530fad92d" facs="#m-85ffcbde-123a-4db1-a5dc-fa98e19ce26b" label="lyrics-like">táculis eórum"in médio eó¬</l><l xml:id="m-a21ee1ce-9a71-4d35-9256-2a3898fcdb72" facs="#m-ec318bfc-8264-4cbf-afd6-e9eb1e8120fe" label="lyrics-like">U et ne despéxeris deprecatió¬</l><l xml:id="m-1036b143-9f6f-4d1e-8399-7812d4abdc45" facs="#m-ca35542d-52d9-4b97-8b72-d1949d0c3e0e" label="ambiguous">rum.</l><l xml:id="m-9232b86c-2f4f-4510-8f58-bf386aa619c7" facs="#m-9478b464-daf8-441c-b7fb-a7e69b3060eb" label="lyrics-like">nem méam:“inténde mihi, et</l><l xml:id="m-47793610-169d-4528-b4e1-849a7de10578" facs="#m-e2509569-50aa-4483-99d1-e4a643ff120a" label="lyrics-like">18. Glória Pátri, et Filio, *t</l><l xml:id="m-2bbf669a-9c89-4101-ac47-54d1c3be4274" facs="#m-db06284c-d2ed-4b0a-ad9f-9b623bcb053e" label="lyrics-like">exáudi me.</l><l xml:id="m-8dad26d9-4ed4-42e8-9345-2a6a14c5a691" facs="#m-113f5a40-32cf-4ee4-9b79-0e605832ed56" label="lyrics-like">Spiritui Sáncto.</l><l xml:id="m-3f69179c-19e8-4197-9db2-38699ddec46e" facs="#m-e15b4acd-f75e-448b-ba38-dd8346d130f5" label="lyrics-like">2. Contristátus sum in exerci¬</l><l xml:id="m-62313044-00e3-4f06-a943-f0726cd5794c" facs="#m-bf67d27d-b819-41c5-9ed5-97352c0ff499" label="lyrics-like">19. Sicut érat in principio, et</l><l xml:id="m-6af979d9-8254-4ced-975a-637ce865fcb7" facs="#m-0b7bee4b-dfdb-4c6e-acc7-765fa352289d" label="lyrics-like">tatióne méa: “et conturbátus</l><l xml:id="m-6b2827d9-cb7a-43db-819d-92e994d14e70" facs="#m-a3732fb4-ac0b-4965-9752-1b0a9d286c71" label="lyrics-like">nunc, et sémper, *et in saécula</l><l xml:id="m-b27a4a17-992a-41f9-89f3-9cd56661167a" facs="#m-d5e544ce-a0f5-497c-96af-8d1c3980a497" label="lyrics-like">sum a vóce inimici, et a tribula¬</l><l xml:id="m-85636b79-14fc-4b34-a37f-ed9a1be24fd9" facs="#m-118cc17d-1038-47d8-b0b8-5d625a493fc8" label="lyrics-like">saecúlórum. Amen.</l><l xml:id="m-0e2fa7e7-c853-4719-9108-26fb1fb99805" facs="#m-0754e9ab-35d4-4d54-b0d3-d4aa83352528" label="lyrics-like">tióne peccatóris.</l><l xml:id="m-c0973a62-ba72-4915-941a-a10b9ab0bf45" facs="#m-c8af4718-5621-4bf2-bbec-ac3ebb24c9c6" label="lyrics-like">3. Quóniam declinavérunt in</l><l xml:id="m-337427f5-2de8-4d47-a084-fd5f75907157" facs="#m-cfe69d89-baf7-4abe-a1de-1418759d0067" label="ambiguous">Psalm 54. II.</l><l xml:id="m-8ae572a4-5b12-421a-b782-d8e8cd53b0db" facs="#m-ba534ca3-5300-4820-951d-c295adaadcca" label="lyrics-like">me iniquitátes : “ et in ira molésti</l><l xml:id="m-db2f0d02-605b-432c-9e02-f0f8623ee5ec" facs="#m-51cee4dd-0e13-460e-8545-c60de92e040a" label="lyrics-like">érant mihi.</l><l xml:id="m-9692d993-1664-4092-a5a6-5717da86f943" facs="#m-a84e09d3-33de-41ec-a1c4-e76dfadef8ec" label="lyrics-like">Qdo autem ad Déum clamávi :"</l><l xml:id="m-deb58c72-41b3-4ffa-ad14-d4561f5437ad" facs="#m-bed8c463-3e77-45c5-a409-b2937447e3e9" label="lyrics-like">4. Cor méum conturbátum est</l><l xml:id="m-799ac9bb-1bc3-4215-922d-d6325875504f" facs="#m-8fa81ad2-f6fb-4ed4-82ba-2a25c48e8180" label="lyrics-like">C et Dóminus satvábit me.</l><l xml:id="m-5c8f8551-8c32-4e85-90a0-977faa0e053f" facs="#m-dacbf512-c842-4974-91fc-94cbe30ee4df" label="lyrics-like">in me: * et formído mórtis cécidit</l><l xml:id="m-c27af0f2-bc2f-4f8a-95aa-7f298f356e06" facs="#m-0a5aed09-3f62-4d53-bcf8-644ed6b57658" label="lyrics-like">2. Véspere, et mâne, et meridie</l><l xml:id="m-5a98d0ce-475c-4c5c-afe5-55a70147ecac" facs="#m-9e5ce974-7bf1-403a-ad9a-3e98565335e8" label="ambiguous">super me.</l><l xml:id="m-96d86b57-390d-41a7-a25b-44c86355f494" facs="#m-40c9004c-4f82-4321-8d9c-57558c180ab7" label="lyrics-like">narrábo et annuntiábo: “ et</l><l xml:id="m-3d70ae0d-2bac-471b-b01d-35a5cc14e77f" facs="#m-21aae539-a5c5-427e-874e-1d6b98183972" label="lyrics-like">5. Timor et trémor venérunt</l><l xml:id="m-15ad6964-0c4f-4278-9d37-fc65a680bab8" facs="#m-c988406a-b08a-410e-ad9f-07808cfe8f53" label="lyrics-like">exáudiet vócem méam.</l><l xml:id="m-ae49d11a-4ce0-4e77-b417-5728e2e9a39e" facs="#m-860ad75c-8ff0-4850-878e-9612c4bc80a3" label="lyrics-like">súper me: * et contexérunt me</l><l xml:id="m-b36eb35e-ed40-41cf-9ce7-75d59b3aec47" facs="#m-b831df7c-2425-4656-b4ad-6f3eab766b02" label="lyrics-like">3. Rédimet in pá̂ce ánimam</l><l xml:id="m-9297f4d0-f46d-44f0-ac2e-08e1b3d4af86" facs="#m-2585ffb4-ab3b-4505-a69f-70d94fef4de0" label="lyrics-like">ténebrae.</l><l xml:id="m-055500fa-d224-4b7e-8796-b957d85d55d7" facs="#m-fc6b206c-90c6-41cc-a49c-7fa9612174bc" label="lyrics-like">méam ab his qui appropínquant</l><l xml:id="m-80416791-fd94-44e8-a207-6ca964f2eb76" facs="#m-ab48dc40-2841-4cc3-ae7f-9a391587c9ff" label="lyrics-like">6. Et dixi: Quis dábit míhi</l><l xml:id="m-033e6518-1b32-4c10-8656-9feee2dbb638" facs="#m-b1c8ff67-e243-40c5-a9b6-f88e81231e43" label="lyrics-like">*quóniam 'inter múltos</l><l xml:id="m-f9af6762-9368-4532-aa29-fb11bbaa1da8" facs="#m-a323aa28-50cf-4196-ba6a-8a147ee2c7bd" label="lyrics-like">pénnas sicut colúmbae?“et vo¬</l><l xml:id="m-0fbb9223-d64c-4ecf-91e9-424e446bebdc" facs="#m-d47678d7-88d2-4f95-bb95-a60e2c23d025" label="lyrics-like">érant mécum.</l><l xml:id="m-0e25000d-bcf0-4915-941d-cf49d9eaccb8" facs="#m-5b899909-e592-49c9-b7d3-b8631da7a309" label="lyrics-like">lábo, et requiéscam.</l><l xml:id="m-3714a18e-c525-4132-b958-5405d2c6f6b5" facs="#m-f29b4970-297d-410b-ad0b-04c5d5aa40c5" label="lyrics-like">4. Exáudiet Déus, et humiliábit</l><l xml:id="m-db581a93-8109-4306-a3a1-d60df7a77ab5" facs="#m-cc11b92f-0edb-40fa-93ad-f485c1b944a5" label="lyrics-like">7. Ecce elongávi fúgiens:</l><l xml:id="m-86f274a4-dd40-4085-a1c4-a9e7231dc586" facs="#m-fab94332-2b41-462b-93ad-7d8682922938" label="ambiguous">"</l><l xml:id="m-dae199a8-3112-4964-8df4-bb4e61d89bd0" facs="#m-2753928e-ef67-43fb-a59b-06f5370eea55" label="lyrics-like">illos,qui est ante saécula.</l><l xml:id="m-1357e7f5-7d77-4f51-b59e-c9829c629316" facs="#m-37969df1-ad6e-4075-b4e9-89e6b8398bcd" label="lyrics-like">et mánsi in solitudine.</l><l xml:id="m-38c122ac-70c0-43c8-aac9-98cf03da6b5a" facs="#m-2bdf20f6-dd58-489b-aa4e-3580845e65e9" label="lyrics-like">5. Non enim est illis commutá¬</l><l xml:id="m-e78409de-d724-4432-ae82-c03af8897740" facs="#m-a3f12695-08e4-4f54-8eb9-f2b0f303d6cd" label="lyrics-like">8. Exspectábam éum qui sál¬</l><l xml:id="m-27438af5-4df1-4475-a0f7-5728a270298d" facs="#m-05e96cf0-244b-401b-954e-4d30f6a73dd8" label="lyrics-like">tio. et non timuérunt Déum:</l><l xml:id="m-3aa766c3-9d31-48de-8364-11a6d3388aab" facs="#m-7fe676cc-0a17-4cb9-8b6a-73b89f13c80b" label="lyrics-like">vum me fécit, *a pusillanimitáte</l><l xml:id="m-2b887a6e-5fba-496c-97e2-bd6e2caf08a2" facs="#m-9f082406-08ad-41a0-a662-a0cc49f95e1e" label="lyrics-like">exténdit mánum súam in retri¬</l><l xml:id="m-2af05025-fc35-40f2-bd15-0a4fdcc27b23" facs="#m-b8c26d98-6bbf-4359-bfd9-b920e936a533" label="lyrics-like">spiritus et tempestáte.</l><l xml:id="m-8c97f7b1-7a11-4feb-8f42-fdd7fd691964" facs="#m-506cbe39-6ced-471e-8c77-021e13829a31" label="lyrics-like">buéndo.</l><l xml:id="m-393adda7-fa0e-431a-b485-025d9d085df7" facs="#m-09d3a0f1-310f-4b8d-944f-fa7377d56534" label="lyrics-like">9. Praecipita, Dómine, divide</l><l xml:id="m-562f00d1-11ec-447e-a164-8c7cd4bb7560" facs="#m-214593f0-dbbf-466a-aad9-79c46964f689" label="lyrics-like">6. Contaminavérunt testamén¬</l><l xml:id="m-1ef72e25-5683-4994-8358-79291c52de07" facs="#m-f515ce6f-c2b0-405a-91ff-7bbdd98099f0" label="lyrics-like">linguas eórum:“ quóniam vidi</l><l xml:id="m-9af0da83-0861-427b-98e2-037c68519f61" facs="#m-903a8ce5-7501-448b-b3a2-1df4ac85c35a" label="lyrics-like">tum éjus, f divísi sunt ab fra vúltus</l><l xml:id="m-6b75380c-ae77-4834-9e2e-6bc083308124" facs="#m-e5058a2c-5e8b-4b78-8f92-dcc1b77012f7" label="lyrics-like">iniquitátem, et contradictiónem in</l><l xml:id="m-df60eb4d-71db-41c1-8b11-6072dc8e7efa" facs="#m-b11c616e-0c0a-41e2-9e7a-7426326add1b" label="lyrics-like">civitáte.</l><l xml:id="m-d4e3e725-9afe-4762-9e2e-0e9ffbe6723d" facs="#m-2bf7c5c6-0a23-4690-993c-1826819da3ad" label="lyrics-like">éjus: a et appropinquávit cor illius.</l><l xml:id="m-0682bb45-a085-4c89-a6f6-7881f472ede9" facs="#m-269100df-d271-4cb3-aea4-a92f4f93209a" label="lyrics-like">7. Molliti sunt sermónes éjus</l><l xml:id="m-9b9ebc54-4cb6-42ab-bd89-978fb1e3da2e" facs="#m-73a6ad9f-b4bc-426e-93a6-a79ea701e5dc" label="lyrics-like">10. Die ac nócte circúmdabit</l><l xml:id="m-4db6cb2a-3ba6-4e0e-b5c9-9924c73b5707" facs="#m-63d7452f-202d-466a-a779-f20d29062043" label="lyrics-like">super óleum :* et ípsi sunt jácula.</l><l xml:id="m-f59ad324-1e18-4f71-bae2-09d55eb26a5f" facs="#m-70d37a6a-38c6-4806-8a3b-18e4cca9b44d" label="lyrics-like">éam super múros éjus, iniquitas :"</l><l xml:id="m-926f8b92-0197-4ab1-b9e2-b65e817a4aed" facs="#m-38df5f2c-0225-4020-a912-8b7f76f92766" label="lyrics-like">et lábor in médio éjus, et inju¬</l><l xml:id="m-7da9c113-072f-4814-a479-ab3bd1625450" facs="#m-68bb38b0-dbb0-42ff-9bd3-497c529a71fd" label="lyrics-like">8. Jácta super Dóminum cúram</l><l xml:id="m-b0196c81-9236-491e-b3f4-3bbd439e6818" facs="#m-66ca045c-e423-424c-bc77-b5ab8261d686" label="ambiguous">stitia.</l><l xml:id="m-92e5f2b3-58d3-4d64-ac60-9d5687ca7bed" facs="#m-db634a84-054d-4ffc-af00-0b30bc26c50d" label="lyrics-like">túam, et ipse te enútriet : </l><l xml:id="m-ae874e96-878d-4f98-abd9-5597e22a714c" facs="#m-772daef5-3b75-4e91-a6a1-0de9b2928272" label="lyrics-like">dábit in aetérnum fluctuatiónem</l><l xml:id="m-d7c04fe1-507c-47fe-b416-61b2cf4f02f1" facs="#m-7411b9ea-1e66-464e-a01a-328116ae49a5" label="lyrics-like">11. Et non defécit de platéis</l><l xml:id="m-12229143-ead6-4e0e-94dc-3128c6079bbc" facs="#m-d19a7fcc-2578-4bc0-9cec-c88786cdb642" label="lyrics-like">ejus * usúra et dólus.</l><l xml:id="m-63943251-230b-4333-b6fa-7f83fcef6741" facs="#m-a8fee0e1-6ef7-4b43-88f0-151c8197466b" label="lyrics-like">jústo.</l></lg></div></section></score></mdiv></body></music>
</mei>