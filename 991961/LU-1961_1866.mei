" lry="612" /><zone xml:id="m-370c6d24-eff5-4608-9d62-3169691c7051" ulx="498" uly="614" lrx="595" lry="651" /><zone xml:id="m-575c50da-d51d-497e-ab2d-801718684a99" ulx="141" uly="641" lrx="982" lry="682" /><zone xml:id="m-0e8cd533-7626-4e91-b9a3-5e2e28834439" ulx="118" uly="670" lrx="543" lry="709" /><zone xml:id="m-e47d5794-8e11-417c-9a35-96f49f455a70" ulx="554" uly="671" lrx="981" lry="710" /><zone xml:id="m-068c2a2d-abf5-4e36-b087-0237533ad756" ulx="117" uly="698" lrx="543" lry="730" /><zone xml:id="m-910ebc18-0501-4ab3-838a-7f0f258acf7f" ulx="557" uly="704" lrx="689" lry="732" /><zone xml:id="m-e1af3228-e716-45f6-a200-ed3630f0c95a" ulx="118" uly="730" lrx="542" lry="763" /><zone xml:id="m-8cd79c29-f204-491f-abe5-ce73820397eb" ulx="430" uly="767" lrx="668" lry="801" /><zone xml:id="m-7fc6f613-ec19-4bb5-af07-cbf6f95fccf2" ulx="157" uly="795" lrx="982" lry="836" /><zone xml:id="m-0bace93d-c6cd-4ef6-8aa5-588a98060a35" ulx="118" uly="817" lrx="689" lry="862" /><zone xml:id="m-3b42a2f8-7304-493c-8434-1074fe17b0ec" ulx="118" uly="850" lrx="549" lry="888" /><zone xml:id="m-073377ba-8daf-4aff-bb83-5ab6b5d26984" ulx="120" uly="936" lrx="983" lry="980" /><zone xml:id="m-1ea672fe-418e-4da2-b0d2-1836bd72daad" ulx="142" uly="985" lrx="862" lry="1022" /><zone xml:id="m-f5bb578f-1f6c-48c0-80f8-577d7b4d5080" ulx="145" uly="1021" lrx="985" lry="1061" /><zone xml:id="m-18523e5c-b93e-48a3-97f0-350cd252358a" ulx="118" uly="1051" lrx="661" lry="1088" /><zone xml:id="m-4d03d2d8-9743-44af-ba58-13fc0da1ec14" ulx="144" uly="1081" lrx="471" lry="1121" /><zone xml:id="m-93640c73-def7-45e1-8551-47b68903f90b" ulx="491" uly="1128" lrx="614" lry="1171" /><zone xml:id="m-cd8e51d7-7654-4c66-ab64-bfc7d59fefcf" ulx="144" uly="1174" lrx="520" lry="1216" /><zone xml:id="m-12a1c940-622e-40f6-a54f-113339b5d326" ulx="500" uly="1216" lrx="609" lry="1255" /><zone xml:id="m-92f60428-2489-41ff-9bd0-3371a259c5b1" ulx="144" uly="1249" lrx="986" lry="1283" /><zone xml:id="m-5fce8493-7d37-4d8a-800c-2882a30ae132" ulx="126" uly="1276" lrx="985" lry="1310" /><zone xml:id="m-7380add9-55c3-4697-b418-9022dd7979d6" ulx="122" uly="1308" lrx="985" lry="1338" /><zone xml:id="m-16df201c-8561-4bc7-9d48-87225729a8c1" ulx="122" uly="1332" lrx="935" lry="1369" /><zone xml:id="m-5ae15500-d8d9-4628-9b0c-5c5a33e8b14f" ulx="147" uly="1368" lrx="541" lry="1406" /><zone xml:id="m-cf138315-a167-4323-abdc-206038e3077a" ulx="147" uly="1400" lrx="988" lry="1444" /><zone xml:id="m-70ddd705-a801-42a4-9eb7-69655d94320c" ulx="122" uly="1429" lrx="324" lry="1469" /><zone xml:id="m-a4287812-24a0-4bb8-928d-4d51ee2bba4d" ulx="871" uly="1456" lrx="960" lry="1510" /><zone xml:id="m-751cd444-3c82-4218-9e13-ac1cd2d0ab8a" ulx="147" uly="1460" lrx="488" lry="1498" /><zone xml:id="m-e7f7f531-f994-4723-9223-354c58079b19" ulx="149" uly="1494" lrx="521" lry="1536" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-d6928d80-4067-4be2-a0e3-c5cd38b25a76" n="1866" facs="#m-4cfe77a5-5436-433a-825f-f28ccf86fbed" /><div xml:id="m-4711864c-73a2-4f34-9cc3-4bbbdd6e780c">
            <lg xml:id="m-a68aa5a4-fb4b-461d-b1b3-256d464cf0fe">
              <l xml:id="m-47638704-025a-4f6f-bf46-c5a47ed25da3" facs="#m-2d40ab7d-21c0-48a9-95c7-ccbce40f983d" label="ambiguous">1e2s</l><l xml:id="m-4ad04b6c-3c4d-4fa8-b03e-d60095e421ae" facs="#m-416b7f90-4715-44fa-a456-0bbb9723a31a" label="ambiguous">September I0. 11. 12.</l><l xml:id="m-1866bbf0-8e08-46a3-8b14-eb0359662009" facs="#m-6dfa5b53-87f1-407b-889c-1bc09dd05d42" label="ambiguous" /><l xml:id="m-cca8d94f-aa66-4d4f-aeef-dd1bcb512433" facs="#m-e2d2549a-4795-4fe3-81a9-853bcd1bf556" label="ambiguous">10.</l><l xml:id="m-8cc63e8e-110e-40fa-8f2c-b9c99aaf7fc9" facs="#m-718e512d-a1cb-4e24-9c33-ccf1f0169595" label="text-like">St. Nicholas of Tolentino, Confessor.</l><l xml:id="m-bb44d691-deff-4da7-a3c6-6c97825771e8" facs="#m-8544255e-8365-4c81-b082-8a4f7e5251c7" label="ambiguous">Double.</l><l xml:id="m-3b180b0d-5a4e-4710-b06e-9251f3e64875" facs="#m-313f8344-98f8-4d14-8505-f003f1d5e0a3" label="lyrics-like">Mass. Jústus ut pálma. p. 1204.</l><l xml:id="m-5f39c3c5-53b0-4751-848a-fcf21fd9a534" facs="#m-7438dd47-565b-41e0-be67-21db5dc4537c" label="ambiguous">Collect.</l><l xml:id="m-76047e3d-9aa9-43d0-bc44-1cfe321c6823" facs="#m-a6dab680-4ec3-4fda-ab5f-76bd9432b121" label="lyrics-like">H Désto Dómine supplicatiónibus! fidúciam non habémus, * ejus qui</l><l xml:id="m-78686fc9-1d7f-414c-8980-df0109785811" facs="#m-18faf950-1fb5-4a27-bd59-3c20c757cc69" label="lyrics-like">A nostris, quas in beáti Nicolail tibi plácuit précibus adjuvémur.</l><l xml:id="m-fb6145a9-6f2f-4e16-83d6-fc68c028f4c0" facs="#m-8e2f22e6-78fa-4194-9ed3-8a3bb452876c" label="lyrics-like">Confessóris tui solemnitáte deféri¬</l><l xml:id="m-637410d8-7c31-4f9e-b70b-5feee7826b72" facs="#m-700fcc19-7cd4-4f13-9bfe-4b662766ee8f" label="lyrics-like">Per Dóminum.</l><l xml:id="m-b45d2138-4497-450d-a3bd-7ae1411b751c" facs="#m-7ac9eef7-92cd-4bb2-bceb-2692eeb2237f" label="lyrics-like">mus: t ut qui nostrae justítiae</l><l xml:id="m-08c8e062-c5ca-4327-8d05-e0780413a3c9" facs="#m-dde70bf3-e867-491d-a472-8ab33eca2835" label="text-like">SS. Protus and Hyacinth, Martyrs.</l><l xml:id="m-a5ccc0df-15d5-494d-8f85-156145f95c75" facs="#m-89b75204-a47f-446b-9154-456c5de7796e" label="ambiguous">n1.</l><l xml:id="m-e2813908-a088-46d3-b26a-7f4fb81c492b" facs="#m-f3f678f6-12f8-414e-9855-5ee448f870c2" label="ambiguous">Simple.</l><l xml:id="m-e4b2882b-dbdb-4eb4-a81b-bed42bc893f9" facs="#m-51aaee80-0ed2-4615-b9dd-0a98a8bcf755" label="ambiguous">Collect.</l><l xml:id="m-dbcb085a-b1fe-40f9-ad42-b44d9698f21c" facs="#m-f6331858-2187-4ffc-9ad9-b6c1eac88189" label="lyrics-like">REatórum Mártyrum tuórum Pro-júgiter intercéssio tueátur. Per Dó¬</l><l xml:id="m-342e78da-c6b9-4c28-b515-eb5755edf513" facs="#m-91567fd8-4e3b-48f1-b551-1df4ceba2869" label="lyrics-like">D ti et Hyacinthi nos, Dómine, minum nostrum.</l><l xml:id="m-3a642ba2-d67f-4c6e-bca9-62073ceb03c8" facs="#m-6b467fcb-5e7f-4073-bfae-fb6e58f91516" label="lyrics-like">fõveat pretiósa conféssio:“et pia</l><l xml:id="m-f8b207d8-ee46-4948-a2c9-cf125d050e14" facs="#m-370c6d24-eff5-4608-9d62-3169691c7051" label="ambiguous">Secret.</l><l xml:id="m-34721c87-9142-4538-9023-8b13adda2168" facs="#m-575c50da-d51d-497e-ab2d-801718684a99" label="lyrics-like">DRO sanctórum Mártyrum tuó- quaésumus; ut remédium nobis</l><l xml:id="m-a14089ed-4b45-45a7-b49d-6ca187b1d5aa" facs="#m-0e8cd533-7626-4e91-b9a3-5e2e28834439" label="ambiguous">Erum Proti et Hyacinthi comme¬</l><l xml:id="m-fa7310d2-af3d-4bcc-9839-d7e1e7ac176d" facs="#m-e47d5794-8e11-417c-9a35-96f49f455a70" label="lyrics-like">perpétuae salútis operéntur. Per</l><l xml:id="m-c08408c8-2295-453d-a830-1877c77dbdd1" facs="#m-068c2a2d-abf5-4e36-b087-0237533ad756" label="lyrics-like">moratióne, múnera tibi, Dómine,</l><l xml:id="m-8cf586b4-e56a-4058-90cd-ddc580c5dca5" facs="#m-910ebc18-0501-4ab3-838a-7f0f258acf7f" label="lyrics-like">Dóminum.</l><l xml:id="m-958062c2-1acd-4086-a139-6c0e9d06e590" facs="#m-e1af3228-e716-45f6-a200-ed3630f0c95a" label="lyrics-like">quae debémus, exsólvimus : praesta</l><l xml:id="m-f4ae342c-5bec-4f39-a108-f6da55263b58" facs="#m-8cd79c29-f204-491f-abe5-ce73820397eb" label="ambiguous">Postcommunion.</l><l xml:id="m-be15e859-a9b4-4633-bfe0-3b542075ee09" facs="#m-7fc6f613-ec19-4bb5-af07-cbf6f95fccf2" label="lyrics-like">T percépta nos Dómine tua san- quaésumus, implóret orátio. Per</l><l xml:id="m-af677bc0-337b-4475-ae84-743b5a705bcc" facs="#m-0bace93d-c6cd-4ef6-8aa5-588a98060a35" label="lyrics-like">Ul cta purfficent : beatórum Mar-] Dóminum.</l><l xml:id="m-4bde921e-439e-4d5b-9611-9a351e2a3967" facs="#m-3b42a2f8-7304-493c-8434-1074fe17b0ec" label="lyrics-like">tyrum tuórum Proti et Hyacínthi,</l><l xml:id="m-c616012b-039f-4b07-a3ac-f735d6695695" facs="#m-073377ba-8daf-4aff-bb83-5ab6b5d26984" label="text-like">12. Feast of the Most Holy Name of Mary. Double major.</l><l xml:id="m-7d11d2ba-8fa5-48cb-921b-7e7e3b4049e7" facs="#m-1ea672fe-418e-4da2-b0d2-1836bd72daad" label="text-like">Alt from the Common of Feasts of the Blessed Virgin, p. 1254.</l><l xml:id="m-78a0ffc2-38b9-4299-b693-38d013b16eff" facs="#m-f5bb578f-1f6c-48c0-80f8-577d7b4d5080" label="lyrics-like">At Ist Vespers, at Magnificat. Ant. Sáncta María... túi sáncti Nóminis</l><l xml:id="m-c576949c-857f-43bb-8e31-3419662453fa" facs="#m-18523e5c-b93e-48a3-97f0-350cd252358a" label="lyrics-like">commemoratiónem. p. 1255. V. Dignáre me.</l><l xml:id="m-efb6a8ff-50b0-41b9-bffc-170eecd5fee2" facs="#m-4d03d2d8-9743-44af-ba58-13fc0da1ec14" label="lyrics-like">Prayer. Concéde. as below.</l><l xml:id="m-b492277b-c401-4d21-a3c9-3cdf44c8d8c2" facs="#m-93640c73-def7-45e1-8551-47b68903f90b" label="text-like">At Mass.</l><l xml:id="m-5c963900-7cdc-4a2d-b30e-f3f240f99f3c" facs="#m-cd8e51d7-7654-4c66-ab64-bfc7d59fefcf" label="lyrics-like">Introit. Vúltum túum. p. 1229.</l><l xml:id="m-faa5a578-2455-4fbb-abe9-2d4c3f9c2679" facs="#m-12a1c940-622e-40f6-a54f-113339b5d326" label="ambiguous">Collect.</l><l xml:id="m-aaa13aaf-50b7-40d3-999a-2f0070f3e0aa" facs="#m-92f60428-2489-41ff-9bd0-3371a259c5b1" label="lyrics-like">vOncéde, quaésumus omnípotens ! pia intercessióne, a cunctis malis</l><l xml:id="m-a82a0b88-cd98-4900-889c-9b98a3ebe3bf" facs="#m-5fce8493-7d37-4d8a-800c-2882a30ae132" label="lyrics-like">L Deus: t ut fidéles tui, qui subl liberéntur in terris, * et ad gáudia</l><l xml:id="m-ea00b786-7f59-4744-9d18-4462fc5ed79a" facs="#m-7380add9-55c3-4697-b418-9022dd7979d6" label="lyrics-like">sanctíssimae Virginis Mariae Nó-]aetérna pervenire mereántur in</l><l xml:id="m-acaf7352-2815-483a-bedd-61d5faa82eef" facs="#m-16df201c-8561-4bc7-9d48-87225729a8c1" label="lyrics-like">mine et protectióne laetántur; ejus! caelis. Per Dóminum nostrum.</l><l xml:id="m-98fc9429-c50a-41fc-808d-2edf180f0d8c" facs="#m-5ae15500-d8d9-4628-9b0c-5c5a33e8b14f" label="ambiguous">Epistle. Ego quasi vitis. D. 1684.</l><l xml:id="m-f8289147-3dca-41b9-b5a7-cf8c57a97f40" facs="#m-cf138315-a167-4323-abdc-206038e3077a" label="lyrics-like">Gradual. Benedicta et venerábilis. p. 1264. Alleluia, allelúia. V. Post</l><l xml:id="m-07414aab-f4c6-490c-ab17-83c17ea7ea7f" facs="#m-70ddd705-a801-42a4-9eb7-69655d94320c" label="lyrics-like">pártum. D. 1265.</l><l xml:id="m-7c1d5278-2abe-41a2-b045-ce6617d14478" facs="#m-a4287812-24a0-4bb8-928d-4d51ee2bba4d" label="ambiguous">Credo.</l><l xml:id="m-251800ff-fea4-443c-ae2f-2d13ae2b07e9" facs="#m-751cd444-3c82-4218-9e13-ac1cd2d0ab8a" label="ambiguous">Gospel. Missus est. p. 1270.</l><l xml:id="m-8b348430-fc52-4721-80ac-64da230b1a41" facs="#m-e7f7f531-f994-4723-9223-354c58079b19" label="ambiguous">offertory. Ave Maria. D. 1268.</l></lg></div></section></score></mdiv></body></music>
</mei>