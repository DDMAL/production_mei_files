      <graphic xml:id="m-94d8f3c6-6aaa-406a-82ae-140ce29f200f" target="2065_original_image.tiff" /><zone xml:id="m-f3bed41d-16ca-4f1e-b8ce-30dc50397fe9" ulx="854" uly="74" lrx="923" lry="114" /><zone xml:id="m-37aca6ea-81eb-474c-bc25-738f5d45dd45" ulx="317" uly="78" lrx="629" lry="115" /><zone xml:id="m-62cce036-7698-4f0f-8ff9-bcc56614af37" ulx="373" uly="139" lrx="576" lry="172" /><zone xml:id="m-10c5bcc2-4d84-409c-9745-37c55b325414" ulx="47" uly="170" lrx="924" lry="209" /><zone xml:id="m-c84e6b96-dcca-4483-af0b-6f0bbabc78d9" ulx="25" uly="197" lrx="922" lry="236" /><zone xml:id="m-592481e0-1826-4eac-9c6a-0117d98916e6" ulx="25" uly="227" lrx="913" lry="261" /><zone xml:id="m-cbff93cc-7021-41ec-b04e-aaf01161cc40" ulx="48" uly="265" lrx="924" lry="300" /><zone xml:id="m-922021ec-922c-4f39-aed2-15ef71a360d8" ulx="22" uly="294" lrx="925" lry="330" /><zone xml:id="m-9bae4b83-e9fa-41d8-bc2b-12b0d41205d8" ulx="23" uly="323" lrx="924" lry="355" /><zone xml:id="m-c3b677f3-ff14-42cf-bcbd-f3b65ef8ef6e" ulx="24" uly="345" lrx="658" lry="380" /><zone xml:id="m-63629a3c-2d93-459c-a91f-5b5cfc8bb665" ulx="51" uly="377" lrx="923" lry="412" /><zone xml:id="m-68ec4a9c-05bf-4d9b-812e-37fa551d6c47" ulx="23" uly="403" lrx="242" lry="440" /><zone xml:id="m-c9e43d51-d12c-4e54-8190-9ddf6443f1a6" ulx="321" uly="440" lrx="631" lry="476" /><zone xml:id="m-85f69863-bd92-4514-901b-0e57fd860bca" ulx="425" uly="480" lrx="528" lry="515" /><zone xml:id="m-153e1d0a-b506-4e87-a728-3348fed66824" ulx="42" uly="511" lrx="926" lry="552" /><zone xml:id="m-8bb60665-2879-47d1-9f40-714f58757521" ulx="29" uly="544" lrx="924" lry="582" /><zone xml:id="m-aa8d4056-43d3-404f-8814-065f0fa3344a" ulx="29" uly="576" lrx="920" lry="609" /><zone xml:id="m-49e8850d-5d39-4c8f-bccf-f197085212d2" ulx="25" uly="602" lrx="673" lry="635" /><zone xml:id="m-0f0add11-20bf-43b3-bbc9-efb2daae8528" ulx="426" uly="640" lrx="517" lry="682" /><zone xml:id="m-581807ba-63eb-4aae-b4b7-c76ab984874b" ulx="35" uly="672" lrx="925" lry="713" /><zone xml:id="m-49f39ea8-4031-40bb-a331-ea43af0bbe0d" ulx="29" uly="705" lrx="729" lry="742" /><zone xml:id="m-a62beca1-052a-4f0d-85e5-10481f6faa4e" ulx="26" uly="732" lrx="479" lry="772" /><zone xml:id="m-2cfc80ef-0209-4b4a-9484-c8543fbdc07e" ulx="376" uly="775" lrx="581" lry="810" /><zone xml:id="m-aabdc86f-e8f6-4571-ae5c-0d3b74b7e8dc" ulx="34" uly="800" lrx="926" lry="842" /><zone xml:id="m-5601f11a-7b71-4f7f-93b1-461bd453fabc" ulx="27" uly="833" lrx="925" lry="872" /><zone xml:id="m-2a14e97d-4797-4932-aded-accecd08337e" ulx="29" uly="862" lrx="622" lry="900" /><zone xml:id="m-9b6ced61-62fb-43e4-a0fe-fc9cc1de4a38" ulx="300" uly="914" lrx="659" lry="946" /><zone xml:id="m-9c18748d-c3e1-4dfb-b7ae-fc7767c6e3ea" ulx="425" uly="951" lrx="528" lry="996" /><zone xml:id="m-e11a973c-049f-460a-8cd2-3995439c9ee4" ulx="71" uly="992" lrx="927" lry="1030" /><zone xml:id="m-acec1bd4-cc05-43a7-96dc-4914d15d84d8" ulx="30" uly="1018" lrx="839" lry="1060" /><zone xml:id="m-6628c070-f968-4a52-a5d3-4a9cf00e80cf" ulx="27" uly="1048" lrx="477" lry="1086" /><zone xml:id="m-a7dc286e-3030-446b-b69a-3e20a0b1e909" ulx="431" uly="1089" lrx="519" lry="1125" /><zone xml:id="m-e3229b87-c36d-4afb-92e7-74ac2dd2006f" ulx="39" uly="1121" lrx="926" lry="1161" /><zone xml:id="m-66e46ca8-3c63-4f2b-9ef2-54be00a21fa2" ulx="33" uly="1152" lrx="923" lry="1190" /><zone xml:id="m-434be164-b4ba-4ac8-bc4d-c2012443f8b6" ulx="31" uly="1185" lrx="882" lry="1219" /><zone xml:id="m-059553dc-4e76-43be-bdd5-b73dcdae57ed" ulx="28" uly="1209" lrx="482" lry="1244" /><zone xml:id="m-bbee7a16-816b-403a-8760-7547e356e9fe" ulx="378" uly="1250" lrx="583" lry="1289" /><zone xml:id="m-8859fad0-9733-4a5d-b88c-cf5a9ee3119b" ulx="49" uly="1282" lrx="927" lry="1326" /><zone xml:id="m-2b18d181-d1db-4000-ba87-759ed3350c4f" ulx="30" uly="1314" lrx="860" lry="1353" /><zone xml:id="m-594683fa-7ea9-49a3-a8f8-edb25a49f6ce" ulx="30" uly="1345" lrx="477" lry="1384" /><zone xml:id="m-429b22b0-3013-4dfc-a12d-ba63c81d1b4c" ulx="183" uly="1394" lrx="773" lry="1437" /><zone xml:id="m-7f871f22-1007-4a07-8ade-878d36e63a35" ulx="426" uly="1440" lrx="528" lry="1477" /><zone xml:id="m-37044e6b-105c-4d95-a052-3fafcc42692e" ulx="71" uly="1471" lrx="929" lry="1511" /><zone xml:id="m-2869221a-afd7-4522-87a1-14e8606ad9e8" ulx="32" uly="1506" lrx="930" lry="1543" /><zone xml:id="m-0b235099-97c1-4559-955e-4ada9568f6b6" ulx="30" uly="1533" lrx="928" lry="1571" /><zone xml:id="m-e03c06ec-b0ca-414b-9d20-3ee1977709da" ulx="31" uly="1559" lrx="665" lry="1597" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-1c5c2474-353c-422d-b7a1-764930a776c0" n="2065" facs="#m-d7c39ff8-d067-4cc9-8122-9176b7b01606" /><div xml:id="m-4478ff2c-b2ed-4b25-bcb9-590a9b7836f2">
            <lg xml:id="m-c8add378-7e95-44df-bb4b-e5ab884cc22c">
              <l xml:id="m-2e017c2d-3a92-4e11-981d-abe963715028" facs="#m-f3bed41d-16ca-4f1e-b8ce-30dc50397fe9" label="ambiguous">isie</l><l xml:id="m-6f6bdab1-22f6-4a01-a904-2553fd17d356" facs="#m-37aca6ea-81eb-474c-bc25-738f5d45dd45" label="text-like">Masses for the Dead.</l><l xml:id="m-20d1a69e-94db-45fc-921d-28e402b307a6" facs="#m-62cce036-7698-4f0f-8ff9-bcc56614af37" label="ambiguous">Postcommunion.</l><l xml:id="m-4ea9034a-ac01-4740-9513-09a5a17226f5" facs="#m-10c5bcc2-4d84-409c-9745-37c55b325414" label="lyrics-like">DRosit, quaésumus Dómine, áni-l méntia : ut ejus, in quo sperávit et</l><l xml:id="m-cc8d75d7-ceef-4e7a-a995-d22d824062ed" facs="#m-c84e6b96-dcca-4483-af0b-6f0bbabc78d9" label="lyrics-like">E mae fámuli tui N. Sacerdótis crédidit, aetérnum cápiat, te mise¬</l><l xml:id="m-18ca672e-7f6a-4d2a-9d18-6c3b7bf92744" facs="#m-592481e0-1826-4eac-9c6a-0117d98916e6" label="lyrics-like">misericórdiae tuae imploráta cle-ránte, consórtium. Per Dóminum.</l><l xml:id="m-fbb66923-46cf-4aa7-ac62-27082d9301fd" facs="#m-cbff93cc-7021-41ec-b04e-aaf01161cc40" label="lyrics-like">For a Bishop the same Prayers are said, the words sacerdotáli. Sacerdótis.</l><l xml:id="m-4fccf4d9-45d2-43eb-a896-81034cecb2b8" facs="#m-922021ec-922c-4f39-aed2-15ef71a360d8" label="lyrics-like">and sacerdotále being replaced by pontificáli. Pontificis. and pontificále</l><l xml:id="m-c38ee50b-b9a7-43fd-b2eb-25d81ac181b7" facs="#m-9bae4b83-e9fa-41d8-bc2b-12b0d41205d8" label="text-like">respectively. For a Cardinal, after the name of the deceased, mention is</l><l xml:id="m-81e8d440-e487-4e86-81d7-d5f682998af6" facs="#m-c3b677f3-ff14-42cf-bcbd-f3b65ef8ef6e" label="text-like">made of his dignity as indicated on p. 1821 or p. 1822.</l><l xml:id="m-9b53aac3-0d3b-4712-8b9e-c669b5f21662" facs="#m-63629a3c-2d93-459c-a91f-5b5cfc8bb665" label="text-like">For two or more deceased, the Prayers are said as in the Daily Mass for</l><l xml:id="m-de003a0f-4694-40af-b36d-242531e2129c" facs="#m-68ec4a9c-05bf-4d9b-812e-37fa551d6c47" label="text-like">the Dead, p. 1817.</l><l xml:id="m-116d5ccd-89de-4e13-b121-36d18c1bddcc" facs="#m-c9e43d51-d12c-4e54-8190-9ddf6443f1a6" label="text-like">For a Man deceased.</l><l xml:id="m-83ba2568-2857-47b1-981d-02dff64542d0" facs="#m-85f69863-bd92-4514-901b-0e57fd860bca" label="ambiguous">Collect.</l><l xml:id="m-c40d19a5-26e7-4878-a917-b8db9d91249f" facs="#m-153e1d0a-b506-4e87-a728-3348fed66824" label="lyrics-like">TNclína Dómine aurem tuam ad saéculo migráre jussísti, in pacis ac</l><l xml:id="m-a6ba92ff-911f-410b-820b-49a2c2b3c630" facs="#m-8bb60665-2879-47d1-9f40-714f58757521" label="lyrics-like">L preces nostras, quibus misericór- lucis regióne constítuas; et Sanctó¬</l><l xml:id="m-0640e5ea-23b6-4873-a8e3-9ddaa966abfb" facs="#m-aa8d4056-43d3-404f-8814-065f0fa3344a" label="lyrics-like">diam tuam súpplices deprecámur:ut! rum tuórum júbeas esse consórtem.</l><l xml:id="m-d863d415-6638-4a71-8887-9467b4a83b8f" facs="#m-49e8850d-5d39-4c8f-bccf-f197085212d2" label="lyrics-like">ánimam fámuli tui N., quam de hoc! Per Dóminum.</l><l xml:id="m-34e4e526-b61e-47f1-bb05-8c5620cc21ee" facs="#m-0f0add11-20bf-43b3-bbc9-efb2daae8528" label="ambiguous">Secret.</l><l xml:id="m-75e053e0-31d3-4b00-9dd6-2456959c365b" facs="#m-581807ba-63eb-4aae-b4b7-c76ab984874b" label="lyrics-like">INnue nobis, quaésumus Dómine, l totius mundi tribuísti relaxári deli¬</l><l xml:id="m-9178c9de-1d7d-4a90-ad0b-623f69b897cf" facs="#m-49f39ea8-4031-40bb-a331-ea43af0bbe0d" label="lyrics-like">H ut ánimae fámuli tui N. haecl cta. Per Dóminum.</l><l xml:id="m-42dae0be-81f8-49a2-8bb0-4df2436fbd83" facs="#m-a62beca1-052a-4f0d-85e5-10481f6faa4e" label="lyrics-like">prosit oblátio: quam immolándo</l><l xml:id="m-a15916d6-8b50-4300-9ad5-5dcf1d3768cb" facs="#m-2cfc80ef-0209-4b4a-9484-c8543fbdc07e" label="ambiguous">Postcommunion.</l><l xml:id="m-88036d96-8872-42fa-a41b-941eb37bf44c" facs="#m-aabdc86f-e8f6-4571-ae5c-0d3b74b7e8dc" label="lyrics-like">H Bsólve, quaésumus Dómine, áni-[ ctiónis glória inter Sanctos et elé¬</l><l xml:id="m-f3eaa713-0c3c-419f-8689-9cf82519528d" facs="#m-5601f11a-7b71-4f7f-93b1-461bd453fabc" label="lyrics-like">A mam fámuli tui N. ab omni ctos tuos resuscitátus respiret. Per</l><l xml:id="m-393682dd-3c62-464a-a9a1-587b0b3c6619" facs="#m-2a14e97d-4797-4932-aded-accecd08337e" label="lyrics-like">vínculo delictórum : ut in resurre- Dóminum.</l><l xml:id="m-221c9ae0-6c84-404c-a89d-82eedd294c62" facs="#m-9b6ced61-62fb-43e4-a0fe-fc9cc1de4a38" label="text-like">For a Woman deceased.</l><l xml:id="m-f02f5454-3b0e-4917-a0d0-2d81d325cdac" facs="#m-9c18748d-c3e1-4dfb-b7ae-fc7767c6e3ea" label="ambiguous">Collect.</l><l xml:id="m-4b0491bf-60f9-4ba0-8b45-42ed015e2df1" facs="#m-e11a973c-049f-460a-8cd2-3995439c9ee4" label="lyrics-like">Uaésumus Dómine, pro tua pie- exútam, in aetérnae salvatiónis par¬</l><l xml:id="m-af635671-5d48-4928-b501-012189ecc1b9" facs="#m-acec1bd4-cc05-43a7-96dc-4914d15d84d8" label="lyrics-like">U tá̂te miserére ánimae fámulae tem restitue. Per Dóminum.</l><l xml:id="m-d2062cee-bf2e-4297-8302-1b026023850e" facs="#m-6628c070-f968-4a52-a5d3-4a9cf00e80cf" label="lyrics-like">tuae N. : et a contágiis mortalitátis</l><l xml:id="m-652398a5-6511-4503-9458-fe2cc9990411" facs="#m-a7dc286e-3030-446b-b69a-3e20a0b1e909" label="ambiguous">Secret.</l><l xml:id="m-b2a44a8a-bf06-4d9f-93bb-14646e751cd3" facs="#m-e3229b87-c36d-4afb-92e7-74ac2dd2006f" label="lyrics-like">LIS sacrificiis, quaésumus Dómi-[per haec piae placatiónis officia,</l><l xml:id="m-9f367fa8-7137-409a-885c-4ab274882ba5" facs="#m-66e46ca8-3c63-4f2b-9ef2-54be00a21fa2" label="lyrics-like">Et ne, ánima fámulae tuae N. al perpétuam misericórdiam conse¬</l><l xml:id="m-eda752bd-ba81-4ec0-80bc-954c1849dadb" facs="#m-434be164-b4ba-4ac8-bc4d-c2012443f8b6" label="lyrics-like">peccátis ómnibus exuátur, sine qui- quátur. Per Dóminum nostrum.</l><l xml:id="m-59342a13-af47-461b-bdf4-ebdaf66180a5" facs="#m-059553dc-4e76-43be-bdd5-b73dcdae57ed" label="lyrics-like">bus a culpa nemo liber éxstitit : ut</l><l xml:id="m-16e29d62-01ec-4ac1-80c4-fc7c5f878e1d" facs="#m-bbee7a16-816b-403a-8760-7547e356e9fe" label="ambiguous">Postcommunion.</l><l xml:id="m-a63c3f31-26f6-4c45-863d-e09349bfc67e" facs="#m-8859fad0-9733-4a5d-b88c-cf5a9ee3119b" label="lyrics-like">TNvéniat, quaésumus Dómine, tuae misericórdiae consecúta est</l><l xml:id="m-f820a8ae-e52b-4af4-9acb-f2fe94b2c108" facs="#m-2b18d181-d1db-4000-ba87-759ed3350c4f" label="lyrics-like">L ánima fámulae tuae N. lucis sacraméntum. Per Dóminum.</l><l xml:id="m-1acc1102-6841-4de5-a20f-c693b94d49b5" facs="#m-594683fa-7ea9-49a3-a8f8-edb25a49f6ce" label="lyrics-like">aetérnae consórtium : cujus perpé¬</l><l xml:id="m-6664e7eb-8c55-4b02-a49b-08ca84c96501" facs="#m-429b22b0-3013-4dfc-a12d-ba63c81d1b4c" label="text-like">For all who are buried in the cemetery.</l><l xml:id="m-c3ae4907-464c-4229-9197-5521b79a358d" facs="#m-7f871f22-1007-4a07-8ade-878d36e63a35" label="ambiguous">Cottect.</l><l xml:id="m-fe400d06-cc62-49ce-abd9-51c0fec8ddca" facs="#m-37044e6b-105c-4d95-a052-3fafcc42692e" label="lyrics-like">Eus, cujus miseratióne ánimae propítius véniam peccatórum; ut a</l><l xml:id="m-36aa86cb-fd25-4d88-9e0f-ace291940191" facs="#m-2869221a-afd7-4522-87a1-14e8606ad9e8" label="lyrics-like">I fidélium requiéscunt : fámulis cunctis reátibus absolúti, tecum sine</l><l xml:id="m-a4e1d10a-d551-4e5c-bb86-92ef6abc9a92" facs="#m-0b235099-97c1-4559-955e-4ada9568f6b6" label="lyrics-like">et famulábus tuis, et ómnibus hic et fine laeténtur. Per eúmdem Dómi¬</l><l xml:id="m-dda38aa9-01d7-42f8-9ff7-0914980a98a3" facs="#m-e03c06ec-b0ca-414b-9d20-3ee1977709da" label="lyrics-like">ubique in Christo quiescéntibus, da l num nostrum.</l></lg></div></section></score></mdiv></body></music>
</mei>