        <section>
          <pb xml:id="m-fe282150-e013-4efe-86cd-a382142abea1" n="2224" facs="#m-17494742-4300-43f1-8812-f71c3deedbad" /><div xml:id="m-0e733f63-9d6d-49fd-9b9f-0989f988c543">
            <lg xml:id="m-71c9644e-9edb-4dc3-948e-3c9e32e2531a">
              <l xml:id="m-c37292b2-12ff-4609-9524-6da5050c24a8" facs="#m-acf7fe64-135c-4523-8193-93bbfdafa140" label="ambiguous">100*</l><l xml:id="m-b1bf7ed9-10a5-4e23-961f-93dfb7e27e72" facs="#m-ffa572a1-87be-4c6f-b42b-adeb10fcd26b" label="text-like">Alphabetical Table of Feasts</l><l xml:id="m-10dbd315-3ed3-4597-94ee-db24b1ace070" facs="#m-46e610df-c909-4156-8df4-6f0abf73f6c1" label="text-like">Secunda and Rufina, Virgins, MM. 1553 Thomas of Canterbury, Bish. M. 37</l><l xml:id="m-da5d82ce-d851-4e67-8314-5fa6040308e3" facs="#m-2239c4cf-271e-48f0-b675-d7b092004159" label="text-like">Sennen and Abdon, MM. 1573</l><l xml:id="m-81d42aa6-3314-441a-be0b-78de54d5c8ac" facs="#m-2d4482d3-94e2-453d-8254-5417803f2c63" label="text-like">Thomas of Villanova, Bish. Conf.4</l><l xml:id="m-e87c7fb8-85d7-415b-b5ef-077c24ab4a4c" facs="#m-574f6c5e-de02-4ff0-8768-9d8591648b91" label="text-like">Tiburtius and Susanna, MM. </l><l xml:id="m-b6edf6b0-c8ea-4eb7-a9f3-f0d945cfaff3" facs="#m-a38bce63-a836-4045-8436-aaa33784208e" label="text-like">Seven Dolours of the B. V. M.</l><l xml:id="m-1b7fad3f-fd80-4267-8465-1eb9b4c6a5e6" facs="#m-f9f7e8ff-ec58-471c-9281-27d7bcc411db" label="text-like">Tuburtius and his companions,</l><l xml:id="m-4f1f086f-de95-479b-ae5b-3881c8b51cec" facs="#m-533eecc2-9235-43ce-8b3b-71f29c162487" label="ambiguous">(Passion Week).  1422</l><l xml:id="m-798f5215-4903-4d78-a920-1adccf42ab52" facs="#m-40eccb9c-fd58-4cf3-abeb-02e1048716e8" label="ambiguous">MM. (April 14) 1427</l><l xml:id="m-62d014a2-8dda-41eb-a706-7b04e80bc635" facs="#m-91b9bba6-38f4-430b-ba19-a1d7550e187f" label="text-like">Seven Dolours of the B. V. M.</l><l xml:id="m-e09afd7a-8318-4963-a233-e74cf47704e0" facs="#m-941d0bba-5a2e-4f4e-924c-21bcaf43a7ef" label="ambiguous">Timothy, Bish. M.. 1342</l><l xml:id="m-923605db-8396-4f46-85ee-48a3c8a61687" facs="#m-436e4ce4-e62d-4ab0-af78-5f4ee7520d8c" label="ambiguous">(Sept. 15) 1631</l><l xml:id="m-f63e1d4e-a85a-4fc8-b31c-515445c3d389" facs="#m-56bc2cd3-3775-4f66-b2ba-fdce7992a33a" label="ambiguous">Seven Hoty Brothers, MM. </l><l xml:id="m-18818ef3-26cf-4238-a192-1c611bfb3e58" facs="#m-c4f6045f-f36f-401f-b539-6573b58e3cbc" label="text-like">Timothy and his companions, MM. 1612</l><l xml:id="m-d59c0d69-abc1-4c62-837e-4511e4103d3b" facs="#m-f06c1c5c-b9e1-42c6-95f4-41bb1731d42e" label="text-like">Seven Holy Founders of the</l><l xml:id="m-2c628f35-809a-47f6-b470-a3cddb667e88" facs="#m-8cf9dd0e-5ad2-4cd7-9baa-90773c6636bf" label="ambiguous">Titus, Bish. Conf. 1373</l><l xml:id="m-7e79c885-f039-4861-a4ec-62356eb470bd" facs="#m-8e4cb7a1-815d-48cf-b6d0-ce4b057a9ee6" label="ambiguous">Servites, Conf.  1384</l><l xml:id="m-30f4092f-06ab-47de-a937-cfa2cf087603" facs="#m-910cf2a5-b650-4835-a5ec-36f973643cb5" label="text-like">Transfiguration of Our Lord J. C. 1584</l><l xml:id="m-32e9fe4b-9741-4196-9ec2-f1ef19ba1fc8" facs="#m-3b6ec629-d55b-4a88-888b-23f6d0432f72" label="ambiguous">Silverius, Pope, M. 1493</l><l xml:id="m-5cb189a0-eac8-420b-b8d8-af7e7e2d8648" facs="#m-36a5f213-409f-4569-80ba-c870a314440b" label="ambiguous">Trinity, Blessed. 907</l><l xml:id="m-ab1486dc-912a-4273-8b89-856b6122d360" facs="#m-4b127e7d-54e2-4be8-adab-e0ea39fb4831" label="text-like">Tryphon and his companions, MM. 1746</l><l xml:id="m-548ce587-6266-40fa-96e7-e19a75b96173" facs="#m-d9dc3071-ba6f-4586-b419-fad02bf2e90f" label="ambiguous">439</l><l xml:id="m-7987f52f-0a33-4d7c-a4d2-285497769677" facs="#m-561fd5cc-a30f-4340-827b-7378954b6b7f" label="ambiguous">Silvester I, Pope, Contf.</l><l xml:id="m-aad280b7-1a2c-4877-9ae0-13a4b2d38e7f" facs="#m-88ccd3ab-025c-48e9-8af7-d49a3dbf5a2a" label="ambiguous">Sylvester, Abbot. 1762</l><l xml:id="m-a28870f2-dec5-4653-97bd-8c2442bc07f8" facs="#m-8a6fa7e4-ecc2-43bf-bc78-e41b901cdf7d" label="ambiguous">Twelve Brothers, Martyrs 2</l><l xml:id="m-5f0d24ff-c583-4794-8dae-ab382f124d10" facs="#m-b7d84ff8-768a-4371-be39-daebe027291c" label="ambiguous">Simeon, Bish. M. 1300</l><l xml:id="m-5e89e725-e481-4494-9992-eec121bb