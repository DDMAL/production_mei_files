                  <nc xml:id="m-f20e5416-504e-46b7-930d-e893acd60407" pname="d" oct="3" /></neume></syllable><syllable xml:id="m-e81be395-ee76-4947-90cf-b1ab15596a14">
                <syl /><neume facs="#m-7e4996cd-cedf-4cc0-92b5-06c3d5c23b8f" type="punctum" xml:id="m-aa399843-631c-49a3-a255-aff4098a907c">
                  <nc xml:id="m-b844b5cd-8afa-4a04-a95f-8ab181852419" pname="c" oct="3">
                    <signifLet xml:id="m-9e393948-cd6d-426d-82a7-90457b3c96f2" /></nc></neume></syllable><divLine xml:id="m-727778df-2bc0-4d76-80fb-a535d17df55d" facs="#m-5409c44f-ccca-48e8-893a-404d2fc71afb" form="maior" /><custos xml:id="m-f64ce1dc-6676-429e-a1d0-63e0ecc64367" facs="#m-d5924226-9bbe-4d8b-ad30-f4eb348871a1" pname="g" oct="3" /><sb xml:id="m-7a78ca1b-0284-47f5-9aa3-5fa33dd7b68f" n="2" facs="#m-bd499dcd-a8b0-4b7a-be50-7b19e729084c" /><clef xml:id="m-c7c80f2d-3172-48ae-8ca3-e549dac05f01" facs="#m-c7316fce-43f2-4cde-9dae-587932008299" line="4" shape="C" /><syllable xml:id="m-cfd00110-7400-48bb-820b-fc7d8b959bc7">
                <syl /><neume facs="#m-574e6d50-fe0d-4672-8a72-a18eff66771b" type="punctum" xml:id="m-5eb18378-b44b-4427-a120-818df3e57626">
                  <nc xml:id="m-3b8d15b9-2b24-405e-9793-9a8a20219f67" pname="g" oct="3" /></neume></syllable><syllable xml:id="m-53f4f828-6d20-4e74-bd86-88b97cbec394">
                <syl /><neume facs="#m-e86f3894-c92d-4582-9752-3df314c86631" type="punctum" xml:id="m-e9fdde7c-0e65-4e04-ac96-860e9ab677b4">
                  <nc xml:id="m-19dfbbb1-e252-4a84-bdcd-f0ed3adcf5bc" pname="f" oct="3" /></neume></syllable><syllable xml:id="m-5d268704-0121-4d5a-affc-1944dd2fd27e">
                <syl /><neume facs="#m-fab18805-6799-40e6-895d-60865893e4f5" type="punctum" xml:id="m-fc464e8b-c05a-4a83-9bda-543caabcb76e">
                  <nc xml:id="m-4e4300ae-0c8d-46fe-bde8-03978f24471c" pname="g" oct="3"><episema xml:id="m-487bbb8a-437b-4785-a749-6ce91e8b85a7" form="v" /></nc></neume></syllable><syllable xml:id="m-c3346d6b-407f-4558-b620-b7c7e2b31a46">
                <syl /><neume facs="#m-3987fd4d-1f77-4767-a147-56bbaa14ede6" type="punctum" xml:id="m-572a01ad-58b5-4258-bd91-6e0348db4bf0">
                  <nc xml:id="m-e4a17680-b608-454d-ad1b-d29bf9e4d465" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-3d9e14b8-0ce8-4677-97f5-f93df8465802">
                <syl /><neume facs="#m-c5b4bf2f-5953-46e5-9d40-9e8b88496cbf" type="punctum" xml:id="m-04d9624e-87c2-4473-8222-659e904997b8">
                  <nc xml:id="m-3a4a6bca-b989-4b6e-9af3-25d54eb2ed57" pname="g" oct="3" /></neume></syllable><syllable xml:id="m-739a88cb-15ba-4821-ae69-64939e7c86f8">
                <syl /><neume facs="#m-0991bc3f-2d8b-48db-aa18-851368faab59" type="punctum" xml:id="m-e7a36ff4-96c6-47b3-b914-2f5d90a6e6bf">
                  <nc xml:id="m-db76e450-2643-49f2-b004-4767114e0aa6" pname="f" oct="3" /></neume></syllable><syllable xml:id="m-6f796376-9ce8-4fa9-8e8b-1e1cf9d08e10">
                <syl /><neume facs="#m-8d515045-bc04-4c2f-992d-4bcc3608ad82" type="punctum" xml:id="m-ad6be315-ebed-42ad-8679-b67c618286f8">
                  <nc xml:id="m-017611e2-ebc5-41f9-806d-fe88b809a181" pname="f" oct="3">
                    <signifLet xml:id="m-7f8a7a33-8996-4946-b431-a7ca956a07b4" /></nc></neume></syllable><divLine xml:id="m-fc5880a7-a4da-4e94-8a1f-eb44388554d0" facs="#m-b76733b1-8168-4bf5-91ff-6a7d11bc184b" form="finalis" /></layer></staff><div xml:id="m-54b3cf44-1881-4ba0-9d32-0ed1ab2b304f"><lg xml:id="m-bf1180fa-6f24-499a-8dfe-17feeda7a64c"><l xml:id="m-803fabef-ea4a-43bc-b934-eb80baa04d1d" facs="#m-f0e2a1d3-fbfb-4778-92ba-aa79000d367c" label="ambiguous">1874</l><l xml:id="m-12400aaa-6c08-476e-951e-880ef70c0f63" facs="#m-56595b4d-72db-4a62-b0fd-df2ef89652f3" label="ambiguous">Durin</l><l xml:id="m-ffd880dd-9e30-4dec-8aca-abf4c816a4dd" facs="#m-b6a51aff-dc41-44fa-892c-3d827d3a0f5a" label="ambiguous">Lent.</l><l xml:id="m-aa6a5fcb-ac38-4e0f-a6b1-96eee6c4b53e" facs="#m-7c7a9b33-8f2a-4847-b60b-40b164d6cf82" label="text-like">Hymn of the Compa</l><l xml:id="m-78265990-1e13-423d-8946-cef3164ff23d" facs="#m-b8aed51b-d567-4017-8477-29f0c20d6e7f" label="text-like">assion of the B. V. M.</l><l xml:id="m-7cb65d76-6ab8-4141-880c-566940ad516e" facs="#m-f5fb3215-0dd7-4a09-9a27-148b75e51bd0" label="ambiguous">6.</l><l xml:id="m-d7f1f8e7-2f00-4da1-9656-b3012bf85ee2" facs="#m-37aab390-f17d-4ee6-a333-472e5853e1f3" label="lyrics-like">Tábat Máter do-lo-rósa</l><l xml:id="m-778d1472-d574-4e5e-ab94-991a0b51e990" facs="#m-d29e0316-8920-4c2f-a0fd-e97947babbbb" label="lyrics-like">Juxta crúcem lacrimósa,</l><l xml:id="m-7c80eee2-9a09-47b9-b9f7-ea0388034fc5" facs="#m-ec544f8e-dcf6-4849-9006-1cc7bb62eda4" label="lyrics-like">Dum pendébat Fí-li-us.</l><l xml:id="m-56998894-ad39-457a-9640-3a9567ea17d4" facs="#m-02830e01-0432-4341-87b9-0df35d1b4b25" label="lyrics-like">2. Cújus ánimam geméntem,</l><l xml:id="m-53ba23b0-9cb2-4dc7-ba39-85f1f768d4a0" facs="#m-de3ab996-820c-449d-b0ca-8ff269c10391" label="lyrics-like">11. Sáncta Máter, istud ágas,</l><l xml:id="m-7f9aec7d-6dbc-4d16-8a6a-e2b82a6b310d" facs="#m-4e8692e2-df9d-4daf-b315-defaf3f8490b" label="lyrics-like">Crucifixi fige plágas</l><l xml:id="m-b0ff8b14-cf42-4c10-a1ca-70f48f1ebda4" facs="#m-3ba97ce0-593f-4c7d-b03d-dd6f6ffbd4ec" label="lyrics-like">Contristátam et doléntem</l><l xml:id="m-91190e6f-6a22-49fd-a74c-31c52a4db61c" facs="#m-4df2b9f5-31ae-4860-b029-3c110d1c1273" label="lyrics-like">Pertransivit gládius.</l><l xml:id="m-4f8c8995-c9d4-4fa6-aee8-be34130df1ef" facs="#m-6e729acb-9488-435d-a90b-9a24e0cbc43a" label="lyrics-like">Córdi méo váside.</l><l xml:id="m-b4c85af9-0b65-424b-9933-49d54bf6caa7" facs="#m-336c2e59-3dfb-4928-9fd1-5f6dced8beca" label="lyrics-like">12. Tui náti vulneráti,</l><l xml:id="m-55f2b2d1-5ed7-4342-aea2-f8b3409b6d71" facs="#m-527905c2-3c53-4e9c-ab5e-3fa105fbbad8" label="ambiguous">3. O quam tristis et afflicta</l><l xml:id="m-5f98204c-05b5-47ef-b0a4-04f9868adc01" facs="#m-d9910a6e-db12-4516-b0d3-7ded6002e6f9" label="ambiguous">Fuit illa benedicta</l><l xml:id="m-cd11f9d8-5922-4210-9629-f2f45c4f1f43" facs="#m-050ac04d-acec-48e8-8e9a-1db86304efd9" label="lyrics-like">Tam dignáti pro me páti,</l><l xml:id="m-ae6e70c1-fb4b-424b-a0e7-c9d06f397991" facs="#m-ca5829c5-2d55-454b-8bf8-21911b6ad4c8" label="lyrics-like">Máter unigéniti!</l><l xml:id="m-996697a0-1f74-4392-bbd4-118948f384a2" facs="#m-ec44cb5b-0d44-454d-b819-b32e5ed9db54" label="lyrics-like">Poénas mécum divide.</l><l xml:id="m-3d979dbd-3153-41b8-b0cd-76f8f4a3178d" facs="#m-4cd1c0b5-b2ff-4d9a-abba-ef7170344afc" label="lyrics-like">4. Quae maerébat et dolébat,</l><l xml:id="m-6ac62483-f972-4b99-b2bb-692fffc1d8b2" facs="#m-476b6047-cbb1-4229-abeb-04263f30dbbb" label="lyrics-like">13. Fac me técum pie flére,</l><l xml:id="m-d9c9ef15-f927-46b4-b696-71bd45167659" facs="#m-a38a9569-3cc2-4dc7-b692-2199ed491acb" label="lyrics-like">Pla Mâter, dum vidébat</l><l xml:id="m-9ef5467b-c101-432d-a0f2-ee43a872f9dc" facs="#m-9c8b88e7-fabf-4eda-ae04-11252daa8bd4" label="lyrics-like">Crucifixo condolére,</l><l xml:id="m-dbe643e4-d7e1-419f-8b59-0297a80f972f" facs="#m-9af4b424-4362-43b4-afce-0a9589a22692" label="lyrics-like">Donec égo vixero.</l><l xml:id="m-73ed6a01-00ad-49da-a7b3-87901483a46e" facs="#m-4dd41ed2-9c07-4b26-8114-5fcd81392fc5" label="lyrics-like">Náti poénas inclyti.</l><l xml:id="m-59867818-327b-401b-9f57-3ee6f08245e3" facs="#m-63665f9d-d8d3-43a9-b4b6-289c3f2fe28a" label="lyrics-like">14. Juxta crúcem técum stáre,</l><l xml:id="m-d2d548f4-db67-4284-9a8e-d940ae5054c3" facs="#m-1af2ee83-1b18-4854-b606-d66511dc58ee" label="lyrics-like">5. Quis est hómo qui non fléret,</l><l xml:id="m-b420a7df-1af8-493d-8715-ff63ca433e77" facs="#m-59a98ca6-5651-4b8c-ac08-a5c67daf016a" label="lyrics-like">Mâtrem Christi si vidéret</l><l xml:id="m-a496cbf4-087f-40a3-8095-dd60b26a10e0" facs="#m-90855a9b-ba8a-4469-98b0-af16ff94698e" label="lyrics-like">Et me tibi sociáre</l><l xml:id="m-d651f15b-f74a-461e-8eb7-f318f8019fe9" facs="#m-805f0e45-8f87-46a2-b950-2aa1d107513e" label="lyrics-like">In plánctu desídero.</l><l xml:id="m-2c9aa1ec-c9ef-44a2-8f73-f7350b3b2981" facs="#m-23b5389d-3251-4dd1-b6e1-4b8a0064d717" label="lyrics-like">In tánto supplício?</l><l xml:id="m-04faaf13-f4d1-43e5-b41b-73c5e5ad4308" facs="#m-004604d5-f76f-45a5-9f75-8a96dc9748be" label="lyrics-like">6. Quis non pósset contristári,</l><l xml:id="m-9bcb4a0c-a354-4a44-8701-ae5c32d2ae5e" facs="#m-1dd5a0f5-9a89-488e-97c6-0d8c0edcc2ea" label="lyrics-like">15. Virgo vírginum praeclára,</l><l xml:id="m-a72c2b7a-498a-4b17-a495-575d95890b71" facs="#m-ad6bad68-02b9-4e02-b330-c9a257f0811f" label="lyrics-like">Christi mâtrem contemplári</l><l xml:id="m-05c7c69c-954c-40f0-9d81-d6f5e033a31e" facs="#m-6823c19e-c426-4247-b814-a9b90990b73b" label="lyrics-like">Mihi iam non sis amára:</l><l xml:id="m-b22b0ac6-2bc7-4fa3-9653-a7312da479b4" facs="#m-ff604211-da63-4855-9ea9-175155f2a68d" label="lyrics-like">Doléntem cum Filio ?</l><l xml:id="m-08deb0e8-18a6-4a7d-8fe8-2b89edb712d1" facs="#m-93ca158e-8973-4b7d-a0cc-67fd51005089" label="lyrics-like">Fac me técum plángere.</l><l xml:id="m-c73392c1-2f50-4e2d-a6c4-14ea15f7d171" facs="#m-1dc53872-b913-456e-8baa-99bc01017a32" label="lyrics-like">7. Pro peccátis súae géntis,</l><l xml:id="m-ffc90dac-eeed-4191-96cc-35260f38bded" facs="#m-119b1496-3c9e-4c44-8c98-cda90ba944d9" label="lyrics-like">16. Fac ut pórtem Christi mórtem</l><l xml:id="m-32004926-8655-4f9f-9af1-157eb0dbaa84" facs="#m-71dcb4c3-bac9-47f5-a430-e05ddb6a3bdd" label="lyrics-like">vidit Jésum in torméntis,</l><l xml:id="m-c1cdadc5-b58a-4ae2-9257-d50d1c836222" facs="#m-f7600eb2-220a-4240-b58a-4a877dc1d4db" label="lyrics-like">Passiónis fac consórtem,</l><l xml:id="m-e2962671-f069-4bfc-afd6-2bef6f47a942" facs="#m-b020b7bb-bf0e-4a1f-8568-b3c1374dd260" label="lyrics-like">Et flagéllis súbditum.</l><l xml:id="m-14ff6380-6e72-4874-bfa1-30970edd273c" facs="#m-b03b183e-3fdd-4f69-9463-5abbe15e143d" label="lyrics-like">Et plágas recólere.</l><l xml:id="m-177bccb2-65a1-41b2-8a2c-f2684f18b5e6" facs="#m-d1e5f74c-25ff-4054-a49c-044a474f2eb2" label="lyrics-like">8. Vídit súum dúlcem nátum</l><l xml:id="m-8eb1dd17-3c34-45e9-80fc-441ee94a0267" facs="#m-f5476378-61a5-4b34-93e1-0861064d0ce2" label="lyrics-like">17. Fac me plágis vulnerári,</l><l xml:id="m-d55e54ca-b0d0-4b40-a9bb-a1b22030e152" facs="#m-2b0eac9b-34f4-4a10-b44e-7790febc6096" label="lyrics-like">Moriéndo desolátum,</l><l xml:id="m-b705d0e6-4b4e-4407-952e-bdae0c47a947" facs="#m-dd5f8351-8f52-4cf7-b10f-f7c3a01711f3" label="lyrics-like">Fac me crúce inebriári.</l><l xml:id="m-c5280f2a-1307-4e1e-9e7d-d4cbe836bf64" facs="#m-8acf9b76-b97f-4718-8ca5-4b963a7721b4" label="lyrics-like">Dum emísit spíritum.</l><l xml:id="m-bb4b60fb-f602-48ef-a494-91e36787040e" facs="#m-c5f86163-5372-4ca5-8113-03cb0d4c60b0" label="lyrics-like">Et cruóre Filii.</l><l xml:id="m-1fe87644-5f33-4cb0-b2d0-88af38db7503" facs="#m-49ffe080-bd19-4584-9044-824509788eaf" label="lyrics-like">9. Eia Máter, fons amóris,</l><l xml:id="m-2f5db0f0-297f-4181-9b36-f7d0765c8b1a" facs="#m-523bab12-1448-401b-a3d4-88d542ce61fa" label="lyrics-like">18. Flámmis ne úrar succénsus,</l><l xml:id="m-b90a959e-d11f-4e33-9756-7dfcc4e29e3a" facs="#m-b786696a-8781-4363-9bdb-b1820b76a2de" label="lyrics-like">Per te, Virgo, sim defénsus</l><l xml:id="m-f373c4f3-56dd-4dd2-be76-1ba6dccce42d" facs="#m-ad38f516-bc6b-45bd-a366-10e79617e134" label="lyrics-like">Me sentire vim dolóris</l><l xml:id="m-0e091d31-9a1a-4222-8cb3-1f6622bf2b38" facs="#m-ec9207b6-9622-4040-acfb-12cd1b6979af" label="lyrics-like">Fac, ut técum lúgeam.</l><l xml:id="m-f992a628-f098-40d0-a0b2-00605e815c12" facs="#m-df25bbeb-db7d-4f27-81b2-24d846d6ab89" label="ambiguous">In die judicii.</l><l xml:id="m-f818541a-4e13-4caa-8a05-617c7b2f21fa" facs="#m-d57afa96-f79a-4cac-a747-c93ab3f09c1f" label="lyrics-like">10. Fac ut árdeat cor méum</l><l xml:id="m-1864aa8c-955f-4043-8b15-9843f605a235" facs="#m-c0bd1c33-a454-46d4-aa3e-aab1e6d9f3a6" label="ambiguous">19. Christe, cum sit hinc exire,</l><l xml:id="m-20fe7d17-d169-4aac-a463-02714584eab1" facs="#m-b7a3a499-b6af-41ad-b202-c85d5850fa93" label="lyrics-like">In amándo Christum Déum,</l><l xml:id="m-3dee3c3e-9a5b-4dfa-bd58-3d48d69bc401" facs="#m-02c67c9e-ab08-4885-a5dc-c614656cd643" label="lyrics-like">Da per Mátrem me venire</l><l xml:id="m-badaee13-3402-4c66-84d5-bec55b8f5f8c" facs="#m-c04475d6-9038-4d4e-92c4-15ce1d7c32f7" label="lyrics-like">Ut sibi compláceam.</l><l xml:id="m-5536a5ae-da40-4884-8b62-27843d34e738" facs="#m-0c7a0c86-bf15-4066-a048-594cfeba70c6" label="lyrics-like">Ad pálmam victóriae.</l><l xml:id="m-4dc71e38-2889-43a2-9d0e-55ade56fd575" facs="#m-cfe1073a-b3d1-4cf9-8883-c4af74581f68" label="ambiguous">20. Qua</l><l xml:id="m-9d22faf5-a571-4410-87a9-35c84fdf3934" facs="#m-cf7a481e-9101-49b1-9c19-f844ada824f2" label="lyrics-like">undo córpus moriétur,</l><l xml:id="m-63e12d42-3108-4b83-93d4-991e9716b7ab" facs="#m-d7d1d097-ded2-443b-88f0-6c521f5f9842" label="lyrics-like">Fac ut án</l><l xml:id="m-af5a1b07-5c27-450c-ae18-d6e5776c9f40" facs="#m-33121029-af97-4504-907f-34c9a63dd3f8" label="lyrics-like">imae donétur</l><l xml:id="m-9507aaf8-7445-4651-ab3f-ef9091fb4c27" facs="#m-f0eb63c2-c826-4eaa-a1f1-7486aa6482fc" label="ambiguous">Paradisi g</l><l xml:id="m-4e66355b-c958-4741-a1d8-16a16ab08305" facs="#m-d097f3c7-7000-4ed5-b625-eca8e8d1be23" label="lyrics-like">dória. Amen.</l></lg></div></section></score></mdiv></body></music>
</mei>