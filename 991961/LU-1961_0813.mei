                  <syl /><neume facs="#m-ce5faf2d-82e6-4bf7-9904-2b2933502755" type="punctum" xml:id="m-4c5d9d7f-9095-483e-a81c-78806869d0f5">
                    <nc xml:id="m-11543ff9-e48a-4ae0-84a2-e0a51e61c91a" pname="a" oct="3" />
