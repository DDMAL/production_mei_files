                <divLine xml:id="m-4515fb3c-f89c-462e-8b20-4b23e942c8d8" facs="#m-179b024c-c639-4a8d-b130-89af3ea5bfec" form="maior" />
                <syllable xml:id="m-373d850e-c4b5-464b-be02-3585e9f69fb5">
                  <syl /><neume facs="#m-0ad9bf15-1f2e-417a-ab61-4343c9a29aa7" type="punctum" xml:id="m-c1139633-0e17-4dd9-a2aa-e6aeac80652c">
