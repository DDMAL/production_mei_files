                <syllable xml:id="m-9a2bcb52-6109-43f5-bfe6-40cc90b21a17">
                  <syl /><neume facs="#m-534b2216-67fe-4ffa-a8ea-ad683e1e1797" type="torculus" xml:id="m-b3b7383a-c408-4377-8819-66cb046d693c">
                    <nc xml:id="m-f38cfca3-92fc-4316-83b9-16379c854947" pname="e" oct="3" />
                    <nc xml:id="m-da8c4d82-22dc-4a44-9a54-0437927e12ec" pname="f" oct="3" />
                    <nc xml:id="m-62a5a2b6-bec0-4379-af07-9c233aeae957" pname="e" oct="3">
