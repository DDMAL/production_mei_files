917df71"><nc xml:id="m-4ab4f9e6-dc00-49b7-b07d-8825fac201b6" pname="g" oct="4" /></neume></syllable><syllable xml:id="m-4fc68279-734f-464b-b9f1-fc4dac093a8c"><syl /><neume facs="#m-05ab7896-a1d9-4f20-ac8f-baf754edf9b6" type="punctum" xml:id="m-1e6df9de-52d4-404d-bcf2-87cc5f09439c"><nc xml:id="m-e0aec907-ff21-4b4f-a8c5-c3db332ecbb5" pname="b" oct="4" /></neume></syllable><syllable xml:id="m-2e618efd-df40-4674-849d-493a02d50b42"><syl /><neume facs="#m-8f14de56-5c33-44a6-b730-8e77b4e5f465" type="punctum" xml:id="m-3edc743f-e1eb-42cd-8ade-5eec22c777f6"><nc xml:id="m-32601a21-889e-4fbe-8eac-9990db39179b" pname="d" oct="5" /></neume></syllable><syllable xml:id="m-b2c93754-c152-4656-bdd7-1527c7713fd8"><syl /><neume facs="#m-3a9d8067-01e8-474d-b6ad-e9607f88212f" type="punctum" xml:id="m-db778a84-2589-4f25-8383-462759fbb69e"><nc xml:id="m-5d01f31c-96a3-4163-b7ad-63ffb3227e65" pname="c" oct="5" /></neume></syllable><syllable xml:id="m-559d3390-7b7d-4a95-af47-22006337f69f"><syl /><neume facs="#m-9b584754-6264-4a15-8ab4-2c92a7eaa426" type="punctum" xml:id="m-6d3ee9fb-d965-4eed-b2be-1bf500a3989a"><nc xml:id="m-aa522d87-0373-4a22-9771-d1723feeac89" pname="d" oct="5" /></neume></syllable><syllable xml:id="m-ee087c82-97ce-4211-b857-7a9fb1b6fd93"><syl /><neume facs="#m-eae13e63-7118-45d1-8896-255e9b8bcdd3" type="punctum" xml:id="m-47278c6e-6714-49a1-aa3c-099f6c1f16c6"><nc xml:id="m-e6f27d39-ed89-4cf0-a00c-240f1b7fe4ab" pname="d" oct="5" /></neume></syllable></layer></staff><div xml:id="m-3a6d464f-63a4-4570-bff8-0d8da25eb7fd">
            <lg xml:id="m-0599ccd7-8424-40f7-8682-069c654ee0eb">
              <l xml:id="m-e41397e3-da8b-4cfc-9e8f-ec937d0516eb" facs="#m-71e6692d-6bfd-4136-bde3-f2c3bfb74e02" label="ambiguous">236</l><l xml:id="m-2dbdc9d4-7e40-41ae-b2ea-155ea0fe0cd0" facs="#m-d994fb86-2613-4930-b745-64c8e08c56db" label="text-like">Sunday at Terce.</l><l xml:id="m-48649151-0591-4c8a-a7fb-914c7edd0fe5" facs="#m-254d8fc1-a43a-4634-b548-22131fd34193" label="text-like">In Paschal Time.</l><l xml:id="m-9bda6d86-6d58-4191-a163-b1cb35338c22" facs="#m-483c31db-5c51-46d7-a056-ab6c6307022c" label="ambiguous">Ant.</l><l xml:id="m-0851d98e-a2c6-4a38-994a-a43b28e40e22" facs="#m-51e94962-5c2d-420c-bf55-e1040e2d25e3" label="ambiguous">2</l><l xml:id="m-b08c8c0f-3352-4b68-8527-2a573b4fcc8e" facs="#m-a2f0377a-e608-40ab-94a2-3f2bb8f1a1c0" label="lyrics-like">ALle-lú-ia.</l><l xml:id="m-673f230a-0329-44ff-82df-864f48bcb745" facs="#m-a62e038b-52b2-45c8-9efe-4cc753a1c043" label="ambiguous">E u o u a e.</l><l xml:id="m-dc3d88dc-9cf6-4367-b309-39015e6a9354" facs="#m-b2794f92-201a-403e-8130-85716b94f66b" label="text-like">During Advent, Septuagesima, and Lent, the Antiphon is taken from the</l><l xml:id="m-b3d8f095-81b1-4f51-af97-2c51324754fc" facs="#m-553d8918-af68-43de-bfb7-0a7e6438c141" label="lyrics-like">Proper ôf the Time, and on Feast days, from the Proper of the Feast.</l><l xml:id="m-dd7c9f00-d1f6-468f-9fd7-84edd64c6676" facs="#m-8a678952-1217-42a4-8798-45f352f32d54" label="ambiguous">Psalm lI8. III.</l><l xml:id="m-e2994bbf-982a-40d7-ad1d-8ffb238ffc50" facs="#m-98546ab6-ec41-438c-99ce-6460694b1c85" label="ambiguous">Psalm I18. IV.</l><l xml:id="m-33a45475-232e-46b1-beb7-b6169f3e5c2c" facs="#m-c957b635-b596-46e8-9670-975caed6f523" label="lyrics-like">Egem póne mihi Dómine víam</l><l xml:id="m-99937a25-50e2-492d-af57-876bcafaf624" facs="#m-235b3f8b-f2f4-47ec-aefa-8fed28abc9b3" label="text-like">This Psalm and the next shoula</l><l xml:id="m-067f1f75-d4f9-4d64-ae23-16637e7ca9fa" facs="#m-61288772-fc10-48d7-8ca8-0c8409e1e59c" label="lyrics-like">I justifcatiónum tuárum:“et</l><l xml:id="m-a3e0c283-15c3-4f74-b341-92ba674d44a7" facs="#m-308d6838-8495-4e97-bb22-38a922c37436" label="text-like">each be intoned by the Cantor.</l><l xml:id="m-adc8994a-cb19-4ce5-9cb7-e5100e879375" facs="#m-e6a94a5b-f258-4506-b48e-c42628c73d1d" label="lyrics-like">exquíram éam sémper.</l><l xml:id="m-aad64f93-5169-4ebf-a95b-480a8e0ee349" facs="#m-e3555566-70a3-46ae-bb52-7eb413d20b06" label="lyrics-like">(DEmor ésto vérbi túi sérvo</l><l xml:id="m-00b1e2b5-c586-4951-b6ba-ea87e37b5827" facs="#m-3d4bc624-79d1-4eb9-89ec-289a0fae1a72" label="lyrics-like">Da mihi intelléctum, et scrutá¬</l><l xml:id="m-c41b6a50-c14c-491e-8158-9d9e9204e6ec" facs="#m-bf5c7366-de16-4a15-9eac-48c81dbbf406" label="lyrics-like">31 túo,  in quo míhi spém de¬</l><l xml:id="m-449015e8-504a-49f8-acf0-72641c894013" facs="#m-2da5fe50-956a-4f61-a35e-fba70a4071e3" label="lyrics-like">bor légem túam :* et custódiam</l><l xml:id="m-d2c2bdff-976f-4637-85bf-9662177440d1" facs="#m-ba7b7f07-de70-4fb3-8db7-f1822abd19da" label="ambiguous">disti.</l><l xml:id="m-4d970c16-f691-4273-bfc0-55d72fe6ce52" facs="#m-b52cd845-128a-45e2-aaee-0dc5a98add16" label="lyrics-like">illam in tóto corde méo.</l><l xml:id="m-191253de-1006-4add-ac68-99652fa9a68c" facs="#m-880da031-81ee-4e76-998e-3a48b58c7af4" label="lyrics-like">Haec me consoláta est in humi¬</l><l xml:id="m-5e10bb12-ba70-41f8-87bd-d91f27d4d1ac" facs="#m-0b3ea834-d10f-4417-9b07-87abd7924139" label="lyrics-like">Déduc me in sémitam man¬</l><l xml:id="m-028eef94-0ccf-4029-85e4-9a697e8786ba" facs="#m-952a2d4d-0240-46c2-a76a-3f0ac0e64516" label="lyrics-like">datórum tuórum:quia ipsam</l><l xml:id="m-34ebb496-73be-497e-916f-123981232b2c" facs="#m-d69b4f7d-75ba-467e-8546-859d54820887" label="lyrics-like">litáte mea:* quia elóquium túum</l><l xml:id="m-e9d107f0-253a-4a1f-a942-2ac2c8b072d7" facs="#m-34850513-823f-4f44-9876-3d8bfd4987b3" label="lyrics-like">vivifieávit me.</l><l xml:id="m-eab792da-2b00-4f25-aafd-6a0295a9808c" facs="#m-60811e8c-1e37-44ac-abe0-c2e30d18cbfc" label="lyrics-like">vólui.</l><l xml:id="m-45277806-9d88-4e98-b7c0-0f1f583d6c08" facs="#m-d74138b8-ceb4-41d4-8d44-7b9a7c4260d7" label="lyrics-like">Inclina cor méum in testimónia</l><l xml:id="m-75608dfb-37be-411b-a241-fd004907dabe" facs="#m-36e81fc0-d431-47f0-a528-ec065dea9c35" label="lyrics-like">Supérbi inique agébant usque¬</l><l xml:id="m-e27b9a1e-a6e3-4fee-942b-2350cfa39880" facs="#m-18bd298c-4434-40c8-a7b8-9553cc042e40" label="lyrics-like">túa:* et non in avaritiam.</l><l xml:id="m-0517412f-cb1a-4e74-aab3-1f5d4ad234a3" facs="#m-248d532a-24e5-4541-8fb9-bc12b20cbd93" label="lyrics-like">quáque: * a lége autem túa non</l><l xml:id="m-993bfe21-d5dc-4b05-b568-23bf241526c2" facs="#m-9a61504c-3fa8-4b65-8240-46e9feaee33a" label="lyrics-like">Avérte óculos méos ne vídeant</l><l xml:id="m-b1aa836e-529b-44b5-a4b1-6f514aab265c" facs="#m-98bc1892-429d-41e4-a74e-3a300497d1fb" label="lyrics-like">declinávi.</l><l xml:id="m-a28354ac-b1c2-4c1d-ab22-d028b13df23b" facs="#m-6f81c7db-835e-4b2a-936a-f0a750cf137b" label="lyrics-like">Mémor fui judiciórum tuórum a</l><l xml:id="m-d3f8d7ce-1806-47d9-ad87-f8a75f3a4263" facs="#m-7e37d761-fed8-4376-924a-baef9327a964" label="lyrics-like">vanitátem: * in vía túa vivifica</l><l xml:id="m-0fd83ac5-7f95-441c-9a1b-2f6878c172e0" facs="#m-129f0e62-24e3-4639-9d76-0686466363fe" label="lyrics-like">saéculo Dómine: * et consolátus</l><l xml:id="m-afe585c4-d43a-4f42-994d-b3748490d73e" facs="#m-3e699303-4e93-43ab-a622-a98777f091cf" label="ambiguous">me.</l><l xml:id="m-201ce47c-d4a6-43cf-982f-99d40c5b831f" facs="#m-e1d5b60a-60b8-4246-822a-e43551b02c09" label="lyrics-like">Státue sérvo túo elóquium</l><l xml:id="m-8d339b8d-0215-495d-9bb9-0b149814746c" facs="#m-8af9d2c8-75e9-47bf-a982-e23238011ce1" label="ambiguous">sum.</l><l xml:id="m-83b8b699-d669-45bc-a255-0252de53671f" facs="#m-fa6627c7-4c51-4a1b-ba77-a1d05b37da7b" label="lyrics-like">Deféctio ténuit me, * pro peccató¬</l><l xml:id="m-fa8b73ca-8a58-4c5e-ba60-f87e8555f539" facs="#m-0fadd659-8977-458f-9475-ce731416377c" label="lyrics-like">tuum, * in timóre tuo.</l><l xml:id="m-b77a3051-3678-47cc-9541-8c95c97314ba" facs="#m-0153e565-2f3a-4ec2-8f5b-e68e0fa32f0f" label="lyrics-like">Amputa oppróbrium méum quod</l><l xml:id="m-1da6d620-5819-4803-b58b-c975acc7c0d5" facs="#m-2a9aa6e0-66cf-41dd-9cc2-5d01c272421d" label="lyrics-like">ribus derelinquéntibus légem túam.</l><l xml:id="m-9dd3fe69-359d-4b1e-9cee-55ef3d4bfdd9" facs="#m-b425acdb-87cc-40e7-af0c-404fc5db3380" label="lyrics-like">suspicátus sum :* quia judicia túa</l><l xml:id="m-afed91bd-bac9-494b-b632-5a8795992b3f" facs="#m-1bc5792a-3d19-4ac2-9eb0-ab89b9889f75" label="lyrics-like">Cantábiles míhi érant justifica¬</l><l xml:id="m-c5c33eb9-2e4a-4e8f-8152-7edd14854b5c" facs="#m-05545563-fc71-4072-b7cb-e1f4f6f35d04" label="lyrics-like">tiónes tuae, * in lóco peregrina¬</l><l xml:id="m-4363c276-ff98-4f59-b068-eaf0841673ea" facs="#m-e637cd2c-a0dc-474b-89e3-6ed9b48ba3ac" label="ambiguous">jucunda.</l><l xml:id="m-53512493-57fe-4d4a-88fc-193c34fdfcf5" facs="#m-17380a00-b07d-4bcd-9cc8-7152534889f9" label="lyrics-like">Ecce concupivi mandata túa:</l><l xml:id="m-2ba4cdca-c02f-4c1f-b4c4-29951acff391" facs="#m-b664715a-0a8e-4f45-a9db-c1f964f2b148" label="lyrics-like">tiónis méae.</l><l xml:id="m-a6db5703-e98e-4c9d-a1fd-a6d9fc577518" facs="#m-62db1a0f-55af-4f70-b49a-05065524e7a4" label="lyrics-like">Mémor fui nócte nóminis tui</l><l xml:id="m-5a5fc7b4-9175-4ad8-92f6-1d9dc98d1954" facs="#m-3b6b4fed-dbb6-40cc-a5d8-43f043de28a4" label="lyrics-like">in aequitáte tũa vivifica me.</l><l xml:id="m-cc0732bc-d454-47e4-979d-95b5412267bd" facs="#m-7c25d48c-0f2a-4748-bfeb-ad27d5c36086" label="lyrics-like">Dómine: * et custodivi legem</l><l xml:id="m-f5b46ef5-9327-4cd2-8237-8334ee7adbef" facs="#m-00ecccf2-90e6-4b8c-bd7f-d172dc7add99" label="lyrics-like">Et véniat super me misericórdia</l><l xml:id="m-021a31c7-0a18-4875-9ee3-8e1b650d1113" facs="#m-99efbc5f-37dd-4c51-a10b-acaf8dc66345" label="lyrics-like">túam.</l><l xml:id="m-875e941f-fb14-4dc1-a0bd-096ccc5d6737" facs="#m-d0db8522-b581-41f3-a1ac-771ad13be806" label="lyrics-like">túa Dómine:* salutáre túum se¬</l><l xml:id="m-bd9059df-44e9-417e-b2a0-8969f944e282" facs="#m-df463fce-8a84-4b6d-a811-94eaf5ee02ca" label="lyrics-like">Haec fácta est mihi: “quia</l><l xml:id="m-d0d5f76a-e3e6-4b1d-9d0a-5a35ea27e84a" facs="#m-ce692eb7-a910-4100-9b4c-f75af0ecc7a5" label="lyrics-like">cúndum eloquium túum.</l><l xml:id="m-b80f18ac-4905-45a5-8049-70f23b2f266d" facs="#m-c6289d05-f8f6-40ab-9fd8-817794f22cac" label="lyrics-like">Et respondébo exprobrántibus</l><l xml:id="m-d6afd2d4-ad44-4cfe-aeb6-0063cdde8db8" facs="#m-7dee51a0-8ebf-4f07-9335-df39fb220996" label="lyrics-like">justificatiónes túas exquisivi.</l><l xml:id="m-343faf82-ede9-471a-9fad-558da098f12d" facs="#m-21318c14-a9bb-4e50-aecb-1a82eb36d894" label="lyrics-like">Pórtio méa Dóminé, * díxi cu¬</l><l xml:id="m-62df772b-d28d-4f45-bda8-553ee71fe802" facs="#m-84656cac-b266-40b6-8eb9-a1fab80ede29" label="lyrics-like">mihi vérbum:*qua sperávi in</l><l xml:id="m-d3ae530c-978e-4a63-91c6-b268670531fb" facs="#m-b7133a91-8b97-4709-a04f-cff6b207b0dd" label="lyrics-like">sermónibus tuis.</l><l xml:id="m-9fb1e6cc-4bdc-45ac-b75b-0522012de7dd" facs="#m-b909c1c1-b188-41e4-a323-d5b43378621f" label="lyrics-like">stodire légem túam.</l><l xml:id="m-464bb086-5369-4be8-a01d-afb7179d66ba" facs="#m-9a76539f-4b59-499e-8584-f13378bcdfa2" label="lyrics-like">Et ne áuferas de ore méo vér¬</l><l xml:id="m-cf75f2e6-7773-4479-a7a8-aaa35a9f7c8c" facs="#m-f4555521-6b21-41f4-964f-da25f99837df" label="lyrics-like">Deprecãtus sum fáciem túam in</l><l xml:id="m-314730be-4573-4b5c-8722-57232dd55a20" facs="#m-ccaae661-98d8-4a1a-b986-6801b2896d4e" label="lyrics-like">tóto córde méo:“miserére méi</l><l xml:id="m-373d80b2-7b2c-434b-8ce3-ae1b60530b2a" facs="#m-381711eb-dc1d-4f5f-a17a-9598ce13b24a" label="lyrics-like">bum veritátis usquequâque :* quia</l><l xml:id="m-442db725-e21b-4279-bb10-d489a99dbcaa" facs="#m-f0fe8367-c1a3-4e6b-9f58-501ee53d7103" label="lyrics-like">secúndum elóquium túum.</l><l xml:id="m-eb19a69f-4c80-4a4f-926c-83a9b9f1a3a4" facs="#m-54955226-39e6-4169-9c4d-538deebc7995" label="lyrics-like">in judíciis tuis supersperávi.</l><l xml:id="m-5686cb9f-aea7-4408-922c-d5124963c6f4" facs="#m-dae9e927-7c08-4e30-b174-e45ec87f4829" label="lyrics-like">Cogitávi vias méas: * et con¬</l><l xml:id="m-a34144d2-ff5f-4a97-818f-3b9c483020f7" facs="#m-c4cb2cdd-e96d-47f3-b014-82f6d94d4a31" label="lyrics-like">Et custódiam légem túam sém¬</l><l xml:id="m-87b619e4-50b6-45bc-91c7-0d7f85140d77" facs="#m-82ab80be-4734-46af-879e-990adb887c0c" label="lyrics-like">vérti pédes méos in testimónia túa.</l><l xml:id="m-87abea9a-c7bd-4252-8773-144fbae921fd" facs="#m-802063db-67ef-4a5a-ab7d-b31c59bb3ff8" label="lyrics-like">per :* in saéculum et in saéculum</l><l xml:id="m-4005d0ae-96b6-41dc-b714-8b8859dbe48d" facs="#m-84f2f7d1-dad8-4958-8bcb-f533dda811c0" label="lyrics-like">saéculi.</l><l xml:id="m-0e7ab405-5056-4732-ac16-f131c02fa6b1" facs="#m-9701d92f-eb61-4886-b642-cd88fd849e93" label="lyrics-like">Parátus sum, et non súm turbá¬</l><l xml:id="m-6e9b3389-c2cd-446d-ac2c-4ca4cbf33c7a" facs="#m-83c008f0-75cf-4681-a24f-655f5f331698" label="lyrics-like">Et ambulábam in latitúdine:</l><l xml:id="m-befc6786-6bb2-4272-a3ee-f2c5328f9acd" facs="#m-4fe89e6f-67db-4a90-9e66-f05dd9bb5953" label="lyrics-like">tus: * ut custódiam mandáta túa.</l><l xml:id="m-a01ae8a3-e754-42b3-946b-32e8400ec8fc" facs="#m-db82285d-6570-468c-9701-674e7232ac7c" label="lyrics-like">quia mandáta túa exquisívi.</l><l xml:id="m-3df88615-8ded-4ad9-964a-10084fe6fb79" facs="#m-ab116ffc-460e-4184-87f8-45ad0866d3e9" label="lyrics-like">Fûnes peccatórum circumpléxi</l><l xml:id="m-be9fbd33-b07f-4448-bee2-f0968c60134e" facs="#m-a7a8f01f-955c-48c8-9809-c4f7ae89af10" label="lyrics-like">Et loquébar in testimónis tuis</l><l xml:id="m-64af2af5-d0e3-429c-bedf-5e31fdc9cca6" facs="#m-fb6601f4-f4de-45f0-becd-2c9bcc6bda8d" label="lyrics-like">sunt me : * et légem túam non</l><l xml:id="m-739097c6-a56e-4274-b75d-5f9066d5c64e" facs="#m-9bd3c4f2-c4b0-470e-9439-8e37c4efae11" label="lyrics-like">súm oblitus.</l><l xml:id="m-196a22ca-0521-4c1c-a3ea-c01cb01ec912" facs="#m-31d7ff24-bedd-4f84-bdd4-f50dd93abaf5" label="lyrics-like">in conspèctu régum :* et non con¬</l><l xml:id="m-accaa729-c4c1-481c-97d5-1972e873b2f9" facs="#m-1e30609b-09ac-4915-9fd1-5062c3edc64d" label="lyrics-like">Média nócte surgébam ad confi¬</l><l xml:id="m-c72d4de6-6304-4c2f-a8a3-54c130457a0b" facs="#m-1919a4d6-aa87-4167-b182-7a2a134b6cf0" label="lyrics-like">fundébar.</l><l xml:id="m-6dcb6f1c-f30d-4398-946e-a10243b2865b" facs="#m-6e415f28-ea46-4746-be6d-fcf57b14e218" label="ambiguous">tendum tibi, * super judicia justifi¬</l><l xml:id="m-1cbe07f7-52e4-4a8c-82cc-e08e1adaa3f2" facs="#m-368b4aa3-efa6-4cd8-a297-de8c3248ebbe" label="lyrics-like">Et meditábar in mandátis túis.</l><l xml:id="m-31e297c8-b398-42b7-9123-fca6c67e369b" facs="#m-bd605962-4482-4369-9d97-14ffd6fb385b" label="lyrics-like">catiónis túae.</l><l xml:id="m-1de46d73-35e8-420a-b596-9747f1a96fca" facs="#m-763b26e2-5d8d-4b44-9eed-43df088c415c" label="lyrics-like">quaé diléxi.</l><l xml:id="m-69293170-1e42-4931-bcd8-66d0b0b124e9" facs="#m-7972ad6b-c519-40dc-be0b-e07df2cb38a9" label="lyrics-like">Et levávi mánus méas ad man¬</l><l xml:id="m-c7d69e9d-b4e1-493e-a5cf-b0b36f95098e" facs="#m-1213889b-c7e6-45ca-9045-69fe7c715953" label="lyrics-like">Párticeps égo sum ómnium ti¬</l><l xml:id="m-3f9774fd-3593-44b0-a1d0-39aa604bc918" facs="#m-21ea685e-26da-4589-b860-5dbf6e069676" label="lyrics-like">dáta túa, quaé dilexi :* et exercé¬</l><l xml:id="m-397bcca1-a621-4d10-a7bf-94304afab49f" facs="#m-34427972-8bd4-4b45-84b5-aba0e46f2303" label="lyrics-like">méntium te: *et custodiéntium</l><l xml:id="m-7850f572-b175-4cce-9986-2cf7a59e14fa" facs="#m-3e18dde7-4e51-4d13-a4a5-a3f4f8ac587a" label="lyrics-like">Imandáta túa.</l><l xml:id="m-9a6fadcf-432c-480c-8365-577ff19dec16" facs="#m-b37395cd-ccc3-4948-80eb-a46f5762e67f" label="lyrics-like">bar in justificatiónibus tuis.</l></lg></div></section></score></mdiv></body></music>
