                    <nc xml:id="m-c7853232-48f2-4a34-8dfa-02bb6394a7c3" pname="f" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-e139943a-3aad-4678-9d18-b76b67a53ce5">
                  <syl /><neume facs="#m-718e3f39-4186-4745-ba3c-a39ef8b48e92" type="podatus" xml:id="m-0a918324-1958-4449-9da7-4cbfe8639beb">
                    <nc xml:id="m-24bd98cf-3847-4e31-9af5-bb1824ab3d6b" pname="g" oct="3" />
                    <nc xml:id="m-07146b3d-bf84-4aa8-bae0-3e8fd6740475" pname="a" oct="3" />
