      <graphic xml:id="m-cc23b78d-a505-4403-ad8c-80cf22199097" target="2287_original_image.tiff" /><zone xml:id="m-cecd23ee-62bf-4c59-afa6-a0e3d57ec420" ulx="174" uly="82" lrx="722" lry="116" /><zone xml:id="m-cfcbb3ec-764c-407f-8ca0-f5d4a31875fd" ulx="793" uly="91" lrx="848" lry="124" /><zone xml:id="m-53f232a9-c7cf-4300-ba30-24b44d3cf3cf" ulx="203" uly="129" lrx="689" lry="168" /><zone xml:id="m-3b1ed6ec-34fc-46b7-a490-53013f85ed06" ulx="67" uly="161" lrx="637" lry="208" /><zone xml:id="m-85504a3a-49dc-4bdb-90c4-d7753a3036d7" ulx="405" uly="203" lrx="490" lry="235" /><zone xml:id="m-677a16ef-18fd-4ebd-9741-f1524e9c0785" ulx="73" uly="230" lrx="848" lry="273" /><zone xml:id="m-0377efe3-7d03-4bef-9f91-bdda9f21ee21" ulx="42" uly="260" lrx="848" lry="298" /><zone xml:id="m-347de501-a26c-47ae-8f2c-c608829f3135" ulx="40" uly="286" lrx="583" lry="322" /><zone xml:id="m-9889e3fc-b04b-4607-815f-9936b3b59342" ulx="341" uly="326" lrx="556" lry="359" /><zone xml:id="m-37c237e5-d147-4179-9d04-1083a2c46908" ulx="61" uly="354" lrx="845" lry="394" /><zone xml:id="m-c855bc6b-5efa-4953-8a87-fb36062d8afb" ulx="41" uly="381" lrx="847" lry="416" /><zone xml:id="m-c1d88700-504c-4827-a469-3e6763fb0633" ulx="40" uly="410" lrx="846" lry="443" /><zone xml:id="m-a6c81463-ebb0-4843-bcfd-a8e196ff86b4" ulx="40" uly="435" lrx="653" lry="475" /><zone xml:id="m-a3fe536e-7e84-4030-a9b7-f9130e0d996f" ulx="377" uly="514" lrx="518" lry="548" /><zone xml:id="m-89af7ff4-eb65-49be-a4c1-5eaeac7d4d20" ulx="111" uly="550" lrx="770" lry="595" /><zone xml:id="m-1a49b4dc-6cf6-480e-abb9-06279509edf2" ulx="386" uly="593" lrx="500" lry="633" /><zone xml:id="m-7589bd3b-b533-4cdb-9f2a-50ff3625ef33" ulx="239" uly="633" lrx="650" lry="668" /><zone xml:id="m-08712edf-15fe-4abb-9d45-d9dd7f206d78" ulx="376" uly="688" lrx="518" lry="724" /><zone xml:id="m-2f6d7933-b123-4ca2-a386-c209629e7e53" ulx="68" uly="730" lrx="715" lry="768" /><zone xml:id="m-49dc0471-94d1-4128-9116-caca0678e2bc" ulx="396" uly="769" lrx="494" lry="801" /><zone xml:id="m-28bbb25b-bf43-4fb4-870c-9e44eb9595ef" ulx="80" uly="794" lrx="848" lry="835" /><zone xml:id="m-44a4bd7e-7ee3-4f8d-a6c0-50240024c8f0" ulx="43" uly="824" lrx="847" lry="858" /><zone xml:id="m-ff675865-7a04-4618-85e7-35fb214a46b6" ulx="43" uly="852" lrx="848" lry="888" /><zone xml:id="m-d36b00ec-c8a2-4ff2-9e4e-49dc84c93020" ulx="42" uly="876" lrx="576" lry="915" /><zone xml:id="m-bfaf72fe-df6b-4356-b763-570eeb58d1fa" ulx="53" uly="912" lrx="839" lry="948" /><zone xml:id="m-48baf705-e9a4-42c3-9d8b-f99ad6c78b2a" ulx="59" uly="943" lrx="848" lry="985" /><zone xml:id="m-b211a90c-39ff-40bf-812f-edabb243492e" ulx="48" uly="970" lrx="848" lry="1010" /><zone xml:id="m-d094081b-d824-4293-81f5-5af71f558bfa" ulx="43" uly="1000" lrx="441" lry="1035" /><zone xml:id="m-4c1e6114-be25-4d45-816b-6fe3f1792782" ulx="449" uly="1004" lrx="848" lry="1030" /><zone xml:id="m-5effde1b-ba59-4bc1-bc70-13d2f9d4e034" ulx="43" uly="1024" lrx="441" lry="1065" /><zone xml:id="m-ae45eb12-14d8-4b02-bc6a-bfa3fd301ca2" ulx="448" uly="1024" lrx="848" lry="1059" /><zone xml:id="m-8728bd4f-704b-4290-a683-5a4a5cfe2dea" ulx="43" uly="1051" lrx="848" lry="1089" /><zone xml:id="m-9d5f86f9-fe69-4d3a-a158-8c7e73bc361c" ulx="43" uly="1077" lrx="848" lry="1116" /><zone xml:id="m-91f1e86a-6556-42ef-8c03-a8180ac2375b" ulx="43" uly="1105" lrx="849" lry="1144" /><zone xml:id="m-ad859ea5-f389-4c55-bd03-8d3699f83e51" ulx="44" uly="1132" lrx="846" lry="1168" /><zone xml:id="m-dd46b3b3-9af9-4892-a422-596b58088cb3" ulx="41" uly="1159" lrx="843" lry="1194" /><zone xml:id="m-fa2b7be9-b9c8-4789-9f91-78ade701e320" ulx="40" uly="1184" lrx="844" lry="1220" /><zone xml:id="m-245be37a-3987-44d6-9f4a-502c4c8ff711" ulx="42" uly="1212" lrx="846" lry="1247" /><zone xml:id="m-efb683ab-0354-4af8-88d7-5b7759e19282" ulx="40" uly="1238" lrx="699" lry="1278" /><zone xml:id="m-b377a070-e518-42f0-957d-586e85dd19e3" ulx="67" uly="1270" lrx="510" lry="1308" /><zone xml:id="m-4114e8ec-0a2a-4e26-8718-84a3a9d436bc" ulx="406" uly="1311" lrx="491" lry="1340" /><zone xml:id="m-112708e0-0cb3-4de6-a131-92cd89d5565b" ulx="59" uly="1336" lrx="845" lry="1377" /><zone xml:id="m-907c0324-1952-412e-b045-7403ede2d6d3" ulx="447" uly="1367" lrx="847" lry="1405" /><zone xml:id="m-b789f3ed-2490-4b95-bae0-7dc90b9eb126" ulx="41" uly="1368" lrx="440" lry="1405" /><zone xml:id="m-005a1ade-2160-4c47-affc-c1ddb4c74a25" ulx="41" uly="1396" lrx="437" lry="1428" /><zone xml:id="m-4223dcc8-0a38-4d7e-b727-d94e1e600777" ulx="446" uly="1396" lrx="846" lry="1428" /><zone xml:id="m-9db407b5-b534-4832-b558-432b61e6b296" ulx="40" uly="1422" lrx="631" lry="1460" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-6b1ad7f1-228c-4d74-b765-87892d3d4327" n="2287" facs="#m-adc97bb3-c1ab-49cf-9228-61d6b39e0da2" /><div xml:id="m-febfcebe-0fc4-470a-b009-0a3d2d94e646">
            <lg xml:id="m-eb64eb5c-0dcb-46c9-930b-a61044a97a9f">
              <l xml:id="m-5abc2a9a-748a-4701-8359-b28d6ae66cba" facs="#m-cecd23ee-62bf-4c59-afa6-a0e3d57ec420" label="text-like">March 22: St. Isidore the Farm-Laborer</l><l xml:id="m-8245fc1a-aabf-4dde-8dd8-629a57606528" facs="#m-cfcbb3ec-764c-407f-8ca0-f5d4a31875fd" label="ambiguous">(25)</l><l xml:id="m-9616a82a-dd11-4dc3-b1ed-2524cd9cb947" facs="#m-53f232a9-c7cf-4300-ba30-24b44d3cf3cf" label="text-like">In some other dioceses, the Proper Mass.</l><l xml:id="m-430e296d-f307-4307-bc15-e06553ca6995" facs="#m-3b1ed6ec-34fc-46b7-a490-53013f85ed06" label="lyrics-like">Collect. Deus, qui beátam Catharinam. p. (24).</l><l xml:id="m-ea745d90-8bd2-4110-b6c2-54a5738bc2ea" facs="#m-85504a3a-49dc-4bdb-90c4-d7753a3036d7" label="ambiguous">Secret</l><l xml:id="m-2d7c0597-5c09-4121-80cf-9e8be558871a" facs="#m-677a16ef-18fd-4ebd-9741-f1524e9c0785" label="lyrics-like">sacrifíciis, quaésumus, intercedénte, spíritum in nobis</l><l xml:id="m-9b13aede-5cd8-43b4-b8e9-05211f2fb8f3" facs="#m-0377efe3-7d03-4bef-9f91-bdda9f21ee21" label="lyrics-like">Lt omnipotens Deus, propitiátus tuae dilectiónis accénde. Per</l><l xml:id="m-86abcf58-cff8-4642-be85-87a54494a6de" facs="#m-347de501-a26c-47ae-8f2c-c608829f3135" label="lyrics-like">inténde: et, beáta Catharina Dóminum.</l><l xml:id="m-249dfc28-113d-4b6c-a477-e25992410dcb" facs="#m-9889e3fc-b04b-4607-815f-9936b3b59342" label="ambiguous">Postcommunion</l><l xml:id="m-f52bd7d1-a483-4608-b520-ed3c9f16b9cd" facs="#m-37c237e5-d147-4179-9d04-1083a2c46908" label="lyrics-like">Upplices te rogámus, omni-tribuas pro tui amóre terréna</l><l xml:id="m-3043ee42-6be6-4622-a9e4-f1ed8a5d41d0" facs="#m-c855bc6b-5efa-4953-8a87-fb36062d8afb" label="lyrics-like">O potens Deus: ut, quos tuis despiceré; et caeléstium semper</l><l xml:id="m-209605c8-b4b7-4e68-8210-4637ab6c9d64" facs="#m-c1d88700-504c-4827-a469-3e6763fb0633" label="lyrics-like">reficere dignátus es sacraméntis, participatióne gaudére. Per Dó¬</l><l xml:id="m-58229d48-25e2-4de1-8444-803592fbdf5c" facs="#m-a6c81463-ebb0-4843-bcfd-a8e196ff86b4" label="lyrics-like">intercedénte beáta Catharina, minum nostrum.</l><l xml:id="m-7ee2a6eb-a16f-484e-b694-3f32d1f12b73" facs="#m-a3fe536e-7e84-4030-a9b7-f9130e0d996f" label="ambiguous">MARCH 22</l><l xml:id="m-746717ea-b33c-45b0-9d26-ebf3e6c6459f" facs="#m-89af7ff4-eb65-49be-a4c1-5eaeac7d4d20" label="text-like">St. Isidore the Farm-Laborer, Confessor</l><l xml:id="m-bc4e75f4-e9c0-427e-bb24-04d2078e21a8" facs="#m-1a49b4dc-6cf6-480e-abb9-06279509edf2" label="ambiguous">III elass</l><l xml:id="m-c694477e-729a-44c2-90fc-1d6b5caae72d" facs="#m-7589bd3b-b533-4cdb-9f2a-50ff3625ef33" label="text-like">In all dioceses of the United States</l><l xml:id="m-39a0e41b-2fc4-46ac-91aa-12fa1f687b79" facs="#m-08712edf-15fe-4abb-9d45-d9dd7f206d78" label="text-like">AT MASS</l><l xml:id="m-b09cb564-38d7-44bb-859b-617f47614b63" facs="#m-2f6d7933-b123-4ca2-a386-c209629e7e53" label="lyrics-like">Mass. Jústus ut pálma. p. 1204, except the following:</l><l xml:id="m-a67d634b-ea5c-4938-afce-c4bd8c366f35" facs="#m-49dc0471-94d1-4128-9116-caca0678e2bc" label="ambiguous">Collect</l><l xml:id="m-308361cd-8ee6-4ffc-bce0-54192eb871d5" facs="#m-28bbb25b-bf43-4fb4-870c-9e44eb9595ef" label="lyrics-like">A nobis, quaésumus, misé- ejus méritis et exémplis * plácita</l><l xml:id="m-c08b7951-2efa-444e-9c5c-bfa085473dcb" facs="#m-44a4bd7e-7ee3-4f8d-a6c0-50240024c8f0" label="lyrics-like">U ricors Deus: beáto Isidóro tibi semper humilitâte deservire.</l><l xml:id="m-e6ddb9d9-5d20-4c15-8ad0-2d6cfe138314" facs="#m-ff675865-7a04-4618-85e7-35fb214a46b6" label="lyrics-like">Agricola Confessóre tuo interce- Per Dóminum nostrum Jesum</l><l xml:id="m-61f72b76-78f3-49ca-8d7c-92a261e74bc7" facs="#m-d36b00ec-c8a2-4ff2-9e4e-49dc84c93020" label="lyrics-like">dénte, supérbe non sápere: t sed Christum.</l><l xml:id="m-628018e7-9929-4af3-abb0-4c9ea51b4038" facs="#m-bfaf72fe-df6b-4356-b763-570eeb58d1fa" label="ambiguous">Lectio Epistolae beati Jacobi Apostoli James. 5, 7-8, 11, 16-18</l><l xml:id="m-8d77219d-5736-4c78-b481-9e80350e2e04" facs="#m-48baf705-e9a4-42c3-9d8b-f99ad6c78b2a" label="lyrics-like">VRatres: Patiéntes estóte usque miséricors Dóminus est, et mise¬</l><l xml:id="m-9076d311-5685-4f2b-9bf8-2ab59b4ad854" facs="#m-b211a90c-39ff-40bf-812f-edabb243492e" label="lyrics-like">ad advéntum Dómini. Ecce rátor. Confitémini ergo altéru¬</l><l xml:id="m-fcd4c48d-b95e-48a6-812e-fb3281c40492" facs="#m-d094081b-d824-4293-81f5-5af71f558bfa" label="lyrics-like">agricola exspéctat pretiósum fru¬</l><l xml:id="m-832d3836-7871-47a3-b0b7-d9e3dae5f172" facs="#m-4c1e6114-be25-4d45-816b-6fe3f1792782" label="lyrics-like">trum peccáta vestra, et oráte pro</l><l xml:id="m-efaf2c84-a2a2-4c10-8f2a-334aa8639879" facs="#m-5effde1b-ba59-4bc1-bc70-13d2f9d4e034" label="lyrics-like">ctum terrae, patiénter ferens,</l><l xml:id="m-9a81965e-efbf-41a4-9c66-7d77c08fa254" facs="#m-ae45eb12-14d8-4b02-bc6a-bfa3fd301ca2" label="lyrics-like">invicem, ut salvémini : multum</l><l xml:id="m-b92f5b52-3483-4df2-84c7-fcbcd3b44981" facs="#m-8728bd4f-704b-4290-a683-5a4a5cfe2dea" label="lyrics-like">donec accípiat temporáneum et enim valet deprecátio justi assí¬</l><l xml:id="m-f55042e0-0daf-4b23-abc3-ec570f1e3123" facs="#m-9d5f86f9-fe69-4d3a-a158-8c7e73bc361c" label="lyrics-like">serótinum. Patiéntes igitur estóte dua. Elias homo erat similis</l><l xml:id="m-91e5aac4-1297-4e1a-9547-61e58efe1fae" facs="#m-91f1e86a-6556-42ef-8c03-a8180ac2375b" label="lyrics-like">et vos, et confirmáte corda nobis, passíbilis: et oratióne</l><l xml:id="m-3f4afa83-b199-4390-b42c-819d6c891b7d" facs="#m-ad859ea5-f389-4c55-bd03-8d3699f83e51" label="lyrics-like">vestra. quóniam advéntus Dó-orávit, ut non plúeret super</l><l xml:id="m-96888884-8923-436b-9018-71fa51dbe6a1" facs="#m-dd46b3b3-9af9-4892-a422-596b58088cb3" label="lyrics-like">mini appropinquávit. Ecce beati- terram, et non pluit annos tres,</l><l xml:id="m-ca1cfa4a-5001-4886-b917-b30c2230aa19" facs="#m-fa2b7be9-b9c8-4789-9f91-78ade701e320" label="lyrics-like">ficámus eos qui sustinuérunt. et menses sex. Et rursum orávit,</l><l xml:id="m-22b921cd-c264-40b4-92da-ee2e22e1367e" facs="#m-245be37a-3987-44d6-9f4a-502c4c8ff711" label="lyrics-like">Sufferéntiam Job audístis, et et caelum dedit plúviam, et terra</l><l xml:id="m-391d5b0a-0b7c-452b-87fa-2ca09adcae7f" facs="#m-efb683ab-0354-4af8-88d7-5b7759e19282" label="lyrics-like">finem Dómini vidistis, quóniam dedit fructum suum.</l><l xml:id="m-27964ad3-c0d2-4ff3-87f2-281d88e1a1ac" facs="#m-b377a070-e518-42f0-957d-586e85dd19e3" label="ambiguous">Gospel. Ego sum vitis vera. p. 1148.</l><l xml:id="m-aa6bd428-b45d-4feb-a57c-1fe7f00a1d5d" facs="#m-4114e8ec-0a2a-4e26-8718-84a3a9d436bc" label="ambiguous">Secret</l><l xml:id="m-a25f03e4-0308-454b-bf80-93d85840a9f8" facs="#m-112708e0-0cb3-4de6-a131-92cd89d5565b" label="lyrics-like">ORopitiáre, Dómine, supplica-Confessóre tuo, quod fidéliter</l><l xml:id="m-e606647a-b6b2-4049-844d-0ecd708b98f0" facs="#m-907c0324-1952-412e-b045-7403ede2d6d3" label="lyrics-like">pétimus, efficáciter consequá¬</l><l xml:id="m-4690287f-55b4-45d6-87fe-2027ca523039" facs="#m-b789f3ed-2490-4b95-bae0-7dc90b9eb126" label="lyrics-like">Ltionibus nostris, et has pópuli</l><l xml:id="m-3d31f5b4-c4fd-4691-95b9-bd5fb86fdcd5" facs="#m-005a1ade-2160-4c47-affc-c1ddb4c74a25" label="lyrics-like">tui oblatiónes benignus assúme:</l><l xml:id="m-c74c0c18-3038-4a4c-990f-a3a9a0d06bc8" facs="#m-4223dcc8-0a38-4d7e-b727-d94e1e600777" label="lyrics-like">mur. Per Dóminum nostrum Je¬</l><l xml:id="m-4f28a271-2594-4fe7-8192-d21d5372aec9" facs="#m-9db407b5-b534-4832-b558-432b61e6b296" label="lyrics-like">ut, intercedénte beâto Isidóro sum Christum.</l></lg></div></section></score></mdiv></body></music>
</mei>