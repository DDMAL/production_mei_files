    <body xml:id="m-d5e1f3ac-5564-41e6-a9c5-a1712b2fb44b">
      <mdiv xml:id="m-cb50967e-dec4-4e8e-abd7-c2d504d2b380" type="solesmes">
        <score xml:id="m-58e86076-fdb5-46f3-931c-86bd505a355a">
          <scoreDef xml:id="m-41d9e6bd-9de5-4d36-b219-4c143f00f96d">
            <staffGrp xml:id="m-8d3a3eeb-7af8-4843-ad99-2fca1fba1e63">
              <staffDef xml:id="m-b5e21770-7d98-4572-b69f-26e4db8cfbc4" n="1" notationtype="neume" lines="4" />
