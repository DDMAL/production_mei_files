                <syllable xml:id="m-0b8404d8-24e9-4d2f-b7e0-5ebd5623baf0">
                  <syl /><neume facs="#m-9f223e2d-461e-4b56-a72e-f420cf083eac" type="punctum" xml:id="m-a88d37da-4d97-4075-af8f-6e28d73ebb6e">
                    <nc xml:id="m-d8315d89-556f-4a01-89e5-43c1a9108296" pname="a" oct="3">
                      <signifLet xml:id="m-0cddf0d1-9b2f-411c-b383-1a17d22ae4a0" />
                    </nc>
                  </neume>
                </syllable>
                <divLine xml:id="m-4e2f7407-f40f-4dbb-8c96-e7ea8578b4fe" facs="#m-305ca35c-69a9-4e5b-8699-d45d42d15352" form="minima" />
                <syllable xml:id="m-6c55868f-5f73-421d-b661-67318026e1d5">
                  <syl /><neume facs="#m-40efb4df-e233-4061-89c5-703cc4adf12d" type="punctum" xml:id="m-f2287ebb-d0ed-4b3e-a7ca-764c3b6f572c">
                    <nc xml:id="m-da29b944-da5c-410c-a185-66969fd0698a" pname="b" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-f9539c48-1cda-4e99-b68d-1e4cea50be48">
                  <syl /><neume facs="#m-ecf92fc2-a4b0-46d3-a174-3fa48662adcc" type="virga" xml:id="m-7f7df5d5-4b37-43b6-8060-6a17000a7ee2">
                    <nc xml:id="m-da73dbcb-ec95-4652-b590-6d2f72001756" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-5fded74e-dc04-469c-bfc6-64966636321b">
                  <syl /><neume facs="#m-233c4417-514f-4065-ae1f-4e7df37c3f91" type="torculus" xml:id="m-50b29c17-b87d-40a1-9c41-5eef04a68c33">
                    <nc xml:id="m-b2647ab6-8258-46b1-8237-c69325c269a5" pname="g" oct="3" />
                    <nc xml:id="m-c6ec875d-94dd-4142-ba7c-4e285fc74395" pname="b" oct="3" />
                    <nc xml:id="m-e4c1ed82-a942-4d10-8630-2105bf5d232e" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-588155cb-0eff-4540-8ae6-2ddf62903f27">
                  <syl /><neume facs="#m-41a8dead-d5b7-4770-8624-d11e3ca73296" type="torculus" xml:id="m-5ce22f88-d834-43d9-b8c7-f3ee6d5eeaff">
                    <nc xml:id="m-eeae52f4-56a4-4aae-8595-441535f4542d" pname="f" oct="3" />
                    <nc xml:id="m-07630fbe-98d0-4841-8e2d-d8608119a689" pname="g" oct="3" />
                    <nc xml:id="m-bf0b2a22-ee69-476b-b4c1-09bc8ed2cefc" pname="f" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-10b41aad-11e4-43f5-9111-15634b6c49ce">
                  <syl /><neume facs="#m-be96c718-69ea-4515-8019-52dc8a41c62c" type="punctum" xml:id="m-815e398a-3ccc-475f-a3f4-f5e9344b95df">
                    <nc xml:id="m-daff8ddf-a4d1-489b-bcd1-7d4695fe539b" pname="f" oct="3" />
                  </neume>
                </syllable>
                <divLine xml:id="m-1cb22e75-8875-48a5-9f4e-10899db33da9" facs="#m-75159f77-6423-463f-8e84-1dcf0dd64c11" form="finalis" />
              </layer>
            </staff>
            <div xml:id="m-783b4baa-628f-4eeb-9810-380a0662162c">
              <lg xml:id="m-1a23e8b7-0ae6-4028-a9f9-cb83dc07b26e">
                <l xml:id="m-be05f281-f411-4f10-9adf-7300e40c1738" facs="#m-0d401c7e-f2e9-4901-8d6d-22a59a4048d3" label="text-like">Low Sunday.</l><l xml:id="m-12696c45-2ae5-4756-8f7a-c3aac7c251bc" facs="#m-392ec8b6-e2b6-4764-aef5-4b167e1ab00f" label="ambiguous">su</l><l xml:id="m-e6a87fa7-447a-4aeb-8ce3-8e8fadb89d05" facs="#m-7719e58d-3982-42ed-8f0a-7121ad79782a" label="lyrics-like">sus. Dixérunt ergo ei álii discípuli:</l><l xml:id="m-422c839f-d214-4762-849b-9b1dc8f557df" facs="#m-7c778e28-4e67-4992-b835-bd9831987b5d" label="lyrics-like">incrédulus, sed fidélis. Respóndit</l><l xml:id="m-a8642f82-871a-4c64-9ff6-838e00ed6af2" facs="#m-7c62b47a-0708-4a49-9129-fc8d3018ad46" label="lyrics-like">Vidimus Dóminum. Ille autem di¬</l><l xml:id="m-23c79a10-f065-40e7-899e-da70ff29ed2f" facs="#m-bea4ed9b-769d-4c6c-b2f4-c0202ff2dead" label="lyrics-like">Thomas, et dixit ei: Dóminus</l><l xml:id="m-b4b3db44-e94d-42df-bad1-d963ac5de1a2" facs="#m-9f240244-1f90-4581-b9db-39476d85c375" label="lyrics-like">xit eis: Nisi vídero in mánibus eius</l><l xml:id="m-01ee8202-378c-414b-8a84-6af951ca2e74" facs="#m-89fc443e-25fa-4a64-94f1-d62abdf1c240" label="ambiguous">meus, et Deus meus. Dixit ei Jesus:</l><l xml:id="m-191a8507-c217-479a-9b97-f0eb7de5ae4f" facs="#m-d9448134-5237-4da7-9789-0986531a0b5c" label="lyrics-like">fixúram clavórum, et mittam dí¬</l><l xml:id="m-3ded65db-93d8-4250-a9c4-4160970b91cf" facs="#m-91341819-733c-4b20-8f93-a8a89c854519" label="ambiguous">Quia vidisti me, Thoma, credidisti:</l><l xml:id="m-0c6ab15a-2727-4e0f-8159-58ec934012cc" facs="#m-ba27b9da-4c7d-46de-8a63-1503130694f1" label="lyrics-like">gitum meum in locum clavórum, et</l><l xml:id="m-176cd895-7343-4886-88aa-4f01140c7545" facs="#m-53b77db4-310e-4215-bbcb-d0afaf93edbf" label="lyrics-like">beáti, qui non vidérunt, et credidé¬</l><l xml:id="m-1e22df0e-3d95-43e1-9e43-2837dccf0e7b" facs="#m-b8ac5e04-9b53-4579-8583-f8acc09658ed" label="ambiguous">mittam manum meam in latus ejus</l><l xml:id="m-3a400e3b-7927-4988-9a41-7a6c3a9af695" facs="#m-49a65a20-1673-4f01-8bc1-00025178d147" label="lyrics-like">runt. Multa quidem et ália signa</l><l xml:id="m-264b49f5-6c27-4055-92e5-a84e3035969e" facs="#m-9331d36a-ef97-45e9-b59b-99abc9a1017e" label="ambiguous">non credam. Et post dies octo, ste¬</l><l xml:id="m-cba0625c-5a17-4387-b465-3deedeb0f990" facs="#m-2c6a8f13-3eed-408d-9821-6d9faac0e632" label="lyrics-like">fecit Jesus in conspéctu discipuló¬</l><l xml:id="m-de499d63-4df6-4201-a453-4ff0ad268192" facs="#m-3443bcb5-1905-432c-83e4-24514110733a" label="lyrics-like">rum erant discípuli ejus intus, et</l><l xml:id="m-539b5047-d5d7-4bc8-9f9d-5e6508d31d06" facs="#m-6922bcd2-2ce4-46a5-8a56-7331e4545f80" label="lyrics-like">rum suórum, quae non sunt scripta</l><l xml:id="m-97dfc972-f894-4b5e-b9b4-7e293854416a" facs="#m-a51d5ac3-1d83-46e8-bd27-158d37f40456" label="lyrics-like">Thomas cum eis. Venit Jesus jánuis</l><l xml:id="m-5b26fa56-792c-42fe-9b9d-beeccdcaf00f" facs="#m-82f549cc-4fa5-4116-8cb5-514304d39fdb" label="ambiguous">in libro hoc. Haec autem scripta</l><l xml:id="m-8de1363a-c4c3-4a27-bf0c-dcb5ba6b52be" facs="#m-952dbeeb-663c-414c-9e4a-61a21c8d8cc6" label="lyrics-like">clausis, et stetit in médio, et dixit:</l><l xml:id="m-d5668c4a-5c63-40b6-a315-edc0982f3ce4" facs="#m-85ced872-1271-4d86-90b3-3cc874f6e86d" label="lyrics-like">sunt, ut credátis, quia Jesus est</l><l xml:id="m-67f1076c-f10e-4c12-90df-8d45015f3132" facs="#m-1cfae1d4-7022-406a-b5fe-ecab2977c2fe" label="ambiguous">Pax vobis. Deinde dicit Thomae:</l><l xml:id="m-0825a470-db99-4e41-858b-359f1dec613a" facs="#m-40249eac-7c6a-407d-956e-0c12778f91cd" label="lyrics-like">Christus Filius Dei: et ut credén¬</l><l xml:id="m-bf2aa84e-6b58-40ed-8601-f0624456392b" facs="#m-e9fde0c6-82c4-4157-96eb-6947a4a912b2" label="ambiguous">Infer digitum tuum huc, et vide</l><l xml:id="m-59822ec8-4c7e-47d9-beb1-5d7ac2e0497b" facs="#m-cff55574-61c7-4bd4-9c27-24eceef27cc9" label="lyrics-like">tes, vitam habeátis in nómine ejus.</l><l xml:id="m-dac354a0-10e1-4db1-8739-f8a9951affbf" facs="#m-c67620e8-84df-4d4d-87eb-911dd10fdabf" label="ambiguous">manus meas, et affer manum tuam,</l><l xml:id="m-58acb417-c56d-4b19-b8af-f97cad0699f4" facs="#m-b569e456-71c9-41b0-8e93-4f5738a6e8f9" label="ambiguous">Credo.</l><l xml:id="m-ec19b33e-be37-442e-b691-6c5705cf141f" facs="#m-1881e648-32e3-4242-87d3-d4e035c8a28f" label="ambiguous">et mitte in latus meum: et noli esse</l><l xml:id="m-4ce1fd3b-97b4-427a-a7e8-03267cda8aa5" facs="#m-e5cebc58-3402-42d4-9711-a0046b6f9895" label="lyrics-like">Offertory. Angelus Dómini. p. 787.</l><l xml:id="m-3cf1176d-33c9-467a-b61c-6eed41195f6f" facs="#m-fe99e2bf-1bf9-4cdb-9aa2-a87dd8a26441" label="ambiguous">Secret.</l><l xml:id="m-59df148a-7f28-4afe-9a1d-b1acc342af06" facs="#m-36db9cd6-c42f-479d-bc58-b62cba3ea9a7" label="lyrics-like">NUscipe múnera, Dómine, quaé-[tísti, perpétuae fructum concéde</l><l xml:id="m-d0cd3798-9e2d-4a85-bd00-601974d23773" facs="#m-ccf9aa01-8e37-44f3-b62b-7861d136b9da" label="lyrics-like">O sumus, exsultántis Ecclésiae:] laetitiae. Per Dóminum nostrum.</l><l xml:id="m-3327c467-087f-4c39-86ad-e7b8a8448d66" facs="#m-c5c01de5-6419-4940-9f95-465f221462bd" label="lyrics-like">et cui causam tanti gáudii praesti¬</l><l xml:id="m-fee78e94-319c-4087-a15b-085e2a05e944" facs="#m-d8e9e61e-cf3e-4556-9fbb-40618a710b32" label="text-like">Preface. Easter Sunday, p. 8.</l><l xml:id="m-057e4b55-f4bc-478d-bf22-e685f228ae64" facs="#m-76b87869-8f9a-44a2-9511-e5fe34221b83" label="ambiguous">comm.</l><l xml:id="m-d10c5831-9aef-4dfb-8e27-656891a40319" facs="#m-9d781f4c-07ec-4146-8d88-61f6495dca94" label="ambiguous">6.</l><l xml:id="m-f196853b-7529-44e5-90a6-fafd56b3e054" facs="#m-875ded02-46ae-4d70-af52-5bec0f7d2236" label="lyrics-like">It-te" mánum tú-am, et cognósce lóca clavó¬</l><l xml:id="m-596c539a-c650-4306-a2db-d8eb6c8cea20" facs="#m-1c54e3e2-f2a3-47c9-a978-d4702489b334" label="lyrics-like">rum, alle-lú- ia: et nó-li ésse incrédu-lus, sed fidé¬</l><l xml:id="m-32ed7f8b-d18b-479a-ac6f-9c5d02ee0974" facs="#m-27b6d493-d620-449d-b964-f6aeae94e818" label="lyrics-like">lis, alle-lú-ia, alle¬ lú- ia.</l><l xml:id="m-51737ac9-bc23-4b14-b4df-006a130f50ef" facs="#m-73274b3c-61fb-4760-868a-d107aa3567f8" label="ambiguous">Postcommunion.</l><l xml:id="m-9dc160d8-a6a2-45da-944c-3ea5e9fbb612" facs="#m-481936e5-2116-452b-89b7-1b221b46e142" label="lyrics-like">Uaésumus Dómine Deus noster:]contulísti, et praesens nobis remé¬</l><l xml:id="m-5b87764e-395f-4602-9f00-67bd38c7ca58" facs="#m-9f28eb7f-3ada-4d0e-a874-59fc43cac9ba" label="lyrics-like">Uat sacrosáncta mystéria, quae dium esse fácias, et futúrum. Per</l><l xml:id="m-4bfa4c10-b571-44e7-96d5-216f5a96ea7b" facs="#m-da5a2c6d-37ec-4265-aecd-9dabc1271268" label="lyrics-like">pro reparatiónis nostrae munimine! Dóminum.</l><l xml:id="m-2b522fb1-ec32-4937-9f9c-49eacdb3eecf" facs="#m-8c795320-370f-4e44-ae9b-c8eb51aba7d8" label="text-like">AT SEXT.</l><l xml:id="m-3dd1520f-6c90-43c0-851d-56e21def41ab" facs="#m-faa86df4-60b0-47da-b61f-b6e6fef76c16" label="lyrics-like">Ant. Allelúia. as in the Psalter for Paschal Time, p. 241.</l><l xml:id="m-9f265e33-35a2-490f-9ccc-4f2134dd89cb" facs="#m-00ed160d-a2c3-49b7-a536-7d965dbd8d81" label="ambiguous">Chapter.</l><l xml:id="m-d02fc5ef-f5c2-40bc-b982-644043a13970" facs="#m-e4b4e0c3-5ca8-4940-8d48-c1e6e3e4ca1c" label="ambiguous">1.Joann.5.</l><l xml:id="m-e7a9bf22-ec55-40ad-912e-5c6e9436c994" facs="#m-fcef2ca5-6989-4277-a889-1968ce00a8b5" label="lyrics-like">Uis est autem qui vincit mun-lvenit per aquam et sánguinem, Je¬</l><l xml:id="m-f1711102-9157-4976-a427-7362f046e849" facs="#m-82490be3-0426-4de0-9b67-4f3f5fcbc6ef" label="lyrics-like">Udum, t nisi qui credit quóniam! sus Christus:* non in aqua solum,</l><l xml:id="m-fa3eb722-926e-4391-99f6-46ebd6ff8776" facs="#m-d7137a62-4135-4e09-aca0-8ea29ec44e3a" label="lyrics-like">Jesus est Filius Dei? Hic est quil sed in aqua et sánguine.</l><l xml:id="m-fb2b1008-13ad-432d-b4f0-88d212566a67" facs="#m-4ba2b4eb-6bc4-45f3-8519-300646ac9a83" label="lyrics-like">Short Resp. Surréxit Dóminus vere. p. 244. Y. Gavísi sunt.</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>