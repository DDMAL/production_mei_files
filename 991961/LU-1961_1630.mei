985" lry="595" /><zone xml:id="m-f362d3f3-80a4-4987-b21f-6f02560edb62" ulx="121" uly="584" lrx="985" lry="620" /><zone xml:id="m-8e435c15-c87e-42d0-8217-7d58c0e3f890" ulx="118" uly="617" lrx="986" lry="644" /><zone xml:id="m-8fe1f057-2880-41f4-8afb-c5b9aae0b56a" ulx="118" uly="638" lrx="659" lry="675" /><zone xml:id="m-2cc40097-9288-445d-a926-654fdc68d89f" ulx="118" uly="702" lrx="984" lry="748" /><zone xml:id="m-c2967d4c-6c60-47af-8d4a-98f91d08b779" ulx="502" uly="741" lrx="603" lry="778" /><zone xml:id="m-85137956-0396-4e6b-8f78-a36426dfce52" ulx="142" uly="785" lrx="982" lry="828" /><zone xml:id="m-ada7d8a6-17a8-4122-8647-fa4c0b180c81" ulx="142" uly="832" lrx="501" lry="873" /><zone xml:id="m-8b3924a4-b9da-4a1e-81e2-b0c8bf904372" ulx="146" uly="865" lrx="365" lry="900" /><zone xml:id="m-3d5d4f23-f4f8-465e-8d6f-a15562bd113a" ulx="497" uly="898" lrx="604" lry="931" /><zone xml:id="m-b9e1be07-f75b-4ebc-8275-30b8852c415d" ulx="153" uly="929" lrx="984" lry="968" /><zone xml:id="m-6a807095-7207-4018-82f9-99ade32590f7" ulx="122" uly="956" lrx="986" lry="996" /><zone xml:id="m-aedf3d68-8670-490b-bdec-802145f3c43b" ulx="117" uly="986" lrx="925" lry="1024" /><zone xml:id="m-01f631c0-941a-490a-9637-63573fe59cb0" ulx="504" uly="1026" lrx="603" lry="1061" /><zone xml:id="m-c2ee4956-3a6f-4fc5-8b3b-a5e2c633f22e" ulx="158" uly="1058" lrx="988" lry="1099" /><zone xml:id="m-20f11e47-aab3-48c9-808c-79cce0e16506" ulx="122" uly="1089" lrx="546" lry="1121" /><zone xml:id="m-c05f4e39-187f-4512-873f-0f7af7523e44" ulx="554" uly="1091" lrx="985" lry="1126" /><zone xml:id="m-b9c8ae71-c423-4906-ab59-48fa930168a1" ulx="118" uly="1115" lrx="858" lry="1153" /><zone xml:id="m-5f016eb4-2cb0-470a-baba-fafbbfa6564d" ulx="436" uly="1157" lrx="676" lry="1191" /><zone xml:id="m-ba696e02-c6b2-48bd-8b04-002951e0ab14" ulx="141" uly="1192" lrx="987" lry="1227" /><zone xml:id="m-fe668d41-a32e-42b4-a183-6d0e74d0d120" ulx="120" uly="1218" lrx="548" lry="1255" /><zone xml:id="m-b59171a1-0c96-41b8-8e35-e266d13eba46" ulx="558" uly="1220" lrx="986" lry="1256" /><zone xml:id="m-e672a6b0-4b8e-45e2-a982-8a5c7a855416" ulx="119" uly="1246" lrx="551" lry="1278" /><zone xml:id="m-ac6cc05a-8143-4f98-81e6-1f58f8ff9633" ulx="556" uly="1247" lrx="692" lry="1283" /><zone xml:id="m-6f86d7bb-2cc2-4689-9a9e-3e74d80b7170" ulx="120" uly="1273" lrx="550" lry="1309" /><zone xml:id="m-d7187bb0-e7be-4775-8262-6d3b123ce787" ulx="352" uly="1344" lrx="746" lry="1392" /><zone xml:id="m-2d6d44c8-10a2-4c4e-a2d3-e6136f090160" ulx="122" uly="1345" lrx="179" lry="1387" /><zone xml:id="m-d1b8af54-147c-4335-9c76-761d384ecfaf" ulx="825" uly="1353" lrx="987" lry="1391" /><zone xml:id="m-260bc693-c79d-4b29-9d01-df5cb946f9de" ulx="498" uly="1392" lrx="611" lry="1427" /><zone xml:id="m-e2206271-5b9d-478b-9d25-075fa04970b4" ulx="162" uly="1425" lrx="988" lry="1466" /><zone xml:id="m-85d49aeb-1935-4bec-b733-3099fd6ced6d" ulx="121" uly="1456" lrx="986" lry="1492" /><zone xml:id="m-875534c4-fc17-4a20-8536-0ef1fc89a264" ulx="119" uly="1485" lrx="938" lry="1521" /><zone xml:id="m-41a84446-f769-41cd-867d-ce5ef206feb3" ulx="143" uly="1515" lrx="937" lry="1555" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-173c0504-fee5-4983-8f84-54c8c92bbc3d" n="1630" facs="#m-827a8f78-21f2-47db-98a9-071968fabd02" /><div xml:id="m-09571edb-ac02-4a32-a57c-19be7815ddc1">
            <lg xml:id="m-cdf5e47f-70ed-4da6-a4f3-67b578235a97">
              <l xml:id="m-419024e6-5f85-4ec3-828b-4a7cf4d3be81" facs="#m-7eef45f2-b11b-4aab-ac5d-e2079469571c" label="ambiguous">142e</l><l xml:id="m-284abda2-214f-4c90-a5ee-8702f81743a8" facs="#m-4430935d-7283-4e09-8d9f-c83d4c28ead9" label="ambiguous">April 4. S. 11. 13.</l><l xml:id="m-e5b5c4e7-2004-4a84-b8d4-a3db8d1c328e" facs="#m-4d2326a8-9cbc-4bee-8a7b-c0722c7bb7d6" label="text-like">4. St. Isidore, Bishop, Confessor, and Doctor of the Church.</l><l xml:id="m-e8294513-002a-44a3-8654-954f630a9d23" facs="#m-10f0e519-0d4b-4ba1-b4b8-3ad99c4d2884" label="ambiguous">Double.</l><l xml:id="m-ade11135-9d2f-4358-a146-f5a1981b0376" facs="#m-48c925c7-3f27-43e3-a182-bf7621b470c5" label="lyrics-like">At ist and 2nd Vespers, at Magn. Ant. O Dóctor... beâte Isidóre. p. 262s.</l><l xml:id="m-a56b400d-8e4a-424c-9c7b-35c9a1442c06" facs="#m-b30e1b17-1372-4ace-83d1-6caf587806b7" label="lyrics-like">Mass. In médio. p. 1190.</l><l xml:id="m-2da45c28-c0ea-4f0c-a7f1-8cc4da0a780e" facs="#m-7e3f2c54-1d19-4e4c-bdb6-e00f71f5fab0" label="text-like">The Credo. Is said.</l><l xml:id="m-18911245-98b5-41b5-8e73-103f351b6eba" facs="#m-3fdb0ed9-6506-4977-8de2-b95137e020ab" label="ambiguous">Collect.</l><l xml:id="m-bd1baa4d-9405-41e1-8058-34fe8d958b76" facs="#m-0997a1f6-ee29-4f0f-ac10-95b5795f19a8" label="lyrics-like">Eus, qui pópulo tuo aetérnae búimus in terris,“intercessórem</l><l xml:id="m-df216e8d-1096-485c-a683-accc9ef3960c" facs="#m-a9ece373-afee-47ee-8242-f857144ee3bc" label="lyrics-like">I salútis beátum Isidórum miní¬</l><l xml:id="m-ccdf97f4-0cb4-421e-ab4e-accf2fd431bb" facs="#m-90d3d75e-6632-45e1-bb54-e00a9ee4a492" label="lyrics-like">habére mereámur in caelis. Per</l><l xml:id="m-93c6f2d8-0236-4aff-89a6-9eac3dd3ba3d" facs="#m-99ab8903-7da3-4a90-a281-9d037a68cea9" label="lyrics-like">strum tribuísti : t praesta, quaésu¬</l><l xml:id="m-d571b4a9-703e-42c4-a1b3-18400bff4136" facs="#m-393414a8-4aae-4375-8d02-fea422e66e49" label="lyrics-like">Dóminum.</l><l xml:id="m-d00c79c2-1265-4525-b022-7ba9b33bab1b" facs="#m-3a3d5ab8-5dcb-43ee-ba21-131bf852b8f9" label="lyrics-like">mus; ut quem Doctórem vitae ha¬</l><l xml:id="m-5bf3181c-0486-433a-8ab9-ebe1480a72c7" facs="#m-4122ffe2-6907-44ed-9f83-1a2bfa1816b1" label="ambiguous">St. Vincent Ferrer, Confessor.</l><l xml:id="m-5e0a9ca1-76a4-4dd0-b835-a63e5e5ca3b1" facs="#m-f7af8007-241c-4780-8103-479481ea4988" label="ambiguous">5.</l><l xml:id="m-9e9a04c0-2118-4c19-9bf6-f507ee092461" facs="#m-f1d60cf0-728a-49f4-b484-88cd88390d09" label="ambiguous">Double.</l><l xml:id="m-926a15c7-1689-4663-8a1c-6d745a4b23c6" facs="#m-cb1c12d6-1151-47b6-bbd2-f6cbcbeb7c36" label="lyrics-like">Mass. Os jústi. from the Common of a Confessor not a Bishop, p. 1200.</l><l xml:id="m-a2caa713-ae73-4808-826e-edfd965c1fdc" facs="#m-58b13f66-c19c-431a-86f3-ecc48b44b88f" label="ambiguous">Collect.</l><l xml:id="m-04f0495d-2f2a-4fe1-bf03-a447900c462d" facs="#m-f7964d48-842d-4b62-8d8c-ae4b765aabd0" label="lyrics-like">Eus, qui Ecclésiam tuam beáti tuis; ut et ipsius instruámur exém¬</l><l xml:id="m-b22085ff-d251-450b-bdd7-ede6de6c492d" facs="#m-f362d3f3-80a4-4987-b21f-6f02560edb62" label="lyrics-like">U Vincéntii Confessóris tui méri-l plis, * et ab ómnibus, ejus patro¬</l><l xml:id="m-be32e040-87be-4d04-bd9f-738cab216d13" facs="#m-8e435c15-c87e-42d0-8217-7d58c0e3f890" label="lyrics-like">tis et praedicatióne illustráre digná-] cínio, liberémur advérsis. Per Dó¬</l><l xml:id="m-56139e4d-9461-481e-9d5d-74ae1fbf2a7c" facs="#m-8fe1f057-2880-41f4-8afb-c5b9aae0b56a" label="lyrics-like">tus es: t concéde nobis fámulis minum.</l><l xml:id="m-adb6d8fa-cd37-4676-acc2-04d6bc53020e" facs="#m-2cc40097-9288-445d-a926-654fdc68d89f" label="text-like">11. St. Leo I, Pope, Confessor, and Doctor of the Church.</l><l xml:id="m-afd79168-10c5-4751-8dde-9aafb23a9acf" facs="#m-c2967d4c-6c60-47af-8d4a-98f91d08b779" label="ambiguous">Double.</l><l xml:id="m-abab3cbb-1378-4915-b327-109c4b3d49cf" facs="#m-85137956-0396-4e6b-8f78-a36426dfce52" label="lyrics-like">At Ist and 2nd Vespers, at Magn. Ant. O Dóctor... beâte Léo. . 22</l><l xml:id="m-37a17d50-d975-403c-b706-ec3ad583a410" facs="#m-ada7d8a6-17a8-4122-8647-fa4c0b180c81" label="text-like">Mass. Si diligis me. p. 1122</l><l xml:id="m-a488df48-790c-48e3-b794-590198b97f95" facs="#m-8b3924a4-b9da-4a1e-81e2-b0c8bf904372" label="text-like">The Credo is said.</l><l xml:id="m-10865fc3-095b-4a69-bd73-ebc2d4e155b1" facs="#m-3d5d4f23-f4f8-465e-8d6f-a15562bd113a" label="ambiguous">Collect.</l><l xml:id="m-55f2144c-ab79-41fb-b6a2-34a9ec9a8bdb" facs="#m-b9e1be07-f75b-4ebc-8275-30b8852c415d" label="lyrics-like">(Regem tuum, Pastor aetérne,) cem, perpétua protectióne custódi:</l><l xml:id="m-55b610f8-c263-4926-91fe-8257864a98a4" facs="#m-6a807095-7207-4018-82f9-99ade32590f7" label="lyrics-like">U placátus inténde: t et per quem totius Écclésiae praestitisti</l><l xml:id="m-4b1b8a9f-7c67-433a-94f9-c38c68b57874" facs="#m-aedf3d68-8670-490b-bdec-802145f3c43b" label="lyrics-like">beátum Leónem Summum Pontifi-l esse pastórem. Per Dóminum.</l><l xml:id="m-2fcd95d6-89b7-4d65-bafc-19bd7b0aedc0" facs="#m-01f631c0-941a-490a-9637-63573fe59cb0" label="ambiguous">Secret.</l><l xml:id="m-e6606440-431c-4cb4-a131-3b68ef2a76e8" facs="#m-c2ee4956-3a6f-4fc5-8b3b-a5e2c633f22e" label="lyrics-like">Blátis munéribus, quaésumus! proficiat ubique succéssus, et grati</l><l xml:id="m-bcca915c-1ed6-4ed3-a5a3-9a02ad348d5c" facs="#m-20f11e47-aab3-48c9-808c-79cce0e16506" label="lyrics-like">U Dómine, Ecclésiam tuam bení¬</l><l xml:id="m-60277f0d-0061-4a9e-8e05-b121911fb00b" facs="#m-c05f4e39-187f-4512-873f-0f7af7523e44" label="lyrics-like">fiant nómini tuo, te gubernánte,</l><l xml:id="m-c675e9d5-7f34-4cb5-b749-270609eba6eb" facs="#m-b9c8ae71-c423-4906-ab59-48fa930168a1" label="lyrics-like">gnus illúmina: ut, et gregis tuil pastóres. Per Dóminum.</l><l xml:id="m-16377399-f48f-40c1-bcc9-d67a3b568de1" facs="#m-5f016eb4-2cb0-470a-baba-fafbbfa6564d" label="ambiguous">Postcommunion.</l><l xml:id="m-3d21cf68-83f4-4b16-b3e9-b7e286440770" facs="#m-ba696e02-c6b2-48bd-8b04-002951e0ab14" label="lyrics-like">DEfectióne sancta enutritam gu-] creménta libertátis accípiat et in</l><l xml:id="m-f5ef200a-df8d-4cf8-8bf4-94d39b8db4e0" facs="#m-fe668d41-a32e-42b4-a183-6d0e74d0d120" label="lyrics-like">It bérna, quaésumus Dómine,</l><l xml:id="m-5ae097fc-4488-4ec7-bfbd-8c51e6fb2b0a" facs="#m-b59171a1-0c96-41b8-8e35-e266d13eba46" label="lyrics-like">religiónis integritáte persístat. Per</l><l xml:id="m-70da957d-2920-43e7-b545-f762c88b740d" facs="#m-e672a6b0-4b8e-45e2-a982-8a5c7a855416" label="lyrics-like">tuam placátus Ecclésiam: ut po¬</l><l xml:id="m-54ba1024-096d-401e-9cc6-1ee0ab09088d" facs="#m-ac6cc05a-8143-4f98-81e6-1f58f8ff9633" label="lyrics-like">Dóminum.</l><l xml:id="m-6e2d82a0-20f1-404b-ab55-b1a235cb7b45" facs="#m-6f86d7bb-2cc2-4689-9a9e-3e74d80b7170" label="lyrics-like">ténti moderatióne dirécta, et in¬</l><l xml:id="m-b32ef2c4-07cd-4607-9e76-9cf2e5b48acb" facs="#m-d7187bb0-e7be-4775-8262-6d3b123ce787" label="ambiguous">St. Hermenegild, Martyr.</l><l xml:id="m-f05dd88e-222b-49fb-8b1a-20bc6f4cb0b1" facs="#m-2d6d44c8-10a2-4c4e-a2d3-e6136f090160" label="ambiguous">13.</l><l xml:id="m-2368a606-42b3-4ef1-9efe-08b95417e15b" facs="#m-d1b8af54-147c-4335-9c76-761d384ecfaf" label="ambiguous">Semi-double.</l><l xml:id="m-b29ac469-2bd2-41bb-926a-917980da146d" facs="#m-260bc693-c79d-4b29-9d01-df5cb946f9de" label="ambiguous">Collect.</l><l xml:id="m-d3c4ddf8-e4e7-4cd5-8f4a-5ebf8c6b99e9" facs="#m-e2206271-5b9d-478b-9d25-075fa04970b4" label="lyrics-like">Eus, qui beátum Hermenegil-Isti : t da, quaésumus, nobis ejus</l><l xml:id="m-24e72f0f-8c27-4a26-8083-8119b493f81d" facs="#m-85d49aeb-1935-4bec-b733-3099fd6ced6d" label="lyrics-like">U dum Mártyrem tuum caelésti l exémplo cadũca despicere, * atque</l><l xml:id="m-6fe7b249-8650-4cb7-8198-4549ac559b6c" facs="#m-875534c4-fc17-4a20-8536-0ef1fc89a264" label="lyrics-like">regno terrénum postpónere docui-laetérna sectári. Per Dóminum.</l><l xml:id="m-d290bc4b-4fe1-4562-a09a-b38057633b37" facs="#m-41a84446-f769-41cd-867d-ce5ef206feb3" label="lyrics-like">Secret. Munéribus nostris. and Postcommunion. Da quaésumus. p. 1188.</l></lg></div></section></score></mdiv></body></music>
</mei>