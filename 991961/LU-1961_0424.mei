      <graphic xml:id="m-3eadf845-d43e-413f-b8e3-7223ea5b2127" target="0424_original_image.tiff" /><zone xml:id="m-68b22eff-fd25-4f37-ad79-3af0fea4fe0d" ulx="64" uly="44" lrx="114" lry="66" /><zone xml:id="m-c84dc966-4d6b-4686-8dae-93e3b7624f96" ulx="124" uly="47" lrx="443" lry="64" /><zone xml:id="m-aa4f4563-7587-457e-bd05-cab36f32951a" ulx="84" uly="69" lrx="477" lry="91" /><zone xml:id="m-39096217-52f0-440d-8920-1649cc5d666a" ulx="84" uly="87" lrx="391" lry="108" /><zone xml:id="m-e80fe22a-8743-4fa7-b352-bf129a5e52c4" ulx="82" uly="102" lrx="513" lry="128" /><zone xml:id="m-42e44df6-2963-4156-a548-b0b9c7dfe303" ulx="64" uly="118" lrx="188" lry="138" /><zone xml:id="m-98389bc5-de68-49e1-a0ac-7bda036ba890" ulx="76" uly="131" lrx="514" lry="155" /><zone xml:id="m-6634ee1a-ef02-436c-a356-578ada332c40" ulx="64" uly="148" lrx="182" lry="168" /><zone xml:id="m-11a7984d-f550-4485-9cd0-c747810408b6" ulx="77" uly="163" lrx="467" lry="185" /><zone xml:id="m-42f9dd58-a950-4baa-9f8a-7e3bf44e6954" ulx="77" uly="181" lrx="513" lry="202" /><zone xml:id="m-6a1cc9c6-240f-41de-a233-90c1b7d708d0" ulx="64" uly="197" lrx="127" lry="218" /><zone xml:id="m-5807fdfa-2dc1-4fd1-9388-2882bbdc0bd0" ulx="237" uly="219" lrx="341" lry="241" /><zone xml:id="m-d2894a9b-2389-4051-8a1f-09dbe029054a" ulx="74" uly="235" lrx="513" lry="258" /><zone xml:id="m-31b29304-26f5-4cc4-a723-754aef4406d5" ulx="64" uly="254" lrx="305" lry="274" /><zone xml:id="m-84034b19-8fa0-4e4d-be17-c21fa12a1091" ulx="75" uly="268" lrx="514" lry="288" /><zone xml:id="m-4930589d-651e-4a9f-bb16-2a4dc909807a" ulx="63" uly="286" lrx="470" lry="305" /><zone xml:id="m-fe332f63-8829-424c-bd5a-ed072938315f" ulx="75" uly="301" lrx="513" lry="322" /><zone xml:id="m-0dec9089-d128-42a7-9862-f71d57dcf854" ulx="64" uly="317" lrx="179" lry="337" /><zone xml:id="m-18622b1f-8ce5-4dcc-ac78-23b59bbdf810" ulx="77" uly="334" lrx="512" lry="353" /><zone xml:id="m-ec482509-33ae-4483-b65b-3c11bc5ffae4" ulx="64" uly="348" lrx="197" lry="366" /><zone xml:id="m-e7225459-d16e-4f40-aac6-f29a6663ed79" ulx="77" uly="365" lrx="514" lry="385" /><zone xml:id="m-ab82b014-f0e6-4e49-b11b-4642a912aafe" ulx="65" uly="379" lrx="373" lry="396" /><zone xml:id="m-54d7040e-568f-45a1-9402-61e76f4f2a7b" ulx="77" uly="395" lrx="514" lry="418" /><zone xml:id="m-fd8886a7-78d3-46cb-b368-35fe7d5d6a48" ulx="64" uly="411" lrx="150" lry="427" /><zone xml:id="m-4d226627-d18a-43c7-b5d8-d3eb94053cdf" ulx="77" uly="422" lrx="514" lry="443" /><zone xml:id="m-85d28594-4243-402d-b19c-520e9cb0354b" ulx="64" uly="439" lrx="324" lry="457" /><zone xml:id="m-53adea4a-fc1b-4aa9-b1fa-69cd13beba65" ulx="77" uly="452" lrx="514" lry="475" /><zone xml:id="m-76504e98-6924-44f1-8eb4-eb98877d540c" ulx="65" uly="468" lrx="239" lry="490" /><zone xml:id="m-3df9146b-cfd5-469f-bbe6-444e048f1656" ulx="233" uly="492" lrx="344" lry="514" /><zone xml:id="m-f24b8a57-b3e4-495f-be91-ce26e4727825" ulx="84" uly="515" lrx="513" lry="537" /><zone xml:id="m-aec03755-38c8-467e-8e0f-348e6cfa529c" ulx="65" uly="531" lrx="200" lry="552" /><zone xml:id="m-3d710ea3-392c-476d-a2bf-a544dba48444" ulx="83" uly="547" lrx="514" lry="570" /><zone xml:id="m-0e588ab3-359f-456d-bc50-2be87cc7352d" ulx="64" uly="559" lrx="123" lry="580" /><zone xml:id="m-de3d0517-bd45-4ce6-91ec-e91ecba70953" ulx="84" uly="573" lrx="514" lry="601" /><zone xml:id="m-8be84e92-fb7a-4ebb-9c34-c0386ac381e3" ulx="63" uly="591" lrx="159" lry="611" /><zone xml:id="m-b6eca1ac-5b22-41f8-b92e-cbc7337d32f0" ulx="84" uly="603" lrx="514" lry="625" /><zone xml:id="m-2091d466-8ed1-41a9-a814-0798ca1cdb24" ulx="63" uly="620" lrx="136" lry="640" /><zone xml:id="m-5a9918ca-46a3-494f-ae97-63efb41a9232" ulx="84" uly="637" lrx="513" lry="657" /><zone xml:id="m-d82ed06d-4074-4942-825a-391f73b95b8d" ulx="64" uly="651" lrx="198" lry="672" /><zone xml:id="m-288fd5cd-41b4-411a-8675-a2030fc0eed2" ulx="84" uly="669" lrx="494" lry="688" /><zone xml:id="m-d9a33d33-2770-4d85-bb13-215a465d0528" ulx="84" uly="684" lrx="514" lry="705" /><zone xml:id="m-bc462e51-96b1-4158-bbb2-7cc5d7e8d4bf" ulx="64" uly="698" lrx="320" lry="716" /><zone xml:id="m-ffd801c2-f94f-408e-b1b8-fbc077ed2ec1" ulx="84" uly="714" lrx="514" lry="737" /><zone xml:id="m-36e61936-3229-42ee-b659-306fb241f3c9" ulx="64" uly="729" lrx="218" lry="746" /><zone xml:id="m-5b69e8c0-1ecc-4d58-9058-1f9ea62b412e" ulx="83" uly="742" lrx="514" lry="763" /><zone xml:id="m-72ab8122-5536-48b8-bf2b-f2e1575c2e1e" ulx="63" uly="758" lrx="152" lry="776" /><zone xml:id="m-5bf86f24-ceef-4042-ace7-94a572e5410c" ulx="77" uly="771" lrx="514" lry="798" /><zone xml:id="m-54b8a668-0fe1-4e1a-b162-55d4a43ad6f2" ulx="64" uly="789" lrx="200" lry="810" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-a709f7cd-8b3f-43d9-a222-6fd5bff0f8a7" n="0424" facs="#m-be93bda6-d246-41db-89c2-27a744edcbca" /><div xml:id="m-08faa826-e53a-41f3-b244-78167d144308">
            <lg xml:id="m-f6797828-edf8-497b-8dad-fc7418516038">
              <l xml:id="m-a634e126-1e10-4017-a699-61ad1d6696e2" facs="#m-68b22eff-fd25-4f37-ad79-3af0fea4fe0d" label="ambiguous">2700</l><l xml:id="m-04a78409-42f2-44f6-bf84-0a9a25d3f2e4" facs="#m-c84dc966-4d6b-4686-8dae-93e3b7624f96" label="text-like">Antiphons and Psalms at the Little Hours</l><l xml:id="m-0063082d-78ba-4a4d-8bfe-b4eacb1e0b15" facs="#m-aa4f4563-7587-457e-bd05-cab36f32951a" label="lyrics-like">" Fiant dies ejus páuci :* et episcopãtum éjus accipiat âlter.</l><l xml:id="m-9b7dadff-159f-4e9a-b40e-5491eae3445e" facs="#m-39096217-52f0-440d-8920-1649cc5d666a" label="lyrics-like">8. Fiant fili ejus órphani : * et úxor éjus vidua.</l><l xml:id="m-33ae3d84-4191-4f4b-9ef2-5a2d2ffbbe09" facs="#m-e80fe22a-8743-4fa7-b352-bf129a5e52c4" label="lyrics-like">9. Nutántes transferántur fili éjus, et mendicent :* et ejiciantur de</l><l xml:id="m-e3ef3f39-49a8-4d13-a21a-a403f416a700" facs="#m-42e44df6-2963-4156-a548-b0b9c7dfe303" label="lyrics-like">habitatiónibus suis.</l><l xml:id="m-13d8260d-1294-4ea4-87d0-c4de9b70c75d" facs="#m-98389bc5-de68-49e1-a0ac-7bda036ba890" label="lyrics-like">10. Scrutétur foenerátor ómnem substántiam ejus: * et diripiant</l><l xml:id="m-076d6591-9708-4783-8040-1b4dbc89a464" facs="#m-6634ee1a-ef02-436c-a356-578ada332c40" label="lyrics-like">aliéni labores éjus.</l><l xml:id="m-06fef3fe-507c-4959-9851-60ad1aaa48cc" facs="#m-11a7984d-f550-4485-9cd0-c747810408b6" label="lyrics-like">11. Non sit illi adjútor : * nec sit qui misereátur pupilis éjus.</l><l xml:id="m-19122cd1-b328-4a37-bc16-a575f78cecd2" facs="#m-42f9dd58-a950-4baa-9f8a-7e3bf44e6954" label="lyrics-like">12. Flant náti éjus in interitum :* in generatiône úna deleátur nó¬</l><l xml:id="m-1a88ef9a-12a6-47de-8860-8992589ee0d0" facs="#m-6a1cc9c6-240f-41de-a233-90c1b7d708d0" label="lyrics-like">men éjus.</l><l xml:id="m-60147c30-c867-434e-b2a0-3e70fb9ac1a6" facs="#m-5807fdfa-2dc1-4fd1-9388-2882bbdc0bd0" label="ambiguous">Psalm I0S. II.</l><l xml:id="m-863beb34-ffc4-4e84-8335-0fa7f1c5f3e4" facs="#m-d2894a9b-2389-4051-8a1f-09dbe029054a" label="lyrics-like">(N memóriam rédeat iniquitas pátrum éjus in conspéctu Dómini :* et</l><l xml:id="m-468a273c-5f75-40ff-bbf2-ddc761ace18b" facs="#m-31b29304-26f5-4cc4-a723-754aef4406d5" label="lyrics-like">L peccátum mátris éjus non deleatur.</l><l xml:id="m-63d4c954-488e-402d-a79a-eee542194834" facs="#m-84034b19-8fa0-4e4d-be17-c21fa12a1091" label="lyrics-like">2. Fiant cóntra Dóminum semper, t et dispéreat de térra memória</l><l xml:id="m-e37654a8-c704-4c00-99be-9841139804b1" facs="#m-4930589d-651e-4a9f-bb16-2a4dc909807a" label="lyrics-like">córum : * pro éo quod non est recordátus fácere misericórdiam.</l><l xml:id="m-20267731-2994-4d7b-af34-52a3d79e3e33" facs="#m-fe332f63-8829-424c-bd5a-ed072938315f" label="lyrics-like">3. Et persecútus est hóminem inopem et mendicum, * et compúnctum</l><l xml:id="m-66203603-2432-43cf-86b3-38c68a41955b" facs="#m-0dec9089-d128-42a7-9862-f71d57dcf854" label="lyrics-like">córde mortiñeâre.</l><l xml:id="m-6b923961-d0ac-463f-bc71-d17c46ae8172" facs="#m-18622b1f-8ce5-4dcc-ac78-23b59bbdf810" label="lyrics-like">4. Et diléxit maledictiónem, et véniet ei :* et nóluit benedictiónem,</l><l xml:id="m-fda191bd-d6cd-4af7-bab8-3b630e1b403f" facs="#m-ec482509-33ae-4483-b65b-3c11bc5ffae4" label="lyrics-like">et elongábitur ab éo.</l><l xml:id="m-6d69a93b-d373-400a-9554-8de244b54967" facs="#m-e7225459-d16e-4f40-aac6-f29a6663ed79" label="lyrics-like">5. Et induit maledictiónem sicut vestiméntum, t et intrávit sicut áqua</l><l xml:id="m-48850c79-3f02-440b-a965-10051a613d30" facs="#m-ab82b014-f0e6-4e49-b11b-4642a912aafe" label="lyrics-like">in interióra ejus, * et sicut óleum in óssibuz éjus.</l><l xml:id="m-202e0e02-dc2a-4348-a655-0891daf4f062" facs="#m-54d7040e-568f-45a1-9402-61e76f4f2a7b" label="lyrics-like">6. Elat éi sicut vestiméntum, quo operitur : et sicut zóna, qua semper</l><l xml:id="m-d0ffe9f7-bbe3-4e25-907b-3887e7e08c2f" facs="#m-fd8886a7-78d3-46cb-b368-35fe7d5d6a48" label="ambiguous">praceingitur.</l><l xml:id="m-190beaff-63eb-4fd6-a7a5-e1667c76bd23" facs="#m-4d226627-d18a-43c7-b5d8-d3eb94053cdf" label="lyrics-like">7. Hoc ópus eórum qui détrahunt mihi ápud Dóminum:“et qui</l><l xml:id="m-7a2d03c3-7516-4b42-bab1-d1bfa8aecce6" facs="#m-85d28594-4243-402d-b19c-520e9cb0354b" label="lyrics-like">loquóntur mála advérsus ánimam méam.</l><l xml:id="m-b3cfcb04-59f3-46cb-b7b7-2b1c795e2084" facs="#m-53adea4a-fc1b-4aa9-b1fa-69cd13beba65" label="lyrics-like">8. Et tu, Dómine, Dómine, fac mécum propter nómen túum :* quia</l><l xml:id="m-40c596c8-b682-4214-9b9c-9be8a1b2d03c" facs="#m-76504e98-6924-44f1-8eb4-eb98877d540c" label="lyrics-like">suávis est misericórdia túa.</l><l xml:id="m-bacade2d-1978-4115-b03c-adb7027e7087" facs="#m-3df9146b-cfd5-469f-bbe6-444e048f1656" label="ambiguous">Psalm I08. III.</l><l xml:id="m-f2ed779e-c818-46c8-a445-05a62907a706" facs="#m-f24b8a57-b3e4-495f-be91-ce26e4727825" label="lyrics-like">Ibera me quia egénus et páuper égo sum :* et cor méum conturbá¬</l><l xml:id="m-078d4cee-5a0d-467a-be48-b9663193ee29" facs="#m-aec03755-38c8-467e-8e0f-348e6cfa529c" label="ambiguous">A tum est intra me.</l><l xml:id="m-daf76ac6-ab25-4671-af51-29ac7d766d19" facs="#m-3d710ea3-392c-476d-a2bf-a544dba48444" label="lyrics-like">2 Sicut úmbra cum deelinat, ablátus sum :* et excússus sum sicut</l><l xml:id="m-10d41294-6282-43fe-859d-5ecc7ade86c2" facs="#m-0e588ab3-359f-456d-bc50-2be87cc7352d" label="ambiguous">locustae.</l><l xml:id="m-4392cb4a-2f3a-46b4-9fb1-a7853bb9e326" facs="#m-de3d0517-bd45-4ce6-91ec-e91ecba70953" label="lyrics-like">3. Génua méa infirmáta sunt a jejunio: et cáro méa immutáta est</l><l xml:id="m-14b8ed8a-4d8e-46f0-8f58-820e8f7c6f8d" facs="#m-8be84e92-fb7a-4ebb-9c34-c0386ac381e3" label="lyrics-like">propter óleum.</l><l xml:id="m-7df640bb-d66b-4165-b303-4aa942b7f80e" facs="#m-b6eca1ac-5b22-41f8-b92e-cbc7337d32f0" label="lyrics-like">4. Et égo fáctus sum oppróbrium illis : * vidérunt me, et movérunt</l><l xml:id="m-ce16fa4d-1e1c-46f3-904d-ba6ea4234419" facs="#m-2091d466-8ed1-41a9-a814-0798ca1cdb24" label="lyrics-like">cápita sua.</l><l xml:id="m-2e8a3ccb-ba2d-4b74-8d2b-c5a433a126e2" facs="#m-5a9918ca-46a3-494f-ae97-63efb41a9232" label="lyrics-like">5. Adjuva me, Dómine Déus méus : * sálvum me fac secúndum</l><l xml:id="m-a0548708-7d71-45b2-871b-2df87d6fa453" facs="#m-d82ed06d-4074-4942-825a-391f73b95b8d" label="lyrics-like">misericórdiam túam.</l><l xml:id="m-afe55751-f9b0-4171-a6e8-e48bb979df72" facs="#m-288fd5cd-41b4-411a-8675-a2030fc0eed2" label="lyrics-like">6. Et sciant quia mánus túa haec : * et tu, Dómine, fecisti éam.</l><l xml:id="m-119ee939-3e73-408b-9536-addbb1f6f359" facs="#m-d9a33d33-2770-4d85-bb13-215a465d0528" label="lyrics-like">7 Maledicent flli, et tu benedices : t qui insúrgunt in me confun¬</l><l xml:id="m-a88ec034-0f31-49d2-8b9b-e12994a75813" facs="#m-bc462e51-96b1-4158-bbb2-7cc5d7e8d4bf" label="lyrics-like">dántur :* sérvus autem túus laetábitur.</l><l xml:id="m-0154f457-4d64-4c8f-a0ee-5a6bae227a5c" facs="#m-ffd801c2-f94f-408e-b1b8-fbc077ed2ec1" label="lyrics-like">8. Induántur qui détrahunt mihi, pudóreur sicut</l><l xml:id="m-0599a6ae-f63f-4327-a035-bf494cfc719e" facs="#m-36e61936-3229-42ee-b659-306fb241f3c9" label="lyrics-like">diploide confusióne súa.</l><l xml:id="m-9e6b642a-b10b-4af3-bc5c-e8ca05809b86" facs="#m-5b69e8c0-1ecc-4d58-9058-1f9ea62b412e" label="lyrics-like">9. Confitébor Dómino nimis in ore méo:* et in médio multórum</l><l xml:id="m-a377f9ad-8a2a-4b23-bb18-595bb47a064f" facs="#m-72ab8122-5536-48b8-bf2b-f2e1575c2e1e" label="lyrics-like">laudábo éum.</l><l xml:id="m-446245c4-edc1-4da3-84b7-17c4c5551939" facs="#m-5bf86f24-ceef-4042-ace7-94a572e5410c" label="lyrics-like">10. Quia astitit a dextris páuperis, « ut sálvum faceret a persequén¬</l><l xml:id="m-03c4029c-7061-466d-b095-a65b8f941807" facs="#m-54b8a668-0fe1-4e1a-b162-55d4a43ad6f2" label="lyrics-like">tibus ánimam méam.</l></lg></div></section></score></mdiv></body></music>
</mei>