                <syllable xml:id="m-092bd587-2092-4f9e-981e-2757745028cd">
                  <syl /><neume facs="#m-ce631d25-e8b7-422f-8a3f-0c85fc24e006" type="torculus" xml:id="m-8dda5dc0-a62d-47df-8979-cecc754dbe60">
                    <nc xml:id="m-96092cf0-318c-4ac4-a7ad-04ad20f71eb5" pname="a" oct="3"><episema xml:id="m-ec5de583-b533-45d1-977c-32aed640d3f8" form="v" /></nc>
                    <nc xml:id="m-6c6609cb-0760-42df-bcba-a7b95df3ebd2" pname="b" oct="3" />
