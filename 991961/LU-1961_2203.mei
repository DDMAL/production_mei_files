              <l xml:id="m-32b18274-2ebd-4bb1-93d0-684b10ed2acf" facs="#m-1a3afa4e-ac8a-4708-87f0-856e4197ca60" label="ambiguous">Antiphons</l><l xml:id="m-031173e9-fbc9-4e35-a00e-4564d00a2f16" facs="#m-de726368-1855-4819-b244-9db570b04399" label="ambiguous">1 — Thursday — Vespers. 2</l><l xml:id="m-6c933c4d-2ae5-433a-a377-8018725c55f5" facs="#m-968eed69-407a-4ad8-870a-696c7c8989cf" label="ambiguous">7 Assumpta est Maria.</l><l xml:id="m-a533b7b2-dcd6-4ffa-acab-86efe2b501a8" facs="#m-ed89f473-872d-4a4b-8e2b-c35affef5c12" label="ambiguous">1606</l><l xml:id="m-f15daf07-dc09-4dbe-82fa-425b1048bf86" facs="#m-00388e5f-8f0b-4365-bb77-8001efef21e8" label="ambiguous">"</l><l xml:id="m-46680fce-521b-4d30-8d7f-6dc22ce071c3" facs="#m-ca311501-df1a-4178-887d-43e054d6732d" label="ambiguous">.</l><l xml:id="m-3d28b4aa-c7f3-454a-8714-5e0eb701e7fd" facs="#m-72cf1aa5-d1b5-414a-9bc5-1720623c7128" label="ambiguous">.</l><l xml:id="m-f353905e-9827-4cd3-80ba-613ea83f55d6" facs="#m-0d67232f-0aa6-4ccd-a129-a818ccade6e7" label="ambiguous">— Compline</l><l xml:id="m-5fbe8766-f0e1-4def-9e47-37839dd837ea" facs="#m-3973d4fd-5a4c-47e1-acb0-1409ae3909f2" label="ambiguous">300</l><l xml:id="m-2b68e605-df85-4d44-a274-3abadb87d8c6" facs="#m-6b3b4a8a-b4d3-4b2b-b485-844583c327cf" label="ambiguous">1 Astiterunt justi</l><l xml:id="m-b5279008-0c97-4121-b24d-2c4956ee2a94" facs="#m-83cf35b7-42c8-4862-a006-d20ac17bd580" label="ambiguous">1506</l><l xml:id="m-59ad99d2-a8fb-4140-ac8a-43337be628d4" facs="#m-94d7a9ba-947e-46e7-b1c8-9cac54ffec75" label="ambiguous">.</l><l xml:id="m-fccbb341-142e-4fe7-af8b-b0854569bd1c" facs="#m-2924e348-bc68-4404-92c7-3559b4bed981" label="ambiguous">.</l><l xml:id="m-0fc90195-8edb-4bf5-a857-ed8bd06d5c32" facs="#m-20c0d3df-93b2-41a4-af7d-bc094cc3c538" label="ambiguous">— Friday — Vespers.</l><l xml:id="m-75ffd896-fb72-4030-b4cf-3848c887ff42" facs="#m-e85a14c4-5d4a-4dc5-abc8-661e0d2afdd1" label="ambiguous">304</l><l xml:id="m-eb167faa-a45e-4b69-9ca1-c4b1cb7bcff7" facs="#m-f62ba