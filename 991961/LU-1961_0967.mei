                <syllable xml:id="m-b3fb95ae-b666-489a-a974-d33073b6491d">
                  <syl /><neume facs="#m-186b0dfa-d6b5-4d7e-9080-4355268b5420" type="clivis" xml:id="m-39964db6-efda-4e51-9afc-a58a1917219b">
                    <nc xml:id="m-c19bb88a-95ba-4b2e-8359-cf371a6b8a7e" pname="g" oct="3">
                      <signifLet xml:id="m-0ba9cdf7-7f4c-4a48-ace1-766064e33454" />
