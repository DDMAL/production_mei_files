82969e3d0" label="lyrics-like">Omnes sáncti Pontifices et</l><l xml:id="m-bb7ebe02-9a52-40c5-8635-6f46ded1570e" facs="#m-c5bb92df-fe2d-48f3-9142-449b23332aeb" label="lyrics-like">Confessóres,</l><l xml:id="m-72eba4d2-268c-45dd-a8e4-20666b6c9c43" facs="#m-987c877e-b57e-4f79-b16a-ac32b62d1ce0" label="lyrics-like">oráte.</l><l xml:id="m-5dfc2550-92c4-46d5-b426-0d3cd40b16d3" facs="#m-3c0e237b-d88c-4bc5-8992-e95e5d8d958b" label="lyrics-like">Sáncta Caecilia,</l><l xml:id="m-926c0475-5454-4eb8-a742-b8847ced5a10" facs="#m-a48dbff9-4a0e-4a63-a739-3157d31556fa" label="lyrics-like">óra.</l><l xml:id="m-e60bf1ed-a626-4fd9-b930-83361b3d2bec" facs="#m-b6515508-0180-49b9-9404-e52bf8cd2f9e" label="lyrics-like">Omnes sáncti Doctóres,</l><l xml:id="m-20258680-0a4c-43dd-b72f-8e1cfe447129" facs="#m-8fe68811-9bbf-488a-8928-bcd04d6126d7" label="lyrics-like">oráte.</l><l xml:id="m-089b9d57-55ed-4aab-ad9a-02317a1f0ea6" facs="#m-1e36e630-982e-43b6-b4f9-b1f2185b42ad" label="lyrics-like">Sáncta Catharina,</l><l xml:id="m-f7b50641-ffef-4ca7-ba0d-2bf5a063e24f" facs="#m-870904a7-d3ef-43ef-b49b-c76d43400cc9" label="lyrics-like">óra.</l><l xml:id="m-bfcc12b1-8e60-4e5f-8fea-d484250f5502" facs="#m-02fc561b-b823-4816-a681-8367fc55bbbb" label="lyrics-like">Sáncta Anastásia,</l><l xml:id="m-31d54e71-3d82-43dc-b529-8fe520cf26b3" facs="#m-1fa2ec62-3baf-4acc-9e48-4aa027a28c90" label="lyrics-like">óra.</l><l xml:id="m-2f6fda73-9468-4d5a-ad3b-dae9be371957" facs="#m-38fc6a35-e14a-425e-ba23-35128ba59203" label="lyrics-like">Sáncte Antóni,</l><l xml:id="m-334cf6d8-01d1-425a-8291-5d70b5dee379" facs="#m-5c3f89ae-7fe7-4b93-80a9-c9d5e799596d" label="lyrics-like">óra.</l><l xml:id="m-30625397-1e59-4e6a-a71f-9a0ddc003071" facs="#m-17ff3406-f72d-4325-a2f8-0dc862f23ae9" label="lyrics-like">sáncte Benediete,</l><l xml:id="m-1e57f869-f25d-4cdf-95f9-6e126e1d6b42" facs="#m-5e114f77-221f-4f65-b4bd-f5aab84fab93" label="lyrics-like">óra.</l><l xml:id="m-2f206f2c-4974-4c61-a3c3-06c8d1f779cf" facs="#m-5ab34570-b8e4-47f1-8f2c-ca7035856686" label="lyrics-like">Omnes sánctae Virgines et</l><l xml:id="m-f8c37391-430b-4e96-8c12-a64b4879a9cf" facs="#m-80284570-b129-4178-b71f-b609fa9beaa2" label="lyrics-like">oráte.</l><l xml:id="m-51dbced2-088f-467e-8629-48688a8b2e1a" facs="#m-79d94726-d6a4-46a6-b94b-f1b6a0856b2c" label="lyrics-like">sáncte Bernarde.</l><l xml:id="m-606b0da5-3e0e-4127-ab85-5c97854434e5" facs="#m-74fff66e-2a08-4947-b496-65ee7ceaeb94" label="ambiguous">viduae.</l><l xml:id="m-07c13247-1239-4b8d-9dc2-2ed4e72723f9" facs="#m-a1178e10-0c01-48a8-9a0a-0d53071cbc30" label="lyrics-like">óra.</l><l xml:id="m-403f8feb-a053-4a3a-9d53-32d336ede036" facs="#m-50e36729-fcbd-46bb-8042-33965ce86959" label="lyrics-like">Omnes Sáncti et Sánctae Déi,</l><l xml:id="m-b40310f1-8185-496b-8c72-05466742ca51" facs="#m-931b754f-3476-48b9-bba5-825a5ccafcfe" label="lyrics-like">Sáncte Dominice,</l><l xml:id="m-668bc859-28cb-48ab-8c29-1bd97074bad2" facs="#m-e7a1b221-4547-4439-90db-8fe543c9b1fc" label="lyrics-like">óra.</l><l xml:id="m-19a3d45c-f4fe-4370-b3f3-fbddaedca616" facs="#m-71dde0ad-34c0-48d3-847e-9d51be6a94d9" label="lyrics-like">intercédite pro nóbis.</l><l xml:id="m-1cbc19bf-807d-4db7-93a5-d714d2375e60" facs="#m-10f75ad4-91bc-4427-9ed3-b3d7b2456388" label="lyrics-like">sáncte Franeisce,</l><l xml:id="m-94a689cd-e8af-437b-8c31-ef3f589483a4" facs="#m-fbc9a818-a137-4a7d-b7a3-0966dca218f1" label="lyrics-like">óra.</l><l xml:id="m-494bfe9c-84a8-4bfc-a99a-07067639689f" facs="#m-dee0502f-4550-468e-adb5-7ec89c3a57f1" label="lyrics-like">Propi-ti- us és-to, párce nó-bis Dómine.</l><l xml:id="m-92f67660-d174-4ced-a858-2803e05e691a" facs="#m-34b9e126-6d75-4f69-ba59-aca02402e424" label="lyrics-like">Propi-- us és-to,</l><l xml:id="m-34528197-41e4-4f29-9c96-727a51fa46b9" facs="#m-e40fd426-66f8-4c2b-9296-d65a97af022e" label="lyrics-like">exáudi nos Dómine.</l><l xml:id="m-b9bd9621-e9e5-4f90-8044-3859a7d7cf08" facs="#m-f60d8d86-be53-4b1f-ab81-196fe08b3d27" label="lyrics-like">li-be-ra nos Dómine.</l><l xml:id="m-f92ab27e-d398-44a1-aed8-c227f89fcf1f" facs="#m-97cedd27-b80d-46db-a7a3-47f765cfb629" label="lyrics-like">Ab ómni má¬ lo,</l><l xml:id="m-9e3a1f92-045b-4b1a-a541-4237adc304b9" facs="#m-ee631d0e-e27a-473d-9c69-f85ce64deb68" label="lyrics-like">Ab ómni peceâto,</l><l xml:id="m-76f5d13d-547e-46d5-91f2-bc55a2c952f3" facs="#m-6c0278f1-d8b7-404f-ade6-c15ee3dfdd60" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-7c5435d0-401e-4541-9858-57f498872df0" facs="#m-3ca2ee65-e130-44a4-83f1-9cd50ecfec26" label="lyrics-like">Ab ira túa.</l><l xml:id="m-c91e4520-ca73-4143-b908-3e73c33599fd" facs="#m-2cee75ef-c28b-459d-948a-c51a41d07219" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-c5f0ec1f-ed29-47ca-aca4-ff879d81e4d5" facs="#m-c05926fd-33dc-434b-9db2-d0e22a08c3ab" label="lyrics-like">A subitánea et improvisa mórte,</l><l xml:id="m-7298c958-f088-4226-86fe-772c18a78488" facs="#m-3f999977-555a-427b-b2a5-c6d4d48bd454" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-39d336d2-a358-4441-96d9-23056c72b033" facs="#m-540213d2-1b9d-400a-9d9f-b7c6daf7d850" label="lyrics-like">Ab insidits dtáboli,</l><l xml:id="m-2cbc15cd-b4bf-4ed6-baa0-f347d93c45e9" facs="#m-a2ef850b-7f78-46cd-adbb-f0dc6fe7b3d9" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-8dab8280-6861-452d-9908-a9be4aa9f932" facs="#m-4b03ccda-c6bd-47b1-81b8-9115befee6e0" label="lyrics-like">Ab fra, et ódio, et ómni mála voluntáte,</l><l xml:id="m-29ad1f26-3810-47a5-af64-44097538cd2f" facs="#m-f48a9dd1-faa0-4ce7-adf0-4732be0c17d2" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-b4200e56-fe18-411a-ae08-f51f77ffa795" facs="#m-0975f223-f9e3-46ef-b626-38d15ced2f6c" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-d2748cc6-7f2f-4790-8e2f-5ae95e2c8517" facs="#m-f530c328-f50d-4468-8c88-231df3716cfe" label="lyrics-like">A spiritu fornicatiónis,</l><l xml:id="m-cb91e476-24bc-4b51-8652-513a44f36d06" facs="#m-37ec5f60-1d02-460d-bd2f-ba05f554ebd0" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-ebacfcee-b215-437a-9203-1a667cfd098e" facs="#m-9cef382c-2efe-4350-9239-f9728da13f0d" label="lyrics-like">A fülgure et tempestáte,</l><l xml:id="m-6c9c55ea-e25f-467a-a7b0-3c4c9cc281c2" facs="#m-b155995b-2f9b-4df9-a2de-9a0f57ed4fb3" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-10c98500-ab25-4c95-bdbb-d4e15aef1637" facs="#m-05815977-a208-4dac-b89a-9806323dfbb5" label="lyrics-like">A flagéllo terraemótus,</l><l xml:id="m-5e803328-bb2b-4ac5-9d1b-70e9e7220f23" facs="#m-89330607-442e-48bc-aece-02de002eb261" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-cca25777-a673-4a6e-bfce-b7fe80c2f5a6" facs="#m-5610b290-d24c-41f3-8f72-b6d09669a41c" label="lyrics-like">A péste, fáme, et béllo,</l><l xml:id="m-887b73cb-6d49-4b84-8a9a-3dfea2a35b2f" facs="#m-c25fde96-9dd8-48ec-997f-b8a88f59a3bf" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-becc4ec7-9c9f-4d3a-9799-3e7db7cbb131" facs="#m-60cb4d05-7774-44b5-8f38-f09a60abbde5" label="lyrics-like">A mórte perpétua.</l><l xml:id="m-5790ee57-3d41-44b9-9402-499c80313ce6" facs="#m-51be52c5-2ec8-4e16-9743-1096e52e245f" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-68b73bc8-770e-4b19-8a99-82fa856f4aa7" facs="#m-5851bb5b-5e24-4ae7-ab8d-99660dfd2a98" label="lyrics-like">Per mystérium sánctae incarnatiónis túae,</l><l xml:id="m-baaaba6f-07cb-4769-a5bc-1d07a0b4ce32" facs="#m-d2221753-bf6e-44b7-9cef-8d86bf5e095f" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-112b100b-26b7-4699-a8c5-c52c050e3e20" facs="#m-bae91807-cf20-42b0-a40f-1b1ea7ce066b" label="lyrics-like">Per advéntum túum.</l><l xml:id="m-f0ec2ad3-3e57-4bc2-b689-7c438e19fb78" facs="#m-acc1b72d-eb9c-48cc-9fc7-17f7d5e8a4ce" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-40ba0f78-a8f5-41dc-938c-d6e0b55d80dc" facs="#m-e3c7e40f-7f48-442d-901f-74b32521f459" label="lyrics-like">Per nativitátem túam,</l><l xml:id="m-a44eb140-9f74-4341-8f43-30aaa1d0b986" facs="#m-c600f9f3-3ad7-4453-b5fa-40e1e7ee7a05" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-4e76f285-ed66-4d93-9fb4-c587245cf1fa" facs="#m-9d04444f-bc01-4a91-8b96-cf1effb0b41e" label="lyrics-like">Per baptísmum et sánctum jejúntum túum,</l><l xml:id="m-c974c045-3e7b-435d-9880-59c7f14c1ef6" facs="#m-1348efcb-ff08-45a8-8e1d-895451a42c1a" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-f6974638-8b1b-487b-ad03-38074ce53558" facs="#m-e42bb93f-cb67-4196-b290-a0e31983ea11" label="lyrics-like">Per crúcem et passiónem túam,</l><l xml:id="m-d4333203-3790-42d0-b43c-a9ba07f815e3" facs="#m-29f7d3e0-f428-4c40-bc89-62d95e8a31fa" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-c2b14ceb-0bc7-4f6d-9a25-87512ea499ad" facs="#m-31036530-8c74-4402-b16f-0efd214f83fe" label="lyrics-like">Per mórtem et sepultúram tuam,</l><l xml:id="m-1a874dfa-d82a-4f5d-8bfd-00de1bd6e955" facs="#m-6036d08b-1f4d-4d51-b52d-0db45e77fa1e" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-b349a219-aa58-4247-997c-0a7354b025b3" facs="#m-112afb05-c801-4d94-bbd2-f22e0eb8cb0c" label="lyrics-like">Per sánctam resurrectiónem túam,</l><l xml:id="m-c1a8991f-abe9-4a87-8216-88154664f000" facs="#m-9ab19840-6abe-4b8b-8f77-31ddb8bbbdcc" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-b8c989ca-2af4-40c5-b8a3-d7df3a4a90ff" facs="#m-47cabc44-46d8-46a1-9cf3-c15b00714fc1" label="lyrics-like">Per admirábilem ascensiónem túam,</l><l xml:id="m-c4fb7e78-e212-4364-8f67-0d79efefa7b5" facs="#m-86c6499a-3943-490f-bb5d-e7e3a12bb328" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-5d2cef2d-cd13-4ff4-bd5c-d3bea75cf3cc" facs="#m-38e84212-4ed6-4b81-a4a5-1765a270869b" label="lyrics-like">Per advéntum Spiritus Sáncti Parácliti,</l><l xml:id="m-3ee199f6-5165-4f6d-8680-2f974e839cd5" facs="#m-68d2cdf9-b81d-4e59-b7d9-a898f21c10bf" label="ambiguous">In die Judicii,</l><l xml:id="m-4efc8ed9-1c22-4d45-8e5c-9f7fc9f9140e" facs="#m-b1225044-93b0-4fb2-99d2-bc15019b11ad" label="lyrics-like">libera nos Dómine.</l><l xml:id="m-feab97dd-38e4-46c0-be56-efb44fbd74f1" facs="#m-a93c5a42-eb95-4bbb-95ab-f4ff9343bd47" label="lyrics-like">Pecca-tó- res, te rogámus áudi nos.</l><l xml:id="m-e5102a74-49f9-42ea-be29-8b8a05e087f2" facs="#m-50b86efc-fd60-45f3-a675-2ad32b5407c0" label="lyrics-like">Ut nóbis párcas,</l><l xml:id="m-f3891de1-67d0-4fe5-b286-a851755884d7" facs="#m-97fc67bb-87cb-49e8-936a-e81378afbb79" label="lyrics-like">te rogámus áudi nos.</l><l xml:id="m-1f9d882c-81b0-4891-81ac-a9b73a0e1dc0" facs="#m-7122ed2f-c661-43ac-bd55-e0611079d6b5" label="lyrics-like">Ut nóbis indúlgeas,</l><l xml:id="m-1e899a84-1996-4387-a55c-7b25ff8f7769" facs="#m-d80909a6-dced-4182-9503-a314f4c606a6" label="lyrics-like">te rogámus áudi nos.</l><l xml:id="m-16ea5dbc-8450-4892-a4f0-34d995ec2976" facs="#m-d675d03b-5ec0-4f0a-b315-bdfe4bed2477" label="lyrics-like">Ut ad véram paeniténtiam nos perdúcere aignéris, te rogámus áudi nos.</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
