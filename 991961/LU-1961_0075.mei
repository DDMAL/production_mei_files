1" ulx="174" uly="1505" lrx="1851" lry="1575" /><zone xml:id="m-ea935a7e-7be5-438b-bb79-d1944027510f" ulx="119" uly="1563" lrx="1500" lry="1633" /><zone xml:id="m-1c8d9f66-85ed-4aa7-ac0b-f83f6a798995" ulx="171" uly="1636" lrx="1857" lry="1714" /><zone xml:id="m-aebfcf71-d7dc-4353-b736-bf7c45e56e48" ulx="119" uly="1696" lrx="1855" lry="1772" /><zone xml:id="m-6229a6b0-50ca-44ea-9d62-d1728cc492c9" ulx="120" uly="1768" lrx="544" lry="1824" /><zone xml:id="m-f8413b4c-c0d8-4d93-b6ec-f738cd4d383e" ulx="174" uly="1889" lrx="879" lry="1963" /><zone xml:id="m-b47634bb-a757-48bc-b389-eaacd9689266" ulx="173" uly="1983" lrx="1848" lry="2055" /><zone xml:id="m-3042e67a-adbf-4e0c-93c3-ec0f62ce8d4b" ulx="122" uly="2053" lrx="1848" lry="2114" /><zone xml:id="m-b3979693-7faf-4aa1-a8e5-dbf617e92f82" ulx="122" uly="2096" lrx="1105" lry="2163" /><zone xml:id="m-d01ac764-86f9-4c1e-ae55-11f5ce1bd97a" ulx="182" uly="2179" lrx="1855" lry="2248" /><zone xml:id="m-09aaa4ce-178d-4315-9574-2d6ad5370752" ulx="292" uly="2235" lrx="1855" lry="2303" /><zone xml:id="m-8a2034de-48b4-464f-a05d-8040cca4955a" ulx="283" uly="2287" lrx="578" lry="2347" /><zone xml:id="m-b85568d7-c93b-4bb7-8875-e8cc8b15be8c" ulx="176" uly="2426" lrx="1220" lry="2482" /><zone xml:id="m-f0e1add9-1c6d-4ad2-8cbf-2cdb74d479cc" ulx="176" uly="2507" lrx="1449" lry="2586" /><zone xml:id="m-9aa31d5d-76ea-4c18-b024-d59832345fd2" ulx="176" uly="2592" lrx="1850" lry="2671" /><zone xml:id="m-8e80b621-3b08-4aa6-854b-e09390de2c20" ulx="117" uly="2653" lrx="634" lry="2729" /><zone xml:id="m-f7e1fb24-4937-4159-ac06-ef981131615d" ulx="173" uly="2727" lrx="1848" lry="2801" /><zone xml:id="m-cf0c467f-e414-4782-8aa5-53e70991389f" ulx="120" uly="2787" lrx="678" lry="2853" /><zone xml:id="m-247eee22-41f0-44cc-9e9e-9d5ba1d3d76e" ulx="174" uly="2861" lrx="1853" lry="2929" /><zone xml:id="m-01afa121-5c1b-4e50-b6c7-44086319b34a" ulx="120" uly="2918" lrx="1853" lry="2999" /><zone xml:id="m-6f68abe3-e03c-479f-90c8-f4e9d05ba09d" ulx="122" uly="2978" lrx="757" lry="3055" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-c98aa0de-94d2-4455-9f53-64d900d3812d" n="0075" facs="#m-54ef6db4-7c90-4e5c-a64a-ed171ba23a50" /><div xml:id="m-fa23c79e-ec81-465f-921e-46cc214fd0f7">
            <lg xml:id="m-376f134f-bf94-483d-ae14-a3c5172cd71e">
              <l xml:id="m-1c3ea11a-cd57-458b-84df-6a5e40efaaf2" facs="#m-eefd1982-0a63-4ce7-afaa-586f7f495664" label="text-like">Proper of the Time.</l><l xml:id="m-c893ec36-2950-4f1b-a8d2-0901c5517cab" facs="#m-dca28fa4-5274-43c1-8b30-da3ab4873a24" label="ambiguous">LXXV.</l><l xml:id="m-5571f1e5-179f-4d87-a383-1b8d90fa13e0" facs="#m-1faf4dbd-e567-46db-8b08-27a2d23575d8" label="text-like">6. FEAST OF THE HOLY NAME OF JESUS. — I class.</l><l xml:id="m-f444d10d-7687-4e8f-8080-a0aac3cf0e6e" facs="#m-25047038-8781-4cd6-9413-e9393601a50e" label="text-like">This is kept on the Sunday from Jan. 2 to 5; if there is none, then</l><l xml:id="m-f31b8bb6-08b9-42ec-8546-959650f24500" facs="#m-ccb3085e-95bb-4503-951e-53e595dc7b57" label="text-like">on Jan. 2. On Sunday, from Jan. 3to5, it has I Vespers,</l><l xml:id="m-f0318bed-4dc4-4336-8fae-1f22c39ece3b" facs="#m-302fd6d0-1bc4-4ae0-b884-f77685496399" label="text-like">p. 445; but on a weekday none.</l><l xml:id="m-02defaad-32c9-4500-bdd7-b013d02d64b9" facs="#m-5473628f-6d4c-403c-80e3-a92f89951df9" label="text-like">At the lesser Hours, antiphons and psalms of the occurring</l><l xml:id="m-55868d54-ae31-4f2e-ae98-efae54d127a9" facs="#m-893556bf-d218-48a6-976e-deba5655f3cd" label="text-like">day; the rest of the feast. Where it is a I class feast, the proper</l><l xml:id="m-4c0d24f8-657e-4745-803c-867ff216b623" facs="#m-2465db21-5ac7-4cbc-a799-3502c1381311" label="text-like">antiphons are said, p. 445.</l><l xml:id="m-dd7dd093-af8d-4ba3-8ab5-b2d1d2d91b66" facs="#m-d177d81c-da45-4cca-aac8-d7c41d5c6dff" label="text-like">At non-conventual sung Mass, and at both Vespers, no</l><l xml:id="m-d58830db-45a1-4633-84fe-56ad33b99d3e" facs="#m-da66d19b-e8b7-4d73-91cd-ebc18edb2b30" label="ambiguous">commemoration.</l><l xml:id="m-8991b4a0-2b57-4456-884e-1f0fdcaca103" facs="#m-f2ec0c86-74f2-454d-9644-797d05bdfa7b" label="text-like">Compline of Sunday.</l><l xml:id="m-5718ed07-1479-4119-b06a-3853942807d0" facs="#m-27b7c34a-fa29-4345-b6bc-b10c46dbc877" label="text-like">When the feast is kept on Jan. 5, it is not commemorated at</l><l xml:id="m-03674cac-10ce-4f60-94d8-5d219e064ef0" facs="#m-1f0e81a4-ba66-460f-a345-019aaf05c9b9" label="text-like">1 Vespers of the Epiphany.</l><l xml:id="m-e6122b02-6a7d-4570-8c02-37cdbf68d4e0" facs="#m-dee211ce-7010-4913-93ac-1d3148f52d0c" label="ambiguous">7. JANUARY 2-5</l><l xml:id="m-cf9d3556-f50e-4b99-a9bd-216ea4e7ca69" facs="#m-4a236320-afde-4bc8-8f6b-f8385fe0a6d2" label="text-like">These days are ferias of the season of the Nativity:</l><l xml:id="m-7596fa5c-c0fc-48c4-9e22-ffa8c3919718" facs="#m-59b845a1-0424-47ff-b0cc-e2f3ce07becd" label="text-like">a) the ferial Office, antiphons and psalms of the occurring</l><l xml:id="m-1e0e35b8-1f0e-4de0-930c-6c94e00b8f7e" facs="#m-dff54e73-07b5-4723-a2b9-4896e02e5d73" label="text-like">weekday; the rest, including the V. in the short responsory</l><l xml:id="m-90d36cc4-a9f0-44fd-ba69-b1a673ab74eb" facs="#m-08522d68-de53-4e45-83d8-634527b140a4" label="text-like">at Prime, as for Christmas.</l><l xml:id="m-1182de25-c6c5-4ed8-99ac-687c0d0e2007" facs="#m-f50f291a-f2d5-482e-9d10-60f701371bd1" label="lyrics-like">The Mass is that of January I, with Glória and Christmas</l><l xml:id="m-e759bde2-7be9-4c46-bf14-680ac9b30dfe" facs="#m-ea935a7e-7be5-438b-bb79-d1944027510f" label="lyrics-like">preface, but with no Creed or proper Communicántes.</l><l xml:id="m-9a893f89-d3e8-4643-a999-1de36ae04306" facs="#m-1c8d9f66-85ed-4aa7-ac0b-f83f6a798995" label="text-like">b) On feasts which fall on these days, V. of Christmas in short</l><l xml:id="m-6a46dc57-992e-431c-9ce8-7718159d48fc" facs="#m-aebfcf71-d7dc-4353-b736-bf7c45e56e48" label="text-like">resp. at Prime, unless there is a proper V.; but the feria is not</l><l xml:id="m-e28286e7-56a7-4c23-a4fb-5d00f7ad7774" facs="#m-6229a6b0-50ca-44ea-9d62-d1728cc492c9" label="ambiguous">commemorated.</l><l xml:id="m-874cd81b-0b61-4ce0-8501-621dff7b2ae5" facs="#m-f8413b4c-c0d8-4d93-b6ec-f738cd4d383e" label="ambiguous">8. EPIPHANY. — I class.</l><l xml:id="m-db1c5492-0be0-46df-95fa-9497523be2d6" facs="#m-b47634bb-a757-48bc-b389-eaacd9689266" label="text-like">All as in the Liber Usualis, except the hymn at the lesser Hours,</l><l xml:id="m-3e0d5903-e98e-4f99-99aa-fe08796dbd83" facs="#m-3042e67a-adbf-4e0c-93c3-ec0f62ce8d4b" label="lyrics-like">which keeps its melody but has the common doxology, Praésta,</l><l xml:id="m-9b0988c6-3024-4ee4-b0b5-c74991a19d13" facs="#m-b3979693-7faf-4aa1-a8e5-dbf617e92f82" label="lyrics-like">Páter puíssime, until Jan. 13 inclusive.</l><l xml:id="m-eec3fde0-6b58-46c6-bd84-6cf88be6b4f6" facs="#m-d01ac764-86f9-4c1e-ae55-11f5ce1bd97a" label="text-like">When the exterior solemnity takes place on the Sunday which follows</l><l xml:id="m-62762c1f-fa3a-4a78-8714-dbf61381c827" facs="#m-09aaa4ce-178d-4315-9574-2d6ad5370752" label="text-like">Jan. 6, there is no commemoration of the Holy Family, nor of</l><l xml:id="m-c7bbd11e-0516-4082-be47-f949d130f758" facs="#m-8a2034de-48b4-464f-a05d-8040cca4955a" label="text-like">the Sunday.</l><l xml:id="m-4ef7d902-0f2f-423b-b99c-d8729d758c7d" facs="#m-b85568d7-c93b-4bb7-8875-e8cc8b15be8c" label="text-like">9. FIRST SUNDAY AFTER EPIPHANY:</l><l xml:id="m-4bd338d9-f76f-47c1-b3eb-b251e3b983d6" facs="#m-f0e1add9-1c6d-4ad2-8cbf-2cdb74d479cc" label="text-like">FEAST OF THE HOLY FAMILY. — I class.</l><l xml:id="m-db3723ef-8f48-436e-ad1a-78553dcaf1e5" facs="#m-9aa31d5d-76ea-4c18-b024-d59832345fd2" label="text-like">This feast has I Vespers, p. 467, except when it falls the day</l><l xml:id="m-8e1126a8-70b5-4887-a837-b8e438f49c04" facs="#m-8e80b621-3b08-4aa6-854b-e09390de2c20" label="text-like">after the Epiphany.</l><l xml:id="m-68295db8-9d75-47b7-8fed-eb08013d3dee" facs="#m-f7e1fb24-4937-4159-ac06-ef981131615d" label="text-like">At the lesser Hours, ant. and pss. of Sunday (at Prime n° I);</l><l xml:id="m-0b017cd0-6b6d-409c-b6ed-1bd2a4559b04" facs="#m-cf0c467f-e414-4782-8aa5-53e70991389f" label="text-like">the rest, of the feast.</l><l xml:id="m-49fe3360-9956-4211-bcef-e81db33bcd7b" facs="#m-247eee22-41f0-44cc-9e9e-9d5ba1d3d76e" label="text-like">The two commemorations given at Mass and at both Vespers</l><l xml:id="m-b0c189a5-6388-4c9d-99c9-2d3d69e6e2fa" facs="#m-01afa121-5c1b-4e50-b6c7-44086319b34a" label="text-like">are no longer made; the same applies for the rubric placed at the</l><l xml:id="m-5e6e9074-f8af-4224-97fc-223186cd53cc" facs="#m-6f68abe3-e03c-479f-90c8-f4e9d05ba09d" label="text-like">beginning of II Vespers.</l></lg></div></section></score></mdiv></body></music>
</mei>