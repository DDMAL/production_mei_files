                <syllable xml:id="m-976872b9-0040-403d-8521-e0ee00e0e92c">
                  <syl /><neume facs="#m-7ecc9eb8-9d8d-4259-b6fc-b4f21b58bd36" type="punctum" xml:id="m-c677c676-5dee-4719-8c9a-8b744bec2f8b">
