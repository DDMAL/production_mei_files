="651" lrx="550" lry="688" /><zone xml:id="m-6001c6dd-19c2-425c-b83b-3a887c6d0725" ulx="161" uly="677" lrx="1124" lry="714" /><zone xml:id="m-ad4b5a7d-380d-4ecc-b0f7-989d724936dc" ulx="136" uly="713" lrx="1119" lry="750" /><zone xml:id="m-3e30c437-11c2-41a7-ac25-af814420551e" ulx="135" uly="733" lrx="296" lry="777" /><zone xml:id="m-b177ff08-bcb2-450e-8bcf-eda1f5444fa4" ulx="162" uly="765" lrx="889" lry="804" /><zone xml:id="m-3f6b5317-aabd-4b21-a1fc-d7046f3220ce" ulx="290" uly="807" lrx="969" lry="853" /><zone xml:id="m-6162168e-8020-4786-9cf9-1c7b52473149" ulx="164" uly="857" lrx="864" lry="893" /><zone xml:id="m-a1c0519a-92e2-41ea-b147-38b20f59ef73" ulx="165" uly="884" lrx="1125" lry="923" /><zone xml:id="m-3cf1c05d-af2e-4b38-9cf7-b393b4ea0f66" ulx="140" uly="919" lrx="1122" lry="951" /><zone xml:id="m-018790e8-d37a-402a-b08b-ae867193c57a" ulx="165" uly="945" lrx="779" lry="987" /><zone xml:id="m-e4f9dffd-328b-421a-a478-5153ef15fde0" ulx="308" uly="984" lrx="957" lry="1038" /><zone xml:id="m-a02f2681-9b22-4ac3-8d58-acf09c0a8d2e" ulx="164" uly="1033" lrx="867" lry="1071" /><zone xml:id="m-76ad2b1c-372b-44b8-8181-a75c50b62e41" ulx="164" uly="1066" lrx="1127" lry="1099" /><zone xml:id="m-38027289-8a7b-479f-a93b-0524b4960dca" ulx="137" uly="1096" lrx="1122" lry="1132" /><zone xml:id="m-93b19a89-2384-4b2f-86d0-c3754ba93fe6" ulx="137" uly="1119" lrx="298" lry="1161" /><zone xml:id="m-40073abe-83f8-4759-847e-72eb67dfbffe" ulx="165" uly="1151" lrx="784" lry="1194" /><zone xml:id="m-7760f3ae-489c-41d3-b2d1-b907c2790536" ulx="304" uly="1194" lrx="962" lry="1244" /><zone xml:id="m-c58ffc7d-3649-472d-981e-dc3306101975" ulx="166" uly="1242" lrx="870" lry="1280" /><zone xml:id="m-a8601347-d505-4f44-9276-5348ba1c795a" ulx="165" uly="1273" lrx="1129" lry="1307" /><zone xml:id="m-289eea35-5e10-4d41-ad63-fe859c1bd6de" ulx="141" uly="1304" lrx="1124" lry="1343" /><zone xml:id="m-9ccd18b0-8bcf-459d-990f-058874ba69e3" ulx="141" uly="1328" lrx="299" lry="1368" /><zone xml:id="m-bd4c5644-306a-4a10-a71c-b5c76d311b68" ulx="167" uly="1359" lrx="913" lry="1404" /><zone xml:id="m-65607540-32f8-402f-9627-c2cb701567c2" ulx="148" uly="1436" lrx="1130" lry="1490" /><zone xml:id="m-cc735607-bc2f-41f0-88bc-3822f7fec6d7" ulx="169" uly="1493" lrx="1017" lry="1539" /><zone xml:id="m-e17d7a4f-eb95-47d2-b626-5fb1357b8d62" ulx="560" uly="1535" lrx="712" lry="1580" /><zone xml:id="m-00a4559b-b04b-4401-b731-cd53ccb756d5" ulx="579" uly="1575" lrx="708" lry="1620" /><zone xml:id="m-2f77f3be-2121-4a5e-ac8b-7fc421410060" ulx="185" uly="1608" lrx="1131" lry="1654" /><zone xml:id="m-4f669ee2-f432-4054-868a-73b03eb1873a" ulx="152" uly="1648" lrx="1118" lry="1685" /><zone xml:id="m-89d8e62b-3334-4ac5-bf68-4569db7318ec" ulx="147" uly="1674" lrx="634" lry="1718" /><zone xml:id="m-384b2fed-fa60-4138-98b4-09f2d6f45778" ulx="174" uly="1707" lrx="784" lry="1749" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-1c4317bc-3e13-48c6-abf3-32baf4b68c63" n="1268" facs="#m-4994a0c8-be6b-4fe5-b28b-4ae1c0496f5a" /><div xml:id="m-66ae41a9-74c4-4745-b8af-03e9fdab6ccf">
            <lg xml:id="m-e723c0ae-6567-4b95-98dd-928d2c87fcb5">
              <l xml:id="m-1d35a7bf-0c3c-4e54-b23a-38c39cd3cabc" facs="#m-7db316e7-c805-4a62-adf4-534aac90705b" label="ambiguous">1078</l><l xml:id="m-d98076f3-4981-4dd5-af30-8b4482861599" facs="#m-727546e3-9f0c-4473-a89d-0ac4cf765fae" label="text-like">24th Sunday after Pentecost.</l><l xml:id="m-10b8eb81-d907-4ca4-a76e-c3a908f6ccc3" facs="#m-7c5a06de-1932-4c7a-a2bf-cb3601f9c37b" label="text-like">If there be 25 Sundays after Pentecost, the 2ath Sunday after Pentecost</l><l xml:id="m-170dfb2b-8c10-4bcc-bab2-59725a90d4ce" facs="#m-2fe2a51c-25a5-4f9f-9dd8-e03f4c43e72b" label="lyrics-like">vill be the óth Sunday after the Epiphany as given below.</l><l xml:id="m-8a330141-6c0f-4e55-903d-503c32abdd44" facs="#m-2e907e07-5716-4ba4-969b-ffc73a4651c1" label="lyrics-like">Ir there be 2o Sundars after Pentecost, the ãsth and aSth Sundays mill be</l><l xml:id="m-d2262821-0679-4c02-9c3f-016a988f2401" facs="#m-9a63d359-cc17-452b-bf6d-14f49a82deb5" label="lyrics-like">the Sth and óth Sundays after the Epiphany, respectively, as given below.</l><l xml:id="m-e0c23ba5-5d88-4f25-bb9f-4a9df090e1c3" facs="#m-7d0463dc-682c-42ed-a1ac-e40037ceda6f" label="text-like">If there be 27 Sundays after Pentecost, the 2ath, 25h. and 2oth Sundays</l><l xml:id="m-d027422a-8bba-4d3d-acd0-7f541dc9d906" facs="#m-f7e9722a-8222-4cf8-b6c9-af3899952302" label="lyrics-like">vill be the sth, Sth, and oth Sundays after the Épiphany, respectively, as</l><l xml:id="m-7790496b-469f-4379-9891-26ad561af446" facs="#m-266cfb39-4a84-4e52-9b47-f3af92614160" label="ambiguous">given belom.</l><l xml:id="m-e7f1a138-df97-437a-aca2-38a415b761ae" facs="#m-d9effc9c-bc67-47bf-b4b3-2d51d49b7287" label="text-like">If there be 28 Sundays after Pentecost, the 24h, 25th, 2oth, and arth</l><l xml:id="m-d5f34f7b-cc24-4c93-8c59-14704d0efd0e" facs="#m-b5841ab1-2451-408b-9f8e-37131fe21d8f" label="lyrics-like">Sundays will be the Brd, 4th, Sth, and óth Sundays after the Epiphany.</l><l xml:id="m-6ee6244e-f22b-4ddc-9cb5-4a9206406a8c" facs="#m-e98cf93b-c023-4b9d-9746-d2dde9490381" label="ambiguous">respectively, as given below.</l><l xml:id="m-f85c85b4-b91b-41ae-ba0d-c8589d0d558c" facs="#m-29e7ef08-5571-46ce-82c8-df1082a65e1f" label="text-like">on all the Sundars from the twenty-third to the last Sunday after</l><l xml:id="m-ba6b2059-e4ce-4a28-b3aa-31a255f27f93" facs="#m-ee3ae635-d95a-4bfd-984d-e2391f3f8775" label="text-like">Pentecost, the Introit, the Gradual, the Offertory, and the Communion are</l><l xml:id="m-647a1e9b-e81b-4f6f-88a8-2b3e78bb961c" facs="#m-663d9fbe-22f2-498e-84e4-e737be79cf7d" label="text-like">taken from the tuenty-third Sunday</l><l xml:id="m-a7174998-6667-4eb9-9bad-9a8afd2bfbbc" facs="#m-b37478a9-50d4-409c-8e95-ade4e9c7df5b" label="text-like">It must be noted that the Office indicated for the twenty-fourth Sunday</l><l xml:id="m-a4803aef-6c45-4596-950c-e9962ae92406" facs="#m-a7a20899-6c08-44c1-af02-15f202719f79" label="text-like">after Pentecost is always to be said on the last Sunday after Pentecost.</l><l xml:id="m-9dffbfb6-676b-4b75-8384-8edcabe07d88" facs="#m-273165d6-b946-4d3e-ae68-81aca0fb0391" label="text-like">The Third Sunday after the Epiphany.</l><l xml:id="m-fa6ecf85-a8c2-41b2-8d59-13f4bcf6538d" facs="#m-163822a8-7702-4443-90f1-e6c676023222" label="text-like">Introit, Gradual, Offertory, and Communion as on the twenty-third</l><l xml:id="m-f1be7c4a-6041-4086-a9eb-9e1499ddcc56" facs="#m-02efabf5-a7ac-4812-ba5b-ed1a143f3570" label="text-like">Sunday after Pentecost, p. 1074.</l><l xml:id="m-fdbb7a9a-16dd-4035-b377-0512c5485a45" facs="#m-6001c6dd-19c2-425c-b83b-3a887c6d0725" label="text-like">Collect. Epistle, Gospel, Secret, Postcommunion, Prayer at Vespers, and</l><l xml:id="m-2cb33008-202c-4daa-9f89-7db6baee2d6e" facs="#m-ad4b5a7d-380d-4ecc-b0f7-989d724936dc" label="text-like">Antiphon or the Magnificat as on the third Sunday after the Epiphany,</l><l xml:id="m-c06b51d5-fe8d-4264-ae62-0885d46c7785" facs="#m-3e30c437-11c2-41a7-ac25-af814420551e" label="ambiguous">pp. is9-o1.</l><l xml:id="m-6df78feb-7b98-4fe7-b325-4ba16311b023" facs="#m-b177ff08-bcb2-450e-8bcf-eda1f5444fa4" label="text-like">2. Collect. A cunctis. p. 498. — 3. At the priest's choice.</l><l xml:id="m-dd9b8472-1982-4ad3-9cb1-608b90c7a986" facs="#m-3f6b5317-aabd-4b21-a1fc-d7046f3220ce" label="text-like">The Fourth Sunday after the Epiphany.</l><l xml:id="m-bc616fe0-b1bf-4741-8a4b-e7051723c852" facs="#m-6162168e-8020-4786-9cf9-1c7b52473149" label="text-like">Introit, Gradual, Offertory, and Communion, p. 1074.</l><l xml:id="m-fb15fc87-06ae-47e3-acdd-fd7345bfac19" facs="#m-a1c0519a-92e2-41ea-b147-38b20f59ef73" label="text-like">Colleci, Epistle. Gospel, Secret, Postcommunion, Prayer at Vespers, and</l><l xml:id="m-83ee5a05-7f7b-4525-a08a-185941642778" facs="#m-3cf1c05d-af2e-4b38-9cf7-b393b4ea0f66" label="text-like">Antiphon ofthe Magnificat as on the fourth Sunday after the Epiphany, p. 492.</l><l xml:id="m-5f42ffc0-d036-493f-9799-7dcfe20c5803" facs="#m-018790e8-d37a-402a-b08b-ae867193c57a" label="text-like">2. A cunctis. p. 498. — 3. At the priest's choice.</l><l xml:id="m-67277403-bac9-482e-b2d4-330c55ff2b3f" facs="#m-e4f9dffd-328b-421a-a478-5153ef15fde0" label="text-like">The Fifth Sunday after the Epiphany.</l><l xml:id="m-87782554-bd4e-44b1-93c5-149a76f60ff8" facs="#m-a02f2681-9b22-4ac3-8d58-acf09c0a8d2e" label="text-like">Introit, Gradual, Offertory, and Communion, p. 1074.</l><l xml:id="m-c6087475-b966-4391-9d53-9a690a3f0678" facs="#m-76ad2b1c-372b-44b8-8181-a75c50b62e41" label="text-like">Colleci. Epistle, Gospel, Secret, Postcommunion, Prayer at Vespers, and</l><l xml:id="m-4bfa78ff-c660-4588-a5de-feb335d042af" facs="#m-38027289-8a7b-479f-a93b-0524b4960dca" label="text-like">Antiphon of the Magnificat as on the fifth Sunday after the Epiphany.</l><l xml:id="m-08546fab-e830-4dd1-81bf-2ededfd0d492" facs="#m-93b19a89-2384-4b2f-86d0-c3754ba93fe6" label="ambiguous">»p. 498-494.</l><l xml:id="m-4a99c3d1-1955-4285-9a45-e44524ccaaee" facs="#m-40073abe-83f8-4759-847e-72eb67dfbffe" label="text-like">2. A cunctis. p. 498. — 3. At the priest's choice.</l><l xml:id="m-7b8d815e-5efa-40b8-b684-4834e0309a37" facs="#m-7760f3ae-489c-41d3-b2d1-b907c2790536" label="text-like">The Sixth Sunday after the Epiphany.</l><l xml:id="m-93e54b4b-edbd-48f2-b42e-29ebbdc95c91" facs="#m-c58ffc7d-3649-472d-981e-dc3306101975" label="text-like">Introit. Gradual, Offertory, and Communion, p. 1074.</l><l xml:id="m-55e5d891-793f-4377-8670-1575cd52462b" facs="#m-a8601347-d505-4f44-9276-5348ba1c795a" label="text-like">Collect. Epistle, Gospel, Secret, Postcommunion, Prayer at Vespers, and</l><l xml:id="m-fde39227-be89-4f46-9fc7-eed3bb5b4f46" facs="#m-289eea35-5e10-4d41-ad63-fe859c1bd6de" label="text-like">Antiphon of the Magnificat as on the sixth Sunday after the Epiphany,</l><l xml:id="m-3c3402a3-c4d5-43b4-a808-d52e400fd197" facs="#m-9ccd18b0-8bcf-459d-990f-058874ba69e3" label="ambiguous">m. 189-491.</l><l xml:id="m-9bbf9bb4-2732-47bb-9f72-7c10daf98e32" facs="#m-bd4c5644-306a-4a10-a71c-b5c76d311b68" label="text-like">2nd Collect. A cunctis. p. 498. — 3. At the priest's choice.</l><l xml:id="m-59c41308-685c-4102-98a1-a78593e8a3fc" facs="#m-65607540-32f8-402f-9627-c2cb701567c2" label="text-like">The Twenty-Fourth &amp; Last Sunday after Pentecost.</l><l xml:id="m-5c07b3e4-d56c-43ed-90ce-bd22b881c468" facs="#m-cc735607-bc2f-41f0-88bc-3822f7fec6d7" label="text-like">All as on the twenty-third Sunday, p. 1074, except the followins:</l><l xml:id="m-dbcb1560-6a1d-4651-a4d4-510f4a8239b0" facs="#m-e17d7a4f-eb95-47d2-b626-5fb1357b8d62" label="text-like">AT MASS.</l><l xml:id="m-3a711bd2-ab4d-4420-aaa2-95f27fa9eeec" facs="#m-00a4559b-b04b-4401-b731-cd53ccb756d5" label="ambiguous">Collect.</l><l xml:id="m-162e3cbf-a4b5-4632-8585-68bd8cc220c5" facs="#m-2f77f3be-2121-4a5e-ac8b-7fc421410060" label="lyrics-like">(Xcita, quaésumus Dómine, tuó-l exsequéntes, * pietátis tuae remédia</l><l xml:id="m-d8cdceb5-6f05-4742-a0b4-25050be4e003" facs="#m-4f669ee2-f432-4054-868a-73b03eb1873a" label="lyrics-like">C rum fidélium voluntátes : t ut majóra percípiant. Per Dóminum.</l><l xml:id="m-92ca98f6-19cb-4af2-a5e9-663dc4b3daa3" facs="#m-89d8e62b-3334-4ac5-bf68-4569db7318ec" label="lyrics-like">divini óperis fructum propénsius</l><l xml:id="m-c0a91b18-1ce3-45c2-b30a-80f2b38cf076" facs="#m-384b2fed-fa60-4138-98b4-09f2d6f45778" label="text-like">2. A cunctis. p. 498. — 3. At the priest's choice.</l></lg></div></section></score></mdiv></body></music>
</mei>