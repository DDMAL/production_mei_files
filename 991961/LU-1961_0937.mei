  <music>
  <facsimile xml:id="m-a3993e42-5257-43db-9616-1a337de4dcbe" type="transcription">
    <surface xml:id="m-b858a9e7-7535-47a2-a07c-102dcbf032cb" lrx="964" lry="1534">
      <graphic xml:id="m-fc0f1edb-3edc-4c30-879f-65f85d135a1f" target="0937_original_image.tiff" /><zone xml:id="m-9e16ed76-1d69-40f0-846e-7c3c06039441" ulx="299" uly="91" lrx="610" lry="121" /><zone xml:id="m-03b13b92-1ab9-4284-8ad8-4f5e99ca3507" ulx="785" uly="92" lrx="853" lry="123" /><zone xml:id="m-4243d366-bb07-4676-90a8-309efffdf488" ulx="70" uly="138" lrx="852" lry="172" /><zone xml:id="m-37b70012-5cfb-4741-b796-2b977e235322" ulx="45" uly="167" lrx="851" lry="198" /><zone xml:id="m-4c340f8b-c426-4242-8271-223a5deff039" ulx="46" uly="192" lrx="851" lry="229" /><zone xml:id="m-36a5454e-b514-409d-b2af-c4a4c447e1fa" ulx="47" uly="219" lrx="849" lry="249" /><zone xml:id="m-8cf9e0af-ef5a-42ce-bca3-c1533d9df0de" ulx="46" uly="245" lrx="849" lry="282" /><zone xml:id="m-0ff32ff2-0bca-4ded-a260-e5fece5300d9" ulx="46" uly="273" lrx="511" lry="307" /><zone xml:id="m-b719a54e-2e1c-4949-bfeb-c850827d5cb9" ulx="71" uly="307" lrx="851" lry="340" /><zone xml:id="m-b760f778-190c-4e80-b6ba-c348057aaa63" ulx="46" uly="333" lrx="851" lry="364" /><zone xml:id="m-2bcee1f4-69d9-4177-b1ad-13fa55cccfe2" ulx="46" uly="363" lrx="851" lry="389" /><zone xml:id="m-843ddc81-a587-43ac-8ba2-220c4282f34b" ulx="46" uly="385" lrx="849" lry="419" /><zone xml:id="m-5c08c0bf-b2eb-47a3-b3bb-3c5eaf735b29" ulx="46" uly="411" lrx="325" lry="449" /><zone xml:id="m-0b4fc8e0-2ee4-422b-a4d3-5aef646cbbb2" ulx="72" uly="440" lrx="852" lry="478" /><zone xml:id="m-cf6a0517-f0e7-44ac-94c3-0b41a17510b9" ulx="47" uly="474" lrx="852" lry="508" /><zone xml:id="m-7075e289-2b45-4189-93c1-287cc08bffcc" ulx="46" uly="498" lrx="851" lry="530" /><zone xml:id="m-b0b1608d-20dc-4d52-ab0e-8da3093b608a" ulx="46" uly="525" lrx="557" lry="560" /><zone xml:id="m-a853cbed-51ae-4376-9995-1c905082dffa" ulx="72" uly="553" lrx="848" lry="589" /><zone xml:id="m-78377c17-4753-490d-8387-6d4c891d96c3" ulx="49" uly="580" lrx="767" lry="618" /><zone xml:id="m-f86410c4-636f-401d-986a-59372eb81dc3" ulx="137" uly="699" lrx="740" lry="741" /><zone xml:id="m-ae8e8cac-cb42-41a4-befd-4ca4db832fca" ulx="69" uly="744" lrx="849" lry="779" /><zone xml:id="m-430c8766-79c9-4e0a-be11-5048d03af1ed" ulx="46" uly="771" lrx="348" lry="808" /><zone xml:id="m-137eef85-4b3b-4ffb-8920-5ff8a4e13176" ulx="217" uly="818" lrx="675" lry="859" /><zone xml:id="m-83c92105-681e-4baf-8cb9-617b0b481fda" ulx="377" uly="865" lrx="525" lry="903" /><zone xml:id="m-576cc3cf-cea0-409c-823f-7324058c89a7" ulx="74" uly="897" lrx="850" lry="935" /><zone xml:id="m-967a6f89-d113-4818-a8af-dbed4d8f24bb" ulx="48" uly="928" lrx="294" lry="963" /><zone xml:id="m-b37e5140-ba9b-45cc-93b9-1a88ca32e388" ulx="72" uly="945" lrx="850" lry="986" /><zone xml:id="m-69b6bf93-0da3-4be1-97ee-78f8ca56337b" ulx="47" uly="976" lrx="412" lry="1010" /><zone xml:id="m-0e431b29-d714-45cb-8289-c51bc3a86d6a" ulx="74" uly="991" lrx="851" lry="1030" /><zone xml:id="m-f43b1107-eaae-4c55-9e84-edf4a80e8207" ulx="49" uly="1016" lrx="853" lry="1058" /><zone xml:id="m-dd193ceb-3827-4076-b0d7-ca8d62d5c995" ulx="49" uly="1040" lrx="852" lry="1081" /><zone xml:id="m-ad960570-c87f-402a-bbf2-3e8b170cfdd5" ulx="49" uly="1065" lrx="826" lry="1106" /><zone xml:id="m-882b313f-e290-4f5b-b2d0-b5bbef07b0f8" ulx="381" uly="1105" lrx="518" lry="1147" /><zone xml:id="m-66842772-b0cd-4687-987a-92ba876c140a" ulx="68" uly="1139" lrx="849" lry="1179" /><zone xml:id="m-d92ec305-9be4-4b6c-adc7-02e70b6acf02" ulx="44" uly="1167" lrx="850" lry="1202" /><zone xml:id="m-c1f48704-f95a-4728-8619-627e81183bdb" ulx="45" uly="1195" lrx="268" lry="1225" /><zone xml:id="m-f09cd9cc-f740-487c-badb-2992c04beb00" ulx="73" uly="1211" lrx="850" lry="1251" /><zone xml:id="m-55553df1-63e5-4d2f-92ac-f420352a228f" ulx="70" uly="1238" lrx="852" lry="1274" /><zone xml:id="m-eae8af83-93f2-4320-bdf1-e9829a253609" ulx="45" uly="1264" lrx="346" lry="1297" /><zone xml:id="m-9c78ded0-d329-45c4-af78-eeda60764c03" ulx="73" uly="1282" lrx="850" lry="1320" /><zone xml:id="m-7c04028a-7f4d-4de0-ac38-993423aa48b0" ulx="71" uly="1311" lrx="850" lry="1345" /><zone xml:id="m-088dfb50-a4ed-40e7-8c25-1a16f301279b" ulx="45" uly="1336" lrx="848" lry="1366" /><zone xml:id="m-b879d8d5-17f1-4bc1-9026-a0c5739bd641" ulx="46" uly="1361" lrx="173" lry="1390" /><zone xml:id="m-77cb60f2-45dc-4f69-a320-7df8f6b5ffb2" ulx="70" uly="1377" lrx="849" lry="1411" /><zone xml:id="m-e7145a9e-ad92-402d-82f0-ac4e0fe27f2d" ulx="47" uly="1401" lrx="848" lry="1434" /><zone xml:id="m-ec1e984d-d85c-44a8-902c-95c64c7af77c" ulx="46" uly="1424" lrx="849" lry="1464" /><zone xml:id="m-00c0d76f-add6-47da-a07e-89ec850a58d6" ulx="45" uly="1447" lrx="761" lry="1489" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-fce251c3-466b-421b-92de-0667f724b7a6" n="0937" facs="#m-b858a9e7-7535-47a2-a07c-102dcbf032cb" /><div xml:id="m-608c80a2-3a9a-4049-bb96-5912ed4be172">
            <lg xml:id="m-631f989a-6c5e-469c-9d83-18ec9bbe446b">
              <l xml:id="m-62720942-f938-4fe7-a597-51c98fbe99b8" facs="#m-9e16ed76-1d69-40f0-846e-7c3c06039441" label="text-like">The readings or lessons</l><l xml:id="m-7330168d-a235-4378-8469-5b183c1425a7" facs="#m-03b13b92-1ab9-4284-8ad8-4f5e99ca3507" label="ambiguous">7760</l><l xml:id="m-f6f8e614-60e4-4516-a3c7-76dc1b41c988" facs="#m-4243d366-bb07-4676-90a8-309efffdf488" label="lyrics-like">orámus ergo te, Dómine : ut Céreus iste in honórem tui nóminis</l><l xml:id="m-1c8f5242-b728-44bd-9d07-afd231eca6f0" facs="#m-37b70012-5cfb-4741-b796-2b977e235322" label="lyrics-like">consecrátus, ad noctis hujus calíginem destruéndam, indeficiens</l><l xml:id="m-e29a5c48-57bd-47cb-b4f7-2e73f5eb24b5" facs="#m-4c340f8b-c426-4242-8271-223a5deff039" label="lyrics-like">persevéret. Et in odórem suavitátis accéptus, supérnis lumi¬</l><l xml:id="m-ceefb34d-897a-4a57-a0b6-a7b8d90df7d4" facs="#m-36a5454e-b514-409d-b2af-c4a4c447e1fa" label="lyrics-like">náribus misceátur. Flammas eius lúcifer matutínus invéniat.</l><l xml:id="m-a36e12d7-0fb3-44ae-b651-7c0365dbd336" facs="#m-8cf9e0af-ef5a-42ce-bca3-c1533d9df0de" label="lyrics-like">Ille, inquam, lúcifer, qui nescit occásum. Ille, qui regréssus ab</l><l xml:id="m-e47e037c-0a6c-451a-8029-39a5f7c97bdd" facs="#m-0ff32ff2-0bca-4ded-a260-e5fece5300d9" label="lyrics-like">inferis, humáno géneri serénus illúxit.</l><l xml:id="m-b31828ba-d07f-412b-b9b2-ad464993eebd" facs="#m-b719a54e-2e1c-4949-bfeb-c850827d5cb9" label="lyrics-like">Precámur ergo te, Dómine: ut nos fámulos tuos, omnémque</l><l xml:id="m-5afdbe29-4186-4261-9532-44b5001dd90f" facs="#m-b760f778-190c-4e80-b6ba-c348057aaa63" label="lyrics-like">clerum, et devotíssimum pópulum : una cum beatíssimo Papa</l><l xml:id="m-c27d7bb2-9b13-4300-862a-d2a893a31132" facs="#m-2bcee1f4-69d9-4177-b1ad-13fa55cccfe2" label="lyrics-like">nostro N. et Antístite nostro N., quiéte témporum concéssa, in</l><l xml:id="m-022ff84c-9670-4201-aa0e-e024549b0b38" facs="#m-843ddc81-a587-43ac-8ba2-220c4282f34b" label="lyrics-like">his paschálibus gáudiis, assídua protectióne régere, gubernáre,</l><l xml:id="m-656fefc1-ddb3-4d92-9b55-e37b0c37e391" facs="#m-5c08c0bf-b2eb-47a3-b3bb-3c5eaf735b29" label="lyrics-like">et conserváre dignéris.</l><l xml:id="m-707bfc32-1865-43ab-b39b-f84614268dac" facs="#m-0b4fc8e0-2ee4-422b-a4d3-5aef646cbbb2" label="lyrics-like">Réspice étiam ad eos, qui nos in potestáte regunt, et, ineffábili</l><l xml:id="m-d33197be-02f5-4bcd-9c7a-65bcefa994c2" facs="#m-cf6a0517-f0e7-44ac-94c3-0b41a17510b9" label="lyrics-like">pietátis et misericórdiae tuae múnere, dírige cogitatiónes eórum</l><l xml:id="m-aa7277e6-c109-4f74-9d6c-b11f0bee266b" facs="#m-7075e289-2b45-4189-93c1-287cc08bffcc" label="lyrics-like">ad justítiam et pacem, ut de terréna operositâte ad caeléstem</l><l xml:id="m-ba9214cc-de57-4581-bb47-b87fc972f108" facs="#m-b0b1608d-20dc-4d52-ab0e-8da3093b608a" label="lyrics-like">pátriam pervéniant cum omni pópulo tuo.</l><l xml:id="m-92558cc7-170b-4808-a376-70d88a7c8740" facs="#m-a853cbed-51ae-4376-9995-1c905082dffa" label="lyrics-like">Per eúmdem Dóminum nostrum Jesum Christum Filium tuum</l><l xml:id="m-526d998c-4b4a-4e3b-b9c6-b2ac82a30699" facs="#m-78377c17-4753-490d-8387-6d4c891d96c3" label="lyrics-like">Qui tecum vivit et regnat in unitáte Spiritus Sancti Deus:</l><l xml:id="m-f76d9dc4-11ee-4edc-a54c-09acdd22219c" facs="#m-f86410c4-636f-401d-986a-59372eb81dc3" label="lyrics-like">per ómni-a saécu-la saecu-lórum. W. Amen.</l><l xml:id="m-07ca9d81-616b-4afd-9d97-b47502ab796f" facs="#m-ae8e8cac-cb42-41a4-befd-4ca4db832fca" label="text-like">After the Praise of Easter the deacon changes his aohite vestments for purple</l><l xml:id="m-9fd000b3-24ef-4709-a636-3ca431fd02a8" facs="#m-430c8766-79c9-4e0a-be11-5048d03af1ed" label="text-like">ones, and joins the celebrant.</l><l xml:id="m-33977f2e-38c4-495f-b508-29c402eeac4e" facs="#m-137eef85-4b3b-4ffb-8920-5ff8a4e13176" label="text-like">THE READINGS OR LESSONS</l><l xml:id="m-6cc37e29-5abb-448e-8eab-f530e82aba40" facs="#m-83c92105-681e-4baf-8cb9-617b0b481fda" label="ambiguous">Solemn rite</l><l xml:id="m-c43f6b3c-c4ab-4920-955b-2fa822127824" facs="#m-576cc3cf-cea0-409c-823f-7324058c89a7" label="text-like">The subdeacon puts the cross near the credence-table, on the Epistle side,</l><l xml:id="m-c9a56ad0-4ff1-466c-adc6-e6ad987264a7" facs="#m-967a6f89-d113-4818-a8af-dbed4d8f24bb" label="text-like">then joins the celebrant.</l><l xml:id="m-ccaf0375-35db-4c80-b437-2087ca03f4de" facs="#m-b37e5140-ba9b-45cc-93b9-1a88ca32e388" label="text-like">An acolyte removes the white covering from the lectern or places an unco¬</l><l xml:id="m-e05a6659-aae5-4693-b5b0-a1c5b67dcf7f" facs="#m-69b6bf93-0da3-4be1-97ee-78f8ca56337b" label="text-like">vered lectern ready for the Lessons.</l><l xml:id="m-0693ffa3-6168-4481-a920-c34ae2f96df5" facs="#m-0e431b29-d714-45cb-8289-c51bc3a86d6a" label="lyrics-like">The Lessons are then sung without tirle or Deo grátias at the end. They</l><l xml:id="m-e54e8939-c633-4f25-bd55-d60c7958a2e6" facs="#m-f43b1107-eaae-4c55-9e84-edf4a80e8207" label="text-like">ure sung in the middle of the choir by a capable reader in surplice, so placed</l><l xml:id="m-6f0d015b-6700-4ac1-95bd-5042ab898567" facs="#m-dd193ceb-3827-4076-b0d7-ca8d62d5c995" label="text-like">that he has the paschal candle in front of him, the altar on his righit, and</l><l xml:id="m-0b4b0b7f-ead1-4f9a-aff5-e9a865c588ef" facs="#m-ad960570-c87f-402a-bbf2-3e8b170cfdd5" label="text-like">the nave of the church on his left. The servers and people all sit and listen.</l><l xml:id="m-f98e8b40-bbbc-40a6-a8a5-0317a11b76e9" facs="#m-882b313f-e290-4f5b-b2d0-b5bbef07b0f8" label="ambiguous">Simple rite</l><l xml:id="m-2bb75aab-a118-4ddb-acce-054f7291bdad" facs="#m-66842772-b0cd-4687-987a-92ba876c140a" label="text-like">(After the Praise of Easter, the celebrant goes back to his place, takes off</l><l xml:id="m-5ae1adbc-6337-4287-a1e0-a339e77b5a6e" facs="#m-d92ec305-9be4-4b6c-adc7-02e70b6acf02" label="text-like">the uhite dalmatic and stole and again puis on the purple stole and cope,</l><l xml:id="m-0e40dc76-4c9b-4ed7-b248-73f5d0e2ef86" facs="#m-c1f48704-f95a-4728-8619-627e81183bdb" label="text-like">helped by the servers.</l><l xml:id="m-3ec8e712-5247-4c9c-a5ce-e65c42f424e8" facs="#m-f09cd9cc-f740-487c-badb-2992c04beb00" label="text-like">The cross-bearer puis the cross near the credence-table, on the Epistle side.</l><l xml:id="m-4ffe9eae-a0a9-48a5-9ec6-78d912223baa" facs="#m-55553df1-63e5-4d2f-92ac-f420352a228f" label="text-like">A server removes the wohite covering from the lectern or places an uncovered</l><l xml:id="m-9f8f4c9e-d01f-4c23-b613-15ecd75ddd0e" facs="#m-eae8af83-93f2-4320-bdf1-e9829a253609" label="text-like">lectern ready for the Lessons.</l><l xml:id="m-ced87087-0bdf-4845-8bbf-ac7f8c081366" facs="#m-9c78ded0-d329-45c4-af78-eeda60764c03" label="text-like">The celebrant, in purple cope and stole, goes to the lectern for the Lessons.</l><l xml:id="m-c9952b24-693d-40cf-9b52-05a949de349c" facs="#m-7c04028a-7f4d-4de0-ac38-993423aa48b0" label="text-like">I there is a capable reader, he may sing or read the Lessons, in a surplice;</l><l xml:id="m-7ad47a20-6455-4076-acb4-1ccd9d200535" facs="#m-088dfb50-a4ed-40e7-8c25-1a16f301279b" label="text-like">in that case the celebrant sits and listens, and remains at his seat to sing</l><l xml:id="m-5061835b-8e76-46bb-8154-cf139a18a504" facs="#m-b879d8d5-17f1-4bc1-9026-a0c5739bd641" label="text-like">the Collecis.</l><l xml:id="m-1c1e664d-494a-40e6-bdbd-7ba0076a7568" facs="#m-77cb60f2-45dc-4f69-a320-7df8f6b5ffb2" label="lyrics-like">The Lessons are read without a title and without Deo grátias at the end.</l><l xml:id="m-cb8840ef-6673-47dc-a679-2d30c2fa4ae7" facs="#m-e7145a9e-ad92-402d-82f0-ac4e0fe27f2d" label="text-like">They are sung in the middle of the choir in such a way that the reader</l><l xml:id="m-a381f623-96c1-4430-a769-5e59a1667a7b" facs="#m-ec1e984d-d85c-44a8-902c-95c64c7af77c" label="lyrics-like">Ior priestl has the paschal candlé in front of him, the altar on his rieht, and</l><l xml:id="m-f55ea3cc-cc65-4343-a621-c95a980d63b2" facs="#m-00c0d76f-add6-47da-a07e-89ec850a58d6" label="lyrics-like">the church door on his left. The servers anã people all sit and listenl.</l></lg></div></section></score></mdiv></body></music>
</mei>