x="940" lry="1593" /><zone xml:id="m-31d1710a-6622-4b68-afd6-454b3988323d" ulx="975" uly="1550" lrx="1014" lry="1587" /></surface>
    </facsimile>
    <body xml:id="m-5d0d449e-dff4-4ad2-b52f-058c38961834">
      <mdiv xml:id="m-db33a306-8a1b-4f05-b581-8817d0f9bf09" type="solesmes">
        <score xml:id="m-1a990fd4-6751-4733-9efa-a7258db63f32">
          <scoreDef xml:id="m-a6b52d1e-54b9-409b-95ce-1b1417a13919">
            <staffGrp xml:id="m-955a2e66-9a8e-4e8c-a3bc-70524706d68c">
              <staffDef xml:id="m-a8c032d2-067d-49cb-9acd-efb3f78c29eb" n="1" notationtype="neume" lines="4" />
            </staffGrp>
          </scoreDef>
          <section xml:id="m-0d1bf227-5a3a-4d04-a3fb-1e87fe689248">
            <pb xml:id="m-ad4d8734-3588-4a67-a5dc-b43331a77b1c" n="638" facs="#m-227daa4a-4416-4fa1-b9fc-c42042e0a86d" />
            <staff xml:id="m-d14b126b-09f8-47e4-acd2-ffd8cd9ef158" n="1">
              <layer xml:id="m-5d1ff960-3850-4d03-8299-a181fd154fb9" n="1">
                <sb xml:id="m-9dcedda0-f253-451b-9fb7-c362e9afdecd" n="1" facs="#m-809486f7-2897-44e8-b6fd-9fefe91a3ad5" />
              </layer>
            </staff>
            <div xml:id="m-1aa0f894-369c-40f4-b12f-a4cbc2d76f9b">
              <lg xml:id="m-35881cc6-93ce-44d9-b1d6-7acad78d7599">
                <l xml:id="m-82cc0183-7107-485d-a59a-4fbd774268c9" facs="#m-e566a5fd-7249-4545-bce0-4569f45abf28" label="ambiguous">492</l><l xml:id="m-5b392f5f-c885-4285-9e7f-8d3c13c0aa8e" facs="#m-eb2edaf4-1509-446d-b61b-d4f68f11e0e2" label="text-like">4th Sunday after the Epiphany.</l><l xml:id="m-05f1594d-6763-4ee5-a192-265703d392dc" facs="#m-5c7446de-2816-454f-8ef5-786fc6ca0a06" label="text-like">The Fourth Sunday after the Epiphany.</l><l xml:id="m-e6313b50-c431-45a1-a940-57e0fbaa7b56" facs="#m-f6fc0f96-8a25-4342-9edd-ad3e731d1e43" label="text-like">As on the third Sunday, except the following:</l><l xml:id="m-f5b1f815-8c5c-4c28-913c-b85e6bb6db70" facs="#m-462dd3a0-c6b1-4882-bfa3-31078ae85a58" label="text-like">AT MASS.</l><l xml:id="m-5db3fed9-b013-4099-ad7c-934ab90dac68" facs="#m-290571b8-f631-4e5d-897b-fd4117032265" label="ambiguous">Collect.</l><l xml:id="m-61682006-e8f3-40e4-80f1-51985b97cb67" facs="#m-19bda302-82c3-4322-9ce0-f79c4b8421b7" label="lyrics-like">Eus, qui nos in tantis periculis, ris; * ut ea quae pro peccátis no¬</l><l xml:id="m-7d0539e6-81db-4967-87c5-e2c10d8845ef" facs="#m-20c9842c-71aa-461f-ab06-54f3dedf5d2a" label="lyrics-like">I constitútos, pro humána scis stris pátimur, te adjuvánte vincá¬</l><l xml:id="m-dc7237b9-ad01-4a20-bf69-d102c19c06a5" facs="#m-b4b6cecc-eef1-4769-834f-b3bfe18a3603" label="lyrics-like">mus. Per Dóminum.</l><l xml:id="m-4895b7f5-8f08-4cd6-862e-1c008d04ff42" facs="#m-cffa7b25-d429-45fa-ae51-d370a390afac" label="lyrics-like">fragilitáte non posse subsistere: t</l><l xml:id="m-a962d706-c0ff-47df-9908-49a7dc6f80b8" facs="#m-43c9e340-6385-4d6d-9d01-72526af2d13f" label="lyrics-like">da nobis salútem mentis et córpo¬</l><l xml:id="m-d4772b15-1f54-412f-9a51-bea7310f3e17" facs="#m-d82806e7-b08e-4b89-ae50-09102476ad73" label="lyrics-like">Second Collect of Our Lady. Deus qui salútis. p. 441. Third Collect for</l><l xml:id="m-51abb171-8546-42c5-8100-2eaf55605ca3" facs="#m-55dc6503-833b-48d7-8366-d8e7eab418a1" label="text-like">the Church or for the Pope, p. 819</l><l xml:id="m-054688fd-1f7b-4d22-b031-b89d8c77c12b" facs="#m-4cd4c2ba-bd40-4103-befc-b6b2a87b052e" label="text-like">After the Purifeation, Second Collect. A cunctis. p. 498. Thira at</l><l xml:id="m-0ea6e24c-111a-4c53-a98e-136c89e7c6ee" facs="#m-711b15da-30af-4415-9e19-7737a5f3b57e" label="text-like">the Priest's choice.</l><l xml:id="m-2f6dc426-5112-4801-a819-8d16378f3288" facs="#m-eeaed64a-187b-4f12-b002-af6a918de253" label="ambiguous">Lectio Epistolae beati Pauli Apostoli ad Romanos. Rom. 13. c.</l><l xml:id="m-058fb8eb-1c6e-4f01-99ad-78c2be47fb09" facs="#m-fb208727-8e85-4115-a3c8-43d88c69fa0e" label="lyrics-like">L'Ratres: Némini quidquam de-f concupisces : et si quod est áliud</l><l xml:id="m-3457813a-9ca8-4cee-b909-59fa6d927251" facs="#m-aceb31cb-92d1-4e22-b541-2f891a728c72" label="lyrics-like">T beátis, nisi ut invicem diligátis:</l><l xml:id="m-b7002c45-b656-4d7b-9080-e7bcb1434bf9" facs="#m-f8f321c2-48e1-4318-9f27-069d2fd1f1e0" label="lyrics-like">mandátum, in hoc verbo instaurá¬</l><l xml:id="m-a9913aca-dc7f-4212-b45c-6edec04885bc" facs="#m-31f7af9b-2002-4267-a191-1c76fc96741e" label="lyrics-like">qui enim díligit próximum, legem</l><l xml:id="m-ce6cf66b-9623-49c1-9481-173d334c35e6" facs="#m-36b84c1a-1d69-4284-91bc-25bbc3d906b4" label="lyrics-like">tur : Diliges próximum tuum sicut</l><l xml:id="m-1787506e-ba49-4b71-8324-fcd66fa17a19" facs="#m-6926eac1-1749-4e96-bddd-68c9e6bae7ac" label="lyrics-like">implévit. Nam: Non adulterábis:</l><l xml:id="m-8f3e8a66-f480-42bf-9930-5acf9936c716" facs="#m-a5ab739d-aff0-4cfa-8424-f838923a549b" label="lyrics-like">teipsum. Diléctio próximi malum</l><l xml:id="m-1ae0977a-b621-4cf1-b9e2-103a8e245227" facs="#m-8f8a570b-24cf-49f6-b497-3342655f6792" label="lyrics-like">Non occides : Non furáberis : Non</l><l xml:id="m-aadcbe20-c4ce-48ff-95f9-6e60991e4230" facs="#m-fa3788ae-6688-4d0a-94eb-c22bf281e7fd" label="lyrics-like">non operátur. Plenitúdo ergo legis</l><l xml:id="m-c9d9e06d-31bb-4c69-adc3-7be348c1200a" facs="#m-360172b1-d0d2-4615-87b6-5f1867b7c757" label="lyrics-like">falsum testimónium dices: Non est diléctio.</l><l xml:id="m-2b3d6c18-0dc1-4244-b4ee-6f6f50cf1d94" facs="#m-f70be514-b7d9-4c43-92df-da970e7ddaa1" label="ambiguous">† Sequentia sancti Evangelii secundum Matthaeum. Matth. S. c.</l><l xml:id="m-723e5b2e-b5b7-4f44-8e2d-64a13232ac7e" facs="#m-eb1d9c5d-da12-4f27-8c6b-9e4614a6f808" label="lyrics-like">TN illo témpore : Ascendénte Jesu límus. Et dicit eis Jesus : Quid timidi</l><l xml:id="m-6e29eab9-8d1e-4326-a80e-71ed7fc25672" facs="#m-b56bc005-13ba-4b14-a526-0b2726912453" label="lyrics-like">L in navículam, secúti sunt eum</l><l xml:id="m-544073c7-152a-4fcb-9c05-32652b1fbe87" facs="#m-393039d7-afb3-4dc1-95a7-2560a40e0090" label="lyrics-like">estis, módicae fidei? Tunc surgens,</l><l xml:id="m-da7abd28-6b31-4399-aaf4-59e4b1ed2a38" facs="#m-969df606-f60e-4d74-a5af-33b35156b85b" label="lyrics-like">imperávit ventis et mari, et facta</l><l xml:id="m-f3c764e1-1009-4463-a805-838b2e38dcac" facs="#m-d6b07b14-447c-4296-856d-be890fa0b169" label="ambiguous">discipuli ejus: et ecce motus ma¬</l><l xml:id="m-2f140a9e-0224-4941-81c4-62ba9388625c" facs="#m-83fcae24-04af-46af-b39a-8616e4b0ee70" label="lyrics-like">est tranquillitas magna. Porro hó¬</l><l xml:id="m-bda5c136-b44a-45a6-af34-9e6faf96be92" facs="#m-2176604d-dfd1-42a4-941e-f14610f06efb" label="lyrics-like">gnus factus est in mari, ita ut naví¬</l><l xml:id="m-a2332789-23b6-4660-9fd3-771665ed17be" facs="#m-1ca16bcd-128f-48f3-931e-c74bf9aebc20" label="lyrics-like">cula operirétur flúctibus, ipse vero</l><l xml:id="m-a77a4dd4-b956-4248-a0c0-91b0bcc612e1" facs="#m-13bcede0-1cb7-48a2-af50-52f292af5002" label="lyrics-like">mines miráti sunt, dicéntes : Qualis</l><l xml:id="m-2e81120f-6514-4a8d-9c67-fbf69fa986c8" facs="#m-ebdcd4ed-9de5-454b-bdbb-301f2dd07e99" label="lyrics-like">est hic, quia venti et mare obédiunt</l><l xml:id="m-48412e08-18fe-4d8a-8c1a-e2e5e204b703" facs="#m-1ee8cea7-af91-4218-88d3-79424a50b057" label="lyrics-like">dormiébat. Et accessérunt ad eum</l><l xml:id="m-2869362a-984e-475c-8c8d-5cc0ce2c41ef" facs="#m-d3a326b3-f63d-48d3-9e51-6463468a1ca9" label="ambiguous">Credo.</l><l xml:id="m-b3ce776f-2a52-4814-80b4-d85102fce369" facs="#m-3879a380-3b7c-4923-b39a-c997d44c488b" label="ambiguous">ei?</l><l xml:id="m-a0be519c-f888-4968-9705-2bc43cb93a78" facs="#m-c03c2951-7924-4114-8ded-aa63d580163b" label="lyrics-like">discipuli ejus, et suscitavérunt eum.</l><l xml:id="m-88282bcb-194e-4e54-9e12-6003c1801ca1" facs="#m-59538975-b1db-4755-a955-681537df80c6" label="lyrics-like">dicéntes : Dómine, salva nos, per¬</l><l xml:id="m-f2f7d23e-3ee1-41f9-8ab2-8aec3cb95de5" facs="#m-08f2fddc-98b3-4627-b244-e9d654082b34" label="ambiguous">Secret.</l><l xml:id="m-ee805046-b485-4719-a4a0-706d006ae4f5" facs="#m-27402903-1f62-4670-b466-d394a6f6b142" label="lyrics-like">VOncéde, quaésumus omnípotens! omni malo purget semper, et mú¬</l><l xml:id="m-0158d680-194f-4ed9-a2b7-06036408bef5" facs="#m-575629de-5942-4be5-9fed-63e7d45c7d4f" label="lyrics-like">U Deus: ut hujus sacrificii munus niat. Per Dóminum.</l><l xml:id="m-455758dc-78bd-4ce5-8c00-55df225f8456" facs="#m-38c9174b-c031-41e5-b2de-0b864e20dfd1" label="lyrics-like">oblátum, fragilitãtem nostram ab</l><l xml:id="m-5ae4a5aa-3ddd-46e9-94b7-0052088da61c" facs="#m-bd5c1cc7-4a61-4584-b2b3-de37cc3f771c" label="lyrics-like">Secret of Our Lady. Tua Dómine. P. 1268. St rthe Church or for</l><l xml:id="m-9e65b170-12e8-425a-a142-af7129fa6701" facs="#m-05d80944-6986-427a-81f4-3d30f8aecbee" label="text-like">the Pope, p. 322.</l><l xml:id="m-069eeeb1-667e-439a-a675-912e95ffb306" facs="#m-78791bfb-eb26-43f7-b3c5-38c4cf92c2d4" label="lyrics-like">After the Puriñcation, Second Secret. Exáudi nos. p. 50l. Third at</l><l xml:id="m-c9236029-ec41-4299-bbb5-f86e699fdb70" facs="#m-42e190a4-5548-40ef-a077-26b25bd54556" label="text-like">the Priest's choice.</l><l xml:id="m-247c13f5-3527-44bf-b87f-8323cdf682b6" facs="#m-50c85174-3e4a-42e2-b5a9-2b6a1074dadf" label="ambiguous">Postcommunion.</l><l xml:id="m-991c7688-3764-4d1d-aba5-505b66f7a877" facs="#m-3a493626-58d5-4cec-b5a0-092e3b8e8bba" label="lyrics-like">Unera tua nos, Deus, a dele-[ diant, et caeléstibus semper instáu¬</l><l xml:id="m-bc7690d3-0877-4095-b55d-8a2469d6f31e" facs="#m-45402f85-fed1-45d7-b007-c5c60b0bc910" label="lyrics-like">316 ctatiónibus terrénis expé-lrent aliméntis. Per Dóminum.</l><l xml:id="m-a888a402-9029-46c8-b4d3-6d63a64e1cef" facs="#m-9e80984a-adbf-4617-92f2-da9ff6d129e1" label="text-like">Postcommunion of Our Lady. Haec nos. 42. Postcommunion for the</l><l xml:id="m-9889d9c8-462a-4345-922e-d7585cb7e806" facs="#m-b9e2ae1c-6f27-4478-b0fc-6ed3d0c1f173" label="text-like">Church or for the Pope, p. 828.</l><l xml:id="m-3aab8229-d0c2-4b2a-9c09-954ba428e9cf" facs="#m-e4dc91cd-1672-4b11-8887-a8b21e26b0f9" label="lyrics-like">After the Purification, Second Postcommunion. Mundet et múniat.</l><l xml:id="m-0d61cd45-1eab-48ec-bbe7-e97fbe2a1194" facs="#m-796e3f10-d98f-4162-a920-f5de3d24bbe0" label="text-like">.502. Third at the Priest's choice.</l><l xml:id="m-70663b77-72d4-456d-ad49-464783b503ab" facs="#m-983854a8-9165-4756-ae1e-cbd3d6f53146" label="text-like">AT VESPERS.</l><l xml:id="m-0272cf80-da49-492a-8a27-b52afa9997a2" facs="#m-66b204e3-4114-4685-8ae0-56f19fdf9688" label="text-like">At Magn.</l><l xml:id="m-c2266d5c-cb6c-43c0-a229-76ffb8c4f3d3" facs="#m-c5fca93e-94a4-4551-9f7a-bfdc71e903a1" label="ambiguous">Ant. 1782</l><l xml:id="m-519323cc-ace0-44d3-90c5-bf77b2f479df" facs="#m-f2928492-9aa1-4751-a894-ef5982a1741a" label="ambiguous">O</l><l xml:id="m-6bae1c1b-5582-4f95-9fe7-48c9637b43c8" facs="#m-94b4019e-ca31-4d8d-a841-08bb81a6e255" label="lyrics-like">Omine, “ sálva nos, per-ímus : impera,</l><l xml:id="m-6089af1e-5343-4dbf-826b-a33c2924228f" facs="#m-31d1710a-6622-4b68-afd6-454b3988323d" label="ambiguous">et</l></lg>
            </div>
