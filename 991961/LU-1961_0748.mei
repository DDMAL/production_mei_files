                    <nc xml:id="m-a5a8dc5c-886b-46f2-a957-e037a0bf2365" pname="c" oct="4"><episema xml:id="m-7331d811-8300-4fe8-aca4-d75d7fa231fb" form="v" /></nc>
                  </neume>
                </syllable>
                <syllable xml:id="m-533f2b3b-bda7-4cb3-8ef7-38e68122520e">
                  <syl /><neume facs="#m-a75ae430-4748-400f-ac1f-b59b17c8040f" type="punctum" xml:id="m-1fdae062-011a-47f5-9c9c-90de1eff15ac">
                    <nc xml:id="m-ec179b77-7a17-4165-9b5c-5e317bb86226" pname="b" oct="3" tilt="se" />
                  </neume>
                </syllable>
                <syllable xml:id="m-d629dbaa-9c9a-4a6c-acfa-c8c5c4d61842">
                  <syl /><neume facs="#m-ab873b01-9471-4d84-a3a4-c7af5baa680e" type="punctum" xml:id="m-012dfe55-faae-4e09-9695-04923d6819d2">
                    <nc xml:id="m-2312a8c2-4529-4e86-9304-2b075f8c9e75" pname="a" oct="3" tilt="se" />
                  </neume>
                </syllable>
                <syllable xml:id="m-fd097354-6836-4e41-a89b-2609d0ec2dc4">
                  <syl /><neume facs="#m-c26e9e7a-79c2-45eb-a713-d99546ad855e" type="cephalicus" xml:id="m-2ed4fb6f-f4a3-4acf-9fb7-d777cf44b5de">
                    <nc xml:id="m-c5eba095-6fe4-483a-a47a-1c02495e703d" pname="a" oct="3" />
                    <nc xml:id="m-704521ed-29c9-4f93-9cc1-7a6173d79ef2" pname="g" oct="3" />
                  </neume>
