 lrx="472" lry="592" /><zone xml:id="m-1cc6a687-ec0d-4ec9-925d-7c3fee7f7756" ulx="528" uly="576" lrx="639" lry="612" /><zone xml:id="m-25097e0f-254e-4fd6-8fe4-595daac8dd39" ulx="178" uly="607" lrx="1033" lry="648" /><zone xml:id="m-7f8c21dc-5f93-4a8b-9fca-3cb01e59b415" ulx="137" uly="636" lrx="1032" lry="676" /><zone xml:id="m-25ff8381-c709-42fc-8c0a-34016c1c76ee" ulx="136" uly="666" lrx="1031" lry="703" /><zone xml:id="m-5a146d2c-3135-4af1-8c92-e9698afce3ba" ulx="136" uly="697" lrx="584" lry="732" /><zone xml:id="m-9ae7a851-693f-4a81-8ae0-ad39082ff2c7" ulx="388" uly="769" lrx="791" lry="821" /><zone xml:id="m-1f3f78d6-29f3-4ab4-8f30-5227023d77f6" ulx="137" uly="774" lrx="197" lry="820" /><zone xml:id="m-e6b64a43-7c5d-412d-a8b9-5fd3ecfd591f" ulx="865" uly="775" lrx="1033" lry="819" /><zone xml:id="m-2474f742-c48d-4dc2-9fc9-44ffa2e8cd88" ulx="530" uly="816" lrx="644" lry="859" /><zone xml:id="m-7891705e-eaa7-4c81-a712-d41b28f9b5b0" ulx="159" uly="851" lrx="1035" lry="890" /><zone xml:id="m-2c4defd4-8ac0-4f52-9dfd-0f0c5d1c322c" ulx="142" uly="879" lrx="1031" lry="916" /><zone xml:id="m-51eb3375-4cfa-4131-91c7-6831668a7fcb" ulx="138" uly="908" lrx="697" lry="946" /><zone xml:id="m-1626fa3c-8fd6-420d-96de-1e494cc403de" ulx="534" uly="943" lrx="637" lry="974" /><zone xml:id="m-b7dec399-ccc9-48ec-9a16-bf2155c9f0b8" ulx="159" uly="969" lrx="1037" lry="1010" /><zone xml:id="m-e1314978-3428-4c49-8684-e311d4f2891a" ulx="140" uly="998" lrx="581" lry="1036" /><zone xml:id="m-5a737add-6a70-4e6a-a11c-d6c176d93f1f" ulx="590" uly="1002" lrx="1035" lry="1033" /><zone xml:id="m-e45131c6-09bb-4e98-9f48-1864568f95da" ulx="138" uly="1027" lrx="731" lry="1061" /><zone xml:id="m-f5c89466-7dcd-4d6e-a20a-bad698d33aa0" ulx="449" uly="1060" lrx="698" lry="1093" /><zone xml:id="m-b15228ed-c8e8-488f-ae18-d7af241623bb" ulx="148" uly="1088" lrx="1035" lry="1123" /><zone xml:id="m-fd6c1041-9812-4116-83f7-51808b0c114b" ulx="141" uly="1122" lrx="989" lry="1158" /><zone xml:id="m-c072eabb-d96b-402d-bf8e-0be4cf8fb5c5" ulx="138" uly="1147" lrx="590" lry="1184" /><zone xml:id="m-2b5c407b-1271-4df0-b4ac-798bee2cf28e" ulx="298" uly="1241" lrx="867" lry="1291" /><zone xml:id="m-67b2d1fa-add2-4b1d-b493-2077b280c967" ulx="142" uly="1247" lrx="203" lry="1292" /><zone xml:id="m-a253a6ab-7834-43ea-8ec3-2b934dd8a727" ulx="229" uly="1296" lrx="1038" lry="1339" /><zone xml:id="m-caf9bd09-2ec7-42a7-98bb-b7ef8602b332" ulx="167" uly="1346" lrx="1035" lry="1388" /><zone xml:id="m-59e3ed51-3f17-4e69-b76e-3d61249fa65b" ulx="141" uly="1375" lrx="245" lry="1417" /><zone xml:id="m-ec48c9b5-a794-4e00-8d20-e6cea7e34191" ulx="169" uly="1416" lrx="535" lry="1461" /><zone xml:id="m-98811fca-23cc-455a-8a19-66dcc78707a0" ulx="535" uly="1467" lrx="648" lry="1499" /><zone xml:id="m-b01542d4-8f3b-41cf-9d07-193e7b8ddb3f" ulx="188" uly="1506" lrx="1040" lry="1539" /><zone xml:id="m-1f1c63f6-a2f8-4954-bc0c-a9594df4e425" ulx="151" uly="1533" lrx="1037" lry="1567" /><zone xml:id="m-928b4161-5ba3-44f4-acf6-3dac09f3bb6c" ulx="144" uly="1562" lrx="1033" lry="1601" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-73e8b771-d7bd-4578-ba6f-daa3eddd8a03" n="1602" facs="#m-47c60a4c-14ac-4700-9026-339ebb743d27" /><div xml:id="m-30cd9e62-936e-40a2-87cf-8fbae1771151">
            <lg xml:id="m-c918f274-cfed-4f5b-8a1d-c9c60148e6e2">
              <l xml:id="m-fc0fb687-c713-4440-abbb-75e51d82e6e0" facs="#m-884866e0-44d7-4380-94f9-2bc2dbf06c51" label="ambiguous">1398</l><l xml:id="m-71d9b71f-46f0-4cd7-b291-87157bc687a7" facs="#m-fd5cd231-ba5a-430c-89da-b3d5c913a94b" label="ambiguous">March 8. 9. 10. 12.</l><l xml:id="m-18ce73fb-0e1f-4c3b-99b9-5ab6f888523c" facs="#m-7e3a773f-35d3-4672-823a-cae8b8996517" label="text-like">St. John of God, Confessor.</l><l xml:id="m-17533b59-8f12-49ac-a8bc-8f72a86bd762" facs="#m-5b4b2d89-b3fb-4142-9be9-2aefbf8b5131" label="ambiguous">8.</l><l xml:id="m-831831da-27f9-4ce5-90f9-13ea619bf6e2" facs="#m-293e6f85-5da7-4ad2-85b7-843e54e7dc02" label="ambiguous">Double.</l><l xml:id="m-ce8addda-8fa8-4c9c-8dfa-2f82229b0abe" facs="#m-b844d257-a9f9-45d5-9e89-41c8a79bcf5b" label="lyrics-like">Mass. Os jústi. from the Common of a Confessor not a Bishop, p. 1200,</l><l xml:id="m-fe3d2ba2-f7bb-458e-8c29-d198d41cd0bd" facs="#m-90c12442-e139-4f0a-bfdb-1cdae169df74" label="text-like">except the follouing:</l><l xml:id="m-2368d7d3-353b-4d06-ab6a-55975ef58932" facs="#m-43e994a9-c8eb-4a6b-8715-f4035b342858" label="ambiguous">Collect.</l><l xml:id="m-7ac480bd-bf3c-4197-aa6d-ef9ea3308fb3" facs="#m-619f292a-e486-4ed8-af9e-44920b6ebcc7" label="lyrics-like">Eus, qui beátum Joánnem, tuo fragántibus méritis; ut igne caritá¬</l><l xml:id="m-f6e2364a-b735-4c33-882e-e942d034fb25" facs="#m-3b3ecefe-2dc7-46fc-b6bf-6ccb60fa931e" label="lyrics-like">U amóre succénsum, inter flam- tis tuae vítia nostra curéntur, * et</l><l xml:id="m-fff62f42-cf31-43dd-8928-7e4f4a3ee195" facs="#m-41b0e5dc-713a-48d3-8c12-9cf97de98786" label="lyrics-like">mas innóxium incédere fecisti, et</l><l xml:id="m-eba387c0-629b-41c3-814c-578a0f77cced" facs="#m-1b5e69d4-b725-49fd-b53b-54884f1b724c" label="lyrics-like">remédia nobis aetérna provéniant.</l><l xml:id="m-fe35c9c3-c7e1-4dfe-b60b-b4b3b8cadf8d" facs="#m-d993c417-893c-4567-b428-bf9b68f60660" label="lyrics-like">per eum Ecclésiam tuam nova prole</l><l xml:id="m-dd37b932-7683-4fd3-a811-7dbfb5d3a9c6" facs="#m-0dc7d0a1-8511-4b98-9f54-07d895ffb969" label="lyrics-like">Per Dóminum.</l><l xml:id="m-8cb3a0bb-33a1-4657-aa55-4fe4dc95df93" facs="#m-1677e594-c2f0-4533-bd6e-e8744b44d18e" label="lyrics-like">foecundásti: t praesta, ipsíus suf¬</l><l xml:id="m-c83d7814-3e8c-4dc6-806a-22e1c05e1651" facs="#m-5b349f7c-f27b-4512-bd94-a70e0d506d17" label="lyrics-like">Gospel. Accessérunt ad Jesum. p. 1049.</l><l xml:id="m-8403dcbf-e6b4-4d6b-80e1-803268a19679" facs="#m-955f73ee-baa5-41ae-b5e6-b823979c5ceb" label="text-like">St. Frances of Rome, Widow.</l><l xml:id="m-26557ea0-a418-4b85-ae38-c274a4d8cbec" facs="#m-487b1da1-54f7-44a1-a649-97bf8276f551" label="ambiguous">9.</l><l xml:id="m-2fcfa2cf-43de-4f1d-a960-4ef1bc13b9f1" facs="#m-20ac5b1b-0607-4a8c-a6c0-0cd167266c93" label="ambiguous">Double.</l><l xml:id="m-4a2dcb9a-5a94-49ae-a2b7-3a6699272997" facs="#m-e44313c7-bfb5-4c8d-a0b9-3dad6b90ba93" label="lyrics-like">Mass. Cognóvi. p. 1239.</l><l xml:id="m-87032e17-127b-4f8c-97b8-31c4014b3484" facs="#m-1cc6a687-ec0d-4ec9-925d-7c3fee7f7756" label="ambiguous">Collect.</l><l xml:id="m-d9650c6e-3f9c-4e92-8395-eae14869a8e2" facs="#m-25097e0f-254e-4fd6-8fe4-595daac8dd39" label="lyrics-like">Eus, qui beátam Francíscam quaésumus; ut intercessiónis ejus</l><l xml:id="m-04188b9c-54ea-4458-ab2f-a0253ec097e8" facs="#m-7f8c21dc-5f93-4a8b-9fca-3cb01e59b415" label="lyrics-like">U fámulam tuam, inter cétera auxilio,* Angelórum consórtium</l><l xml:id="m-72c304b1-6a4d-458e-83cb-e8acd0669f34" facs="#m-25ff8381-c709-42fc-8c0a-34016c1c76ee" label="lyrics-like">grátiae tuae dona, familiári Angeli cónsequi mereámur. Per Dóminum.</l><l xml:id="m-632d9174-6835-401f-9dbb-7743b11e7ea0" facs="#m-5a146d2c-3135-4af1-8c92-e9698afce3ba" label="lyrics-like">consuetúdine decorásti : t concéde</l><l xml:id="m-bfccc1a0-6b89-463d-a05e-25d39506c738" facs="#m-9ae7a851-693f-4a81-8ae0-ad39082ff2c7" label="text-like">The Forty Holy Martyrs.</l><l xml:id="m-09624895-0e91-40c6-ad7a-aaaef599c838" facs="#m-1f3f78d6-29f3-4ab4-8f30-5227023d77f6" label="ambiguous">10.</l><l xml:id="m-73106a4c-e944-4c2a-8120-b2f379e330a0" facs="#m-e6b64a43-7c5d-412d-a8b9-5fd3ecfd591f" label="ambiguous">Semi-double.</l><l xml:id="m-68d86f3b-e051-44ac-a782-6fb796b7b70a" facs="#m-2474f742-c48d-4dc2-9fc9-44ffa2e8cd88" label="ambiguous">Collect.</l><l xml:id="m-e283d1fc-e120-4fec-934c-4b3232e28920" facs="#m-7891705e-eaa7-4c81-a712-d41b28f9b5b0" label="lyrics-like">DRaesta, quaésumus omnípotens gnóvimus,“pios apud te in nostra</l><l xml:id="m-0774977e-695b-4d27-825f-4a5baca24309" facs="#m-2c4defd4-8ac0-4f52-9dfd-0f0c5d1c322c" label="lyrics-like">L Deus : f ut qui gloriósos Már-lintercessióne sentiämus. Per Dó¬</l><l xml:id="m-879d3432-cfe8-4df6-a6ee-7e6eb1c451c6" facs="#m-51eb3375-4cfa-4131-91c7-6831668a7fcb" label="lyrics-like">tyres fortes in sua confessióne co-l minum.</l><l xml:id="m-2918df97-3788-42d5-8277-3d07dcec658c" facs="#m-1626fa3c-8fd6-420d-96de-1e494cc403de" label="ambiguous">Secret.</l><l xml:id="m-375f48c3-e5c7-4d94-a5a4-53d80c6baa87" facs="#m-b7dec399-ccc9-48ec-9a16-bf2155c9f0b8" label="lyrics-like">OReces, Dómine, tuórum réspice, tá̂te Sanctórum, et nobis cónferant</l><l xml:id="m-d2541e2c-7bf0-4532-af13-ffaabd9a9580" facs="#m-e1314978-3428-4c49-8684-e311d4f2891a" label="lyrics-like">L oblationésque fidélium : ut et</l><l xml:id="m-ce5336f9-5551-4e67-8b47-4e3ff16d25f2" facs="#m-5a737add-6a70-4e6a-a11c-d6c176d93f1f" label="lyrics-like">tuae propitiatiónis auxilium. Per</l><l xml:id="m-2ff199a3-ed48-48db-8b15-5b73b5ea81e6" facs="#m-e45131c6-09bb-4e98-9f48-1864568f95da" label="lyrics-like">tibi gratae sint pro tuórum festivi-l Dóminum.</l><l xml:id="m-367b7f12-8cb3-49db-bdeb-6a4605ae6302" facs="#m-f5c89466-7dcd-4d6e-a20a-bad698d33aa0" label="ambiguous">Postcommunion.</l><l xml:id="m-fb2dce8c-2e42-4da1-9e71-bea749579821" facs="#m-b15228ed-c8e8-488f-ae18-d7af241623bb" label="lyrics-like">NAnctórum tuórum, Dómine, in-l lebrámus actióne, perpétua salva¬</l><l xml:id="m-07742f84-aa98-4787-9040-264dfee00976" facs="#m-fd6c1041-9812-4116-83f7-51808b0c114b" label="lyrics-like">D tercessióne placátus : praesta, tiône capiámus. Per Dóminum.</l><l xml:id="m-37628f1c-3842-4bda-b56d-4468f1843dba" facs="#m-c072eabb-d96b-402d-bf8e-0be4cf8fb5c5" label="lyrics-like">quaésumus; ut, quae temporáli ce¬</l><l xml:id="m-44d17314-fe03-4c10-aeb1-443aaabd7060" facs="#m-2b5c407b-1271-4df0-b4ac-798bee2cf28e" label="text-like">St. Gregory the Great, (Gregory I.)</l><l xml:id="m-a9a47c35-a533-4779-8b4e-70225d3a3e36" facs="#m-67b2d1fa-add2-4b1d-b493-2077b280c967" label="ambiguous">12.</l><l xml:id="m-ae2e9f8c-cc15-469c-933d-444b0082390e" facs="#m-a253a6ab-7834-43ea-8ec3-2b934dd8a727" label="text-like">Pope, Confessor, and Doctor of the Church. Double.</l><l xml:id="m-b5c410b6-f676-44b4-89cd-069f49d4a1d4" facs="#m-caf9bd09-2ec7-42a7-98bb-b7ef8602b332" label="lyrics-like">At Ist and 2nd Vespers, at Magn. Ant. O Dóctor... beâte Gregóri.</l><l xml:id="m-1acebd99-12f9-4c8f-9250-26e7b4893652" facs="#m-59e3ed51-3f17-4e69-b76e-3d61249fa65b" label="ambiguous"> 262..</l><l xml:id="m-e120d860-7221-444d-9fe3-27a576bbdd5b" facs="#m-ec48c9b5-a794-4e00-8d20-e6cea7e34191" label="lyrics-like">Mass. Si díligis me. p. 1122t.</l><l xml:id="m-6324b0ac-ec8e-464a-8feb-4ac18e2e5833" facs="#m-98811fca-23cc-455a-8a19-66dcc78707a0" label="ambiguous">Collect.</l><l xml:id="m-3eb091f2-75f8-4366-a196-1ea29513ed05" facs="#m-b01542d4-8f3b-41cf-9d07-193e7b8ddb3f" label="lyrics-like">Eus, qui ánimae fámuli tui! pítius;ut qui peccatórum nostrórum</l><l xml:id="m-79cc22d1-7657-415c-bd08-705a60b95366" facs="#m-1f1c63f6-a2f8-4954-bc0c-a9594df4e425" label="lyrics-like">I Gregórii aetérnae beatitúdinis ! póndere prémimur, * ejus apud te</l><l xml:id="m-4ac8f18d-ca03-4472-a905-8473dda5c316" facs="#m-928b4161-5ba3-44f4-acf6-3dac09f3bb6c" label="lyrics-like">praémia contulisti :t concéde pro-lprécibus sublevémur. Per Dóminum</l></lg></div></section></score></mdiv></body></music>
</mei>