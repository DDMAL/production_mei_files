="522" uly="978" lrx="923" lry="1013" /><zone xml:id="m-5b15993c-9bb1-4043-82a2-eaae9b375f51" ulx="114" uly="1001" lrx="511" lry="1034" /><zone xml:id="m-0b48b1ee-31ae-4f6e-888f-711a4f84fb91" ulx="527" uly="1005" lrx="923" lry="1039" /><zone xml:id="m-d3f64e6a-af22-489d-a14d-2ed561702841" ulx="114" uly="1030" lrx="511" lry="1065" /><zone xml:id="m-cb0bd1eb-ab44-43c1-ba1a-03831b0d6cc0" ulx="526" uly="1031" lrx="924" lry="1063" /><zone xml:id="m-c0ccc928-8ebf-487e-a932-d89981a82e05" ulx="114" uly="1055" lrx="442" lry="1090" /><zone xml:id="m-35ca5141-8a7a-4afe-ada3-e193623cc81b" ulx="525" uly="1061" lrx="921" lry="1090" /><zone xml:id="m-039e03ce-76a3-4ee6-a7fd-bc39e23455e0" ulx="527" uly="1084" lrx="924" lry="1117" /><zone xml:id="m-48a9dff7-aaea-4e92-a856-0457687f7c7a" ulx="121" uly="1097" lrx="510" lry="1137" /><zone xml:id="m-288c4ed0-ecac-400d-9011-fd78cc054605" ulx="527" uly="1108" lrx="921" lry="1144" /><zone xml:id="m-f1aecd69-0a89-4000-8376-7c5a52cec1fe" ulx="124" uly="1127" lrx="511" lry="1161" /><zone xml:id="m-c47acd0d-78d8-4cd6-854d-9b2642c5402a" ulx="527" uly="1134" lrx="922" lry="1170" /><zone xml:id="m-e8d637f6-e99a-4746-8bbe-fa09febaafa2" ulx="114" uly="1152" lrx="511" lry="1189" /><zone xml:id="m-367e6316-c5da-461a-99c3-3d0dd172eabe" ulx="527" uly="1161" lrx="924" lry="1196" /><zone xml:id="m-3a547717-2aac-4d4d-8864-6d746e275112" ulx="115" uly="1179" lrx="511" lry="1213" /><zone xml:id="m-ae1cbdbb-8721-475c-a84f-a5d86ff12a97" ulx="528" uly="1189" lrx="925" lry="1223" /><zone xml:id="m-7d1e91e4-68e5-4466-99ac-72c2eccae48c" ulx="114" uly="1206" lrx="511" lry="1241" /><zone xml:id="m-ebab2e33-4067-4cf5-b605-621fa80cda3d" ulx="528" uly="1217" lrx="925" lry="1249" /><zone xml:id="m-290375eb-5957-4163-9fdf-80c1726cbf94" ulx="116" uly="1232" lrx="513" lry="1267" /><zone xml:id="m-b7a33c20-3e45-42a2-a014-7306d19ccb66" ulx="527" uly="1241" lrx="925" lry="1273" /><zone xml:id="m-0daf1b35-81f4-4f45-b87e-84a1466f4fbb" ulx="115" uly="1258" lrx="511" lry="1291" /><zone xml:id="m-bb9c245a-8ea1-43eb-a064-ce917f9c0ac8" ulx="529" uly="1269" lrx="926" lry="1299" /><zone xml:id="m-bd774b4e-8c5c-48c8-b9d0-85829a0f7013" ulx="114" uly="1289" lrx="511" lry="1316" /><zone xml:id="m-d41c9abc-0d8e-4faa-8fad-7b871dcbd39f" ulx="528" uly="1297" lrx="927" lry="1325" /><zone xml:id="m-c64f1ca3-d89a-479e-bdca-f5c402c1a724" ulx="115" uly="1311" lrx="511" lry="1345" /><zone xml:id="m-1b03fe67-f256-4cab-b7a2-df421551d7fd" ulx="528" uly="1320" lrx="927" lry="1355" /><zone xml:id="m-1a3a38c1-512b-4e73-96a3-735acb0d9268" ulx="116" uly="1338" lrx="513" lry="1371" /><zone xml:id="m-e5290929-610b-493c-ab93-02c76f19decf" ulx="528" uly="1346" lrx="926" lry="1380" /><zone xml:id="m-e0fe8135-2461-4f9c-86f7-61a75b5c98ac" ulx="116" uly="1366" lrx="511" lry="1395" /><zone xml:id="m-0d0cab42-3c4d-41cf-9343-882ba5700c3f" ulx="529" uly="1372" lrx="926" lry="1411" /><zone xml:id="m-f3e2a07f-dc0d-405a-aae2-573f2a98a9e7" ulx="116" uly="1391" lrx="511" lry="1422" /><zone xml:id="m-f19b29c4-d450-4ebb-949f-3aca92e7a58d" ulx="529" uly="1400" lrx="624" lry="1435" /><zone xml:id="m-bcdcba0f-71f3-42dd-b951-c301cfc6b9b3" ulx="117" uly="1416" lrx="512" lry="1457" /></surface>
    </facsimile>
    <body xml:id="m-a4de3f2b-dddc-4b39-a2b4-1adb750b1471">
      <mdiv xml:id="m-7d066e79-9c0d-44d9-a8d0-ce0e196703f9" type="solesmes">
        <score xml:id="m-d8eed975-7173-40ed-85d9-f082ad628253">
          <section xml:id="m-eff472dc-8d63-4d69-b223-51a922fe3831">
            <pb xml:id="m-0a194449-f23a-4dbd-bc83-830018ddab9a" n="0946" facs="#m-1f17c48b-df34-42df-8a2d-02a8f8ef75b5" />
            <div xml:id="m-548f7c7a-b32d-4a1e-a570-104416174831">
              <lg xml:id="m-5d156b03-8e53-42c8-8ce2-24e6e193defe">
                <l xml:id="m-b778ae1a-f64a-438f-b311-f73203d50c8e" facs="#m-86116de9-a472-4189-826d-ecd8bf077da8" label="ambiguous">776x</l><l xml:id="m-a9d210fc-e486-41b2-b2ce-88fbc28b9440" facs="#m-73d34957-9735-4753-bc1d-1899836f0349" label="text-like">The Paschal vign</l><l xml:id="m-15b25645-888d-42f4-94f2-dae83e9225fa" facs="#m-d5662b1c-069f-462d-9374-70bc095efed3" label="text-like">THE BLESSING OF WATER FOR BAPTISM</l><l xml:id="m-3945559d-49ee-4a20-a4ca-b4950cddded3" facs="#m-2ac1f3d0-98a2-4bce-a90d-c836dabc899c" label="lyrics-like">20. Afiert he invocation Omnes Sáncti et Sánctae Déi, all rise. If cantors</l><l xml:id="m-fa3c99aa-0d98-4b51-a83d-7d3fc1fca20a" facs="#m-6324eafd-7e27-4909-9ad1-2aab1c2320eb" label="lyrics-like">sung thé Litany, they return to their places.</l><l xml:id="m-fbfb75d9-fc4c-4f11-890c-491d95fc4368" facs="#m-871264ba-5192-450b-b40f-b8cc1bf5c612" label="text-like">The celebrant and ministers Iserversl mabe reverence to the altar, and</l><l xml:id="m-87822890-7d4f-4aee-9ea2-5de2ded80f04" facs="#m-18094fb7-bad8-48bc-86b4-c8da5dc67526" label="text-like">proceed to the blessing of baptismal water.</l><l xml:id="m-1de315d4-a33e-421f-84cc-d052fb98a382" facs="#m-11b01ab6-35a0-4bc2-b840-c68b230650b0" label="text-like">21. They sand before the vessel of water —ich should be suitably</l><l xml:id="m-20f1a74d-e58d-4e2a-b144-9e36e9344ad0" facs="#m-2274ab91-05d8-4091-ba9d-6a0668f5ba92" label="ambiguous">decorated — as follouos:</l><l xml:id="m-bbc001f1-34c9-472c-a92d-d84fa8c9a817" facs="#m-2b8d8f81-45bb-4d2b-89fe-4ee4c4fb726c" label="text-like">a) The celebrant stands facing the people with the vessel in front of him,</l><l xml:id="m-573c16c6-584f-4a58-89c0-bdcf38ca73bf" facs="#m-d5b03b81-6244-4e76-9411-c7fcdc8c77c3" label="text-like">the paschal candle on his righi, a scond subdeacon or cleric Iserverl with</l><l xml:id="m-537735a3-ca08-430b-be3c-0a7a25e38586" facs="#m-041e8d24-13d9-4c82-8f34-c3f071c6fdff" label="text-like">the cross on his left.</l><l xml:id="m-ce0fdd3f-ff7c-441d-a983-0009d12fa146" facs="#m-ecc67ab7-c27b-4976-bbdf-335b5da31075" label="text-like">b) The ministers Iservers] stand on either side of the celebrant, and help him</l><l xml:id="m-7a03dac2-194e-4d55-967f-5f09d3bfec26" facs="#m-92550736-e8eb-4648-955b-8a08f960146c" label="text-like">in the ceremonies as required.</l><l xml:id="m-99fdb928-53de-41e1-a953-4a81ee3749c8" facs="#m-b5d0590a-4432-421a-a894-0e7fed5ce5a9" label="text-like">e) An acolyte [serverl holds the missal for the celebrant, unless a lectern</l><l xml:id="m-a9cb2aff-5eed-456b-8aea-2437111b8937" facs="#m-0ba44bbe-a7b3-432c-b172-ce2c42aefe23" label="text-like">is used.</l><l xml:id="m-682e27e4-febe-4954-bd0c-707c783062c0" facs="#m-64fcba78-934c-464a-bbf4-5f0dae69152f" label="text-like">The celebrant, with hands joined, sings to the ferial tone A (or the ancient</l><l xml:id="m-84fa93ac-132e-433e-86e1-8e0db784950e" facs="#m-c2f1d4c8-0e4e-48e1-b272-e5ef382220a7" label="ambiguous">simple tone):</l><l xml:id="m-3dcbe277-5615-4538-b8a5-c691ed0d3a88" facs="#m-e86c491d-722b-4ea7-9e52-4bccd6df3eb7" label="lyrics-like">V. Dóminus vobiscum. W. Et cum spíritu tuo.</l><l xml:id="m-df2af171-eaf2-46b5-a152-fafbbe251947" facs="#m-10a0b6ff-65e9-41ef-b05f-78f5747a15b9" label="text-like">Prayer</l><l xml:id="m-0c122bd3-94e8-40ed-a986-89897c5c51d2" facs="#m-66bec2b0-e476-4271-9605-a80430e2282e" label="lyrics-like">Orémus.</l><l xml:id="m-0bce5608-5d8f-4464-9a16-2cbdd6456b31" facs="#m-de4f42a3-e04b-402d-8872-bf59dfb546d6" label="lyrics-like">Mnipotens sempitérne Deus, tátis geréndum est ministério,</l><l xml:id="m-a744942e-3bbf-49f5-b0e9-aafce49c233b" facs="#m-727fcd0a-9153-4b28-84b9-a73fbceff05b" label="lyrics-like">virtútis tuae impleátur efféctu.</l><l xml:id="m-757a6b5b-37c6-4cf5-b175-58cae7644929" facs="#m-821f7c96-65bd-4ff6-b628-883acee924f5" label="lyrics-like">U adésto magnae pietátis tuae</l><l xml:id="m-285e6c5d-c86e-4dce-a304-e28bb435b2e9" facs="#m-8530256d-cc72-4d97-a49f-2a3645c46127" label="lyrics-like">Per Dóminum nostrum Jesum</l><l xml:id="m-928206ae-7f4e-4a1a-87fe-edea798457e6" facs="#m-652a1779-0976-488c-b2d0-d5ec441e9108" label="lyrics-like">mystériis, adésto sacraméntis:!</l><l xml:id="m-984a4f4f-41b1-4f5a-81a9-7e392bf49767" facs="#m-1b0cc234-8ba8-49e6-b904-c0e436acdab6" label="ambiguous">Christum, Filium tuum: Qui</l><l xml:id="m-4468fb38-f590-4fe5-b3b3-5288972beb93" facs="#m-eae36e52-db5a-4b74-95fc-1d300c3bf995" label="lyrics-like">et ad recreándos novos pópulos,</l><l xml:id="m-8689be45-d03a-4b04-8777-0895a50370a2" facs="#m-47ff4bb8-e1e5-45b6-99ce-39bc3a7b0e62" label="lyrics-like">tecum vivit et regnat in unitáte</l><l xml:id="m-fff2da45-e6f1-4361-bd6c-9d9031d1d78f" facs="#m-de12b7fc-b316-4cf0-a6bf-13af78468f85" label="lyrics-like">quos tibi fons baptísmatis pár¬</l><l xml:id="m-d47d024d-a32e-4c13-99d7-7d318734de55" facs="#m-17c07e55-6e51-499f-bda3-9d8014ecc299" label="lyrics-like">turit, spiritum adoptiónis emit¬</l><l xml:id="m-f6b5c369-fbd3-468d-9464-756e71075f7d" facs="#m-504c5241-cb29-4149-9638-2a8d77dbef13" label="ambiguous">Spiritus Sancti Deus:</l><l xml:id="m-06e7a283-e243-42bb-8a29-97babffbba85" facs="#m-81ad67e5-6cd4-4b86-a21f-be5ae077248c" label="ambiguous">te; " ut, quod nostrae humili¬</l><l xml:id="m-7987bc87-ada6-48ed-980b-5d9f7a917038" facs="#m-55ccdb52-7685-4ef9-8e3c-37f1018a98f7" label="text-like">He then continues to the tone of the Preface, with his hands joined:</l><l xml:id="m-ef777475-04f0-4057-8442-c88eeeea4e31" facs="#m-ab3ca463-677e-4a1b-892a-69de5b74b63d" label="lyrics-like">Per ómnia saécula sacculórum. (to the ferial tone, p. 776M).</l><l xml:id="m-32d88cf0-e93c-4413-aacb-b648d257abc6" facs="#m-0c608379-331a-4ce6-b6a5-0bada9f68201" label="lyrics-like">Per ómnia saécula sacculó-linter ipsa mundi primórdia fere¬</l><l xml:id="m-6dad033e-79e7-4bc5-bcc3-282c5fc2946a" facs="#m-3b0c67e1-a437-4c4b-a098-9a0a8b19f7eb" label="lyrics-like">rum. W. Amen. Y. Dóminus</l><l xml:id="m-c795af54-ca13-40df-b05d-1ef5b2d8b262" facs="#m-a705c9cb-74ce-4499-8e4d-08eba93edb85" label="lyrics-like">bátur : ut iam tunc virtútem</l><l xml:id="m-741a5cbb-73a2-45e1-956a-edd254e560cc" facs="#m-d679d936-9b3b-4fed-b97a-56f084c96e68" label="lyrics-like">vobíscum. N. Et cum spíritu</l><l xml:id="m-08acff49-6045-493e-944b-c892b820ab1c" facs="#m-86262218-35c7-4bd1-9c6f-ce317cc55cf7" label="lyrics-like">sanctificatiónis, aquárum natúra</l><l xml:id="m-399db0bc-2ae6-42ef-87c7-63306010ab21" facs="#m-88fd9a63-1d52-4185-8e4d-beaebc777329" label="lyrics-like">túo. Y. Sursum córda. Kr. Ha¬</l><l xml:id="m-033a7c93-e114-4c67-9786-37004c883bd4" facs="#m-b6a61ced-8746-4204-9416-fe697ecacd83" label="lyrics-like">conciperet. Déus, qui nocén¬</l><l xml:id="m-43f03df6-2a71-4645-b119-dc68077e8c2b" facs="#m-5b15993c-9bb1-4043-82a2-eaae9b375f51" label="lyrics-like">bémus ad Dóminum. Y. Grátias</l><l xml:id="m-402e86bc-abe1-4ac9-9484-ea3bc203f82a" facs="#m-0b48b1ee-31ae-4f6e-888f-711a4f84fb91" label="ambiguous">tis mundi crimina per aquas</l><l xml:id="m-3543189f-ef96-4050-83ab-55edcebb99f2" facs="#m-d3f64e6a-af22-489d-a14d-2ed561702841" label="lyrics-like">agámus Dómino Déo nóstro.</l><l xml:id="m-b26f7b7c-3a12-4680-9bb9-b1d84a0e0485" facs="#m-cb0bd1eb-ab44-43c1-ba1a-03831b0d6cc0" label="lyrics-like">ábluens, regeneratiónis spéciem</l><l xml:id="m-8d88a1b5-ea3f-48ea-8ab9-2007b7480d46" facs="#m-c0ccc928-8ebf-487e-a932-d89981a82e05" label="lyrics-like">IV. Dígnum et justum est.</l><l xml:id="m-4f0452e0-db9c-4458-9a22-cc3ef781fac0" facs="#m-35ca5141-8a7a-4afe-ada3-e193623cc81b" label="lyrics-like">in ipsa dilúvii effusióne signásti :</l><l xml:id="m-417d08a6-acdc-4e1c-a4c0-8020d85f8c6d" facs="#m-039e03ce-76a3-4ee6-a7fd-bc39e23455e0" label="lyrics-like">ut, untus ejusdémque eleménti</l><l xml:id="m-fedbf07d-6e68-4406-9d32-200c18d10ffa" facs="#m-48a9dff7-aaea-4e92-a856-0457687f7c7a" label="ambiguous">VJEre dignum et justum est,</l><l xml:id="m-153326f5-b2ab-4c8d-a6d3-0846903cca84" facs="#m-288c4ed0-ecac-400d-9011-fd78cc054605" label="lyrics-like">mystério, et finis esset vitiis,</l><l xml:id="m-d4a0f9db-9162-4b6a-bea1-ba7ecf2172d1" facs="#m-f1aecd69-0a89-4000-8376-7c5a52cec1fe" label="lyrics-like">Yaequum et salutáre, nos tibi</l><l xml:id="m-b00d9cf8-974d-4c0c-a90c-c6ab037b5096" facs="#m-c47acd0d-78d8-4cd6-854d-9b2642c5402a" label="lyrics-like">et orgo virtútibus. Réspice,</l><l xml:id="m-4431a09c-935d-4887-9f2b-e849f1e65341" facs="#m-e8d637f6-e99a-4746-8bbe-fa09febaafa2" label="lyrics-like">semper et ubique grátias ágere,</l><l xml:id="m-13a93eb8-9d96-4905-be3a-b488ce9d9ad5" facs="#m-367e6316-c5da-461a-99c3-3d0dd172eabe" label="lyrics-like">Dómine, in fáciem Ecclésiae</l><l xml:id="m-a36fe811-602f-440e-923c-9a9a36b4818f" facs="#m-3a547717-2aac-4d4d-8864-6d746e275112" label="lyrics-like">Dómine, sancte Pater, omní¬</l><l xml:id="m-55d36af8-37f7-4b6a-9c10-bdaf40912ffd" facs="#m-ae1cbdbb-8721-475c-a84f-a5d86ff12a97" label="ambiguous">tuae, et multiplica in ea regene¬</l><l xml:id="m-e74e95db-3cfc-48fc-ab82-3c66e191e94e" facs="#m-7d1e91e4-68e5-4466-99ac-72c2eccae48c" label="lyrics-like">potens aetérne Deus : Qui invi¬</l><l xml:id="m-7ea7eb77-bfb0-44c7-bae9-1fbd3f80b6ba" facs="#m-ebab2e33-4067-4cf5-b605-621fa80cda3d" label="lyrics-like">ratiónes tuas, qui grátiae tuae</l><l xml:id="m-7acb8586-5240-4530-a901-3dbec4642e56" facs="#m-290375eb-5957-4163-9fdf-80c1726cbf94" label="lyrics-like">sibili poténtia, sacramentórum</l><l xml:id="m-cc2b7a9c-a16d-4128-91ee-e26375d90d1c" facs="#m-b7a33c20-3e45-42a2-a014-7306d19ccb66" label="lyrics-like">affluéntis impetũ laetificas civi¬</l><l xml:id="m-14579f23-6903-4f63-b09d-0421e56719f3" facs="#m-0daf1b35-81f4-4f45-b87e-84a1466f4fbb" label="lyrics-like">tuórum mirabiliter operáris effé¬</l><l xml:id="m-2dcc3cb0-7e6d-4d54-96d1-6f1ad25f2cc4" facs="#m-bb9c245a-8ea1-43eb-a064-ce917f9c0ac8" label="lyrics-like">tátem tuam : fontémque baptis¬</l><l xml:id="m-c8798986-2467-4932-9428-e09d6bd4d2cf" facs="#m-bd774b4e-8c5c-48c8-b9d0-85829a0f7013" label="lyrics-like">ctum : et licet nos tantis mysté¬</l><l xml:id="m-495a3a6d-2885-454f-9e8d-51f9ceceb5d7" facs="#m-d41c9abc-0d8e-4faa-8fad-7b871dcbd39f" label="lyrics-like">matis áperis toto orbe terrárum</l><l xml:id="m-211a5528-185f-4148-b0ec-aeac4fdb30fd" facs="#m-c64f1ca3-d89a-479e-bdca-f5c402c1a724" label="lyrics-like">riis exsequéndis simus indigni:</l><l xml:id="m-31bef356-d3c5-4374-96bc-c50e1d1e2ac4" facs="#m-1b03fe67-f256-4cab-b7a2-df421551d7fd" label="lyrics-like">géntibus innovándis : ut, tuae</l><l xml:id="m-483dcb4d-3c30-4993-93f5-736662701c15" facs="#m-1a3a38c1-512b-4e73-96a3-735acb0d9268" label="lyrics-like">tu tamen grátiae tuae dona non</l><l xml:id="m-75de19d3-805d-404e-affe-cabcf4581921" facs="#m-e5290929-610b-493c-ab93-02c76f19decf" label="lyrics-like">majestátis império, sumat Uni¬</l><l xml:id="m-a10c1a60-1ace-4646-ac5f-9f2fcf468d18" facs="#m-e0fe8135-2461-4f9c-86f7-61a75b5c98ac" label="lyrics-like">déserens, étiam ad nostras pre¬</l><l xml:id="m-22b8f553-5ce7-4097-9209-46a6934327ec" facs="#m-0d0cab42-3c4d-41cf-9343-882ba5700c3f" label="lyrics-like">géniti tui grátiam de Spiritu</l><l xml:id="m-feebd65b-39a2-4949-b12c-d4d57c254d47" facs="#m-f3e2a07f-dc0d-405a-aae2-573f2a98a9e7" label="lyrics-like">ces aures tuae pietátis inclinas.</l><l xml:id="m-c11dfce2-90a8-43e6-bebf-32f5f998effc" facs="#m-f19b29c4-d450-4ebb-949f-3aca92e7a58d" label="ambiguous">Sancto.</l><l xml:id="m-75738d36-adae-4acf-8b5b-ed2705edce23" facs="#m-bcdcba0f-71f3-42dd-b951-c301cfc6b9b3" label="ambiguous">Deus, cujus Spiritus super aquas,</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>