        <zone xml:id="m-86116de9-a472-4189-826d-ecd8bf077da8" ulx="115" uly="81" lrx="185" lry="115" /><zone xml:id="m-73d34957-9735-4753-bc1d-1899836f0349" ulx="400" uly="81" lrx="640" lry="115" /><zone xml:id="m-d5662b1c-069f-462d-9374-70bc095efed3" ulx="183" uly="137" lrx="852" lry="179" /><zone xml:id="m-2ac1f3d0-98a2-4bce-a90d-c836dabc899c" ulx="139" uly="187" lrx="921" lry="224" /><zone xml:id="m-6324eafd-7e27-4909-9ad1-2aab1c2320eb" ulx="114" uly="217" lrx="563" lry="251" /><zone xml:id="m-871264ba-5192-450b-b40f-b8cc1bf5c612" ulx="139" uly="237" lrx="924" lry="277" /><zone xml:id="m-18094fb7-bad8-48bc-86b4-c8da5dc67526" ulx="114" uly="262" lrx="545" lry="300" /><zone xml:id="m-11b01ab6-35a0-4bc2-b840-c68b230650b0" ulx="138" uly="291" lrx="922" lry="331" /><zone xml:id="m-2274ab91-05d8-4091-ba9d-6a0668f5ba92" ulx="115" uly="320" lrx="367" lry="354" /><zone xml:id="m-2b8d8f81-45bb-4d2b-89fe-4ee4c4fb726c" ulx="138" uly="344" lrx="924" lry="376" /><zone xml:id="m-d5b03b81-6244-4e76-9411-c7fcdc8c77c3" ulx="115" uly="368" lrx="924" lry="403" /><zone xml:id="m-041e8d24-13d9-4c82-8f34-c3f071c6fdff" ulx="115" uly="394" lrx="320" lry="424" /><zone xml:id="m-ecc67ab7-c27b-4976-bbdf-335b5da31075" ulx="139" uly="417" lrx="925" lry="451" /><zone xml:id="m-92550736-e8eb-4648-955b-8a08f960146c" ulx="115" uly="445" lrx="416" lry="474" /><zone xml:id="m-b5d0590a-4432-421a-a894-0e7fed5ce5a9" ulx="140" uly="466" lrx="925" lry="500" /><zone xml:id="m-0ba44bbe-a7b3-432c-b172-ce2c42aefe23" ulx="116" uly="492" lrx="194" lry="524" /><zone xml:id="m-64fcba78-934c-464a-bbf4-5f0dae69152f" ulx="141" uly="514" lrx="925" lry="548" /><zone xml:id="m-c2f1d4c8-0e4e-48e1-b272-e5ef382220a7" ulx="116" uly="543" lrx="265" lry="571" /><zone xml:id="m-e86c491d-722b-4ea7-9e52-4bccd6df3eb7" ulx="143" uly="571" lrx="710" lry="608" /><zone xml:id="m-10a0b6ff-65e9-41ef-b05f-78f5747a15b9" ulx="738" uly="608" lrx="827" lry="645" /><zone xml:id="m-66bec2b0-e476-4271-9605-a80430e2282e" ulx="212" uly="609" 