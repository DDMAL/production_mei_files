="m-7c735be9-1f15-4e16-a89b-9d680b2fee14" ulx="58" uly="333" lrx="181" lry="348" /><zone xml:id="m-7602b33a-e8c5-4a58-a859-931cfa450dc7" ulx="71" uly="345" lrx="505" lry="371" /><zone xml:id="m-ff837de0-5428-43a2-aa32-2d489d815de9" ulx="58" uly="358" lrx="114" lry="377" /><zone xml:id="m-1f95241e-d7e9-4eca-a617-2f5bf0154698" ulx="71" uly="372" lrx="505" lry="398" /><zone xml:id="m-ac0ebc8b-74a2-409b-8f51-13b31ec75534" ulx="58" uly="389" lrx="104" lry="409" /><zone xml:id="m-cb26084a-20c6-44d6-a66d-866831005133" ulx="72" uly="404" lrx="505" lry="425" /><zone xml:id="m-088861be-f121-464e-9ed3-b89f6f4536f3" ulx="58" uly="420" lrx="213" lry="439" /><zone xml:id="m-41b7e880-75b8-4fc6-b536-72a5bf70c07f" ulx="72" uly="436" lrx="505" lry="457" /><zone xml:id="m-e43126d6-88c2-4493-9ce8-f20fde4b056c" ulx="58" uly="449" lrx="245" lry="467" /><zone xml:id="m-491df4ac-2b0b-4ed4-99dd-d13b62352343" ulx="73" uly="463" lrx="505" lry="487" /><zone xml:id="m-a20ed78a-2946-4ef5-979d-8138e2d0ef35" ulx="59" uly="482" lrx="177" lry="498" /><zone xml:id="m-cdad95db-f40f-4e3b-b511-e8274614ef48" ulx="72" uly="491" lrx="505" lry="513" /><zone xml:id="m-2850acb5-a964-4b9a-a1f7-18086b92c879" ulx="59" uly="509" lrx="312" lry="529" /><zone xml:id="m-1afa561f-fd6f-4a20-b297-279df926c9d6" ulx="72" uly="525" lrx="463" lry="543" /><zone xml:id="m-cf9b6316-3099-4d1d-a2b3-fab526a48af2" ulx="72" uly="540" lrx="507" lry="561" /><zone xml:id="m-a88b2415-4a8e-44a7-9792-88d7c72c7832" ulx="60" uly="554" lrx="91" lry="576" /><zone xml:id="m-175e3910-c6ae-49db-9f8d-6762478cee4d" ulx="72" uly="571" lrx="506" lry="594" /><zone xml:id="m-1986c7d8-b744-4eb3-940d-32e822498900" ulx="59" uly="586" lrx="140" lry="606" /><zone xml:id="m-1b820653-e192-4bc7-8b02-844c8e1b5e70" ulx="73" uly="602" lrx="507" lry="626" /><zone xml:id="m-b9eb827e-5770-46ed-baaa-6a02bed11bf6" ulx="60" uly="616" lrx="176" lry="633" /><zone xml:id="m-cb940aca-10a4-4939-ba35-e231146f497f" ulx="74" uly="629" lrx="508" lry="650" /><zone xml:id="m-6c24716c-f45b-4a77-8546-ccff74d4b9dd" ulx="61" uly="647" lrx="145" lry="665" /><zone xml:id="m-84504b22-57f5-4aef-930c-57e8534b0930" ulx="74" uly="661" lrx="507" lry="682" /><zone xml:id="m-62ce1922-a2cd-417a-9c08-a4eebad42410" ulx="74" uly="678" lrx="508" lry="698" /><zone xml:id="m-86aa8653-66b8-490d-a818-5e20ea3dbbb5" ulx="60" uly="692" lrx="118" lry="712" /><zone xml:id="m-231282d1-a63f-4e7f-8878-fd65bb65620b" ulx="75" uly="709" lrx="465" lry="727" /><zone xml:id="m-62f7c597-9628-44e7-ac2b-d22cb3550952" ulx="75" uly="724" lrx="509" lry="746" /><zone xml:id="m-539751af-fa9b-4cbd-9356-a5d76f07d337" ulx="62" uly="742" lrx="117" lry="761" /><zone xml:id="m-640cd6a3-5fa5-408f-b1fe-967d1452fb0c" ulx="75" uly="756" lrx="509" lry="778" /><zone xml:id="m-8b835fbd-f3a3-4212-98ef-dd6403053974" ulx="61" uly="770" lrx="245" lry="794" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-38fd81fa-9af0-4a4c-a335-67fca63b13c9" n="0532" facs="#m-c3f6bf5e-0209-4114-bd77-eba901b43580" /><div xml:id="m-1e9e7f08-19ee-4761-a189-61cdfb0e3264">
            <lg xml:id="m-3716b9d4-824c-463d-8de8-50a20a8eb4f5">
              <l xml:id="m-f32b2b03-9a14-4587-9b98-b363be5f4604" facs="#m-66bcc797-cfcd-4a21-88e6-fd006460c2c8" label="ambiguous">286</l><l xml:id="m-76e1ffc7-b8ba-4057-ba87-681f53320bbc" facs="#m-3778215b-3d14-49e2-992d-2269306c8606" label="text-like">The Nativity or our Lord.</l><l xml:id="m-52224542-a079-44b8-9cdf-01adfc4debe0" facs="#m-9eae7b00-ca2d-473c-9c88-8f20b96aa39c" label="lyrics-like">21. Mánus enim méa auxiliábitur ei :* et bráchium méum confortabut</l><l xml:id="m-0350c213-51ac-4cbd-9cee-050542f29dd8" facs="#m-fabdaedb-cc28-47e7-b8b3-3391bf8f77b8" label="ambiguous">eum.</l><l xml:id="m-e63a4264-e571-40a2-b8cc-7b0bfae4a36a" facs="#m-adf20915-a3bd-4090-93eb-5f4580fe70c0" label="lyrics-like">22. Nihil proficiet inimicus ta éo, * et filius iniquitátis non appónet</l><l xml:id="m-5e75cf19-c540-43f5-8a45-be708cf3e3b4" facs="#m-1cc477ef-79c3-4a5e-83e4-a2208a7dee0a" label="lyrics-like">nocére éi.</l><l xml:id="m-c3661b52-1ba5-48b3-9ac3-a6b929e5d4ec" facs="#m-b5ae68fe-b83c-4092-8683-d40869dad453" label="lyrics-like">23. Et concidam a fácie ipsius inimícos ejus: * et odiéntes éum</l><l xml:id="m-4fadbaf2-3e21-4a91-9886-d22e6fb2dcd0" facs="#m-df66a2b4-6ff5-4fd3-9949-f075708bca7b" label="lyrics-like">in fúgam convertam.</l><l xml:id="m-901802cf-ccaa-41b9-8278-f30ff554fcf8" facs="#m-4556e904-e084-4080-a830-13a06282fb34" label="lyrics-like">24. Et véritas méa, et misericórdia méa cum ipso :* et in nómine</l><l xml:id="m-fd86beba-dfc7-4e2a-9e14-f1754d11d06e" facs="#m-060c224e-fca0-499e-8d91-a62bf14d4442" label="lyrics-like">méo exaltábitur corna ejus.</l><l xml:id="m-c3ab328c-232f-4e3d-ac6d-be7445b67c84" facs="#m-ecd7cada-47d0-4d8b-b827-723777f6ea2d" label="lyrics-like">25. Et pónam in mári mánum éjus: * et in flumínibus déxteram</l><l xml:id="m-73c9a94f-a702-46c3-89d0-d1f65ccc3184" facs="#m-cae924a0-cddd-4949-83f8-5732c0608407" label="ambiguous">ejus.</l><l xml:id="m-e9acd9f7-309a-4ec7-9fa9-65b6baf1fb9e" facs="#m-61af3d95-632f-4ab0-bc69-62f7fd46cc96" label="lyrics-like">28. Ipse invocábit me : Pâter méus es tu :“ Déus méus, et suscéptor</l><l xml:id="m-880cdce9-70c3-43d5-abfe-e0b77069de5e" facs="#m-08c7e485-ba63-4ac7-8a1a-bb9b4ca00a51" label="lyrics-like">satútis méae.</l><l xml:id="m-2822710f-4539-44ea-9996-fba1c10ee515" facs="#m-2a4a189e-51ef-47fb-9f93-451348ee8cd9" label="lyrics-like">27. Et égo primogénitum pónam illum. "excélsum prae régibus terrae.</l><l xml:id="m-21df352c-1657-4a06-8e92-8c837dd66680" facs="#m-32ce1bc9-d973-41b3-99bc-68892af83814" label="lyrics-like">28. In aetérnum servábo illi misericórdiam méam :* et testaméntum</l><l xml:id="m-81d5aef8-f46f-4101-9ea9-1fcfc243293e" facs="#m-a699c917-f609-4c45-8e4e-227f20fd4907" label="lyrics-like">méum fidele ipsi.</l><l xml:id="m-eb0a0a49-8957-4326-91e8-e7d2bee28b61" facs="#m-0519878d-d466-49ab-8ee1-8e8b582a62c7" label="lyrics-like">29. Et pónam in saćculum saéculi sémen éjus :* et thrónum éjus sicut</l><l xml:id="m-845d480e-acb6-40d2-b328-276f6c4ffb28" facs="#m-9d93c7ac-33ad-4789-9ac5-2c4cde6c88ae" label="lyrics-like">dtes caelí.</l><l xml:id="m-a30e2a27-e5e4-4ebe-91a1-0cbb13d84f99" facs="#m-b8bf2c10-19aa-4e2c-aea0-fe08a1f39d5b" label="lyrics-like">30. si autem dereliquerint fili éjus légem méam :* et in judiciis méis</l><l xml:id="m-92e9f8ac-0b7e-47cd-b8a5-52070dbee6de" facs="#m-7c735be9-1f15-4e16-a89b-9d680b2fee14" label="lyrics-like">non ambuláverint:</l><l xml:id="m-6bb3dcf8-05dc-40a7-99a3-304c50eb0869" facs="#m-7602b33a-e8c5-4a58-a859-931cfa450dc7" label="lyrics-like">31. si justitias méas profanáverint : = et mandáta méa non custo¬</l><l xml:id="m-5366110f-273b-4739-944e-a3786c7bd6be" facs="#m-ff837de0-5428-43a2-aa32-2d489d815de9" label="ambiguous">dierint:</l><l xml:id="m-5c081bb1-93c2-4c16-a7ef-3faac28a0a80" facs="#m-1f95241e-d7e9-4eca-a617-2f5bf0154698" label="lyrics-like">32. Visitábo in virga iniquitátes córum : “ et in verbéribus peccata</l><l xml:id="m-2e9b15f1-38e6-4996-b004-29d9a587a27e" facs="#m-ac0ebc8b-74a2-409b-8f51-13b31ec75534" label="lyrics-like">córum.</l><l xml:id="m-03f6be42-d34d-48c9-bcc4-96915a789251" facs="#m-cb26084a-20c6-44d6-a66d-866831005133" label="lyrics-like">33. Misericórdiam autem méam non dispérgam ab éoqe</l><l xml:id="m-9ce53a96-c3fe-49e7-a536-dca52e1187aa" facs="#m-088861be-f121-464e-9ed3-b89f6f4536f3" label="lyrics-like">nocébo in veritáte mea:</l><l xml:id="m-ee6f178c-62d7-400c-996d-00c50154d811" facs="#m-41b7e880-75b8-4fc6-b536-72a5bf70c07f" label="lyrics-like">34. Neque profanábo testaméntum méum :* et quae procédunt de</l><l xml:id="m-d97663e8-1844-411a-bba0-e1814de600cd" facs="#m-e43126d6-88c2-4493-9ce8-f20fde4b056c" label="lyrics-like">lábiis méis, non factam irrita.</l><l xml:id="m-7e074ccf-2258-446b-b72d-c75cdca27e46" facs="#m-491df4ac-2b0b-4ed4-99dd-d13b62352343" label="lyrics-like">35. Semel jurávi in sáncto méo : Si Dávia mentiar :* sémen éjus in</l><l xml:id="m-1efa8e7a-678c-4534-81b5-9ea16f6be826" facs="#m-a20ed78a-2946-4ef5-979d-8138e2d0ef35" label="lyrics-like">aetérnum manébit.</l><l xml:id="m-ea3cc292-0e39-4580-b7d9-83c266e2fefd" facs="#m-cdad95db-f40f-4e3b-b511-e8274614ef48" label="lyrics-like">36. Et thrónus éjus sicut sol in conspéctu méo, t et sicut luna perfécta</l><l xml:id="m-64d87cb5-83b2-4542-86ed-a8287f411eed" facs="#m-2850acb5-a964-4b9a-a1f7-18086b92c879" label="lyrics-like">in ceternum : * et téstis in caéto fidelis.</l><l xml:id="m-4e0bb37b-3e7b-4b52-9a55-d0131a26e87a" facs="#m-1afa561f-fd6f-4a20-b297-279df926c9d6" label="lyrics-like">37. Tu vero repulisti et despexisti :* distulisti christum túum.</l><l xml:id="m-f2403e6c-dadd-410d-b5f9-cce258454918" facs="#m-cf9b6316-3099-4d1d-a2b3-fab526a48af2" label="lyrics-like">38. Evertisti testaméntum sérvi tui :* profanásti in térra sanctuartum</l><l xml:id="m-c0b46887-2e02-481f-be08-bef27c610e0b" facs="#m-a88b2415-4a8e-44a7-9792-88d7c72c7832" label="ambiguous">ejus.</l><l xml:id="m-7af9794c-af14-45b5-b208-ed23dfead58f" facs="#m-175e3910-c6ae-49db-9f8d-6762478cee4d" label="lyrics-like">39. Destruxisti ómnes sépes éjus : “ posuisti firmaméntum éus</l><l xml:id="m-09a61067-f704-407b-9eeb-edc682c0bcc9" facs="#m-1986c7d8-b744-4eb3-940d-32e822498900" label="ambiguous">formidinem.</l><l xml:id="m-3c2c98c6-7318-4fcc-90e1-adf86fe602ef" facs="#m-1b820653-e192-4bc7-8b02-844c8e1b5e70" label="lyrics-like">40. Diripuérunt éum ómnes transcóntes viam : * factus est oppró¬</l><l xml:id="m-cb58e26b-b844-42c9-b329-e932c6d21c1d" facs="#m-b9eb827e-5770-46ed-baaa-6a02bed11bf6" label="ambiguous">brium vicints suis.</l><l xml:id="m-5e2ceee0-cb45-4f28-904a-63419f252b63" facs="#m-cb940aca-10a4-4939-ba35-e231146f497f" label="lyrics-like">41. Exaltásti déxteram depriméntium éum : * lactificásti ómnes</l><l xml:id="m-aa912146-f568-4d52-b9b2-33b38ea26a35" facs="#m-6c24716c-f45b-4a77-8546-ccff74d4b9dd" label="lyrics-like">inimicos éjus.</l><l xml:id="m-3859398b-6b08-4ee5-9918-3bc7f00ecf63" facs="#m-84504b22-57f5-4aef-930c-57e8534b0930" label="lyrics-like">42. Avertisti adjutorium gládit éjus :* et non es auxiliãtus ét tn bello.</l><l xml:id="m-ea9fcb19-6b87-4471-881a-496afda00385" facs="#m-62ce1922-a2cd-417a-9c08-a4eebad42410" label="lyrics-like">43. Destruxisti éum ab emundattône : “ et sédem éjus in térram</l><l xml:id="m-35059c1c-bed2-4fd7-892b-b8bc4b7f87ac" facs="#m-86aa8653-66b8-490d-a818-5e20ea3dbbb5" label="ambiguous">cottisisti.</l><l xml:id="m-4c861bb8-0a44-488c-ae59-53cac49da061" facs="#m-231282d1-a63f-4e7f-8878-fd65bb65620b" label="lyrics-like">44. Minorásti dies témporis esus :* perfudisti éum confusiône.</l><l xml:id="m-21791f6d-2dbc-4062-8129-8136fb2c71b4" facs="#m-62f7c597-9628-44e7-ac2b-d22cb3550952" label="lyrics-like">45. Usquequo, Domine, avértis in finem : * exardéscet sicut ignis</l><l xml:id="m-d5b46a1e-157a-4548-9f5b-48ac63179a1f" facs="#m-539751af-fa9b-4cbd-9356-a5d76f07d337" label="lyrics-like">tra túa?</l><l xml:id="m-1babd42d-187b-46b9-9427-8632577311d4" facs="#m-640cd6a3-5fa5-408f-b1fe-967d1452fb0c" label="lyrics-like">46. Memoráre quac méa suostántia : * numquid enim vane consti¬</l><l xml:id="m-6e2c19a0-41d5-4f36-b773-1541a5c0a415" facs="#m-8b835fbd-f3a3-4212-98ef-dd6403053974" label="lyrics-like">tuisti ómnes fuios hominum?</l></lg></div></section></score></mdiv></body></music>
</mei>