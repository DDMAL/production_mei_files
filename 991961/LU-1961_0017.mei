  <music xml:id="m-6faa61d8-2e6e-429e-9193-05a3427ac24e">
    <facsimile xml:id="m-f185adf1-750c-4ab2-a1fd-3270f59d14fa" type="transcription">
      <surface xml:id="m-569b01bb-ae6b-415b-a245-968981d72d26" lrx="1638" lry="2703">
