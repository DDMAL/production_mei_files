9a-bec9-a1f066d52d27" ulx="192" uly="1257" lrx="339" lry="1291" /><zone xml:id="m-8910b9f0-09ae-49c9-b914-5c255827c0de" ulx="497" uly="1281" lrx="710" lry="1316" /><zone xml:id="m-f3f03b19-9956-4c87-81d8-75ac99da35ae" ulx="88" uly="1289" lrx="483" lry="1329" /><zone xml:id="m-e3f69ae3-1dde-4f69-97cf-edf11f968483" ulx="52" uly="1320" lrx="484" lry="1357" /><zone xml:id="m-005742c0-16b8-4e2c-8819-7b1c865f87ee" ulx="526" uly="1322" lrx="928" lry="1354" /><zone xml:id="m-c85d0e65-e1c3-4a78-b56f-9b839d78fc79" ulx="486" uly="1347" lrx="830" lry="1390" /><zone xml:id="m-71c36c7e-d2fd-45a6-9ebd-8fe1efd814d6" ulx="51" uly="1348" lrx="246" lry="1385" /><zone xml:id="m-c9bb0fd3-70ee-4cfe-bb1f-865b05991711" ulx="339" uly="1398" lrx="643" lry="1435" /><zone xml:id="m-a0ea585e-6ec5-4b09-8fed-68e2f32cc39d" ulx="78" uly="1447" lrx="833" lry="1484" /><zone xml:id="m-04368d88-36e1-4acc-835a-5208841181b9" ulx="76" uly="1482" lrx="928" lry="1526" /><zone xml:id="m-31cc2808-057a-41b8-a8cf-ed7eec911ee8" ulx="53" uly="1512" lrx="928" lry="1552" /><zone xml:id="m-6c566863-138b-4966-8e10-be95cddfb46a" ulx="52" uly="1539" lrx="904" lry="1582" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-8ed36bcc-087c-405b-96ce-8d50f7dcf6a8" n="0113" facs="#m-be7152f2-fb04-4b9d-9848-c215dc3a3560" /><div xml:id="m-101e113c-6324-4ff8-a654-4da817379b85">
            <lg xml:id="m-85e46ef6-78ce-4a16-867a-44e3592df85e">
              <l xml:id="m-9e875211-a805-4192-ae18-507b60a60ff2" facs="#m-14ec6e17-26a6-4b64-8c81-3f341fa3b552" label="text-like">The Ordinary of the Mass.</l><l xml:id="m-09c6db3c-2768-4c36-8a9c-26064ad1b508" facs="#m-8fa313e1-3ba0-4574-bbbc-38a1887cbf88" label="ambiguous">3</l><l xml:id="m-a33bb642-b117-46f6-ba96-672fd838ed63" facs="#m-f6d9413c-03fb-464d-96fc-441b4c16e361" label="lyrics-like">Orémus.</l><l xml:id="m-6c34418b-31e9-48cf-babd-87e84094d486" facs="#m-890b2afa-92e1-4cdf-8d72-5f82543d08cb" label="lyrics-like">Ut áudiam vocem laudis: et enár¬</l><l xml:id="m-82f1a1a8-5fa4-4d6a-bd75-85ebc51e1369" facs="#m-00cc4054-1f99-4378-9a3b-7fb2eccf67cd" label="text-like">Having read the Offertory Anti¬</l><l xml:id="m-03cd0ac5-b835-4424-ac15-bbe27964a74b" facs="#m-5a69f2a9-0f26-4005-bcf7-125f2102c0b8" label="lyrics-like">rem univérsa mirabília tua.</l><l xml:id="m-6f178e65-3588-4a27-9dac-199c801ff4f1" facs="#m-3fa0ac27-38d1-4501-ba61-fb1610c20633" label="lyrics-like">Dómine, diléxi decórem domus</l><l xml:id="m-fee6387d-09d1-4cc4-8a9b-2cedf3922453" facs="#m-5a913001-1fba-4d32-9ec2-56485f84c87f" label="text-like">phon, the Priest says:</l><l xml:id="m-930781e6-3029-47f3-b2df-f8a28d284c45" facs="#m-4a9570cc-b969-487d-a421-322444eef479" label="lyrics-like">tuae: et locum habitatiónis glóriae</l><l xml:id="m-913044c2-e40a-4e36-b8b7-416df25530b1" facs="#m-f541ac12-8323-4fc3-9c74-c784b6c21caf" label="ambiguous">NUscipe sancte Pater, omnipo¬</l><l xml:id="m-9353868b-6a44-43a7-9f8e-97b912f2a84e" facs="#m-b02a2a2e-08c4-4967-bde8-6ee32a6a6495" label="ambiguous">tuae.</l><l xml:id="m-046da5c5-da2a-4362-96fa-be7b09cd21c0" facs="#m-2aa77cf2-0965-486a-a6f2-3e5ff3e331ab" label="lyrics-like">O tens aetérne Deus, hanc imma¬</l><l xml:id="m-f883a4e0-2136-453c-aa99-387300259288" facs="#m-598cdc47-b10e-49b4-beaa-11b9c1a4d7c4" label="lyrics-like">Ne perdas cum impiis, Deus, áni¬</l><l xml:id="m-2278f881-3210-4a14-9ecf-13ff14bc793c" facs="#m-84d9a47f-dd9d-49ab-9bd6-2122220246fb" label="lyrics-like">culátam hóstiam, quam ego indi¬</l><l xml:id="m-bd01f281-0003-4b9b-8db8-8acdcd56ea69" facs="#m-43f34b1a-90d7-469a-a9d6-d5a765a7437a" label="lyrics-like">mam meam: et cum viris sángui¬</l><l xml:id="m-14061677-d6b1-498d-8db4-b5e61d3749fe" facs="#m-972cadf8-cb9f-4981-82cc-ba9fd1fb8e2e" label="lyrics-like">gnus fámulus tuus óffero tibi Deo</l><l xml:id="m-154eaf5c-868b-4b80-99bd-c23d1124fe02" facs="#m-159e007b-e1ff-4e1f-9672-fc81e1136a71" label="ambiguous">num vitam meam.</l><l xml:id="m-8027d83d-6c47-48cb-a3f5-6237cdffae5f" facs="#m-4acf6124-19c7-44eb-86eb-ee62502a4a1f" label="lyrics-like">meo vivo et vero, pro innumerabí¬</l><l xml:id="m-fa92e5ec-fee7-45b7-b6e2-dc95fe8d18ef" facs="#m-091f0ac2-23ce-4e86-b924-acfeb3da3b03" label="lyrics-like">quorum mánibus iniquitátes</l><l xml:id="m-d53cc23a-0c81-4919-a735-8da06870cb1c" facs="#m-5bf66c8c-c666-45fc-aeb0-66acbc38d2f8" label="lyrics-like">libus peccátis, et offensiónibus, et</l><l xml:id="m-ac6a1a18-781c-4278-a1bc-54d15143141d" facs="#m-1ce8d63b-35b4-4a4b-a8a1-b109d04b4b7d" label="lyrics-like">sunt : déxtera eórum repléta est</l><l xml:id="m-c6c2ce0a-9647-4be8-8b4b-28e2057659f8" facs="#m-ce233dc4-d0af-45cc-9b34-d97f4978356e" label="lyrics-like">negligéntiis meis, et pro ómnibus</l><l xml:id="m-dcee2162-1237-4cbc-9481-77141c36e019" facs="#m-27850375-014b-4d16-954b-8224cc2b6cc2" label="lyrics-like">munéribus</l><l xml:id="m-664be027-5f89-41cf-90bc-62acf6bfe011" facs="#m-dd1646aa-c2d9-4469-be55-0169988ca9b6" label="lyrics-like">circumstántibus, sed et pro ómnibus</l><l xml:id="m-180e6c76-bf43-45b4-82a5-2527f827c0f2" facs="#m-c2426c6b-92bf-4af3-8571-73a92df15f24" label="lyrics-like">Ego autem in innocéntia mea</l><l xml:id="m-d52fc053-c137-471e-918b-3266b4884911" facs="#m-db53f984-dd77-441b-ae91-5d96caa18490" label="lyrics-like">fidélibus christánis, vivis atque de¬</l><l xml:id="m-f52d1d06-e962-4583-a971-7a97f2749f6a" facs="#m-50406183-2752-46bb-b757-cb5207f92d5f" label="lyrics-like">ingréssus sum: rédime me, et mi¬</l><l xml:id="m-a506b60e-336e-4e65-91a7-e6f9ccac492e" facs="#m-a799fcb8-f6b9-4338-a42c-c5bffbfc60e8" label="lyrics-like">fúnctis: ut mihi et illis proficiat ad</l><l xml:id="m-eafe1caa-f7ae-4a36-9577-1f3c6ecbba7f" facs="#m-2f07fac4-12d3-45d7-8d3d-1570b25c8c29" label="lyrics-like">serére mei.</l><l xml:id="m-d474fdc1-d4dc-4123-87e2-46f271c16677" facs="#m-d33bd841-f533-4f18-9cbf-da4e0b7b5dc7" label="lyrics-like">salútem in vitam aetérnam. Amen¬</l><l xml:id="m-cfcfb2f4-370b-4a1f-b219-430febd0d4c6" facs="#m-1b9c16b4-f245-4609-9c4e-b7ffdd68c504" label="lyrics-like">Pes meus stetit in dirécto. in ec¬</l><l xml:id="m-260afc1a-39ce-4fe9-900a-c7e9a759bd00" facs="#m-2382780a-b6d7-4f2f-a99b-480929875372" label="lyrics-like">Deus, qui humanae substántiae</l><l xml:id="m-32cc6c85-d668-4b0a-ba94-b729fe7ada84" facs="#m-ea5510ef-cfbe-47df-bab9-1f6d1d69cc2d" label="lyrics-like">clésiis benedicam te, Dómine.</l><l xml:id="m-51c6f8c3-4918-41be-95c2-a522dec15421" facs="#m-b23319ff-865f-4334-9af2-33ef507d7a75" label="lyrics-like">dignitátem mirabiliter condidisti, et</l><l xml:id="m-22a47c08-aa3f-4050-a369-9264e14e4cd0" facs="#m-ca588787-5834-4acc-a33a-fb5b3e631dd6" label="lyrics-like">Glória, etc.</l><l xml:id="m-61d7ef04-f355-401f-a050-1317cd573a54" facs="#m-620d5365-f8b1-4f29-8f1c-7d25eec1858a" label="lyrics-like">mirabilius reformásti : da nobis per</l><l xml:id="m-fea04ce3-1823-4f22-91a1-de07bdb6d37c" facs="#m-50dbf80f-615e-461e-8f52-53a8b642a4d7" label="lyrics-like">súscipe sancta Trinitas hanc obla¬</l><l xml:id="m-3be5aa2d-0c9f-4408-bf07-12b96c2104a9" facs="#m-011b1fc3-7f86-4d99-8aab-f8af8eadef82" label="lyrics-like">hujus aquae et vini mystérium, ejus</l><l xml:id="m-c37e914d-e076-45ca-8e22-ae388ccb1438" facs="#m-1182f9ea-6553-4dac-b776-da231c2640f8" label="lyrics-like">divinitátis esse consortes, qui huma¬</l><l xml:id="m-126625d4-2e2a-4b4c-a5ce-af3b7515f5f9" facs="#m-2aa08fb0-392a-4229-aa67-9226cf0ecffc" label="lyrics-like">tiónem, quam tibi offérimus ob me¬</l><l xml:id="m-7f137950-b7d0-4de3-84be-1f24b3673f5e" facs="#m-5ca8be51-2edb-4054-984a-b1e2f90c86ba" label="lyrics-like">nitátis nostrae fieri dignátus est</l><l xml:id="m-7082d13d-38ad-41b2-9d71-9a414b4a990e" facs="#m-528df28b-f8a3-46f3-b2e9-84f78f7bc397" label="lyrics-like">móriam passiónis, resurrectiónis, et</l><l xml:id="m-de868934-7ee4-49ec-83c9-f2eeb302ba85" facs="#m-d94af37d-ab58-4eb9-bf4d-dfff1abba72a" label="lyrics-like">párticeps, Jesus Christus Filius tuus</l><l xml:id="m-d8d2b028-7ec2-4368-83cb-6fb50b712cc3" facs="#m-b21a9988-1cf1-44b3-af49-5e10fcdf8e80" label="lyrics-like">ascensiónis Jesu Christi Dómini no¬</l><l xml:id="m-7eca6b9b-265d-4e3b-a1dd-56394552cf0a" facs="#m-2645998a-1f19-4fea-949d-5b7a3fb005fe" label="lyrics-like">Dóminus ñoster : Qui tecum vivit</l><l xml:id="m-2ec07079-40d9-4627-bbb4-98a3dd753157" facs="#m-f783be2f-2e06-4607-baa2-3759dae35891" label="lyrics-like">stri : et in honórem beátae Mariae</l><l xml:id="m-d6205b4a-28d0-4f2b-93cd-1bbf2aba85f7" facs="#m-b14712a1-fd0f-4a82-b237-18ec71fbd77f" label="lyrics-like">et regnat in unitátẽ Spiritus Sancti</l><l xml:id="m-551ba2db-a7d7-4147-bb7e-748e13b9d450" facs="#m-9e8254aa-848c-440d-8ef0-3190f7cad0bb" label="lyrics-like">semper Virginis, et beáti Joánnis</l><l xml:id="m-0cd553fd-1f1c-4c08-a953-7b7783225c68" facs="#m-21409b65-a2c4-4ff9-880a-542a09de3d55" label="lyrics-like">Deus: per ómnia saécula saeculó¬</l><l xml:id="m-38df3e6c-f3f7-4e3e-bf0b-16e672e45308" facs="#m-129750a2-0560-4a50-90b8-0c0195748c34" label="lyrics-like">Baptistae, et sanctórum Apostoló¬</l><l xml:id="m-261cc9c6-3749-4544-8635-7545660c35f4" facs="#m-fa3b42c9-b4c6-49c3-a170-c8a3fb8d718d" label="ambiguous">rum. Amen.</l><l xml:id="m-0cfe21a0-bb00-4b4c-ae3b-5a34202d0cb6" facs="#m-d4950943-6dfb-466d-b928-ffcd870a4480" label="lyrics-like">rum Petri et Pauli, et istórum, et</l><l xml:id="m-db16efd2-0453-4ce1-ac9b-b4945d542167" facs="#m-1a60b0b6-af32-4ffe-b75a-0e443fdef0ea" label="lyrics-like">Offérimus tibi, Dómine, cálicem</l><l xml:id="m-93a024c1-7b4a-4bed-bb79-e0b5e29dfb33" facs="#m-5eb783b6-2400-4827-ba96-c7f02a4e2ecf" label="lyrics-like">ómnium sanctórum : ut illis profi¬</l><l xml:id="m-b4f628ff-fa57-4bd4-8911-750f87822013" facs="#m-0ad2de3c-947f-4427-beaf-b606c1749114" label="lyrics-like">ciat ad honórem, nobis autem ad</l><l xml:id="m-1ee7629e-80f4-4688-9bc8-4238c58a3eaf" facs="#m-9d59ea46-c484-40dc-8442-5ec8c971d5c6" label="lyrics-like">salutáris, tuam deprecántes clemén¬</l><l xml:id="m-67766fbe-1b4f-4934-ae09-61fd95b580d0" facs="#m-d11facd5-cea1-468a-b12f-860b535ce3b2" label="lyrics-like">salútem : et illi pro nobis intercé¬</l><l xml:id="m-6ca67d31-b45f-477a-8c28-b65c08da8ea3" facs="#m-81f3fdd4-8ea0-4c12-979f-1d85c3c3840c" label="lyrics-like">tiam: ut in conspéctu divinae ma¬</l><l xml:id="m-ae3adfdf-6ed2-4f0e-8491-b7c4b9621de3" facs="#m-504ff494-7bc7-4483-842b-f8d632bd9470" label="lyrics-like">dere dignéntur in caelis, quorum</l><l xml:id="m-fe340ba9-43f4-48bb-8682-e12d8b7c7e0c" facs="#m-aaf9f6df-aaf8-4cd1-beae-7e556ef3fbda" label="lyrics-like">jestátis tuae, prò nostra et totius</l><l xml:id="m-8ffcc7d0-f4fa-419a-9d80-23a733816229" facs="#m-0ff0bc57-e808-4fef-8f6a-0246bdd96a2c" label="lyrics-like">memóriam ágimus in terris. Per</l><l xml:id="m-df2e2402-5a6b-44bf-87a1-a2a4eed4126f" facs="#m-68b0d315-8ac3-48a2-b272-c3bdf83a34a4" label="lyrics-like">mundi salúte cum odóre suavitátis</l><l xml:id="m-357e177b-cf41-4849-82a8-c84ac6f51930" facs="#m-42f3aec5-832c-4244-997d-a2b2735f1fc8" label="lyrics-like">eúmdem Christum Dóminum no¬</l><l xml:id="m-9b4d483a-75fb-47e3-9821-acd59d4628a8" facs="#m-7b208620-e40b-41a3-97c7-55a8741ebfb6" label="lyrics-like">ascéndat. Amen.</l><l xml:id="m-6f9e881c-a823-4d58-9ba9-a3a99e8f7266" facs="#m-1bd07657-74d2-41e9-b81e-a7a64f8c7304" label="lyrics-like">In spíritu humilitátis, et in ánimo</l><l xml:id="m-7cc9ecd1-b084-4fb8-b902-ab8b32159832" facs="#m-a026ce24-8d2a-41cb-9514-ab42e6552e86" label="ambiguous">strum. Amen.</l><l xml:id="m-80f907d3-416a-49b2-aac7-4591276453fc" facs="#m-fa52d381-c98d-4cab-bd96-909c0796bf7d" label="lyrics-like">contrito suscipiámur a te, Dómine</l><l xml:id="m-1d2df771-fbd2-4649-8dc3-0b94d3356e4e" facs="#m-3616b990-b06f-4bc0-96c3-8fcb2d755b80" label="lyrics-like">ARáte fratres: ut meum ac ve¬</l><l xml:id="m-f0ee63fb-6c41-45a1-b51f-88b545acc09b" facs="#m-9172a285-2a8c-4f97-8f85-1551a045d1af" label="lyrics-like">et sic fiat sacrifícium nostrum in</l><l xml:id="m-86dbb1a2-004c-42fc-825b-78d0059ba8bd" facs="#m-0449c414-f828-4057-a275-df4928356a6d" label="lyrics-like">U strum sacrificium acceptábile</l><l xml:id="m-b52fce0a-99f1-4426-a574-8c15a4d241bd" facs="#m-885bbfc3-1d2a-4ad8-8831-2787bcf062cd" label="lyrics-like">conspéctu tuo hódie, ut pláceat tibi,</l><l xml:id="m-999bbad7-80d7-48e0-8253-111f362e56b3" facs="#m-ded0df25-ab5f-43c1-822f-4849a87db4a8" label="ambiguous">fiat apud Deum Patrem omnipo¬</l><l xml:id="m-cb2bcc43-e5a4-4cf2-a1f7-89f0681ecb13" facs="#m-8c2817ba-9f66-4205-8b1f-dd1850e6b60e" label="lyrics-like">Dómine Deus.</l><l xml:id="m-7c79d7e4-34e0-4435-8873-08df0082185f" facs="#m-f64c7854-6c17-443c-8f6d-5e3b10f4a4fe" label="lyrics-like">téntem.</l><l xml:id="m-d1e234d9-1a5e-495b-9ef2-5f6cf171b290" facs="#m-307045a9-d7d1-49b0-8ceb-ac3b7f8f22fe" label="lyrics-like">Veni sanctificátor omnípotens</l><l xml:id="m-3e48c9b7-0505-411a-b416-269f23cde65c" facs="#m-702106f6-ea7b-4e7a-910e-40f93e1e3567" label="lyrics-like">K. Suscipiat Dóminus sacrificium</l><l xml:id="m-3ff59ed3-d2c8-48c4-be31-e91078213d65" facs="#m-56d1ed2a-56bb-4816-8665-c8fa96a496eb" label="lyrics-like">aetérne Deus : et bénedic hoc sacri¬</l><l xml:id="m-42fcb8eb-d442-4b1a-a15b-041ead98160a" facs="#m-00023cbd-162b-4ab6-bad2-ca04c5d597ac" label="lyrics-like">de mánibus túis, ad láudem et gló¬</l><l xml:id="m-f3517f55-c5af-4da3-9afd-938c6a8428a9" facs="#m-d4220523-2cfc-4b65-8ca5-40dbee691a0f" label="lyrics-like">ficium tuo sancto nómini praepa¬</l><l xml:id="m-f9f40d39-f37f-4990-8870-8462765e6f00" facs="#m-b4546930-1e22-43b4-ad5a-8bea2f091f50" label="lyrics-like">riam nóminis súi, ad utilitátem</l><l xml:id="m-7dbd3523-6833-4753-8e9c-0cc61b0d1b9d" facs="#m-f7f82fb3-545b-41e7-b878-039fbc3fccae" label="lyrics-like">rátum.</l><l xml:id="m-9114e262-be27-4473-ba53-5dce1d7b3157" facs="#m-4aa91dbf-399f-4bb1-9154-cd7bebdc677c" label="lyrics-like">quoque nóstram, totiúsque Ecclé¬</l><l xml:id="m-be476542-ba3e-4a44-a993-4f11d2bb10e1" facs="#m-06c1ce9a-1481-419a-bec9-a1f066d52d27" label="ambiguous">Psalm 25.</l><l xml:id="m-901a6002-34ab-43f4-8cf3-aa58298bf11c" facs="#m-8910b9f0-09ae-49c9-b914-5c255827c0de" label="lyrics-like">siæ súae sánctae.</l><l xml:id="m-8da7be32-2088-41a8-a88e-02e83cfb785c" facs="#m-f3f03b19-9956-4c87-81d8-75ac99da35ae" label="lyrics-like">Avábo inter innocéntes manus</l><l xml:id="m-bf4653cf-1f5e-4f4e-baaf-2d631a18158c" facs="#m-e3f69ae3-1dde-4f69-97cf-edf11f968483" label="lyrics-like">Il meas: et circúmdabo altáre</l><l xml:id="m-a7644cb4-4256-4bbe-a659-2207c0c12e12" facs="#m-005742c0-16b8-4e2c-8819-7b1c865f87ee" label="text-like">The Priest says Amen, and then</l><l xml:id="m-c682bb35-d781-499b-9889-cf3949170217" facs="#m-c85d0e65-e1c3-4a78-b56f-9b839d78fc79" label="ambiguous">Ithe Secrets. He then says:</l><l xml:id="m-62ffc8ba-2103-4a5b-9b2c-c1aeb0d543f4" facs="#m-71c36c7e-d2fd-45a6-9ebd-8fe1efd814d6" label="lyrics-like">tuum, Dómine.</l><l xml:id="m-87659c57-181b-4d0e-8feb-76349f8ebcf2" facs="#m-c9bb0fd3-70ee-4cfe-bb1f-865b05991711" label="ambiguous">COMMON PREFACE.</l><l xml:id="m-23be7627-8da6-4dd8-989f-f2f554a0c43f" facs="#m-a0ea585e-6ec5-4b09-8fed-68e2f32cc39d" label="text-like">The Proper Prefaces are found after the Ordinary of the Mass.</l><l xml:id="m-d45865d6-9e35-4095-acef-efecbfc39922" facs="#m-04368d88-36e1-4acc-835a-5208841181b9" label="lyrics-like">DER ómnia saécula saeculórum. sum córda. R. Habémus ad Dómi¬</l><l xml:id="m-c0ef03e6-e36c-499a-9989-8bd06b292832" facs="#m-31cc2808-057a-41b8-a8cf-ed7eec911ee8" label="lyrics-like">K. Amen. V. Dóminus vobis-(num. V. Grátiasagámus Dómino Déo</l><l xml:id="m-50b97341-6c38-4ad4-baba-cc936ab6b451" facs="#m-6c566863-138b-4966-8e10-be95cddfb46a" label="lyrics-like">cum. R. Et cum spíritu túo. V. Sur-Inóstro. R. Dignum et jústum est.</l></lg></div></section></score></mdiv></body></music>
</mei>