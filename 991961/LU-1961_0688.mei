ulx="137" uly="970" lrx="622" lry="1012" /><zone xml:id="m-ca7dfd20-5ca8-412f-8665-2e23e3a2caca" ulx="504" uly="1017" lrx="617" lry="1052" /><zone xml:id="m-ab683fac-6534-40d7-a0a8-9ac43ed0bc6b" ulx="121" uly="1049" lrx="1004" lry="1091" /><zone xml:id="m-bfb35a95-d383-48be-b681-ab6eb76e9e3f" ulx="112" uly="1083" lrx="554" lry="1120" /><zone xml:id="m-d456df75-971d-4fa7-9937-5ea5452fb718" ulx="558" uly="1083" lrx="844" lry="1126" /><zone xml:id="m-8fbb70fa-a901-432c-87da-d23cf059e0e2" ulx="113" uly="1110" lrx="563" lry="1149" /><zone xml:id="m-326e5ac9-28e7-4d65-b588-c6c0cafcf4b8" ulx="477" uly="1162" lrx="641" lry="1202" /><zone xml:id="m-96fb7573-a651-40a9-b849-e1d5a471291c" ulx="310" uly="1209" lrx="806" lry="1248" /><zone xml:id="m-c3e5b215-1b94-4168-b847-d3413c76c76d" ulx="131" uly="1256" lrx="1007" lry="1293" /><zone xml:id="m-f67713f5-9d04-4baa-8931-f01c6d79fe76" ulx="113" uly="1286" lrx="1005" lry="1323" /><zone xml:id="m-3d32560b-3b20-4b34-b618-288a65d97feb" ulx="113" uly="1314" lrx="556" lry="1349" /><zone xml:id="m-d702c40b-7b74-4a5a-a474-4ad3176037fb" ulx="559" uly="1314" lrx="1007" lry="1345" /><zone xml:id="m-3873ebf9-6a5b-462e-8420-9a02aca9af84" ulx="112" uly="1345" lrx="554" lry="1373" /><zone xml:id="m-1a168039-40f2-4f97-9500-7917798578ba" ulx="561" uly="1345" lrx="1008" lry="1374" /><zone xml:id="m-f5701681-b2fa-4b9f-86f7-ff6752498800" ulx="112" uly="1368" lrx="554" lry="1402" /><zone xml:id="m-e48dd4d4-ce3e-4cc1-a7b7-d84a7a3fc833" ulx="563" uly="1375" lrx="1008" lry="1403" /><zone xml:id="m-7c379a78-c5d6-4501-b9c8-fea71530185c" ulx="117" uly="1397" lrx="1005" lry="1431" /><zone xml:id="m-71c7df13-677a-4f97-b5b1-c68aaa2957d7" ulx="113" uly="1423" lrx="554" lry="1462" /><zone xml:id="m-afd9cb33-b766-40ca-941a-5cb89a3c0919" ulx="559" uly="1423" lrx="1007" lry="1463" /><zone xml:id="m-12d98460-0275-435c-a58e-b94bbdda8d50" ulx="114" uly="1450" lrx="908" lry="1490" /><zone xml:id="m-3b9751b6-7673-4dc3-b1ce-45172f2f57e8" ulx="139" uly="1489" lrx="510" lry="1530" /><zone xml:id="m-07aae5c0-ce16-4289-be4e-f09a34ac982a" ulx="142" uly="1527" lrx="625" lry="1564" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-7e029ba9-cba6-4169-bb90-e6c2b07d8069" n="0688" facs="#m-20420f4f-d6e6-49da-a19e-f9c65372e553" /><div xml:id="m-87c14a09-cf0b-44ff-888b-a3635b6bb1ee">
            <lg xml:id="m-c9511630-6a44-4408-a4e6-944b848dac08">
              <l xml:id="m-b829060c-748a-4ed9-8648-081ae29d8eb9" facs="#m-5c95b8c5-32b5-479b-ad2d-e46b77b4d2f3" label="text-like">Saturday in Ember week of Lent.</l><l xml:id="m-4161f99c-7026-4deb-bb10-abae52aed1ed" facs="#m-c339b5f3-e107-4327-b884-953c396bd940" label="ambiguous">542</l><l xml:id="m-bb26f057-53a1-415a-b030-0d63cb8d4298" facs="#m-4a3c53f8-f152-4eae-b89c-1a88ff5db955" label="lyrics-like">toto corde tuo, et ex tota ánima sicut locútus est tibi, et custódias</l><l xml:id="m-b7f15a38-34f6-45ba-bb0a-6c7ba3d5fd38" facs="#m-68098b8b-a4a8-4607-99fd-cec3d8a1400b" label="lyrics-like">tua. Dóminum elegísti hódie. ut sit</l><l xml:id="m-4583adca-ec54-4468-bd67-2fdbd8eb5421" facs="#m-8a4a80c0-fc31-4b27-b691-62a532f80829" label="lyrics-like">ómnia praecépta illius : et fáciat te</l><l xml:id="m-ae134f42-d28e-4c53-b0ea-9bc1a7c30a9b" facs="#m-25fcc0ee-910c-4a4c-9feb-6085e10fb613" label="lyrics-like">excelsiórem cunctis géntibus, quas</l><l xml:id="m-e1fbcb8d-ac33-4033-8f8e-483ca99f59e7" facs="#m-d625455d-5745-402a-8824-e60367a2b340" label="lyrics-like">tibi Deus, et ámbules in viis ejus,</l><l xml:id="m-5d621582-9c8f-4801-88de-48d3b9724825" facs="#m-01f98292-3211-4cf6-9c3d-e1b4b763e535" label="lyrics-like">et custódias caeremónias illius, et</l><l xml:id="m-ae443e41-c195-4e16-851b-215498123d71" facs="#m-cf378cc2-76ee-480d-be0a-271e2c90ed8a" label="lyrics-like">creávit in laudem, et nomen, et</l><l xml:id="m-595962c3-49f2-490c-ae8d-8e3363cfcc01" facs="#m-b5fd71ee-43b4-4801-b0c4-8dc155a4356a" label="lyrics-like">mandáta atque judicia, et obédias</l><l xml:id="m-dd4e32ce-e6f6-48c8-89d8-3d88fef9fb65" facs="#m-12b6ec35-1b54-432b-9e31-721016824c4d" label="lyrics-like">glóriam suam : ut sis pópulus san¬</l><l xml:id="m-52cf44ac-e99e-4fa0-92b2-55d4ab556b4b" facs="#m-ac515d7f-40ed-4856-8bd3-e918317c576a" label="lyrics-like">ejus império. Et Dóminus elégit te ctus Dómini Dei tui, sicut locútus</l><l xml:id="m-2e9cc4bc-f3ed-4f0b-8e65-9612af3f588c" facs="#m-7e2744f4-711f-49fd-bb7d-fc27ad89f719" label="lyrics-like">hódie, ut sis ei pópulus peculiáris, est.</l><l xml:id="m-641bd347-734c-4cc7-9bf3-ac80fcf66f11" facs="#m-ac8d5b1e-b38a-4036-916c-560c96de9d39" label="lyrics-like">Gradual. Propítius ésto. p. 999.</l><l xml:id="m-9032bafc-990b-470d-b703-2306e5b4b807" facs="#m-11ffa2e8-6a00-42af-93a9-560a80a454eb" label="lyrics-like">Orémus. Flectámus génua. K. Leváte.</l><l xml:id="m-11ca5561-1fa0-47ef-be78-c91ca12de3b2" facs="#m-30414e8a-e9da-49eb-92c0-84a023ade4ff" label="ambiguous">Collect.</l><l xml:id="m-65c3f952-016d-4e35-9711-e20c8f183d1d" facs="#m-87942c49-6f38-49e4-9193-399fe9a80deb" label="lyrics-like">DRotéctor noster áspice, Deus : ] ricórdia, libera tibi mente famulé¬</l><l xml:id="m-1f57c8ab-3ae6-44d6-a35c-a1cedac50ca3" facs="#m-df44911d-affe-4234-9245-cfe177b2f180" label="lyrics-like">Eut, qui malórum nostrórum ] mur. Per Dóminum.</l><l xml:id="m-29e0cb9a-7280-4801-a3fd-5f173e6846a3" facs="#m-c13b1cde-6267-4a09-a375-9fe9af5a2e8f" label="lyrics-like">póndere prémimur, percépta mise¬</l><l xml:id="m-ba17cd4a-bbb0-4b37-80f9-027ec8cf0d92" facs="#m-13729a95-538a-4a36-a977-06f94efc3053" label="ambiguous">Lesson II.</l><l xml:id="m-a6adeb08-adb9-4107-a6d4-36c4ffabc067" facs="#m-eefd83f5-28e7-4462-ac08-8a09e1c6cf10" label="lyrics-like">Léctio libri Deuteronómii. Deut. 11.</l><l xml:id="m-befa8326-c02a-48b5-9a30-4fce374e2485" facs="#m-425f12ff-1d3e-438b-a17e-7348e632cee8" label="lyrics-like">TN diébus illis : Dixit Móyses filiis ! vester, vester erit. A desérto, et a</l><l xml:id="m-23183f40-4b05-456e-ad5f-54d1fa47690e" facs="#m-f5f4ddc1-50ea-4d45-8017-ac0383e49b5b" label="lyrics-like">L Israel: Si custodiéritis mandáta,</l><l xml:id="m-fe1efb56-9711-4f80-9bdc-94d8fa2a338f" facs="#m-0ba41426-072a-4903-8912-ff70127cbabf" label="lyrics-like">Libano, a flúmine magno Euphráte</l><l xml:id="m-dd39bc61-e381-4d0a-b856-841b3d9514af" facs="#m-94f34c39-a1e1-4650-9a80-b9e2752517c1" label="lyrics-like">usque ad mare Occidentále, erunt</l><l xml:id="m-af0a4307-8e01-435b-8889-b045e6cc63c4" facs="#m-494c8ae8-7d7d-4f96-a562-959f4c5758ab" label="lyrics-like">quae ego praecípio vobis, et fecéri¬</l><l xml:id="m-601eb4a6-e209-4c6b-9d71-3c1ee9622418" facs="#m-3eee2af2-c2b3-4980-ae46-692411cebf78" label="lyrics-like">tis ea, út diligátis Dóminum Deum</l><l xml:id="m-dcfeacff-d092-4f2c-b522-7ad0ce09082a" facs="#m-8e155b8a-fde4-4f4a-94f4-550dfe52e4e4" label="lyrics-like">términi vestri. Nullus stabit contra</l><l xml:id="m-7b1549fa-c9ce-4d62-a663-6e90e9fd36e5" facs="#m-00ee2c17-4929-4240-b932-3efe36f664c0" label="lyrics-like">vestrum, et ambulétis in ómnibus</l><l xml:id="m-42edf318-c2cd-4216-8fbc-84d2cf3f83aa" facs="#m-65275d97-7cea-48a8-a166-908ff3fbf9c1" label="lyrics-like">vos : terrórem vestrum et formidi¬</l><l xml:id="m-f1c78976-b0ca-4e99-a92e-7d57be166881" facs="#m-a34c8f0f-5f1c-4b77-b5a6-8cd971109b66" label="lyrics-like">viis ejus, adhaeréntes ei, dispérdet</l><l xml:id="m-c91689ea-9154-42f4-b42a-9fa174baad5a" facs="#m-15a26e77-8b40-4a08-8121-7a01ca0ab1ae" label="lyrics-like">nem dabit Dóminus Deus vester</l><l xml:id="m-1580d9e1-f521-4895-9323-fc34c8e0c9c3" facs="#m-84302ac7-5859-4559-9e5a-ec1bbf5b899c" label="lyrics-like">Dóminus omnes gentes istas ante</l><l xml:id="m-8dda0f49-76f2-42a8-a49b-f9e7247fdd26" facs="#m-403f9417-ac15-47d1-9cb3-cd376f42b2cb" label="ambiguous">super omnem terram, quam calca¬</l><l xml:id="m-29d63897-c908-4b8d-b433-47a3925a2016" facs="#m-47d1dadb-b8ab-4340-a997-41bc869fc066" label="lyrics-like">fáciem vestram, et possidébitis eas,</l><l xml:id="m-f1fe1b40-162f-4802-9b28-354e5145fdf0" facs="#m-bb46635c-a461-4e44-9603-f220fdec481a" label="lyrics-like">túri estis, sicut locútus est vobis</l><l xml:id="m-ca691d5a-5b9b-463b-ac20-b07067d77cb9" facs="#m-e344b5de-d347-4c4a-975c-67e336a45405" label="lyrics-like">quae majóres et fortióres vobis sunt.</l><l xml:id="m-e5ac2fdb-e8ae-4dec-b39c-7029e4761767" facs="#m-c38be958-5176-4136-9b32-6fc134edadd1" label="lyrics-like">Dóminus Deus vester.</l><l xml:id="m-4b288665-c7a1-4b45-80f8-83924d0688b8" facs="#m-401bffd3-bcf9-46bf-877a-4a263ddcc640" label="lyrics-like">Omnis locus quem calcáverit pes</l><l xml:id="m-1917a957-116c-4bee-af57-fd01a36314e8" facs="#m-f88d5929-2511-48b3-9130-10c3e0ec7d00" label="lyrics-like">Gradual. Protéctor nóster. 1003.</l><l xml:id="m-7c717a4c-be8a-40d2-babf-70ffb151860c" facs="#m-737bb0e3-348f-42c0-8439-e0cbd93677fd" label="lyrics-like">Orémus. Flectámus génua. R. Leváte.</l><l xml:id="m-ef412dde-ba6b-4d8e-b3c2-233f1fe8edfc" facs="#m-ca7dfd20-5ca8-412f-8665-2e23e3a2caca" label="ambiguous">Collect.</l><l xml:id="m-3f5ef18a-46a5-4461-8047-66559bbdbe4c" facs="#m-ab683fac-6534-40d7-a0a8-9ac43ed0bc6b" label="lyrics-like">I Désto, quaésumus Dómine, sup-l próspera húmiles, et inter advérsa</l><l xml:id="m-8745ffef-da58-4c2d-9292-f650043d7797" facs="#m-bfb35a95-d383-48be-b681-ab6eb76e9e3f" label="lyrics-like">Al plicatiónibus nostris: ut esse,</l><l xml:id="m-d489d438-1fac-47e2-a17a-f91bf111f078" facs="#m-d456df75-971d-4fa7-9937-5ea5452fb718" label="lyrics-like">secúri. Per Dóminum.</l><l xml:id="m-756c1af3-f978-46cd-bb78-2d13771ff9aa" facs="#m-8fbb70fa-a901-432c-87da-d23cf059e0e2" label="lyrics-like">te largiénte, mereámur et inter!</l><l xml:id="m-44b2d9a1-4ff1-4ff8-ba62-14aec1cdee62" facs="#m-326e5ac9-28e7-4d65-b588-c6c0cafcf4b8" label="ambiguous">Lesson III.</l><l xml:id="m-5d5212c1-e247-471c-ba0a-1d92fd74d048" facs="#m-96fb7573-a651-40a9-b849-e1d5a471291c" label="lyrics-like">Léctio libri Machabaeórum. 2. Mach. 1.</l><l xml:id="m-9af19a0b-4296-4d79-abd8-47e0069024d9" facs="#m-c3e5b215-1b94-4168-b847-d3413c76c76d" label="lyrics-like">TN diébus illis: Oratiónem facié-l bonus rex, solus praestans, solus</l><l xml:id="m-488e9edb-f4b2-4d9f-9a09-f51ea1bd2ee5" facs="#m-f67713f5-9d04-4baa-8931-f01c6d79fe76" label="lyrics-like">L bant omnes sacerdótes, dum justus, et omnipotens, et aetérnus,</l><l xml:id="m-f0a332eb-2cce-4169-8bb2-319ab382bd2b" facs="#m-3d32560b-3b20-4b34-b618-288a65d97feb" label="lyrics-like">consummarétur sacrificium, Jóna¬</l><l xml:id="m-6c7bd2be-f7ed-4744-bcd8-487f71be08cc" facs="#m-d702c40b-7b74-4a5a-a474-4ad3176037fb" label="ambiguous">qui liberas Israel de omni malo, qui</l><l xml:id="m-0f60d18a-513a-4fc8-af40-27cd5abdfcea" facs="#m-3873ebf9-6a5b-462e-8420-9a02aca9af84" label="lyrics-like">tha inchoánte, céteris autem respon¬</l><l xml:id="m-486bf376-2225-4679-9eff-9260a49f3642" facs="#m-1a168039-40f2-4f97-9500-7917798578ba" label="lyrics-like">fecísti patres eléctos, et sanctificásti</l><l xml:id="m-c23f4375-c1e8-4453-882d-16c0da4e4bd4" facs="#m-f5701681-b2fa-4b9f-86f7-ff6752498800" label="lyrics-like">déntibus. Et Nehemíae erat orátio</l><l xml:id="m-90582317-9677-4c05-91ce-72fec7c4c5e4" facs="#m-e48dd4d4-ce3e-4cc1-a7b7-d84a7a3fc833" label="lyrics-like">eos: áccipe sacrifícium pro univérso</l><l xml:id="m-84368d15-81b3-4b47-ad60-a9890ce51966" facs="#m-7c379a78-c5d6-4501-b9c8-fea71530185c" label="lyrics-like">hunc habens modum: Dómine, Deus ! pópulo tuo Israel, et custódi partem</l><l xml:id="m-3cc624f5-c427-4267-ae29-67f41d81d891" facs="#m-71c7df13-677a-4f97-b5b1-c68aaa2957d7" label="lyrics-like">ómnium creátor, terribilis et fortis,</l><l xml:id="m-4aa20988-77e4-418a-98ab-233ed2bb042b" facs="#m-afd9cb33-b766-40ca-941a-5cb89a3c0919" label="lyrics-like">tuam, et sanctífica: ut sciant gen¬</l><l xml:id="m-b3d9cc64-2141-4ef8-a91b-e8870161c164" facs="#m-12d98460-0275-435c-a58e-b94bbdda8d50" label="lyrics-like">justus et miséricors, qui solus es tes, quia tu es Deus noster.</l><l xml:id="m-22817ab6-bb7e-4e6b-8cad-5f6b7cf989bf" facs="#m-3b9751b6-7673-4dc3-b1ce-45172f2f57e8" label="lyrics-like">Graduat. Convértere. p. 1007.</l><l xml:id="m-c99a52c6-b4bf-4eb3-b9a6-bc578d51226d" facs="#m-07aae5c0-ce16-4289-be4e-f09a34ac982a" label="lyrics-like">Orémus. Flectámus génua. R Leváte.</l></lg></div></section></score></mdiv></body></music>
</mei>