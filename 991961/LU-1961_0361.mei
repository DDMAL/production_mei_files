            <div xml:id="m-472db0a4-a2af-4a8d-bd28-08d7a6d083e7">
              <lg xml:id="m-fe18669d-53f4-4255-848d-490ac8dead2e">
                <l xml:id="m-1d1680e5-2ead-4fe4-942a-4f5ac43b4a6a" facs="#m-d45df066-6630-48e0-9030-39ff2ab1d14b" label="text-like">Sunday at None.</l><l xml:id="m-660af644-d7df-451b-a627-fab773896645" facs="#m-2d859e0e-2789-4909-a670-cef5421d5940" label="ambiguous">249</l><l xml:id="m-ca7c0b6a-a115-4e5a-88a5-cc0801ab86af" facs="#m-decc458d-b8ad-4102-b3bc-a6d271187c6c" label="text-like">In Paschal Time.</l><l xml:id="m-0a7dc9d3-1836-4989-a1a5-a8c1bd8aecca" facs="#m-4c92e334-5ec0-4c11-89ce-7d5b6c9f49be" label="ambiguous">Ant.</l><l xml:id="m-acb1c777-6d3f-4d39-bd89-fc05f54320dd" facs="#m-b5b53a84-6e37-4032-a7d2-17088b6047b9" label="ambiguous">A</l><l xml:id="m-a986cc09-e23f-42de-8747-f8f36095c3b6" facs="#m-10a38c80-1a21-469d-8966-6621fdfb00e1" label="lyrics-like">Lle-lú-ia,</l><l xml:id="m-20d39bb4-4dce-454a-bb82-84ef490d5bd7" facs="#m-eb0864f0-fbd6-47c3-94a4-85e1235a7867" label="lyrics-like">alle lú-ia,</l><l xml:id="m-9899b857-5bc3-40cf-b72d-af91d7152764" facs="#m-2d70bbf6-4f89-4fc3-abd3-2505655ae858" label="lyrics-like">alle lú-ia.</l><l xml:id="m-ff708b10-a2c5-45c5-9e0d-15fa2938f82f" facs="#m-2276f56a-be64-4250-870b-bc2a223a19f3" label="text-like">Chapter in the Proper of the Time.</l><l xml:id="m-22d99825-2b85-4f34-9f82-3adf4f6d58a4" facs="#m-4a1cb837-f213-479c-b155-37a67a4bbb01" label="ambiguous">short</l><l xml:id="m-916187b1-5b00-4d07-a9ba-69293f75ded5" facs="#m-8b72b000-d94c-451f-a247-e046a48c6810" label="ambiguous">Resp.</l><l xml:id="m-9675a25d-a4d2-4728-85b0-f4976d5fd4c4" facs="#m-dacbb4e0-92fa-471f-a2f1-e22b504e8ce2" label="lyrics-like">Aví-si sunt discípu-li:</l><l xml:id="m-75cdacb8-0e3c-47a3-a6d8-56b820bc1239" facs="#m-b3f67e6f-586b-4e73-b893-177ac8b41f03" label="lyrics-like">Alle-lú-ia, alle lú-ia.</l><l xml:id="m-230c9032-d05c-4b12-8b53-e45cde19c2bf" facs="#m-1b99fbd8-d264-4708-aadb-a4244653e617" label="ambiguous">A</l><l xml:id="m-de3fec1b-2533-44bf-908e-3111873ed348" facs="#m-adddbc51-3152-43e0-b45c-969b78ec57ae" label="lyrics-like">V. Vi-so Dómino. Gló-ri-a Pátri,</l><l xml:id="m-9f4307d3-98ad-4d81-b83f-1e2640fc68c7" facs="#m-add00c78-ecd9-4ff9-85ff-89529e8decbb" label="lyrics-like">et Fí-li-o,</l><l xml:id="m-34aa29aa-881a-4229-896f-6fe719e02fe8" facs="#m-2ea79877-d6c7-4e50-9df8-03f85cb74b02" label="lyrics-like">et Spi-rí¬</l><l xml:id="m-c6fb0cac-3a92-4da8-ac91-89d52f65a489" facs="#m-6a050803-3458-4485-b817-2389b0a85ccb" label="lyrics-like">tu-i Sáncto.</l><l xml:id="m-17a6bbd0-1210-4327-b958-2e5fb01601df" facs="#m-fd1fa446-d743-4ac2-af94-4bc1c3397daa" label="lyrics-like">v. Máne nobiscum Dómine, allelúia.</l><l xml:id="m-f8169868-8af8-46d9-a133-72f2bb0c7133" facs="#m-0dd18219-ce32-46a6-83a7-a07b87b397ee" label="lyrics-like">R. Quóniam advesperáscit, allelúia.</l></lg>
            </div>
          </section>
