      <graphic xml:id="m-74b11668-d8f7-488e-b4f0-f0c90bb11585" target="0119_original_image.tiff" /><zone xml:id="m-8414d03c-9ec5-4e0e-98d5-917a6e489698" ulx="373" uly="81" lrx="605" lry="115" /><zone xml:id="m-89e1a82f-5859-4d25-902a-efd49d2a5685" ulx="355" uly="157" lrx="624" lry="196" /><zone xml:id="m-812428a9-69be-4298-b7cc-04b21e3b05a5" ulx="86" uly="211" lrx="918" lry="249" /><zone xml:id="m-f198565f-190a-44f8-a3fe-fb1929bf611c" ulx="57" uly="239" lrx="484" lry="272" /><zone xml:id="m-ad3f0015-a4b0-42a0-a830-6a4900ff7543" ulx="496" uly="241" lrx="919" lry="272" /><zone xml:id="m-b1a4a1e9-f296-4b9f-88ed-c12718736a84" ulx="60" uly="268" lrx="483" lry="299" /><zone xml:id="m-7fae490f-b39c-40bc-b5a9-c18c391f17ef" ulx="497" uly="271" lrx="918" lry="301" /><zone xml:id="m-3131d9bd-6687-4264-bad2-116fb5da616c" ulx="494" uly="298" lrx="919" lry="330" /><zone xml:id="m-690fc6c6-31ea-49b4-9ba2-93a01c7c9a2a" ulx="60" uly="299" lrx="485" lry="328" /><zone xml:id="m-9491be1b-373b-4aab-9714-08facd45a227" ulx="60" uly="321" lrx="486" lry="357" /><zone xml:id="m-2fa8e44f-66d7-4abe-bf27-624c9a7fb712" ulx="494" uly="321" lrx="918" lry="360" /><zone xml:id="m-dd38d844-510f-4c4c-9ca3-569a9893ec83" ulx="495" uly="351" lrx="776" lry="388" /><zone xml:id="m-0a5322fc-ba75-4eae-b360-5e9ee85601f8" ulx="58" uly="353" lrx="486" lry="386" /><zone xml:id="m-be3798dc-3fc0-45f0-8978-5578d3d53380" ulx="58" uly="377" lrx="485" lry="411" /><zone xml:id="m-0fe64a5b-0e7d-420f-8296-c0a4602a5dd7" ulx="369" uly="440" lrx="613" lry="482" /><zone xml:id="m-fc67e80b-b026-4cd8-b70c-a3f506d58da9" ulx="85" uly="491" lrx="920" lry="532" /><zone xml:id="m-cb6980d1-0242-42a1-b9ee-9f868cdb0f42" ulx="57" uly="523" lrx="920" lry="557" /><zone xml:id="m-efcaf4b8-a267-430e-a30f-7c63831c94f7" ulx="495" uly="549" lrx="920" lry="583" /><zone xml:id="m-52023c89-0774-47a7-a796-69a64880b63a" ulx="58" uly="550" lrx="484" lry="582" /><zone xml:id="m-109d94f8-8ef7-4c18-b291-f916c2a8612d" ulx="493" uly="576" lrx="919" lry="614" /><zone xml:id="m-9b1b6bcf-d37e-4def-bbc6-775ee462becf" ulx="58" uly="577" lrx="485" lry="611" /><zone xml:id="m-ab5cc810-9f00-467f-9edd-5379f3a54c8b" ulx="58" uly="604" lrx="920" lry="637" /><zone xml:id="m-26b4ca37-a728-4695-b4bb-41482a7445bb" ulx="58" uly="632" lrx="918" lry="667" /><zone xml:id="m-ad034fc9-0f00-4cff-a15d-30065381c4db" ulx="89" uly="689" lrx="883" lry="732" /><zone xml:id="m-118c8e71-9647-434d-abd1-d30c41b4e0f2" ulx="330" uly="738" lrx="644" lry="776" /><zone xml:id="m-9dfbbc63-88a0-4b6c-8429-8a723e5ac76a" ulx="85" uly="787" lrx="919" lry="828" /><zone xml:id="m-09021561-ed25-4ad0-a164-e8eb5ac8ffed" ulx="57" uly="818" lrx="921" lry="851" /><zone xml:id="m-5093e209-226e-431f-8050-7a3b8cf5cd82" ulx="57" uly="845" lrx="483" lry="883" /><zone xml:id="m-0362bbb3-9880-4784-af49-502f802d313d" ulx="495" uly="850" lrx="920" lry="880" /><zone xml:id="m-65d78b1a-5181-444c-af54-b1d6442addcf" ulx="496" uly="873" lrx="921" lry="907" /><zone xml:id="m-7ffc6b06-bf9e-4b97-816e-2b2736f0482d" ulx="58" uly="874" lrx="483" lry="908" /><zone xml:id="m-af35924a-3362-4941-88d7-0fae2ef1b65e" ulx="57" uly="900" lrx="483" lry="931" /><zone xml:id="m-66d32612-307c-4334-bc96-292592a952d5" ulx="498" uly="901" lrx="918" lry="931" /><zone xml:id="m-bc285996-d836-41cb-9724-59746092a725" ulx="497" uly="923" lrx="920" lry="956" /><zone xml:id="m-bad421a7-cba4-4862-8332-e084eb98892e" ulx="58" uly="925" lrx="483" lry="956" /><zone xml:id="m-c0830ab1-02bc-49d4-b04e-683a4e74a10b" ulx="497" uly="949" lrx="920" lry="987" /><zone xml:id="m-a4bceb02-94b1-4231-8b0a-b56a2cc1414b" ulx="57" uly="953" lrx="483" lry="984" /><zone xml:id="m-deb77ca2-a654-4b29-8f1e-3c6615c1aa6e" ulx="58" uly="978" lrx="483" lry="1011" /><zone xml:id="m-25b6e409-74ab-4c6a-9ec4-8b3f3968ed1b" ulx="496" uly="978" lrx="920" lry="1015" /><zone xml:id="m-c87461f0-be36-424b-9afb-eac7b62d4065" ulx="57" uly="1003" lrx="839" lry="1044" /><zone xml:id="m-eb96fe39-9782-431b-b6be-b6b30337d825" ulx="121" uly="1065" lrx="852" lry="1107" /><zone xml:id="m-87b9b7cf-f63e-40b6-9547-8c193d9aeaf9" ulx="85" uly="1120" lrx="921" lry="1156" /><zone xml:id="m-f82bb437-2eaa-40fb-8c1b-306fd2cabc4b" ulx="56" uly="1154" lrx="921" lry="1187" /><zone xml:id="m-1044c2f1-be96-40a6-9fb5-a7b52682bf3f" ulx="56" uly="1178" lrx="483" lry="1211" /><zone xml:id="m-209f37c8-2410-4403-8c4f-630e6733d7da" ulx="495" uly="1178" lrx="922" lry="1210" /><zone xml:id="m-4d48f826-3fd1-412a-b3c4-063a59e7e815" ulx="495" uly="1204" lrx="920" lry="1238" /><zone xml:id="m-7f18ab7f-5340-4992-ba3f-e4e65d2eab86" ulx="57" uly="1206" lrx="483" lry="1241" /><zone xml:id="m-fb9d8900-7a29-4468-a2d1-3e668df104b9" ulx="57" uly="1231" lrx="483" lry="1269" /><zone xml:id="m-871200c3-86bf-4f3f-bd0f-f1b944cbc287" ulx="497" uly="1232" lrx="920" lry="1268" /><zone xml:id="m-f32ede45-b489-4f0e-a6cf-364a46c3cc30" ulx="56" uly="1260" lrx="483" lry="1295" /><zone xml:id="m-9631310b-8c93-4729-94d1-9db3c7b796b9" ulx="496" uly="1260" lrx="919" lry="1292" /><zone xml:id="m-1fab28d6-7135-45f1-a5a4-a35f2503b816" ulx="56" uly="1286" lrx="482" lry="1322" /><zone xml:id="m-77034954-82c6-4d36-b9e7-69c6da541625" ulx="495" uly="1288" lrx="918" lry="1319" /><zone xml:id="m-09140485-15c0-4b07-a191-250640e45515" ulx="56" uly="1313" lrx="482" lry="1344" /><zone xml:id="m-59f84d9b-292e-439b-acbf-82458ef3d4bd" ulx="495" uly="1314" lrx="918" lry="1352" /><zone xml:id="m-5cca18e0-1869-4b70-ade1-24a6f0a28cad" ulx="58" uly="1339" lrx="607" lry="1373" /><zone xml:id="m-b752810a-08c4-4e76-898c-947cdfbdc0ce" ulx="230" uly="1393" lrx="741" lry="1436" /><zone xml:id="m-4f26c423-b5b9-4ca0-a23c-179737270d94" ulx="86" uly="1450" lrx="914" lry="1490" /><zone xml:id="m-3699c94a-a166-4f58-9e25-d33ca6e34919" ulx="58" uly="1481" lrx="486" lry="1516" /><zone xml:id="m-ced8f796-d8fa-4574-b8fc-0298b2679e51" ulx="492" uly="1481" lrx="918" lry="1516" /><zone xml:id="m-d7619949-66d0-4d2a-bc4a-861fdd59cb66" ulx="57" uly="1506" lrx="917" lry="1546" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-f34f6727-64be-4c6c-8ce6-fa6fe81853b2" n="0119" facs="#m-46ad6b20-e5fe-430b-9e17-cb43115ac872" /><div xml:id="m-17a6404f-3bf7-42e9-8644-f3a5b4613477">
            <lg xml:id="m-221ccaaf-d165-47f5-adf1-ab97b0062de9">
              <l xml:id="m-d64e6715-ef4e-42f1-956e-fa830d888442" facs="#m-8414d03c-9ec5-4e0e-98d5-917a6e489698" label="ambiguous">Proper Prefaces.</l><l xml:id="m-99b2969b-0e60-4395-b44b-a041069ee94a" facs="#m-89e1a82f-5859-4d25-902a-efd49d2a5685" label="text-like">At the Ascension.</l><l xml:id="m-d3966486-fbc4-406a-be0c-96c982595031" facs="#m-812428a9-69be-4298-b7cc-04b21e3b05a5" label="lyrics-like">Vere dignum et justum est, tátis suae tribúeret esse partícipes.</l><l xml:id="m-810435ef-5968-4c7a-8999-b22e8ebedb70" facs="#m-f198565f-190a-44f8-a3fe-fb1929bf611c" label="lyrics-like">aequum etsalutáre..., aetérne Déus:</l><l xml:id="m-f9e5dd92-fa41-4fbf-9efd-efb5eee7819d" facs="#m-ad3f0015-a4b0-42a0-a830-6a4900ff7543" label="lyrics-like">Et ídeo cum Angelis et Archánge¬</l><l xml:id="m-ca5d66c5-9402-4540-88f8-81e12f5b3e24" facs="#m-b1a4a1e9-f296-4b9f-88ed-c12718736a84" label="lyrics-like">per Christum Dóminum nostrum.</l><l xml:id="m-865f662f-cec4-4891-8245-70987ceebca1" facs="#m-7fae490f-b39c-40bc-b5a9-c18c391f17ef" label="lyrics-like">lis, cum Thronis et Dominatiónibus,</l><l xml:id="m-8b3545d2-3251-4b4d-a2eb-90c4fa40102e" facs="#m-3131d9bd-6687-4264-bad2-116fb5da616c" label="lyrics-like">cumque omni militia caeléstis exér¬</l><l xml:id="m-04389cb4-5f68-494b-89b7-a1a2ce52584c" facs="#m-690fc6c6-31ea-49b4-9ba2-93a01c7c9a2a" label="lyrics-like">Qui post resurrectiónem suam óm¬</l><l xml:id="m-c2416a11-aef0-47b2-a8e8-e839192d9ddd" facs="#m-9491be1b-373b-4aab-9714-08facd45a227" label="lyrics-like">nibus discípulis suis maniféstus</l><l xml:id="m-1e804a07-d48a-4329-b58c-341d0358b913" facs="#m-2fa8e44f-66d7-4abe-bf27-624c9a7fb712" label="lyrics-like">citus, hymnum glóriae tuae cáni¬</l><l xml:id="m-b76fa2b2-e3b7-4236-bb78-bd88998fc7cf" facs="#m-dd38d844-510f-4c4c-9ca3-569a9893ec83" label="lyrics-like">mus, sine fine dicéntes.</l><l xml:id="m-a0c64f8b-a018-405a-87fa-5793b6e8ca35" facs="#m-0a5322fc-ba75-4eae-b360-5e9ee85601f8" label="lyrics-like">appáruit, et ipsis cernéntibus est</l><l xml:id="m-8d9453b1-9d3d-4bed-a533-f46beaec919e" facs="#m-be3798dc-3fc0-45f0-8978-5578d3d53380" label="lyrics-like">elevátus in caelum, ut nos divini¬</l><l xml:id="m-8ece1ceb-6dde-4f17-8b1c-b1fe9e00aa32" facs="#m-0fe64a5b-0e7d-420f-8296-c0a4602a5dd7" label="text-like">At Whitsuntide.</l><l xml:id="m-bcd6dc06-7982-4251-990c-1ea69219a93a" facs="#m-fc67e80b-b026-4cd8-b70c-a3f506d58da9" label="lyrics-like">Vere dignum et justum est, die) in filios adoptiónis effúdit. Qua¬</l><l xml:id="m-8f68ef41-66d3-4216-9641-d2f5d420d14f" facs="#m-cb6980d1-0242-42a1-b9ee-9f868cdb0f42" label="lyrics-like">aequumet salutáre..., aetérne Déus: própter profúsis gáudiis, totus in</l><l xml:id="m-efd6f2d4-370b-4475-8c25-59a52eab43ad" facs="#m-efcaf4b8-a267-430e-a30f-7c63831c94f7" label="lyrics-like">orbe terrárum mundus exsúltat. Sed</l><l xml:id="m-62227b48-c623-4f7e-82a2-5b18d9622da5" facs="#m-52023c89-0774-47a7-a796-69a64880b63a" label="lyrics-like">per Christum Dóminum nostrum.</l><l xml:id="m-26974b58-68c8-4535-8d0c-94112dc64e36" facs="#m-109d94f8-8ef7-4c18-b291-f916c2a8612d" label="lyrics-like">et supérnae Virtútes, atque angé¬</l><l xml:id="m-0a381e93-5f57-475a-a0c3-cc318b8c86b4" facs="#m-9b1b6bcf-d37e-4def-bbc6-775ee462becf" label="lyrics-like">Qui ascéndens super omnes caelos,</l><l xml:id="m-0d1c26ad-08a6-402b-a051-6bb46725952c" facs="#m-ab5cc810-9f00-467f-9edd-5379f3a54c8b" label="lyrics-like">sedénsque ad dexteram tuam, pro- licae Potestátes hymnum glóriae</l><l xml:id="m-bf32bf09-7a5b-4be1-840d-bac30d4f0483" facs="#m-26b4ca37-a728-4695-b4bb-41482a7445bb" label="lyrics-like">míssum SpiritumSanctum (hodiérna! tuae cóncinunt, sine fine dicéntes.</l><l xml:id="m-faa71ab9-4837-4b9a-81dd-5ca90c17a0f9" facs="#m-ad034fc9-0f00-4cff-a15d-30065381c4db" label="text-like">On the Feast of the Blessed Trinity and on Sundays</l><l xml:id="m-edb7ce98-b96c-46e2-ae6d-59f47d1b1773" facs="#m-118c8e71-9647-434d-abd1-d30c41b4e0f2" label="text-like">throughout the year.</l><l xml:id="m-9a29cfc5-0e39-4655-a470-6d07d3b862ff" facs="#m-9dfbbc63-88a0-4b6c-8429-8a723e5ac76a" label="lyrics-like">vere dignum et justum est, [sine differéntia discretiónis sentí¬</l><l xml:id="m-4bc94674-e043-432b-9d55-53c328f594db" facs="#m-09021561-ed25-4ad0-a164-e8eb5ac8ffed" label="lyrics-like">aequum et salutáre..., aetérne Deus. mus. Ut in confessióne verae, sem¬</l><l xml:id="m-a9d29f8a-e9a7-4ba0-8954-4f4d98e2c5ef" facs="#m-5093e209-226e-431f-8050-7a3b8cf5cd82" label="lyrics-like">Qui cum Unigénito Filio tuo, et</l><l xml:id="m-6052b597-5696-4c90-b6f4-35bdf71dbd2e" facs="#m-0362bbb3-9880-4784-af49-502f802d313d" label="lyrics-like">piternaéque Deitátis, et in persónis</l><l xml:id="m-4efe79e3-e184-4107-86a8-f4ca61d96361" facs="#m-65d78b1a-5181-444c-af54-b1d6442addcf" label="lyrics-like">proprietas, et in esséntia únitas, et</l><l xml:id="m-79995333-17cb-45c2-92d6-8ece14ba090b" facs="#m-7ffc6b06-bf9e-4b97-816e-2b2736f0482d" label="ambiguous">Spiritu Sancto, unus es Deus, unus</l><l xml:id="m-f3dea626-8295-4843-a3bb-0a3a8b797d25" facs="#m-af35924a-3362-4941-88d7-0fae2ef1b65e" label="lyrics-like">es Dóminus: non in unius singula¬</l><l xml:id="m-8ddbe7cd-fbfb-4166-a5b0-ac57ffbb4e9a" facs="#m-66d32612-307c-4334-bc96-292592a952d5" label="lyrics-like">in majestáte adorétur aequálitas.</l><l xml:id="m-b08c4c3d-874a-44ce-8bff-60116c3a3d7c" facs="#m-bc285996-d836-41cb-9724-59746092a725" label="ambiguous">Quam laudant Angeli, atque Arch¬</l><l xml:id="m-b37c2bb7-ce14-4b44-bc13-d029590d888d" facs="#m-bad421a7-cba4-4862-8332-e084eb98892e" label="lyrics-like">ritáte persónae, sed in unius Trini¬</l><l xml:id="m-a7ba7c6e-19e7-4119-abec-740a9ff27b1b" facs="#m-c0830ab1-02bc-49d4-b04e-683a4e74a10b" label="lyrics-like">ángeli, Chérubim quoque ac Séra¬</l><l xml:id="m-abc7fc02-6fe3-4d9e-b5bd-51beb6a629f6" facs="#m-a4bceb02-94b1-4231-8b0a-b56a2cc1414b" label="lyrics-like">táte substántiae. Quod enim de tua</l><l xml:id="m-215ecf20-e5d3-43b5-8f26-11ca8a60286c" facs="#m-deb77ca2-a654-4b29-8f1e-3c6615c1aa6e" label="lyrics-like">glória, revelánte te, crédimus, hoc</l><l xml:id="m-37388c12-6ca4-4db1-945b-44f57fd2cdad" facs="#m-25b6e409-74ab-4c6a-9ec4-8b3f3968ed1b" label="lyrics-like">phim : qui non cessant clamáre</l><l xml:id="m-c59c035d-7469-4381-b5a3-4790222cc856" facs="#m-c87461f0-be36-424b-9afb-eac7b62d4065" label="lyrics-like">de Filio tuo, hoc de Spiritu Sancto, quotídie, una voce dicentes.</l><l xml:id="m-44ca4fe6-5f39-49ca-b5e3-d8c8e21d4ebe" facs="#m-eb96fe39-9782-431b-b6be-b6b30337d825" label="text-like">On the Feast of the Most Sacred Heart of Jesus.</l><l xml:id="m-1be9da78-88dd-4287-a1e7-0a3a5bce7f8d" facs="#m-87b9b7cf-f63e-40b6-9547-8c193d9aeaf9" label="lyrics-like">Vere dignum et justum est, et grátiae, et quod amóre nostri</l><l xml:id="m-8bd3a151-81d2-4523-974d-02247a1a0353" facs="#m-f82bb437-2eaa-40fb-8c1b-306fd2cabc4b" label="lyrics-like">aequum et salutáre, nos tibi semper, fagráre nunquam déstitit, piis esset</l><l xml:id="m-73be27fa-8384-466f-b565-4dde5d260dde" facs="#m-1044c2f1-be96-40a6-9fb5-a7b52682bf3f" label="lyrics-like">et ubique grátias ágere : Dómine</l><l xml:id="m-fcf9fcb7-fd86-489a-b790-9b5b104608f1" facs="#m-209f37c8-2410-4403-8c4f-630e6733d7da" label="lyrics-like">réquies et poeniténtibus patéret</l><l xml:id="m-c914e82d-4b3a-4d80-af93-306ac4bba1d8" facs="#m-4d48f826-3fd1-412a-b3c4-063a59e7e815" label="lyrics-like">salútis refúgium. Et ideo cum An¬</l><l xml:id="m-4e899694-8c55-4043-8b07-c44c6b68ba4c" facs="#m-7f18ab7f-5340-4992-ba3f-e4e65d2eab86" label="lyrics-like">sancte, Pater omnípotens, aetérne</l><l xml:id="m-60a83c60-b4d1-4861-8481-3f1b4c9ad526" facs="#m-fb9d8900-7a29-4468-a2d1-3e668df104b9" label="lyrics-like">Deus: Qui Unigénitum tuum in</l><l xml:id="m-ed9b8ff5-80d2-41c8-8cdd-1156155ec637" facs="#m-871200c3-86bf-4f3f-bd0f-f1b944cbc287" label="lyrics-like">gelis et Archángelis, cum Thronis</l><l xml:id="m-f56054f1-4a3e-456b-afa1-3c1b7d8f1a12" facs="#m-f32ede45-b489-4f0e-a6cf-364a46c3cc30" label="lyrics-like">cruce pendéntem láncea militis</l><l xml:id="m-2c5e1f35-7f97-4b85-a7dd-29f0269b4c7d" facs="#m-9631310b-8c93-4729-94d1-9db3c7b796b9" label="lyrics-like">ẽt Dominatiónibus, cumque omni</l><l xml:id="m-13ffc9ef-f093-483d-ad80-bc3d965fe3d9" facs="#m-1fab28d6-7135-45f1-a5a4-a35f2503b816" label="lyrics-like">transfígi voluisti, ut apértum Cor,</l><l xml:id="m-ee208818-76d9-4fa8-9370-bf06b380130b" facs="#m-77034954-82c6-4d36-b9e7-69c6da541625" label="lyrics-like">militia caeléstis exércitus, hymnum</l><l xml:id="m-b8a31b0e-a41e-4b79-a0e4-7d0c63a82c79" facs="#m-09140485-15c0-4b07-a191-250640e45515" label="lyrics-like">divínae largitátis sacrárium, tor¬</l><l xml:id="m-479e8095-724d-4d67-8e50-dea66ff1a909" facs="#m-59f84d9b-292e-439b-acbf-82458ef3d4bd" label="lyrics-like">glóriae tuae cánimus, sine fine</l><l xml:id="m-857a6f84-c7d7-4d0e-b342-9371383ead0c" facs="#m-5cca18e0-1869-4b70-ade1-24a6f0a28cad" label="lyrics-like">réntes nobis fúnderet miseratiónis dicéntes.</l><l xml:id="m-b64cf054-c304-46d1-81a1-6346f4d50f53" facs="#m-b752810a-08c4-4e76-898c-947cdfbdc0ce" label="text-like">On the Feast of Christ, our King.</l><l xml:id="m-013bddcf-0542-4126-92a5-929798ab76db" facs="#m-4f26c423-b5b9-4ca0-a23c-179737270d94" label="ambiguous">Vere dignum et justum est, minum nostrum Jesum Christum,</l><l xml:id="m-756776fd-c8f0-443d-98dc-ae3f8045d8ac" facs="#m-3699c94a-a166-4f58-9e25-d33ca6e34919" label="lyrics-like">aequumetsalutáre..., aetérne Deus.</l><l xml:id="m-69d6335c-f59d-4722-8fc2-678474301aeb" facs="#m-ced8f796-d8fa-4574-b8fc-0298b2679e51" label="lyrics-like">Sacerdótem aetérnum et universó¬</l><l xml:id="m-d53f3c3d-7f86-474f-8c17-5f3472bea21f" facs="#m-d7619949-66d0-4d2a-bc4a-861fdd59cb66" label="lyrics-like">Qui unigénitum Filium tuum Dó-lrum Regem, óleo exsultatiónis un¬</l></lg></div></section></score></mdiv></body></music>
</mei>