                  <nc xml:id="m-cbd198e9-6e59-4466-93d6-77b51c809592" pname="c" oct="4" /><nc xml:id="m-95ee202f-f048-4219-b085-7277eb53080f" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-a7bd99eb-09ab-44ba-8f18-44054b850189">
                <syl /><neume facs="#m-130698de-58a5-4343-b1e3-f329515233b8" type="clivis" xml:id="m-998db901-58e0-4860-874c-c2fadd27c83a">
