31" lry="581" /><zone xml:id="m-1863dc39-a6b7-4d7d-9161-c042acb56c91" ulx="540" uly="574" lrx="968" lry="605" /><zone xml:id="m-e3f9ee64-acc7-4360-b5b2-9e82c8849413" ulx="102" uly="578" lrx="532" lry="606" /><zone xml:id="m-6c07fece-9d93-4569-a4df-0ae9c409067e" ulx="103" uly="598" lrx="531" lry="630" /><zone xml:id="m-4b575211-7af6-4fc3-94f2-f5d98203304c" ulx="542" uly="601" lrx="969" lry="634" /><zone xml:id="m-36af072b-7821-4ed2-97c4-e650066e370a" ulx="102" uly="626" lrx="531" lry="658" /><zone xml:id="m-e34c6400-e626-408a-8c3b-42d05850df5e" ulx="542" uly="627" lrx="969" lry="658" /><zone xml:id="m-9de50cfd-6902-4550-9869-6e81dfa53611" ulx="103" uly="652" lrx="530" lry="683" /><zone xml:id="m-6dd8d366-8686-43cf-8b89-16e0e2907fa7" ulx="543" uly="653" lrx="969" lry="689" /><zone xml:id="m-fbbdc8c5-0129-4ad3-b53d-757d045590dd" ulx="102" uly="679" lrx="530" lry="711" /><zone xml:id="m-3d1a1c1e-7cea-4910-995e-e4dc7e3801a4" ulx="542" uly="681" lrx="970" lry="715" /><zone xml:id="m-1d31c7f0-d95f-4098-8599-cbac041b98d8" ulx="103" uly="707" lrx="533" lry="739" /><zone xml:id="m-913dc7fb-9ff8-4b21-81f5-f985effba18f" ulx="541" uly="708" lrx="969" lry="739" /><zone xml:id="m-e3ec114b-f927-4716-b542-040545eb66ad" ulx="102" uly="732" lrx="530" lry="765" /><zone xml:id="m-0dc1aef6-397a-44d5-8a6f-969844934e6a" ulx="541" uly="733" lrx="969" lry="769" /><zone xml:id="m-4abe5994-22c1-40d7-9f64-6abc84de7963" ulx="539" uly="760" lrx="969" lry="797" /><zone xml:id="m-39b32413-4b27-412e-854d-abaf8f581939" ulx="103" uly="761" lrx="529" lry="795" /><zone xml:id="m-5736552a-f3ff-4fc2-9d5a-db46a66b7422" ulx="102" uly="790" lrx="914" lry="822" /><zone xml:id="m-3e652647-349c-4102-b9eb-f2d1d13506a1" ulx="103" uly="817" lrx="541" lry="853" /><zone xml:id="m-af30366e-dcda-4980-b1ed-977f9cdb5472" ulx="103" uly="877" lrx="969" lry="926" /><zone xml:id="m-ec790e9a-dffe-4147-b078-424ca7080263" ulx="128" uly="930" lrx="460" lry="966" /><zone xml:id="m-2bbdb1ef-aeb2-44fc-9f46-3029b181c70f" ulx="482" uly="953" lrx="590" lry="988" /><zone xml:id="m-d6779f38-f8a1-4970-9e3d-fa066304914b" ulx="140" uly="985" lrx="968" lry="1022" /><zone xml:id="m-ad1c2af0-ae12-4bfb-a691-75f3b45adf0b" ulx="103" uly="1012" lrx="966" lry="1051" /><zone xml:id="m-2fafc3c9-3d87-4ece-86e0-5089f26d6463" ulx="103" uly="1039" lrx="724" lry="1076" /><zone xml:id="m-bf04cb55-3521-4b83-acf6-b89f78607620" ulx="103" uly="1126" lrx="943" lry="1172" /><zone xml:id="m-3e10f7f5-dfc6-44e0-849a-2623ee2fef4f" ulx="367" uly="1174" lrx="714" lry="1210" /><zone xml:id="m-986e6d84-7827-4785-9013-99c210ec83b9" ulx="126" uly="1216" lrx="966" lry="1257" /><zone xml:id="m-8b7b6aea-6f02-4c40-b5e7-fd6277e1d3b4" ulx="105" uly="1245" lrx="747" lry="1283" /><zone xml:id="m-e466df4e-ae20-4720-bd34-81779bf34855" ulx="472" uly="1289" lrx="605" lry="1323" /><zone xml:id="m-ba416bff-892e-4a0a-bbdd-e5f74766aadf" ulx="129" uly="1317" lrx="427" lry="1348" /><zone xml:id="m-6f53bc46-1489-40d0-9d30-8991976d0c51" ulx="484" uly="1336" lrx="594" lry="1372" /><zone xml:id="m-887b3ab5-eae1-4614-824c-e1d6bdeb1e90" ulx="123" uly="1368" lrx="971" lry="1408" /><zone xml:id="m-1e7b3869-97d1-4315-8f82-0c4f0f8b85a6" ulx="107" uly="1396" lrx="970" lry="1437" /><zone xml:id="m-bfdc335d-2c3d-42b7-83b9-88ffec3884c5" ulx="107" uly="1426" lrx="613" lry="1461" /><zone xml:id="m-6e275a4b-75fa-4c99-89f9-463d1e8e7b86" ulx="130" uly="1458" lrx="468" lry="1499" /><zone xml:id="m-a90bc42d-bc6d-471d-be2a-78ea5c5df2e1" ulx="132" uly="1497" lrx="967" lry="1532" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-dda6fae0-d242-48d6-8175-3f5157f62808" n="1888" facs="#m-a3197453-751d-471b-a897-1e45f00c1564" /><div xml:id="m-ad6be614-2775-477a-895c-e19d80f9f2b5">
            <lg xml:id="m-58cc2cb8-785f-4e88-ac75-b503bc0cf143">
              <l xml:id="m-20eafd53-b613-4fef-8b05-7c18f4448011" facs="#m-71fdf060-bba3-41dd-954b-a14337867595" label="ambiguous">1648</l><l xml:id="m-174e5e74-dbb8-4a94-8fac-6a19734dc9cd" facs="#m-f71ffca2-9101-4f7c-b181-cfff5098507a" label="ambiguous">September 19. 20. 21.</l><l xml:id="m-73d81b96-d1da-4aa1-bb21-464915866202" facs="#m-7a152fd9-a1ab-4279-96e9-f258d9f7fda3" label="text-like">19. St. Januarius, Bishop, and his Companions, Martyrs.</l><l xml:id="m-7b578d80-7c1e-4b93-a4b2-1a5421beac0d" facs="#m-378b9aea-c096-4eda-b691-323e6c489c79" label="ambiguous">Double.</l><l xml:id="m-4aba8be8-3dfd-465e-a166-0939e6872772" facs="#m-eddf76b3-1cc5-4d63-b5f2-e77738cf26d2" label="lyrics-like">Mass. Sálus autem. p. 1169, except the Gospel.</l><l xml:id="m-f796e524-d9d1-4e96-8e20-6749cefdd56b" facs="#m-7a283e06-b1b6-4691-9fc6-88ba9c614d4c" label="ambiguous">Collect.</l><l xml:id="m-4112a138-0a3d-46a3-baf8-46ba2f686461" facs="#m-36b9174c-0374-43e8-ac33-42ed4980ec4e" label="lyrics-like">Eus, qui nos ánnua sanctórum ! cas: t concéde propítius; ut quo¬</l><l xml:id="m-a7ca36c6-38d0-4473-8ac4-309555396264" facs="#m-572ea3bf-344b-4bdb-b020-41274f9504c9" label="lyrics-like">U Mártyrum tuórum Januárii et rum gaudemus méritis, 7 accendá¬</l><l xml:id="m-5766783a-6b64-47c2-b944-7e02cf0c1718" facs="#m-b6f05a7d-2664-4650-b056-3a0c0d1a0ec9" label="lyrics-like">Sociórum ejus solemnitá̂te laetifi-l mur exémplis. Per Dóminum.</l><l xml:id="m-d5226339-f35e-41ef-a2e0-dc2161c85771" facs="#m-b0ed2421-2f66-4e0f-8007-507fc415737b" label="ambiguous">† Sequentia sancti Evangelii secundum Matthæum.</l><l xml:id="m-99e3bc13-82c7-43b5-85c2-7084c8c1608f" facs="#m-ec2160c5-b0f0-4ae6-adfe-b82e214d0390" label="ambiguous">Matth. 24.</l><l xml:id="m-4ad27753-8aee-4073-9695-c3747c6406e9" facs="#m-19c21c3b-ed72-468b-8e15-530c78a943b8" label="lyrics-like">TN illo témpore: Sedénte Jesu regnum, et erunt pestiléntiae, et</l><l xml:id="m-6d4bfb2c-9896-4794-a70c-256a9bcdea8d" facs="#m-1e7e8a66-b97a-4cda-b1ed-68b28893c040" label="lyrics-like">L super montem Olivéti, acces¬</l><l xml:id="m-f2e07a2d-c6f6-49e5-9962-a73a25f9e644" facs="#m-e5547b91-8096-4c5f-a280-cde7bc2f748b" label="lyrics-like">fames, et terraemótus per loca.</l><l xml:id="m-4b1aa778-4543-4cd6-9793-9d5adde92f5e" facs="#m-d4687457-a3a9-402c-9c8c-7abd9e000185" label="lyrics-like">sérunt ad eum discípuli secréto,</l><l xml:id="m-600d9542-af0f-4a88-b69e-c792d9a646a2" facs="#m-b38abe1d-349d-42df-b6cc-806614dd9282" label="lyrics-like">Hæc autem ómnia initia sunt doló¬</l><l xml:id="m-c3f41502-e133-452b-b838-f3d739aa6cee" facs="#m-a2f826b4-ced2-4cc9-b9b2-aab804510bbd" label="lyrics-like">dicéntes: Dic nobis, quando hæc</l><l xml:id="m-df02ef68-d453-4e10-8ad8-79402ea869dd" facs="#m-f0c492dd-da2c-488d-98b0-ed38962e314a" label="lyrics-like">rum. Tunc tradent vos in tribulatió¬</l><l xml:id="m-1a79e74a-ad5e-41ce-ba56-3357dcb37cd7" facs="#m-881daa2e-9db5-423b-af71-853688a21cb2" label="lyrics-like">nem, et occident vos : et éritis ódio</l><l xml:id="m-415f6487-ccda-4085-a957-4705218b36c7" facs="#m-cfe6d025-9632-4c3e-8ccb-8fe13d2ae171" label="lyrics-like">erunt? et quod signum advéntus</l><l xml:id="m-600d7afc-6717-47cd-9474-09ea5061c25d" facs="#m-1863dc39-a6b7-4d7d-9161-c042acb56c91" label="lyrics-like">ómnibus géntibus propter nomen</l><l xml:id="m-3e58731e-7f4d-4948-b524-b97c1ce432fb" facs="#m-e3f9ee64-acc7-4360-b5b2-9e82c8849413" label="lyrics-like">tui, et consummatiónis saéculi? Et</l><l xml:id="m-cf698815-0ccd-4233-bb10-c47505ffd4ee" facs="#m-6c07fece-9d93-4569-a4df-0ae9c409067e" label="lyrics-like">respóndens Jesus, dixit eis: Vidéte</l><l xml:id="m-2a30cf10-b621-455e-903d-c15e9a0c8484" facs="#m-4b575211-7af6-4fc3-94f2-f5d98203304c" label="lyrics-like">meum. Et tunc scandalizabúntur</l><l xml:id="m-c85b7971-c4e9-427a-927a-0a57bc6cacb1" facs="#m-36af072b-7821-4ed2-97c4-e650066e370a" label="lyrics-like">ne quis vos sedúcat. Multi enim</l><l xml:id="m-5e424921-e3df-4bf1-af01-4a4b0caadccf" facs="#m-e34c6400-e626-408a-8c3b-42d05850df5e" label="lyrics-like">multi, et ínvicem tradent, et ódio</l><l xml:id="m-0694fc76-ecb2-4a7d-ad5e-ab6750e9ee61" facs="#m-9de50cfd-6902-4550-9869-6e81dfa53611" label="lyrics-like">vénient in nómine meo, dicéntes:</l><l xml:id="m-64de6dac-f269-4c1d-9ba8-b581991ad0f9" facs="#m-6dd8d366-8686-43cf-8b89-16e0e2907fa7" label="lyrics-like">habébunt ínvicem. Et multi pseu¬</l><l xml:id="m-de8309c7-0b0e-466c-8385-c5e6f961e2d8" facs="#m-fbbdc8c5-0129-4ad3-b53d-757d045590dd" label="lyrics-like">Ego sum Christus: et multos sedú¬</l><l xml:id="m-1b51b6c2-c265-4fd8-b03d-c031ec1be032" facs="#m-3d1a1c1e-7cea-4910-995e-e4dc7e3801a4" label="lyrics-like">doprophétae surgent, et sedücent</l><l xml:id="m-e48e83f2-5de0-448c-8565-5db1dadb1954" facs="#m-1d31c7f0-d95f-4098-8599-cbac041b98d8" label="lyrics-like">cent. Auditúri enim estis praélia, et</l><l xml:id="m-e3f10096-fefe-4089-b436-1de78aa9e7ed" facs="#m-913dc7fb-9ff8-4b21-81f5-f985effba18f" label="lyrics-like">multos. Et quóniam abundávit iní¬</l><l xml:id="m-8723e22a-47b1-4d3b-a82c-e13520167f87" facs="#m-e3ec114b-f927-4716-b542-040545eb66ad" label="lyrics-like">opiniónes praeliórum. Vidéte ne</l><l xml:id="m-e58cad99-c792-4c84-971d-0236014db15a" facs="#m-0dc1aef6-397a-44d5-8a6f-969844934e6a" label="lyrics-like">quitas, refrigéscet cáritas multó¬</l><l xml:id="m-02e80839-9c9d-4aab-9b40-23887700593b" facs="#m-4abe5994-22c1-40d7-9f64-6abc84de7963" label="lyrics-like">rum. Qui autem perseveráverit</l><l xml:id="m-d77ef7da-b08e-4d08-9470-55a74e2c75ec" facs="#m-39b32413-4b27-412e-854d-abaf8f581939" label="lyrics-like">turbémini. Opórtet enim haec fieri,</l><l xml:id="m-b171e3e6-ae67-4a55-9614-c1f1510d1c35" facs="#m-5736552a-f3ff-4fc2-9d5a-db46a66b7422" label="lyrics-like">sed nondum est finis. Consúrget! usque in finem, hic salvus erit.</l><l xml:id="m-df40db3e-b086-4e2d-8634-772f5a4a572b" facs="#m-3e652647-349c-4102-b9eb-f2d1d13506a1" label="ambiguous">enim gens in gentem, et regnum in!</l><l xml:id="m-cf641bc9-b0ae-42e6-a033-86ff01966cd8" facs="#m-af30366e-dcda-4980-b1ed-977f9cdb5472" label="text-like">20. St. Eustace and his Companions, Martyrs. Double.</l><l xml:id="m-d34d1878-3565-4df7-be6b-3dd36c8a6eff" facs="#m-ec790e9a-dffe-4147-b078-424ca7080263" label="lyrics-like">Mass. Sapiéntiam. p. 1166.</l><l xml:id="m-f2215774-2267-4fa8-b0ef-55f45be5c769" facs="#m-2bbdb1ef-aeb2-44fc-9f46-3029b181c70f" label="ambiguous">Collect.</l><l xml:id="m-e868dfd9-ff29-49bc-a073-7ec69adc53aa" facs="#m-d6779f38-f8a1-4970-9e3d-fa066304914b" label="lyrics-like">Eus, qui nos concédis sanctó-[lere: t da nobis in aetérna beatitú¬</l><l xml:id="m-856ba2aa-5f49-4fe6-9332-9884e452e13a" facs="#m-ad1c2af0-ae12-4bfb-a691-75f3b45adf0b" label="lyrics-like">U rum Mártyrum tuórum Eustá- dine * de eórum societâte gaudére.</l><l xml:id="m-e55833de-7b96-420d-91ee-dfbc6f431a02" facs="#m-2fafc3c9-3d87-4ece-86e0-5089f26d6463" label="lyrics-like">chii et Sociórum ejus natalitia có- Per Dóminum.</l><l xml:id="m-cd08b8b5-d61e-47fb-b902-950458a61157" facs="#m-bf04cb55-3521-4b83-acf6-b89f78607620" label="text-like">21. ST. MATTHEW, APOSTLE AND EVANGELIST.</l><l xml:id="m-4d75b4e6-ba9e-4fbd-955b-9e4649c7466d" facs="#m-3e10f7f5-dfc6-44e0-849a-2623ee2fef4f" label="text-like">Double of the second Class.</l><l xml:id="m-685273b3-02d7-4413-9503-c538d927f4a2" facs="#m-986e6d84-7827-4785-9013-99c210ec83b9" label="text-like">At Vespers and at the Little Hours, all from the Common or</l><l xml:id="m-fb82bc5f-29f5-4509-be84-e4038717f162" facs="#m-8b7b6aea-6f02-4c40-b5e7-fd6277e1d3b4" label="lyrics-like">Evangelists. p. 1I11. — Prayer. Beáti Apóstoli. as below.</l><l xml:id="m-1cde2c74-3c76-409c-b2d2-27cc8eddf833" facs="#m-e466df4e-ae20-4720-bd34-81779bf34855" label="text-like">AT MASS.</l><l xml:id="m-9436bd33-6084-4e4a-a930-0d9f277feed9" facs="#m-ba416bff-892e-4a0a-bbdd-e5f74766aadf" label="lyrics-like">Introit. Os jústi. p. 1200.</l><l xml:id="m-7a6e36db-756b-4e88-ac2c-68e436be1d9c" facs="#m-6f53bc46-1489-40d0-9d30-8991976d0c51" label="ambiguous">Collect.</l><l xml:id="m-55d3bb57-af98-4758-93a9-5a7714c0b44d" facs="#m-887b3ab5-eae1-4614-824c-e1d6bdeb1e90" label="lyrics-like">2Eáti Apóstoli et Evangelistae! nostra non óbtinet, * ejus nobis</l><l xml:id="m-d49872b4-52f5-486e-b958-0f99aafd6a84" facs="#m-1e7b3869-97d1-4315-8f82-0c4f0f8b85a6" label="lyrics-like">O Matthaéi, Dómine, précibus ! intercessióne donétur. Per Dómi¬</l><l xml:id="m-83415bfa-8a92-4688-b87c-47bfd3d337ab" facs="#m-bfdc335d-2c3d-42b7-83b9-88ffec3884c5" label="lyrics-like">adiuvémur : i ut quod possibilitas! num.</l><l xml:id="m-caa21ebb-6a49-4c6c-8473-817c857cba58" facs="#m-6e275a4b-75fa-4c99-89f9-463d1e8e7b86" label="lyrics-like">Epistte. Similitúdo. p. 1432.</l><l xml:id="m-d7de70c4-7a18-4400-895a-8f6f96f2d7ef" facs="#m-a90bc42d-bc6d-471d-be2a-78ea5c5df2e1" label="lyrics-like">Gradual. Beátus vir. D.1136. Allelúia, allelúia. Y. Te gloriósus. p.1613</l></lg></div></section></score></mdiv></body></music>
