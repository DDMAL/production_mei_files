 /><zone xml:id="m-e444eabb-51a6-4e15-9141-f8a98ff86422" ulx="292" uly="720" lrx="676" lry="765" /><zone xml:id="m-4fd322e0-64e3-498e-8754-fb01b3801e10" ulx="713" uly="725" lrx="902" lry="765" /><zone xml:id="m-90628cba-2fb2-4d05-84e1-3163c812deb9" ulx="56" uly="768" lrx="759" lry="810" /><zone xml:id="m-365a7eb5-0639-477a-bda9-81ff54a3b31d" ulx="213" uly="848" lrx="770" lry="893" /><zone xml:id="m-f17b7b5e-c240-403f-816a-bc48343d77ee" ulx="37" uly="849" lrx="94" lry="891" /><zone xml:id="m-429ed7cd-b0fa-4a30-ba4b-c5538005912d" ulx="788" uly="856" lrx="901" lry="892" /><zone xml:id="m-e1394876-5883-4d28-ae78-11e24d24da01" ulx="60" uly="899" lrx="762" lry="939" /><zone xml:id="m-1995eb21-a291-498c-acb5-61542121e9f0" ulx="447" uly="943" lrx="557" lry="981" /><zone xml:id="m-57b1629a-0dfb-4903-9606-ab322da0be11" ulx="37" uly="969" lrx="903" lry="1012" /><zone xml:id="m-60d85280-5695-4460-bfb7-51579ae1afd2" ulx="48" uly="1000" lrx="901" lry="1038" /><zone xml:id="m-7a3325c0-e122-45d2-bb3b-396ccee1b795" ulx="36" uly="1025" lrx="663" lry="1068" /><zone xml:id="m-eb5f90cf-cdd2-444a-a773-70e194e7da46" ulx="57" uly="1064" lrx="714" lry="1102" /><zone xml:id="m-bdf37344-0d10-4d54-a120-1c800b291e5a" ulx="417" uly="1107" lrx="527" lry="1138" /><zone xml:id="m-947a293d-bf58-413a-a92a-9157d804f2b9" ulx="66" uly="1136" lrx="901" lry="1172" /><zone xml:id="m-f652e91d-dbd8-45f7-90f6-64c48f6bdc81" ulx="41" uly="1164" lrx="463" lry="1207" /><zone xml:id="m-4958a706-34d6-4031-aa00-7ac82266aec6" ulx="467" uly="1164" lrx="902" lry="1206" /><zone xml:id="m-3e03d7b2-7694-4060-a636-116ff06a6263" ulx="32" uly="1193" lrx="785" lry="1227" /><zone xml:id="m-af4dd6d6-cdbe-445a-ab37-3d35127fdd9c" ulx="30" uly="1220" lrx="460" lry="1254" /><zone xml:id="m-741346ca-7509-48c0-b43b-fc514ec9740c" ulx="54" uly="1249" lrx="803" lry="1284" /><zone xml:id="m-8cbdd671-ef77-45af-a984-b0fea7cf142b" ulx="224" uly="1312" lrx="699" lry="1354" /><zone xml:id="m-5203cfb4-b2e4-40f7-a553-aa4b7a8dab6f" ulx="32" uly="1318" lrx="89" lry="1359" /><zone xml:id="m-7a3abdea-41de-4cef-bacd-935b189316d1" ulx="795" uly="1319" lrx="902" lry="1361" /><zone xml:id="m-6b1efdaf-3aff-4bbe-ad88-ebe5f012fd35" ulx="56" uly="1361" lrx="331" lry="1406" /><zone xml:id="m-1d619e73-5220-47ef-afe8-003410b4a411" ulx="412" uly="1394" lrx="522" lry="1426" /><zone xml:id="m-ef0d4cb3-bb4c-4606-b845-36c14a6ac112" ulx="70" uly="1419" lrx="902" lry="1458" /><zone xml:id="m-05942aba-5736-4c98-86c5-498ae20e0ee9" ulx="35" uly="1451" lrx="899" lry="1487" /><zone xml:id="m-bd24a567-95a0-4839-b0a4-540f17db863b" ulx="34" uly="1479" lrx="900" lry="1514" /><zone xml:id="m-5dc46a5e-1f66-4050-9917-546128db8835" ulx="33" uly="1504" lrx="901" lry="1541" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-5fe1653e-1137-4abc-9c4b-f14c5fa28586" n="1999" facs="#m-926ee66b-ed22-468b-9760-ec5df1d9b3fa" /><div xml:id="m-2712ab46-b36a-40e5-a961-dec299f14b4f">
            <lg xml:id="m-a2ab9888-0f3c-440f-bc7f-12407a845058">
              <l xml:id="m-6cb490ba-c30b-4a9d-9eec-9e0a1f0cfdbc" facs="#m-7fa79586-e1c3-4a9c-8ced-cc25abcc04cb" label="ambiguous">November 16. 17. 18. 19. 20.</l><l xml:id="m-70f2dea0-3a17-4a99-acb2-643f2df5a7f3" facs="#m-c2e353d7-0cdc-44d1-8fc1-e01d9aad66ed" label="ambiguous">1753</l><l xml:id="m-b31d48d2-db05-4306-b2e2-df91e2030c8d" facs="#m-26911ec0-8a3b-4421-8885-9f1595a60254" label="ambiguous">St. Gertrude, Virgin.</l><l xml:id="m-33b9cfe3-daef-4e9b-90dd-08e3ea9a9ec5" facs="#m-a3a0475b-60c3-4bff-b9f3-841ba136bdb7" label="ambiguous">16.</l><l xml:id="m-aa12c8bd-5e97-4002-9ddd-ce7222af6beb" facs="#m-d1e537d8-cd4d-4a6a-ac9e-ad35aeb01d3d" label="ambiguous">Double.</l><l xml:id="m-8d190890-e119-4fb8-9f66-ca95c5dcf3cc" facs="#m-66167bf2-18a0-444e-908a-f4203c35c38f" label="lyrics-like">Mass. Dilexísti. from the Common of a Virgin, p. 1225.</l><l xml:id="m-84b9e61b-537b-40e6-b86e-89dbf52400c7" facs="#m-de8d0652-6dfc-4257-a9fd-3e05cbd15b65" label="ambiguous">Collect.</l><l xml:id="m-7e935c7f-3e4a-4bb6-acb7-33dde5e4a473" facs="#m-752ca5cd-18db-4ac3-a4ca-5c5f7c08bad9" label="lyrics-like">Eus, qui in corde beâtae Ger-[stri máculas cleménter abstérge,»</l><l xml:id="m-5c6ecfe1-d54a-4dde-97ca-76a3be48d5fe" facs="#m-e538bfc0-4a5f-4d68-b544-c28fe228ffd4" label="lyrics-like">I trúdis Virginis jucúndam tibil et ejúsdem tribue gaudére consór¬</l><l xml:id="m-2d48f906-3788-41f8-927d-4729e951bc4f" facs="#m-ed1e52e1-b359-48f5-bd42-31ad59c6db98" label="lyrics-like">mansiónem praeparásti: t ipsius tio. Per Dóminum.</l><l xml:id="m-b8fd9561-98e7-41d0-9b7e-ae56f8dbc01b" facs="#m-d6e6aa55-21f9-48de-ad3e-611e1a773f49" label="lyrics-like">méritis et intercessióne; cordis no¬</l><l xml:id="m-b8a20808-9fa9-4d67-b9d1-8ad51e773b4a" facs="#m-a3795a74-63b9-4416-8849-cac9f5cd4ee3" label="text-like">17. St. Gregory, the Wonder-Worker, Bishop and Conf.</l><l xml:id="m-137911ae-a5ec-4428-8cd4-04bc135461db" facs="#m-6985563a-53e3-4a99-94ca-99f412e7b16f" label="ambiguous">Semi-double.</l><l xml:id="m-3541f7ef-1c55-4e56-9a95-042c84b3c9b9" facs="#m-0e0368ab-ce0a-49b2-8a91-bd7a0046fadf" label="ambiguous">Collect.</l><l xml:id="m-21ad872d-d673-4c10-8140-4031fa3194a3" facs="#m-a85e6802-0aa9-41cc-a50d-2c602ab5b676" label="lyrics-like">A, quaésumus omnípotens ! ránda solémnitas, * et devotiónem</l><l xml:id="m-13f0760e-a903-4565-8e7c-ee744a8eda9f" facs="#m-d4bddbea-f5b4-4489-b60e-2f9b6a3e52a7" label="lyrics-like">U Deus : † ut beáti Gregórii Con-[mnobis áugeat et salútem. Per Dómi¬</l><l xml:id="m-1b958b87-c203-422c-bb72-6e568c9e6ea1" facs="#m-c684529b-c170-4d33-b0c4-7d06138ea3f4" label="lyrics-like">fessóris tui atque Pontíficis vene- num.</l><l xml:id="m-14115183-c45c-4585-8231-5f371b885102" facs="#m-89f0b952-186f-40aa-b550-a0c5e4499c80" label="lyrics-like">Secret. Sancti tui. and Postcommunion. Praesta quaésumus. p. 1185.</l><l xml:id="m-081c858b-e206-44da-bb33-1cd788132ac7" facs="#m-18fbb586-7488-460a-9ba3-ef1386203be5" label="text-like">The Dedication of the Basilicas</l><l xml:id="m-7e59c1b5-fd72-4e32-a8cd-d59686c07730" facs="#m-f0dd5c18-0bd9-450a-926e-7602efd3b01b" label="ambiguous">18.</l><l xml:id="m-9142011c-2669-4a2f-8c8d-a1c0380dd75e" facs="#m-e444eabb-51a6-4e15-9141-f8a98ff86422" label="text-like">of SS. Peter and Paul.</l><l xml:id="m-bb86ddfc-063f-48f4-96a8-35cebec5287d" facs="#m-4fd322e0-64e3-498e-8754-fb01b3801e10" label="ambiguous">Double major.</l><l xml:id="m-c587e8ce-0f73-4ab7-b3e9-4c6962288383" facs="#m-90628cba-2fb2-4d05-84e1-3163c812deb9" label="text-like">All from the Common of the Dedication of a Church. p. 1241.</l><l xml:id="m-2a261c2f-eda7-431c-8a53-a8a64413b76d" facs="#m-365a7eb5-0639-477a-bda9-81ff54a3b31d" label="text-like">St. Elizabeth of Hungary, Widow.</l><l xml:id="m-042bc4c6-34dc-4df0-b6e7-21f803e980b9" facs="#m-f17b7b5e-c240-403f-816a-bc48343d77ee" label="ambiguous">19.</l><l xml:id="m-139e36e1-c617-4db8-8034-e3320c0bf83d" facs="#m-429ed7cd-b0fa-4a30-ba4b-c5538005912d" label="ambiguous">Double.</l><l xml:id="m-bb4914cb-4a5a-4743-8891-413373aeda69" facs="#m-e1394876-5883-4d28-ae78-11e24d24da01" label="lyrics-like">Mass. Cognóvi. from the Common of Hoty women, p. 1239.</l><l xml:id="m-4338f503-ff15-49e8-95dd-80818fa02ed7" facs="#m-1995eb21-a291-498c-acb5-61542121e9f0" label="ambiguous">Collect.</l><l xml:id="m-557f54a5-5608-4243-9dcd-2b81c9d2edf1" facs="#m-57b1629a-0dfb-4903-9606-ab322da0be11" label="lyrics-like">HUórum corda fidélium Deus mi- próspera mundi despícere; * et cae¬</l><l xml:id="m-2693a077-d5de-480c-a294-c6bff98afe06" facs="#m-60d85280-5695-4460-bfb7-51579ae1afd2" label="lyrics-like">I serátor illústra:t et beâtae lésti semper consolatiône gaudére.</l><l xml:id="m-44aed88c-11ab-47b3-a47a-05bed672f59a" facs="#m-7a3325c0-e122-45d2-bb3b-396ccee1b795" label="lyrics-like">Éfisabeth précibus gloriósis fac nosl Per Dóminum.</l><l xml:id="m-aa5483b7-3321-4bee-8d60-c4b63d0b36a9" facs="#m-eb5f90cf-cdd2-444a-a773-70e194e7da46" label="text-like">Commemoration of St. Pontianus, Pope and Martyr.</l><l xml:id="m-7e753333-92db-4ed4-91e0-cdf67e6bceba" facs="#m-bdf37344-0d10-4d54-a120-1c800b291e5a" label="ambiguous">Collect.</l><l xml:id="m-b5ebf3a5-c354-4f7e-9ed8-2aca85c7071f" facs="#m-947a293d-bf58-413a-a92a-9157d804f2b9" label="lyrics-like">"Regem tuum, Pastor aetérne, tua protectióne custódi; * quem</l><l xml:id="m-11849a4a-a575-4cd4-9c62-b6faa32065f0" facs="#m-f652e91d-dbd8-45f7-90f6-64c48f6bdc81" label="lyrics-like">( placátus inténde: ! et per</l><l xml:id="m-2c6779ba-5bbe-4520-883f-c8a977a4a343" facs="#m-4958a706-34d6-4031-aa00-7ac82266aec6" label="lyrics-like">totius Ecclésiae praestitisti esse</l><l xml:id="m-ee40275d-f527-4b78-9110-27861455757a" facs="#m-3e03d7b2-7694-4060-a636-116ff06a6263" label="lyrics-like">beátum Pontiánum Mártyrem tuum! pastórem. Per Dóminum.</l><l xml:id="m-e512eb5b-7620-4662-8854-14eddfd18154" facs="#m-af4dd6d6-cdbe-445a-ab37-3d35127fdd9c" label="lyrics-like">atque Summum Pontificem, perpé¬</l><l xml:id="m-8a607fdd-de74-425c-b494-82fffaccb2f1" facs="#m-741346ca-7509-48c0-b43b-fc514ec9740c" label="lyrics-like">Secret. Oblátis. p. 11226. and Postcommunion. Refectióne. p. 1123.</l><l xml:id="m-5fab8436-e446-47b3-bf36-c41aec1f9980" facs="#m-8cbdd671-ef77-45af-a984-b0fea7cf142b" label="text-like">St. Felix of Valois, Confessor.</l><l xml:id="m-d5b8c1cb-0096-4ce1-8a23-655e7f4c9310" facs="#m-5203cfb4-b2e4-40f7-a553-aa4b7a8dab6f" label="ambiguous">20.</l><l xml:id="m-236c546e-e36b-4edf-9917-8998c6c7609a" facs="#m-7a3abdea-41de-4cef-bacd-935b189316d1" label="ambiguous">Double.</l><l xml:id="m-5a8bc22c-3634-4d07-8143-bbbf3f6bb66f" facs="#m-6b1efdaf-3aff-4bbe-ad88-ebe5f012fd35" label="lyrics-like">Mass. Jústus. p. 1204.</l><l xml:id="m-f37cbda1-cca8-44b0-a865-d14ba8f69f0d" facs="#m-1d619e73-5220-47ef-afe8-003410b4a411" label="ambiguous">Collect.</l><l xml:id="m-b47fbde8-2c08-403b-b3db-32bf52198ef7" facs="#m-ef0d4cb3-bb4c-4606-b845-36c14a6ac112" label="lyrics-like">Eus, qui beátum Felicem Con-] sumus; ut per grátiam tuam ex pec¬</l><l xml:id="m-3625e2d5-9daf-4105-a686-a3d4d02995b7" facs="#m-05942aba-5736-4c98-86c5-498ae20e0ee9" label="lyrics-like">U fessórem tuum ex erémo ad] catórum nostrórum captivitáte, ejus</l><l xml:id="m-a7d5988f-6f7d-4fce-98f7-e3a46b8b4369" facs="#m-bd24a567-95a0-4839-b0a4-540f17db863b" label="lyrics-like">munus rediménti captivos caélitus intercessióne liberáti, * ad caeléstem</l><l xml:id="m-967e1a28-0e68-4334-a36c-c63c2ea2566e" facs="#m-5dc46a5e-1f66-4050-9917-546128db8835" label="lyrics-like">vocáre dignátus es : f praesta quaé-l pátriam perducámur. Per Dóminum.</l></lg></div></section></score></mdiv></body></music>
</mei>