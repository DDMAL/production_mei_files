      <graphic xml:id="m-25a6c1ca-6da3-42a1-9e70-310eec512888" target="1503_original_image.tiff" /><zone xml:id="m-c953a267-eaeb-418a-ab64-902a7ac66e7d" ulx="61" uly="191" lrx="953" lry="279" /><zone xml:id="m-3733b722-c7b2-4a50-a5f0-11c00ed79ad1" ulx="54" uly="421" lrx="989" lry="461" /><zone xml:id="m-d124e13c-190f-4f19-8af4-496b8913e16d" ulx="25" uly="457" lrx="475" lry="487" /><zone xml:id="m-0167c386-4c00-4b2c-9b79-b5146f64ae7d" ulx="52" uly="482" lrx="990" lry="522" /><zone xml:id="m-c60aa20f-dad8-4657-878a-57475e9add98" ulx="23" uly="510" lrx="989" lry="547" /><zone xml:id="m-f8435f29-d06c-4bdf-9a9b-aea85955225c" ulx="22" uly="543" lrx="987" lry="577" /><zone xml:id="m-81074994-263d-4e64-b5cf-86fe98728d8f" ulx="22" uly="565" lrx="988" lry="604" /><zone xml:id="m-77e92ee5-6c40-4839-883c-f7e8f1454843" ulx="23" uly="594" lrx="988" lry="628" /><zone xml:id="m-f4ea6a80-54bd-4ea5-adb5-4dbc16746796" ulx="22" uly="623" lrx="989" lry="659" /><zone xml:id="m-e1d8465e-3298-4867-b3db-be80ddbd59f8" ulx="23" uly="656" lrx="702" lry="685" /><zone xml:id="m-3993f824-a543-48f8-b6e4-3974b3061639" ulx="50" uly="682" lrx="989" lry="716" /><zone xml:id="m-2c761b70-9c58-454a-9764-b66a6a247168" ulx="22" uly="710" lrx="987" lry="747" /><zone xml:id="m-54979e30-b448-405e-9141-8ef871825150" ulx="22" uly="738" lrx="989" lry="773" /><zone xml:id="m-cb2bba9c-113d-4d60-8d4c-ec01070bd53d" ulx="22" uly="769" lrx="989" lry="807" /><zone xml:id="m-03f18e7a-c78e-459f-8bd1-5d4b682e9763" ulx="22" uly="798" lrx="374" lry="831" /><zone xml:id="m-3d6c74ea-2b5c-4955-90ff-825b0bfa43b0" ulx="256" uly="863" lrx="755" lry="911" /><zone xml:id="m-3a5304b8-c967-4c26-8f84-340bcec8be32" ulx="21" uly="927" lrx="871" lry="971" /><zone xml:id="m-24be04fd-7a29-4da1-911d-2b54b96438b1" ulx="447" uly="988" lrx="569" lry="1025" /><zone xml:id="m-5374d3c3-2b56-4816-b2bd-48d0aacbd655" ulx="73" uly="1021" lrx="989" lry="1067" /><zone xml:id="m-71a83723-4890-478c-8cb9-78c1e71c4525" ulx="24" uly="1052" lrx="852" lry="1098" /><zone xml:id="m-1111272d-4297-4fbb-98aa-6759514a2325" ulx="450" uly="1097" lrx="557" lry="1134" /><zone xml:id="m-76a0a096-3c57-4dfe-9be0-da7dd630937c" ulx="83" uly="1126" lrx="983" lry="1175" /><zone xml:id="m-58952603-2238-410f-9925-bc60e3ac1623" ulx="24" uly="1155" lrx="718" lry="1203" /><zone xml:id="m-09df97c2-726f-4859-899f-624271dc094e" ulx="23" uly="1195" lrx="500" lry="1235" /><zone xml:id="m-2b22e229-1ca8-49a5-9301-65492677b2bb" ulx="373" uly="1233" lrx="636" lry="1275" /><zone xml:id="m-d85bc66b-bd16-4306-9500-4f7c17418df5" ulx="35" uly="1265" lrx="985" lry="1307" /><zone xml:id="m-88f85731-1ae3-4269-bca4-f1fcf4107b3d" ulx="23" uly="1301" lrx="987" lry="1346" /><zone xml:id="m-5f77a21d-3c16-43f7-b280-8bfc003f435b" ulx="19" uly="1420" lrx="81" lry="1468" /><zone xml:id="m-8009e11e-7601-45e1-8669-648790fd7812" ulx="230" uly="1420" lrx="764" lry="1468" /><zone xml:id="m-fb38dcd8-a931-44e2-bd81-aeba60948781" ulx="324" uly="1472" lrx="684" lry="1517" /><zone xml:id="m-c91f6488-2e7f-411c-b08d-944baf5e696c" ulx="335" uly="1531" lrx="673" lry="1570" /><zone xml:id="m-fdbd328b-c1b4-4c85-b5e1-21609b54b1ed" ulx="49" uly="1570" lrx="983" lry="1612" /><zone xml:id="m-2c924264-7e95-49f8-9363-3cb18c4a200d" ulx="18" uly="1603" lrx="432" lry="1635" /><zone xml:id="m-a35a4330-8d7d-47ab-808d-80fa28e04784" ulx="50" uly="1632" lrx="605" lry="1674" /><zone xml:id="m-95034ccc-9fa8-4589-a2e6-52c2e5bdcaf1" ulx="50" uly="1666" lrx="590" lry="1708" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-320f2b27-930a-4030-9755-e39d58cbb34c" n="1503" facs="#m-a5b20cf2-3794-4074-8af4-4a3bdb57de75" /><div xml:id="m-d059e4c5-6deb-43c0-af1d-54cde2aa697f">
            <lg xml:id="m-dfe6ef18-d42a-49c1-b183-6d2b872ca934">
              <l xml:id="m-b9902fc7-4293-4f41-81ac-3d77b0d04c29" facs="#m-c953a267-eaeb-418a-ab64-902a7ac66e7d" label="text-like">The Proper of the Saits.</l><l xml:id="m-65641b7d-3e98-445c-8d6d-148ed028ff7e" facs="#m-3733b722-c7b2-4a50-a5f0-11c00ed79ad1" label="text-like">Whenever any part of an Office or a Mass is not mentioned as Proper to a</l><l xml:id="m-62ecb169-4a89-45be-aae3-34f7ba8795fc" facs="#m-d124e13c-190f-4f19-8af4-496b8913e16d" label="text-like">Saint, it is taken from the Common.</l><l xml:id="m-07dc2999-9c4b-44e7-b5b1-4fabc526a420" facs="#m-0167c386-4c00-4b2c-9b79-b5146f64ae7d" label="text-like">The Psalms of Sunday are said at Lauds, at the Little Hours, and at</l><l xml:id="m-c06ee9f5-e194-419d-92d3-dce3c41574ea" facs="#m-c60aa20f-dad8-4657-878a-57475e9add98" label="text-like">Compline on the feasts of Our Lord, of the Blessed Virgin Mary, of the</l><l xml:id="m-c2df1b73-e0d4-4a06-beec-75eddba7aeb0" facs="#m-f8435f29-d06c-4bdf-9a9b-aea85955225c" label="text-like">Angels, of St John the Baptist, of St Joseph, of the Apostles and Evangelists,</l><l xml:id="m-b5119362-f902-4691-a6cc-df93ce5126e8" facs="#m-81074994-263d-4e64-b5cf-86fe98728d8f" label="text-like">and on every feast which is a Double of the first or second class, but noi</l><l xml:id="m-1cad337a-9b16-4e26-b1f1-f0851d08b504" facs="#m-77e92ee5-6c40-4839-883c-f7e8f1454843" label="text-like">during the common or simple Octaves of ihese feasts. At Prime, the Psalms</l><l xml:id="m-f9aaf31e-8c53-499d-a418-a8e113031afd" facs="#m-f4ea6a80-54bd-4ea5-adb5-4dbc16746796" label="text-like">are those indicated for Feasts. At Vespers, if the Psalms are not mentionea</l><l xml:id="m-5190f632-d53e-4bdb-bfd4-cee9b567f41d" facs="#m-e1d8465e-3298-4867-b3db-be80ddbd59f8" label="text-like">in the Proper, they are to be taken from the Common.</l><l xml:id="m-60add6bf-5e52-4c23-a16f-a1cf45da47be" facs="#m-3993f824-a543-48f8-b6e4-3974b3061639" label="text-like">On feasts of double major or double minor rite and during Common or</l><l xml:id="m-5e36b620-dd56-4ba6-a94f-e387aa567fa8" facs="#m-2c761b70-9c58-454a-9764-b66a6a247168" label="text-like">simple octaves, the Antiphons and Psalms of the feria are said at Vespers.</l><l xml:id="m-cb2d5f16-eefe-401b-8bbd-29fc7aeaa8a2" facs="#m-54979e30-b448-405e-9141-8ef871825150" label="text-like">Howvever, if a double major or double minor feast has Antiphons proper to</l><l xml:id="m-3947adcb-e7e7-4134-a177-15deb3dc0ee8" facs="#m-cb2bba9c-113d-4d60-8d4c-ec01070bd53d" label="text-like">the feast, these Antiphons are said at Vespers with the psalms proper to them</l><l xml:id="m-4e7ab26a-b29a-404a-8c0f-540398aa20f7" facs="#m-03f18e7a-c78e-459f-8bd1-5d4b682e9763" label="text-like">or taken from the Common.</l><l xml:id="m-ac4c20ce-dc69-4210-bf26-5631cd88cbfc" facs="#m-3d6c74ea-2b5c-4955-90ff-825b0bfa43b0" label="text-like">FEASTS OF NOVEMBER.</l><l xml:id="m-85bb6c7a-324e-4a21-8084-bf5d13a7e7f3" facs="#m-3a5304b8-c967-4c26-8f84-340bcec8be32" label="text-like">29. Commemoration of St. Saturninus. Martyr.</l><l xml:id="m-cd84bbd9-5b7d-4922-aedb-4b0d06f4a6e6" facs="#m-24be04fd-7a29-4da1-911d-2b54b96438b1" label="ambiguous">Collect.</l><l xml:id="m-48cf0a92-7c33-4e5a-84b3-f03ad1059dfe" facs="#m-5374d3c3-2b56-4816-b2bd-48d0aacbd655" label="lyrics-like">Eus, qui nos beáti Saturníni pérfrui: * ejus nos tribue méritis</l><l xml:id="m-f673256f-8d69-4de0-b368-92a2789e1486" facs="#m-71a83723-4890-478c-8cb9-78c1e71c4525" label="lyrics-like">I Mártyris tui concédis natalitio adjuvári. Per Dóminum.</l><l xml:id="m-f99a5ffd-b191-4bc7-b85f-cc9d01239a2d" facs="#m-1111272d-4297-4fbb-98aa-6759514a2325" label="ambiguous">Secret.</l><l xml:id="m-1f93cb3a-135b-4732-bf45-90c2d183a54e" facs="#m-76a0a096-3c57-4dfe-9be0-da7dd630937c" label="lyrics-like">Unera, Dómine, tibi dicáta  haec éadem nos placátus inténde.</l><l xml:id="m-a544d3ff-433d-4c8b-bc1d-06c1306e1e6a" facs="#m-58952603-2238-410f-9925-bc60e3ac1623" label="lyrics-like">J1L sanctífica: et, intercedente Per Dóminum.</l><l xml:id="m-47e3c010-2e55-4ccf-b39b-941785c507bb" facs="#m-09df97c2-726f-4859-899f-624271dc094e" label="lyrics-like">beáto Saturníno Mártyre tuo, per</l><l xml:id="m-032b9e4f-e0c6-48ff-bff0-2369119ac99b" facs="#m-2b22e229-1ca8-49a5-9301-65492677b2bb" label="ambiguous">Postcommunion.</l><l xml:id="m-5a96a1f1-662b-4bb4-a913-41336ba9cd93" facs="#m-d85bc66b-bd16-4306-9500-4f7c17418df5" label="lyrics-like">NAnctíficet nos, quaésumus Dó-] et intercessióne sanctórum tuórum</l><l xml:id="m-d66b6f60-6848-4916-947b-03c21e30a851" facs="#m-88f85731-1ae3-4269-bca4-f1fcf4107b3d" label="lyrics-like">Omine, tui percéptio sacraménti l tibi reddat accéptos. Per Dóminum.</l><l xml:id="m-89345658-9db6-433d-9b77-94e798c361d0" facs="#m-5f77a21d-3c16-43f7-b280-8bfc003f435b" label="ambiguous">30.</l><l xml:id="m-380373ac-dbe3-45e8-b9a6-6bab3abf721d" facs="#m-8009e11e-7601-45e1-8669-648790fd7812" label="ambiguous">SAINT ANDREW. APOSTLE.</l><l xml:id="m-369c7cf9-b303-4b8c-9b0f-ce6360b2fc4a" facs="#m-fb38dcd8-a931-44e2-bd81-aeba60948781" label="text-like">Double of the second Class.</l><l xml:id="m-d03c7538-df4b-4139-b37e-3c6fd6a02b69" facs="#m-c91f6488-2e7f-411c-b08d-944baf5e696c" label="text-like">AT FIRST VESPERS.</l><l xml:id="m-a840acfc-6d22-485b-b15b-bab4c291c6a8" facs="#m-fdbd328b-c1b4-4c85-b5e1-21609b54b1ed" label="text-like">The Psalms are indicated at second Vespers, p. 1307. Antiphons, Chapter.</l><l xml:id="m-cb0e3442-2bc8-4f3a-a1ad-f0d692c0e73d" facs="#m-2c924264-7e95-49f8-9363-3cb18c4a200d" label="text-like">and Hymn as at second Vespers.</l><l xml:id="m-1b3fb21a-f232-41a4-82c1-f6a0aa86c14a" facs="#m-a35a4330-8d7d-47ab-808d-80fa28e04784" label="lyrics-like">V. In ómnem térram exívit sónus eórum.</l><l xml:id="m-9b7dc757-de8b-40c1-b7f9-ff141124f2bd" facs="#m-95034ccc-9fa8-4589-a2e6-52c2e5bdcaf1" label="lyrics-like">R. Et in fines órbis térrae vérba eórum.</l></lg></div></section></score></mdiv></body></music>
</mei>