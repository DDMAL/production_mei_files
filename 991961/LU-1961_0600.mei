708" lry="748" /><zone xml:id="m-b052fc9f-f200-4fae-aefb-54b2559b4bdd" ulx="138" uly="762" lrx="944" lry="796" /><zone xml:id="m-1681f651-0748-44a2-ba4e-4336f4ffea1f" ulx="139" uly="789" lrx="671" lry="827" /><zone xml:id="m-d62f0f48-b6bf-4e18-9689-4c36f8250485" ulx="140" uly="823" lrx="645" lry="856" /><zone xml:id="m-85b292c1-cf31-4d02-bfc7-8f2b359d7105" ulx="141" uly="851" lrx="910" lry="891" /><zone xml:id="m-c877e7e9-b086-4db0-8e57-838171907ca4" ulx="139" uly="886" lrx="559" lry="924" /><zone xml:id="m-8fa4ab8d-cc39-498b-bf59-566b683f0ab3" ulx="137" uly="917" lrx="705" lry="955" /><zone xml:id="m-f977ef21-8b28-4c3b-a7d8-982383b92fe0" ulx="136" uly="953" lrx="996" lry="994" /><zone xml:id="m-7d4a0ae8-f240-4256-896a-0e81225306ac" ulx="113" uly="981" lrx="422" lry="1021" /><zone xml:id="m-871988d5-745d-4d1a-86bf-f995948f759d" ulx="500" uly="1011" lrx="613" lry="1048" /><zone xml:id="m-030be7e9-6ba5-47f9-becc-3f8a77d26542" ulx="144" uly="1042" lrx="999" lry="1078" /><zone xml:id="m-182bc7fc-8470-4456-a915-25e3641a3713" ulx="118" uly="1069" lrx="999" lry="1107" /><zone xml:id="m-8f92d97f-e67f-48c3-822b-8fb293290268" ulx="113" uly="1098" lrx="882" lry="1133" /><zone xml:id="m-6a15f166-d379-437a-af2c-8087c24ac676" ulx="114" uly="1126" lrx="555" lry="1163" /><zone xml:id="m-1eb8a9de-3f08-4ee5-812e-8dc72a534770" ulx="138" uly="1165" lrx="990" lry="1204" /><zone xml:id="m-5be66fc0-3cb2-4509-9a6f-d3ca75286e32" ulx="139" uly="1200" lrx="1001" lry="1237" /><zone xml:id="m-907e9fbc-74e8-4379-80ee-e8d4d411f829" ulx="113" uly="1230" lrx="917" lry="1263" /><zone xml:id="m-a32b9c0d-80ba-4855-94fe-8b246910fae6" ulx="138" uly="1258" lrx="1001" lry="1296" /><zone xml:id="m-17ba05dd-a71c-4ae3-a5fa-d0f12d54c657" ulx="115" uly="1292" lrx="284" lry="1321" /><zone xml:id="m-c9146bfa-dcdc-4cbd-a0f6-9a2f3fb72110" ulx="137" uly="1314" lrx="1000" lry="1354" /><zone xml:id="m-59d9bf45-abff-44ab-a222-b8dc2371da5e" ulx="119" uly="1343" lrx="726" lry="1380" /><zone xml:id="m-a508bdd6-3e18-4aad-bca9-e9d8e9a07203" ulx="118" uly="1386" lrx="1002" lry="1420" /><zone xml:id="m-5ab3f989-d0b8-475a-bea0-607a7efd8316" ulx="132" uly="1422" lrx="1004" lry="1458" /><zone xml:id="m-ac267681-eaa6-4275-921a-a7ba5fc13893" ulx="116" uly="1451" lrx="1003" lry="1492" /><zone xml:id="m-f8c113b6-07c4-427d-be89-e20e5f2e9685" ulx="563" uly="1481" lrx="1003" lry="1516" /><zone xml:id="m-e85050cb-4e5c-4680-b0e9-da1df603b134" ulx="117" uly="1482" lrx="552" lry="1519" /><zone xml:id="m-d188ca80-61fd-45fc-9130-729780072785" ulx="116" uly="1509" lrx="553" lry="1543" /><zone xml:id="m-24d43e53-741c-4bc5-8c25-5fba613043b6" ulx="563" uly="1510" lrx="1004" lry="1541" /><zone xml:id="m-cb949e60-0b20-4cfc-a283-fd745f4f403a" ulx="116" uly="1537" lrx="1002" lry="1575" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-921c6e43-9bcf-466b-ad6d-56e15275c76c" n="0600" facs="#m-f8c74aad-77a3-4aed-9834-879f801c9297" /><div xml:id="m-a760ba78-1300-4385-8141-3e855bdef433">
            <lg xml:id="m-8af858bc-0fde-47e9-9520-d86d60af2f41">
              <l xml:id="m-ab7e24ee-6a6f-435f-b574-94980c1824a6" facs="#m-894dbba4-51ab-4303-9419-4a008ef41ab8" label="ambiguous">454</l><l xml:id="m-2c10abb0-4c8f-4314-8d28-351b454d4e8d" facs="#m-e5dd6740-2a9a-447e-958f-12e72b95243b" label="text-like">Eve of the Epiphany.</l><l xml:id="m-5aaf6a7a-6570-4b54-9cea-708ab38209b1" facs="#m-5aec78ce-c324-4b7a-ad4a-86d82d2726da" label="text-like">T When the Feast of the Holy Name of Jesus is celebrated on Jan. Sth,</l><l xml:id="m-d725a539-6986-4561-b567-8cf355f01197" facs="#m-85c5bba1-ebe0-415f-b085-f5c1f8057b82" label="lyrics-like">Vespers are said or thé Eniphany mith commemoration of the Holy Name.</l><l xml:id="m-8a3b95fb-cc45-4263-8928-3ab12ad52318" facs="#m-3af24b58-f92f-433c-86f4-96398865534b" label="text-like">Wherever the Octave of St. Stephen is of Double Major rite, a comme¬</l><l xml:id="m-2389b43b-be70-460d-a185-ee0a213abb66" facs="#m-e2ddc758-7c92-461d-bc8a-24ec9a051721" label="text-like">moration is made on Jan. and as follows:</l><l xml:id="m-b225568a-bc60-4bb0-a62b-dfcaddd0ccec" facs="#m-007be4d0-9535-4ab7-bc8f-a37abf3c1d22" label="lyrics-like">Ant. Sepeliérunt Stéphanum. p. 420. V. Stéphanus vídit.</l><l xml:id="m-f7edebf8-3ad6-42df-a6c5-dfd8ee5e016f" facs="#m-928e9a83-77ca-451a-8785-7d7d6267e5b7" label="text-like">Prayer.</l><l xml:id="m-994c3615-8e9c-4c9d-b5a2-c34536756edc" facs="#m-a29f466b-6fc8-4304-8dae-4aa7dc33efdf" label="lyrics-like">Mnípotens sempitérne Deus, qui étiam persecutóribus exorávit Dó¬</l><l xml:id="m-49d8a263-8bd7-4fd0-8818-300287e99080" facs="#m-c472ffa2-e53a-43e2-9ad8-ce475e7b7eb6" label="lyrics-like">U primitias Mártyrum in beáti Le¬num nostrum Jesum Christum</l><l xml:id="m-a53e249b-d4f7-43f3-991b-4e7d721c71e6" facs="#m-96edd615-4991-4beb-aad6-b6e502e1be59" label="ambiguous">Filium tuum. Qui tecum vivit et re¬</l><l xml:id="m-878662c1-825a-46ba-80d2-9f95c4321d82" facs="#m-bbf72667-a0a7-4996-b774-7c31c9014568" label="lyrics-like">vitae Stéphani sánguine dedicásti:t</l><l xml:id="m-6af89526-7e08-4b05-9c13-c825bbba62c4" facs="#m-e66223bf-d5c9-4af9-aff4-7f5cd457b0b3" label="lyrics-like">gnat in unitátẽ.</l><l xml:id="m-1b6ee02b-c7c5-42eb-9d45-c2f97fb92b2e" facs="#m-2e737b4f-94a8-4b73-a7ad-c43b4e87db23" label="lyrics-like">tribue, quaésumus; ut pro nobis in¬</l><l xml:id="m-39614776-beb7-44af-9fec-5c7af655286b" facs="#m-7b0efe26-a19b-4daa-9aa5-30e2dc12dfba" label="lyrics-like">tercéssor exsístat, *qui pro suis</l><l xml:id="m-2afc7c09-55ce-41b2-b369-3ceb6aae853b" facs="#m-9471d74e-5db9-43c9-ae55-aa393ff0e22c" label="ambiguous">JANUARY. 5.</l><l xml:id="m-286a1f36-1764-44e9-86fb-57a113739a21" facs="#m-faee7394-9981-455e-8e03-edfe6e4ee810" label="text-like">Eve of the Epiphany.</l><l xml:id="m-f34141c8-25a4-450d-837f-048b572fc161" facs="#m-f1685a89-5e2e-4ef9-83fe-790ddbc651ec" label="ambiguous">HClass. Semi-double.</l><l xml:id="m-89195818-4edf-48b7-8440-34fca4149afd" facs="#m-5551c0ce-fd85-4f62-a940-406a44bcaf24" label="text-like">This Vigil has all the privileges of a Sunday.</l><l xml:id="m-127c3cf0-24df-4190-8c3d-3d107379f4f4" facs="#m-803850a8-c516-4402-98a9-87f661bc1373" label="text-like">AT FIRST VESPERS.</l><l xml:id="m-2b7d7910-fdd8-41d9-aa89-217d7a68c558" facs="#m-b052fc9f-f200-4fae-aefb-54b2559b4bdd" label="text-like">Antiphons and Psalms of Second Vespers of the Circumcision, p. 442.</l><l xml:id="m-d02631ea-c7d7-4c3d-8d45-509a2cf5b82b" facs="#m-1681f651-0748-44a2-ba4e-4336f4ffea1f" label="lyrics-like">Chapter. Fratres: Quanto témpore. p. 437.</l><l xml:id="m-dcb0cf30-919b-4fbb-adc9-9a31a5b327e5" facs="#m-d62f0f48-b6bf-4e18-9689-4c36f8250485" label="lyrics-like">Hymn. Jésu Redémptor ómnium. D. 365.</l><l xml:id="m-c473be0f-1801-43b0-87bf-517f46bb28b9" facs="#m-85b292c1-cf31-4d02-bfc7-8f2b359d7105" label="lyrics-like">v. Nótum fécit Dóminus, allelúia. B. Salutáre súum, alleluia.</l><l xml:id="m-11b48380-2d1f-41e9-8592-de364c88c928" facs="#m-c877e7e9-b086-4db0-8e57-838171907ca4" label="lyrics-like">At Magn. Ant. Púer Jésus, p. 437.</l><l xml:id="m-f0117129-0e6e-4f40-be57-d204baa1edba" facs="#m-8fa4ab8d-cc39-498b-bf59-566b683f0ab3" label="lyrics-like">Prayer. Omnípotens sempitérne Deus. p. 434.</l><l xml:id="m-6a69d790-c871-4d88-96be-569a0c5b381c" facs="#m-f977ef21-8b28-4c3b-a7d8-982383b92fe0" label="lyrics-like">Commemoration of St. Telesphorus, Pope and Martyr. Ant. Iste sánctus.</l><l xml:id="m-576925ff-f507-4ece-9bd0-c05e5bc898f9" facs="#m-7d4a0ae8-f240-4256-896a-0e81225306ac" label="lyrics-like">Y. Giória et honóre. 5. 262.</l><l xml:id="m-89fc422c-5a18-4de5-8182-58e7e374d69c" facs="#m-871988d5-745d-4d1a-86bf-f995948f759d" label="text-like">Prayer.</l><l xml:id="m-1be05e8f-83db-4297-8b08-9c636a0b6d9f" facs="#m-030be7e9-6ba5-47f9-becc-3f8a77d26542" label="lyrics-like">yRegem tuum, Pastor aetérne, pétua protectióne custódi; * quem</l><l xml:id="m-4fcf26d9-c6b6-4856-a89f-78b16b4d8e24" facs="#m-182bc7fc-8470-4456-a915-25e3641a3713" label="lyrics-like">U placátus inténde : t et per beã-ltotius Ecclésiae praestitisti esse</l><l xml:id="m-e8e15e73-bc71-492a-aeb5-40bea432bfd3" facs="#m-8f92d97f-e67f-48c3-822b-8fb293290268" label="lyrics-like">tum Telésphorum Mártyrem tuum l pastórem. Per Dóminum.</l><l xml:id="m-95a28c4c-f36e-4947-b444-eac5b227906c" facs="#m-6a15f166-d379-437a-af2c-8087c24ac676" label="ambiguous">atque Summum Pontificem, per¬</l><l xml:id="m-eddb37e5-17f2-4a12-8e70-aeb20028eb47" facs="#m-1eb8a9de-3f08-4ee5-812e-8dc72a534770" label="text-like">At Compline, the Psalms of Sunday are said. The Preces are omitted.</l><l xml:id="m-34f8dbb7-36a0-4eec-8457-d9373d906a9e" facs="#m-5be66fc0-3cb2-4509-9a6f-d3ca75286e32" label="text-like">At the Little Hours, Antiphons ofthe Circumcision, p. 442; the remainder</l><l xml:id="m-fae7f21c-559d-44c7-a5e0-e3b8025ff225" facs="#m-907e9fbc-74e8-4379-80ee-e8d4d411f829" label="text-like">from the Sunday within the Octave of the Nativity, p. 483 and p. 436.</l><l xml:id="m-f8b0c4da-0204-45ec-b07b-3f61a09d94ce" facs="#m-a32b9c0d-80ba-4855-94fe-8b246910fae6" label="text-like">Mass of the Sunday within the Octave of the Nativity. p. 483, except for</l><l xml:id="m-27ef831c-0ce1-442c-8300-f8db6724a747" facs="#m-17ba05dd-a71c-4ae3-a5fa-d0f12d54c657" label="text-like">the followine:</l><l xml:id="m-9f49de90-39af-40b4-b0ed-164c9fe4b523" facs="#m-c9146bfa-dcdc-4cbd-a0f6-9a2f3fb72110" label="text-like">Second Collect of St. Telesphorus, Pope and Martyr. Gregem, as above.</l><l xml:id="m-060289dc-4ca3-4ebf-bb40-483a041c119f" facs="#m-59d9bf45-abff-44ab-a222-b8dc2371da5e" label="lyrics-like">Third Collect of Our Lady. Deus, qui salútis. p. 441.</l><l xml:id="m-d2e49e27-e39a-45b4-9e27-8690278698d0" facs="#m-a508bdd6-3e18-4aad-bca9-e9d8e9a07203" label="ambiguous">† Sequentia sancti Evangelii secundum Matthaeum. Matth. 2.</l><l xml:id="m-774a1e26-d1a8-4575-87bb-9e2e9086563d" facs="#m-5ab3f989-d0b8-475a-bea0-607a7efd8316" label="lyrics-like">TN illo témpore: Defúncto He-] Israel: defúncti sunt enim, qui quae¬</l><l xml:id="m-9f1ffd44-9cc1-461d-9799-c148cde1f4a0" facs="#m-ac267681-eaa6-4275-921a-a7ba5fc13893" label="lyrics-like">I róde, ecce Angelus Dómini ap- rébant ánimam púeri. Qui consúr¬</l><l xml:id="m-6058d6a0-657e-4bc5-9f72-d24f32317947" facs="#m-f8c113b6-07c4-427d-be89-e20e5f2e9685" label="lyrics-like">gens, accépit púerum, et matrem</l><l xml:id="m-87f58663-109f-4484-bc62-24e71570626d" facs="#m-e85050cb-4e5c-4680-b0e9-da1df603b134" label="lyrics-like">páruit in somnis Joseph in Aegypto,</l><l xml:id="m-8e340d5b-fbb8-4955-bb3a-9fc689c45bc3" facs="#m-d188ca80-61fd-45fc-9130-729780072785" label="lyrics-like">dicens: Surge, et áccipe púerum,</l><l xml:id="m-930fcff4-0ae9-47e4-87e6-aac50a821ddc" facs="#m-24d43e53-741c-4bc5-8c25-5fba613043b6" label="ambiguous">ejus, et venit in terram Israel. Au¬</l><l xml:id="m-561c7ccf-9a91-4d14-abe7-6d6310ff16af" facs="#m-cb949e60-0b20-4cfc-a283-fd745f4f403a" label="lyrics-like">et matrem ejus, et vade in terram! diens autem quod Archeláus regná¬</l></lg></div></section></score></mdiv></body></music>
</mei>