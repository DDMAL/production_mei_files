      <graphic xml:id="m-8fb6f098-5829-46ed-a460-6cc9bf349904" target="0121_original_image.tiff" /><zone xml:id="m-c89afa82-6657-4cb3-b080-e53c7663831f" ulx="415" uly="91" lrx="652" lry="125" /><zone xml:id="m-8dc23537-c9ab-405f-82a3-641f1ae2e2ac" ulx="917" uly="97" lrx="975" lry="148" /><zone xml:id="m-d7c00097-0cce-4b36-bba9-c5d3a612550d" ulx="138" uly="188" lrx="928" lry="235" /><zone xml:id="m-5064df20-393a-426a-9026-48f672ce5cef" ulx="387" uly="264" lrx="680" lry="306" /><zone xml:id="m-e5b12508-67e3-47f1-93ee-294c9a3fd9d8" ulx="117" uly="322" lrx="974" lry="363" /><zone xml:id="m-f1d86766-dd7d-4cba-b83c-0a2b793c8569" ulx="86" uly="352" lrx="974" lry="388" /><zone xml:id="m-d6d41685-6828-4270-9299-75a3207c94db" ulx="88" uly="380" lrx="973" lry="419" /><zone xml:id="m-48369515-beb9-414d-bfee-6cf37bdf95b5" ulx="87" uly="410" lrx="967" lry="449" /><zone xml:id="m-9037d794-b26b-4f66-b366-a8c69faded55" ulx="534" uly="437" lrx="971" lry="475" /><zone xml:id="m-6db142b0-3cfb-4153-8168-e8c9728e06aa" ulx="85" uly="443" lrx="524" lry="476" /><zone xml:id="m-93ea2994-1a2b-477a-af69-51b0d0fe2659" ulx="84" uly="467" lrx="523" lry="500" /><zone xml:id="m-57171460-38e1-4187-a274-5366ca5db07f" ulx="531" uly="471" lrx="972" lry="500" /><zone xml:id="m-4d229aba-374c-455d-bdd4-ad62b617ba90" ulx="84" uly="493" lrx="523" lry="532" /><zone xml:id="m-b5b6b1c0-3233-422b-b6b5-acf543a7c8c6" ulx="527" uly="493" lrx="971" lry="532" /><zone xml:id="m-7f91b57d-b774-4dd0-aa93-00b559e8a1c1" ulx="84" uly="525" lrx="969" lry="553" /><zone xml:id="m-24b11622-a109-4b21-9a71-d89c125037a9" ulx="84" uly="548" lrx="926" lry="586" /><zone xml:id="m-5bf7f1d1-8665-4786-88ae-035efff70c93" ulx="85" uly="576" lrx="695" lry="613" /><zone xml:id="m-abd1cbce-b11a-405c-b7ae-5d6e8f9a9ee5" ulx="267" uly="641" lrx="786" lry="682" /><zone xml:id="m-c925dae0-74ac-451e-a9b2-f05d80d84792" ulx="190" uly="695" lrx="862" lry="734" /><zone xml:id="m-f010c27f-e7eb-444d-8ac0-de14724bac3e" ulx="113" uly="742" lrx="969" lry="781" /><zone xml:id="m-75746cc3-7b6b-4c3c-b609-4fc2028c5645" ulx="85" uly="776" lrx="970" lry="807" /><zone xml:id="m-23e8231f-9008-4127-a02d-8f34182943c3" ulx="84" uly="799" lrx="970" lry="833" /><zone xml:id="m-692f7e8d-c082-4f94-a9e2-80f78fac07d4" ulx="85" uly="828" lrx="524" lry="864" /><zone xml:id="m-6ca9c571-7a59-4160-bf8f-015e02cade80" ulx="531" uly="829" lrx="970" lry="864" /><zone xml:id="m-e9db5ed5-b1f3-4883-b316-5e81fdb864a1" ulx="86" uly="853" lrx="522" lry="891" /><zone xml:id="m-622cf87b-90c6-4ddb-9ca1-ea18cabbd461" ulx="532" uly="858" lrx="969" lry="893" /><zone xml:id="m-91a87a2d-e61c-460e-aa4b-eb7f8d21bf97" ulx="85" uly="883" lrx="520" lry="917" /><zone xml:id="m-90ace10e-2f51-439e-a561-2aed3b477bb5" ulx="533" uly="884" lrx="969" lry="922" /><zone xml:id="m-6e6f78ce-26a3-4aee-b7cc-0e039c81ac88" ulx="85" uly="909" lrx="523" lry="948" /><zone xml:id="m-86e9b1b3-12d9-43d6-b103-4657eaaaed01" ulx="532" uly="911" lrx="653" lry="948" /><zone xml:id="m-29335ec5-91fa-4653-8195-5150be675403" ulx="85" uly="940" lrx="523" lry="977" /><zone xml:id="m-d95cfbd0-432f-4347-a8a1-f9da3ee4a539" ulx="233" uly="999" lrx="822" lry="1047" /><zone xml:id="m-27d8ba61-1553-440c-bb45-6a6f0a3ff0ee" ulx="112" uly="1057" lrx="970" lry="1098" /><zone xml:id="m-07ee24ac-df31-487e-b0ee-a279cefec039" ulx="84" uly="1088" lrx="969" lry="1127" /><zone xml:id="m-e0796e92-700b-484d-b838-a18a70a4e3f7" ulx="84" uly="1115" lrx="521" lry="1154" /><zone xml:id="m-3959039f-ccd8-4441-800b-317df341d939" ulx="528" uly="1115" lrx="966" lry="1155" /><zone xml:id="m-eda3ed64-1548-40df-9bba-578883330de0" ulx="535" uly="1141" lrx="964" lry="1183" /><zone xml:id="m-64a99cb8-8c8f-4cb9-b408-7df7f91fc646" ulx="84" uly="1143" lrx="519" lry="1179" /><zone xml:id="m-9c150705-9d60-4adb-9ae3-8512d920e94a" ulx="83" uly="1171" lrx="521" lry="1203" /><zone xml:id="m-c64bd02a-ffca-49a7-bc9b-b82dde3af72b" ulx="529" uly="1172" lrx="968" lry="1210" /><zone xml:id="m-56039ad1-96b7-458c-86a8-93055201b827" ulx="82" uly="1198" lrx="519" lry="1236" /><zone xml:id="m-3e788739-e39f-4758-9fff-4f75b95d275e" ulx="527" uly="1199" lrx="966" lry="1238" /><zone xml:id="m-471bb77d-4051-4762-b910-bbbc983fe83e" ulx="528" uly="1226" lrx="968" lry="1266" /><zone xml:id="m-0671bde0-8954-4a58-8f9d-4c2781eeae71" ulx="83" uly="1228" lrx="521" lry="1261" /><zone xml:id="m-940ca60c-71ec-4de9-847f-fe4b93bdb9de" ulx="84" uly="1252" lrx="524" lry="1292" /><zone xml:id="m-3ab2f252-3fd6-43af-ba66-ea7f7c35b1b2" ulx="534" uly="1256" lrx="970" lry="1288" /><zone xml:id="m-fb468353-5ff6-4a8e-bd72-3a0acbf2bd25" ulx="537" uly="1279" lrx="975" lry="1315" /><zone xml:id="m-51ee3627-0a42-45ab-91a7-60a734dcc2c5" ulx="86" uly="1281" lrx="523" lry="1319" /><zone xml:id="m-9388b377-92fc-4804-8654-4262453b00b6" ulx="535" uly="1310" lrx="975" lry="1345" /><zone xml:id="m-c58aaf03-0d36-4bfd-831b-125bed4b6414" ulx="86" uly="1312" lrx="524" lry="1348" /><zone xml:id="m-c5e44e67-7d45-4c5a-b021-289225827141" ulx="536" uly="1336" lrx="976" lry="1373" /><zone xml:id="m-f6068ff0-7bc5-49cd-bcb3-257b54777378" ulx="87" uly="1338" lrx="524" lry="1376" /><zone xml:id="m-461e3d44-b152-4423-83ed-cfdccc7129ac" ulx="86" uly="1365" lrx="524" lry="1404" /><zone xml:id="m-edd9939f-f849-4b4e-9f8c-f69dae1e8081" ulx="533" uly="1365" lrx="975" lry="1398" /><zone xml:id="m-4ca206f8-bdd8-4cfe-b751-c7991889490e" ulx="86" uly="1391" lrx="945" lry="1434" /><zone xml:id="m-5dcb193a-4ae3-478d-a1f2-f984a0af46bd" ulx="91" uly="1455" lrx="965" lry="1504" /><zone xml:id="m-10e0c87f-d57e-4d3b-b713-7664f97bcdc9" ulx="115" uly="1514" lrx="974" lry="1553" /><zone xml:id="m-2c459b2f-e9cd-46e9-806a-1cfb2f2c9cdb" ulx="535" uly="1543" lrx="974" lry="1581" /><zone xml:id="m-06693de1-5108-49f4-ad10-77acefb00b0a" ulx="86" uly="1545" lrx="524" lry="1585" /><zone xml:id="m-680a613e-47e9-4bb7-b37c-a364e90ef6cf" ulx="88" uly="1570" lrx="974" lry="1612" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-7042fcf0-1fd4-4b6f-98aa-76b15c4e7e60" n="0121" facs="#m-4663f572-19b5-44d2-b68e-1901418028b6" /><div xml:id="m-fb69ebd8-69f9-4082-bb35-8afc226861ee">
            <lg xml:id="m-405bfad9-414c-42f6-adf9-42821f4d8a47">
              <l xml:id="m-40fd2da3-6263-478b-8853-18637e3082a9" facs="#m-c89afa82-6657-4cb3-b080-e53c7663831f" label="ambiguous">Proper Prefaces.</l><l xml:id="m-ce6d537e-5ffc-435d-92ff-9f6058f1482e" facs="#m-8dc23537-c9ab-405f-82a3-641f1ae2e2ac" label="ambiguous">10¬</l><l xml:id="m-7d11eb7b-e35d-44da-8467-b085fb2ce5c3" facs="#m-d7c00097-0cce-4b36-bba9-c5d3a612550d" label="text-like">PROPER PREFACES FOR CERTAIN DIOCESES.</l><l xml:id="m-a8a258ed-1c38-4d4b-b9a5-87f42007f9f3" facs="#m-5064df20-393a-426a-9026-48f672ce5cef" label="text-like">Preface of Advent.</l><l xml:id="m-ac3bfada-6cd9-466b-98f3-15d628277c90" facs="#m-e5b12508-67e3-47f1-93ee-294c9a3fd9d8" label="lyrics-like">Vere dignum et justum est, Dum ergo prope est ut véniat quem</l><l xml:id="m-95fbfb6b-0703-459b-90ec-e32d9b5026fa" facs="#m-f1d86766-dd7d-4cba-b83c-0a2b793c8569" label="lyrics-like">aequum et salutáre, nos tibi semper l missúrus es, et dies affúlget libera¬</l><l xml:id="m-aaa8a49a-ca5b-4d8c-a383-222d3daadeb2" facs="#m-d6d41685-6828-4270-9299-75a3207c94db" label="lyrics-like">et ubique grátias ágere, Dómine! tiónis nostrae, in hac promissiónum</l><l xml:id="m-a2c67fb4-f463-48fd-a245-174e79eec1ed" facs="#m-48369515-beb9-414d-bfee-6cf37bdf95b5" label="lyrics-like">sancte, Pater omnípotens, aetérne tuárum fide piis gáudiis exsultámus.</l><l xml:id="m-b4948af8-dff1-448a-938b-c010085c2f4d" facs="#m-9037d794-b26b-4f66-b366-a8c69faded55" label="lyrics-like">*Et ideo cum Angelis et Archán¬</l><l xml:id="m-ce0d624d-e15f-472f-a6e0-e51cf56a6973" facs="#m-6db142b0-3cfb-4153-8168-e8c9728e06aa" label="lyrics-like">Deus, per Christum Dóminum no¬</l><l xml:id="m-d0924d67-252c-430f-a18c-1e3f0461921c" facs="#m-93ea2994-1a2b-477a-af69-51b0d0fe2659" label="lyrics-like">strum; quem pérdito hóminum</l><l xml:id="m-90c21c21-8b48-4a9a-b1bc-d3ecfc8d071d" facs="#m-57171460-38e1-4187-a274-5366ca5db07f" label="lyrics-like">gelis, cum Thronis et Dominatiónis</l><l xml:id="m-5fc4d8f1-aa3a-4d75-9339-7187a2de0091" facs="#m-4d229aba-374c-455d-bdd4-ad62b617ba90" label="lyrics-like">géneri Salvatórem miséricors et</l><l xml:id="m-b2f265b5-46e5-46bd-966b-e3be9faf048a" facs="#m-b5b6b1c0-3233-422b-b6b5-acf543a7c8c6" label="lyrics-like">bus, cumque omni militia caeléstie</l><l xml:id="m-b34b4966-816f-49ab-a9db-7ddcedbf2390" facs="#m-7f91b57d-b774-4dd0-aa93-00b559e8a1c1" label="lyrics-like">fidélis promisísti, cujus véritas in-lexércitus, hymnum glóriae tua:</l><l xml:id="m-75f22ac9-86e5-4f43-b6c3-e8297aa3503d" facs="#m-24b11622-a109-4b21-9a71-d89c125037a9" label="lyrics-like">strúeret inscios, sánctitas justificáret lcánimus, sine fne dicéntes</l><l xml:id="m-73c70a90-060e-49fe-a788-7475a452d472" facs="#m-5bf7f1d1-8665-4786-88ae-035efff70c93" label="lyrics-like">impios, virtus adjuváret infirmos. (Sanctus, etc.</l><l xml:id="m-2d937691-0972-4f4a-a01e-90238301d77b" facs="#m-abd1cbce-b11a-405c-b7ae-5d6e8f9a9ee5" label="text-like">Preface of the Blessed Sacrament.</l><l xml:id="m-94f30ee1-ef34-4265-946d-30c1255633b5" facs="#m-c925dae0-74ac-451e-a9b2-f05d80d84792" label="ambiguous">(Maundy Thursday — Corpus Christi — Votive Masses).</l><l xml:id="m-7f154f9e-6862-47db-9eae-4487d66f56c2" facs="#m-f010c27f-e7eb-444d-8ac0-de14724bac3e" label="lyrics-like">Vere dignum et justum est, formam sacrificii perénnis instí¬</l><l xml:id="m-2d8549df-aeb1-42a5-bb7c-a6ec01483070" facs="#m-75746cc3-7b6b-4c3c-b609-4fc2028c5645" label="lyrics-like">aequum et salutáre, nos tibi semper! tuens, hóstiam se tibi primum óbtu¬</l><l xml:id="m-21f8e7d0-ea4f-4636-83bb-42cb93c88f62" facs="#m-23e8231f-9008-4127-a02d-8f34182943c3" label="lyrics-like">et ubique grátias ágere, Dómine lit, et primus dócuit offérri : cuius</l><l xml:id="m-0d01330e-441e-4507-914b-e3bb927c5cdd" facs="#m-692f7e8d-c082-4f94-a9e2-80f78fac07d4" label="lyrics-like">sancte, Pater omnípõtens, aetérne</l><l xml:id="m-3f11a7c7-809b-4cd0-8ea7-cf6a0408be52" facs="#m-6ca9c571-7a59-4160-bf8f-015e02cade80" label="lyrics-like">carne pro nobis immoláta dum</l><l xml:id="m-a64a0bdb-cf11-4c88-9920-a43f9fc659f1" facs="#m-e9db5ed5-b1f3-4883-b316-5e81fdb864a1" label="lyrics-like">Deus, per Christum Dóminum no¬</l><l xml:id="m-fb0e7aeb-a2cd-4751-9efa-4c2189acea69" facs="#m-622cf87b-90c6-4ddb-9ca1-ea18cabbd461" label="lyrics-like">páscimur, roborámur, et fuso sán¬</l><l xml:id="m-c71e95ce-97a6-49c0-9b26-a54095d2f614" facs="#m-91a87a2d-e61c-460e-aa4b-eb7f8d21bf97" label="lyrics-like">strum, verum aeternúmque Ponti¬</l><l xml:id="m-f5f59570-65d0-4705-97fb-6e2c1ae7bb1e" facs="#m-90ace10e-2f51-439e-a561-2aed3b477bb5" label="lyrics-like">guine dum potámur, ablúimur.* Et</l><l xml:id="m-48cb9c9a-b7fa-4c50-a0a8-d33585807494" facs="#m-6e6f78ce-26a3-4aee-b7cc-0e039c81ac88" label="lyrics-like">ficem, et solum sine peccáti mácula</l><l xml:id="m-27b7cbef-e8e0-447d-9592-bfab4518b2a9" facs="#m-86e9b1b3-12d9-43d6-b103-4657eaaaed01" label="ambiguous">ideo, etc.</l><l xml:id="m-3b23b1a5-f8b8-4ae9-ba8f-8afe46be7845" facs="#m-29335ec5-91fa-4653-8195-5150be675403" label="lyrics-like">sacerdótem : qui in novíssima coena</l><l xml:id="m-6e234855-9b83-43c8-9b45-2824d8567eea" facs="#m-d95cfbd0-432f-4347-a8a1-f9da3ee4a539" label="text-like">Preface of the Dedication of Churches.</l><l xml:id="m-a51737fd-e108-4e05-90f3-639d14089982" facs="#m-27d8ba61-1553-440c-bb45-6a6f0a3ff0ee" label="lyrics-like">Vere dignum et justum est, ctuárium aetérnae caritátis. Haec</l><l xml:id="m-44b72c5e-1b05-467a-885d-5f13a04e88af" facs="#m-07ee24ac-df31-487e-b0ee-a279cefec039" label="lyrics-like">aequum et salutáre, nos tibi sem-lest arca quae nos a mundi eréptos</l><l xml:id="m-a68a3491-bd64-4d22-82f2-3facabda040e" facs="#m-e0796e92-700b-484d-b838-a18a70a4e3f7" label="lyrics-like">per et ubique grátias ágere, Dó¬</l><l xml:id="m-95b0ada0-f5fe-4042-aafc-4776eb246844" facs="#m-3959039f-ccd8-4441-800b-317df341d939" label="lyrics-like">diluvio, in portum salútis indúcit.</l><l xml:id="m-3822997d-10e3-42aa-9734-7780abb785a1" facs="#m-eda3ed64-1548-40df-9bba-578883330de0" label="lyrics-like">Haec est dilécta et única sponsa,</l><l xml:id="m-83090252-2f55-4f6c-aaa1-8ef845b6cab0" facs="#m-64a99cb8-8c8f-4cb9-b408-7df7f91fc646" label="lyrics-like">mine sancte, Pater omnípotens,</l><l xml:id="m-402ea55a-39f2-40ed-94e9-3cbb06441e51" facs="#m-9c150705-9d60-4adb-9ae3-8512d920e94a" label="lyrics-like">aetérne Deus; qui hanc oratiónis</l><l xml:id="m-fdd30f59-eb08-40f5-8347-5f2988f9e594" facs="#m-c64bd02a-ffca-49a7-bc9b-b82dde3af72b" label="lyrics-like">quam acquisivit Christus sánguine</l><l xml:id="m-fbac6f79-44b3-40eb-b9fd-c917eb37174e" facs="#m-56039ad1-96b7-458c-86a8-93055201b827" label="lyrics-like">domum quam aedificávimus, bo¬</l><l xml:id="m-6aa408f5-fd2b-47d0-b53f-765411bb00d5" facs="#m-3e788739-e39f-4758-9fff-4f75b95d275e" label="lyrics-like">suo, quam vivíficat spiritu suo</l><l xml:id="m-ce0c846e-94ab-46ed-ba06-84ad060290cb" facs="#m-471bb77d-4051-4762-b910-bbbc983fe83e" label="lyrics-like">cujus in sinu, renáti per gratiam</l><l xml:id="m-b7598257-7999-4648-a420-b0ebcf7fc8fc" facs="#m-0671bde0-8954-4a58-8f9d-4c2781eeae71" label="lyrics-like">nórum óminium largítor inhábitas:</l><l xml:id="m-77670b1f-25cb-4354-b681-77bcfc8bf98b" facs="#m-940ca60c-71ec-4de9-847f-fe4b93bdb9de" label="lyrics-like">et Ecclesiam, quam ipse fundasú,</l><l xml:id="m-d04a9f0a-c0fc-454f-a1f6-28d445503122" facs="#m-3ab2f252-3fd6-43af-ba66-ea7f7c35b1b2" label="lyrics-like">tuam, lacte verbi páscimur, pane</l><l xml:id="m-c746ba92-e023-4779-90f1-3e2344dab5be" facs="#m-fb468353-5ff6-4a8e-bd72-3a0acbf2bd25" label="lyrics-like">vitae roborámur, misericórdiae tuae</l><l xml:id="m-e1df7b20-f63a-41c1-b41d-1a31c5253b4a" facs="#m-51ee3627-0a42-45ab-91a7-60a734dcc2c5" label="lyrics-like">incessábili operatióne sanctíficas.</l><l xml:id="m-4b2b5a9c-274f-4bf3-9d7c-6bc16df833de" facs="#m-9388b377-92fc-4804-8654-4262453b00b6" label="lyrics-like">subsidiis confovémus. Haec fidéliter</l><l xml:id="m-b8189544-21d6-4d4a-af25-f45d6062e718" facs="#m-c58aaf03-0d36-4bfd-831b-125bed4b6414" label="lyrics-like">Haec est enim vere domus oratió¬</l><l xml:id="m-6d9afe26-77a7-4c97-b7b8-4338142ae5d2" facs="#m-c5e44e67-7d45-4c5a-b021-289225827141" label="lyrics-like">in terris, sponso adjuvánte, militat;</l><l xml:id="m-1b5fe8f6-de11-4d02-9f46-093cc35b82ff" facs="#m-f6068ff0-7bc5-49cd-bcb3-257b54777378" label="lyrics-like">nis, visibilibus aedificiis adumbráta:</l><l xml:id="m-b4fc3b50-2f98-4083-9685-12c6f216f275" facs="#m-461e3d44-b152-4423-83ed-cfdccc7129ac" label="lyrics-like">templum habitatiónis glóriae tuae,</l><l xml:id="m-fc92ec78-f203-45e8-89c2-6d2b8d55f052" facs="#m-edd9939f-f849-4b4e-9f8c-f69dae1e8081" label="lyrics-like">et perénniter in caelis, ipso corc¬</l><l xml:id="m-a3de23d7-1d17-47e3-ae4b-2cc0c729ba76" facs="#m-4ca206f8-bdd8-4cfe-b751-c7991889490e" label="lyrics-like">sedes incommutábilis veritátis, san-Inánte, triúmphat. « Et ideo, etc.</l><l xml:id="m-5b16167f-3f25-4957-b739-f691c3bfe3ae" facs="#m-5dcb193a-4ae3-478d-a1f2-f984a0af46bd" label="text-like">Preface of the Feasts of all Saints and of Patron Saints.</l><l xml:id="m-8bf2727f-3290-4d3c-ad78-1b0d3d24c376" facs="#m-10e0c87f-d57e-4d3b-b713-7664f97bcdc9" label="lyrics-like">Vere dignum et justum est, sancte, Pater omnípotens, aetérne</l><l xml:id="m-6dc8ae2c-644a-4de3-912e-afe78ed1f0d7" facs="#m-2c459b2f-e9cd-46e9-806a-1cfb2f2c9cdb" label="lyrics-like">Deus, qui glorificáris in concilio</l><l xml:id="m-3ea67c2a-a191-4a26-a21b-7bae36e22557" facs="#m-06693de1-5108-49f4-ad10-77acefb00b0a" label="lyrics-like">aequum et salutáre, nos tibi semper</l><l xml:id="m-2dcc4b86-9a44-4c31-bbee-fef69eaea8e1" facs="#m-680a613e-47e9-4bb7-b37c-a364e90ef6cf" label="lyrics-like">et ubique grátias ágere. Dómine sanctórum, et eórum coronándo</l></lg></div></section></score></mdiv></body></music>
</mei>