                  <nc xml:id="m-b603f07a-c4e8-4c9e-bbf6-7bc9d409f606" pname="a" oct="3" /></neume></syllable><syllable xml:id="m-fcc27642-6ed1-45a3-b659-d138d491b606">
                <syl /><neume facs="#m-f0096867-0c22-47b4-8820-5e11b4ce7b90" type="punctum" xml:id="m-476da6a4-5b1c-43ef-b094-fcec2f669090">
                  <nc xml:id="m-a74b1633-e267-480d-aeda-b487b67d91f8" pname="b" oct="3" /></neume></syllable><syllable xml:id="m-42a12a62-12a4-4316-a2a8-3ca6854cf972">
                <syl /><neume facs="#m-7cca5359-94bf-48e3-a27d-27058b34666a" type="punctum" xml:id="m-21623780-eb9c-4db6-b40d-5d9789d2e1d3">
