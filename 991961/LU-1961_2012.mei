  <music>
  <facsimile xml:id="m-10e2c4d8-2856-4e8b-8dd4-a7afc46d6d0b" type="transcription">
    <surface xml:id="m-80f68526-7e2b-42df-90b4-7133901f6e58" lrx="1161" lry="1843">
      <graphic xml:id="m-d84e4533-167c-42bf-be1f-2ebf3b1b9170" target="2012_original_image.tiff" /><zone xml:id="m-2f385a51-f214-4998-b50b-4deb308d9dc1" ulx="112" uly="92" lrx="195" lry="132" /><zone xml:id="m-613513e0-5b7a-4926-bec3-039e53da31fd" ulx="446" uly="98" lrx="759" lry="132" /><zone xml:id="m-87cb64fb-72c1-4f0a-94c6-5acf798820fe" ulx="139" uly="148" lrx="1092" lry="180" /><zone xml:id="m-17090ad8-f6ca-4fc8-a3da-1606042af6a0" ulx="110" uly="170" lrx="1091" lry="204" /><zone xml:id="m-dd84cdc1-67c1-43ae-affa-ee3ceef11ccd" ulx="109" uly="201" lrx="1091" lry="238" /><zone xml:id="m-864685f7-ff88-4d6a-8ec7-ceef8876ae80" ulx="111" uly="232" lrx="1089" lry="266" /><zone xml:id="m-f4a3df07-8b8b-47e2-aa74-6471562a6afc" ulx="111" uly="254" lrx="901" lry="292" /><zone xml:id="m-8f158114-61a6-49e8-aba5-8d123b7d8ce6" ulx="144" uly="288" lrx="1093" lry="330" /><zone xml:id="m-6bf730ff-c8ea-477b-9185-6488b162d304" ulx="112" uly="316" lrx="614" lry="356" /><zone xml:id="m-ff1d5e87-d88f-4154-9770-6ad0070d65f0" ulx="143" uly="349" lrx="568" lry="395" /><zone xml:id="m-705e5899-9d5b-4b47-84f4-bbf3583d953b" ulx="141" uly="384" lrx="558" lry="427" /><zone xml:id="m-bbf39938-f537-4a4c-9e3f-edaaadcf0fb0" ulx="140" uly="419" lrx="547" lry="460" /><zone xml:id="m-b8ed96db-d170-4595-94f8-43a46050d7b5" ulx="138" uly="457" lrx="1092" lry="500" /><zone xml:id="m-c7a24b53-c51f-4580-89a6-fea6446fd611" ulx="113" uly="491" lrx="1094" lry="528" /><zone xml:id="m-303070b4-f705-4767-8a47-d362bb4f3fd1" ulx="113" uly="521" lrx="934" lry="554" /><zone xml:id="m-3598cd49-7a16-4317-aee9-ced6a1c46e6f" ulx="143" uly="553" lrx="602" lry="594" /><zone xml:id="m-3a5ac453-97c4-4ad5-90e7-735dfb4da336" ulx="144" uly="587" lrx="1015" lry="630" /><zone xml:id="m-7bcb5e68-8253-4fff-a55d-d2e887d5e88b" ulx="144" uly="624" lrx="823" lry="668" /><zone xml:id="m-27edf97a-525e-4002-8491-50a3450c2d62" ulx="144" uly="660" lrx="610" lry="699" /><zone xml:id="m-8860a660-d7d9-430f-893a-689a8844dba3" ulx="145" uly="696" lrx="1092" lry="741" /><zone xml:id="m-01b31f4a-915f-407b-bbb2-afcf58e768d2" ulx="144" uly="731" lrx="776" lry="774" /><zone xml:id="m-897e45b7-2fd0-4009-beee-29db2a79aa94" ulx="543" uly="777" lrx="670" lry="818" /><zone xml:id="m-8ac43963-a6ed-4795-b705-70b207ec9b07" ulx="143" uly="811" lrx="1094" lry="855" /><zone xml:id="m-b1156260-ca92-4292-abe1-919d0c70e3b3" ulx="112" uly="844" lrx="598" lry="883" /><zone xml:id="m-ec7f659e-f66b-4632-bc12-5887979499d1" ulx="610" uly="847" lrx="1095" lry="886" /><zone xml:id="m-2b2a2606-d889-4178-b9b4-54b1576194e6" ulx="113" uly="877" lrx="597" lry="913" /><zone xml:id="m-6eb529cc-6623-4914-b714-ba48fc705c9d" ulx="611" uly="878" lrx="1096" lry="919" /><zone xml:id="m-0cfa014a-2edd-4ca3-9b5d-b28f7c8c0c0d" ulx="113" uly="909" lrx="595" lry="950" /><zone xml:id="m-45fde0fe-af50-4235-8c2d-aa87b4dc32ac" ulx="613" uly="909" lrx="1095" lry="950" /><zone xml:id="m-3c0db63e-bc97-4071-966b-ff79de6d099b" ulx="113" uly="937" lrx="795" lry="979" /><zone xml:id="m-9eb657de-5f4c-452f-9cde-cc6840d2b347" ulx="112" uly="967" lrx="598" lry="1007" /><zone xml:id="m-2ed4db77-f1b3-47b9-a426-a3108e244b8b" ulx="138" uly="1006" lrx="1095" lry="1051" /><zone xml:id="m-d17df618-eeb6-43e7-8344-1db177c8363f" ulx="112" uly="1042" lrx="319" lry="1077" /><zone xml:id="m-4306aa60-863f-40b3-8d24-34f84f6b787f" ulx="138" uly="1072" lrx="1095" lry="1107" /><zone xml:id="m-f7c834cd-5b72-4075-ae80-2bab6f667689" ulx="112" uly="1099" lrx="1093" lry="1140" /><zone xml:id="m-f9e04029-373e-471e-b0a2-c661298c65ca" ulx="112" uly="1124" lrx="218" lry="1163" /><zone xml:id="m-2d108fdd-9895-4f54-a9b4-3a7340c058c8" ulx="471" uly="1184" lrx="741" lry="1231" /><zone xml:id="m-743d51ee-206a-434b-a825-d06f0139fba5" ulx="138" uly="1248" lrx="1096" lry="1290" /><zone xml:id="m-debabf3b-c7b8-4379-9fd6-06e6c5165804" ulx="112" uly="1280" lrx="1096" lry="1317" /><zone xml:id="m-15bd721a-1e00-44d0-a9a0-4f0b662f5066" ulx="112" uly="1312" lrx="1097" lry="1342" /><zone xml:id="m-8e84365c-c375-4a46-b0d8-af96e9523e78" ulx="112" uly="1339" lrx="1096" lry="1372" /><zone xml:id="m-e329cc5a-d6d3-44f1-8551-f211ea6c3c5b" ulx="114" uly="1369" lrx="945" lry="1402" /><zone xml:id="m-9d78791b-821a-43ad-8043-57a6be10a0df" ulx="143" uly="1402" lrx="1096" lry="1446" /><zone xml:id="m-f17d31d9-37e0-4e63-988f-9a6bff6a17cb" ulx="115" uly="1437" lrx="1095" lry="1480" /><zone xml:id="m-5d79a913-fb01-49de-8ae1-3b27f32c0864" ulx="116" uly="1474" lrx="1096" lry="1508" /><zone xml:id="m-87645fd3-dfa5-4ca2-8834-225004eadb5e" ulx="114" uly="1499" lrx="1096" lry="1539" /><zone xml:id="m-aae565e2-8d64-47df-8886-e3b094805342" ulx="139" uly="1568" lrx="1097" lry="1610" /><zone xml:id="m-6c0312f9-0875-48e1-9615-d5ca8cb982c1" ulx="114" uly="1597" lrx="723" lry="1630" /><zone xml:id="m-4a8eb1bb-8c26-47dd-a8b4-ffb883d19226" ulx="138" uly="1625" lrx="1096" lry="1659" /><zone xml:id="m-b332b5b6-787b-46ca-958f-77ce02f6d881" ulx="114" uly="1648" lrx="1094" lry="1685" /><zone xml:id="m-704b9cda-8c91-4aa9-8233-20501d94137e" ulx="137" uly="1677" lrx="1095" lry="1711" /><zone xml:id="m-a903c533-a95b-4f03-9d39-19e2d1951690" ulx="116" uly="1697" lrx="584" lry="1736" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-989f2e79-e96c-43da-ab26-e5679eca2aab" n="2012" facs="#m-80f68526-7e2b-42df-90b4-7133901f6e58" /><div xml:id="m-672d21d6-ccb8-41f6-b240-e2ba5d452f29">
            <lg xml:id="m-1a1ee7ac-d13d-46a4-904a-b073a74a4134">
              <l xml:id="m-b2c78e51-8193-4a32-809e-6654e2a599c2" facs="#m-2f385a51-f214-4998-b50b-4deb308d9dc1" label="ambiguous">1766</l><l xml:id="m-a4c9e28d-a59f-4431-9587-ff3e4d74327c" facs="#m-613513e0-5b7a-4926-bec3-039e53da31fd" label="text-like">The Burial Service.</l><l xml:id="m-e8324215-e567-4d9e-b63e-220818a944a8" facs="#m-87cb64fb-72c1-4f0a-94c6-5acf798820fe" label="text-like">The bier is placed in the middle of the church, with the feet of the corpse</l><l xml:id="m-787dfaa2-d486-40bc-afd8-bb5092655916" facs="#m-17090ad8-f6ca-4fc8-a3da-1606042af6a0" label="text-like">to the High Altar, if a lay person. Ifthe deceased be a priest, he is placea</l><l xml:id="m-c1a8581d-c683-43de-8dc5-7bb9aa3f42f5" facs="#m-dd84cdc1-67c1-43ae-affa-ee3ceef11ccd" label="text-like">facing the people. Lighted candles are placed around the bier. If there be no</l><l xml:id="m-2a2f9f62-58bb-45a2-9be7-3b0ba3e02e8e" facs="#m-864685f7-ff88-4d6a-8ec7-ceef8876ae80" label="text-like">reason for delay, the Office for the Dead is then said, with the Invitatory,</l><l xml:id="m-427c5d61-85e5-4775-b66f-e10ccddccc9d" facs="#m-f4a3df07-8b8b-47e2-aa74-6471562a6afc" label="text-like">the three Nocturns, and Lauds. The Antiphons are doubled.</l><l xml:id="m-b1d395ae-995c-484e-b0b9-117bd667f34a" facs="#m-8f158114-61a6-49e8-aba5-8d123b7d8ce6" label="text-like">When funerals take place in the evening, Vespers and Matins are said, or</l><l xml:id="m-0f2625c6-6236-4525-af4f-824f970d9dc4" facs="#m-6bf730ff-c8ea-477b-9185-6488b162d304" label="text-like">Matins onty, or the first Nocturn only.</l><l xml:id="m-1d3bd05b-09c9-43e5-a0b7-4611759d79fc" facs="#m-ff1d5e87-d88f-4154-9770-6ad0070d65f0" label="text-like">Vespers for the Dead, p. 1772.</l><l xml:id="m-94c262c4-d067-431a-929c-5423838191eb" facs="#m-705e5899-9d5b-4b47-84f4-bbf3583d953b" label="text-like">Matins for the Dead, p. 1779.</l><l xml:id="m-1d729c64-c4c0-4a50-80ab-2e4e0bb8fd10" facs="#m-bbf39938-f537-4a4c-9e3f-edaaadcf0fb0" label="text-like">Lauds for the Dead, p. 1799.</l><l xml:id="m-2fdfbe7f-0a50-4385-819e-45e64d686b45" facs="#m-b8ed96db-d170-4595-94f8-43a46050d7b5" label="text-like">At the end of the Office, after the repetition of the Antiphon of the Benedictus:</l><l xml:id="m-6360d47b-8137-4047-847d-b523e12fcde2" facs="#m-c7a24b53-c51f-4580-89a6-fea6446fd611" label="lyrics-like">Ego sum resurréctio, (or, if Lauds are not said, after the Nocturn or Nocturns</l><l xml:id="m-6125e4a2-98e6-4ade-bf00-6a8ba788e539" facs="#m-303070b4-f705-4767-8a47-d362bb4f3fd1" label="text-like">or Matins,) the foltowving is said. (For the Chant, see p. 1770).</l><l xml:id="m-f5ffcf3f-0f30-4638-8d89-2b84598bb1a9" facs="#m-3598cd49-7a16-4317-aee9-ced6a1c46e6f" label="lyrics-like">Páter nóster. continued in silence.</l><l xml:id="m-e2c4ab37-c5cf-44d7-86df-8c6cb63a6906" facs="#m-3a5ac453-97c4-4ad5-90e7-735dfb4da336" label="lyrics-like">V. Et ne nos indúcas in tentatiónem. H. Sed libera nos a málo.</l><l xml:id="m-9532c443-5696-47c1-8591-cb46f752fb4c" facs="#m-7bcb5e68-8253-4fff-a55d-d2e887d5e88b" label="lyrics-like">V. A pórta inferi. H. Erue Dómine ánimam éjus.</l><l xml:id="m-d5f8de14-02fa-42b8-b207-2bb2813c1994" facs="#m-27edf97a-525e-4002-8491-50a3450c2d62" label="lyrics-like">v. Requiéscat in páce. R. Amen.</l><l xml:id="m-22b902db-2a0c-4397-bb6d-ab761ff80a26" facs="#m-8860a660-d7d9-430f-893a-689a8844dba3" label="lyrics-like">V. Dómine exáudi oratiónem méam. R. Et clámor méus ad te véniat.</l><l xml:id="m-e885408d-85d7-45af-b0b6-6bf2a29a97af" facs="#m-01b31f4a-915f-407b-bbb2-afcf58e768d2" label="lyrics-like">V. Dóminus vobíscum. E. Et cum spiritu túo.</l><l xml:id="m-9d77d146-763b-4bf4-854b-ced889cca1b3" facs="#m-897e45b7-2fd0-4009-beee-29db2a79aa94" label="lyrics-like">Orémus.</l><l xml:id="m-b5ef556a-52b3-423d-83cb-89aad17762a2" facs="#m-8ac43963-a6ed-4795-b705-70b207ec9b07" label="lyrics-like">IBsólve, quaésumus Dómine, áni-( minum nostrum Jesum Christum</l><l xml:id="m-41962c32-6899-4f59-9d64-debcd8861fc5" facs="#m-b1156260-ca92-4292-abe1-919d0c70e3b3" label="lyrics-like">A mam famuli tui N. (fámulae</l><l xml:id="m-ea0c23b1-8a22-4c31-8999-fac057ad913e" facs="#m-ec7f659e-f66b-4632-bc12-5887979499d1" label="ambiguous">Fflium tuum; f qui tecum vivit et</l><l xml:id="m-29fe1351-43bc-4208-be76-0a91028da0b0" facs="#m-2b2a2606-d889-4178-b9b4-54b1576194e6" label="lyrics-like">tuae N.) ab omni vínculo delictó¬</l><l xml:id="m-dd8f5789-9b32-4c18-866a-fa4b9ccb9edc" facs="#m-6eb529cc-6623-4914-b714-ba48fc705c9d" label="lyrics-like">regnat in unitáte Spiritus Sancti</l><l xml:id="m-d97ac0af-3284-4430-90a5-23be12827a68" facs="#m-0cfa014a-2edd-4ca3-9b5d-b28f7c8c0c0d" label="lyrics-like">rum :f ut in resurrectiónis glória"</l><l xml:id="m-c3ade25d-3962-4f77-9795-b7e75e0a1668" facs="#m-45fde0fe-af50-4235-8c2d-aa87b4dc32ac" label="lyrics-like">Deus, * per ómnia saécula saeculó¬</l><l xml:id="m-eb745ec9-c43b-4b66-80e7-d6671ec011c2" facs="#m-3c0db63e-bc97-4071-966b-ff79de6d099b" label="lyrics-like">inter Sanctos et eléctos tuos resusci-I rum. Amen.</l><l xml:id="m-b4de1553-9075-42d8-b9f3-a3af64923557" facs="#m-9eb657de-5f4c-452f-9cde-cc6840d2b347" label="lyrics-like">tátus (resuscitáta) respiret. Per Dó¬</l><l xml:id="m-cb1df5d5-6d85-4ae3-b3e4-cf5f21d8dd59" facs="#m-2ed4db77-f1b3-47b9-a426-a3108e244b8b" label="text-like">According to circumstances, this Prayer is replaced by one of those given</l><l xml:id="m-1bc6f98f-47f0-44f8-b040-92edb54ea971" facs="#m-d17df618-eeb6-43e7-8344-1db177c8363f" label="text-like">on p. 1777-1779.</l><l xml:id="m-572c2307-bebc-42b4-9c8d-8416aa78cb1b" facs="#m-4306aa60-863f-40b3-8d24-34f84f6b787f" label="text-like">During Lauds, the Celebrant and his attendants go to the sacristr to vest.</l><l xml:id="m-dde162b4-3bc4-4e99-966b-7d8fb2b80bee" facs="#m-f7c834cd-5b72-4075-ae80-2bab6f667689" label="text-like">Irthere is no reason for delay. the Mass for the Day of Burial is then said.</l><l xml:id="m-fc0eeda1-ad6d-405b-a19f-6a939faf7fb9" facs="#m-f9e04029-373e-471e-b0a2-c661298c65ca" label="ambiguous">P.1807.</l><l xml:id="m-37e99fc0-a44b-4134-aec3-919e7dc5c23b" facs="#m-2d108fdd-9895-4f54-a9b4-3a7340c058c8" label="text-like">The Absolution.</l><l xml:id="m-7d2e72fd-6101-4f61-b51c-c5f5367796f1" facs="#m-743d51ee-206a-434b-a825-d06f0139fba5" label="text-like">After Mass, the Priest, vested in a black cope, goes to the bier for the</l><l xml:id="m-9cd8fb11-63b5-4617-be93-82a84b4d08b3" facs="#m-debabf3b-c7b8-4379-9fd6-06e6c5165804" label="text-like">ceremony called the Absolution. The Cross-bearer stands at the head of the</l><l xml:id="m-4037affd-2975-42cf-90d6-fef160728538" facs="#m-15bd721a-1e00-44d0-a9a0-4f0b662f5066" label="text-like">deceased between two acolytes, bearing lighted candles. The priest stands at</l><l xml:id="m-b1d0b593-d14a-413e-a516-6dd88bbea30c" facs="#m-8e84365c-c375-4a46-b0d8-af96e9523e78" label="text-like">the foot of the bier opposiie the Cross and recites the following Prayer, which</l><l xml:id="m-4d2d05a9-926e-417b-936b-6b2ae6b8f8dd" facs="#m-e329cc5a-d6d3-44f1-8551-f211ea6c3c5b" label="text-like">is never altered even if said for a woman or for several deceased.</l><l xml:id="m-8cfa7e96-67b6-4024-b232-bb50c73b5d39" facs="#m-9d78791b-821a-43ad-8043-57a6be10a0df" label="lyrics-like">DON intres in judícium cum ser-remissio. Non ergo eum, quaésu¬</l><l xml:id="m-02848e26-470d-4cf4-8875-7e900d74b0ca" facs="#m-f17d31d9-37e0-4e63-988f-9a6bff6a17cb" label="lyrics-like">Lt vo tuo Dómine, quia nullus! mus, tua judiciális senténtia premat,</l><l xml:id="m-d426d44b-7162-4ed4-96d2-f07243cb6462" facs="#m-5d79a913-fb01-49de-8ae1-3b27f32c0864" label="lyrics-like">apud te justificábitur homo, nisi per! quem tibi vera supplicátio fidei</l><l xml:id="m-476c0aa4-e300-4791-a791-aa1a5e6429fb" facs="#m-87645fd3-dfa5-4ca2-8834-225004eadb5e" label="lyrics-like">té ómnium peccatórum ei tribuãturl christiánae comméndãt : sed grátia</l><l xml:id="m-6b425c30-b2ca-4de8-bf7a-25a0589090b3" facs="#m-aae565e2-8d64-47df-8886-e3b094805342" label="lyrics-like">The V.N. Requiem aetérnam and Requiéscat. are not said aster the Prayer, if it</l><l xml:id="m-f5dd71b0-caab-4320-8f67-4808cc7d0c61" facs="#m-6c0312f9-0875-48e1-9615-d5ca8cb982c1" label="lyrics-like">be folloved immédiately by Mass or the Absolution.</l><l xml:id="m-94e0baed-31ec-44e6-80ae-aa280613ecd2" facs="#m-4a8eb1bb-8c26-47dd-a8b4-ffb883d19226" label="text-like">All the Prayers of the Office for the Dead and at the Absolution are sung recto tono</l><l xml:id="m-f9da0ba1-5117-4d31-bec8-1122ee119956" facs="#m-b332b5b6-787b-46ca-958f-77ce02f6d881" label="lyrics-like">In the first ferial tone, or, if preferred, in the second ferial tone as indicatẽd on p. 90.</l><l xml:id="m-5dba3939-325a-4f57-8d31-b370f2b1fabd" facs="#m-704b9cda-8c91-4aa9-8233-20501d94137e" label="text-like">Only the Prayers of Mass and of the Office end with the long conclusion; the othæ</l><l xml:id="m-e95ca5b2-b09e-4858-b283-900918dfc27d" facs="#m-a903c533-a95b-4f03-9d39-19e2d1951690" label="text-like">Prayers end with the shorter conclusion.</l></lg></div></section></score></mdiv></body></music>
</mei>