654" /><zone xml:id="m-0696d743-7e56-483b-8b20-6590a51fe0bf" ulx="52" uly="610" lrx="115" lry="653" /><zone xml:id="m-8c950ba6-5670-4953-a230-d867af18a5a8" ulx="815" uly="610" lrx="917" lry="653" /><zone xml:id="m-5c077612-5e47-48ed-a7d9-1c7276bf7aa0" ulx="430" uly="659" lrx="539" lry="690" /><zone xml:id="m-a57cfe05-0ad2-4132-a423-13e94db95690" ulx="87" uly="684" lrx="917" lry="722" /><zone xml:id="m-7ab91167-6ee2-4457-85f5-20b09ada1063" ulx="55" uly="712" lrx="477" lry="751" /><zone xml:id="m-cb9723a8-fd21-44e5-b448-8730d9125c82" ulx="486" uly="713" lrx="915" lry="749" /><zone xml:id="m-7292090f-7843-4605-bc8a-14b790d28985" ulx="51" uly="743" lrx="771" lry="775" /><zone xml:id="m-20394875-72e3-4753-8169-f0f72bbb9cbe" ulx="51" uly="768" lrx="477" lry="801" /><zone xml:id="m-79448ca8-e399-4013-b902-d016c3a35b23" ulx="73" uly="798" lrx="817" lry="834" /><zone xml:id="m-8ace5719-78a0-4e32-973f-31a04ce27cc6" ulx="186" uly="892" lrx="763" lry="941" /><zone xml:id="m-49e948b5-5daa-47ae-ab79-6c90a3b522e1" ulx="50" uly="896" lrx="109" lry="940" /><zone xml:id="m-64a62ad0-baa9-4c0f-87ae-1cdffe730938" ulx="312" uly="944" lrx="655" lry="981" /><zone xml:id="m-3fe0dde4-bf04-4e02-90e6-1a183bceef6c" ulx="72" uly="991" lrx="915" lry="1030" /><zone xml:id="m-a2da77a7-3ba8-4bdf-b348-4858d6574437" ulx="49" uly="1019" lrx="651" lry="1059" /><zone xml:id="m-3b1a1869-a21e-475a-8480-e64e1a1f02bf" ulx="404" uly="1072" lrx="555" lry="1116" /><zone xml:id="m-47ab51c6-9ae6-4443-9460-637390b03bb0" ulx="73" uly="1121" lrx="425" lry="1163" /><zone xml:id="m-9e82bd13-2132-4670-a9a5-739b53cbea78" ulx="423" uly="1149" lrx="533" lry="1188" /><zone xml:id="m-0f423ba0-f4be-4048-962e-56691536f3f9" ulx="83" uly="1176" lrx="912" lry="1222" /><zone xml:id="m-aafab37f-b4cb-4089-9285-d69aab3325bc" ulx="50" uly="1207" lrx="907" lry="1246" /><zone xml:id="m-b2b7e7bb-195d-404f-ae27-0cc830573da4" ulx="47" uly="1236" lrx="474" lry="1270" /><zone xml:id="m-3491b5c5-60a1-4d22-b9c3-564e614303ce" ulx="486" uly="1236" lrx="671" lry="1275" /><zone xml:id="m-68de33e5-3a97-4e10-9754-d5cfd5eca16f" ulx="46" uly="1265" lrx="473" lry="1298" /><zone xml:id="m-a95b4aba-8c0e-4ece-93e4-2327d2f67d1e" ulx="52" uly="1304" lrx="901" lry="1342" /><zone xml:id="m-617633f6-3ffb-4941-b825-e4f1aa185b40" ulx="55" uly="1344" lrx="910" lry="1385" /><zone xml:id="m-78a99532-3adc-46eb-abb3-b7109b4c7bba" ulx="49" uly="1373" lrx="473" lry="1412" /><zone xml:id="m-9873a4e6-bb80-4a20-a2a0-464602327155" ulx="483" uly="1375" lrx="911" lry="1405" /><zone xml:id="m-6702bd95-c339-493c-8302-253ee547b12d" ulx="46" uly="1401" lrx="472" lry="1435" /><zone xml:id="m-81e1f05e-52c8-4bcf-8066-b2eaf29961ec" ulx="482" uly="1401" lrx="913" lry="1434" /><zone xml:id="m-e4741895-6b88-472e-b79c-cf3bfce4f372" ulx="45" uly="1427" lrx="472" lry="1460" /><zone xml:id="m-38e01b17-5896-4bda-aa99-d0d512a1f054" ulx="483" uly="1427" lrx="911" lry="1460" /><zone xml:id="m-2873e34a-4a6e-48fa-9986-7605db186188" ulx="45" uly="1453" lrx="476" lry="1489" /><zone xml:id="m-04354b7f-3314-45dc-b674-2768cca20b34" ulx="480" uly="1457" lrx="911" lry="1489" /><zone xml:id="m-e3d82600-da5d-423e-b30c-f41b7e30e169" ulx="49" uly="1481" lrx="909" lry="1517" /><zone xml:id="m-2a64903c-b6ff-4a05-a782-ea52e102e0a4" ulx="45" uly="1506" lrx="909" lry="1548" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-85460f95-7b64-4fee-85b7-bcb6822387f2" n="1965" facs="#m-58fdca50-7c69-4fc0-992b-47f132282f2a" /><div xml:id="m-31c2113b-6f1f-4635-b062-0e34f9238f13">
            <lg xml:id="m-22832f0d-4874-4653-a512-a8a50046b99c">
              <l xml:id="m-43479aae-b7b3-4212-9646-2cabf125bf56" facs="#m-f5cd5d50-b8ee-4293-a063-2b001cf3753b" label="ambiguous">october 25. 26. 28.</l><l xml:id="m-499fea69-16b6-496f-8871-02b49a223a7a" facs="#m-d863ba7a-30df-4ff8-baae-6af395632ec1" label="ambiguous">1719</l><l xml:id="m-94e54ec1-26d8-4639-97a8-b0110aa05e6f" facs="#m-b1d01bf3-f0e5-45bb-9184-3783c8e152f1" label="ambiguous">25.</l><l xml:id="m-896d71e4-c4d0-43b2-b73d-c82967a63d5b" facs="#m-875cd5d4-9d8d-4a40-a076-ed7c64e8c817" label="text-like">SS. Chrysanthus and Daria, Martyrs.</l><l xml:id="m-c598a8ba-d87d-4fe6-804f-1434bcd1966e" facs="#m-a3aa5aa4-9b45-4781-9374-7e93462456ac" label="ambiguous">Simple.</l><l xml:id="m-70ebc9de-da65-444b-bd06-cba34f6de880" facs="#m-0110b44b-567d-4dc7-b509-272cd482b0dc" label="ambiguous">Collect.</l><l xml:id="m-c33b7f64-081f-4ead-86db-393951808a7c" facs="#m-0cecb057-434a-4d48-8ef6-447b9c2ced6d" label="lyrics-like">REatórum Mártyrum tuórum Dó-lut quos venerámur obséquio,</l><l xml:id="m-32777711-7c69-4d72-9761-6ba956b0193f" facs="#m-bbe4f7af-b95a-40ca-9ba5-0537d1f37531" label="lyrics-like">D mine Chrysánthi et Dariae, córum pium júgiter experiámur</l><l xml:id="m-dee3f326-356c-4a82-b166-453bf4bc1abe" facs="#m-c8d0457d-1643-4752-95b2-72b1e629ef9f" label="lyrics-like">quaésumus, adsit nobis orátio : f l auxilium. Per Dóminum.</l><l xml:id="m-19239f9b-4585-441a-8016-b3c9c1a4d87e" facs="#m-15a8f78c-e5d2-490f-a339-418548da8701" label="ambiguous">Secret.</l><l xml:id="m-4886a33d-6c8a-4441-8023-f574529ae645" facs="#m-8cdc6469-8275-4961-bb68-90e90a45b3fa" label="lyrics-like">DOpuli tui, quaésumus Dómine, (rum Chrysánthi et Dariae solémni¬</l><l xml:id="m-49df5413-cd0a-4838-9bf4-f17ff9580ead" facs="#m-00990134-8809-41fc-a031-9ba66df6d65a" label="lyrics-like">L tibi grata sit hóstia, quae in na- ter immólátur. Per Dóminum no¬</l><l xml:id="m-64b65236-0ab7-4189-89ca-79eb80bc7e3d" facs="#m-e88dd985-a26f-4db1-90aa-cf2d8bbb8dc4" label="lyrics-like">talitiis sanctórum Mártyrum tuó-Istrum.</l><l xml:id="m-f4c10e80-db24-4f59-bc2d-596b97783433" facs="#m-2db89dc6-13a9-471f-af82-83b8aee49308" label="ambiguous">Postcommunion.</l><l xml:id="m-e19f785b-ff09-4673-abcf-9c7f83ce120e" facs="#m-910b2240-e764-48f4-b8c8-4e6620284f59" label="lyrics-like">Ysticis Dómine repléti sumus (thi et Dariae, quae temporáliter</l><l xml:id="m-594492ac-fb52-45ac-9be7-0ef3991a9e1f" facs="#m-a0476dd4-15f9-4c94-84b2-9a780533314b" label="lyrics-like">SIL votis et gáudis: praesta</l><l xml:id="m-4ef148fa-4d72-4528-9dd6-b8d894192fb4" facs="#m-2df9fdaf-9c31-4ff9-b75d-a5d66daa9186" label="lyrics-like">ágimus, spirituáliter consequámur.</l><l xml:id="m-b3564f03-3c35-4cf7-8959-acab97d1d638" facs="#m-d490530b-0251-4654-aea1-989a52bf49ad" label="lyrics-like">quaésumus; ut intercessiónibus san-Per Dóminum.</l><l xml:id="m-15ea3eda-73e2-44af-860e-f5ea4dc18aac" facs="#m-037a7680-1d53-4c03-adca-25de0f962075" label="lyrics-like">ctórum Mártyrum tuórum Chrysán¬</l><l xml:id="m-88cf9586-fed4-428f-98c1-47b85b1b306c" facs="#m-2d5332de-ee89-4c8b-a1e3-39e5bb2cfd60" label="text-like">S. Evaristus I. Pope and Martyr.</l><l xml:id="m-b1ba0c4c-0bbe-4895-873e-2ac5f2559671" facs="#m-0696d743-7e56-483b-8b20-6590a51fe0bf" label="ambiguous">26.</l><l xml:id="m-a6935e6b-629c-4887-a2c4-bc967d570337" facs="#m-8c950ba6-5670-4953-a230-d867af18a5a8" label="ambiguous">Simple.</l><l xml:id="m-360efbca-35c3-4fe9-af83-edac32b8d87f" facs="#m-5c077612-5e47-48ed-a7d9-1c7276bf7aa0" label="ambiguous">Collect.</l><l xml:id="m-5bf8e6da-30b7-4b5f-ad33-e38ac1c0a0eb" facs="#m-a57cfe05-0ad2-4132-a423-13e94db95690" label="lyrics-like">(Regem tuum, Pastor aetérne, tua protectióne custódi; * quem</l><l xml:id="m-efce1a53-7e5b-46aa-9d8f-f32dc1241088" facs="#m-7ab91167-6ee2-4457-85f5-20b09ada1063" label="lyrics-like">(Y placátus inténde: t et per</l><l xml:id="m-2b6c17d1-27ab-4c79-9484-68d6986d0f37" facs="#m-cb9723a8-fd21-44e5-b448-8730d9125c82" label="lyrics-like">totius Ecclésiae praestitisti esse pa¬</l><l xml:id="m-a2e8f04d-82e8-4377-9f08-968212b6c451" facs="#m-7292090f-7843-4605-bc8a-14b790d28985" label="lyrics-like">beátum Evaristum Mártyrem tuum stórem. Per Dóminum.</l><l xml:id="m-1edfb691-ade1-48e4-ac06-29bf9d0eb4f9" facs="#m-20394875-72e3-4753-8169-f0f72bbb9cbe" label="lyrics-like">atque Summum Pontificem, perpé¬</l><l xml:id="m-d43d16e1-0b4d-4db3-832c-deaad47fa671" facs="#m-79448ca8-e399-4013-b902-d016c3a35b23" label="lyrics-like">Secret. Oblátis. p. 1122e, and Postcommunion. Refectióne. p. 1123.</l><l xml:id="m-dc1ba0ec-d80e-4fee-9ee3-2bda7fc0a0e2" facs="#m-8ace5719-78a0-4e32-973f-31a04ce27cc6" label="text-like">SS. SIMON AND JUDE, APOSTLES.</l><l xml:id="m-a4840672-93be-47a3-ae12-7752c980d606" facs="#m-49e948b5-5daa-47ae-ab79-6c90a3b522e1" label="ambiguous">28.</l><l xml:id="m-2cde4d6b-8dcf-4791-8259-6c7bde9f5fd7" facs="#m-64a62ad0-baa9-4c0f-87ae-1cdffe730938" label="text-like">Double of the second Class.</l><l xml:id="m-12bbbcae-44a9-4df7-a029-cbe21eee9a03" facs="#m-3fe0dde4-bf04-4e02-90e6-1a183bceef6c" label="text-like">At Vespers and at the Little Hours, all from the Common ot</l><l xml:id="m-f560af1b-d4f3-44bc-9084-e627177fa6d2" facs="#m-a2da77a7-3ba8-4bdf-b348-4858d6574437" label="text-like">Apostles, p. I1Il. — Prayer. Deus, qui nos. as below.</l><l xml:id="m-484f3a84-3b52-4b90-80c4-371a395b3138" facs="#m-3b1a1869-a21e-475a-8480-e64e1a1f02bf" label="text-like">AT MASS.</l><l xml:id="m-995fe3ab-fc41-44ef-bfe0-aaaf2b48483f" facs="#m-47ab51c6-9ae6-4443-9460-637390b03bb0" label="text-like">Introit. Mihi autem. p. 1304.</l><l xml:id="m-9ac0dbe8-94de-4ab7-89fd-2bfb5c3fb29d" facs="#m-9e82bd13-2132-4670-a9a5-739b53cbea78" label="ambiguous">Collect.</l><l xml:id="m-5e7b5917-5de3-46c5-be3f-d7266981cf11" facs="#m-0f423ba0-f4be-4048-962e-56691536f3f9" label="lyrics-like">Eus, qui nos per beátos Apósto- sempitérnam et proficiéndo cele¬</l><l xml:id="m-e9c08b85-2f7f-47e4-b6b3-50eff36acc01" facs="#m-aafab37f-b4cb-4089-9285-d69aab3325bc" label="lyrics-like">U los tuos Simônem et Judam ad brâre, * et celebrándo proficere.</l><l xml:id="m-3f4bc1d5-56e0-407f-92b7-adccbed84a38" facs="#m-b2b7e7bb-195d-404f-ae27-0cc830573da4" label="lyrics-like">agnitiónem tui nóminis venire tri¬</l><l xml:id="m-fc034123-1a9a-4c2f-81a2-870cf401dc52" facs="#m-3491b5c5-60a1-4d22-b9c3-564e614303ce" label="lyrics-like">Per Dóminum.</l><l xml:id="m-749b7df0-7a6b-4deb-a76c-d78592cd06ab" facs="#m-68de33e5-3a97-4e10-9754-d5cfd5eca16f" label="lyrics-like">buisti : t da nobis eórum glóriam</l><l xml:id="m-9b07baa6-203f-46a4-8eba-710b1ab6661f" facs="#m-a95b4aba-8c0e-4ece-93e4-2327d2f67d1e" label="ambiguous">Lectio Epistolae beati Pauli Apostoli ad Ephesios. Ephes. 4. b.</l><l xml:id="m-c078df33-7703-400c-8605-11c9312d9be5" facs="#m-617633f6-3ffb-4941-b825-e4f1aa185b40" label="lyrics-like">LRatres: Unicuíque nostrum ! primum in inferióres partes terrae?</l><l xml:id="m-ea450b8e-acdd-488f-a4ad-4cd21c62b2ea" facs="#m-78a99532-3adc-46eb-abb3-b7109b4c7bba" label="lyrics-like">data est grátia secúndum men¬</l><l xml:id="m-ff2b383a-c568-45f7-a24c-ed43d48037c2" facs="#m-9873a4e6-bb80-4a20-a2a0-464602327155" label="lyrics-like">Qui descéndit, ipse est et qui ascén¬</l><l xml:id="m-476d28fc-1a8e-41e2-97c9-41284cce7725" facs="#m-6702bd95-c339-493c-8302-253ee547b12d" label="lyrics-like">suram donatiónis Christi. Propter</l><l xml:id="m-c2bc7286-c6b5-4ed5-8dcb-75eda93f1d30" facs="#m-81e1f05e-52c8-4bcf-8066-b2eaf29961ec" label="lyrics-like">dit super omnes caelos, ut impléret</l><l xml:id="m-1fc94bcd-d6eb-4e12-bfbb-c848b55116f0" facs="#m-e4741895-6b88-472e-b79c-cf3bfce4f372" label="lyrics-like">quod dicit: Ascéndens in altum,</l><l xml:id="m-6a020588-5a5c-4ebd-916a-05a044f8bf61" facs="#m-38e01b17-5896-4bda-aa99-d0d512a1f054" label="lyrics-like">ómnia. Et ipse dedit quosdam qui¬</l><l xml:id="m-cccd3340-3852-4f39-b5bf-1c8a6d33c5d2" facs="#m-2873e34a-4a6e-48fa-9986-7605db186188" label="lyrics-like">captivam duxit captivitãtem : dedit</l><l xml:id="m-3d20f70b-8b60-4adb-be23-7bed03906bfb" facs="#m-04354b7f-3314-45dc-b674-2768cca20b34" label="lyrics-like">dem apóstolos, quosdam autem pro¬</l><l xml:id="m-8bc3637e-e8c4-4c3e-b2ec-2b8919b4b115" facs="#m-e3d82600-da5d-423e-b30c-f41b7e30e169" label="lyrics-like">dona homínibus. Quod autem ascén-lphétas, álios vero evangelistas, álios</l><l xml:id="m-cc7a8bf3-179e-4a46-b0d4-91f00ac927b2" facs="#m-2a64903c-b6ff-4a05-a782-ea52e102e0a4" label="lyrics-like">dit, quid est, nisi quia et descéndit ! autem pastóres et doctôres ad con¬</l></lg></div></section></score></mdiv></body></music>
</mei>