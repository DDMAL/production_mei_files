            <pb xml:id="m-e8c5a7f8-6320-47de-aecf-822b152aea37" n="0006" facs="#m-68bdcffb-4b29-4bcc-8f61-122ce71e2ba9" />
            <div xml:id="m-a7bd7278-79e2-4ae4-91fc-5690ecfe4034">
              <lg xml:id="m-71518d87-06c6-4c22-b3c5-0dd0a85f2728">
                <l xml:id="m-bccf0875-f2ad-48e6-b264-2fca28512738" facs="#m-9fdd54b0-8509-4262-911e-79191ef4c39c" label="ambiguous">vi.</l><l xml:id="m-f8249bce-a07a-49d3-900e-c1021385729d" facs="#m-9ddac86e-8130-427a-960d-ffb942043677" label="text-like">Table of Contents.</l><l xml:id="m-44cd9b70-3d28-4861-8292-718613a77d18" facs="#m-da5820bb-3be1-4fdf-8f18-8ccab60f0e02" label="ambiguous">1832</l><l xml:id="m-97cb6d68-f089-4a5a-ae04-d65cf3161ae2" facs="#m-6721f63d-bc5d-4f07-821d-68a5670dbad3" label="ambiguous">APPENDIX I.</l><l xml:id="m-612cac96-ef72-4560-88a5-3a7f76143635" facs="#m-aea0331f-320f-45ec-9114-c352c7c940ce" label="ambiguous">1832</l><l xml:id="m-cfdb0a21-6ea2-4202-bb93-fe1049870e67" facs="#m-fda2e6f3-55f5-4300-90fe-1fab085378db" label="text-like">Hymn of Thanksgiving</l><l xml:id="m-77b74048-3877-46ee-bae5-cb74f040df85" facs="#m-16e411c5-ae09-4e3d-a568-c960c00e90e2" label="ambiguous">1837</l><l xml:id="m-841d3348-7495-48d2-bd13-f1d422bb802d" facs="#m-e8cb5481-64df-4d5b-8c9a-e7db6edd8b1f" label="text-like">Invocation to the Holy Ghost</l><l xml:id="m-d454e240-b070-4238-a472-07864a0759d5" facs="#m-775ea35e-61f5-4ec9-995c-fff7f3880e14" label="ambiguous">1838</l><l xml:id="m-41d77868-2d46-48cf-a0d1-d703144556f3" facs="#m-013aa4ad-206c-4320-a9c9-2af76be33eeb" label="text-like">Procession to beg for Rain.</l><l xml:id="m-4c12d1a8-e248-4a3f-99b4-21b79a176535" facs="#m-f90a79a8-80c9-4aeb-b55c-e4a83b7cb284" label="ambiguous">1839</l><l xml:id="m-9b2bb025-a001-4a32-b010-d6543630ea4f" facs="#m-bfcffd32-ea71-4adc-a8b4-3849b52fbe3a" label="text-like">Procession to beg for Fine Weather</l><l xml:id="m-3155e715-3e8e-491d-a06a-4fe1ab52b66c" facs="#m-62b5fa05-a441-455b-9e7a-e61fc749d97b" label="ambiguous">1840</l><l xml:id="m-cb41d93c-013f-48b3-854d-5e99ebbf2954" facs="#m-df4c74dd-eea3-4a41-9cda-e93bd3ca3473" label="text-like">The Seven Penitential Psalms</l><l xml:id="m-e6fe8d65-be4b-4330-820c-fe029cf48781" facs="#m-57ca2254-2269-4c17-8ee6-6d1ff6830000" label="ambiguous">1840</l><l xml:id="m-2acf4f93-a612-4fc7-b21c-531a4da5e626" facs="#m-5db4446e-de52-4f6a-bcf2-0570a138fb61" label="text-like">The Solemn reception of a Bishop</l><l xml:id="m-31acce82-e91d-4cb6-acf2-08c5436bc082" facs="#m-51ef6b51-f556-4dc2-ba60-5448ed5b6651" label="text-like">The Pastoral Visit</l><l xml:id="m-bb2ed4db-eb01-4e7e-9d38-ed63b11526fc" facs="#m-9b2a2744-6d0b-4ad3-9510-91a64ada1b45" label="ambiguous">1842</l><l xml:id="m-60863900-bd26-487e-807d-3159c7acf642" facs="#m-4ad719bb-ee60-46eb-a646-32b975d72cf7" label="ambiguous">1844</l><l xml:id="m-ca687dc9-2279-4bf6-a833-669b23ecbc55" facs="#m-883379a3-0401-47bb-b444-c0c497cbb95e" label="text-like">The Administration of Confirmation</l><l xml:id="m-355d2e9a-a1c9-4f08-80a2-1448b4c1dabb" facs="#m-871db63e-c373-4526-a16d-bc51dbd699e6" label="ambiguous">"</l><l xml:id="m-c2a0d153-27d7-401a-be3c-d5bf096a22cf" facs="#m-7411457e-0dce-41c2-909d-6e58875a8e6e" label="ambiguous">1845</l><l xml:id="m-1fd57cad-5af5-4dc7-97d8-5a06f0cb2d91" facs="#m-145ef997-5a2f-4a04-acd4-0666baf87b8c" label="text-like">The Rite of Giving the Tonsure.</l><l xml:id="m-478c6481-532c-4a15-b7c2-3ff7a10c4e83" facs="#m-94fa22c4-30c2-4105-82e6-360d1144076b" label="ambiguous">.</l><l xml:id="m-dee071dd-511f-443d-9ce4-54f596949586" facs="#m-14f70e4f-a306-4dd8-98c0-a1d700c4f050" label="text-like">The Ordination of a Priest.</l><l xml:id="m-883c223e-2c7e-42c9-9f99-f0f18f8d87b6" facs="#m-390f89fb-4985-4f74-9620-414840e2b6ab" label="ambiguous">.1847</l><l xml:id="m-4ce8a622-2050-40c4-8523-691ff71b4615" facs="#m-d086e479-ec54-4ca8-8bf8-7ec7f85ac7a5" label="ambiguous">1840</l><l xml:id="m-e21c1fcb-e300-49d4-a813-8710d8d1ee97" facs="#m-8be6bdbd-7865-439e-b09a-bd9a587aa101" label="text-like">The Blessing of the Holy oils</l><l xml:id="m-3156d6e5-0333-4b5f-95b2-7cf1b1e0cec0" facs="#m-54b15266-c8bc-41d1-9e28-67d8afcd3650" label="ambiguous">"</l><l xml:id="m-3a76fefe-8f68-4ebd-b75b-b054e99057f3" facs="#m-62662272-d8f4-4c69-8110-2e7d0656928d" label="ambiguous">1851</l><l xml:id="m-564a4e0c-b080-4c60-848f-f52198942896" facs="#m-62436632-77b2-40c2-9e63-857c77e24806" label="text-like">Chants at Benediction of the Blessed Sacrament</l><l xml:id="m-9d4e927a-fbe2-46de-9c37-94de80064c82" facs="#m-a42bdf5a-e4e5-4aa6-b791-483c16e68c5b" label="ambiguous">.</l><l xml:id="m-10bd5bc1-95f9-492a-b235-bdf9fe8c714a" facs="#m-dd06dc0d-0707-42fe-bb34-53be8d629889" label="ambiguous">APPENDIX II</l><l xml:id="m-554f6495-0eef-46a1-83e5-00a9244f3beb" facs="#m-6a5d75f6-9bc0-4de7-8c34-dd207c0bc617" label="text-like">Prayers for the Forty Hours</l><l xml:id="m-2fe67506-22be-47a6-a06b-065e8e6a5687" facs="#m-61d033bf-4d34-4629-8ed7-f7dfae775689" label="ambiguous">.</l><l xml:id="m-3290dba2-3a44-493e-8437-2d18845005d0" facs="#m-ba967117-64e3-40d4-9098-abdea00982c9" label="ambiguous">Tract in a Psalm-tone</l><l xml:id="m-4c05c9dc-1ed8-467f-98f2-d06e0cccf5ab" facs="#m-650882ec-dcee-4cb1-8c10-90d6fb641477" label="text-like">Commemoration of all the Faithfull Departed</l><l xml:id="m-62119599-e774-4684-9834-66d50fa1b120" facs="#m-2b89cef6-cc81-48d4-902a-d35deadc146e" label="ambiguous">1</l><l xml:id="m-0179de89-8027-466c-b9ae-954603f52580" facs="#m-71ce7ebb-ecdd-4575-912b-e179d9548af8" label="ambiguous">-</l><l xml:id="m-67bb23d8-69db-4032-8bda-c343f4a8a6ed" facs="#m-17a8270e-9bd7-4f9d-a6c9-2ad24244c70e" label="text-like">Psalms for the Holy Week according to the nev</l><l xml:id="m-6c72540f-d87f-4b46-9fb8-8421ebbdf766" facs="#m-eed1d948-509d-4fe9-8ae6-29d7d1690be7" label="ambiguous">v latin version</l></lg>
            </div>
          </section>
