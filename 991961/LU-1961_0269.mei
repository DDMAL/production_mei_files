                    <nc xml:id="m-80fc3a0b-57e3-4324-b21c-11c1618dd3b5" pname="b" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-6cc0d4d1-7aec-409c-8358-c9f15f50cd1c">
                  <syl /><neume facs="#m-eb6c28b7-a1b2-4807-ae26-256d2929e0a7" type="punctum" xml:id="m-f5fbaec5-4aec-4860-81f1-7376771b3e6e">
                    <nc xml:id="m-3a3bc1bb-11af-4cff-b484-60f1b5761f78" pname="c" oct="4" />
                  </neume>
                </syllable>
                <syllable xml:id="m-fa8af8b8-e081-444c-9747-6f9582219e77">
                  <syl /><neume facs="#m-fe7ab739-88c9-4731-8267-e62c823fdd65" type="cavum" xml:id="m-6e7adcb3-c687-4353-8686-7da777833b70">
                    <nc xml:id="m-8a6e6b93-5766-4446-a3bf-8e2a27a837f0" pname="b" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-2bfb7992-d40c-4e37-8100-1e3a5627aa2a">
                  <syl /><neume facs="#m-b88a95bf-de13-414f-ad7b-fa83e67850a5" type="punctum" xml:id="m-ab0b3c7c-764b-4f90-a8b2-5d7e48a0c462">
                    <nc xml:id="m-c3828a1c-3141-4c50-8ec7-5b6bf94d1b78" pname="b" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-6822030e-850b-4f6a-af0b-eb4338563821">
                  <syl /><neume facs="#m-c3e9d83e-e25a-4e81-b472-819e2964dcb4" type="punctum" xml:id="m-ca9eb874-3696-4795-a435-1f18ad602bdf">
                    <nc xml:id="m-b9d33b93-892b-4f80-82d9-afa27b99df89" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-74fa1721-49d4-48cb-b225-191be6c4bb5e">
                  <syl /><neume facs="#m-169ad79b-9d36-44c8-bd3f-81a414c72833" type="punctum" xml:id="m-ae7e00df-f72c-4c65-8534-e796bdae258f">
                    <nc xml:id="m-e25113b2-65cc-477d-bc0a-774199548452" pname="a" oct="3" />
