="1001" lry="604" /><zone xml:id="m-1ea3fef7-3319-4d37-bc82-0882910fd75c" ulx="571" uly="591" lrx="824" lry="627" /><zone xml:id="m-2a839342-9458-4deb-9cc9-07e7f5e01d06" ulx="136" uly="592" lrx="559" lry="626" /><zone xml:id="m-c59f8a14-dc64-463b-b0a4-e9d9e9b9a60b" ulx="133" uly="619" lrx="559" lry="653" /><zone xml:id="m-8b7cffcd-1efe-4b3b-801b-b9bdfded6871" ulx="157" uly="659" lrx="923" lry="691" /><zone xml:id="m-f23f94c5-92c7-4fb5-a59b-59b69c8950d8" ulx="141" uly="721" lrx="202" lry="763" /><zone xml:id="m-13386e55-ee7d-4942-a7fe-ff2d628268ef" ulx="305" uly="721" lrx="774" lry="767" /><zone xml:id="m-041b894f-1e58-4744-bc66-7145730604c1" ulx="900" uly="733" lrx="1005" lry="769" /><zone xml:id="m-2876ba86-e2c9-4a3b-abaa-78838b2bcb25" ulx="512" uly="767" lrx="622" lry="802" /><zone xml:id="m-9151ebf8-4053-4882-8e2e-33a66377550c" ulx="173" uly="796" lrx="1003" lry="836" /><zone xml:id="m-ac8b9caf-7a57-4263-bd66-f0173b398cd7" ulx="143" uly="821" lrx="564" lry="861" /><zone xml:id="m-5d64b0c6-e496-4731-abf7-be105d9f7018" ulx="570" uly="825" lrx="1001" lry="864" /><zone xml:id="m-596dc130-dc23-47fc-8fe5-5a452f6d3f3d" ulx="137" uly="850" lrx="858" lry="889" /><zone xml:id="m-f4131752-5981-40da-a2e7-b0e66a9a2979" ulx="138" uly="878" lrx="574" lry="915" /><zone xml:id="m-dd40dd0d-77ce-4fb8-8d2f-46a1cc3f1ed6" ulx="160" uly="910" lrx="904" lry="948" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-83475977-9bd0-42d7-b2fe-34b7b5ed6f80" n="1684" facs="#m-acb14043-88d4-43ad-97d2-00fa4429612d" /><div xml:id="m-4b9857fa-e03b-4f88-9f4c-1738df1b362c">
            <lg xml:id="m-7813e72a-fe8a-4f61-8da4-fd1afe260775">
              <l xml:id="m-39b1941b-3905-430d-8dd3-a6987d448002" facs="#m-469a6971-4776-47a5-a080-56ed5f294d43" label="ambiguous">May 29. 30.</l><l xml:id="m-17722e5c-ab08-4953-ac7d-c5ec4b349371" facs="#m-a0bf56d7-e614-4989-ada6-78a9a4db1dac" label="ambiguous">1478</l><l xml:id="m-31d78593-09bd-4944-b72d-62b7e1b08e50" facs="#m-50cc6809-516c-4692-b889-d35c3a6b8758" label="lyrics-like">Gospel. Designávit Dóminus. p. 1373.</l><l xml:id="m-32f82b00-788d-41c9-8a9a-b8b1ab0635aa" facs="#m-b0f0a09a-eff5-4310-9cc1-21247ce71926" label="ambiguous">Secret.</l><l xml:id="m-9c27aeac-bb3b-41d6-a924-bd4e9d79dc84" facs="#m-d49b7f30-a769-4877-9c55-4f09f4ea5446" label="lyrics-like">NAcrificium tibi offérimus, Dómi-(periérunt, ad unum ovîle revérsae,</l><l xml:id="m-1b5fdedc-958c-463a-a321-99c874e06eb4" facs="#m-7e49b5a5-3e2b-4c9a-ad90-ebb92e177746" label="lyrics-like">O ne, in solemnitáte beáti Augu¬</l><l xml:id="m-38aa13f6-9cb2-4820-9332-4f9c6eaaf2f1" facs="#m-3fb486cc-14e0-4dbc-a7ba-e89d2119b5c9" label="lyrics-like">hoc salutári pábulo nutriántur. Per</l><l xml:id="m-052e1d0f-65b9-4fc7-a38f-3ab0508ff51d" facs="#m-7f841b2a-057e-4244-94d0-b767482fd69d" label="lyrics-like">stini Pontfficis et Confessóris tui,</l><l xml:id="m-630e8ae3-d5d0-46d2-9e5b-287a17447cc6" facs="#m-550f6aac-41b6-4742-9e95-a40f4f3aaac2" label="lyrics-like">Dóminum.</l><l xml:id="m-9cb17551-6f9c-4dc8-8c3f-bc1915257397" facs="#m-5a21cd50-3285-46a9-a6f6-640b9e6d4344" label="lyrics-like">humfliter deprecántes:ut oves, quaé</l><l xml:id="m-694899d5-62a8-454f-aed6-a7fa12742df3" facs="#m-388c2945-5471-4a7b-b41f-752013eb65ba" label="ambiguous">Postcommunion.</l><l xml:id="m-3d508855-4289-4810-9f87-ae827217dafe" facs="#m-620cc9b4-cc01-45d2-8435-05be55f3e0fa" label="lyrics-like">L Ostia salutári refécti : te Dómi-( suffrágio, in omni loco nómini tuo</l><l xml:id="m-3d62e098-2207-41ef-bb04-9547c0364f73" facs="#m-2e4b3528-23be-4875-8bf0-458bedf0941a" label="lyrics-like">1t ne, súpplices exorámus; ut éa- jugiter immolétur. Per Dóminum.</l><l xml:id="m-8f09a799-a6bd-40b1-ae07-fbe3c995dfad" facs="#m-b9a70ba7-b2b2-41d4-a9d2-978b74892d5d" label="lyrics-like">dem, beáti Augustini interveniénte!</l><l xml:id="m-e4e3ad23-7c6c-4122-beee-d334a195a7e5" facs="#m-46476aac-e88a-46a9-9649-b27c60184119" label="ambiguous">St. Mary Magdalen Pazzi, Virgin.</l><l xml:id="m-4d5bbe33-791d-4966-baf7-2c3d9b165dee" facs="#m-0e137122-da57-4cd4-a721-d1be83996d1d" label="ambiguous">29.</l><l xml:id="m-e5a832b5-e034-462b-ba05-7ce9c7d11d81" facs="#m-27df6439-3586-4dbd-865c-c06ba4e10f7b" label="ambiguous">Collect.</l><l xml:id="m-420fee74-a7c6-41c0-85db-5cf1990fd8f4" facs="#m-6a6a21d3-f2ff-450b-a52e-a579960c0689" label="lyrics-like">Eus, virginitátis amátor, qui lut quam festiva celebritáte venerá¬</l><l xml:id="m-6ca144b7-5788-4c84-9061-e737dabf4be1" facs="#m-e663e534-a40d-4d47-8854-66e5c0a62980" label="lyrics-like">I beátam Mariam Magdalénam</l><l xml:id="m-8e10ff8e-84f6-4cce-8380-054c10d7d2da" facs="#m-6da92a91-f4a8-4dd1-a424-9ca827e7328c" label="lyrics-like">mur,*puritáte et caritáte imité¬</l><l xml:id="m-83fe48bb-7b14-4a93-acda-667ec434e8bc" facs="#m-1ea3fef7-3319-4d37-bc82-0882910fd75c" label="lyrics-like">mur. Per Dóminum.</l><l xml:id="m-be174a5c-93a3-4e66-bc45-93a65d614be8" facs="#m-2a839342-9458-4deb-9cc9-07e7f5e01d06" label="lyrics-like">Virginem, tuo amóre succénsam,</l><l xml:id="m-55b86673-d017-49db-911d-3adea41c1cd9" facs="#m-c59f8a14-dc64-463b-b0a4-e9d9e9b9a60b" label="lyrics-like">caeléstibus donis decorásti: t da;</l><l xml:id="m-93b7a7c4-c125-4abf-a9ae-742f49253353" facs="#m-8b7cffcd-1efe-4b3b-801b-b9bdfded6871" label="lyrics-like">Secret. Accépta tibi sit. p. 1228. and Postcommunion. Satiásti. 1229.</l><l xml:id="m-8fb2f710-5b32-401f-a729-a8403d11937f" facs="#m-f23f94c5-92c7-4fb5-a59b-59b69c8950d8" label="ambiguous">30.</l><l xml:id="m-21d2527a-1452-4b97-9904-0bb287307d2e" facs="#m-13386e55-ee7d-4942-a7fe-ff2d628268ef" label="text-like">St. Felix I, Pope and Martyr.</l><l xml:id="m-c8cec126-adc3-4ee5-9593-e064c0656b9e" facs="#m-041b894f-1e58-4744-bc66-7145730604c1" label="ambiguous">Simple.</l><l xml:id="m-b2c41e5d-6204-4235-a8ac-69835fc757b7" facs="#m-2876ba86-e2c9-4a3b-abaa-78838b2bcb25" label="ambiguous">Collect.</l><l xml:id="m-23afcdde-afdd-4de2-8e46-01768b529832" facs="#m-9151ebf8-4053-4882-8e2e-33a66377550c" label="lyrics-like">(Regem tuum, Pastor aetérne, tua protectióne custódi; *quem</l><l xml:id="m-3ec13061-17bb-4972-978e-8b5f60d969bd" facs="#m-ac8b9caf-7a57-4263-bd66-f0173b398cd7" label="lyrics-like">( placátus inténde: t et per</l><l xml:id="m-7ea351f7-b198-474a-a86e-7fb1311d52cf" facs="#m-5d64b0c6-e496-4731-abf7-be105d9f7018" label="lyrics-like">totius Ecclésiae praestitisti esse pa¬</l><l xml:id="m-f22c0b69-5919-40a4-91b2-7e3cc3d83afc" facs="#m-596dc130-dc23-47fc-8fe5-5a452f6d3f3d" label="lyrics-like">beátum Felicem Mártyrem tuum stórem. Per Dóminum.</l><l xml:id="m-cb1218c8-30ec-4c91-b68e-eb93aa8ff3fc" facs="#m-f4131752-5981-40da-a2e7-b0e66a9a2979" label="lyrics-like">atque Summum Pontificem, perpé¬</l><l xml:id="m-1ba09479-8a53-4dc0-a693-ac8a4a1b3329" facs="#m-dd40dd0d-77ce-4fb8-8d2f-46a1cc3f1ed6" label="lyrics-like">Secret. Oblátis. p. 1122e. and Postcommunion. Refectióne. p. 1123.</l></lg></div></section></score></mdiv></body></music>
</mei>