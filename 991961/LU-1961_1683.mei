3" lrx="59" lry="1240" /><zone xml:id="m-ee200136-6ef4-421e-ac1e-de801a45919a" ulx="468" uly="1227" lrx="900" lry="1260" /><zone xml:id="m-5dfebb86-0fed-49c2-b775-f9cce9a89bd5" ulx="26" uly="1228" lrx="458" lry="1260" /><zone xml:id="m-b3e3b9cc-e5d0-4450-8cc7-cc5be8c7ad6b" ulx="467" uly="1254" lrx="899" lry="1289" /><zone xml:id="m-86cce372-d806-46d9-9ad4-930073a4a143" ulx="26" uly="1256" lrx="459" lry="1293" /><zone xml:id="m-4acba76a-6dc8-438b-8229-63554f5259fc" ulx="469" uly="1281" lrx="902" lry="1318" /><zone xml:id="m-50849d2e-a221-4363-b192-d4eab9066aa5" ulx="25" uly="1286" lrx="459" lry="1316" /><zone xml:id="m-00768739-719d-4d0d-8351-2eacaa6c4c59" ulx="469" uly="1307" lrx="901" lry="1345" /><zone xml:id="m-4ef53a85-5637-466e-9ff0-38c296c2203d" ulx="26" uly="1310" lrx="458" lry="1349" /><zone xml:id="m-adf0fad9-2c24-4224-9dad-fdb7d8e7bc29" ulx="26" uly="1337" lrx="457" lry="1372" /><zone xml:id="m-6e732c2a-14e9-49bf-be8a-3c9010b40113" ulx="470" uly="1337" lrx="901" lry="1371" /><zone xml:id="m-86d3c4ff-6b6a-48b3-88fd-50e6c078a425" ulx="471" uly="1362" lrx="901" lry="1397" /><zone xml:id="m-9be44e2e-90f6-46e1-8942-396bc8414e9b" ulx="25" uly="1364" lrx="459" lry="1402" /><zone xml:id="m-d4463a37-0c5a-4561-9f2d-fbc216d976d5" ulx="469" uly="1389" lrx="900" lry="1427" /><zone xml:id="m-15f44e74-6a56-4a61-8143-18d7db951b31" ulx="25" uly="1394" lrx="458" lry="1426" /><zone xml:id="m-42843deb-7b9a-48a7-b19d-fcd3bae9867a" ulx="466" uly="1417" lrx="900" lry="1451" /><zone xml:id="m-9dd355bc-1f11-49a0-b03a-5c237157e4c8" ulx="25" uly="1420" lrx="460" lry="1453" /><zone xml:id="m-c31546d5-3f01-4dc0-bbdf-3a5f12fc8ecf" ulx="467" uly="1444" lrx="901" lry="1476" /><zone xml:id="m-dd6a4ce3-41a9-4be4-9730-c9af2c91250e" ulx="25" uly="1445" lrx="459" lry="1480" /><zone xml:id="m-4b34d7c5-4288-4a5d-ae5b-041492259883" ulx="25" uly="1473" lrx="459" lry="1507" /><zone xml:id="m-bb31bf20-2d1e-4b4f-b84c-f28b474f59d6" ulx="466" uly="1475" lrx="900" lry="1509" /><zone xml:id="m-889ea498-179e-4718-915b-bb015149f4d1" ulx="25" uly="1500" lrx="457" lry="1533" /><zone xml:id="m-fa4207a8-9a36-42c7-abf6-da68b9ac50fb" ulx="468" uly="1501" lrx="897" lry="1530" /><zone xml:id="m-59a2bf53-dabf-4f96-b172-8db7059a928b" ulx="26" uly="1526" lrx="838" lry="1568" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-175aab19-b5d3-4e0a-8a39-003212952c3d" n="1683" facs="#m-e4c4cd16-9c37-4b45-b770-257e5f04b205" /><div xml:id="m-44939dc4-4ffa-4c82-b677-6681fab7198c">
            <lg xml:id="m-3d9d250d-046d-40e3-8796-8d1e30d2b397">
              <l xml:id="m-11ecaf80-1b66-42ab-9e34-52424aeb1936" facs="#m-1d90742f-319c-48b5-a739-0397d662898f" label="ambiguous">May 27. 28.</l><l xml:id="m-0be2d2e5-3978-4b4f-a43b-aa9bf0d2bfb5" facs="#m-b1d1e009-b9d7-4dfd-ab3d-05bce2766cab" label="ambiguous">1475</l><l xml:id="m-b68d83f2-e546-4a3a-96b6-dd505c58db32" facs="#m-d91c69a3-1575-426b-a251-347e0dae9eb4" label="ambiguous">Postcommunion.</l><l xml:id="m-0a7a96c0-e2dd-43a7-91e8-06062686cdda" facs="#m-415a9be4-fc70-4fd1-bb84-981595386bdc" label="lyrics-like">(Aeléstibus, Dómine, pasti deli-l tatióne, semper éadem, per quae</l><l xml:id="m-2b6d4d2f-4a73-41cb-b1a7-0590918422a3" facs="#m-d6c5efdd-fee6-4d91-abac-acc0a7bd57e2" label="lyrics-like">L cis: quaésumus; ut beáti Phi-lveráciter vivimus, appetámus. Per</l><l xml:id="m-1caefd02-5bcc-4f23-9fd0-812f6fe00ea0" facs="#m-768fffae-7663-4246-af20-a84f4fcc2885" label="lyrics-like">Isppi Confessóris tui méritis et imi-lDóminum.</l><l xml:id="m-d2f794ac-5ac0-4099-b0ab-b883fbe03efb" facs="#m-6fae8d78-a81f-4877-97ed-fccf95dc3ed3" label="lyrics-like">or st. Eleutherius. Postcommunion. Haec nos commúnio. p. 1135.</l><l xml:id="m-5d3079b9-9c38-48b2-a035-078f7757a7de" facs="#m-b538f791-de60-4d47-a4c2-9e2b098e3916" label="text-like">27. St. Bede the Venerable, Conf. and Doctor of the Church.</l><l xml:id="m-47c7b33b-1ca9-483f-b89f-88c1bc8d2375" facs="#m-990ac2b3-1efe-44a0-b4d0-61865b18ef6d" label="ambiguous">Double.</l><l xml:id="m-a094db70-5057-41da-8501-71c03833d6db" facs="#m-ceb89da0-aa6c-42b0-b268-eab8c4e86edc" label="lyrics-like">At Ist and 2nd Vespers, at Mogn. Ant. O Dóctor... beâte Béda. D. 2623.</l><l xml:id="m-f0d570af-d6ea-4393-b69e-3a3da6b92e16" facs="#m-f6b7c667-ab56-44f7-9a9f-4b7248ebe857" label="lyrics-like">Mass. In médio. from the Common of a Doctor, p. 1190. The Credo</l><l xml:id="m-9df2ed18-86ff-4097-9ea0-8049fbadfc57" facs="#m-6d140d58-5761-4122-9a22-e24f44209a9d" label="text-like">is said.</l><l xml:id="m-2e8e4ced-c970-4a62-9f50-e062cb9cceba" facs="#m-8c28c223-95f6-4f95-b2f7-97248962ee01" label="ambiguous">Collect.</l><l xml:id="m-cbd5afea-251f-41f1-8ccd-98de288d71cc" facs="#m-9064d876-87ad-4b74-bd18-f0729a28bb89" label="lyrics-like">Eus, qui Ecclésiam tuam beáti [concéde propitius fámulis tuis;</l><l xml:id="m-3f043e22-0da0-48ca-b896-067c49580cae" facs="#m-3bbe4d9f-f2e6-4844-9cbd-0c8a1b165fa4" label="lyrics-like">I Bedae Confessóris tui atquel ejus semper illustrári sapiéntia et</l><l xml:id="m-577b8818-b38c-44e5-9f88-3f39dc30005c" facs="#m-930f301c-fb66-43de-a2ff-0954c7f0d042" label="lyrics-like">Doctóris eruditióne clarfficas: t méritis adjuvári. Per Dóminum.</l><l xml:id="m-09739c05-6679-4b11-96f5-d941118c11fb" facs="#m-6882678f-5067-4d19-9252-c6072e2af63a" label="text-like">Commemoration of St. John I., Pope and Martyr.</l><l xml:id="m-90e9189e-6fa7-4392-93e0-71fa895c75d7" facs="#m-c2b8d9de-a617-41e6-af3e-ed0336f3892d" label="ambiguous">Collect.</l><l xml:id="m-16faed72-c828-4733-a4be-97548bf4ff19" facs="#m-4f0ceebe-74b5-4a3a-b9b6-09c97be8703c" label="lyrics-like">"Regem tuum, Pastor aetérne,] tua protectióne custódi; * quem</l><l xml:id="m-c7ac6c9d-e001-45b3-8501-b8a0de4c69bf" facs="#m-0c436769-ac7c-4002-b235-c2951f05b204" label="lyrics-like">(Y placátus inténde: t et per</l><l xml:id="m-0404d9d0-91c3-4d3c-a4a9-0dbcaea157ef" facs="#m-ec180864-4c95-42f2-a6d9-0fc5758eedb3" label="lyrics-like">totius Ecclésiae praestitisti esse pa¬</l><l xml:id="m-1b63e6f5-bc9c-41f4-aa8e-25a1453e4fab" facs="#m-b3894d2b-7540-4088-8a51-887feab5ff2b" label="lyrics-like">beátum Joánnem Mártyrem tuum stórem. Per Dóminum.</l><l xml:id="m-6c5c664c-b0f8-4618-a26f-d524ee8c176a" facs="#m-fc74a79c-3b4f-4023-a4ef-3a56fda6d810" label="lyrics-like">atque Summum Pontificem, perpé¬</l><l xml:id="m-13af159e-1804-4328-a5d7-a0b99cb97a3e" facs="#m-ffbed12f-6f8a-4477-9c08-7557ec6e8338" label="lyrics-like">Secret. Oblátis. p. 1122e. and Postcommunion. Refectióne. p. 1128.</l><l xml:id="m-793e0788-9d47-495b-ae48-029a7ea535ef" facs="#m-c60b1b99-1601-432c-ba87-5318e1d71e51" label="text-like">28. St. Augustine, Bishop and Confessor.</l><l xml:id="m-6521a7ef-2da0-4846-a395-364a0ecab295" facs="#m-955d9f98-7b18-4766-b460-3a0423f238ff" label="ambiguous">Doubu.</l><l xml:id="m-896da50c-72e9-44af-8dc8-951aea172fcc" facs="#m-b2799b20-f88e-48c2-bccf-ecbfb1dd978e" label="lyrics-like">Mass. Sacerdótes túi. from the Common of a Confessor Bishop, p. 1186,</l><l xml:id="m-01ec1e6e-2295-451d-a5aa-fe3d0ff6df5f" facs="#m-79060c1d-0f22-42e9-8025-75ae36490add" label="text-like">except the foltowing:</l><l xml:id="m-822ab02f-3566-45d1-8db7-c35b19fdcffc" facs="#m-60062691-d7d6-4ea1-b467-06ae845a635c" label="ambiguous">Collect.</l><l xml:id="m-a0bb21d3-5fd8-4053-b5ae-989311b336ed" facs="#m-48ce8b0a-f035-41d3-807a-85ccd398c396" label="lyrics-like">Eus, qui Anglórum gentes, prac- veniénte, errántium corda ad veri¬</l><l xml:id="m-4a3b8bbf-7b9b-4ed6-8922-8b8036e601fd" facs="#m-f5218a9a-a73a-40d2-a5e5-7b9c0f24ccd6" label="lyrics-like">U dicatióne et miráculis beáti Au- tátis tuae rédeant unitátem, *et nos</l><l xml:id="m-faf4b0ba-a3f7-4504-aa73-6f3a8c94d888" facs="#m-fd253905-6597-45d2-a456-a48c302d318b" label="lyrics-like">gustini Confessóris tui atque Ponti-lin tua simus voluntáte concórdes¬</l><l xml:id="m-a73980fe-037b-49d4-ba5f-27b5850e567e" facs="#m-1f99f750-a746-4ca0-8b07-fd8c6e318753" label="lyrics-like">Per Dóminum nostrum Jesum Chri¬</l><l xml:id="m-75e32103-d603-4fe0-8cd8-7ffe24495737" facs="#m-e006bcda-9d33-492a-aab7-ae0275a08a30" label="lyrics-like">ficis, verae fidei luce illustrâre di¬</l><l xml:id="m-c9e18979-a08a-4c7a-b169-f411448b0147" facs="#m-5523ee60-40ac-4a6f-9c35-4c741cc7efd3" label="lyrics-like">gnátus es:t concéde; ut ipso inter- stum Filium tuum.</l><l xml:id="m-9f8f0a3b-5b66-45f7-a496-7073438bc8e0" facs="#m-79f590a2-7527-45ef-a514-317f54895966" label="ambiguous">Lectio Epistolae beati Pauli Apostoli ad Thessalonicenses.</l><l xml:id="m-265e37c3-dd1e-4048-bfa5-607760999fd1" facs="#m-a91dc1e2-5f91-44e3-a781-1459f3cb11fc" label="ambiguous">1. Thess. 2.</l><l xml:id="m-512483f1-5349-498b-a715-d84dde6f26bc" facs="#m-828521f4-4c65-4fca-978a-3e32c8ca4232" label="lyrics-like">LRatres : Fidúciam habúimus in riam, neque a vobis neque ab</l><l xml:id="m-7960711e-e383-408d-a8e1-d175050757dc" facs="#m-0a7303ec-1047-4a48-bc07-6321874d001e" label="lyrics-like">áliis; cum possémus vobis óneri</l><l xml:id="m-4e206e67-22ab-4f41-bb2d-735e39180d47" facs="#m-6965700c-4269-4c9a-9df1-b9a9f1b8ae7a" label="ambiguous">Deo nostro loqui ad vos Evan¬</l><l xml:id="m-477fee39-5738-4671-bedf-b7edff99998d" facs="#m-ab4fcc7d-e1a3-45c5-9701-c590a8364868" label="ambiguous">1</l><l xml:id="m-c1a8d4f1-55f2-4a7f-821a-9cfd2c16a3bf" facs="#m-ee200136-6ef4-421e-ac1e-de801a45919a" label="lyrics-like">esse ut Christi Apóstoli: sed facti</l><l xml:id="m-67d14669-cecf-4929-b6ca-952bdc8df0b7" facs="#m-5dfebb86-0fed-49c2-b775-f9cce9a89bd5" label="lyrics-like">gélium Dei in multa sollicitúdine.</l><l xml:id="m-ed430b25-6da1-46a2-99bb-03fb20bfb061" facs="#m-b3e3b9cc-e5d0-4450-8cc7-cc5be8c7ad6b" label="lyrics-like">sumus párvuli in médio vestrum,</l><l xml:id="m-ff6ff596-79ea-48a2-a6de-80fde1437e2b" facs="#m-86cce372-d806-46d9-9ad4-930073a4a143" label="lyrics-like">Exhortátio enim nostra non de</l><l xml:id="m-bf432753-ca70-4c6b-b1e1-6f659bdcc0c7" facs="#m-4acba76a-6dc8-438b-8229-63554f5259fc" label="lyrics-like">tamquam si nutrix fóveat filios</l><l xml:id="m-7e017277-be2a-4b1d-90b2-f588368f687b" facs="#m-50849d2e-a221-4363-b192-d4eab9066aa5" label="lyrics-like">erróre neque de immunditia neque</l><l xml:id="m-63b5ada6-7e14-44b9-9256-60f3e24e1905" facs="#m-00768739-719d-4d0d-8351-2eacaa6c4c59" label="lyrics-like">suos. Ita desiderántes vos, cúpide</l><l xml:id="m-0b82d82b-f156-4e0a-9e03-4614fd685a71" facs="#m-4ef53a85-5637-466e-9ff0-38c296c2203d" label="lyrics-like">in dolo, sed sicut probáti sumus a</l><l xml:id="m-3a777bc2-64bc-45ec-bce4-a60ecb3c3dc8" facs="#m-adf0fad9-2c24-4224-9dad-fdb7d8e7bc29" label="lyrics-like">Deo, ut crederétur nobis Evangé¬</l><l xml:id="m-20a89999-a612-4ccb-a31b-7d7394a58420" facs="#m-6e732c2a-14e9-49bf-be8a-3c9010b40113" label="lyrics-like">volebámus trádere vobis non solum</l><l xml:id="m-55359036-b7dd-439b-8e05-88f97d0b31aa" facs="#m-86d3c4ff-6b6a-48b3-88fd-50e6c078a425" label="lyrics-like">Evangélium Dei, sed étiam ánimas</l><l xml:id="m-5f531458-a126-4e98-8b05-da5683fb286f" facs="#m-9be44e2e-90f6-46e1-8942-396bc8414e9b" label="lyrics-like">lium: ita lóquimur, non quasi</l><l xml:id="m-9835b670-35bd-4e85-baf3-3be044be134c" facs="#m-d4463a37-0c5a-4561-9f2d-fbc216d976d5" label="lyrics-like">nostras; quóniam carissimi nobis</l><l xml:id="m-6fa3ae73-126f-4088-9c61-033cbd1fb772" facs="#m-15f44e74-6a56-4a61-8143-18d7db951b31" label="lyrics-like">homínibus placéntes, sed Deo, qui</l><l xml:id="m-90d7fdef-df6f-4b02-8531-1da5266de99e" facs="#m-42843deb-7b9a-48a7-b19d-fcd3bae9867a" label="lyrics-like">facti estis. Mémores enim estis, fra¬</l><l xml:id="m-0b8306b9-c831-4517-81c6-af51e0625ad5" facs="#m-9dd355bc-1f11-49a0-b03a-5c237157e4c8" label="ambiguous">probat corda nostra. Neque enim</l><l xml:id="m-ffaf86a8-ef9a-4215-997e-779b3cb6dd0a" facs="#m-c31546d5-3f01-4dc0-bbdf-3a5f12fc8ecf" label="lyrics-like">tres, labóris nostri et fatigatiónis:</l><l xml:id="m-2cefba45-a8c5-4c26-9381-bae9f8ebe382" facs="#m-dd6a4ce3-41a9-4be4-9730-c9af2c91250e" label="lyrics-like">aliquándo fuimus in sermône adu¬</l><l xml:id="m-56eb68c7-b88f-484f-9a47-a1a6311e3c14" facs="#m-4b34d7c5-4288-4a5d-ae5b-041492259883" label="lyrics-like">latiónis, sicut scitis; neque in occa¬</l><l xml:id="m-46e7ad5f-2a4b-41b3-91c4-8659e4e96d02" facs="#m-bb31bf20-2d1e-4b4f-b84c-f28b474f59d6" label="lyrics-like">nocte ac die operántes, ne quem</l><l xml:id="m-ea048916-b272-481e-b812-b2f2d4b90681" facs="#m-889ea498-179e-4718-915b-bb015149f4d1" label="lyrics-like">sióne avaritiae: Deus testis est:</l><l xml:id="m-fc97d70d-bf83-4820-8ccb-eec88b7687eb" facs="#m-fa4207a8-9a36-42c7-abf6-da68b9ac50fb" label="lyrics-like">vestrum gravarémus, praedicávi¬</l><l xml:id="m-2fe410fe-8ec4-48e9-b5f3-6567d51c7162" facs="#m-59a2bf53-dabf-4f96-b172-8db7059a928b" label="lyrics-like">nec quaeréntes ab hominibus gló¬ mus in vobis Evangélium Dei</l></lg></div></section></score></mdiv></body></music>
</mei>