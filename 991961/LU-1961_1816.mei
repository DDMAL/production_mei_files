 lrx="873" lry="699" /><zone xml:id="m-da0b67d6-3e83-4314-a0fd-b7a86412cb48" ulx="116" uly="746" lrx="939" lry="793" /><zone xml:id="m-f001ea6c-253d-4973-905d-c3facc3c816c" ulx="487" uly="792" lrx="651" lry="833" /><zone xml:id="m-ca5efc37-ae7a-4624-a1d8-b4a337f454ec" ulx="511" uly="834" lrx="627" lry="876" /><zone xml:id="m-15ba7a01-822b-4824-9289-abcc89faec2b" ulx="162" uly="867" lrx="1016" lry="904" /><zone xml:id="m-b90daa95-723f-4312-a030-a7aed7c1c1e1" ulx="118" uly="896" lrx="557" lry="933" /><zone xml:id="m-6b0ade28-c8db-45d8-89d7-3e67354aa335" ulx="573" uly="899" lrx="1014" lry="932" /><zone xml:id="m-1eab0615-3cde-465a-ad10-664503307c76" ulx="574" uly="924" lrx="764" lry="964" /><zone xml:id="m-690aad8a-e2ac-4dc8-99fb-0bfeed2c4ad3" ulx="118" uly="925" lrx="561" lry="962" /><zone xml:id="m-d3c2d9f5-76ac-4960-a64d-52aa14a6333a" ulx="117" uly="953" lrx="566" lry="991" /><zone xml:id="m-f60814a3-cfa2-4850-a45f-59a3c2014c79" ulx="139" uly="988" lrx="465" lry="1026" /><zone xml:id="m-4efb81f3-7126-4483-8333-664897ad2977" ulx="444" uly="1035" lrx="687" lry="1070" /><zone xml:id="m-e691f8a0-853a-4eb6-ad0e-ca518054c909" ulx="141" uly="1071" lrx="1016" lry="1115" /><zone xml:id="m-4edd1226-9962-4511-9d1a-5ffcb968f582" ulx="118" uly="1103" lrx="561" lry="1143" /><zone xml:id="m-ff260567-dc5a-4521-977c-dff01bcca5e3" ulx="569" uly="1104" lrx="1015" lry="1139" /><zone xml:id="m-24fb6e10-cbfd-4ea1-9d58-812852d31367" ulx="571" uly="1133" lrx="712" lry="1173" /><zone xml:id="m-18a60549-0248-4285-ada1-c58216b0bc01" ulx="118" uly="1134" lrx="563" lry="1164" /><zone xml:id="m-3785c6f9-4c6b-4898-b7f1-24f6e544504b" ulx="118" uly="1162" lrx="562" lry="1198" /><zone xml:id="m-46713a10-d0aa-4ba8-897f-4db0d107dd0f" ulx="121" uly="1281" lrx="162" lry="1324" /><zone xml:id="m-4655aabd-43fc-4508-845e-91d3ab673ad3" ulx="291" uly="1282" lrx="847" lry="1327" /><zone xml:id="m-e644ddab-592a-492c-be2a-8bcf2b024f66" ulx="910" uly="1284" lrx="1016" lry="1323" /><zone xml:id="m-4e34be49-7dca-462c-ab49-5ba4bba0d277" ulx="147" uly="1342" lrx="439" lry="1381" /><zone xml:id="m-bd1f20b5-cc17-4e36-8194-061c284f0df9" ulx="512" uly="1385" lrx="624" lry="1420" /><zone xml:id="m-e0eb60a6-6c86-415a-abb0-ba6e19248391" ulx="163" uly="1424" lrx="1018" lry="1466" /><zone xml:id="m-7ffd3f41-c40d-40d4-bef6-344ec596985d" ulx="125" uly="1452" lrx="1018" lry="1490" /><zone xml:id="m-bed57bb2-ba75-4d15-9b66-0ab9db3d7554" ulx="121" uly="1482" lrx="565" lry="1518" /><zone xml:id="m-99cdcdc9-c30d-4158-81e3-ddfce0482581" ulx="574" uly="1483" lrx="1019" lry="1515" /><zone xml:id="m-177eada5-3e78-4e53-9ab6-940216c70634" ulx="121" uly="1508" lrx="566" lry="1548" /><zone xml:id="m-f09d257a-80ff-43ba-9dd2-0ef07b6b4369" ulx="571" uly="1510" lrx="1018" lry="1549" /><zone xml:id="m-d81a8759-1189-419b-8346-bb02da856940" ulx="121" uly="1537" lrx="691" lry="1578" /><zone xml:id="m-50c2737b-dcdc-4e9f-ae45-95513bfe729a" ulx="146" uly="1581" lrx="678" lry="1621" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-1bf83271-e5dc-43a0-b906-553a96a0b6b9" n="1816" facs="#m-f5ca3151-987f-42f4-b675-a9fa3d0b4a1f" /><div xml:id="m-86987fa8-7a71-48c2-adc3-e102c883e758">
            <lg xml:id="m-33589db6-ba93-405f-8bf6-a871a1d9ef82">
              <l xml:id="m-b45a8f56-59ab-4067-9648-d2bb541a80d7" facs="#m-f6f5cc1e-408f-44f7-a6b4-c1d3614bd9ae" label="ambiguous">1592</l><l xml:id="m-b36a9995-6fe8-4a2a-b6d6-de52d1fc4dfb" facs="#m-ad4f8805-68a3-4276-80af-eb9e3677f2e1" label="ambiguous">August S. 9.</l><l xml:id="m-0f8df04e-5156-4e51-b9e4-cc3e4eb00dbf" facs="#m-392c6fbc-b79e-4361-ba45-b8fb1fecd527" label="text-like">Commemoration of St. Donatus, Bishop and Martyr.</l><l xml:id="m-e84eea27-7536-46df-98a8-bab6302662e3" facs="#m-5891db06-b717-4695-b58b-6522578b66ca" label="ambiguous">Collect.</l><l xml:id="m-1cd430a1-7ce0-4b57-b7b3-27bdc52634c1" facs="#m-79d57b99-d653-466f-9e69-613a2801cf9b" label="lyrics-like">Eus tuórum glória Sacerdótum:*(cujus festa gérimus, sentiámus auxí¬</l><l xml:id="m-ebe69dd3-1897-4a21-814c-ff85e277ffb3" facs="#m-1568c5a7-464e-4ea2-83d8-bf6a2f5ef819" label="lyrics-like">U praesta quaésumus; ut sancti llium. Per Dóminum.</l><l xml:id="m-551e4921-370e-4572-b69f-411ddd64a145" facs="#m-9a65361a-0d60-4f1a-aaf3-6ad5a0db92d7" label="lyrics-like">Mártyris tui et Episcopi Donáti,</l><l xml:id="m-6d0746d3-2928-4fd2-827b-d30bc9df38cb" facs="#m-0e912287-0cc1-4d29-9144-87fe7fd669f3" label="lyrics-like">Gospel. Nemo potest duóbus dóminis servire. p. 1038.</l><l xml:id="m-62f2a20a-22e7-4a4d-bdaa-ab83c49417f8" facs="#m-65bef131-990d-45dd-88aa-32d3c14fe3d7" label="lyrics-like">Secret. Praesta nobis, quaésumus. p. 1206.</l><l xml:id="m-566d3c00-af7c-4007-bc70-62b22082f09c" facs="#m-b81bf1d5-a33f-4ac5-9e2d-ddc0179f9141" label="text-like">of St. Donatus. Secret.</l><l xml:id="m-ccc09ca8-ef77-4644-9cb7-161b69eb672c" facs="#m-0ec1a0f3-ecdb-456a-a8ea-47a6b5657642" label="lyrics-like">DRaesta, quaésumus Dómine: ut! dem nóminis tui dicátis munéribus</l><l xml:id="m-5edff65f-76c6-4c5c-b26f-4248f8cb66a2" facs="#m-a93a774f-57f5-49ac-b77c-c972e53ce97d" label="lyrics-like">Lsancti Mártyris tui et Episcopi l honorámus, piae nobis fructus devo¬</l><l xml:id="m-4b80af09-245a-4e18-9dd0-1087f4452a41" facs="#m-b8ea1a71-ece1-4e25-978f-a293e7cd770a" label="lyrics-like">Donáti intercessióne, quem ad lau-l tiónis accréscat. Per Dóminum.</l><l xml:id="m-e3dcf26d-9033-4138-ab54-130418aefca4" facs="#m-b12bddda-d97a-4789-9992-e50263e2c95c" label="lyrics-like">Postcommunion. Quaésumus omnípotens Deus. p. 1206.</l><l xml:id="m-7a5999d8-2d6d-45e0-b2e5-08278dd5231d" facs="#m-5827735c-86db-48ce-b1ae-6691401de8e5" label="text-like">of St. Donatus. Postcommunion.</l><l xml:id="m-ecc7d02f-fb35-4f29-a060-c32b43413dbd" facs="#m-1d090d25-da62-4f4f-aa70-19e382810553" label="lyrics-like">Mnípotens et miséricors Deus, dénte beáto Donáto Mártyre tuo</l><l xml:id="m-6ad845e5-9269-4a4e-a7c4-44948bc8a045" facs="#m-74b3389e-c294-49e3-bf40-a72933a68e4b" label="lyrics-like">atque Pontifice, ejúsdem proficiá¬</l><l xml:id="m-b55f3d26-609f-4d10-a198-772c40cf4506" facs="#m-e0682402-34f4-43b9-b7f1-3793bd3d0a09" label="lyrics-like">U qui nos sacramentórum tuórum</l><l xml:id="m-78d2aeb9-aecb-40f4-b8f4-7a3d66356825" facs="#m-b485b8e3-c431-4725-ba34-9188e17363bd" label="lyrics-like">et partícipes éfficis et ministros: mus et fidei consórtio, et digno</l><l xml:id="m-0b315cbd-b355-4ce6-9ae1-a5b631e21cee" facs="#m-4334db91-c31b-4e5d-8383-5401fdb32553" label="lyrics-like">praesta quaésumus; ut, interce-l servitio. Per Dóminum.</l><l xml:id="m-a9e30beb-b2bd-44ee-81b9-0a92203b6a9f" facs="#m-da0b67d6-3e83-4314-a0fd-b7a86412cb48" label="text-like">8. SS. Cyriacus, Largus, and Smaragdus, Martyrs.</l><l xml:id="m-eb400286-fe34-4632-b45d-84f1a91e7c11" facs="#m-f001ea6c-253d-4973-905d-c3facc3c816c" label="ambiguous">Semi-double.</l><l xml:id="m-9ed4c6d5-81e7-4fe4-9d51-5908e27b3ad5" facs="#m-ca5efc37-ae7a-4624-a1d8-b4a337f454ec" label="ambiguous">Collect.</l><l xml:id="m-fcb6e845-1312-4ac7-97c1-ddb12e118ac6" facs="#m-15ba7a01-822b-4824-9289-abcc89faec2b" label="lyrics-like">Eus, qui nos ánnua sanctórum! quorum natalitia cólimus, * virtú¬</l><l xml:id="m-d0f7dadf-4e89-49ce-9401-3a796aef4835" facs="#m-b90daa95-723f-4312-a030-a7aed7c1c1e1" label="lyrics-like">O Mártyrum tuórum Cyriaci,</l><l xml:id="m-a7e6afed-654b-4642-bb5f-2a699d0e1844" facs="#m-6b0ade28-c8db-45d8-89d7-3e67354aa335" label="lyrics-like">tem quoque passiónis imitémur.</l><l xml:id="m-1b7f8893-cc5e-458b-a03c-63ce49ed0e85" facs="#m-1eab0615-3cde-465a-ad10-664503307c76" label="lyrics-like">Per Döminum.</l><l xml:id="m-3872e754-9f22-460c-bb3f-cc1746b66d5e" facs="#m-690aad8a-e2ac-4dc8-99fb-0bfeed2c4ad3" label="lyrics-like">Largi et Smarágdi solemnitáte</l><l xml:id="m-c6509637-1cd1-4428-9fc5-195bba06eae7" facs="#m-d3c2d9f5-76ac-4960-a64d-52aa14a6333a" label="lyrics-like">laetfficas: t concéde propitius; ut</l><l xml:id="m-1a7accb6-7e2f-4cb3-9f5c-a6b58104e0fd" facs="#m-f60814a3-cfa2-4850-a45f-59a3c2014c79" label="lyrics-like">Secret. Accépta sit. p. 1141.</l><l xml:id="m-2c75bb92-210c-46eb-b905-2c4d4f17f1e2" facs="#m-4efb81f3-7126-4483-8333-664897ad2977" label="ambiguous">Postcommunion.</l><l xml:id="m-5a3f65ad-0a1d-4699-ab2c-3594d0ee56d3" facs="#m-e691f8a0-853a-4eb6-ad0e-ca518054c909" label="lyrics-like">»Efécti participatióne múneris ribus tuis Cyríaco, Largo et Sma¬</l><l xml:id="m-63f1db61-7179-47e4-af74-887e1ccd91cd" facs="#m-4edd1226-9962-4511-9d1a-5ffcb968f582" label="lyrics-like">L sacri, quaésumus Dómine Deus</l><l xml:id="m-c7e01db1-9357-4565-bdfa-e1931a38b97d" facs="#m-ff260567-dc5a-4521-977c-dff01bcca5e3" label="lyrics-like">rágdo, sentiámus efféctum. Per</l><l xml:id="m-07315fb7-ca65-4730-b4c2-89dd32b65a01" facs="#m-24fb6e10-cbfd-4ea1-9d58-812852d31367" label="lyrics-like">Dóminum.</l><l xml:id="m-1813d54a-7e8a-4114-9ceb-68ab9855d7aa" facs="#m-18a60549-0248-4285-ada1-c58216b0bc01" label="lyrics-like">noster: ut cujus exséquimur cul¬</l><l xml:id="m-259f07cb-8772-484e-929b-44a2f7449f38" facs="#m-3785c6f9-4c6b-4898-b7f1-24f6e544504b" label="lyrics-like">tum, intercedéntibus sanctis Marty¬</l><l xml:id="m-acc45d0c-065a-42a4-b2a8-2c1381f28eaa" facs="#m-46713a10-d0aa-4ba8-897f-4db0d107dd0f" label="ambiguous">9.</l><l xml:id="m-0fd93472-43ed-472e-8d71-29c805748229" facs="#m-4655aabd-43fc-4508-845e-91d3ab673ad3" label="ambiguous">St. John Mary Vianney, Confessor.</l><l xml:id="m-c68bf9a9-3012-46e4-961e-83d025e0141f" facs="#m-e644ddab-592a-492c-be2a-8bcf2b024f66" label="lyrics-like">Douôle.</l><l xml:id="m-998b4974-97d8-4add-b85b-b0b925d2ca9a" facs="#m-4e34be49-7dca-462c-ab49-5ba4bba0d277" label="lyrics-like">Mass. Os jústi. p. 1200.</l><l xml:id="m-73d079b0-06ec-466d-9b0d-969c9383e2a1" facs="#m-bd1f20b5-cc17-4e36-8194-061c284f0df9" label="ambiguous">Collect.</l><l xml:id="m-a5b96712-5824-4311-b365-e4879c8c9f0a" facs="#m-e0eb60a6-6c86-415a-abb0-ba6e19248391" label="lyrics-like">Mnípotens et miséricors Deus,  exémplo et intercessióne, ánimas</l><l xml:id="m-6c671aff-1125-433f-9691-859a64eaf2c7" facs="#m-7ffd3f41-c40d-40d4-bef6-344ec596985d" label="lyrics-like">U qui sanctum Joánnem Mariam fratrum lucrári Christo, * et cum</l><l xml:id="m-ec117440-e631-4c5b-8fee-4558be3841b2" facs="#m-bed57bb2-ba75-4d15-9b66-0ab9db3d7554" label="lyrics-like">pastoráli stúdio et jugi oratiónis</l><l xml:id="m-4b4fe6a5-f1b1-4d33-821e-f85bdbcab2c2" facs="#m-99cdcdc9-c30d-4158-81e3-ddfce0482581" label="lyrics-like">eis aetérnam glóriam cónsequi va¬</l><l xml:id="m-b9e331a8-e9ea-458b-b2dd-45a6d2ac664e" facs="#m-177eada5-3e78-4e53-9ab6-940216c70634" label="lyrics-like">ac paeniténtiae ardóré mirábilem</l><l xml:id="m-1206b2ed-d399-4d63-aace-51cfb1237f8d" facs="#m-f09d257a-80ff-43ba-9dd2-0ef07b6b4369" label="lyrics-like">leámus. Per eúmdem Dóminum</l><l xml:id="m-d3a6769f-5a02-4a64-aca3-1fc4be70e3d8" facs="#m-d81a8759-1189-419b-8346-bb02da856940" label="lyrics-like">effecisti :t da, quaésumus; ut, ejus nostrum.</l><l xml:id="m-92aa9ac8-4bf6-4984-9913-16023026e4c0" facs="#m-50c2737b-dcdc-4e9f-ae45-95513bfe729a" label="text-like">Commemoration of St. Romanus, Martyr.</l></lg></div></section></score></mdiv></body></music>
</mei>