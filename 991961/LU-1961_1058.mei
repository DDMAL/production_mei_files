        <zone xml:id="m-95c23912-a923-47da-9719-eea6762af244" ulx="54" uly="29" lrx="86" lry="47" /><zone xml:id="m-7377e9b9-f7a6-4104-bf93-a752cd3471c6" ulx="225" uly="31" lrx="328" lry="48" /><zone xml:id="m-c0725fc5-155e-43dd-9538-2d99382d3c2e" ulx="73" uly="51" lrx="499" lry="74" /><zone xml:id="m-a94b3554-b2b2-4a12-9e7f-bcee8b53de92" ulx="54" uly="67" lrx="265" lry="87" /><zone xml:id="m-7aa3d36c-0e66-4160-96a5-ae1a6c6fb3fb" ulx="74" uly="81" lrx="500" lry="107" /><zone xml:id="m-d57cd935-0e6f-420d-8b1c-5286aa562bb3" ulx="54" uly="95" lrx="119" lry="114" /><zone xml:id="m-932c4a5f-747f-4fe6-b418-5ea595710b30" ulx="74" uly="108" lrx="500" lry="134" /><zone xml:id="m-0352b38b-96c5-4b0d-84d8-81312bd9d867" ulx="54" uly="126" lrx="188" lry="145" /><zone xml:id="m-5ebb00bb-31b5-415a-8900-958df16b9dbd" ulx="73" uly="139" lrx="499" lry="162" /><zone xml:id="m-97956f10-1eda-4c6b-a442-5c118f69db04" ulx="54" uly="158" lrx="153" lry="177" /><zone xml:id="m-ed95fe90-817c-4c87-848b-6b6cb2b71ed7" ulx="74" uly="172" lrx="499" lry="195" /><zone xml:id="m-d856ae5a-9f26-4c40-928c-5bd43774b746" ulx="54" uly="185" lrx="157" lry="206" /><zone xml:id="m-e81ec6f1-b9fe-4113-a15c-b62fd1e5e927" ulx="68" uly="199" lrx="500" lry="223" /><zone xml:id="m-e372a691-87d7-4166-94f9-8880495e15c8" ulx="55" uly="217" lrx="260" lry="233" /><zone xml:id="m-3ba67459-1069-49f2-a9f8-5468bcaeaa7d" ulx="68" uly="229" lrx="500" lry="253" /><zone xml:id="m-f416df83-ae05-4cec-8d5c-8b1a788163a0" ulx="56" uly="247" lrx="126" lry="266" /><zone xml:id="m-15b22d15-ebf6-4144-b66c-31bdd0216984" ulx="68" uly="259" lrx="455" lry="282" /><zone xml:id="m-db4e479b-63d7-4b3e-8d2c-23be0aa83a8a" ulx="69" uly="278" lrx="488" lry="298" /><zone xml:id="m-9a7ce96a-0d03-4544-a812-06ad66acc953" ulx="69" uly="295" lrx="501" lry="314" /><zone xml:id="m-b71ce8be-57a7-4115-8a05-e8d97e72529f" ulx="56" uly="310" lrx="350" lry="329" /><zone xml:id="m-412656bf-6191-40c0-b828-3d07cc4c265d" ulx="69" uly="325" lrx="501" lry="346" /><zone xml:id="m-67db2322-db30-4e9e-b8c1-4de35ff559ac" ulx="56" uly="340" lrx="283" lry="360" /><zone xml:id="m-ae3e7d90-e57d-4660-8774-dcc72e2e11b5" ulx="69" uly="355" lrx="501" lry="378" /><zone xml:id="m-ea748bbd-9d34-45d7-a354-f3fc89f6888a" ulx="56" uly="371" lrx="133" lry="392" /><zone xml:id="m-77fdd7a0-9d61-4926-a84c-fcdf8ab9f386" ulx="69" uly="388" lrx="502" lry="410" /><zone xml:id="m-95cbd61b-4e59-42e6-8b20-ba247bb2697a" ulx="57" uly="401" lrx="218" lry="419" /><zone xml:id="m-1738a774-b142-4bea-95c2-742fff0937ae" ulx="69" uly="415" lrx="502" lry="439" /><zone xml:id="m-2f37c778-81dd-4623-8932-34a7e8c2016b" ulx="57" uly="432" lrx="231" lry="450" /><zone xml:id="m-623e6364-cccc-4afe-afad-b54006e20764" ulx="69" uly="445" lrx="501" lry="469" /><zone xml:id="m-05eed0e5-59a5-4dc5-bddd-4ef1a7040dff" ulx="56" uly="460" lrx="133" lry="480" /><zone xml:id="m-eaa77fd2-06c8-4643-bf52-531402f13596" ulx="69" uly="475" lrx="423" lry="496" /><zone xml:id="m-86b52a58-e677-4d0a-9052-d9931b154620" ulx="69" uly="493" lrx="502" lry="515" /><zone xml:id="m-a261cba3-c69c-4e6e-8386-6bd04be854d5" ulx="56" uly="510" lrx="232" lry="527" /><zone xml:id="m-c12cf4fc-5ecb-4932-8e01-3daceccc8a3f" ulx="69" uly="524" lrx="503" lry="546" /><zone xml:id="m-0f93214a-c687-4cd8-953e-45b0bb2d9cea" ulx="56" uly="540" lrx="105" lry="561" /><zone xml:id="m-a04f2d44-e46f-4155-ac03-aaeff93041e1" ulx="69" uly="557" lrx="503" lry="578" /><zone xml:id="m-58816f5c-c01c-41c3-99d7-7dd920f73b9c" ulx="56" uly="570" lrx="336" lry="588" /><zone xml:id="m-6ec74d7c-a1c8-4929-933d-d170c8e57e17" ulx="69" uly="589" lrx="504" lry="610" /><zone xml:id="m-c01e53f8-c2c2-4d31-8611-e9e8f89e83e9" ulx="57" uly="604" lrx="108" lry="618" /><zone xml:id="m-d0897269-9ebe-472e-aec8-f7838515865f" ulx="69" uly="615" lrx="504" lry="639" /><zone xml:id="m-5ee1040f-b25a-4b08-991f-e16528767fea" ulx="57" uly="632" lrx="164" lry="650" /><zone xml:id="m-66376276-eed0-45de-a84d-356dc3c0be20" ulx="70" uly="644" lrx="504" lry="666" /><zone xml:id="m-5f195225-2f19-419f-b74d-d1d60b67c261" ulx="57" uly="662" lrx="143" lry="681" /><zone xml:id="m-35897e1c-2108-4116-9eea-59ca7f7e2b19" ulx="69" uly="676" lrx="503" lry="697" /><zone xml:id="m-a4c2170f-f8c0-4fc3-9066-1a1418bf84b6" ulx="57" uly="693" lrx="224" lry="712" /><zone xml:id="m-a4d04e5d-af4d-43b5-b053-ac051744ad7d" ulx="70" uly="707" lrx="443" lry="729" /><zone xml:id="m-c4ca39ba-24d0-40d3-9185-803b57dbb373" ulx="70" uly="724" lrx="408" lry="745" /><zone xml:id="m-d2cc2278-f56d-4aec-a870-76590e8fa92f" ulx="70" uly="741" lrx="504" lry="770" /><zone xml:id="m-7d4b8122-1e97-4431-8f29-9219a954bacd" ulx="58" uly="756" lrx="118" lry="778" /></surface>
    </facsimile>
    <body xml:id="m-f530bab1-237e-4f6f-b2bb-cd6a7008a970">
      <mdiv xml:id="m-5e258897-edad-42a6-965f-feb72feb42a4" type="solesmes">
        <score xml:id="m-91192ba1-5e22-48f1-8d08-368a38e22f4f">
          <section xml:id="m-1fe37851-4941-48fb-a323-c61ade51c1db">
            <pb xml:id="m-72fd91db-8f1e-40cd-ace2-6c9f12463abc" n="1058" facs="#m-f9bc3a42-6b7c-4ff4-b921-6af2afa98473" />
            <div xml:id="m-717c283b-18f4-46bc-9d46-f55bb9a7f336">
              <lg xml:id="m-c0dcb369-b67f-4031-b4c4-fc5263d1c459">
                <l xml:id="m-70f9b151-028d-41bb-bea9-81dd1f4fb4a4" facs="#m-95c23912-a923-47da-9719-eea6762af244" label="ambiguous">870</l><l xml:id="m-494c792a-3040-4aee-a264-4bc83d9184d1" facs="#m-7377e9b9-f7a6-4104-bf93-a752cd3471c6" label="text-like">wnit sunday.</l><l xml:id="m-00381340-544e-4f92-b825-320d65562b05" facs="#m-c0725fc5-155e-43dd-9538-2d99382d3c2e" label="lyrics-like">5. Exsultáte in conspéctu ejus : * turbabúntur a fácie éjus, pátris</l><l xml:id="m-811341af-e85a-4297-af7a-82189e8c3cfe" facs="#m-a94b3554-b2b2-4a12-9e7f-bcee8b53de92" label="lyrics-like">orphanórum, et júdicis manárum.</l><l xml:id="m-cf1167fa-5239-4613-bede-c0ddfb10d3de" facs="#m-7aa3d36c-0e66-4160-96a5-ae1a6c6fb3fb" label="lyrics-like">8, Déus in toco sáncto suo : * Déus qui inhabitáre fácit únius móris</l><l xml:id="m-dc94d298-0626-493d-b393-2ecaf707d87b" facs="#m-d57cd935-0e6f-420d-8b1c-5286aa562bb3" label="ambiguous">in domo:</l><l xml:id="m-94fbc749-3abe-420d-aa4b-337d2efe4f64" facs="#m-932c4a5f-747f-4fe6-b418-5ea595710b30" label="lyrics-like">7. Qui edúcit vinctos in fortitudine, * simfliter éos, qui exásperant, qui</l><l xml:id="m-0fe5776a-2847-4963-baed-53057a57d95c" facs="#m-0352b38b-96c5-4b0d-84d8-81312bd9d867" label="lyrics-like">hábitant ta sepulcris.</l><l xml:id="m-fab4e0fe-e639-477a-9d78-dd64aebd451c" facs="#m-5ebb00bb-31b5-415a-8900-958df16b9dbd" label="lyrics-like">8. Déus, cum egrederéris in conspéctu pópuli tui, * cum pertrans¬</l><l xml:id="m-b11072ae-df8d-471b-8e0c-56b0348d0a22" facs="#m-97956f10-1eda-4c6b-a442-5c118f69db04" label="lyrics-like">tres in desérto:</l><l xml:id="m-ace0c461-ee1d-4673-8798-4cbbd5ca0eb0" facs="#m-ed95fe90-817c-4c87-848b-6b6cb2b71ed7" label="lyrics-like">9. Térra móta est, étenim caéli distillavérunt a fácie Déi Sinai, "a</l><l xml:id="m-679bc3d7-57b3-4747-bfb6-512072b3ca05" facs="#m-d856ae5a-9f26-4c40-928c-5bd43774b746" label="lyrics-like">fácie Del Israci.</l><l xml:id="m-56811745-b03e-48e7-bf46-da2095fa10df" facs="#m-e81ec6f1-b9fe-4113-a15c-b62fd1e5e927" label="lyrics-like">10. Plúviam voluntáriam segregábis, Déus, hereditáti túae :* et infir¬</l><l xml:id="m-4fd19413-f54d-44b1-8e57-000a6d95a541" facs="#m-e372a691-87d7-4166-94f9-8880495e15c8" label="lyrics-like">máta est, tu vero perfecisti éam.</l><l xml:id="m-bf165ad5-0d6a-40b2-a190-92c8fab5d723" facs="#m-3ba67459-1069-49f2-a9f8-5468bcaeaa7d" label="lyrics-like">11. Animália túa habitábunt in éa : * parásti in dulcédine túa páu¬</l><l xml:id="m-a2dacfc4-5f19-4667-bab9-90c975e4ef4e" facs="#m-f416df83-ae05-4cec-8d5c-8b1a788163a0" label="ambiguous">pert. Deus.</l><l xml:id="m-f88bbe63-aa2a-44e3-8211-7a34f9658490" facs="#m-15b22d15-ebf6-4144-b66c-31bdd0216984" label="lyrics-like">12. Dominus dábit vérbum evangelizántibus, » virtute múlta.</l><l xml:id="m-bfeed496-3767-458c-ae86-bcce5df54596" facs="#m-db4e479b-63d7-4b3e-8d2c-23be0aa83a8a" label="lyrics-like">13. Rex virtútum dilécti dilécti : * et speciéi dómus dividere spólia.</l><l xml:id="m-e5d5b536-e8e2-400f-b551-096bbe138793" facs="#m-9a7ce96a-0d03-4544-a812-06ad66acc953" label="lyrics-like">14. Si dormiátis inter médios cléros, t pénnae colúmbae deargen¬</l><l xml:id="m-de0ecb97-b695-4f3d-b26f-81b346a94696" facs="#m-b71ce8be-57a7-4115-8a05-e8d97e72529f" label="lyrics-like">tátae, " et posterióra dórsi éjus in pallôre auri.</l><l xml:id="m-a553120e-88db-4614-a799-bc7da2807181" facs="#m-412656bf-6191-40c0-b828-3d07cc4c265d" label="lyrics-like">15. Dum discérnit caeléstis réges super éam, f nive dealbabúntur in</l><l xml:id="m-4d8930e0-7b46-4fe1-874f-279ef1ddfa7a" facs="#m-67db2322-db30-4e9e-b8c1-4de35ff559ac" label="lyrics-like">selmon : * mons Dét, mons pinguis.</l><l xml:id="m-7f7846d5-623f-4eaf-a6a6-6a0a46421a7e" facs="#m-ae3e7d90-e57d-4660-8774-dcc72e2e11b5" label="lyrics-like">16. Mons coagulátus, mons pinguis :* ut quid suspicámini móntes</l><l xml:id="m-33e037bb-4219-40ef-a6a8-e18502207921" facs="#m-ea748bbd-9d34-45d7-a354-f3fc89f6888a" label="lyrics-like">coagulátos?</l><l xml:id="m-a36aa781-adb9-45b5-9836-18ead985f18a" facs="#m-77fdd7a0-9d61-4926-a84c-fcdf8ab9f386" label="lyrics-like">17. Mons, in quo beneplácitum est Déo habitáre in éo :* étenim Dó¬</l><l xml:id="m-68197840-02f3-4666-a1d0-23eab679fb7b" facs="#m-95cbd61b-4e59-42e6-8b20-ba247bb2697a" label="lyrics-like">minus habitáoit 'in finem.</l><l xml:id="m-416f9d7a-df41-4f17-b897-f1352db8f757" facs="#m-1738a774-b142-4bea-95c2-742fff0937ae" label="lyrics-like">18. Cúrrus Déi decem milibus múltiplex, millia lactántium :* Dómi¬</l><l xml:id="m-0b031dbd-646a-4a56-bb71-f02311055392" facs="#m-2f37c778-81dd-4623-8932-34a7e8c2016b" label="lyrics-like">nus in éis in Sina tn sáncto.</l><l xml:id="m-fb2ca427-b293-441c-bfd3-76b900752489" facs="#m-623e6364-cccc-4afe-afad-b54006e20764" label="lyrics-like">19. Ascendisti in áltum, cepisti captivitâtem : * accepisti dóna in</l><l xml:id="m-93eb2f37-242d-426f-8351-769024a7e90f" facs="#m-05eed0e5-59a5-4dc5-bddd-4ef1a7040dff" label="ambiguous">hominibus:</l><l xml:id="m-c6dbe06f-bc1b-418d-b0da-2a286709f79d" facs="#m-eaa77fd2-06c8-4643-bf52-531402f13596" label="lyrics-like">20. Etenim non credéntes, * inhabitâre Dóminum Déum.</l><l xml:id="m-27b489c1-c93f-4aa9-beaf-9e3c1436df6a" facs="#m-86b52a58-e677-4d0a-9052-d9931b154620" label="lyrics-like">21. Benedictus Dóminus die quotidie : * prósperum iter fáciet nóbis</l><l xml:id="m-c0741b4f-607b-45e6-9606-4f33c4bf3c68" facs="#m-a261cba3-c69c-4e6e-8386-6bd04be854d5" label="lyrics-like">Déus salutárium nostrórum.</l><l xml:id="m-d42d4c42-905a-4b0c-af33-d81f3e2800a6" facs="#m-c12cf4fc-5ecb-4932-8e01-3daceccc8a3f" label="lyrics-like">22. Déus nóster, Déus sálvos faciéndi : * et Dómini Dómini éxitus</l><l xml:id="m-f328c3f7-32c5-4b9f-832c-7521a816c2f9" facs="#m-0f93214a-c687-4cd8-953e-45b0bb2d9cea" label="lyrics-like">mórtis.</l><l xml:id="m-5fc923de-e887-4d0a-b27d-2bbf13fbca3b" facs="#m-a04f2d44-e46f-4155-ac03-aaeff93041e1" label="lyrics-like">23. Verúmtamen Déus confringet cápita inimicórum suorum :* vér¬</l><l xml:id="m-6bfac91f-8a8f-432a-a5e1-6da57422f44f" facs="#m-58816f5c-c01c-41c3-99d7-7dd920f73b9c" label="lyrics-like">ticem capilli perambulántium in deticiis suis</l><l xml:id="m-70d8075e-bc17-4a4f-b6ee-d1c6ace2d733" facs="#m-6ec74d7c-a1c8-4929-933d-d170c8e57e17" label="lyrics-like">24. Dixit Dóminus : Ex Basan convértam, 4 convértam in profándam</l><l xml:id="m-0f26518d-4bf8-468e-a2fc-b564de03585c" facs="#m-c01e53f8-c2c2-4d31-8611-e9e8f89e83e9" label="lyrics-like">máris:</l><l xml:id="m-1bf45bd8-72f0-4f75-a15a-59ed90aa297a" facs="#m-d0897269-9ebe-472e-aec8-f7838515865f" label="lyrics-like">25. Ut intingátur pes túus in sánguine : * lingua cánum tuórum ex</l><l xml:id="m-1efa4592-50ac-4cb2-b53a-53d1ceb3cc97" facs="#m-5ee1040f-b25a-4b08-991f-e16528767fea" label="ambiguous">inimicts, «b ipso.</l><l xml:id="m-12a062d3-fdc7-4a7d-89e6-daf31d6b9579" facs="#m-66376276-eed0-45de-a84d-356dc3c0be20" label="lyrics-like">26. Vidérunt ingréssus túos, Déus, * ingréssus Déi méi, régis méi qui</l><l xml:id="m-59951e57-9033-43f6-be36-cd9af05e386f" facs="#m-5f195225-2f19-419f-b74d-d1d60b67c261" label="lyrics-like">est in sáncto.</l><l xml:id="m-7e581456-0c8b-477d-a68b-2a4fde071ed0" facs="#m-35897e1c-2108-4116-9eea-59ca7f7e2b19" label="lyrics-like">27. Praevenérunt principes conjúncti psallentibus, * in médio juven¬</l><l xml:id="m-f384ee48-6610-41ef-937f-edce02037fe3" facs="#m-a4c2170f-f8c0-4fc3-9066-1a1418bf84b6" label="lyrics-like">culárum tympanistriãrum.</l><l xml:id="m-87034471-db9f-439b-8cdc-aeaea79050fe" facs="#m-a4d04e5d-af4d-43b5-b053-ac051744ad7d" label="lyrics-like">28. In ccclésis benedicite Déo Domino, * de fontibus Israel.</l><l xml:id="m-1da8a50d-15b3-40bf-ae09-a84e6800f0cc" facs="#m-c4ca39ba-24d0-40d3-9185-803b57dbb373" label="lyrics-like">29. Ibi Bénjamin adolescéntulus, * in méntts excéssu.</l><l xml:id="m-ba403a1c-1b2c-4127-8e28-f6f9726cade0" facs="#m-d2cc2278-f56d-4aec-a870-76590e8fa92f" label="lyrics-like">30 Principes Juda, dúces corum:: principes Zabulon, principes</l><l xml:id="m-9992b847-7681-4d7b-bd39-4cf714176062" facs="#m-7d4b8122-1e97-4431-8f29-9219a954bacd" label="lyrics-like">Néphtali.</l></lg>
            </div>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>