434" /><zone xml:id="m-47b40461-370e-475b-8598-f7c817653181" ulx="438" uly="401" lrx="801" lry="436" /><zone xml:id="m-78fabd07-17f9-4ebc-b2c3-ea2890d93937" ulx="27" uly="424" lrx="425" lry="457" /><zone xml:id="m-470bbbe5-19ba-435d-a363-08715afa28e4" ulx="465" uly="427" lrx="596" lry="465" /><zone xml:id="m-ec9df39b-0c53-4be2-9bbc-65cd66aebc27" ulx="27" uly="451" lrx="426" lry="489" /><zone xml:id="m-dc698194-1652-41f2-a03e-be96adc2a1ac" ulx="135" uly="491" lrx="250" lry="528" /><zone xml:id="m-00bae918-e8a2-40b2-bfc4-972d8ba6adbf" ulx="569" uly="497" lrx="728" lry="534" /><zone xml:id="m-a393ccf4-d731-4bb1-b5e6-1bc40f6b50f4" ulx="41" uly="523" lrx="835" lry="563" /><zone xml:id="m-b323c4b6-a3b2-4451-8161-40515dfb41bd" ulx="31" uly="556" lrx="833" lry="588" /><zone xml:id="m-24a13c51-9048-47de-8106-4cce020a1f75" ulx="27" uly="582" lrx="834" lry="619" /><zone xml:id="m-a215ae45-7fd7-4e55-84a7-7e65e0738815" ulx="27" uly="608" lrx="657" lry="641" /><zone xml:id="m-de0758fa-7221-4579-a571-3551659f1fe2" ulx="48" uly="642" lrx="832" lry="680" /><zone xml:id="m-167cc9d7-0ed4-4b17-b22b-127b6ccc3fe2" ulx="25" uly="671" lrx="595" lry="706" /><zone xml:id="m-eb269fc0-36e4-490c-9d48-5fc7d6d63746" ulx="51" uly="705" lrx="759" lry="747" /><zone xml:id="m-3ddbd4dd-57cb-414e-b7ca-fb306c1dc75a" ulx="49" uly="748" lrx="835" lry="787" /><zone xml:id="m-384f2147-429c-477e-9ef9-f111cdf3f97f" ulx="27" uly="779" lrx="229" lry="811" /><zone xml:id="m-593d2dca-5291-4863-a16d-a414acb5d9b4" ulx="53" uly="810" lrx="834" lry="849" /><zone xml:id="m-2cefabb6-b78b-440c-a703-844bc7e3f07c" ulx="27" uly="839" lrx="834" lry="873" /><zone xml:id="m-60ffc726-e232-4adb-a86c-c3fd6d9789fc" ulx="27" uly="859" lrx="746" lry="900" /><zone xml:id="m-fd375cd3-3cb9-4860-b5c7-59dafc9ff987" ulx="50" uly="889" lrx="835" lry="930" /><zone xml:id="m-683d3ded-32f4-4b9f-a38e-4faef2bca4b9" ulx="27" uly="912" lrx="789" lry="955" /><zone xml:id="m-7db39ba6-d095-421b-876b-27437bd50688" ulx="48" uly="948" lrx="838" lry="995" /><zone xml:id="m-374e132d-b9c4-4860-9cc3-359534487574" ulx="27" uly="978" lrx="837" lry="1018" /><zone xml:id="m-a637f966-440f-412d-a4c3-3b5339c50b94" ulx="28" uly="998" lrx="837" lry="1046" /><zone xml:id="m-da9ac5dd-e685-4a32-8764-8999dda15b53" ulx="28" uly="1034" lrx="231" lry="1068" /><zone xml:id="m-0064f47b-cd55-4cfd-970d-ae30cbdb54ed" ulx="65" uly="1425" lrx="208" lry="1459" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-fb6c3541-7c26-462e-a362-382cfa5b065e" n="0897" facs="#m-1d361f7a-cbd6-4d10-9283-c74c73b805c7" /><div xml:id="m-4dd64f07-45cb-401e-a941-618b3039bb15">
            <lg xml:id="m-a6ce67f1-d11b-474e-a139-04f86a4dc370">
              <l xml:id="m-6a6ef16c-dfb7-432b-9b5b-96884e692a29" facs="#m-2a90c825-7bd5-4183-a146-28ed1c86f0dc" label="text-like">The Solemn afternoon Liturgy</l><l xml:id="m-78fe147d-1eff-4a78-9b67-bca348eebde1" facs="#m-6da1e37b-4b75-4d3c-a074-48977c9270f1" label="ambiguous">751</l><l xml:id="m-840a8f97-d60f-4edf-9709-1e3fe923e30d" facs="#m-7ef70b10-b694-431e-9d12-619b0da978d8" label="lyrics-like">orémus.</l><l xml:id="m-a0136442-dafa-4b79-a85d-09020f979dc1" facs="#m-a6d6ab84-184d-4805-afee-80a285f59083" label="text-like">First prayer</l><l xml:id="m-d6a83edd-1806-4b40-92b2-f204c7a40306" facs="#m-53094c7b-b5f9-4764-bae8-eac6d9b0c8ac" label="lyrics-like">Uper pópulum tuum, quaésu- consolátio tribuátur, fides sancta</l><l xml:id="m-92999eb6-726c-46e1-9266-4180e4e4f11a" facs="#m-db331f4e-cebf-4c04-b3df-0836723ea808" label="lyrics-like">O mus, Domine, qui passiónem</l><l xml:id="m-004489d2-cda9-4a5a-980f-d45c75b2a62c" facs="#m-1a93e20c-9f85-49ff-b40e-1640c1a6ecbb" label="lyrics-like">succréscat, redémptio sempi¬</l><l xml:id="m-e8fb440e-e566-4e83-b434-4a655ffc106f" facs="#m-ef3b8fde-b883-421f-9fdc-4fcb562e832b" label="lyrics-like">et mortem Filii tui devóta mente</l><l xml:id="m-ea90afc1-8059-49da-b22b-3b0195a7a3da" facs="#m-e3d7963b-fd32-4bf6-9da0-0061c6ea8823" label="lyrics-like">térna firmétur. Per eúmdem Chri¬</l><l xml:id="m-e65152e2-b531-410a-8e10-9777345f309e" facs="#m-913e6848-c78d-456e-be2c-a460001ed4db" label="lyrics-like">recóluit, f benedictio copiósa de¬</l><l xml:id="m-88dffcef-c424-43e2-800e-d5a45f53d35d" facs="#m-187c005a-7136-4945-89e4-389a909ddb88" label="lyrics-like">stum Dóminum nostrum.</l><l xml:id="m-a0adae77-73b5-4a34-a640-a29d70605b51" facs="#m-bf553a13-20d0-4cf7-87ef-be75036d1ee4" label="lyrics-like">scéndat, * indulgéntia véniat,</l><l xml:id="m-ae2dcece-6fc1-4688-a265-6369529129cb" facs="#m-481195f3-eedc-4e4f-8dae-96ce8040ad6e" label="ambiguous">K. Amen.</l><l xml:id="m-45d44416-2d92-41d2-8082-a2dd05903a44" facs="#m-43bd0ff7-305d-42de-806a-db9436ebfa4d" label="lyrics-like">Orémus.</l><l xml:id="m-b115c370-f2d1-4629-bc27-25be30f726b9" facs="#m-6580021c-f1f8-4058-970d-1267997b5b80" label="text-like">Second prayer</l><l xml:id="m-fd342ccd-e88f-4982-bb0a-b59d1fb86987" facs="#m-01d2461f-471d-4105-b197-b8d98312ec98" label="lyrics-like">Mnípotens et miséricors Deus,</l><l xml:id="m-e87be656-5ab0-41d4-845b-384e491b82c7" facs="#m-677eb01d-21d1-4d9d-b2f6-4089f649b310" label="lyrics-like">stérii participatióne, perpétua de¬</l><l xml:id="m-f7375992-04be-461f-b4d5-34af0517328f" facs="#m-13698c85-e0e3-4f2e-bc48-f2625f40d948" label="lyrics-like">U qui Christi tui beâta pas¬</l><l xml:id="m-30a7d334-b356-4ad5-8e85-8678062e930f" facs="#m-5202152b-3f25-4787-927c-e28f2b392dc5" label="lyrics-like">votióne vivámus. Per eúmdem</l><l xml:id="m-d76739cc-115b-4911-9e3a-1ba4c7e3cd11" facs="#m-37a62867-f8dd-4d85-ba26-618a8f7fd783" label="lyrics-like">sióne et morte nos reparásti: !</l><l xml:id="m-fc9722b4-79bb-42ef-b2ef-8db41e87a6d2" facs="#m-47b40461-370e-475b-8598-f7c817653181" label="lyrics-like">Christum Dóminum nostrum.</l><l xml:id="m-1572c505-db03-4e6a-8f24-354380401318" facs="#m-78fabd07-17f9-4ebc-b2c3-ea2890d93937" label="lyrics-like">consérva in nobis óperam mise¬</l><l xml:id="m-cec44254-5eeb-47aa-88c3-836de3089088" facs="#m-470bbbe5-19ba-435d-a363-08715afa28e4" label="ambiguous">W. Amen.</l><l xml:id="m-eeb74aad-aa1e-46f2-8f60-13a808a899ff" facs="#m-ec9df39b-0c53-4be2-9bbc-65cd66aebc27" label="lyrics-like">ricórdiae tuae; * ut, hujus my¬</l><l xml:id="m-ae0fb410-9657-41d4-9b92-08c167f0d94d" facs="#m-dc698194-1652-41f2-a03e-be96adc2a1ac" label="lyrics-like">orémus.</l><l xml:id="m-872b340e-7a37-4464-98f9-b649d34fb97a" facs="#m-00bae918-e8a2-40b2-bfc4-972d8ba6adbf" label="text-like">Third prayer</l><l xml:id="m-2d3521fb-0fb7-4ff2-8b90-055890a93411" facs="#m-a393ccf4-d731-4bb1-b5e6-1bc40f6b50f4" label="lyrics-like">DEminiscere miseratiónum tuá- tuus, per suum cruórem, instí¬</l><l xml:id="m-166ee1a2-92d2-49fe-9d21-a572a85caf18" facs="#m-b323c4b6-a3b2-4451-8161-40515dfb41bd" label="lyrics-like">It rum, Dómine, f et fámulos tuit paschâle mystérium. Per</l><l xml:id="m-f38614cd-d9de-4336-aafc-6be68178dc99" facs="#m-24a13c51-9048-47de-8106-4cce020a1f75" label="lyrics-like">tuos aetérna protectióne sancti¬umdem Christum Dóminum no¬</l><l xml:id="m-88d747b6-7327-4d0b-9f07-558764624b43" facs="#m-a215ae45-7fd7-4e55-84a7-7e65e0738815" label="ambiguous">fica,  pro quibus Christus, Filius strum. W. Amen.</l><l xml:id="m-863e0bf8-a117-4b57-8d50-e38fb63b5005" facs="#m-de0758fa-7221-4579-a571-3551659f1fe2" label="text-like">36. The celebrant and the sacred ministers go doum the altar steps, genufiect,</l><l xml:id="m-8f788a67-a9a4-4f2c-8417-dcefe628e5f3" facs="#m-167cc9d7-0ed4-4b17-b22b-127b6ccc3fe2" label="text-like">and return to the sacristy with the acolytes lor serversl.</l><l xml:id="m-a097e7a1-d58c-4f8f-b2a0-fee81b7cb801" facs="#m-eb269fc0-36e4-490c-9d48-5fc7d6d63746" label="text-like">The high altar is stripped bare, except for the Cross and candlestichs.</l><l xml:id="m-f9666283-0d9a-452d-baad-ed92517050c9" facs="#m-3ddbd4dd-57cb-414e-b7ca-fb306c1dc75a" label="text-like">37. To-day Vespers are omitted. Compline is recited in choir, p. 686; the</l><l xml:id="m-4b372448-b23d-448d-a3a5-a5f75305ea99" facs="#m-384f2147-429c-477e-9ef9-f111cdf3f97f" label="text-like">candles are not lit.</l><l xml:id="m-45f18483-c766-4275-ae5a-59c7534a7ee9" facs="#m-593d2dca-5291-4863-a16d-a414acb5d9b4" label="text-like">38. At a convenient time the Blessed Sacrament is brought privately to</l><l xml:id="m-c3ef99db-e3bd-4c9c-beba-338b2233d27f" facs="#m-2cefabb6-b78b-440c-a703-844bc7e3f07c" label="lyrics-like">a place of reservation: a lamp burns there as usual. The high altãr is</l><l xml:id="m-7c10edaa-ff60-4a3a-bad0-eb76b6654fee" facs="#m-60ffc726-e232-4adb-a86c-c3fd6d9789fc" label="text-like">stripped by the acolytes [serversl, leaving only the Cross and candles.</l><l xml:id="m-a7198ad4-307f-453f-856b-a271bb95fa90" facs="#m-fd375cd3-3cb9-4860-b5c7-59dafc9ff987" label="text-like">In private recitation of the Divine Office, Vespers are said by those who</l><l xml:id="m-84ed8992-714a-478c-a58b-c697876cdd95" facs="#m-683d3ded-32f4-4b9f-a38e-4faef2bca4b9" label="text-like">have not been present at the afternoon Liturgy as indicated above, p. 687.</l><l xml:id="m-3d6ff252-8123-40de-9020-d7a8877d61e7" facs="#m-7db39ba6-d095-421b-876b-27437bd50688" label="text-like">Priests who have charge of two or more parishes may be allowed by the</l><l xml:id="m-7237b573-27ba-4368-8dbd-b007434f00e9" facs="#m-374e132d-b9c4-4860-9cc3-359534487574" label="lyrics-like">Bishop of the diocese tõ repeat the Good Friday Liturgy, but not in the</l><l xml:id="m-90af84b8-0ea4-4a31-9d9f-7ebfb318a55d" facs="#m-a637f966-440f-412d-a4c3-3b5339c50b94" label="text-like">same parish, and only within the limits of time shown above, p. 720,</l><l xml:id="m-3988c8af-9b22-4dd8-bcff-07afddfa0de2" facs="#m-da9ac5dd-e685-4a32-8764-8999dda15b53" label="text-like">for its celebration.</l><l xml:id="m-ccace158-73b1-45e2-83b0-655368ff70aa" facs="#m-0064f47b-cd55-4cfd-970d-ae30cbdb54ed" label="ambiguous">No so1. — 29</l></lg></div></section></score></mdiv></body></music>
</mei>