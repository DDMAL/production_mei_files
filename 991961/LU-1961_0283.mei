                <syllable xml:id="m-d061a878-8fcb-4f20-bb5a-d882830d8252">
                  <syl /><neume facs="#m-38243577-2c87-4cbd-9256-ad35f897e3c4" type="punctum" xml:id="m-6941db3c-214e-40e6-8531-beaed80ecde5">
                    <nc xml:id="m-de00024b-2076-46e1-8128-c4bb6db96392" pname="a" oct="3" />
                  </neume>
                </syllable>
                <syllable xml:id="m-c1de74a9-7848-412a-be06-881b3601d170">
                  <syl /><neume facs="#m-5c70b829-df4c-4de0-8fd1-4fe261d30f44" type="podatus" xml:id="m-906135f7-bca4-442a-8879-aed4644029da">
                    <nc xml:id="m-99677312-9857-4ed5-8f24-fbfd894fad61" pname="a" oct="3" />
                    <nc xml:id="m-2d89f01a-e667-4a72-a87d-25983d4fc047" pname="b" oct="3" />
