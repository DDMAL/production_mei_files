d450-4c1e-86b9-5db7b35f0e9e" ulx="498" uly="1313" lrx="933" lry="1347" /><zone xml:id="m-47ebb338-aa55-46f8-8bd8-48512efb7daa" ulx="79" uly="1337" lrx="453" lry="1373" /><zone xml:id="m-e4ce612f-d64b-4e83-8f14-114da14c1bf7" ulx="498" uly="1340" lrx="935" lry="1373" /><zone xml:id="m-b010cb74-2ade-429a-8ca7-07423b41748b" ulx="499" uly="1370" lrx="935" lry="1404" /><zone xml:id="m-1496977f-ed4f-4fd7-ac9c-086ed1df6464" ulx="60" uly="1374" lrx="484" lry="1411" /><zone xml:id="m-736198bb-a1d3-4cfa-a70b-cb952885d9e7" ulx="498" uly="1399" lrx="574" lry="1433" /><zone xml:id="m-37cab655-23e6-4da5-908a-80dc3d46151f" ulx="52" uly="1408" lrx="486" lry="1442" /><zone xml:id="m-b3ba150a-7ef8-489f-a704-b8c0a767ed84" ulx="528" uly="1428" lrx="935" lry="1467" /><zone xml:id="m-3ddfc582-ff37-427d-9ddd-d0c25a9a7909" ulx="50" uly="1431" lrx="486" lry="1465" /><zone xml:id="m-ef36491c-fe33-4dd4-b82b-b5cc95b40090" ulx="50" uly="1459" lrx="485" lry="1492" /><zone xml:id="m-b7ef99fd-53e9-4ae1-b65d-ac6f4f3e1225" ulx="499" uly="1460" lrx="934" lry="1492" /><zone xml:id="m-fb9aa136-75c7-49fc-bad2-6409557c2482" ulx="51" uly="1486" lrx="486" lry="1522" /><zone xml:id="m-01cc63f5-7d98-40b5-8b50-2624357673db" ulx="499" uly="1486" lrx="933" lry="1523" /><zone xml:id="m-e9e0b479-0fc3-4aa6-8b03-2e135305fdc9" ulx="52" uly="1513" lrx="485" lry="1548" /><zone xml:id="m-00b20a8b-dfe1-4a2b-8634-7539e8f37c4a" ulx="498" uly="1513" lrx="934" lry="1547" /><zone xml:id="m-429aae4a-42fa-41a9-90be-686421577ff3" ulx="51" uly="1544" lrx="179" lry="1580" /><zone xml:id="m-c5f5a0a2-369d-432f-9555-345a7cb745db" ulx="499" uly="1546" lrx="834" lry="1581" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-df17e901-3e3f-4fbe-96a9-eb25f286f986" n="0115" facs="#m-ff3ebc26-5755-47a5-9627-2310ed71d350" /><div xml:id="m-e1f763b6-be07-4498-bf28-98727c5c7a17">
            <lg xml:id="m-75d775a9-cb78-47ff-927f-8181a810b1ce">
              <l xml:id="m-2f78e20d-49e1-40ed-95f4-c52ff5d6661b" facs="#m-0028459a-d94c-46f4-97e5-38102627fa20" label="text-like">The Ordinary of the Mass.</l><l xml:id="m-cff57e4c-9513-4f05-bfa7-cbffee18936c" facs="#m-93c1c521-cbda-4e8c-84b3-a9fb05b50664" label="ambiguous">5</l><l xml:id="m-d1e10c39-da09-4c7f-8b30-2d657d4eaf27" facs="#m-287b4994-4b00-4a79-8538-af9ebb56e5b4" label="lyrics-like">néli, Cypriáni, Lauréntij, Chrysó¬</l><l xml:id="m-2924ec4e-35af-4ec0-8a99-34ce498bf65b" facs="#m-289d20ca-03ad-4994-a130-02378b881055" label="ambiguous">HIC EST ENIM CALIX SANGUINIS</l><l xml:id="m-57c45174-6272-4e78-abf6-23c19b403d91" facs="#m-9f20793c-3e12-4a56-a588-4fd0a66ed177" label="lyrics-like">goni, Joánnis et Pauli, Cosmaë et</l><l xml:id="m-eeef3a24-b050-4281-938c-b3600cd16d8e" facs="#m-51be7ec1-f4cb-4618-be31-e52cfb52881f" label="ambiguous">MEI, NOVI ET AETERNI TESTA¬</l><l xml:id="m-26e25115-14c0-48b9-a12b-c255889f9949" facs="#m-d22b764b-cc31-4297-a231-01b9bcbb3ee2" label="lyrics-like">Damiáni: et ómnium Sanctórum</l><l xml:id="m-73177a26-b5d1-4650-b1f4-a3a57725e0bb" facs="#m-104bc939-81ff-470d-9ff6-28ccbcc9059a" label="ambiguous">MENTI: MYSTERIUM FIDEI QUI</l><l xml:id="m-71b21884-efe3-4702-964e-ac52a4cee839" facs="#m-28e0f33c-f694-4bda-801f-1ccf970ef0f2" label="lyrics-like">tuórum; quorum méritis, precibús¬</l><l xml:id="m-150d8f4a-ace7-4c17-b279-fdaa4383904c" facs="#m-9d00b241-4054-4ba2-83b1-7de32311f0f2" label="ambiguous">PRO VOBIS ET PRO MULTIS EFFUN¬</l><l xml:id="m-800e342f-360d-4d77-a696-58439364a637" facs="#m-b0b3bff3-891f-4146-b0d9-fdf2a8b4c073" label="ambiguous">DETUR IN REMISSIONEM PECCA¬</l><l xml:id="m-88259cff-53c6-4ff1-aef1-73a62b502c21" facs="#m-f70106a7-47ac-41e3-9105-3e3146488bfd" label="lyrics-like">que concédas, ut in ómnibus pro¬</l><l xml:id="m-6eff7301-2461-4b2a-b527-64d6ac391e6a" facs="#m-c7de7a12-a503-4780-955d-ce793d5a9426" label="lyrics-like">tectiónis tuae muniámur auxilio.</l><l xml:id="m-5a54cb4d-6224-4aa3-b8be-a59efa3b0f6d" facs="#m-6537913d-aec5-41e5-9ff9-fc2aa8a19588" label="ambiguous">TORUM.</l><l xml:id="m-dad8d97b-be43-448d-b4e2-d1cbdd224253" facs="#m-da3c5e79-d63a-48f4-9799-3bf9486bcc3e" label="lyrics-like">Per eúmdem Christum Dóminum</l><l xml:id="m-1f4f8d08-5fee-4c04-8917-d474a1eb30e0" facs="#m-de036e94-13fb-46a3-a9fe-ff3c8afd68d1" label="lyrics-like">Haec quotiescúmque fecéritis, in</l><l xml:id="m-c6890a3f-7aac-4aa3-a4fa-8b445dc74d5f" facs="#m-62c0091b-0cc4-43f3-bcde-1e6d745729d1" label="ambiguous">nostrum. Amen.</l><l xml:id="m-424e9dd3-2105-40d8-8ab1-186f15c863a8" facs="#m-88aa2d03-69eb-4503-b172-2e9e3b017a2b" label="lyrics-like">mei memóriam faciétis.</l><l xml:id="m-d3119b7d-988d-451f-9dc4-f6aa91436c97" facs="#m-bd5f17d4-bce8-4a5c-b3cf-e9fa2fe4b045" label="lyrics-like">Hanc ígitur oblatiónem servitútis</l><l xml:id="m-1a26fd08-fff5-4b5b-a5b1-d7c27c3d13ce" facs="#m-3b92ea4c-adf8-4793-8272-9a098bbe8bea" label="lyrics-like">7TNde et mémores, Dómine, nos</l><l xml:id="m-7241b360-38fd-416d-a332-3544948b52eb" facs="#m-e7f07cbd-bb91-4924-a41c-6cbd9d12a128" label="ambiguous">nostrae, sed et cunctae familiae</l><l xml:id="m-d3131f17-5f2f-49e8-95a8-d8bb09fac5b2" facs="#m-6dfc9037-d728-4cb0-b5b8-83f0bd4ead32" label="ambiguous">U servi tui, sed et plebs tua sancta,</l><l xml:id="m-42103cb1-bf69-4913-815f-51f88642a49c" facs="#m-dd9166f1-6220-4f46-8682-fc41ca951f1b" label="ambiguous">tuae,</l><l xml:id="m-f3fda320-067a-4899-bab8-7ee82a1b47b2" facs="#m-c194ae9a-b219-4784-ba3e-1eb2cc3d8e15" label="lyrics-like">ejusdem Christi Fili tui Dómini</l><l xml:id="m-c2fc9cce-99bf-4642-aa2a-262c2a1a33ee" facs="#m-f1c29c01-640c-4c4d-b7d0-459c30978960" label="lyrics-like">nostri tam beátae passiónis, nec non</l><l xml:id="m-2c9cd01a-7640-489e-aa69-7a8a102b4bbb" facs="#m-ffeb0187-ce88-4e73-8786-e5f1a1bb7854" label="text-like">During the Octaves of Easter and</l><l xml:id="m-7b99b657-cd58-454f-bc23-67965768029a" facs="#m-429f9f07-b9ba-474b-b8cc-9d1356bdc6c4" label="lyrics-like">et ab inferis resurrectiónis, sed et</l><l xml:id="m-161c86c6-6ba8-4388-bfd3-628ae0816891" facs="#m-7a67cc1b-3310-4303-8bd9-e710b86706de" label="ambiguous">Pentecost:</l><l xml:id="m-3359c119-ef0d-42a2-ae59-16ab5a39625f" facs="#m-21923ed3-b165-490a-99e4-24d8235584b8" label="lyrics-like">in caelos gloriósac ascensiónis: of¬</l><l xml:id="m-2ee814b8-20f5-45d1-acf3-70453a192754" facs="#m-29e8b906-cf6f-4b59-a886-321566b3cd5f" label="lyrics-like">quam tibi offérimus pro his quoque, quos</l><l xml:id="m-2b954bc2-e7e6-4796-b9c8-c9ab9f536589" facs="#m-0bf0c4f4-183c-4aa2-8e30-ec9c93cf6d26" label="lyrics-like">férimus praeclárae majestáti tuae</l><l xml:id="m-24356647-5221-44a1-9c3b-1e6d16ad15d9" facs="#m-3f4cbeed-3792-409e-8baf-623bf3291163" label="lyrics-like">regeneráre dignátus es ex aqua et Spí¬</l><l xml:id="m-2773b309-9fdf-4f12-8dde-5be01f1a3bf3" facs="#m-8c3d085e-5f09-453b-b68a-80a90320f5be" label="lyrics-like">de tuis donis, ac datis, hóstiam pu¬</l><l xml:id="m-ba94eba0-4453-4828-9e75-839799c37108" facs="#m-7d2ab43c-99b8-42c7-9489-4d89fa53a0c8" label="lyrics-like">ritu Sancto, tribuens eis remissiónem</l><l xml:id="m-0a6e18a2-c6f4-4996-8b0e-fa8062114842" facs="#m-9531d591-7df4-4fb8-9780-5f79885f81d6" label="lyrics-like">ram, hóstiam sanctam, hóstiam im¬</l><l xml:id="m-0692f285-7960-4755-97a2-7d865deb94eb" facs="#m-5480dda1-f350-4d30-bb35-5ba31a611106" label="lyrics-like">ómnium peccatórum,</l><l xml:id="m-4a72f3cb-5967-4f0a-96fc-5d6c83663a8d" facs="#m-d842c2fc-f258-49ed-a2d4-e921b5fef0c6" label="lyrics-like">maculátam, Panem sanctum vitae</l><l xml:id="m-fe749f67-e8c2-42fe-a02b-c2763b5b1de1" facs="#m-3909502a-a473-47b9-b819-a5a12e82c4a8" label="lyrics-like">aetérnae, et Cálicem salútis perpé¬</l><l xml:id="m-fa76e6ac-1c5a-433e-a8bc-90497b334527" facs="#m-57131bcf-4303-46a0-a3f2-e17362a028bd" label="lyrics-like">quaésumus Dómine, ut placátus</l><l xml:id="m-0e1b2a8b-5fb7-4629-ad7a-a29d7eff4936" facs="#m-7f6fe36d-746e-4bd9-a847-6a67556214f7" label="ambiguous">tuae.</l><l xml:id="m-67526a63-579f-4157-867d-bc07ce19c16b" facs="#m-d72988d9-ab7c-4e97-a8bf-73b4730ff19c" label="lyrics-like">accipias: diésque nostros in tua pace</l><l xml:id="m-052f0b03-f507-47e8-8e80-f2f18ede54ce" facs="#m-2d003635-7cb7-4a7f-8047-48b681165511" label="lyrics-like">Supra quae propítio ac seréno</l><l xml:id="m-57183d4b-3a79-4b2d-bc44-a22b04b76fea" facs="#m-66aac04c-3f92-4d32-9eec-92e35dc49f6f" label="lyrics-like">dispónas, atque ab aetérna damna¬</l><l xml:id="m-3c27c88f-60ca-4864-ab97-0240232dc6e3" facs="#m-d34251b1-2c00-4d6d-993d-f3c7589c77f3" label="lyrics-like">vultu respscere dignéris: et accépta</l><l xml:id="m-63ac954a-fd52-411d-9a21-fa468a9984ee" facs="#m-79180454-4922-4bab-aede-322b967a8054" label="lyrics-like">habére, sicuti accépta habére di¬</l><l xml:id="m-1368bf08-50ee-47c5-bbb0-04af09478578" facs="#m-200f2bf4-3ad6-4770-a4a2-fbfd172d3414" label="lyrics-like">tióne nos éripi, et in electórum</l><l xml:id="m-97c87b4f-8e48-492e-a959-a516f0405251" facs="#m-75ad3ffc-eff4-4fdc-8517-f9fefb3a6407" label="lyrics-like">tuórum júbeas grege numerári.</l><l xml:id="m-c7ef83e6-251d-4afc-8b32-8ce5325a2bcd" facs="#m-478ea2a4-6b31-403f-b3a0-f4f02befcf24" label="lyrics-like">gnátus es múnera púeri tui justi</l><l xml:id="m-4dfbfe15-1b7c-4b65-8057-6bc4efc66d42" facs="#m-ce11752c-f4b5-487f-ba8c-18ca0b3f560c" label="lyrics-like">Per Christum Dóminum nostrum.</l><l xml:id="m-1e6e8ecc-cfc5-4e99-a798-b7c5ef7d2a03" facs="#m-c4b99262-d65e-40ac-b524-50171d9305b2" label="lyrics-like">Abel. et sacrificium Patriárchae</l><l xml:id="m-6558c02e-c013-41c5-b00f-74833753d308" facs="#m-9f06acfb-97b6-4715-981a-a0b92120e34f" label="lyrics-like">nostri Abrahae: et quod tibi óbtulit</l><l xml:id="m-02a77a4b-20e7-40e2-97bb-d64f6b213a4e" facs="#m-69632b69-6506-48e0-abd1-387622a1a797" label="ambiguous">Amen.</l><l xml:id="m-df029899-f6a8-4726-aa50-99e57c2e4d63" facs="#m-6023a527-94ac-4428-8659-e05827445dda" label="lyrics-like">summus sacérdos tuus Melchise¬</l><l xml:id="m-5a791001-2180-4292-9c45-4425ba3043ae" facs="#m-24a98e64-729d-4032-91d4-62b171a99bb4" label="lyrics-like">Quam oblatiónem tu Deus in óm¬</l><l xml:id="m-4ed58d4e-5363-401b-b4ea-f7b9f5003e3e" facs="#m-0bd34e57-103d-42ac-9969-f0be8f87d3d4" label="ambiguous">dech, sanctum sacrificium, imma¬</l><l xml:id="m-01a6fa39-b8d1-4e90-9cf1-e5cfc761cfea" facs="#m-b5b345aa-0aff-4094-9a20-d42ed7fe6b43" label="lyrics-like">nibus, quaésumus, benedíctam, ad¬</l><l xml:id="m-b375d3b2-4d3f-4011-bd66-e84270570c7c" facs="#m-6e82cffc-b52c-4ba5-b58d-c5602c155fca" label="lyrics-like">culátam hóstiam.</l><l xml:id="m-b6ae36db-9215-4483-bd59-13dca72dfa73" facs="#m-d92b3f04-3788-414b-9cf8-348247381689" label="lyrics-like">scriptam, ratam, rationábilem, ac¬</l><l xml:id="m-27ecdd1c-38c9-4224-9e1b-a0ca2c66cb76" facs="#m-fd7a6f45-b521-4513-b71d-e16b5677d94e" label="lyrics-like">ceptabilémque facere dignéris : ut</l><l xml:id="m-59c8f050-bd8c-4b82-b5d5-270c14626303" facs="#m-386ec6d9-6650-49df-a44e-88d07d7c6cc9" label="lyrics-like">Súpplices te rogámus, omnipo¬</l><l xml:id="m-81b4d865-3018-4697-8722-2347dcc3c709" facs="#m-75d62e80-491c-41a0-8879-85cdeb4deb12" label="lyrics-like">nobis Corpüs, et Sanguis fiat dile¬</l><l xml:id="m-1483f7af-cf46-42d7-b30e-d953ce89b37a" facs="#m-61f27803-531e-46f6-b354-9f57b1b87230" label="lyrics-like">tens Deus : jube haec perférri per</l><l xml:id="m-5e2bb060-8f4f-4a65-b60f-053016ec7a94" facs="#m-4305425d-de69-4101-8aa5-8f46b6940bff" label="lyrics-like">ctissimi Filii tui Dómini nostri Jesu</l><l xml:id="m-f1fc1ca5-f464-46a5-b5df-8f8b4a9ac646" facs="#m-84d59eea-705b-4a16-9c3f-fc61dc8f5675" label="ambiguous">manus sancti Angeli tui in sublime</l><l xml:id="m-b99fe3cc-e632-4003-bfe7-979ebfb918a8" facs="#m-ddc687e5-9414-4237-9c4c-fa7142c5245a" label="ambiguous">Christi¬</l><l xml:id="m-1517d4fd-1f3e-463c-ba6c-97f9433853a0" facs="#m-cf263165-5832-4d18-a33d-447bac13c116" label="lyrics-like">altáre tuum in conspéctu divinae</l><l xml:id="m-c0f9a162-8224-426f-9c3b-aeef84ed8aac" facs="#m-5125e37b-6d5c-4f58-86ce-2e99d6b914a5" label="lyrics-like">majestátis tuae: ut quotquot, ex</l><l xml:id="m-69b526fb-5dbe-49d8-8607-48e6f48c0869" facs="#m-ddd8a32f-1d3f-4127-b034-ac24345a1b51" label="lyrics-like">Qui pridie quam paterétur, accé¬</l><l xml:id="m-51dd1c0f-008d-43d8-a20d-d4b1433d12ff" facs="#m-ad82bc9a-d0d2-4b7f-b80c-9055f6a2224c" label="lyrics-like">hac altáris participatióne, sacrosán¬</l><l xml:id="m-1a2e260e-1baa-4348-b413-917d2f0bc5df" facs="#m-a3122c8b-6a01-4cde-81f6-ddd8109b1a86" label="lyrics-like">pit panem in sanctas ac venerábiles</l><l xml:id="m-e87da64b-da65-42aa-8f2d-ffdf8a3fbdfe" facs="#m-c2182caf-a213-47c7-a24e-89dfcf565337" label="lyrics-like">ctum Filii tui Corpus, et Sánguinem</l><l xml:id="m-57bf22ea-a051-413e-90c4-840411885f03" facs="#m-677599b1-da28-4d5f-b080-5f545c2158f3" label="lyrics-like">manus suas, et elevátis óculis in</l><l xml:id="m-b0c1fc5a-6f20-4b04-b766-f66bc9c5e1a1" facs="#m-c6936d7b-2923-40d1-a49c-a5d2cf18175f" label="lyrics-like">sumpsérimus, omni benedictióne</l><l xml:id="m-4e09882e-7a75-4ef7-8289-57ddc78ed646" facs="#m-3a805c61-d1ca-44ff-bca4-72674e8d93d9" label="ambiguous">caelum, ad te Deum Patrem suum</l><l xml:id="m-72011018-23e9-4b27-8917-9e8d3c5d7bf6" facs="#m-e067bc74-8032-4644-9b29-8d543a11ea15" label="lyrics-like">caelésti et grátia repleámur. Per</l><l xml:id="m-50a76381-4444-4de5-96d3-366d225dba18" facs="#m-9b3661ad-c8ca-4d6a-82ca-273535281a81" label="lyrics-like">omnipoténtem, tibi grátias agens,</l><l xml:id="m-14479ae0-813e-461e-85fc-d9cea7fe5eaf" facs="#m-822f4943-07f3-4a37-93bc-2093710b8a51" label="lyrics-like">eúmdem Christum Dóminum no¬</l><l xml:id="m-42862c52-efc9-4ba5-bf58-c81639f921bc" facs="#m-4c9511a9-cc1a-40b6-8b33-1b5ebbb750e4" label="ambiguous">benedixit, fregit, deditque discipulis</l><l xml:id="m-5dadcc7f-08f0-4db5-94c9-d0ec623d91c6" facs="#m-765841fb-7b25-46de-a046-0a758ffc8e80" label="ambiguous">strum. Amen.</l><l xml:id="m-8333773b-dc2f-4ff4-b942-ff2a09795309" facs="#m-e8e09429-516b-4ffa-a69b-3c385f0a3f62" label="lyrics-like">suis, dicens: Accipite, et manducáte</l><l xml:id="m-9ad0fab1-41fe-4601-8163-22aa18b14ceb" facs="#m-8e149611-032a-4a2f-a443-0a082e9d4ecc" label="lyrics-like">Meménto étiam, Dómine, famu¬</l><l xml:id="m-48f0503d-5ef6-4e99-b932-9b8625a4bc6e" facs="#m-656b996d-b5ce-4e3f-aaa2-c3dc69b197f8" label="ambiguous">ex hoc omnes.</l><l xml:id="m-fd1c16ba-a627-4dd3-90e2-1e8a549fa5c0" facs="#m-bccb67ce-d450-4c1e-86b9-5db7b35f0e9e" label="lyrics-like">lórum, famularúmque tuárum N.</l><l xml:id="m-38a91eb9-ac28-42a0-bd05-7f6ba09a9940" facs="#m-47ebb338-aa55-46f8-8bd8-48512efb7daa" label="ambiguous">HOC EST ENIM CORPUS MEUM.</l><l xml:id="m-b9798090-e994-4a26-a76d-e3b55dc62a70" facs="#m-e4ce612f-d64b-4e83-8f14-114da14c1bf7" label="lyrics-like">et N., qui nos praëcessérunt cum</l><l xml:id="m-a8d4c954-ffbe-4923-b814-3d650588bc64" facs="#m-b010cb74-2ade-429a-8ca7-07423b41748b" label="lyrics-like">signo fidei, et dórmiunt in somno</l><l xml:id="m-d2210839-72a4-4088-b57d-8c4e5d492fea" facs="#m-1496977f-ed4f-4fd7-ac9c-086ed1df6464" label="lyrics-like">NImili modo postquam coenátum</l><l xml:id="m-64745e1b-350f-4be7-a3c1-e02379c5aca8" facs="#m-736198bb-a1d3-4cfa-a70b-cb952885d9e7" label="ambiguous">pacis.</l><l xml:id="m-2fb9e7ac-fe73-4e93-96f5-747dcf8ff00d" facs="#m-37cab655-23e6-4da5-908a-80dc3d46151f" label="lyrics-like">O est, accipiens et hunc praeclá¬</l><l xml:id="m-5a5ec19f-b69c-47cf-90b7-cadf85f5ad17" facs="#m-b3ba150a-7ef8-489f-a704-b8c0a767ed84" label="lyrics-like">Ipsis, Dómine, et ómnibus in</l><l xml:id="m-4f5583ae-9317-4aef-bf32-10aa0fe72629" facs="#m-3ddfc582-ff37-427d-9ddd-d0c25a9a7909" label="lyrics-like">rum Cálicem in sanctas ac venerá¬</l><l xml:id="m-17ab0c26-074d-4452-b1a9-410e40c0d123" facs="#m-ef36491c-fe33-4dd4-b82b-b5cc95b40090" label="lyrics-like">biles manus suas: item tibi grátias</l><l xml:id="m-0ada989a-a89d-48b4-b566-e491b7648e79" facs="#m-b7ef99fd-53e9-4ae1-b65d-ac6f4f3e1225" label="lyrics-like">Christo quiescéntibus, locum refri¬</l><l xml:id="m-cda62717-15f9-411f-a53d-d5f5b3b4f80c" facs="#m-fb9aa136-75c7-49fc-bad2-6409557c2482" label="ambiguous">agens, benedixit deditque discspulis</l><l xml:id="m-94a8c6fc-5da5-495e-accc-2f40a9de1a91" facs="#m-01cc63f5-7d98-40b5-8b50-2624357673db" label="lyrics-like">gérii, lucis et pacis, ut indúlgeas,</l><l xml:id="m-eef3d6c1-07d2-498a-a7e2-a3d59eea44ad" facs="#m-e9e0b479-0fc3-4aa6-8b03-2e135305fdc9" label="ambiguous">suis, dicens : Accipite et bibite ex</l><l xml:id="m-5cb2785c-77f4-47d1-b2ab-7275384b7d55" facs="#m-00b20a8b-dfe1-4a2b-8634-7539e8f37c4a" label="lyrics-like">deprecámur. Per eúmdem Christum</l><l xml:id="m-97ceba1b-efa2-4d04-9b67-dd86d1d538a4" facs="#m-429aae4a-42fa-41a9-90be-686421577ff3" label="ambiguous">eo omnes.</l><l xml:id="m-2ffeb866-c2b5-408d-a8cd-8ce18b72eb95" facs="#m-c5f5a0a2-369d-432f-9555-345a7cb745db" label="lyrics-like">Dóminum nostrum. Amen.</l></lg></div></section></score></mdiv></body></music>
</mei>