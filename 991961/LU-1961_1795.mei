938" /><zone xml:id="m-dc9adb04-58db-4e98-988c-be65f6e69dc3" ulx="35" uly="934" lrx="466" lry="972" /><zone xml:id="m-623e453a-b590-43c9-8ef4-9cd8bc6b3d66" ulx="183" uly="977" lrx="744" lry="1012" /><zone xml:id="m-921770c7-5e89-458b-8fdc-818b36468ca5" ulx="56" uly="1002" lrx="896" lry="1045" /><zone xml:id="m-415f0be4-220f-4dd9-8429-23ec804fcfab" ulx="36" uly="1034" lrx="460" lry="1068" /><zone xml:id="m-a24e87ff-d919-4819-8647-47272dfb5bb9" ulx="474" uly="1034" lrx="894" lry="1068" /><zone xml:id="m-ea7921be-786e-4dd4-be34-090941566fd7" ulx="33" uly="1060" lrx="460" lry="1092" /><zone xml:id="m-272776f8-d021-44f4-a58a-e8db10effab2" ulx="474" uly="1061" lrx="654" lry="1095" /><zone xml:id="m-e0adb536-0b70-4bd3-b18f-56dfaa4b34cf" ulx="32" uly="1086" lrx="460" lry="1124" /><zone xml:id="m-02284100-a436-4eac-8a4e-92efdd932034" ulx="214" uly="1169" lrx="723" lry="1213" /><zone xml:id="m-7ace78f9-2c05-4822-b40f-ea36230ee24f" ulx="33" uly="1173" lrx="89" lry="1212" /><zone xml:id="m-60fecf6e-78b8-4259-ba1f-86a9df146d00" ulx="796" uly="1174" lrx="895" lry="1218" /><zone xml:id="m-cde0a4d5-0332-4d1c-ab56-6ff34de14de8" ulx="408" uly="1217" lrx="515" lry="1253" /><zone xml:id="m-b2eb280b-dfea-445d-bda0-ee9cd339bede" ulx="72" uly="1249" lrx="894" lry="1286" /><zone xml:id="m-54d3cd90-efb2-4974-ace6-391c9084b0a6" ulx="36" uly="1280" lrx="893" lry="1318" /><zone xml:id="m-d76ab72b-701c-4ad2-a3d6-887adff4e9d7" ulx="31" uly="1307" lrx="894" lry="1340" /><zone xml:id="m-527c81b8-7473-40bc-8735-061bc4174d5c" ulx="32" uly="1338" lrx="842" lry="1372" /><zone xml:id="m-0d808185-9ff6-4598-ae0a-438f45de821c" ulx="57" uly="1368" lrx="554" lry="1408" /><zone xml:id="m-26face21-07c4-42d9-84a9-ef5a61d9bcea" ulx="345" uly="1412" lrx="578" lry="1444" /><zone xml:id="m-161b8aa1-98b5-4fbe-b92a-957c94a3196a" ulx="51" uly="1440" lrx="891" lry="1480" /><zone xml:id="m-476aa301-978e-40c5-b36c-fb8763a35d18" ulx="32" uly="1470" lrx="458" lry="1508" /><zone xml:id="m-eff2126f-9498-4e12-bb5d-444121a354ff" ulx="467" uly="1470" lrx="893" lry="1508" /><zone xml:id="m-50dd8c55-8f17-4a29-aba7-cc9716678c30" ulx="31" uly="1499" lrx="600" lry="1539" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-d835df0c-78d9-4f57-886f-671a51ec0a21" n="1795" facs="#m-871c916f-e879-4af9-a6f3-665bdd2a193a" /><div xml:id="m-bd5f98c6-9de4-4f86-93a6-27e82a078bb8">
            <lg xml:id="m-46070212-2c67-42cb-a77f-e271b73d8714">
              <l xml:id="m-532503ea-3f0b-476d-83d7-26d6bd023e62" facs="#m-c5ce2739-4ab5-4bfd-9a08-8c4d905bd963" label="ambiguous">1873</l><l xml:id="m-09dab60b-4a4a-411e-a1e8-e0d7be881c16" facs="#m-16c1d660-9f47-4a0f-92df-1606edcbf999" label="ambiguous">Iuly 29 30</l><l xml:id="m-a9cd3d6a-61cc-4ef7-a772-3864992dc077" facs="#m-238d2e9b-a562-41e5-9547-c5789a95cf52" label="ambiguous">St. Martha, Virgin.</l><l xml:id="m-75197892-2fbf-405d-9f46-aafab0c57a1c" facs="#m-bc4e3c6e-4a51-4a9e-8fd7-df7c3dc2ffa7" label="ambiguous">29.</l><l xml:id="m-a23c8432-fa6b-424a-86d6-b5144036fe7e" facs="#m-7181bac3-c14b-4c3e-a2fc-4fbb91912950" label="ambiguous">Semi-double.</l><l xml:id="m-0435a48e-bae4-4b5d-8b09-4e1217653b7b" facs="#m-a2ef06b7-9102-4790-b54b-57c3381b9047" label="lyrics-like">Mass. Dilexísti. p. 1225, except the following:</l><l xml:id="m-7df485f1-2e5a-40dd-8dff-1c2fb9051761" facs="#m-7a2f1e77-be55-447f-be01-2ebb8a44db2a" label="ambiguous">Collect.</l><l xml:id="m-2f466ace-21cb-4359-966d-01e6c33989cc" facs="#m-21bfe983-9011-43f1-98a8-4c516b954637" label="lyrics-like">(xáudi nos Deus salutáris no-t gaudémus; *ita piae devotióni¬</l><l xml:id="m-811facff-b2f4-403a-a4ea-084d5c839c70" facs="#m-2fd1afc3-d8fd-46b3-b369-e6a96b1cc0c8" label="lyrics-like">Cster: [ut sicut de beâtae erudiámur afféctu. Per Dóminum</l><l xml:id="m-23fefbca-3d52-43ed-9497-a561979844f4" facs="#m-99c3d99c-ac56-4960-9aa8-ac7078891b71" label="lyrics-like">Marthae Virginis tuae festivitâte nostrum.</l><l xml:id="m-5d9a4756-4df8-4a77-86ce-8285a1ad8e5a" facs="#m-e84dd12b-3a5a-4558-89c5-dec3dd17635c" label="text-like">Commemoration of St. Felix and his Companlons, Martyrs.</l><l xml:id="m-63ba0e4b-5d01-423b-b2ff-bf3cf05e8147" facs="#m-5b81476b-3506-4556-b869-bfb58a1056b6" label="ambiguous">Collect.</l><l xml:id="m-9b00059f-b63a-4beb-9f7d-57f77f28d99b" facs="#m-75673788-8adf-4288-9d15-97dec0d0bd8b" label="lyrics-like">DRaesta, quaésumus Dómine: solemnitáte congáudet, ita perfruá¬</l><l xml:id="m-946e4965-8129-482f-ac81-2620fe246c01" facs="#m-56570b1c-aab7-4d52-ab18-0f2eaebc42a6" label="lyrics-like">Lut, sicut pópulus christiánus tur aetérna; * et quod votis céle¬</l><l xml:id="m-ce66bf07-d087-450f-a180-1129bd75f335" facs="#m-43c3b9a3-0ebd-47b6-9c97-71c5faf2f4c4" label="lyrics-like">brat, comprehéndat efféctu. Per</l><l xml:id="m-f43e297c-0c41-4531-9f6a-95099a971349" facs="#m-178ccb68-698e-4563-bd22-988a4ed4291a" label="lyrics-like">Martyrum tuórum Felicis, Simpli¬</l><l xml:id="m-8743ae02-a655-41b7-8ac9-fb2199bf8b63" facs="#m-7c24e5af-a967-4e17-89ca-934aa307a528" label="lyrics-like">cii, Faustini et Beatricis temporáli! Dóminum.</l><l xml:id="m-70cb8679-9d5c-469e-b8c0-e0c3effc331e" facs="#m-948348ce-7af0-4fe5-82e6-097ff65bcfc4" label="ambiguous">* Sequentia sancti Evangelli secundum Lucam. Luc. 10. g.</l><l xml:id="m-7a95174c-d5f6-41d7-8677-328032cef8aa" facs="#m-8a8af50f-762e-46db-993f-97bda629be8e" label="lyrics-like">TN illo témpore: Intrávit Jesus! Dómine, non est tibi curae quod</l><l xml:id="m-a3157c92-cefc-41f4-91c1-212b28a60365" facs="#m-0882d710-5d42-470a-83a8-ba88bddf0e55" label="lyrics-like">L in quoddam castéllum : et múlier</l><l xml:id="m-85976dfa-608f-408b-bc55-fb3d9edf6f85" facs="#m-2e00e4a8-75ba-4f80-84a4-124d975d1848" label="ambiguous">soror mea reliquit me solam mini¬</l><l xml:id="m-2293ce19-1b85-48ce-946b-eab4e68245ed" facs="#m-edef8885-25ca-49e4-9cc9-e4a81a8a3f55" label="lyrics-like">quaedam Martha nómine, excépit</l><l xml:id="m-0679327b-bb8d-404e-9c74-f6ffaf95611e" facs="#m-f5feef57-d59f-4de5-bd70-30a027e4c175" label="lyrics-like">stráre? Dic ergo illi ut me ádjuvet.</l><l xml:id="m-61d96089-ec35-484e-82e4-5a19cf370ddc" facs="#m-1681064a-23b1-4174-8651-9ee3b8d871e5" label="ambiguous">illum in domum suam : et huic</l><l xml:id="m-6c922fdd-59af-4db9-ab78-a40a6f4a79f0" facs="#m-2e8552f8-f3c9-42e6-8253-f94e8af53afc" label="lyrics-like">Et respóndens, dixit illi Dóminus:</l><l xml:id="m-823e790a-c2d6-4cf0-9f5d-09206339f295" facs="#m-0057f508-6b56-4964-9aee-dd5d39dc0445" label="lyrics-like">gat soror nómine Marsa, quae</l><l xml:id="m-490c59d0-a528-4719-b6e6-d7b54949e92f" facs="#m-b0287883-0fe6-4361-b66d-8a8690a75cfe" label="ambiguous">Martha, Martha, sollicita es et tur¬</l><l xml:id="m-5a6b28ca-8620-4ed3-b2cf-428102d28f37" facs="#m-fd6a6484-f7cb-4030-8df8-75ff61987840" label="lyrics-like">étiam sedens secus pedes Dómini,</l><l xml:id="m-277e00b5-799e-400d-9ff3-afb146fa7c0d" facs="#m-e6cff05f-4dcd-467d-beed-e5369a9530d7" label="lyrics-like">báris erga plúrima. Porro unum</l><l xml:id="m-a7953589-ddfb-4789-be16-951ed11912ec" facs="#m-36169916-956b-4c21-88bf-0c5b742b0a57" label="lyrics-like">audiébat verbum illus. Martha</l><l xml:id="m-cb932c7e-c63c-4da0-8b56-e16173aa49ca" facs="#m-68c87426-3612-4a90-8bc4-8e11a3a73e0f" label="lyrics-like">est necessárium. María óptimam</l><l xml:id="m-e03ede2b-0bcd-4b43-a6d8-00d14cb2013a" facs="#m-d9f7726b-9773-4328-afeb-f33f1b67644d" label="lyrics-like">autem satagébat circa frequens</l><l xml:id="m-a1d894b1-2ac0-4e28-b583-74494c87cc72" facs="#m-96261646-71b6-427b-8f76-0d3c99d407f3" label="lyrics-like">partem elégit quae non auferétur</l><l xml:id="m-1cb73c78-b4c4-41e1-9083-c106aed71575" facs="#m-6532def8-16c8-4091-981d-e75e43e8cfa1" label="ambiguous">Credo.</l><l xml:id="m-671bb742-677a-4ad2-8860-48f4cb665cde" facs="#m-1f28b2fa-609b-4013-ae1a-8953bd20dd5d" label="lyrics-like">ministérium: quae stetit, et ait:  ab ea¬</l><l xml:id="m-a686011a-1b93-4ac3-aaf0-bb403b4f091d" facs="#m-6f0d065b-df74-4efc-8310-d1acd32c6155" label="text-like">of the Holy Martyrs. Secret.</l><l xml:id="m-4f5d6070-f83f-4d6a-83df-18e1fc753aa9" facs="#m-1d3a873f-0722-4140-a532-2f43d3002324" label="lyrics-like">F Ostias tibi, Dómine, pro sanctó-] deprecántes; ut indulgéntiam nobis</l><l xml:id="m-5b6c5777-ed25-42b8-990c-3b517f678267" facs="#m-6a5bb6b4-eb08-4e82-a6a3-dbd666d1af16" label="lyrics-like">Et rum Mártyrum tuórum Felicis,</l><l xml:id="m-496dea8b-5dab-4d99-a1e7-516ccc5b837c" facs="#m-347c9c2e-32e1-4def-9fc3-864e64ee9b8a" label="lyrics-like">páriter cónferant, et salútem. Per</l><l xml:id="m-f15a4f7f-3519-4a22-9981-94ff776b74c6" facs="#m-079083da-5983-4857-8353-b8d6131412a6" label="ambiguous">Simplicii, Faustini et Beatricis com¬</l><l xml:id="m-5fbb2560-d59c-4a32-b69b-5473224eb91e" facs="#m-14d8c0e1-5899-45e5-9460-47721ad3e62f" label="lyrics-like">Dóminum.</l><l xml:id="m-eb6d0f7d-21a9-4b9c-a28d-4aa6dfa8ecb1" facs="#m-dc9adb04-58db-4e98-988c-be65f6e69dc3" label="lyrics-like">memoratióne deférimus, suppliciter</l><l xml:id="m-9230106e-1732-4876-b2e7-89868b95de96" facs="#m-623e453a-b590-43c9-8ef4-9cd8bc6b3d66" label="text-like">of the Holy Martyrs. Postcommunion.</l><l xml:id="m-c08d5972-c683-4395-9bdb-e0b18e8b2909" facs="#m-921770c7-5e89-458b-8fdc-818b36468ca5" label="lyrics-like">DRaesta, quaésumus omnipotens [ celebráta solémnitas, indulgéntiam</l><l xml:id="m-f1fd0142-dbb3-49d7-aa1f-be39ad5e6eed" facs="#m-415f0be4-220f-4dd9-8429-23ec804fcfab" label="lyrics-like">L Deus: ut sanctórum Mártyrum</l><l xml:id="m-40a8233f-f471-45c6-ae81-380b9411db16" facs="#m-a24e87ff-d919-4819-8647-47272dfb5bb9" label="lyrics-like">nobis tuae propitiatiónls acquírat.</l><l xml:id="m-f9414cbc-de2b-43af-be03-be784d6c6e9e" facs="#m-ea7921be-786e-4dd4-be34-090941566fd7" label="lyrics-like">tuórum Felicis, Simplicii, Faüstini</l><l xml:id="m-caa7982f-9c04-424c-b3be-ac93017cb9f7" facs="#m-272776f8-d021-44f4-a58a-e8db10effab2" label="lyrics-like">Per Dómínum.</l><l xml:id="m-8228a748-6ea1-4bb7-b308-77e1b35345fc" facs="#m-e0adb536-0b70-4bd3-b18f-56dfaa4b34cf" label="lyrics-like">et Beatricis caeléstibus mystériis</l><l xml:id="m-c9dbdddf-b7b9-4dfa-9b0a-fdccd7299c75" facs="#m-02284100-a436-4eac-8a4e-92efdd932034" label="text-like">SS. Abdon and Sennen, Martyrs.</l><l xml:id="m-9a9ac4e7-b46f-4cbb-82e8-ccb84a5e5e76" facs="#m-7ace78f9-2c05-4822-b40f-ea36230ee24f" label="ambiguous">30.</l><l xml:id="m-77480afe-44c4-4c05-8a2b-d6832f529420" facs="#m-60fecf6e-78b8-4259-ba1f-86a9df146d00" label="ambiguous">simple.</l><l xml:id="m-a4e81adf-c1ad-4db2-b3e3-4a220b1f834b" facs="#m-cde0a4d5-0332-4d1c-ab56-6ff34de14de8" label="ambiguous">Collect.</l><l xml:id="m-7e0898b8-86ce-48dd-bd42-1854836586fe" facs="#m-b2eb280b-dfea-445d-bda0-ee9cd339bede" label="lyrics-like">Eus, qui sanctis tuis Abdon et! véniam peccatórum*; ut, Sanctó¬</l><l xml:id="m-8a227e88-0808-4b4f-bb7e-8f2477f03d92" facs="#m-54d3cd90-efb2-4974-ace6-391c9084b0a6" label="lyrics-like">I Sennen ad hanc glóriam ve- rum tuórum intercedéntibus méri¬</l><l xml:id="m-02619979-989f-4820-ad26-98619d7198c6" facs="#m-d76ab72b-701c-4ad2-a3d6-887adff4e9d7" label="lyrics-like">niéndi, copiósum munus grátiae! tis, ab ómnibus mereántur adversi¬</l><l xml:id="m-e9f01e9d-3f6e-4026-8372-dd4cf8c0d8b4" facs="#m-527c81b8-7473-40bc-8735-061bc4174d5c" label="lyrics-like">contulisti : t da fámulis tuis suórum ! tátibus liberári. Per Dóminum.</l><l xml:id="m-bfc4f3b9-a162-48a3-9a9d-aa175adaba52" facs="#m-0d808185-9ff6-4598-ae0a-438f45de821c" label="lyrics-like">Secret. Haec hóstia, quaésumus, p. 1477.</l><l xml:id="m-d2d1dd47-8c14-456a-a078-4602de874270" facs="#m-26face21-07c4-42d9-84a9-ef5a61d9bcea" label="ambiguous">Postcommunion.</l><l xml:id="m-c1a96bc7-f820-49eb-98e8-1c41bfdc0b52" facs="#m-161b8aa1-98b5-4fbe-b92a-957c94a3196a" label="lyrics-like">OER hujus Dómine operatiónem! Martyribus tuis Abdon et Sennen,</l><l xml:id="m-c1edebc5-0238-43b4-b89a-a73d4f6a88c5" facs="#m-476aa301-978e-40c5-b36c-fb8763a35d18" label="lyrics-like">L mystéri, et vitia nostra pur¬</l><l xml:id="m-ddbf40be-baec-4540-a5a8-c5e50b772562" facs="#m-eff2126f-9498-4e12-bb5d-444121a354ff" label="lyrics-like">justa desidéria compleántur. Per</l><l xml:id="m-4d201ab9-c480-4e62-ab7b-078fe8e98590" facs="#m-50dd8c55-8f17-4a29-aba7-cc9716678c30" label="lyrics-like">géntur : et, intercedéntibus sanctis! Dóminum.</l></lg></div></section></score></mdiv></body></music>
</mei>