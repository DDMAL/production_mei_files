/><zone xml:id="m-b3b258a0-a206-47cb-ab9a-e7d59711b1e8" ulx="79" uly="657" lrx="733" lry="694" /><zone xml:id="m-a4ce5c20-c90e-433f-8162-fc7458744501" ulx="169" uly="700" lrx="301" lry="738" /><zone xml:id="m-820aa641-f6b6-419e-b550-96c354ddbb31" ulx="748" uly="705" lrx="849" lry="744" /><zone xml:id="m-c13fea22-6851-4228-8a53-2b9e70db0989" ulx="54" uly="736" lrx="975" lry="784" /><zone xml:id="m-063c9c5c-45e6-41e8-8f56-06e6e104ba26" ulx="60" uly="772" lrx="505" lry="808" /><zone xml:id="m-7d81e760-8bfd-4b17-a0ad-e9ba3bc22c15" ulx="512" uly="773" lrx="975" lry="804" /><zone xml:id="m-a984fb60-0f15-44db-9ad1-5d72c2746339" ulx="513" uly="798" lrx="975" lry="835" /><zone xml:id="m-ce6453be-2d0d-47c3-9cde-3b2b9d99487a" ulx="46" uly="801" lrx="503" lry="836" /><zone xml:id="m-2a7f0ad1-9a7d-4995-8890-5d1fac8d2109" ulx="515" uly="828" lrx="976" lry="866" /><zone xml:id="m-cb93fa7e-606c-4447-bb19-fe202a7b84bd" ulx="48" uly="830" lrx="505" lry="866" /><zone xml:id="m-33f6f30e-4ac8-4a05-a9d5-c167e01d7b53" ulx="518" uly="861" lrx="975" lry="902" /><zone xml:id="m-64e75260-8768-47f4-845f-9337274767f3" ulx="46" uly="862" lrx="504" lry="899" /><zone xml:id="m-e335777b-ff25-436c-a817-0747af872407" ulx="517" uly="891" lrx="974" lry="930" /><zone xml:id="m-6b38d009-978b-457d-8862-d60672131ee3" ulx="46" uly="892" lrx="503" lry="925" /><zone xml:id="m-613a3b59-aca7-4232-a3e2-a1913506dc8b" ulx="47" uly="921" lrx="936" lry="962" /><zone xml:id="m-ce8bcd08-2696-4d3a-9c5f-6dd539f1a39d" ulx="47" uly="951" lrx="521" lry="988" /><zone xml:id="m-929689ba-1033-40f9-9bc8-e6903421b6c8" ulx="544" uly="951" lrx="702" lry="989" /><zone xml:id="m-61fcc569-378b-4269-8e24-cb2216437a63" ulx="77" uly="991" lrx="975" lry="1027" /><zone xml:id="m-49edbb6d-218b-4871-ae4f-4a3606b00880" ulx="46" uly="1020" lrx="973" lry="1052" /><zone xml:id="m-f60a9363-65b8-4cf5-8963-aacfbdc88461" ulx="46" uly="1050" lrx="805" lry="1086" /><zone xml:id="m-cf42bd95-297b-4e19-8c84-30d4606da850" ulx="91" uly="1112" lrx="930" lry="1154" /><zone xml:id="m-6a3abca6-254a-455e-ad6b-9c211c569ab5" ulx="153" uly="1162" lrx="325" lry="1210" /><zone xml:id="m-80680e23-67de-4a61-8393-b3d0b2b8899e" ulx="712" uly="1162" lrx="874" lry="1212" /><zone xml:id="m-1c9b63a3-983b-4dfb-9d3a-968a1666dde2" ulx="72" uly="1215" lrx="516" lry="1260" /><zone xml:id="m-fa83109b-e927-4df3-be49-cc6258ebd20d" ulx="539" uly="1218" lrx="972" lry="1257" /><zone xml:id="m-945694b4-2fbf-4f34-869f-afc4e7952b8d" ulx="42" uly="1253" lrx="972" lry="1282" /><zone xml:id="m-013a75ad-7c25-4a77-b2f6-6d76a3c193cb" ulx="44" uly="1277" lrx="503" lry="1312" /><zone xml:id="m-7328dd7d-1f5b-449d-acec-e3bf06034844" ulx="513" uly="1277" lrx="972" lry="1311" /><zone xml:id="m-3b97d4ee-296c-4cd4-81d6-742c4c52d3c5" ulx="511" uly="1304" lrx="973" lry="1341" /><zone xml:id="m-25bbdced-a4b7-482f-9b8b-1cc23358a697" ulx="44" uly="1305" lrx="505" lry="1339" /><zone xml:id="m-36c5e498-9bff-4d34-b41b-1eace2b751b2" ulx="514" uly="1331" lrx="973" lry="1369" /><zone xml:id="m-787bb5a1-064f-4405-b61e-b88c191f9a43" ulx="45" uly="1332" lrx="503" lry="1371" /><zone xml:id="m-c29e6c57-a0d3-46e7-9159-be61ccfdf174" ulx="516" uly="1357" lrx="944" lry="1397" /><zone xml:id="m-d27dafb5-142d-4cb7-982b-88b1be8da385" ulx="44" uly="1360" lrx="474" lry="1395" /><zone xml:id="m-7fe82d5d-d710-44d6-b4e2-ee00abbf52c9" ulx="547" uly="1400" lrx="871" lry="1443" /><zone xml:id="m-3168e8ea-7587-4e4a-9f9b-ba2658af59e5" ulx="76" uly="1401" lrx="400" lry="1444" /><zone xml:id="m-d5ce8b90-5803-4119-b42d-2c9f2dc6c200" ulx="73" uly="1440" lrx="505" lry="1477" /><zone xml:id="m-be18dfdb-27de-4d06-9afa-b56dc3ed55ff" ulx="544" uly="1440" lrx="845" lry="1477" /><zone xml:id="m-3106fb18-a16f-42fe-9154-978ee47bb122" ulx="539" uly="1472" lrx="968" lry="1516" /><zone xml:id="m-931889dd-1aa0-427a-849f-60bafa40ba74" ulx="76" uly="1474" lrx="505" lry="1514" /><zone xml:id="m-6514430c-e134-4fd7-b16a-453af73e0bbf" ulx="45" uly="1506" lrx="136" lry="1542" /><zone xml:id="m-81dbc40b-3499-4475-a6e9-b3866095e83b" ulx="517" uly="1508" lrx="873" lry="1541" /><zone xml:id="m-b6ddac92-75a3-440a-bf01-b1b86e334954" ulx="74" uly="1536" lrx="503" lry="1579" /><zone xml:id="m-a584ef63-53f4-4328-a14f-de6f91cf3dd5" ulx="545" uly="1540" lrx="848" lry="1579" /><zone xml:id="m-315f6c14-0969-4a10-bc54-3b4226cd329b" ulx="46" uly="1568" lrx="107" lry="1608" /><zone xml:id="m-cf8ffed0-ef5e-4be1-931e-6437e2de7559" ulx="548" uly="1576" lrx="798" lry="1619" /><zone xml:id="m-45ba1b83-707c-4eeb-a191-ef1773c2e45a" ulx="78" uly="1601" lrx="404" lry="1643" /><zone xml:id="m-fabbbd78-c3d3-4bd3-97c8-2fd72de9d917" ulx="82" uly="1643" lrx="323" lry="1682" /></surface></facsimile><body>
    <mdiv type="solesmes">
      <score>
        <section>
          <pb xml:id="m-7617867a-3b78-4dd9-a393-5e941d6ddd18" n="0933" facs="#m-fe53b7bc-ff41-4f1f-bd10-e54fb73c09e7" /><div xml:id="m-dbe89c50-bbd2-44b9-aa02-cfed26148fae">
            <lg xml:id="m-7120faf7-8efb-4dc0-ada4-504095ad50fe">
              <l xml:id="m-692bd7b1-a336-4001-be42-6d4def679d79" facs="#m-e21e437a-b297-49b1-b25d-19b1abef9df0" label="text-like">The procession</l><l xml:id="m-50d28e21-93f7-47e1-9b00-6d4773d0c33d" facs="#m-60c8b748-60ec-4c88-8612-1eab81318a43" label="ambiguous">776x</l><l xml:id="m-da09b4cd-c7cc-40f5-9189-5bd9380c29e3" facs="#m-2c100c6d-5339-49e9-b266-3a375ea87a5a" label="text-like">6. When the inscribing of the cross and other signs is done, the deacon</l><l xml:id="m-154dbeb1-4422-4ca2-82d0-50e339f708e6" facs="#m-32aacb6d-27bd-4236-bd97-c95001695810" label="text-like">Ior a serverl presents the grains of incense to the priest. If they are not yet</l><l xml:id="m-eb91d957-41b3-44d8-8140-d8adfc81cb15" facs="#m-3d287f64-214e-40bd-bce7-1e5f9e948411" label="text-like">blessed, the celebrant thrice sprinhles them with holy water and thrice censes</l><l xml:id="m-79986f42-cfef-42aa-bc78-d3be57e2e8d3" facs="#m-37f5507c-b703-48f7-8c91-b2b16115562a" label="text-like">them, saving nothing. Then hefixes the five grains in their holes, saving aloud:</l><l xml:id="m-e840542a-55c3-4ca0-8c16-89cf66c5d032" facs="#m-bb9cf00a-0c3d-4372-bbbe-25f48647feb3" label="lyrics-like">1) Per sua sancta vúlnera</l><l xml:id="m-1a999d87-2ee0-4871-be63-ef5b87f7ed9c" facs="#m-5c1533d4-3b09-4fd8-89c0-fa44cee0ee95" label="lyrics-like">2) gloriósa</l><l xml:id="m-3875c1a3-5489-432b-9a6f-d6c6c9961768" facs="#m-b2c22f47-0926-4004-834e-a3882c2cf2e7" label="lyrics-like">3) custódiat</l><l xml:id="m-ef7822d3-9c4f-4669-a087-cd0022e60fb8" facs="#m-c21b9379-82e1-41c5-8104-520f3901d9bb" label="ambiguous" /><l xml:id="m-bd937282-a96c-46bf-a453-12ed94b729e2" facs="#m-813c7ab3-6d6a-40d9-96d3-63c09d2d471c" label="ambiguous">25</l><l xml:id="m-6c7ba615-3476-4f51-a390-64196dbc5e9d" facs="#m-9e01209f-ff62-4fd3-a307-c2d7ab523ddd" label="ambiguous">3</l><l xml:id="m-752262cb-dd09-4272-9c9b-264590cc34a5" facs="#m-ac5ca961-6de1-4958-b96f-330adabbd14e" label="lyrics-like">4) et consérvet nos</l><l xml:id="m-9cf2d801-4d1a-4279-9691-9746a7539bdf" facs="#m-f9b79e30-c052-4e20-9a5c-b088329b1b97" label="lyrics-like">5) Christus Dóminus. Amen.</l><l xml:id="m-a8b22615-4a52-462f-a415-06d392b07c3c" facs="#m-eb6e1e2c-6b3a-43cd-90ca-cbf5051a2629" label="text-like">7. Then the deacon lor a serverl, lighting a small candle at the newo fire,</l><l xml:id="m-8dd84b94-38c6-417c-9683-73fdefb1d119" facs="#m-0d4cdde1-87d3-4f10-a147-7db86bc4312c" label="text-like">gives it to the priest, who with it lighis the paschal candle, saying aloud:</l><l xml:id="m-d9652899-44ea-4932-9a27-feea6374190d" facs="#m-f21ae711-e12d-4479-b247-65501212326b" label="lyrics-like">Lumen Christi glorióse resurgéntis</l><l xml:id="m-6ef006d6-12e8-455b-b326-c41799db4885" facs="#m-5833773c-d4de-4c7a-ab99-1a1e8d3f6e2e" label="lyrics-like">Díssipet ténebras cordis et mentis.</l><l xml:id="m-1e4e8519-76d0-4f21-ac1e-37d19563fe22" facs="#m-39a1733d-b9ab-4fc1-ab29-648ee4b00aa5" label="text-like">8. At once the priest blesses the lighted paschal candle, singing to the ferial</l><l xml:id="m-e786cebe-deee-4ab6-b048-529d8d75fa3a" facs="#m-e56c2c5c-f783-45e3-b2e1-78f46ac6ad04" label="text-like">tone B lor ancient simple tonel, with hands joined:</l><l xml:id="m-8ae02a75-4473-4dbe-ae80-9d3989ad1565" facs="#m-b3b258a0-a206-47cb-ab9a-e7d59711b1e8" label="lyrics-like">V. Dóminus vobíscum. W. Et cum spíritu túo.</l><l xml:id="m-f7ff6c9f-93c2-4254-89ed-8c8a4fcd8c12" facs="#m-a4ce5c20-c90e-433f-8162-fc7458744501" label="lyrics-like">Orémus.</l><l xml:id="m-bb0516eb-e947-4c57-a953-73426b123756" facs="#m-820aa641-f6b6-419e-b550-96c354ddbb31" label="text-like">Prayer</l><l xml:id="m-3393ed19-e3e7-4e7a-b78d-e1ddbea304ee" facs="#m-c13fea22-6851-4228-8a53-2b9e70db0989" label="lyrics-like">VyEniat, quaésumus, omnípo- admixtióne refúlgeat; sed in</l><l xml:id="m-5dca1df6-97c1-459b-af71-aa86051f044e" facs="#m-063c9c5c-45e6-41e8-8f56-06e6e104ba26" label="ambiguous">tens Deus, super hunc in¬</l><l xml:id="m-ce4b60d4-1137-4ea6-8e14-cc14ab7243c4" facs="#m-7d81e760-8bfd-4b17-a0ad-e9ba3bc22c15" label="lyrics-like">quocúmque loco ex hujus san¬</l><l xml:id="m-04333ecb-aff7-451d-9029-076b7f9125d2" facs="#m-a984fb60-0f15-44db-9ad1-5d72c2746339" label="lyrics-like">ctificatiónis mystério áliquid fú¬</l><l xml:id="m-8ffa1fd7-6204-4956-89b7-1a46b73a1822" facs="#m-ce6453be-2d0d-47c3-9cde-3b2b9d99487a" label="lyrics-like">cénsum céreum larga tuae be¬</l><l xml:id="m-08e2e6c8-10f2-4323-b436-3cbe46a0bd7c" facs="#m-2a7f0ad1-9a7d-4995-8890-5d1fac8d2109" label="lyrics-like">erit deportátum, expúlsa diabó¬</l><l xml:id="m-93bc9fca-1b26-47ac-a2a5-d417bcdadbf2" facs="#m-cb93fa7e-606c-4447-bb19-fe202a7b84bd" label="lyrics-like">ne † dictiónis infúsio: et hunc</l><l xml:id="m-aa1bd5ef-03e7-4366-8dcc-eed918f237fb" facs="#m-33f6f30e-4ac8-4a05-a9d5-c167e01d7b53" label="ambiguous">licae fraudis nequitia, virtus</l><l xml:id="m-f363a623-5d13-4106-a7e1-59902dd2346b" facs="#m-64e75260-8768-47f4-845f-9337274767f3" label="lyrics-like">noctúrnum splendórem invisibilis</l><l xml:id="m-46baa2c3-7873-45cb-912f-b54fe0f4d8fe" facs="#m-e335777b-ff25-436c-a817-0747af872407" label="lyrics-like">tuae majestátis assístat. Per</l><l xml:id="m-fcefe31a-1692-411a-b7b9-e25bd80e25b2" facs="#m-6b38d009-978b-457d-8862-d60672131ee3" label="lyrics-like">regenerátor inténde; ut non so¬</l><l xml:id="m-e4fee7a4-6201-4c80-b34d-0b04219bad9d" facs="#m-613a3b59-aca7-4232-a3e2-a1913506dc8b" label="lyrics-like">lum sacrificium, quod hac nocte Christum Dóminum nostrum.</l><l xml:id="m-4b02a19c-6e77-49b9-a39f-32146f8ac3d2" facs="#m-ce8bcd08-2696-4d3a-9c5f-6dd539f1a39d" label="lyrics-like">litátum est, arcána lúminis tui</l><l xml:id="m-eea4407c-847a-4b79-9d1e-7720084683e4" facs="#m-929689ba-1033-40f9-9bc8-e6903421b6c8" label="ambiguous">W. Amen.</l><l xml:id="m-e6e645c1-0d61-476e-9c54-1c68dd2820e7" facs="#m-61fcc569-378b-4269-8e24-cb2216437a63" label="text-like">9. During this time the lights in the church are extinguished. And candles</l><l xml:id="m-2c64d665-c84b-40f6-9acb-bb361c70d6da" facs="#m-49edbb6d-218b-4871-ae4f-4a3606b00880" label="text-like">are distributed to clergy and people, unless they already have them, to be carried</l><l xml:id="m-94b9f547-104b-471a-acd5-1757659f561e" facs="#m-f60a9363-65b8-4cf5-8963-aacfbdc88461" label="text-like">in the procession into the church and lit from the paschal candle.</l><l xml:id="m-2ee319e5-05c4-4bc7-9df1-b95f96efcf5a" facs="#m-cf42bd95-297b-4e19-8c84-30d4606da850" label="text-like">THE PROCESSION OF THE PASCHAL CANDLE</l><l xml:id="m-0e94a72d-6f9c-4e37-9e6c-7fa4875afcb1" facs="#m-6a3abca6-254a-455e-ad6b-9c211c569ab5" label="ambiguous">Solemn rite</l><l xml:id="m-f181dc90-9ea5-4652-bd93-3b0144252516" facs="#m-80680e23-67de-4a61-8393-b3d0b2b8899e" label="ambiguous">Simple rite</l><l xml:id="m-3fcf1a1b-b9b4-4185-9497-0ca1f2f3fef7" facs="#m-1c9b63a3-983b-4dfb-9d3a-968a1666dde2" label="text-like">10. Then the celebrant again puts</l><l xml:id="m-995bf587-e499-402f-b203-24d1ea6eddf2" facs="#m-fa83109b-e927-4df3-be49-cc6258ebd20d" label="text-like">H0a. Then the priest tabes off his</l><l xml:id="m-1d3ccc4a-62e6-477f-ad43-abc010455e26" facs="#m-945694b4-2fbf-4f34-869f-afc4e7952b8d" label="text-like">incense in the thurible; the deacon! purple vestments and puts on a iohite</l><l xml:id="m-4c339eb1-0f22-4944-abcb-0fec3b584f3c" facs="#m-013a75ad-7c25-4a77-b2f6-6d76a3c193cb" label="text-like">tahes off his purple vestments and puis</l><l xml:id="m-1468eb87-f06a-40a6-b46b-243952e04951" facs="#m-7328dd7d-1f5b-449d-acec-e3bf06034844" label="text-like">stole and dalmatic; he then puts in¬</l><l xml:id="m-79d3cc55-17f1-419b-8eae-3cea7a26ceb8" facs="#m-3b97d4ee-296c-4cd4-81d6-742c4c52d3c5" label="text-like">cense again in the thurible; then he</l><l xml:id="m-2d950c5f-7884-4122-9ed9-4e23e718b397" facs="#m-25bbdced-a4b7-482f-9b8b-1cc23358a697" label="text-like">on a white stole and dalmatic, he then</l><l xml:id="m-aa27a24b-8625-4ddb-a8f8-8c42ba23fc27" facs="#m-36c5e498-9bff-4d34-b41b-1eace2b751b2" label="text-like">tabes the lighted paschal candle and</l><l xml:id="m-7f57f2ca-e5a8-4a18-b9cc-03b0329f54c6" facs="#m-787bb5a1-064f-4405-b61e-b88c191f9a43" label="text-like">tabes the lighted paschal candle, and</l><l xml:id="m-2370c8d9-6b63-464e-8606-18026b358980" facs="#m-c29e6c57-a0d3-46e7-9159-be61ccfdf174" label="text-like">the procession is formed as follouos:</l><l xml:id="m-f0fcc4ca-8d50-4de5-a511-e9cae9fe868e" facs="#m-d27dafb5-142d-4cb7-982b-88b1be8da385" label="text-like">the procession is formed as follous:</l><l xml:id="m-aaff5bdd-971f-4163-b35e-b3ca77a2e592" facs="#m-7fe82d5d-d710-44d6-b4e2-ee00abbf52c9" label="text-like">a) the thurifer, first of all,</l><l xml:id="m-164b0b5a-5119-4104-ae2f-5f9251a69d57" facs="#m-3168e8ea-7587-4e4a-9f9b-ba2658af59e5" label="text-like">a) the thurifer, first of all,</l><l xml:id="m-3e446048-8f96-4906-b614-bd09a3c0759a" facs="#m-d5ce8b90-5803-4119-b42d-2c9f2dc6c200" label="text-like">b) then the subdeacon with the cross,</l><l xml:id="m-2212484e-19f2-4bd9-822f-677b93999cce" facs="#m-be18dfdb-27de-4d06-9afa-b56dc3ed55ff" label="text-like">b) then the cross-bearer,</l><l xml:id="m-d5f08344-bacc-4114-ae5c-a87cf734cbd6" facs="#m-3106fb18-a16f-42fe-9154-978ee47bb122" label="text-like">e) immediately after him, the cele¬</l><l xml:id="m-ec5920ac-d403-46ba-be01-cbd8f64df995" facs="#m-931889dd-1aa0-427a-849f-60bafa40ba74" label="text-like">c) the deacon vith the lighted</l><l xml:id="m-5a19f7bf-dc5b-4ff2-b697-fa769a431d16" facs="#m-6514430c-e134-4fd7-b16a-453af73e0bbf" label="ambiguous">candle,</l><l xml:id="m-c83d883a-2e26-4ec5-80b8-04b95029605f" facs="#m-81dbc40b-3499-4475-a6e9-b3866095e83b" label="text-like">brant with the lighted candle,</l><l xml:id="m-e3d66170-2ce4-47c3-931e-fbb17503d53c" facs="#m-b6ddac92-75a3-440a-bf01-b1b86e334954" label="text-like">d) the celebrant immediately after</l><l xml:id="m-860523e3-278e-448f-8bdc-c65384a5f6dc" facs="#m-a584ef63-53f4-4328-a14f-de6f91cf3dd5" label="text-like">d) then the other servers,</l><l xml:id="m-be8aaf5d-757f-4a42-aefc-050db8473a9f" facs="#m-315f6c14-0969-4a10-bc54-3b4226cd329b" label="ambiguous">him,</l><l xml:id="m-9557e69b-4b4d-427a-9a49-34be9d6c1b61" facs="#m-cf8ffed0-ef5e-4be1-931e-6437e2de7559" label="text-like">e) lastly the people.]</l><l xml:id="m-93fa2497-3b16-4ee1-8a3c-f26d092d315f" facs="#m-45ba1b83-707c-4eeb-a191-ef1773c2e45a" label="text-like">e) then the clergy in order,</l><l xml:id="m-2bc7f2f0-6d37-4cd7-a635-93242aa9dbe3" facs="#m-fabbbd78-c3d3-4bd3-97c8-2fd72de9d917" label="text-like">f) lasily the people.</l></lg></div></section></score></mdiv></body></music>
</mei>